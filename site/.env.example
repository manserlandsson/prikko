# Mapbox — kartstil i sidopanel och på stadssidan.
# Skapas på mapbox.com → Access tokens → public token (pk....).
# Fri nivå: 50 000 kartladdningar/mån, kommersiell användning tillåten.
PUBLIC_MAPBOX_TOKEN=

# Mapillary — gatubilder till verksamhetssidorna.
# Gratis konto på mapillary.com → Settings → Developers → skapa en token.
#
# Läses av pipeline/matt_bildtackning.py och pipeline/hamta_gatubilder.py.
# Ingen token betyder ingen mätning och bara Panoramax som källa, och Panoramax
# är mätt till 11,5 procent inom 60 meter i fyra kommuner. Kör mätskriptet innan
# mer byggs på det här spåret:  python3 pipeline/matt_bildtackning.py
MAPILLARY_TOKEN=

# Google Maps: INGEN NYCKEL, och det är ett beslut och inte en lucka.
#
# Places-foton är sedan 8 juli 2025 inte en tillåten användning för en
# katalogtjänst med faktureringsadress i EES, Street View-innehåll får inte
# visas bredvid en karta (och vår sida visar just en), och ingendera får lagras
# eller cachas. Tre av varandra oberoende spärrar, alla citerade i
# docs/13_bilder_och_verksamhetsdata.md del A1. Lägg inte tid på att omvärdera
# det, och lägg inte tillbaka nyckeln.

# ---------------------------------------------------------------------------
# Cloudflare R2 — hör INTE hemma i den här filen.
#
# Bilderna som pipelinen hämtar lagras i R2, och nyckeln dit går förbi allt.
# Den bor i ~/.prikko-env tillsammans med SUPABASE_SERVICE_KEY, precis som den
# nyckeln aldrig får hamna här. Variabelnamnen och klickvägen i Cloudflare står
# överst i pipeline/prikko/imagestore.py.
# ---------------------------------------------------------------------------

# Supabase — inloggning, bevakning, omdömen och verksamhetens svar.
#
# Båda finns i Supabase → Project Settings → API.
# Anon-nyckeln är AVSEDD att vara publik och bakas in i klientkoden. Det är
# radsäkerheten som skyddar datan, aldrig nyckeln. Service-nyckeln får däremot
# aldrig hamna här: den går förbi radsäkerheten och bor bara i ~/.prikko-env.
#
# Lämnas de tomma byggs sajten precis som förut, men varje inloggningsberoende
# yta säger att funktionen inte är konfigurerad i stället för att gå sönder.
#
# KRÄVER OCKSÅ: Project Settings → API → Exposed schemas → lägg till
# `community`. Utan det svarar varje skrivning 404. Se pipeline/schema_community.sql.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
