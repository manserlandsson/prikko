---
/**
 * Gatubild via Googles Maps Embed API — laddad först vid klick.
 *
 * Varför inte direkt i sidan:
 *
 * 1. Googles villkor. Street View-bilder får inte lagras eller cachas
 *    ("Content pre-fetching, indexing, storing, or caching is generally
 *    prohibited, except for place IDs and panorama IDs"). Vi kan alltså inte
 *    baka in bilden i den statiska HTML:en — bara visa den live.
 * 2. Integritet. En Google-iframe sätter Googles kakor. Laddas den på varje
 *    restaurangsida krävs samtyckesbanner på hela sajten. Vid klick är det
 *    besökarens eget val, och de allra flesta sidvisningar slipper den helt.
 * 3. Prestanda. En iframe per sida skulle skada Core Web Vitals, och
 *    hastighet är hela vår rankningsstrategi.
 *
 * Nyckeln läggs i PUBLIC_GOOGLE_MAPS_KEY. Saknas den renderas ingenting —
 * sidan ska aldrig visa en trasig knapp.
 */
interface Props {
  lat: number;
  lng: number;
  name: string;
}

const { lat, lng, name } = Astro.props;
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY;
---

{key && (
  <div class="streetview" data-src={`https://www.google.com/maps/embed/v1/streetview?key=${key}&location=${lat},${lng}&heading=0&pitch=0&fov=80`}>
    <button type="button" class="trigger">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
           stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="7" r="3" />
        <path d="M9 21v-6l-2-4a5 5 0 0110 0l-2 4v6" />
      </svg>
      Se gatubild
    </button>
    <p class="hint caption text-muted">
      Öppnar Googles gatubild. Google kan då sätta kakor.
    </p>
  </div>
)}

<style>
  .streetview {
    margin-top: var(--s-3);
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    justify-content: center;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    padding: 10px 18px;
    font: 600 var(--fs-body-s)/1 var(--font-sans);
    cursor: pointer;
  }

  .trigger:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .hint {
    margin-top: 6px;
    text-align: center;
  }

  .streetview.open .trigger,
  .streetview.open .hint {
    display: none;
  }

  .streetview iframe {
    display: block;
    width: 100%;
    height: 200px;
    border: 0;
    border-radius: var(--r-control);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.streetview').forEach((box) => {
    box.querySelector('.trigger')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.dataset.src!;
      frame.loading = 'lazy';
      frame.title = 'Gatubild';
      frame.allowFullscreen = true;
      // Googles kakor laddas först nu, efter besökarens egen klickning.
      box.classList.add('open');
      box.appendChild(frame);
    });
  });
</script>
