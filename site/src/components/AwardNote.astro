---
/**
 * Utmärkelsen på verksamhetens egen sida, som ett sigill vid bedömningen.
 *
 * ## Tre former, och varför det blev den här
 *
 * 1. Ett brett grått FÄLT mellan nyckeltalen och kontrollhistoriken, med
 *    sigill, rubrik, en mening om serien och en länk. Ägaren underkände det:
 *    "utmärkelsen sitter superfult här ... överförklarat också". Det var en
 *    låda i en huvudkolumn vars hela form bygger på att ingenting är inramat.
 * 2. Ett PILLER i rubrikraden, bredvid "Ren historik". Lådan försvann, men
 *    det gjorde utmärkelsen med: "varför tog du bort utmärkelsen". Ett
 *    tunt piller bland andra piller är inget erkännande.
 * 3. SIGILLET, ute till höger på bedömningsraden. Det är den form märket
 *    faktiskt har, det står bredvid det besked det hör ihop med, och det
 *    skjuter ingenting nedåt eftersom raden redan är så hög som ansiktet.
 *
 * "Ren historik" står inte längre intill. Den räknades vid varje bygge ur
 * samma serie kontroller som utmärkelsen vilar på, alltså sade den inget som
 * inte redan stod bredvid. Se sidmallen.
 *
 * All brödtext följde med ut i steg 2 och kommer inte tillbaka. "Nio
 * kontroller i rad utan anmärkning" är utgåvans KRITERIUM och står på
 * utgåvesidan, ett klick bort, tillsammans med datumintervall och frysdatum.
 *
 * Märket är historiskt: det säger att verksamheten fanns med i en namngiven
 * årsutgåva, blir aldrig osant och tas aldrig bort. Årtalet i ritningen är
 * hela skälet till att det kan stå bredvid vilken bedömning som helst utan
 * att säga emot den, också "Brister som kvarstår" nästa år.
 */
import AwardSeal from './AwardSeal.astro';
import { path } from '../lib/urls';
import { awardsFor } from '../lib/utmarkelser';
import { markTitle } from '../lib/marke';
import type { Establishment } from '../lib/data';

interface Props {
  establishment: Establishment;
}

const { establishment: e } = Astro.props;

/* Bara den senaste utgåvan. Äldre räknades upp i en egen mening förut; de
   finns på utgåvesidorna och behöver inte varsin länk från en restaurangsida. */
const newest = awardsFor(e.municipality.slug, e.slug)[0];
---

{newest && (
  <a class="utmarkelse" href={path('utmarkelser', newest.year)} title={markTitle(newest.year)}>
    <AwardSeal year={newest.year} width={132} decorative />
    <span class="visually-hidden">{markTitle(newest.year)}</span>
  </a>
)}

<style>
  /* Ingen ram och ingen platta. Ritningen bär sin egen form, och en ram runt
     ett sigill är en låda runt en låda. */
  .utmarkelse {
    flex: none;
    display: block;
    line-height: 0;
    transition: opacity .15s ease;
  }

  .utmarkelse:hover { opacity: .78; }

  /* Under 640 px står sigillet under beskedet i stället för bredvid, se
     sidmallen, och då får det inte ta halva bredden. */
  @media (max-width: 640px) {
    .utmarkelse :global(.seal) { width: 104px; height: auto; }
  }
</style>
