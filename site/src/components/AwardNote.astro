---
/**
 * Utmärkelsen på verksamhetens egen sida.
 *
 * Två saker som ser lika ut men inte är det, och som sidan därför måste hålla
 * isär:
 *
 * - MÄRKET, som står här, är historiskt. Det säger att verksamheten fanns med i
 *   en namngiven årsutgåva. Det blir aldrig osant, och det tas aldrig bort.
 * - CHIPET uppe vid bedömningen är nuläget, satt av `e.distinction` vid varje
 *   bygge. Det försvinner samma dag kommunen hittar en avvikelse.
 *
 * Slutar de säga samma sak är det inte ett fel, utan hela skälet till att
 * märket bär ett årtal. DÅ, och bara då, skrivs en andra mening ut, så att en
 * läsare som ser ett märke från 2026 bredvid "Brister som kvarstår" får veta
 * varför båda står där. Säger de samma sak tillför meningen ingenting, och det
 * som inte tillför något står inte här.
 *
 * Serien och listan räcker alltså som text. Datumintervallet och frysdatumet
 * stod här förut och bar inget på just den här sidan: den som vill ha dem
 * hittar dem på utgåvesidan, ett klick bort.
 */
import AwardSeal from './AwardSeal.astro';
import { path } from '../lib/urls';
import { awardsFor, capitalise, numeral } from '../lib/utmarkelser';
import type { Establishment } from '../lib/data';

interface Props {
  establishment: Establishment;
}

const { establishment: e } = Astro.props;
const awards = awardsFor(e.municipality.slug, e.slug);
const newest = awards[0];
/* Märket visar den senaste utgåvan. Äldre utgåvor räknas upp i text i stället
   för i rubriken, så att rubriken alltid svarar mot det märke som står bredvid. */
const earlier = awards.slice(1);
---

{newest && (
  <section class="award">
    <a href={path('utmarkelser', newest.year)} class="seal-link" aria-label={`Utmärkelsen ${newest.year}`}>
      {/* 88 px. Kransen är bred och låg, 507 mot 236, till skillnad från en
          rund lagerkrans. Vid samma höjd som en rund läser den därför som
          tunnare, och behöver mer bredd för att väga lika tungt bredvid
          texten. 88 ger 41 px höjd, ungefär höjden på rubriken plus raden
          under. */}
      <AwardSeal year={newest.year} width={88} decorative />
    </a>
    <div>
      <h2>Utmärkelsen {newest.year}</h2>
      {/* Andra meningen är en uppmaning och inte ett påstående. "Verksamheten
          står i 2026 års lista" upprepar det märket bredvid redan säger, medan
          "Se hela listan" pekar vidare. Länken bär hela uppmaningen så att den
          som hoppar mellan länkar med tangentbord hör vad den leder till. */}
      <p>
        {capitalise(numeral(newest.entry.run))} kontroller i rad utan anmärkning.
        {' '}<a href={path('utmarkelser', newest.year)}>Se hela {newest.year} års lista</a>.
      </p>
      {!e.distinction && (
        <p>Utmärkelsen avser den utgåvan. Vad som gäller nu står ovan.</p>
      )}
      {earlier.length > 0 && (
        <p>
          Verksamheten står också i {earlier.map((a, i) => (
            <>
              {i > 0 && (i === earlier.length - 1 ? ' och ' : ', ')}
              <a href={path('utmarkelser', a.year)}>{a.year}</a>
            </>
          ))} års {earlier.length === 1 ? 'lista' : 'listor'}.
        </p>
      )}
    </div>
  </section>
)}

<style>
  /* Luften följer märket. Med ett 56 px brett sigill i stället för en
     banderoll skulle 24 px runtom göra kortet till mest tomrum. */
  .award {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-8);
    padding: var(--s-4);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
  }

  .seal-link {
    display: block;
    flex: none;
  }

  /* `h2` som element, brödtextstorlek som form. Rutan är en notis bredvid
     innehållet och inte ett eget avsnitt, så den ska inte bära ett avsnitts
     rubrikstorlek. Dokumentstrukturen är en annan fråga än typografin. */
  .award h2 {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: 600;
    margin-bottom: var(--s-1);
  }

  .award p {
    font-size: var(--fs-body-s);
    line-height: 21px;
    color: var(--text-secondary);
  }

  .award p + p {
    margin-top: var(--s-2);
  }

  @media (max-width: 560px) {
    .award {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
