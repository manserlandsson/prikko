---
/**
 * Rättelsen och replikrätten, i sidopanelen.
 *
 * Rutan bar tidigare fem saker: bevakning, omdöme, rättelse, en kvittensrad
 * och verksamhetens egen väg in. Bevakningen och omdömet har flyttat till
 * handlingsraden direkt under rubriken, där Booli har sina, se
 * Handlingsrad.astro. Kvar står de två som vänder sig till en annan publik.
 *
 *   Rätta en uppgift    till /ratta, som redan är den publicerade vägen för
 *                       rättelse och genmäle. Verksamheten följer med i
 *                       adressen, så att formuläret där står ifyllt i stället
 *                       för att be någon skriva av sin egen restaurangs namn.
 *   Svara på en kontroll  verksamhetens replikrätt. Löftet i sidfoten och på
 *                       metodiksidan är att svaren publiceras oredigerade,
 *                       och den vägen måste alltid gå att hitta från sidan
 *                       svaret gäller. Se ownerComment i lib/db.ts.
 *
 * Att de INTE ligger i ögonhöjd är ett val och inte en nedprioritering. Den
 * som driver ett ställe letar aktivt efter vägen in och hittar en panel i
 * marginalen; besökaren som bara vill veta om stället är rent ska inte
 * behöva sortera bort två knappar som inte angår hen.
 */
import '../styles/konto.css';

interface Props {
  establishmentId: string;
  establishmentName: string;
  municipalitySlug: string;
}

const { establishmentId, establishmentName, municipalitySlug } = Astro.props;

/**
 * Verksamheten med i adressen till båda formulären.
 *
 * `sida` finns bara på rättelselänken och bär sökvägen hit. Redaktionen får
 * då veta exakt vilken sida anmälaren stod på, vilket är mer värt än namnet:
 * två verksamheter kan heta samma sak i samma kommun.
 */
const params = new URLSearchParams({
  id: establishmentId,
  kommun: municipalitySlug,
  namn: establishmentName,
});

const ownerHref = `/konto/verksamhet/?${params}`;
const correctionHref = `/ratta/?${params}&sida=${encodeURIComponent(Astro.url.pathname)}`;

/**
 * Vägen till fönsterdekalen, med verksamheten ifylld.
 *
 * Nyckeln räknas ur sidans egen sökväg och inte ur en ny prop. `/stockholm/ag/`
 * ÄR nyckeln så snart snedstrecken är av, och en prop till hade varit ett
 * andra ställe där kommun och slug kan råka skilja sig från adressen de sitter
 * på.
 *
 * Länken går till /dekal/ och inte rakt på /api/marke, alltså till sidan som
 * förklarar vad märket är och vad det inte är innan filen laddas ner. Ett
 * märke som hämtas utan att någon läst villkoren hamnar förr eller senare i ett
 * fönster med ordet "godkänd" bredvid sig.
 *
 * Raden ligger i ÄGARENS ruta och inte i handlingsraden, av samma skäl som
 * står i huvudet: den som driver stället letar aktivt, besökaren ska slippa.
 * Kostnaden är en `<a>` på 16 044 sidor, alltså omkring 110 byte rå per sida
 * och i praktiken ingenting efter komprimering, eftersom raden är identisk på
 * alla utom två tecken.
 */
const dekalHref = `/dekal/?v=${encodeURIComponent(Astro.url.pathname.replace(/^\/|\/$/g, ''))}`;
---

{/* Rubriken sade "Stämmer inte uppgifterna?" och knappen under den "Rätta en
    uppgift", alltså samma ord två gånger med tre rader emellan. Rubriken
    frågar nu utan att låna knappens ord. Knappen får däremot behålla sina
    tre: den står ensam i en panel och inte i handlingsraden, där kortheten
    kommer av att tre etiketter ska läsas som en uppsättning. */}
<h2 class="rubrik">Något som inte stämmer?</h2>

{/* Här stod "Allt på sidan kommer från kommunens egen kontroll. Ser du något
    som är fel, säg till." Två meningar som förklarade varifrån datan kommer
    och vad knappen under är till för, mellan en rubrik som frågar och en
    knapp som svarar. Rubriken plus knappen räcker. */}

<a class="btn-ghost" href={correctionHref}>Rätta en uppgift</a>

<p class="owner caption">
  <a href={ownerHref}>Driver du verksamheten? Svara på en kontroll</a>
  <a href={dekalHref}>Sätt upp märket i fönstret</a>
</p>

<style>
  /* Samma panelrubriknivå som resten av sidopanelen och som kommunhubben.
     Regeln står här och inte i sidmallen eftersom Astros scopeade selektorer
     inte korsar komponentgränser. */
  .rubrik {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    margin-top: var(--s-4);
  }

  /* Marginalen skiljer rubriken från gatufotot ovanför. Saknar verksamheten
     foto är rubriken panelens första barn, och då är luften panelens egen
     padding. */
  .rubrik:first-child { margin-top: 0; }

    /* Höjden är satt och inte räknad ur padding, exakt som .btn-primary i
       tokens.css. 11 plus 11 plus en 14/1-rad blev 36 utan ikon och 42 med,
       alltså två olika knappar i samma rad och båda under träffytegolvet.
       Se --h-tap i tokens.css. */
  .btn-ghost {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-top: var(--s-3);
    background: transparent;
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    height: var(--h-tap);
    padding-inline: 22px;
    font: 600 var(--fs-body-s)/1 var(--font-sans);
    cursor: pointer;
  }

  .btn-ghost:hover {
    background: var(--canvas);
    color: var(--text);
    text-decoration: none;
  }

  /* Två rader och inte en, med luft emellan. De vänder sig till samma person
     men gäller olika saker, och som en enda rad med punkt emellan läses de som
     en mening. */
  .owner {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
    text-align: center;
  }
</style>
