---
/**
 * Områdessidan: stadsdelen som egen adress, hel eller skuren på kategori.
 *
 * Sidan svarar på fyra saker och ingenting mer. Vilka ställen finns här, hur
 * ser det ut mot kommunen i stort, var i området ligger de, och vad finns
 * intill. Allt annat hör hemma på kommunhubben eller på verksamhetssidan.
 *
 * KATEGORISNITTET är samma sida med en smalare mängd, inte en egen mall. Det
 * är avsiktligt: `restauranger södermalm` och "allt på Södermalm" är två
 * sökningar men en och samma sorts svar, och två mallar för samma svar glider
 * isär. Vad snittet ändrar är rubriken, talen och listan. Vad det inte ändrar
 * är formen.
 *
 * Talen måste läsas ur RÄTT mängd. `slice` räknar hela området och `kategori`
 * räknar snittet, och en sida som blandar dem påstår att 607 restauranger på
 * Södermalm har områdets fördelning. Därför `vy` nedan: allt som är ett tal på
 * sidan hämtas därifrån och aldrig från `slice` direkt.
 *
 * Formen är kommunhubbens och kategorisidans: hårlinje och luft, inga ramar i
 * huvudkolumnen, ingen ingress som beskriver vad sidan innehåller. Kartan är
 * det enda som bär en ram, och den bär den för att en karta utan kant flyter
 * ihop med sidan.
 */
import Base from '../layouts/Base.astro';
import EstablishmentList from './EstablishmentList.astro';
import Filterrad from './Filterrad.astro';
import Kategorival from './Kategorival.astro';
import OmradeKarta from './OmradeKarta.astro';
import Pagination from './Pagination.astro';
import { formatNumber, type Establishment, type Municipality } from '../lib/data';
import { kartfragment, utsnitt } from '../lib/kartrutor';
import {
  areaBounds,
  areaPreposition,
  linkedAreas,
  municipalityCleanShare,
  nearbyAreas,
  type AreaCategorySlice,
  type AreaSlice,
} from '../lib/omraden';
import { pageUrl } from '../lib/pagination';
import { SITE, VERDICT } from '../lib/site';
import { absolute, path } from '../lib/urls';

interface Props {
  kommun: Municipality;
  slice: AreaSlice;
  /** Kategorisnittet sidan visar, eller null för hela området. */
  kategori?: AreaCategorySlice | null;
  /** Områdets alla kategorier, för filterraden. */
  kategorier?: AreaCategorySlice[];
  items: Establishment[];
  currentPage: number;
  lastPage: number;
  start: number;
  total: number;
}

const {
  kommun,
  slice,
  kategori = null,
  kategorier = [],
  items,
  currentPage,
  lastPage,
  start,
  total,
} = Astro.props;

const city = kommun.city;
const area = slice.area;
const kommunBase = `/${kommun.slug}`;
const omradeBase = `${kommunBase}/omrade/${area.slug}`;
const base = kategori ? `${omradeBase}/${kategori.category.slug}` : omradeBase;

const prep = areaPreposition(area.name);
const platsen = `${prep} ${area.name}`;

/**
 * Mängden sidans tal räknar. Se modulhuvudet.
 *
 * `total` kommer redan från routen och är snittets antal när ett snitt visas,
 * men fördelningen och jämförelsen måste hämta sina tal ur samma mängd, annars
 * beskriver bandet ett område medan rubriken beskriver en kategori.
 */
const vy = kategori ?? slice;

/*
 * Vad sidan handlar om, i löptext.
 *
 * Kategoriordet står i PLURAL och gemener eftersom det ska kunna stå mitt i en
 * mening: "607 restauranger på Södermalm". `plural` är fältet som bär den
 * formen, se TOP_CATEGORIES i lib/categories.ts.
 *
 * En reservation som hör hit och inte får tappas bort: butiksledets efterfrågan
 * är belagd under ordet MATAFFÄR, inte under ordet butiker. `butiker
 * södermalm` kompletteras med kläder, vintage och second hand, alltså en annan
 * bransch. Vi skriver ändå "butiker", för det är vad mängden ÄR, och en rubrik
 * som säger mataffärer om en lista som rymmer kiosker och apotek vore fel om
 * sitt eget innehåll. Kategorins `blurb` står under rubriken och säger
 * "Mataffärer, kiosker, hälsokost och apotek", vilket är där ordet hör hemma.
 */
const saken = kategori ? kategori.category.plural : 'verksamheter';

/*
 * Andelen räknas på BEDÖMDA och aldrig på totalen, samma regel som gäller
 * överallt annars på sajten. Med totalen som nämnare hade ett område där
 * kommunen kontrollerat lite sett sämre ut än ett där den kontrollerat mycket.
 */
const share = vy.assessed ? Math.round((vy.clean / vy.assessed) * 100) : 0;
const kommunen = municipalityCleanShare(kommun.slug);

/**
 * Kartan, och vägen vidare in i den delade vyn på områdets utsnitt.
 *
 * Ett enda anrop avgör båda, och det är kartsidans eget: en länk till en
 * kartsida som inte byggs är en 404, och de fyra kommuner som inte lämnar
 * koordinater har ingen. I praktiken har varje kommun med en områdessida också
 * en kartsida, men det är en följd och inte en garanti, och en följd är inget
 * att länka på.
 *
 * Rutan hämtade tidigare sitt villkor ur `mapDataset`, alltså ur en annan
 * modul än den länken bredvid frågade. Två svar på samma fråga blir förr eller
 * senare två olika svar.
 *
 * KARTAN STÅR BARA PÅ HELA OMRÅDETS SIDA. Områdeskartan ritar områdets alla
 * verksamheter och går inte att skära på kategori utan att kartlagret byggs om
 * per snitt. En karta som visar 1 197 punkter under en rubrik som säger 607
 * restauranger påstår något som inte stämmer, och det är en dyrare sorts fel
 * än en sida utan karta.
 */
const karta = kategori === null && utsnitt(kommun.slug);
const kartlank = karta ? path(kommunBase, 'karta') + kartfragment(areaBounds(area)) : null;

/*
 * Fördelningen som stapel och antal, i kommunhubbens egen form: en tunn rad
 * med färgband och siffror, inga rutor.
 *
 * Här stod tidigare precis samma tal utskrivna som mening, "1 197
 * verksamheter på Södermalm, 939 av de 1 037 vi kan bedöma fick inga
 * anmärkningar...". Det är den förklarande brödtext docs/18 förbjuder: talen
 * ska VISAS, inte berättas.
 *
 * Formen är KommunOversikts, men komponenten återanvänds inte. Dess rubrik
 * lyder "Fördelning i kommunen", vilket är fel påstående på en områdessida,
 * och den bär ett id som skulle bli en dubblett om båda sidorna använde den.
 * Att lägga till en rubrikflagga där hade ändrat en fil som hör till
 * kommunhubben för en sidtyp som inte gör det.
 *
 * Färgerna är bedömningens egna och betyder här vad de betyder överallt
 * annars. Varje segment bär sin etikett i text: färg ensam är aldrig ett
 * budskap.
 *
 * INGEN POST ÄR KLICKBAR HÄR, till skillnad från kommunhubbens rad. Det är
 * inte en lucka. Hubbens poster leder till /[kommun]/anmarkningar och till
 * kommunens eget avsnitt om vad kontrollen inte nått, och båda räknar HELA
 * kommunen. Talen i det här bandet räknar stadsdelen. En post som säger 74 och
 * leder till en sida som säger 774 är en sämre länk än ingen länk, och en
 * anmärkningssida per område vore en ny rutt per stadsdel för en sökning ingen
 * gör. Kommer det någon gång ett områdesurval att peka på hör länkarna hit,
 * inte förr.
 */
const segments = [
  { n: vy.clean, label: VERDICT.clean.label, surface: 'var(--verdict-clean)' },
  { n: vy.minor, label: VERDICT.minor.label, surface: 'var(--verdict-minor)' },
  { n: vy.major, label: VERDICT.major.label, surface: 'var(--verdict-major)' },
  // "Ingen bedömning" är inte en nivå och får aldrig läsas som en mild
  // variant av de andra. Därför grått, och därför sist.
  { n: total - vy.assessed, label: 'Ingen bedömning', surface: 'var(--verdict-none)' },
].filter((s) => s.n > 0);

const barLabel = segments.map((s) => `${s.label}: ${formatNumber(s.n)}`).join('. ');

/** Andel i hela procent. Visas inte under 1 %, eftersom "0 %" bredvid ett tal
 *  som inte är noll läser som ett fel. */
function share100(n: number): string | null {
  if (!total) return null;
  const pct = Math.round((n / total) * 100);
  return pct >= 1 ? `${pct} %` : null;
}

/*
 * Meningen nedan syns inte på sidan. Den är sidans meta-beskrivning, som
 * måste vara en mening, och den enda rad ett AI-svar sannolikt citerar.
 */
const answer =
  vy.assessed > 0
    ? `${formatNumber(total)} ${saken} ${platsen}. ${formatNumber(vy.clean)} av de ` +
      `${formatNumber(vy.assessed)} vi kan bedöma fick inga anmärkningar vid sin senaste ` +
      `hygienkontroll, ${formatNumber(vy.minor + vy.major)} fick anmärkningar.`
    : `${formatNumber(total)} ${saken} ${platsen}. Ingen av dem har en kontroll som går att bedöma.`;

const grannar = currentPage === 1 ? nearbyAreas(kommun.slug, area.slug) : [];

/*
 * Kommunens övriga områden, som filterrad överst.
 *
 * Härifrån gick det tidigare bara att komma till de sex närmaste grannarna,
 * längst ned i sidfoten. Raden når alla trettio i Stockholms fall, kostar en
 * rad i höjd och visar dessutom var man står.
 *
 * Sidfotens "Områden intill" står kvar och är inte en dubblett: den är
 * sorterad på avstånd och bär geografi, raden är i bokstavsordning och bär
 * register. Det är två olika frågor.
 *
 * Bara på sida 1. Den som bläddrat till sida 4 av ett område har redan valt.
 */
const omraden = currentPage === 1 ? linkedAreas(kommun.slug) : [];

/*
 * Rubriken bär KATEGORIN OCH PLATSEN, i den ordningen, och aldrig ordet betyg.
 *
 * Ordningen är sökningens egen: folk skriver `restauranger södermalm`, inte
 * `södermalm restauranger`. Ordet hygienkontroller står kvar först på hela
 * områdets sida, där mängden inte har något bättre namn, men ett snitt HAR ett
 * namn och ska bära det.
 *
 * `högst betyg` finns i svansen på nästan varje mätt fras och står ändå inte
 * här. Det är Googles stjärnbetyg i läsarens huvud och vi har inga stjärnor.
 * Regeln är docs/26 §8 punkt 5 och docs/29 §7, och den gäller även när
 * frasen bevisligen har volym.
 */
const rubrik = kategori
  ? `${kategori.category.name} ${platsen}`
  : `Hygienkontroller ${platsen}`;

const title =
  currentPage === 1
    ? `${rubrik}, ${city}`
    : `${rubrik}, ${city}, sida ${currentPage} av ${lastPage}`;

const description =
  currentPage === 1
    ? answer
    : `Verksamhet ${formatNumber(start)}–${formatNumber(start + items.length - 1)} av ` +
      `${formatNumber(total)} ${saken} ${platsen} i ${city}, i bokstavsordning. ` +
      `Sida ${currentPage} av ${lastPage}.`;

/*
 * Brödsmulan får ett steg till när ett snitt visas, så att området alltid går
 * att nå uppåt. Sista posten bär aldrig `item`: den är sidan man står på.
 */
const stigen: Array<{ name: string; item?: string }> = [
  { name: 'Prikko', item: absolute() },
  { name: kommun.name, item: absolute(kommunBase) },
  { name: area.name, item: kategori || currentPage > 1 ? absolute(omradeBase) : undefined },
];
if (kategori) {
  stigen.push({
    name: kategori.category.name,
    item: currentPage > 1 ? absolute(base) : undefined,
  });
}
if (currentPage > 1) stigen.push({ name: `Sida ${currentPage}` });

const crumbs = stigen.map((c, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: c.name,
  ...(c.item ? { item: c.item } : {}),
}));

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${kategori ? kategori.category.name : 'Verksamheter'} ${platsen}, ${city}`,
    numberOfItems: total,
    // Bara sidans egna poster, med sin riktiga position i hela listan.
    itemListElement: items.slice(0, 25).map((e, i) => ({
      '@type': 'ListItem',
      position: start + i,
      url: absolute(kommunBase, e.slug),
      name: e.name,
    })),
  },
];

const prev = currentPage > 1 ? pageUrl(base, currentPage - 1, SITE.url) : undefined;
const next = currentPage < lastPage ? pageUrl(base, currentPage + 1, SITE.url) : undefined;
---

<Base title={title} description={description} jsonLd={jsonLd} prev={prev} next={next}>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path(kommunBase)}>{city}</a>
      {(kategori || currentPage > 1) && (
        <>
          <span aria-hidden="true">›</span>
          <a href={path(omradeBase)}>{area.name}</a>
        </>
      )}
      {kategori && currentPage > 1 && (
        <>
          <span aria-hidden="true">›</span>
          <a href={path(base)}>{kategori.category.name}</a>
        </>
      )}
    </nav>

    <header class="head">
      <p class="eyebrow">{kommun.name}</p>
      <h1>
        {rubrik}
        {currentPage > 1 && <span class="text-secondary">, sida {currentPage}</span>}
      </h1>
      {/* Kategorins egen förklaring, ordagrant ur TOP_CATEGORIES. Den bär de
          ord efterfrågan faktiskt använder, alltså mataffär och förskola, och
          den finns redan skriven. Se resonemanget vid `saken` ovan. */}
      {kategori && <p class="blurb">{kategori.category.blurb}</p>}
      {/* Omfånget som tal, inte som mening. Samma form som kedjesidans rad
          under namnet. */}
      <p class="omfang">
        {formatNumber(total)} {saken}
        {currentPage > 1 && (
          <> · {formatNumber(start)}–{formatNumber(start + items.length - 1)}, sida {currentPage} av {lastPage}</>
        )}
      </p>
    </header>

    {/* Kategorivalet. Ett rutnät och inte filterraden, av samma skäl som på
        kommunhubben: fyra val är ett fast och känt antal som aldrig rullar.
        Ett snitt under gränsen står kvar med sin siffra men utan länk, precis
        som kategorierna gör där. Visas bara på sida 1: den som bläddrat till
        sida 4 har redan valt. */}
    {currentPage === 1 && kategorier.length > 1 && (
      <section class="filter" aria-labelledby="omradets-kategorier">
        <h2 id="omradets-kategorier" class="eyebrow">Verksamheter efter typ {platsen}</h2>
        <Kategorival
          label={`Verksamheter efter typ ${platsen}`}
          items={[
            {
              href: kategori ? path(omradeBase) : undefined,
              label: 'Alla',
              count: slice.count,
              ikon: 'alla' as const,
              current: kategori === null,
            },
            ...kategorier.map((c) => ({
              href: c.linked ? path(omradeBase, c.category.slug) : undefined,
              label: c.category.name,
              count: c.count,
              ikon: c.category.id,
              current: c.category.id === kategori?.category.id,
            })),
          ]}
        />
      </section>
    )}

    {/* Områdesväljaren. Riktiga länkar till de områdessidor som redan finns,
        alltså en genväg och inte en ersättning: adresserna är sidor för att de
        kan rankas, och de står kvar precis som de var. Se Filterrad.astro. */}
    {omraden.length > 1 && (
      <Filterrad
        label={`Områden i ${city}`}
        lead={{ href: path(kommunBase), label: `Hela ${city}`, count: undefined }}
        items={omraden.map((o) => ({
          /* Grannområdet nås alltid på sin egen rot, aldrig på det snitt man
             råkar stå i. Ett `restauranger`-led som följde med till Gamla stan
             hade lett till en sida som inte byggs där snittet ligger under
             gränsen, alltså till en 404. */
          href: path(kommunBase, 'omrade', o.area.slug),
          label: o.area.name,
          count: o.count,
          current: o.area.slug === area.slug,
        }))}
      />
    )}

    {currentPage === 1 && (
      <>
        <section class="fordelning" aria-labelledby="fordelning-rubrik">
          <h2 id="fordelning-rubrik" class="eyebrow">Bedömning, {saken} {platsen}</h2>

          <div class="bar" role="img" aria-label={barLabel}>
            {segments.map((s) => (
              <span style={`width:${(s.n / total) * 100}%;background:${s.surface}`}></span>
            ))}
          </div>

          {/* Två våningar per post, talet överst och etiketten under. Samma
              form som KommunOversikt.astro, av samma skäl: en enda tät rad med
              prick, tal, etikett och procent gånger fyra går inte att läsa i
              ett svep. */}
          <ul class="legend">
            {segments.map((s) => {
              const pct = share100(s.n);
              return (
                <li>
                  <span class="varde">
                    <b>{formatNumber(s.n)}</b>
                    {pct && <span class="pct">{pct}</span>}
                  </span>
                  <span class="lbl">
                    <span class="swatch" style={`background:${s.surface}`} aria-hidden="true"></span>
                    {s.label}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>

        {/* Jämförelsen mot kommunen i stort. Två tal under en etikett, inga
            rutor och ingen mening: det är data, inte ett resonemang. Står
            bara när båda talen har underlag, annars jämför den ingenting. */}
        {slice.assessed > 0 && kommunen.assessed > 0 && (
          <dl class="jamfor">
            <dt>Utan anmärkningar</dt>
            <dd><b>{share} %</b> {area.name}</dd>
            <dd><b>{kommunen.share} %</b> {city}</dd>
          </dl>
        )}

        {karta && (
          <div class="karta">
            <OmradeKarta kommun={kommun} area={area} count={total} />
            {/* Attributionen står här OCH i kartans hörn, av samma skäl som i
                Karta.astro: kravet är att den syns, och ett kontrollelement
                som kan fällas ihop är ingen garanti. */}
            {/* Vidare in i den delade vyn, på områdets eget utsnitt.
                Områdeskartan visar var stället ligger; den delade vyn kan
                sökas, filtreras och läsas rad för rad. Fragmentet räknas av
                lib/kartrutor.ts så att zoomen inte blir en gissning per
                sidmall. */}
            {kartlank && (
              <p class="vidare">
                <a href={kartlank}>Öppna {area.name} i hela kartan</a>
              </p>
            )}
            <p class="attribution text-muted">
              Kartdata och områdesgräns <a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer" target="_blank">© OpenStreetMap</a>,
              kakel från <a href="https://openfreemap.org" rel="noopener noreferrer" target="_blank">OpenFreeMap</a>.
            </p>
          </div>
        )}
      </>
    )}

    <EstablishmentList items={items} kommunSlug={kommun.slug} />

    <Pagination base={base} current={currentPage} last={lastPage} label={`${saken} ${platsen}`} />

    <footer class="foot">
      {grannar.length > 0 && (
        <nav aria-label={`Områden intill ${area.name}`}>
          <p class="text-secondary">Områden intill</p>
          <ul class="others">
            {grannar.map((g) => (
              <li>
                <a href={path(kommunBase, 'omrade', g.area.slug)}>
                  {g.area.name} <span class="text-muted">{formatNumber(g.count)}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <p>
        {kategori
          ? <a href={path(omradeBase)}>Se alla verksamheter {platsen}</a>
          : <a href={path(kommunBase)}>Se alla verksamheter i {city}</a>}
      </p>
    </footer>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-8) var(--s-12);
    max-width: var(--w-page);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-body-s);
    color: var(--text-muted);
    margin-bottom: var(--s-4);
  }

  .crumbs a { color: var(--text-secondary); }

  .head h1 {
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    margin-top: var(--s-1);
  }

  .head h1 span { font-weight: 400; }

  .blurb {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  /* Kategorivalet står mellan rubriken och bedömningen, som filterraden. */
  .filter { margin-top: var(--s-6); }

  .filter h2 { margin-bottom: var(--s-2); }

  .omfang {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  /* Filterraden står mellan rubriken och bedömningen. Måtten bor i
     Filterrad.astro, här bara luften omkring. */
  .page :global(.filterrad) { margin-top: var(--s-6); }

  /* Fördelningen. Samma mått och samma språk som kommunhubbens rad, se
     KommunOversikt.astro, där måtten och Ednia-mätningen bakom dem står
     skrivna: ett 24 px högt band med 8 px radie och en teckenförklaring i
     spalter. Inget kort, ingen ram. Formen bor på två ställen eftersom
     rubriken och id:t skiljer sig åt, se markupkommentaren, och de två
     kopiorna måste därför ändras tillsammans. */
  .fordelning { margin-top: var(--s-6); }

  .bar {
    display: flex;
    height: 24px;
    border-radius: var(--s-2);
    overflow: hidden;
    margin-top: var(--s-2);
    background: var(--verdict-none);
  }

  .bar > span { display: block; height: 100%; }

  .legend {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s-3) var(--s-4);
  }

  .varde {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  /* Färgprickens enda uppgift är att koppla posten till sitt segment i
     bandet. Betydelsen står i texten bredvid, så prickens kontrast bär ingen
     information. */
  .swatch {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    transform: translateY(-1px);
  }

  .legend b {
    font-size: var(--fs-h-xs);
