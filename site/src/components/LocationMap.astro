---
/**
 * Karta i sidopanelen — statisk bild, inte interaktiv karta.
 *
 * Skälet är hårt vunnet. Den interaktiva MapLibre-varianten gick sönder på
 * tre olika sätt: exportformen skilde sig mellan dev och byggd chunk
 * (maplibre-gl har ingen default-export), IntersectionObserver-initieringen
 * var beroende av scrollposition kontra skriptstart, och WebGL-ytan gick inte
 * att verifiera tillförlitligt. En `<img>` kan inte gå sönder på något av de
 * sätten. Den laddar direkt, kräver noll JavaScript och kan inte skada
 * Core Web Vitals.
 *
 * Det är dessutom vad Apple och Zillow själva gör i små ytor — interaktiv
 * karta sparas till vyer där kartan ÄR huvudsaken. Den kommer på stadssidan.
 *
 * Mapbox Static Images API: 50 000 bilder/mån gratis, kommersiellt tillåtet.
 * Attribution för själva KARTBILDEN bakas in i bilden av API:et.
 *
 * Nålen ritas som vårt eget ansiktsmärke ovanpå bilden i stället för att
 * skickas som overlay till Mapbox. Då slipper vi hosta en markörbild, och
 * märket blir exakt vårt — samma tecken som på resten av sajten.
 *
 * ## Varför härledda nålar måste märkas
 *
 * Uppsala och Örebro lämnar inga koordinater. Deras nålar är geokodade mot
 * OpenStreetMap i pipelinen (se prikko/geocode.py). Två skäl att skriva ut det:
 *
 * 1. Juridiskt. OSMF:s Geocoding Guideline tillåter att en härledd koordinat
 *    lagras och visas, men kräver attribution DÄR den visas. Mapbox inbakade
 *    "© OpenStreetMap" gäller kartbilden, inte vår nål, och täcker alltså inte
 *    kravet.
 * 2. Redaktionellt, och det tyngre skälet. En nål som ser likadan ut oavsett
 *    om kommunen lämnat punkten eller om vi räknat fram den påstår en säkerhet
 *    vi inte har. Härledda nålar får därför en synlig osäkerhetsring, och de
 *    228 som bara matchat grannporten en vidare ring.
 */
import FaceMark from './FaceMark.astro';
import type { VerdictOrNone } from '../lib/site';

interface Props {
  lat: number;
  lng: number;
  name: string;
  verdict: VerdictOrNone;
  /** Satt bara när koordinaten är härledd ur adressen, inte lämnad av kommunen. */
  geoSource?: 'osm';
  /** 'address' = adressens egen punkt. 'approximate' = grannporten. */
  geoPrecision?: 'address' | 'approximate';
}

const { lat, lng, name, verdict, geoSource, geoPrecision } = Astro.props;

// Saknas geoSource kommer punkten från kommunen och ska inte märkas.
const derived = geoSource === 'osm';
const approximate = derived && geoPrecision === 'approximate';

const token = import.meta.env.PUBLIC_MAPBOX_TOKEN;

// light-v11 är Mapbox nedtonade stil: ljus, låg mättnad, få etiketter.
// Samma återhållsamhet som gör Apples kartor rena.
const STYLE = 'mapbox/light-v11';
const WIDTH = 300;
const HEIGHT = 170;
const ZOOM = 14.2;   // utzoomad så kvarteret syns, inte bara huset

const src = token
  ? `https://api.mapbox.com/styles/v1/${STYLE}/static/${lng},${lat},${ZOOM},0/${WIDTH}x${HEIGHT}@2x?access_token=${token}`
  : null;

const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=17/${lat}/${lng}`;

const alt = derived
  ? `Karta som visar den beräknade platsen för ${name}`
  : `Karta som visar var ${name} ligger`;
---

{src && (
  <figure class="map">
    <div class="frame">
      <img
        src={src}
        alt={alt}
        width={WIDTH}
        height={HEIGHT}
        loading="lazy"
        decoding="async"
      />
      <span class:list={['pin', derived && 'derived', approximate && 'wide']}>
        <FaceMark verdict={verdict} size={34} />
      </span>
    </div>
    <figcaption class="text-muted">
      {derived && (
        <span class="derived-note">
          Platsen är beräknad från adressen, inte lämnad av kommunen.
          {approximate && ' Husnumret saknas i kartdatan, så nålen står vid närmaste grannport.'}
          {' '}Kartdata ©{' '}
          <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener noreferrer"
          >OpenStreetMap</a>.
        </span>
      )}
      <a href={osm} target="_blank" rel="noopener noreferrer">Öppna större karta</a>
    </figcaption>
  </figure>
)}

<style>
  .map { margin: 0; }

  .frame {
    position: relative;
    border-radius: var(--r-control);
    overflow: hidden;
    background: var(--canvas);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Nålen sitter i bildens mitt, som är exakt punkten vi centrerat på.
     Förskjuts uppåt så märkets underkant pekar på platsen. */
  .pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .28));
  }

  .pin :global(.face) {
    border: 2px solid #fff;
    border-radius: 11px;
  }

  /* Osäkerhetsring för härledd punkt. Samma grepp som mobilkartornas
     positionsring: nålen står kvar där den står, men ringen visar att den
     har en tolerans. Ritad på ::before så den ligger under märket. */
  .pin.derived::before {
    content: '';
    position: absolute;
    top: 60%;
    left: 50%;
    width: 66px;
    height: 66px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, .22);
    background: rgba(0, 0, 0, .06);
  }

  /* Grannportsträff: samma signal, vidare ring. */
  .pin.wide::before {
    width: 104px;
    height: 104px;
  }

  /* Kartbildens egen attribution bakas in av Mapbox. Texten här gäller något
     annat: att NÅLEN är härledd ur OpenStreetMap. Se komponentens inledning. */
  figcaption {
    margin-top: 6px;
    font-size: 11px;
    line-height: 14px;
  }

  .derived-note {
    display: block;
    margin-bottom: 4px;
  }
</style>
