---
/**
 * Karta i sidopanelen — statisk bild, inte interaktiv karta.
 *
 * Skälet är hårt vunnet. Den interaktiva MapLibre-varianten gick sönder på
 * tre olika sätt: exportformen skilde sig mellan dev och byggd chunk
 * (maplibre-gl har ingen default-export), IntersectionObserver-initieringen
 * var beroende av scrollposition kontra skriptstart, och WebGL-ytan gick inte
 * att verifiera tillförlitligt. En `<img>` kan inte gå sönder på något av de
 * sätten. Den laddar direkt, kräver noll JavaScript och kan inte skada
 * Core Web Vitals.
 *
 * Det är dessutom vad Apple och Zillow själva gör i små ytor — interaktiv
 * karta sparas till vyer där kartan ÄR huvudsaken. Den kommer på stadssidan.
 *
 * Mapbox Static Images API: 50 000 bilder/mån gratis, kommersiellt tillåtet.
 * Attribution bakas in i bilden av API:et.
 *
 * Nålen ritas som vårt eget ansiktsmärke ovanpå bilden i stället för att
 * skickas som overlay till Mapbox. Då slipper vi hosta en markörbild, och
 * märket blir exakt vårt — samma tecken som på resten av sajten.
 */
import FaceMark from './FaceMark.astro';
import type { VerdictOrNone } from '../lib/site';

interface Props {
  lat: number;
  lng: number;
  name: string;
  verdict: VerdictOrNone;
}

const { lat, lng, name, verdict } = Astro.props;

const token = import.meta.env.PUBLIC_MAPBOX_TOKEN;

// light-v11 är Mapbox nedtonade stil: ljus, låg mättnad, få etiketter.
// Samma återhållsamhet som gör Apples kartor rena.
const STYLE = 'mapbox/light-v11';
const WIDTH = 300;
const HEIGHT = 170;
const ZOOM = 15.2;

const src = token
  ? `https://api.mapbox.com/styles/v1/${STYLE}/static/${lng},${lat},${ZOOM},0/${WIDTH}x${HEIGHT}@2x?access_token=${token}`
  : null;

const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=17/${lat}/${lng}`;
---

{src && (
  <figure class="map">
    <div class="frame">
      <img
        src={src}
        alt={`Karta som visar var ${name} ligger`}
        width={WIDTH}
        height={HEIGHT}
        loading="lazy"
        decoding="async"
      />
      <span class="pin">
        <FaceMark verdict={verdict} size={34} />
      </span>
    </div>
    <figcaption class="text-muted">
      <a href={osm} target="_blank" rel="noopener noreferrer">Öppna större karta</a>
    </figcaption>
  </figure>
)}

<style>
  .map { margin: 0; }

  .frame {
    position: relative;
    border-radius: var(--r-control);
    overflow: hidden;
    background: var(--canvas);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Nålen sitter i bildens mitt, som är exakt punkten vi centrerat på.
     Förskjuts uppåt så märkets underkant pekar på platsen. */
  .pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .28));
  }

  .pin :global(.face) {
    border: 2px solid #fff;
    border-radius: 11px;
  }

  /* Attribution bakas in i bilden av Mapbox — ingen egen text behövs. */
  figcaption {
    margin-top: 6px;
    font-size: 11px;
    line-height: 14px;
  }
</style>
