---
/**
 * Karta i sidopanelen — statisk bild, inte interaktiv karta.
 *
 * Skälet är hårt vunnet. Den interaktiva MapLibre-varianten gick sönder på
 * tre olika sätt: exportformen skilde sig mellan dev och byggd chunk
 * (maplibre-gl har ingen default-export), IntersectionObserver-initieringen
 * var beroende av scrollposition kontra skriptstart, och WebGL-ytan gick inte
 * att verifiera tillförlitligt. En `<img>` kan inte gå sönder på något av de
 * sätten. Den laddar direkt, kräver noll JavaScript och kan inte skada
 * Core Web Vitals.
 *
 * Det är dessutom vad Apple och Zillow själva gör i små ytor — interaktiv
 * karta sparas till vyer där kartan ÄR huvudsaken. Den kommer på stadssidan.
 *
 * Mapbox Static Images API: 50 000 bilder/mån gratis, kommersiellt tillåtet.
 * Attribution för själva KARTBILDEN bakas in i bilden av API:et.
 *
 * Nålen ritas som vårt eget ansiktsmärke ovanpå bilden i stället för att
 * skickas som overlay till Mapbox. Då slipper vi hosta en markörbild, och
 * märket blir exakt vårt — samma tecken som på resten av sajten.
 *
 * ## Härledda nålar
 *
 * Uppsala och Örebro lämnar inga koordinater. Deras nålar är geokodade mot
 * OpenStreetMap i pipelinen (se prikko/geocode.py). En nål som ser likadan ut
 * oavsett om kommunen lämnat punkten eller om vi räknat fram den påstår en
 * säkerhet vi inte har, så härledda nålar ritas med streckad kant.
 *
 * Under kartan stod tidigare en bildtext som sa samma sak i ord, plus
 * "Kartdata © OpenStreetMap". Den är borttagen på ägarens begäran: den
 * upprepades på var och en av sidorna och läste som en brasklapp.
 *
 * Två saker att veta om det beslutet:
 *
 * 1. Den streckade kanten är nu en konvention utan förklaring i gränssnittet.
 *    Ordet "beräknade" i bildens alt-text är det enda som återstår i klartext.
 * 2. OSMF:s Geocoding Guideline tillåter att en härledd koordinat lagras och
 *    visas, men kräver attribution där den visas. Bedömningen som gjordes när
 *    bildtexten skrevs var att Mapbox inbakade "© OpenStreetMap" gäller
 *    kartbilden och inte vår nål. Ägaren har gjort den motsatta bedömningen,
 *    att den inbakade attributionen räcker. Ändras den bedömningen igen hör
 *    upplysningen hemma på /metodik, inte som en rad per verksamhetssida.
 */
import FaceMark from './FaceMark.astro';
import type { VerdictOrNone } from '../lib/site';

interface Props {
  lat: number;
  lng: number;
  name: string;
  verdict: VerdictOrNone;
  /** Satt bara när koordinaten är härledd ur adressen, inte lämnad av kommunen. */
  geoSource?: 'osm';
}

const { lat, lng, name, verdict, geoSource } = Astro.props;

// Saknas geoSource kommer punkten från kommunen och ska inte märkas.
const derived = geoSource === 'osm';

const token = import.meta.env.PUBLIC_MAPBOX_TOKEN;

// light-v11 är Mapbox nedtonade stil: ljus, låg mättnad, få etiketter.
// Samma återhållsamhet som gör Apples kartor rena.
const STYLE = 'mapbox/light-v11';
const WIDTH = 300;
const HEIGHT = 170;
/*
 * 13.4. Var 14.2, och dessförinnan högre.
 *
 * En karta som visar kvarteret svarar på frågan "exakt var ligger porten",
 * men det är inte den fråga någon ställer här. Den som läser om en restaurang
 * vill veta VAR I STAN den ligger, och vid 14.2 fanns inte tillräckligt många
 * kända hållpunkter i bild för att man skulle kunna placera den.
 *
 * Ett steg ut, alltså några kvarter i stället för ett. Nålen är fortfarande
 * exakt, det är omgivningen som blivit läsbar.
 */
const ZOOM = 13.4;

const src = token
  ? `https://api.mapbox.com/styles/v1/${STYLE}/static/${lng},${lat},${ZOOM},0/${WIDTH}x${HEIGHT}@2x?access_token=${token}`
  : null;

const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=17/${lat}/${lng}`;

const alt = derived
  ? `Karta som visar den beräknade platsen för ${name}`
  : `Karta som visar var ${name} ligger`;
---

{src && (
  <figure class="map">
    <div class="frame">
      <img
        src={src}
        alt={alt}
        width={WIDTH}
        height={HEIGHT}
        loading="lazy"
        decoding="async"
      />
      <span class:list={['pin', derived && 'derived']}>
        <FaceMark verdict={verdict} size={34} />
      </span>
    </div>
    <figcaption class="text-muted">
      <a href={osm} target="_blank" rel="noopener noreferrer">Öppna större karta</a>
    </figcaption>
  </figure>
)}

<style>
  .map { margin: 0; }

  .frame {
    position: relative;
    border-radius: var(--r-control);
    overflow: hidden;
    background: var(--canvas);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Nålen sitter i bildens mitt, som är exakt punkten vi centrerat på.
     Förskjuts uppåt så märkets underkant pekar på platsen. */
  .pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .28));
  }

  .pin :global(.face) {
    border: 2px solid #fff;
    border-radius: 11px;
  }

  /* Härledd punkt: streckad kant i stället för hel.
     Samma konvention som kartor använder för en preliminär gräns, och den
     säger "den här punkten är inte fastställd" utan att påstå hur långt fel
     den kan vara.
     Här stod först en osäkerhetsring i stil med mobilkartornas
     positionsring. Den fick skrotas: vid zoom 14.2 motsvarar en ring som alls
     syns bakom det 34 px stora märket runt 280 meter, medan geokodningens
     verkliga tolerans är tiotals meter. En ring som är ärlig är mindre än
     nålen, och en ring som syns ljuger grovt. Kanten kan inte göra det
     felet, eftersom den inte mäter något. */
  .pin.derived :global(.face) {
    border-style: dashed;
  }

  /* Bär numera bara länken till den stora kartan. Kartbildens attribution
     bakas in av Mapbox nere till höger i själva bilden. */
  figcaption {
    margin-top: 6px;
    font-size: 11px;
    line-height: 14px;
  }
</style>
