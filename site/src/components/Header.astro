---
/**
 * Global header.
 *
 * Wordmarken är Måns egen logotyp från Figma, inlinad som SVG: ingen extra
 * request, inget layoutskift, och den kan färgsättas med currentColor. Filen
 * finns även i brand/prikko-wordmark.svg — ändras den ena ska den andra följa.
 *
 * Länkar alltid till roten. Googles interna länkgraf börjar här.
 *
 * Menyn ligger längst till höger. Den hette platsväljare och bar en lista över
 * kommunerna; listan är borta, se PlacePicker.astro. Kvar är rättelse, tre
 * länkar om oss och kontot.
 *
 * Sökfältet ligger i mitten och är sajtens enda väg till en kommun, en
 * verksamhet, en karta, en sida eller en artikel. /sok finns kvar som
 * formulärets mål och som landningssida, men behöver ingen menyrad.
 */
import { SITE } from '../lib/site';
import PlacePicker from './PlacePicker.astro';
import SiteSearch from './SiteSearch.astro';

interface Props {
  /**
   * Falskt på en sida som inte ska bära fältet i raden alls. Utan fältet
   * försvinner också underkanten: sidhuvudet ska då läsa som ETT vitt band
   * med wordmarken som avsändarrad, inte som en tom rad med två saker i var
   * sin ände ovanför en linje.
   *
   * En sida får aldrig två sökfält. SiteSearch ankrar sitt skript i
   * document.querySelector och fält-id:t site-search-q är skrivet en gång.
   * Startsidan sätter därför `hem` i stället för att stänga av fältet och
   * rita en andra instans i sidan: docken nedan flyttar den enda instansen.
   */
  search?: boolean;
  /**
   * Startsideläget: fältet ligger kvar HÄR men ritas stort och centrerat
   * nere i sidan tills man rullar, och far då upp i raden. Se .sokdock i
   * stilblocket och skriptet längst ned för hur och varför.
   *
   * Läget kräver att sidan bär ett tomrum på 96 px överst där det stora
   * fältet ska hänga. index.astro gör det med .storsok, och de två måtten
   * måste hållas i takt: fältet står på top 88 och är 56 högt.
   */
  hem?: boolean;
}

const { search = true, hem = false } = Astro.props;
---

<header class:list={[!search && 'plain', hem && 'hem']} data-huvud>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name}, till startsidan`}>
      <svg
        class="wordmark"
        viewBox="0 0 159 59"
        role="img"
        aria-label={SITE.name}
      >
        <path d="M139.5 20.5c1.657 0 3 1.343 3 3s-1.343 3-3 3-3-1.343-3-3 1.343-3 3-3Z" fill="currentColor" stroke="currentColor"/>
        <path class="eye-right" d="M152.5 20.5c1.657 0 3 1.343 3 3s-1.343 3-3 3-3-1.343-3-3 1.343-3 3-3Z" fill="currentColor" stroke="currentColor"/>
        <path d="M135 34c7 6.667 14 6.667 21 0" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" fill="none"/>
        <path
          fill="currentColor"
          d="M2.44 49V19.24h4.92v4.32l-.48-1.08c.747-1.173 1.76-2.08 3.04-2.72 1.28-.667 2.76-1 4.44-1 2.053 0 3.907.507 5.56 1.52 1.653 1.013 2.96 2.373 3.92 4.08.987 1.707 1.48 3.627 1.48 5.76 0 2.107-.48 4.027-1.44 5.76-.96 1.733-2.267 3.107-3.92 4.12-1.653.987-3.533 1.48-5.64 1.48-1.573 0-3.027-.307-4.36-.92-1.307-.64-2.347-1.547-3.12-2.72l.84-1.04V49H2.44Zm11.28-12.32c1.2 0 2.267-.28 3.2-.84.933-.56 1.653-1.333 2.16-2.32.533-.987.8-2.12.8-3.4 0-1.28-.267-2.4-.8-3.36-.507-.987-1.227-1.76-2.16-2.32-.933-.587-2-.88-3.2-.88-1.147 0-2.187.28-3.12.84-.907.56-1.627 1.347-2.16 2.36-.507.987-.76 2.107-.76 3.36 0 1.28.253 2.413.76 3.4.533.987 1.253 1.76 2.16 2.32.933.56 1.973.84 3.12.84ZM29.315 41V19.24h4.92v4.84l-.4-.72c.507-1.627 1.293-2.76 2.36-3.4 1.093-.64 2.4-.96 3.92-.96h1.28v4.64h-1.88c-1.493 0-2.693.467-3.6 1.4-.907.907-1.36 2.187-1.36 3.84V41h-5.24ZM44.276 41V19.24h5.24V41h-5.24Zm0-24.2v-5.6h5.24v5.6h-5.24ZM54.354 41V10.72h5.24v19.84l-2-.6 10.24-10.72h6.52l-8.04 8.76 8.2 13h-6l-7.12-11.28 3.12-.64-6.56 7.04 1.64-3.2V41h-5.24ZM77.44 41V10.72h5.24v19.84l-2-.6 10.24-10.72h6.52l-8.04 8.76 8.2 13h-6l-7.12-11.28 3.12-.64-6.56 7.04 1.64-3.2V41h-5.24ZM110.775 41.48c-2.133 0-4.08-.493-5.84-1.48-1.733-.987-3.12-2.333-4.16-4.04-1.013-1.707-1.52-3.653-1.52-5.84 0-2.187.507-4.133 1.52-5.84 1.04-1.707 2.427-3.053 4.16-4.04 1.734-.987 3.68-1.48 5.84-1.48 2.134 0 4.067.493 5.8 1.48 1.734.987 3.107 2.333 4.12 4.04 1.04 1.68 1.56 3.627 1.56 5.84 0 2.187-.52 4.133-1.56 5.84-1.04 1.707-2.426 3.053-4.16 4.04-1.733.987-3.653 1.48-5.76 1.48Zm0-4.8c1.174 0 2.2-.28 3.08-.84.907-.56 1.614-1.333 2.12-2.32.534-1.013.8-2.147.8-3.4 0-1.28-.266-2.4-.8-3.36-.506-.987-1.213-1.76-2.12-2.32-.88-.587-1.906-.88-3.08-.88-1.2 0-2.253.293-3.16.88-.906.56-1.626 1.333-2.16 2.32-.506.96-.76 2.08-.76 3.36 0 1.253.254 2.387.76 3.4.534.987 1.254 1.76 2.16 2.32.907.56 1.96.84 3.16.84Z"
        />
      </svg>
    </a>

    {search && !hem && <SiteSearch />}

    {/*
      Metodik och Om låg tidigare här bredvid menyknappen. De finns nu i
      menyn, och att visa samma två länkar på två ställen i samma rad gör
      raden rörig utan att göra något lättare att hitta.

      Sidhuvudet är därmed tre saker: märket, sökfältet och menyn. Allt
      annat bor i menyn eller i sidfoten, som är fullständig.
    */}

    <PlacePicker />
  </div>

  {/* Ett enda fält, två lägen. En sida får aldrig bära två instanser:
      SiteSearch ankrar sitt skript i document.querySelector och fältets id
      site-search-q är skrivet en gång. Docken flyttar och skalar just den
      instansen i stället för att rita en andra. */}
  {hem && (
    <div class="sokdock">
      <SiteSearch size="hero" />
    </div>
  )}
</header>

<style>
  /* Sidhuvudet ligger ÖVER sidan, inte i den.
   *
   * Utan det här målades sökförslagen under innehållet. Kedjan: .site-search
   * har transform (centreringen nedan), och en transform som inte är none
   * skapar en egen staplingskontext. Panelens z-index: 50 ordnar därför bara
   * syskon inne i sökfältet och kan inte ta sig ut. Utåt räknas hela
   * sidhuvudet som z-index auto, alltså nivå noll, och där avgör
   * dokumentordning: allt positionerat som kommer senare målas ovanpå.
   * Kommunsidans hero-scrim gjorde precis det, mitt genom förslagslistan.
   *
   * Att lyfta sidhuvudet är rätt lösning och inte en lapp: sidhuvudet ska
   * ligga överst oavsett vad sidan under innehåller. Det gäller lika mycket
   * platsväljarens panel, som har samma z-index 50 och samma inneslutning.
   *
   * 60 är valt mot skalan som finns: InfoTip 20 är det högsta i innehållet,
   * panelerna 50 gäller bara inuti sidhuvudet, och skip-länken i Base 100
   * måste ligga kvar överst av allt. 60 är över allt sidinnehåll med
   * marginal och under skip-länken med marginal. */
  header {
    position: relative;
    z-index: 60;
    background: var(--card);
    border-bottom: 1px solid var(--hairline);
  }

  /* Startsideläget, se Props. Ingen linje mellan sidhuvud och hero. */
  header.plain { border-bottom: 0; }

  /* ══ STARTSIDANS SÖKDOCK ═══════════════════════════════════════════════
   *
   * Ägaren 2026-08-20: "airbnb har också typ att sökbaren och lite filter
   * eller kategorier är stora i början, sen när man scrollar ner så petas
   * sökbaren upp och blir lite mer simpel, något sånt kan ju va smart."
   *
   * Uppmätt på airbnb.se 2026-08-21, se docs/40 §3. Deras fält går från
   * 850 × 66 till 458 × 46, och hela sidhuvudsblocket bär
   *
   *     transition: transform 0.451754s
   *                 linear(0 0%, 0.185572 10%, 0.465306 20%, 0.682334 30%,
   *                        0.822325 40%, 0.904974 50%, 0.951289 60%,
   *                        0.976364 70%, 0.989612 80%, 0.996485 90%, 1 100%)
   *
   * alltså 452 ms med en fjäder samplad i elva steg. Kurvan står ordagrant i
   * --fjader nedan och används på både läge och bredd.
   *
   * VARFÖR HÖJDEN ALDRIG ANIMERAS. Att låta sidhuvudet krympa från 236 till
   * 64 px hade varit den uppenbara lösningen och den är fel: 172 px
   * omflödning per bildruta, i 452 ms, på en sida med tvåhundra kort. Docken
   * är i stället `position: absolute` i ett sidhuvud som ALLTID är 64 px
   * högt, och det stora läget hänger ut nedanför sidhuvudets underkant över
   * sidans egna 144 px tomrum (.storsok i index.astro). Ihopfällningen rör
   * därmed bara `top`, `width` och `height` på ETT element, och sidan under
   * står helt stilla.
   *
   * `overflow: visible` på sidhuvudet är alltså ett krav och inte en
   * slentrian: docken sticker ut nedanför det. */
  header.hem {
    --fjader: linear(
      0 0%, 0.185572 10%, 0.465306 20%, 0.682334 30%, 0.822325 40%,
      0.904974 50%, 0.951289 60%, 0.976364 70%, 0.989612 80%, 0.996485 90%, 1 100%
    );
    position: sticky;
    top: 0;
    overflow: visible;
    border-bottom: 0;
  }

  /* Underkanten kommer först när fältet har landat i raden. Vid vila ska
     sidhuvud och det stora fältet läsa som ETT vitt band, inte som en rad
     med en linje under och något stort hängande nedanför den. */
  header.hem.kompakt { border-bottom: 1px solid var(--hairline); }

  .sokdock {
    position: absolute;
    left: 50%;
    top: 88px;
    z-index: 2;
    /* 600 och inte 680. SiteSearch sätter `max-width: 600px` på sitt
       hero-läge, så ett bredare omslag ger bara luft på var sida och en
       bredd som inte stämmer med fältet i den. Airbnbs eget fält är 850,
       men deras är ett trepartsformulär och vårt är ETT fält. */
    width: min(600px, calc(100vw - 2 * var(--s-6)));
    transform: translateX(-50%);
    transition:
      top var(--fjader-tid) var(--fjader),
      width var(--fjader-tid) var(--fjader);
    --fjader-tid: .452s;
  }

  header.hem.kompakt .sokdock {
    top: 10px;
    width: min(380px, 34vw);
  }

  /* MENYN ÄR ÖPPEN: docken går undan.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22: "sök baren syns också när man öppnar hamburgaremenyn."

     Två fel i ett. Det tekniska: menypanelen är `position: fixed` med
     `z-index: 1` och docken `z-index: 2`, så docken målades ovanpå panelen
     och dolde "Rätta en uppgift" och "Jämför två ställen". Ingen annan sida
     visade det, eftersom bara startsidan har en dock som hänger ned över
     sidan.

     Det andra är att en z-index-rättning inte hade räckt. Panelen är en yta
     som tar hela mitten av skärmen, och ett sökfält som ligger kvar ovanpå
     den, halvt skymt, är fortfarande fel. Docken tonas därför bort helt så
     länge menyn står öppen.

     `.picker` är ett `<details>`, alltså är `[open]` sanningen om läget och
     inget skript behövs. */
  header.hem:has(.picker[open]) .sokdock {
    opacity: 0;
    pointer-events: none;
    transition: opacity .15s cubic-bezier(.2, 0, 0, 1);
  }

  /* Fältets egen höjd. 56 utfällt och 44 ihopfällt, alltså --h-field i det
     ihopfällda läget. Airbnb går 66 → 46; vårt fält är ETT fält och inte
     ett trepartsformulär, och 66 px på en enda rad text blir en platta. */
  .sokdock :global(.search-field) {
    height: 56px;
    transition: height var(--fjader-tid) var(--fjader);
  }

  header.hem.kompakt .sokdock :global(.search-field) {
    height: var(--h-field);
  }

  /* Skuggan byter i 175 ms och inte i 452, uppmätt: Airbnbs kompakta piller
     bär `box-shadow 0.175s cubic-bezier(0.2, 0, 0, 1)`. Den ska landa före
     rörelsen, annars ser fältet ut att tappa sin platta på vägen upp. */
  .sokdock :global(.search-field) {
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .02), 0 8px 24px rgba(0, 0, 0, .10);
    transition:
      height var(--fjader-tid) var(--fjader),
      box-shadow .175s cubic-bezier(.2, 0, 0, 1);
  }

  header.hem.kompakt .sokdock :global(.search-field) {
    box-shadow: 0 1px 2px rgba(0, 0, 0, .08), 0 4px 12px rgba(0, 0, 0, .05);
  }

  /* KNAPPEN MÅSTE KRYMPA MED FÄLTET.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22: "cirkeln för sök i högre hörnet ser ej alignad ut."

     Uppmätt, och han har rätt: fältet var 44 px högt och knappen 44 px, alltså
     noll luft över och under men sex på höger sida. Ögat läser det inte som
     "stor knapp" utan som "knappen sitter snett", eftersom luften finns på
     ena ledden och inte på den andra.

     SiteSearch sätter 44 px på knappen i sitt hero-läge, vilket är rätt i ett
     56 px fält: (56 − 44) / 2 = 6, samma som fältets högerfyllning. Docken
     krympte fältet till 44 utan att röra knappen, och då gick räkningen inte
     ihop.

     34 i ett 44 px fält ger (44 − 34) / 2 = 5, alltså exakt fältets egna
     5 px fyllning på alla fyra sidor. Airbnbs kompakta piller mäter 46 högt
     med en 32 px knapp, alltså samma princip och samma storleksordning. */
  /* IHOPFÄLLNINGEN TAR BORT VAR-DELEN, och det är det som gör rörelsen till
     en funktion i stället för en storleksändring.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22: "vad fyller sökbarens animationen för funktion nu? det
     ska ju vara som airbnb att söket blir mer utevecklat eller?"

     Airbnbs utfällda läge är ett trepartsformulär som fälls ihop till ETT
     piller med tre etiketter. Vårt utfällda läge är två delar, Vad och Var,
     och det ihopfällda är ett fält. Utfällt frågar sidan alltså mer än
     ihopfällt, vilket var hela poängen.

     `display: none` och inte `opacity`: delen bär ett formulärfält och en
     knapp, och en knapp man kan tabba till men inte se är värre än ingen
     knapp. Det dolda `kommun`-fältet följer med och skickas alltså inte
     heller i det kompakta läget, vilket är rätt: valet syns inte, då ska det
     inte gälla. */
  header.hem.kompakt .sokdock :global(.var) { display: none; }

  header.hem.kompakt .sokdock :global(.go) {
    width: 34px;
    height: 34px;
  }

  header.hem.kompakt .sokdock :global(.go svg) {
    width: 16px;
    height: 16px;
  }

  /* Telefon: inget utfällt läge alls.
     Airbnbs egen mobilstartsida, uppmätt 2026-08-21, har ett fält i full
     bredd överst och ingen ihopfällning. 680 px av ett 390 px fönster finns
     inte, och 144 px tomrum överst på en 812 px skärm är en sjättedel av
     sidan. Docken sitter därför i raden från början och rör sig aldrig; det
     är också därför .storsok är 0 px hög under samma brytpunkt. */
  @media (max-width: 700px) {
    header.hem .sokdock,
    header.hem.kompakt .sokdock {
      top: 10px;
      width: auto;
      left: auto;
      /* MENYKNAPPEN SKA INTE LIGGA UNDER FÄLTET.
         ──────────────────────────────────────────────────────────────────
         Ägaren 2026-08-24: "varför syns ej hamburgareikonen i headern på
         mobile om man är på home, men syns fint väl inne på en
         restaurangsida?"

         Skälet: bara startsidan har klassen `hem`, och bara då finns
         sökdocken. Här stod `right: var(--s-4)`, alltså 16 px från kanten,
         och docken slutade därmed på exakt samma pixel som menyknappen.
         Uppmätt vid 375: docken 132 till 359 med z-index 2, knappen 323 till
         359 med z-index auto. Fältet låg alltså rakt ovanpå hamburgaren, och
         eftersom docken har ett högre lager fångade den även klicken.

         Kommentaren nedan räknade redan med knappens 36 px men marginalen
         drog aldrig av dem. 16 plus 36 plus 8 px luft lägger fältets högra
         kant på 315 och knappen står fri från 323. */
      right: calc(var(--s-4) + 36px + var(--s-2));
      transform: none;
      /* Wordmarken är 97 px plus radens indrag, menyknappen 36 plus samma.
         Fältet tar allt däremellan. */
      inset-inline-start: 132px;
      transition: none;
    }

    /* `header.hem` står med i BÅDA väljarna, och det är inte slentrian.
       SiteSearch sätter höjden med `.site-search.is-hero .search-field`,
       alltså tre klasser. Utan sidhuvudet i väljaren blir vår två, och
       fältet blir 54 px på telefon i stället för 44. */
    header.hem .sokdock :global(.search-field),
    header.hem.kompakt .sokdock :global(.search-field) {
      height: var(--h-field);
      transition: none;
      box-shadow: 0 1px 2px rgba(0, 0, 0, .08), 0 4px 12px rgba(0, 0, 0, .05);
    }

    /* Samma räkning som på dator, se ovan: telefonens fält är alltid 44. */
    /* Telefonen har inget utfällt läge alls, se .sokdock ovan, så Var-delen
       hör inte hemma där. 227 px fält delat i två är två delar på hundra
       pixlar var. */
    header.hem .sokdock :global(.var) { display: none; }

    header.hem .sokdock :global(.go) {
      width: 34px;
      height: 34px;
    }

    header.hem .sokdock :global(.go svg) {
      width: 16px;
      height: 16px;
    }
  }

  /* Den som bett om mindre rörelse får lägesbytet utan resa. */
  @media (prefers-reduced-motion: reduce) {
    .sokdock,
    .sokdock :global(.search-field) { transition: none; }
  }

  /* position: relative — på små skärmar ankras sökpanelen till hela raden i
     stället för till fältet, som då börjar för långt in på skärmen. */
  /* Raden är 64 px och inte 58. Uppmätt på booli.se 2026-08-18 och kontrollerad
     igen 2026-08-20: deras `nav.h-16` är 64 px i både 1280 och 390. Deras rad
     är däremot TOM på sökfält, både på start- och söksidan, så 64 säger inget
     om vad ett fält i raden får väga. Sedan 2026-08-20 är fältet 44 px och
     sitter med 10 px luft över och under. Se --h-bar och --h-field i
     tokens.css. */
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--h-bar);
  }

  /* Sökfältet ska ligga i RADENS mitt, inte i mitten av det som blir över.
     Med margin-inline: auto centrerades det mellan wordmarken (97 px) och
     menyknappen (36 px), alltså 30 px för långt åt höger, precis halva
     skillnaden mellan dem. Snedheten syns tydligast på verksamhetssidan,
     där innehållet under är symmetriskt och avslöjar den.

     Absolut positionering i stället, ankrad i .bar som redan är relative.

     Brytpunkten 640 px är räknad, inte vald. Ett centrerat fält på 300 px
     har sin vänsterkant vid W/2 minus 150. Wordmarken slutar vid 113 och
     behöver 24 px luft, alltså krävs W över 574. Menyn kräver bara 452.
     640 är närmaste befintliga brytpunkt i filen med marginal. Under den
     får fältet flyta som förut. */
  .bar :global(.site-search) { margin-inline: auto; }

  @media (min-width: 640px) {
    .bar :global(.site-search) {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      margin-inline: 0;
      width: min(380px, 34vw);
    }

  }

  /* Menyn står ALLTID vid högerkanten, utanför alla brytpunkter.

     Regeln låg tidigare inne i 640-blocket ovanför, eftersom sökfältets
     margin-inline: auto råkade knuffa menyn åt höger på smalare skärmar. Det
     höll bara så länge varje sida hade ett fält i sidhuvudet: startsidan bär
     fältet i heron i stället, och där stod hamburgaren plötsligt dikt an mot
     wordmarken. En knapp som byter kant beroende på sida är trasig. */
  /* Över sökdockens z-index 2. En knapp som ligger under ett fält går varken
     att se eller trycka på, och lagret är billigare än att lita på att inga
     mått någonsin överlappar igen. */
  .bar :global(.picker) { margin-left: auto; position: relative; z-index: 3; }

  /* `flex: none` och inte bara `display: inline-flex`.
     ────────────────────────────────────────────────────────────────────────
     Wordmarken var 97 px bred på startsidan och 81 på alla andra sidor, med
     samma höjd och samma viewBox. Alltså PRESSAD, inte mindre.

     Skälet är att raden är en flexrad och att ett flexbarn krymper när det
     blir trångt. Startsidan har inget sökfält i sidhuvudet, alltså finns det
     plats och märket får sina rätta 159 gånger 59. Varje annan sida har
     sökfältet, och där tog raden bredden ur det enda barn som gick att pressa.
     En svg med `width: auto` försvarar sig inte: den har ingen egen bredd att
     hålla emot med, den bara följer med.

     Det syns tydligast på telefon, där det är trängst. 81 mot 97 är sexton
     procent smalare, alltså ett annat märke. Ägaren såg det direkt.

     `flex: none` säger att märket varken växer eller krymper. Sökfältet är det
     som ska ge efter, för det har en egen bredd att ge av. */
  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: none;
    color: var(--brand);
  }

  /* Träffytan, 44 px, oberoende av wordmarkens 36. Länken till startsidan är
     sajtens mest tryckta, och den ska inte kräva att man träffar en 36 px
     hög rad. Ett genomskinligt ::after 4 px över och under, samma grepp som
     kartknapparna, se kartram.css. Bara lodrätt: vågrätt är märket 159 px
     brett och behöver ingenting. */
  .brand::after {
    content: '';
    position: absolute;
    inset: -4px 0;
  }

  .brand:hover {
    text-decoration: none;
    color: var(--brand-ink);
  }

  /* Wordmarken blinkar när man för muspekaren över den.
   *
   * Hover, inte vid sidladdning. Sidhuvudet finns på 14 711 sidor, och ett
   * ansikte som blinkar vid varje laddning blir en tic i stället för en
   * detalj. Vid hover styr besökaren själv, och den som aldrig hittar den
   * förlorar ingenting.
   *
   * Ögat skalas kring sin EGEN mittpunkt — utan fill-box räknar webbläsaren
   * origo från hela svg:n och ögat glider iväg över texten i stället för att
   * blinka. */
  .eye-right {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Namnet måste vara unikt. @keyframes är GLOBALA i CSS — Astro scopar
     selektorer men inte keyframe-namn, så en `wink` här och en `wink` i
     bedömningsmärket skrev en gång över varandra beroende på laddningsordning.
     Märkets blinkning heter numera `mm-blink-v` och `mm-blink-h` och bor i
     rörelsekatalogen, alltså kan krocken inte uppstå igen på det hållet. */
  /* Blinkar av sig själv med långt uppehåll, inte vid hover.
     Hela cykeln är 9 sekunder och blinkningen upptar de första 8 procenten
     — ungefär 0,7 sekunder. Resten står ögat stilla. Det ger ett liv i
     märket utan att bli en tic på en sida man läser länge.

     Ögat renderas under fyra pixlar brett vid 36 px logohöjd, så själva
     ihoptryckningen måste vara långsam och nästan fullständig för att alls
     gå att uppfatta. */
  .eye-right {
    animation: wordmark-wink 9s cubic-bezier(.4, 0, .2, 1) 2s infinite;
  }

  @keyframes wordmark-wink {
    0%, 2%   { transform: scaleY(1); }
    5%, 6%   { transform: scaleY(.06); }
    9%, 100% { transform: scaleY(1); }
  }

  /* Rörelse kan utlösa yrsel hos den som har en vestibulär sjukdom. Den som
     bett om mindre rörelse har oftast ett medicinskt skäl. */
  @media (prefers-reduced-motion: reduce) {
    .eye-right { animation: none; }
  }

  .wordmark {
    /* 36px. Var 26 och sedan 30 — båda för små. Hela märket skalas, ordet och
       ansiktet tillsammans, eftersom de sitter i samma viewBox.
       Wordmarken är sajtens enda varumärkesbärare i sidhuvudet och ska väga
       tyngre än navigationslänkarna bredvid, inte läsa som ännu en menypost. */
    height: 36px;
    width: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .bar { gap: var(--s-4); }
  }

  @media (max-width: 640px) {
    .bar { gap: var(--s-3); }
  }

  /* De sista pixlarna går till fältet, inte till luften.
     ────────────────────────────────────────────────────────────────────────
     Uppmätt vid 375 px: ordmärket tar 97, menyknappen 36, containern 2 × 16
     och de två gluggarna 2 × 12. Kvar blev 186 till fältet, alltså 123 inuti
     efter knapp och indrag, medan den korta platshållaren "Sök ställe eller
     ort" behöver 129. Den kapades mitt i sista ordet.

     Glugg 8 i stället för 12 ger de 8 px som fattas. Åtta är fortfarande mer
     än den optiska minsta gluggen mellan ett ordmärke och en rund knapp, och
     alternativet var att korta platshållaren till något som inte längre säger
     att man kan söka på en ort. */
  @media (max-width: 400px) {
    .bar { gap: var(--s-2); }
  }
</style>

{/*
  Ihopfällningen. Ett klassbyte och ingenting mer, all rörelse ligger i CSS.

  EN VAKTPOST OCH EN IntersectionObserver, INTE EN RULLHANTERARE.

  Skälet är kostnaden. En `scroll`-hanterare körs vid varje rullsteg, på en
  sida som bär 154 kort, för att svara på en fråga som ändrar svar två gånger
  per besök. En observatör körs bara när vaktposten korsar kanten.

  Vaktposten är en pixel stor, ligger absolut på y = 24 i dokumentet och syns
  aldrig. Korsar den överkanten är sidan rullad, punkt.

  Ingen hysteres behövs, och det är vaktpostens förtjänst. Den första
  versionen lyssnade på `scroll` och hade två trösklar, 24 ned och 8 upp, för
  att gummibandsrullningen på iOS passerar noll flera gånger efter att fingret
  släppt. Med en vaktpost är det inte ett problem: gummibandet drar scrollY
  under noll, vilket gör vaktposten MER synlig och alltså aldrig kan vända
  läget av misstag.

  EN VARNING TILL DEN SOM SKA MÄTA DET HÄR. En observatör körs när sidan
  RITAS, och en flik som ligger i bakgrunden ritas aldrig. Mäts det här i en
  dold flik svarar den noll gånger, och slutsatsen blir att ihopfällningen är
  trasig. Det hände 2026-08-21, och samma fälla står redan nedskriven för
  kartans attributionskontroll. Ha fliken i förgrunden.

  Skriptet är `is:inline` och avsiktligt inte en modul. Det är några rader som
  ska vara igång vid första bildrutan; en modul med defer hade låtit fältet
  stå i sitt stora läge en stund på en sida som laddats mitt i en rullning,
  och sedan hoppa.
*/}
<script is:inline>
  (() => {
    const huvud = document.querySelector('header[data-huvud].hem');
    if (!huvud) return;

    // Utan IntersectionObserver står fältet kvar i sitt stora läge. Sidan
    // fungerar, den fäller bara inte ihop, vilket är rätt utfall att falla
    // tillbaka på: det stora läget är sidans grundläge.
    if (!('IntersectionObserver' in window)) return;

    const vakt = document.createElement('div');
    vakt.setAttribute('aria-hidden', 'true');
    vakt.style.cssText =
      'position:absolute;top:24px;left:0;width:1px;height:1px;pointer-events:none';
    document.body.prepend(vakt);

    new IntersectionObserver(
      ([post]) => huvud.classList.toggle('kompakt', !post.isIntersecting),
      { threshold: 0 },
    ).observe(vakt);
  })();
</script>
