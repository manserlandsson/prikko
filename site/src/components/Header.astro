---
/**
 * Global header. Wordmark är inline SVG (ingen extra request, ingen CLS)
 * och länkar alltid till roten — Googles interna länkgraf börjar här.
 */
import { SITE } from '../lib/site';
---

<header>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name} — till startsidan`}>
      <svg
        class="mark"
        viewBox="0 0 96 96"
        aria-hidden="true"
        focusable="false"
      >
        <rect width="96" height="96" rx="26" fill="var(--brand)" />
        <circle cx="37.87" cy="37.12" r="6.12" fill="#fff" />
        <circle cx="60.61" cy="37.12" r="6.12" fill="#fff" />
        <path
          d="M30 55.49c12.25 11.66 24.49 11.66 36.74 0"
          stroke="#fff"
          stroke-width="7.87"
          stroke-linecap="round"
          fill="none"
        />
      </svg>
      <span class="wordmark">prikko</span>
    </a>

    <nav aria-label="Huvudmeny">
      <a href="/sok">Sök</a>
      <a href="/metodik">Metodik</a>
      <a href="/om">Om</a>
    </nav>
  </div>
</header>

<style>
  header {
    background: var(--card);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--text);
  }

  .brand:hover {
    text-decoration: none;
  }

  .mark {
    width: 26px;
    height: 26px;
    display: block;
  }

  .wordmark {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -.02em;
    color: var(--brand);
  }

  nav {
    margin-left: auto;
    display: flex;
    gap: var(--s-6);
  }

  nav a {
    font-size: var(--fs-body-s);
    font-weight: 400;
    color: var(--text-secondary);
  }

  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
</style>
