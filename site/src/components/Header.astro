---
/**
 * Global header.
 *
 * Wordmarken är Måns egen logotyp från Figma, inlinad som SVG: ingen extra
 * request, inget layoutskift, och den kan färgsättas med currentColor. Filen
 * finns även i brand/prikko-wordmark.svg — ändras den ena ska den andra följa.
 *
 * Länkar alltid till roten. Googles interna länkgraf börjar här.
 *
 * Menyn ligger längst till höger. Den hette platsväljare och bar en lista över
 * kommunerna; listan är borta, se PlacePicker.astro. Kvar är rättelse, tre
 * länkar om oss och kontot.
 *
 * Sökfältet ligger i mitten och är sajtens enda väg till en kommun, en
 * verksamhet, en karta, en sida eller en artikel. /sok finns kvar som
 * formulärets mål och som landningssida, men behöver ingen menyrad.
 */
import { SITE } from '../lib/site';
import PlacePicker from './PlacePicker.astro';
import SiteSearch from './SiteSearch.astro';

interface Props {
  /**
   * Startsidan stänger av fältet här och bär i stället hero-läget av samma
   * komponent mitt på sidan. En sida får aldrig två sökfält: dubbleringen
   * var det som fick den gamla heron att kännas tom, och SiteSearchs skript
   * och fält-id förutsätter dessutom en instans.
   *
   * Utan fältet försvinner också underkanten. Sidhuvud och hero ska då läsa
   * som ETT vitt band med wordmarken som avsändarrad, inte som en tom rad
   * med två saker i var sin ände ovanför en linje.
   */
  search?: boolean;
}

const { search = true } = Astro.props;
---

<header class:list={[!search && 'plain']}>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.name}, till startsidan`}>
      <svg
        class="wordmark"
        viewBox="0 0 159 59"
        role="img"
        aria-label={SITE.name}
      >
        <path d="M139.5 20.5c1.657 0 3 1.343 3 3s-1.343 3-3 3-3-1.343-3-3 1.343-3 3-3Z" fill="currentColor" stroke="currentColor"/>
        <path class="eye-right" d="M152.5 20.5c1.657 0 3 1.343 3 3s-1.343 3-3 3-3-1.343-3-3 1.343-3 3-3Z" fill="currentColor" stroke="currentColor"/>
        <path d="M135 34c7 6.667 14 6.667 21 0" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" fill="none"/>
        <path
          fill="currentColor"
          d="M2.44 49V19.24h4.92v4.32l-.48-1.08c.747-1.173 1.76-2.08 3.04-2.72 1.28-.667 2.76-1 4.44-1 2.053 0 3.907.507 5.56 1.52 1.653 1.013 2.96 2.373 3.92 4.08.987 1.707 1.48 3.627 1.48 5.76 0 2.107-.48 4.027-1.44 5.76-.96 1.733-2.267 3.107-3.92 4.12-1.653.987-3.533 1.48-5.64 1.48-1.573 0-3.027-.307-4.36-.92-1.307-.64-2.347-1.547-3.12-2.72l.84-1.04V49H2.44Zm11.28-12.32c1.2 0 2.267-.28 3.2-.84.933-.56 1.653-1.333 2.16-2.32.533-.987.8-2.12.8-3.4 0-1.28-.267-2.4-.8-3.36-.507-.987-1.227-1.76-2.16-2.32-.933-.587-2-.88-3.2-.88-1.147 0-2.187.28-3.12.84-.907.56-1.627 1.347-2.16 2.36-.507.987-.76 2.107-.76 3.36 0 1.28.253 2.413.76 3.4.533.987 1.253 1.76 2.16 2.32.933.56 1.973.84 3.12.84ZM29.315 41V19.24h4.92v4.84l-.4-.72c.507-1.627 1.293-2.76 2.36-3.4 1.093-.64 2.4-.96 3.92-.96h1.28v4.64h-1.88c-1.493 0-2.693.467-3.6 1.4-.907.907-1.36 2.187-1.36 3.84V41h-5.24ZM44.276 41V19.24h5.24V41h-5.24Zm0-24.2v-5.6h5.24v5.6h-5.24ZM54.354 41V10.72h5.24v19.84l-2-.6 10.24-10.72h6.52l-8.04 8.76 8.2 13h-6l-7.12-11.28 3.12-.64-6.56 7.04 1.64-3.2V41h-5.24ZM77.44 41V10.72h5.24v19.84l-2-.6 10.24-10.72h6.52l-8.04 8.76 8.2 13h-6l-7.12-11.28 3.12-.64-6.56 7.04 1.64-3.2V41h-5.24ZM110.775 41.48c-2.133 0-4.08-.493-5.84-1.48-1.733-.987-3.12-2.333-4.16-4.04-1.013-1.707-1.52-3.653-1.52-5.84 0-2.187.507-4.133 1.52-5.84 1.04-1.707 2.427-3.053 4.16-4.04 1.734-.987 3.68-1.48 5.84-1.48 2.134 0 4.067.493 5.8 1.48 1.734.987 3.107 2.333 4.12 4.04 1.04 1.68 1.56 3.627 1.56 5.84 0 2.187-.52 4.133-1.56 5.84-1.04 1.707-2.426 3.053-4.16 4.04-1.733.987-3.653 1.48-5.76 1.48Zm0-4.8c1.174 0 2.2-.28 3.08-.84.907-.56 1.614-1.333 2.12-2.32.534-1.013.8-2.147.8-3.4 0-1.28-.266-2.4-.8-3.36-.506-.987-1.213-1.76-2.12-2.32-.88-.587-1.906-.88-3.08-.88-1.2 0-2.253.293-3.16.88-.906.56-1.626 1.333-2.16 2.32-.506.96-.76 2.08-.76 3.36 0 1.253.254 2.387.76 3.4.534.987 1.254 1.76 2.16 2.32.907.56 1.96.84 3.16.84Z"
        />
      </svg>
    </a>

    {search && <SiteSearch />}

    {/*
      Metodik och Om låg tidigare här bredvid menyknappen. De finns nu i
      menyn, och att visa samma två länkar på två ställen i samma rad gör
      raden rörig utan att göra något lättare att hitta.

      Sidhuvudet är därmed tre saker: märket, sökfältet och menyn. Allt
      annat bor i menyn eller i sidfoten, som är fullständig.
    */}

    <PlacePicker />
  </div>
</header>

<style>
  /* Sidhuvudet ligger ÖVER sidan, inte i den.
   *
   * Utan det här målades sökförslagen under innehållet. Kedjan: .site-search
   * har transform (centreringen nedan), och en transform som inte är none
   * skapar en egen staplingskontext. Panelens z-index: 50 ordnar därför bara
   * syskon inne i sökfältet och kan inte ta sig ut. Utåt räknas hela
   * sidhuvudet som z-index auto, alltså nivå noll, och där avgör
   * dokumentordning: allt positionerat som kommer senare målas ovanpå.
   * Kommunsidans hero-scrim gjorde precis det, mitt genom förslagslistan.
   *
   * Att lyfta sidhuvudet är rätt lösning och inte en lapp: sidhuvudet ska
   * ligga överst oavsett vad sidan under innehåller. Det gäller lika mycket
   * platsväljarens panel, som har samma z-index 50 och samma inneslutning.
   *
   * 60 är valt mot skalan som finns: InfoTip 20 är det högsta i innehållet,
   * panelerna 50 gäller bara inuti sidhuvudet, och skip-länken i Base 100
   * måste ligga kvar överst av allt. 60 är över allt sidinnehåll med
   * marginal och under skip-länken med marginal. */
  header {
    position: relative;
    z-index: 60;
    background: var(--card);
    border-bottom: 1px solid var(--hairline);
  }

  /* Startsideläget, se Props. Ingen linje mellan sidhuvud och hero. */
  header.plain { border-bottom: 0; }

  /* position: relative — på små skärmar ankras sökpanelen till hela raden i
     stället för till fältet, som då börjar för långt in på skärmen. */
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: 58px;
  }

  /* Sökfältet ska ligga i RADENS mitt, inte i mitten av det som blir över.
     Med margin-inline: auto centrerades det mellan wordmarken (97 px) och
     menyknappen (36 px), alltså 30 px för långt åt höger, precis halva
     skillnaden mellan dem. Snedheten syns tydligast på verksamhetssidan,
     där innehållet under är symmetriskt och avslöjar den.

     Absolut positionering i stället, ankrad i .bar som redan är relative.

     Brytpunkten 640 px är räknad, inte vald. Ett centrerat fält på 300 px
     har sin vänsterkant vid W/2 minus 150. Wordmarken slutar vid 113 och
     behöver 24 px luft, alltså krävs W över 574. Menyn kräver bara 452.
     640 är närmaste befintliga brytpunkt i filen med marginal. Under den
     får fältet flyta som förut. */
  .bar :global(.site-search) { margin-inline: auto; }

  @media (min-width: 640px) {
    .bar :global(.site-search) {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      margin-inline: 0;
      width: min(380px, 34vw);
    }

  }

  /* Menyn står ALLTID vid högerkanten, utanför alla brytpunkter.

     Regeln låg tidigare inne i 640-blocket ovanför, eftersom sökfältets
     margin-inline: auto råkade knuffa menyn åt höger på smalare skärmar. Det
     höll bara så länge varje sida hade ett fält i sidhuvudet: startsidan bär
     fältet i heron i stället, och där stod hamburgaren plötsligt dikt an mot
     wordmarken. En knapp som byter kant beroende på sida är trasig. */
  .bar :global(.picker) { margin-left: auto; }

  /* `flex: none` och inte bara `display: inline-flex`.
     ────────────────────────────────────────────────────────────────────────
     Wordmarken var 97 px bred på startsidan och 81 på alla andra sidor, med
     samma höjd och samma viewBox. Alltså PRESSAD, inte mindre.

     Skälet är att raden är en flexrad och att ett flexbarn krymper när det
     blir trångt. Startsidan har inget sökfält i sidhuvudet, alltså finns det
     plats och märket får sina rätta 159 gånger 59. Varje annan sida har
     sökfältet, och där tog raden bredden ur det enda barn som gick att pressa.
     En svg med `width: auto` försvarar sig inte: den har ingen egen bredd att
     hålla emot med, den bara följer med.

     Det syns tydligast på telefon, där det är trängst. 81 mot 97 är sexton
     procent smalare, alltså ett annat märke. Ägaren såg det direkt.

     `flex: none` säger att märket varken växer eller krymper. Sökfältet är det
     som ska ge efter, för det har en egen bredd att ge av. */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    color: var(--brand);
  }

  .brand:hover {
    text-decoration: none;
    color: var(--brand-ink);
  }

  /* Wordmarken blinkar när man för muspekaren över den.
   *
   * Hover, inte vid sidladdning. Sidhuvudet finns på 14 711 sidor, och ett
   * ansikte som blinkar vid varje laddning blir en tic i stället för en
   * detalj. Vid hover styr besökaren själv, och den som aldrig hittar den
   * förlorar ingenting.
   *
   * Ögat skalas kring sin EGEN mittpunkt — utan fill-box räknar webbläsaren
   * origo från hela svg:n och ögat glider iväg över texten i stället för att
   * blinka. */
  .eye-right {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Namnet måste vara unikt. @keyframes är GLOBALA i CSS — Astro scopar
     selektorer men inte keyframe-namn, så en `wink` här och en `wink` i
     bedömningsmärket skrev en gång över varandra beroende på laddningsordning.
     Märkets blinkning heter numera `mm-blink-v` och `mm-blink-h` och bor i
     rörelsekatalogen, alltså kan krocken inte uppstå igen på det hållet. */
  /* Blinkar av sig själv med långt uppehåll, inte vid hover.
     Hela cykeln är 9 sekunder och blinkningen upptar de första 8 procenten
     — ungefär 0,7 sekunder. Resten står ögat stilla. Det ger ett liv i
     märket utan att bli en tic på en sida man läser länge.

     Ögat renderas under fyra pixlar brett vid 36 px logohöjd, så själva
     ihoptryckningen måste vara långsam och nästan fullständig för att alls
     gå att uppfatta. */
  .eye-right {
    animation: wordmark-wink 9s cubic-bezier(.4, 0, .2, 1) 2s infinite;
  }

  @keyframes wordmark-wink {
    0%, 2%   { transform: scaleY(1); }
    5%, 6%   { transform: scaleY(.06); }
    9%, 100% { transform: scaleY(1); }
  }

  /* Rörelse kan utlösa yrsel hos den som har en vestibulär sjukdom. Den som
     bett om mindre rörelse har oftast ett medicinskt skäl. */
  @media (prefers-reduced-motion: reduce) {
    .eye-right { animation: none; }
  }

  .wordmark {
    /* 36px. Var 26 och sedan 30 — båda för små. Hela märket skalas, ordet och
       ansiktet tillsammans, eftersom de sitter i samma viewBox.
       Wordmarken är sajtens enda varumärkesbärare i sidhuvudet och ska väga
       tyngre än navigationslänkarna bredvid, inte läsa som ännu en menypost. */
    height: 36px;
    width: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .bar { gap: var(--s-4); }
  }

  @media (max-width: 640px) {
    .bar { gap: var(--s-3); }
  }
</style>
