---
/**
 * Återkommande brister.
 *
 * Sidans egentliga insikt. En enskild avvikelse säger lite — alla får en
 * emellanåt. Att samma kylkedja underkänts fyra gånger på två år säger något
 * helt annat, och det syns inte om man läser kontrollerna var för sig.
 *
 * Visas bara när det finns något att visa. En verksamhet utan mönster ska
 * inte få en tom rubrik som antyder att vi letat och hittat något.
 */
import InfoTip from './InfoTip.astro';
import { formatDate, type RecurringIssue } from '../lib/data';

interface Props {
  issues: RecurringIssue[];
}

const { issues } = Astro.props;

/**
 * Historiken följer LOKALEN, och det sägs OVILLKORLIGT.
 *
 * Kommunen registrerar kontrollerna på anläggningen, och ingen av källorna
 * säger när verksamheten startade eller om ägaren bytt. En brist som noterats
 * 2018 och igen 2025 behöver därför inte vara samma verksamhet som inte rättat
 * sig. Det kan vara två företag som fått samma anmärkning i samma kök.
 *
 * Att påstå det förra om ett namngivet företag är rubrikens allvarligaste
 * felkälla, och den enda på sidan som anklagar. Den gäller varje verksamhet
 * här, inte bara dem med ett uppehåll i historiken, och förbehållet visas
 * därför alltid. Villkorat blev det en falsk trygghetssignal på de sidor där
 * risken är störst. Se HISTORY_GAP_DAYS i data.ts.
 *
 * Uppehållet får bara två uppgifter kvar: rangordna ner en gles brist
 * (sorteringen i recurringIssues) och tala om hur lång tid det gått. Det sista
 * är en ren observation och säger ingenting om ägarbyte.
 */
const years = (days: number) => Math.floor(days / 365);

/**
 * INGEN OMRÅDESIKON I DEN HÄR LISTAN. Mätt beslut, återinför den inte.
 *
 * Raderna bar tidigare en AreaIcon per lagstiftningsområde, alltså bokstaven i
 * rapporteringspunkten. Ikonen fanns för att listan skulle gå att skumma. Den
 * gjorde inte det, och beståndet visar varför. Räknat över alla tolv kommuner:
 * 3 402 verksamheter har en lista här, 5 463 rader totalt.
 *
 * Datan kommer i två former och ikonen misslyckas i BÅDA, av motsatta skäl.
 *
 * Stockholm, 2 387 av listorna: koden ÄR bara områdesbokstaven, och radens
 * egen text är områdets namn. Det finns exakt femton distinkta beskrivningar i
 * hela Stockholms bestånd: "Hygien", "Spårbarhet", "Riskhantering" och så
 * vidare. Ikonen upprepas alltså aldrig (0 av 747 flerradslistor har en enda
 * ikon), men den säger inte heller något som inte redan står i fetstil bredvid
 * den. En droppe intill ordet Hygien är dekor.
 *
 * Linköping, Örebro och Borgholm, 884 av listorna: koden är hela
 * rapporteringspunkten och texten är specifik och läsvärd. Här upprepas
 * ikonen i stället hela tiden, eftersom område J heter "Grundförutsättningar,
 * hygien" och rymmer nästan allt en restaurang får anmärkningar på. 72 % av
 * raderna i flerradslistorna delar ikon med minst en annan rad, och 39,6 % av
 * listorna visar samma ikon på varenda rad. Pizzeria Valla i Linköping: nio
 * rader, sex identiska droppar.
 *
 * Uppsala, 131 listor: ingen kod alls, alltid reservcirkeln.
 *
 * De två andra utvägarna mättes och håller inte:
 *
 * - Ikon per rapporteringspunkt, så att J02 och J08 skiljer sig, går inte att
 *   bygga. 63,7 % av raderna HAR ingen rapporteringspunkt, bara en bokstav
 *   eller tomt. Den skulle dessutom bara gälla de kommuner vars text redan är
 *   specifik nog att skiljas åt utan ikon.
 *
 * - Ikon bara när raderna spänner över flera områden räddar ingenting. Det
 *   villkoret är sant för 84,7 % av flerradslistorna, Pizzeria Valla inräknad,
 *   där sex droppar av nio kvarstår.
 *
 * Kvar står att texten redan bär det ikonen skulle bära, i den ena formen som
 * områdesnamn och i den andra som konkret brist. Rader utan ikon läser
 * snabbare än rader med en ikon som inte skiljer dem åt.
 *
 * AreaIcon finns kvar och används av ControlBreakdown, där raderna är en
 * enskild kontrolls områden och sammanhanget är ett annat.
 */
---

{issues.length > 0 && (
  <section class="recurring">
    <div class="head">
      <h2>
        Återkommande brister
        <InfoTip
          label="återkommande brister"
          text="Brister som kommunen noterat vid mer än en kontroll. En enskild avvikelse säger lite. Att samma sak återkommer säger mer. Kontrollerna är registrerade på lokalen och inte på företaget, så noteringar från en tidigare verksamhet på adressen räknas med. Brister vars noteringar ligger långt isär rangordnas därför ner."
        />
      </h2>
      <p class="count text-secondary">
        {issues.length} {issues.length === 1 ? 'brist' : 'brister'} vid mer än en kontroll
      </p>
    </div>

    <p class="caveat">
      Kommunen registrerar kontrollerna på lokalen och inte på företaget, och
      anger inte när en verksamhet startat eller bytt ägare. Noteringarna nedan
      behöver därför inte gälla samma verksamhet.
      {' '}<a href="/metodik/#lokalen">Så hanterar vi det</a>.
    </p>

    <ul class="rows">
      {issues.map((issue) => (
        <li class="row">
          <b>{issue.description}</b>
          <span class="when text-secondary">
            {issue.dates.slice(0, 4).map(formatDate).join(' · ')}
            {issue.dates.length > 4 && ` · +${issue.dates.length - 4} till`}
          </span>
          {/* Ren observation. Inget påstående om ägarbyte. */}
          {issue.straddlesGap && (
            <span class="maybe">{years(issue.gapDays)} år mellan noteringarna</span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .head h2 { display: flex; align-items: center; }

  .count { font-size: var(--fs-body-s); }

  /* Förbehållet, inte en varning.
   *
   * Neutral yta och hårfin ram med avsikt: det här är en upplysning om vad
   * datan inte kan visa, inte ett omdöme om verksamheten. Röd eller gul hade
   * lånat betydelse från bedömningsnivåerna och lagt ännu ett larm på en sida
   * som redan har ett. */
  /* Ingen egen ruta. Förbehållet stod tidigare i en inramad ruta, och en ram
     är en signal om att något är avgränsat och viktigt nog att lyftas ur
     texten. Det här är en fotnot till listan under, inte en varning, och
     ramen gav den en tyngd som fick hela avsnittet att se ut som ett larm. */
  .caveat {
    margin-top: var(--s-3);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .maybe {
    display: block;
    margin-top: 2px;
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    color: var(--text-muted);
  }

  .rows {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }

  .row {
    padding: var(--s-3) 0;
    border-top: 1px solid var(--hairline);
  }

  .row b {
    display: block;
    font-size: var(--fs-body-s);
    font-weight: 600;
    line-height: 20px;
  }

  .when {
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
  }

</style>
