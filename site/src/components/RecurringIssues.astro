---
/**
 * Återkommande brister.
 *
 * Sidans egentliga insikt. En enskild avvikelse säger lite — alla får en
 * emellanåt. Att samma kylkedja underkänts fyra gånger på två år säger något
 * helt annat, och det syns inte om man läser kontrollerna var för sig.
 *
 * Visas bara när det finns något att visa. En verksamhet utan mönster ska
 * inte få en tom rubrik som antyder att vi letat och hittat något.
 */
import AreaIcon from './AreaIcon.astro';
import InfoTip from './InfoTip.astro';
import { formatDate, legislationArea, type RecurringIssue } from '../lib/data';

interface Props {
  issues: RecurringIssue[];
}

const { issues } = Astro.props;

/**
 * Historiken följer LOKALEN, och det sägs OVILLKORLIGT.
 *
 * Kommunen registrerar kontrollerna på anläggningen, och ingen av källorna
 * säger när verksamheten startade eller om ägaren bytt. En brist som noterats
 * 2018 och igen 2025 behöver därför inte vara samma verksamhet som inte rättat
 * sig. Det kan vara två företag som fått samma anmärkning i samma kök.
 *
 * Att påstå det förra om ett namngivet företag är rubrikens allvarligaste
 * felkälla, och den enda på sidan som anklagar. Den gäller varje verksamhet
 * här, inte bara dem med ett uppehåll i historiken, och förbehållet visas
 * därför alltid. Villkorat blev det en falsk trygghetssignal på de sidor där
 * risken är störst. Se HISTORY_GAP_DAYS i data.ts.
 *
 * Uppehållet får bara två uppgifter kvar: rangordna ner en gles brist
 * (sorteringen i recurringIssues) och tala om hur lång tid det gått. Det sista
 * är en ren observation och säger ingenting om ägarbyte.
 */
const years = (days: number) => Math.floor(days / 365);
---

{issues.length > 0 && (
  <section class="recurring">
    <div class="head">
      <h2>
        Återkommande brister
        <InfoTip
          label="återkommande brister"
          text="Brister som kommunen noterat vid mer än en kontroll. En enskild avvikelse säger lite. Att samma sak återkommer säger mer. Kontrollerna är registrerade på lokalen och inte på företaget, så noteringar från en tidigare verksamhet på adressen räknas med. Brister vars noteringar ligger långt isär rangordnas därför ner."
        />
      </h2>
      <p class="count text-secondary">
        {issues.length} {issues.length === 1 ? 'brist' : 'brister'} vid mer än en kontroll
      </p>
    </div>

    <p class="caveat">
      Kommunen registrerar kontrollerna på lokalen och inte på företaget, och
      anger inte när en verksamhet startat eller bytt ägare. Noteringarna nedan
      behöver därför inte gälla samma verksamhet.
      {' '}<a href="/metodik/#lokalen">Så hanterar vi det</a>.
    </p>

    <ul class="rows">
      {issues.map((issue) => {
        const area = legislationArea(issue.code);
        return (
          <li class="row">
            <span class="icon">
              <AreaIcon letter={issue.code || issue.group.charAt(0)} />
            </span>
            <span class="what">
              <b>{issue.description}</b>
              <span class="when text-secondary">
                {issue.dates.slice(0, 4).map(formatDate).join(' · ')}
                {issue.dates.length > 4 && ` · +${issue.dates.length - 4} till`}
              </span>
              {/* Ren observation. Inget påstående om ägarbyte. */}
              {issue.straddlesGap && (
                <span class="maybe">{years(issue.gapDays)} år mellan noteringarna</span>
              )}
            </span>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .head h2 { display: flex; align-items: center; }

  .count { font-size: var(--fs-body-s); }

  /* Förbehållet, inte en varning.
   *
   * Neutral yta och hårfin ram med avsikt: det här är en upplysning om vad
   * datan inte kan visa, inte ett omdöme om verksamheten. Röd eller gul hade
   * lånat betydelse från bedömningsnivåerna och lagt ännu ett larm på en sida
   * som redan har ett. */
  .caveat {
    margin-top: var(--s-4);
    padding: var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .maybe {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    line-height: 15px;
    color: var(--text-muted);
  }

  .rows {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    border-top: 1px solid var(--hairline);
  }

  /* Bara ikonen — ingen färgad platta bakom.
   *
   * Plattan gjorde varje rad till ett litet kort och lade färg på något som
   * redan är allvarligt av sin text. Ikonen i bläckfärg låter innehållet
   * bära tyngden i stället för dekoren. */
  .icon {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }

  .what b {
    display: block;
    font-size: var(--fs-body-s);
    font-weight: 600;
    line-height: 20px;
  }

  .when {
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
  }

</style>
