---
/**
 * Prikkos wordmark, med en enda källa i koden.
 *
 * Märket är Måns egen logotyp från Figma. Det ritas inline som SVG: ingen
 * extra request, inget layoutskift, och det kan färgsättas med currentColor
 * så att samma fil fungerar mot ljus och mörk yta.
 *
 * Originalet ligger i brand/prikko-wordmark.svg, och ändras den ena ska den
 * andra följa. Men i site/ ska SVG:n bara finnas här. Sidhuvudet hade en
 * egen kopia; den ska ersättas av den här komponenten (se not i rapporten,
 * Header.astro var upptagen när sidfoten byggdes om).
 *
 * SJÄLVA KURVORNA LIGGER SEDAN 2026-08-31 I lib/wordmark.ts. De flyttade
 * eftersom fönsterdekalen också ska bära ordmärket, och dekalen sätts ihop av
 * functions/api/marke.ts, som Cloudflare Pages bundlar för sig och som inte kan
 * importera en .astro-fil. Alternativet var att skriva av ritningen dit, alltså
 * två ordmärken så fort någon rättar det ena. Komponenten är kvar som den var
 * utåt: samma props, samma DOM, samma klass `eye-right` för sidhuvudets
 * blinkning.
 *
 * Storlek styrs av `height` i px, inte av viewBox. Bredden följer med.
 *
 * Ingen animation här. Sidhuvudets blinkning är sidhuvudets beslut och läggs
 * på utifrån, och ögat har klassen `eye-right` just för att kunna nås med
 * `:global(.eye-right)` från den som vill animera det. En sidfot som blinkar
 * vore en tic, inte en detalj.
 */
interface Props {
  /** Höjd i px. 36 är sidhuvudets mått. */
  height?: number;
  /** Extra klass, för positionering hos den som anropar. */
  class?: string;
  /**
   * Tillgängligt namn. Ligger märket redan i en länk med aria-label ska det
   * här sättas till null så att skärmläsaren inte läser namnet två gånger.
   */
  label?: string | null;
}

import {
  WORDMARK_FILLS,
  WORDMARK_MOUTH,
  WORDMARK_MOUTH_WIDTH,
  WORDMARK_VIEWBOX,
} from '../lib/wordmark';

const { height = 36, class: className, label = 'Prikko' } = Astro.props;
const decorative = label === null;
---

<svg
  class:list={['wordmark', className]}
  viewBox={WORDMARK_VIEWBOX}
  style={`height:${height}px`}
  role={decorative ? 'presentation' : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={decorative ? undefined : label}
  focusable="false"
>
  {/* Ögonen först, och det högra bär klassen som sidhuvudet animerar. Ordningen
      i WORDMARK_FILLS är därför inte godtycklig: index 0 och 1 är prickarna. */}
  <path d={WORDMARK_FILLS[0]} fill="currentColor" stroke="currentColor" />
  <path class="eye-right" d={WORDMARK_FILLS[1]} fill="currentColor" stroke="currentColor" />
  <path
    d={WORDMARK_MOUTH}
    stroke="currentColor"
    stroke-width={WORDMARK_MOUTH_WIDTH}
    stroke-linecap="round"
    fill="none"
  />
  {WORDMARK_FILLS.slice(2).map((d) => <path fill="currentColor" d={d} />)}
</svg>

<style>
  .wordmark {
    width: auto;
    display: block;
  }
</style>
