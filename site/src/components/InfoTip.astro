---
/**
 * (i)-symbol med förklaring vid hover och tangentbordsfokus.
 *
 * Mönstret är hämtat från ednia, som sätter en (i) vid varje rubrik där datan
 * behöver förklaras.
 *
 * ---------------------------------------------------------------------------
 * VARFÖR BUBBLAN LIGGER I TOPPSKIKTET
 * ---------------------------------------------------------------------------
 * Komponenten var tidigare ren CSS med en absolut positionerad bubbla. Det
 * kostade två saker som båda syntes:
 *
 *   Rutnätet i FactGrid kunde inte klippa sina hörn, eftersom overflow: hidden
 *   hade kapat bubblan. Följden var att cellernas raka hörn målades ovanpå den
 *   rundade ramen, och kanterna såg trasiga ut. Det lappades en gång med en
 *   mindre hörnradie, vilket dolde symptomet i stället för att laga felet.
 *
 *   Bubblan är 260 px bred och tog plats i layouten även dold, vilket gav
 *   vågrät rullning på telefon.
 *
 * Bubblan är nu en popover. Webbläsaren ritar den i sitt toppskikt, utanför
 * varje förälders overflow och utan att påverka sidans bredd. Båda felen
 * försvinner av samma ändring.
 *
 * Placeringen sker med script, inte med CSS-ankarpositionering. Ankarstödet
 * gick inte att belägga för Safari och Firefox vid skrivande stund, och en
 * popover utan ankare hamnar mitt på skärmen. Femton rader script är billigare
 * än en bubbla som landar fel hos en tredjedel av besökarna.
 *
 * Sajten är noll-JS av princip, och det gäller fortfarande: texten ligger i
 * DOM:en och läses av sökmotorer utan att något körs. Scriptet flyttar bara en
 * ruta som redan finns.
 *
 * Tillgänglighet: knapp och inte span så den nås med tangentbord, och
 * förklaringen kopplas med aria-describedby så skärmläsare läser upp den.
 */
interface Props {
  label: string;
  text: string;
}

const { label, text } = Astro.props;
const id = `tip-${Math.random().toString(36).slice(2, 9)}`;
---

<span class="wrap" data-tip>
  <button
    type="button"
    class="dot"
    aria-label={`Vad betyder ${label}?`}
    aria-describedby={id}
    popovertarget={id}
  >
    i
  </button>
  {/* `popover="manual"` och inte "auto": auto stänger varje annan öppen
      popover när en ny öppnas, vilket är rätt för menyer men fel här, och
      auto stängs dessutom av ett klick var som helst vilket krockar med att
      vi öppnar på hover. Vi styr öppning och stängning själva. */}
  {/* `data-nosnippet` för att Google annars skriver sökresultatet ur tipset.

      Verkligt utfall för AG i Stockholm, kontrollerat i Google: utdraget löd
      "Besökarnas omdömen i. Vad besökare tycker om stället. Det är åsikter,
      inte kontrollresultat, och de påverkar aldrig hygienbedömningen." Alltså
      rubriken, knappens bokstav i, och hela den här texten. Ett verktygstips är
      skrivet för den som redan står på sidan och undrar vad en etikett betyder,
      och det är precis fel text att möta någon med som ännu inte klickat.

      Attributet rör bara utdraget. Sidan indexeras som förut, länkarna räknas
      som förut, och texten finns kvar för skärmläsare, som ju är hela skälet
      till att den ligger i dokumentet och inte i ett attribut. */}
  <span class="bubble glass glass-dark" id={id} role="tooltip" popover="manual" data-nosnippet>{text}</span>
</span>

<style>
  .wrap {
    position: relative;
    display: inline-flex;
    vertical-align: middle;
    margin-left: 6px;
  }

  /* Ringen bor i hovringen, inte i viloläget.
   *
   * Nyckeltalsraden bär fem av de här bredvid varandra, och fem ringar
   * konkurrerar med de fem tal de är till för att förklara. Ägaren frågade om
   * de skulle vara vita eller av glas. Svaret är varken: vitt försvinner mot
   * kortet, och glas är en dekoration som sajten bara använder där något
   * faktiskt svävar över innehåll, alltså i bubblan nedan.
   *
   * Rätt åtgärd är att göra dem tystare. Bokstaven står kvar, ringen kommer
   * fram när man närmar sig. Måtten ändras inte, så träffytan är densamma
   * och raden hoppar aldrig.
   */
  .dot {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    /* Vit fylld cirkel med hårlinje. Den ska LÄSA som en ikon, inte som ett
       löst i mitt i en rad. Ett försök att tona ned den genom att ta bort
       ringen i viloläget gick för långt: kvar blev en bokstav utan form.
       Vitt mot kortets vita ger ingen ruta, det är hårlinjen som ger formen,
       och mot canvasens ljusgrå lyfter den lite. */
    border: 1px solid var(--hairline);
    background: var(--card);
    color: var(--text-secondary);
    font: 600 10px/1 var(--font-sans);
    cursor: help;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color .12s ease, border-color .12s ease;
  }

  /* Träffytan, 44 px, oberoende av prickens 16.
     ────────────────────────────────────────────────────────────────────────
     Pricken är sajtens minsta kontroll och satt precis intill en rubrik.
     16 px ligger under WCAG 2.5.8:s 24 och långt under de 44 som är rimlig
     träffyta på telefon; uppmätt i bygget 2026-08-18 fanns fyra till sex
     sådana prickar per sida. Att växa själva cirkeln var aldrig svaret,
     den ska läsa som en ikon i en rad text.

     Ett genomskinligt ::after utanför pricken, samma grepp som kartknapparna,
     se kartram.css. Men i TVÅ steg, och det är räknat:

       mus      4 px utanför, alltså 24 px, WCAG 2.5.8:s krav
       finger  14 px utanför, alltså 44 px, --h-tap

     Skälet till att musen inte får 44 är att pricken står inuti löpande text
     med rader omkring 28 px isär. En osynlig 44-cirkel hade nått ner i talet
     under och fällt ut bubblan när pekaren egentligen låg på siffran.
     `pointer: coarse` har ingen hovring att stjäla, och där är 44 gratis. */
  .dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
  }

  @media (pointer: coarse) {
    .dot::after { inset: -14px; }
  }

  .dot:hover,
  .dot:focus-visible {
    border-color: var(--brand);
    color: var(--brand);
  }

  /* Bubblan är ett svävande lager och bär därför sajtens glasyta: .glass för
     oskärpa, kant och lyft, .glass-dark för den mörka fyllningen. Allt det
     står i tokens.css. Här bor bara måtten.

     Mörk och inte ljus, till skillnad från panelerna i sidhuvudet: tipset är
     ett påpekande ovanpå en text, inte en yta att arbeta i, och ett ljust
     glas hade smält ihop med sidan bakom. Radien är dessutom mindre än
     --r-card. 12 px på en ruta som ofta är två rader hög blir en tablett. */
  .bubble {
    /* Popover ritas i toppskiktet och positioneras mot vyporten. Måtten sätts
       av scriptet vid varje öppning; här står bara utseendet. */
    position: fixed;
    margin: 0;
    inset: auto;
    width: max-content;
    max-width: 260px;
    /* Webbläsarens egen regel för [popover] sätter overflow: auto, och en
       bubbla som är två rader text fick därmed en rullningslist när höjden
       råkade bli en pixel knappare än innehållet. Ett verktygstips ska aldrig
       gå att rulla i: får texten inte plats är texten för lång, och då är det
       texten som ska kortas. */
    overflow: visible;
    font-size: var(--fs-caption);
    line-height: 17px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    padding: 8px 10px;
    border-radius: 9px;
    border: 0;
    opacity: 0;
    transition: opacity .12s ease;
  }

  /* En popover är display: none tills den öppnas, så ingen egen döljning
     behövs. Toningen sker när den redan är öppen. */
  .bubble:popover-open {
    opacity: 1;
  }

  /* Pilen hämtar samma --glass-fill som bubblan, alltså även den solida
     färgen när reservregeln slår till. Den kan inte sudda bakgrunden bakom
     sig, men fem pixlar utan oskärpa syns inte mot en bubbla som har den. */
  .bubble::after {
    content: '';
    position: absolute;
    top: 100%;
    left: var(--arrow, 50%);
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--glass-fill);
  }

  /* Bubblan under knappen: pilen vänds och flyttas till överkanten. */
  .bubble.is-below::after {
    top: auto;
    bottom: 100%;
    border-top-color: transparent;
    border-bottom-color: var(--glass-fill);
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble { transition: none; }
  }
</style>

<script>
  /**
   * Öppnar och placerar bubblorna.
   *
   * En popover ligger i toppskiktet och positioneras mot vyporten, inte mot
   * sin förälder. Den måste därför få sina koordinater när den öppnas, och
   * räknas om vid rullning eftersom knappen rör sig men bubblan inte gör det.
   *
   * `is-below` vänder pilen. Får bubblan inte plats ovanför knappen, alltså
   * nära sidans överkant, hamnar den under i stället.
   */
  const GAP = 8;

  function place(dot: HTMLElement, bubble: HTMLElement) {
    const b = dot.getBoundingClientRect();
    const w = bubble.offsetWidth;
    const h = bubble.offsetHeight;

    // Vågrätt centrerad över knappen, men aldrig utanför skärmen.
    const half = w / 2;
    const centre = b.left + b.width / 2;
    const left = Math.min(Math.max(centre - half, GAP), window.innerWidth - w - GAP);

    const below = b.top - h - GAP < GAP;
    bubble.classList.toggle('is-below', below);
    bubble.style.left = `${left}px`;
    bubble.style.top = below ? `${b.bottom + GAP}px` : `${b.top - h - GAP}px`;

    // Pilen följer knappen och inte bubblans mitt, som kan ha flyttats av
    // kanten ovan. Utan detta pekar pilen bredvid symbolen den hör till.
    bubble.style.setProperty('--arrow', `${centre - left}px`);
  }

  for (const wrap of document.querySelectorAll<HTMLElement>('[data-tip]')) {
    const dot = wrap.querySelector<HTMLButtonElement>('.dot');
    const bubble = wrap.querySelector<HTMLElement>('.bubble');
    if (!dot || !bubble || !('showPopover' in bubble)) continue;

    let open = false;
    const show = () => {
      if (open) return;
      bubble.showPopover();
      place(dot, bubble);
      open = true;
    };
    const hide = () => {
      if (!open) return;
      bubble.hidePopover();
      open = false;
    };

    wrap.addEventListener('pointerenter', show);
    wrap.addEventListener('pointerleave', hide);
    dot.addEventListener('focus', show);
    dot.addEventListener('blur', hide);

    /* Knappen bär popovertarget, så webbläsaren växlar bubblan vid klick av
       sig själv. På pekskärm är det den enda vägen in, och där finns ingen
       pointerleave att stänga med, så Escape och nästa tryck utanför får
       göra jobbet. */
    dot.addEventListener('click', () => {
      open = bubble.matches(':popover-open');
      if (open) place(dot, bubble);
    });

    document.addEventListener('scroll', () => open && place(dot, bubble), { passive: true });
    window.addEventListener('resize', hide);
  }
</script>
