---
/**
 * KODKORTET: sajtens kodruta.
 *
 * ---------------------------------------------------------------------------
 * DEN VAR MÖRK I FYRA DAGAR, OCH ÄR LJUS IGEN
 * ---------------------------------------------------------------------------
 * Ägaren 2026-09-05, om den mörka: "kodlådorna fine, men ska dom verkligen
 * vara svarta?"
 *
 * Frågan prövades i bild och inte i tyckande. Uppmätt på /api/ vid 1 440 px:
 * sidan bär sju kodkort, och med #1D1D1F som yta ligger vart och ett på 15,2:1
 * mot sidan under. Det är inte sju kort på en sida, det är sju hål i den.
 *
 * Förlagorna svarar inte entydigt heller. Uppmätt 2026-09-01: Stripe kör
 * #0C2E4E och Resend #000000, medan Ably och Clerk inte har ett enda kodblock
 * på sina sidor. Två av fyra gör alltså inte valet alls, och de två som gör det
 * säljer båda ett SDK till en publik som lever i en mörk editor.
 *
 * Det som avgjorde är vår egen sajt. Den är ljus rakt igenom, den har inget
 * mörkt läge, och systemets enda mörka yta är kartknappens platta på
 * startsidan. En kodruta som är sajtens näst mörkaste yta, sju gånger på samma
 * sida, gör koden till sidans tyngsta element i stället för till dess mest
 * lästa.
 *
 * ---------------------------------------------------------------------------
 * YTAN ÄR FORTFARANDE INTE EN NY FÄRG
 * ---------------------------------------------------------------------------
 * Botten är `var(--text)` blandad 5 procent i `var(--card)`, alltså ungefär
 * #F3F3F4, och huvudraden samma två färger på 10 procent, ungefär #E8E8E9.
 * Ingen ny ton kommer in i systemet, precis som när ytan var mörk: då blandades
 * vitt i --text, nu blandas --text i vitt.
 *
 * Räknat mot sajtens egna ytor: kortet ligger på 1,07:1 mot --canvas och
 * huvudraden på 1,10:1 mot kortet. Det är ungefär samma två steg som den mörka
 * rutan hade internt, alltså läser kortet som ett fält och raden som en rad.
 *
 * Kanten går tillbaka till --hairline. Den var utbytt mot vit på 8 procent
 * enbart för att svart på 9,8 procent är osynligt mot en nästan svart yta, och
 * det skälet finns inte längre. Ringen är dessutom det som bär avgränsningen
 * här, precis som tokens.css säger om varje annat kort på sajten: fyllningen
 * är för svag ensam, linjen är det ögat hittar.
 *
 * VAD SOM INTE ÄNDRADES: rutan är fortfarande sidans enda yta som betyder "det
 * här är maskinens svar och inte vår text". Den skillnaden bärs nu av en dämpad
 * yta, en huvudrad och monospacen i stället för av ett mörkerhopp.
 *
 * ---------------------------------------------------------------------------
 * HUVUDRADEN BÄR ADRESSEN, OCH DEN GÖR TVÅ SAKER
 * ---------------------------------------------------------------------------
 * Genrens kodkort har en rad överst med ett filnamn eller en flik. Vi lägger
 * ADRESSEN där, alltså `/api/v1/index.json` eller `Terminal`. Det ersätter den
 * grå versaletiketten som stod OVANFÖR den vita rutan förut, och sparar en rad
 * per ruta på en sida som har sju.
 *
 * Kopieraknappen sitter i samma rad, till höger, vilket är förlagornas plats.
 * Den skrivs HÄR i markupen med `hidden` och inte av skriptet, till skillnad
 * från den förra sidan: när rutan är en komponent skrivs de tre elementen en
 * gång i källan även om sidan visar sju rutor, och då finns skälet att bygga
 * dem i webbläsaren inte kvar. Vinsten är att stilen kan vara scopad, för ett
 * element som JavaScript skapar bär inte komponentens scope-attribut.
 *
 * Utan JavaScript, eller utan urklipp, förblir knappen dold. En död knapp är
 * sämre än ingen knapp.
 *
 * ---------------------------------------------------------------------------
 * INGA RADNUMMER, TROTS ATT BÅDA FÖRLAGORNA HAR DEM
 * ---------------------------------------------------------------------------
 * Uppmätt 2026-09-05: Stripe numrerar i #55718D och Resend i #464A4D. Vi gör
 * det ändå inte, och skälet är innehållet och inte formen.
 *
 * VÅRA JSON-RUTOR ÄR KLIPPTA. Rad nio i rutan är inte rad nio i dokumentet,
 * eftersom `"codes": { … }` står där tvåhundra rader borde stå. Ett radnummer
 * är ett löfte om att man kan peka på en rad i svaret, och det löftet kan
 * rutan inte hålla. Stripes och Resends block visar hela sitt exempel och har
 * inget sådant problem.
 *
 * Det gäller inte curl-raderna heller: de är en rad lång, och att numrera den
 * med en etta är dekor.
 *
 * ---------------------------------------------------------------------------
 * INGA SPRÅKFLIKAR, AV SAMMA SORTS SKÄL
 * ---------------------------------------------------------------------------
 * Stripe har sju flikar och Resend tolv plus åtta. Båda säljer ett SDK, och
 * fliken svarar på "finns det ett paket för mitt språk". Vi säljer en statisk
 * JSON-fil bakom ett CDN. Det finns inget klientbibliotek, och sju flikar som
 * alla visar samma curl-rad i olika omskrivning hade varit ett löfte om ett
 * ekosystem som inte finns.
 */
import { farglagg, type Sprak } from '../lib/kodfarg';

interface Props {
  /** Vad rutan är: "Anrop", "Svar", "Attribution". Står först i huvudraden. */
  roll: string;
  /** Adressen eller filnamnet till höger om rollen. Utelämnas för ren text. */
  vag?: string;
  /** Färgläggningens dialekt. Se lib/kodfarg.ts. */
  sprak?: Sprak;
  /** Koden som den ska stå, radbrytningar och allt. */
  kod: string;
  /** Sätts på hjältens ruta, som får mindre grad för att rymma längre rader. */
  tat?: boolean;
}

const { roll, vag, sprak = 'text', kod, tat = false } = Astro.props;

/**
 * Kopieraknappens namn.
 *
 * "Kopiera" ensamt duger inte: sidan har sju kort, och sju knappar med samma
 * namn är sju identiska rader i en skärmläsares knapplista.
 *
 * Adressen räcker inte heller hela vägen. Terminalkorten bär `vag="bash"`, och
 * TVÅ av dem heter "Exempel", alltså hade båda fått namnet "Kopiera exempel,
 * bash". Uppmätt i den byggda sidan innan den här raden skrevs. För ett
 * terminalkort lånas därför kommandots första rad i stället, som är det enda
 * som verkligen skiljer de två åt.
 *
 * Attributionsrutan har varken adress eller kommando, och den är ensam om sin
 * roll, alltså räcker "Kopiera attribution".
 */
const knappmal = sprak === 'bash' ? kod.split('\n')[0] : vag;
const knappnamn = knappmal
  ? `Kopiera ${roll.toLowerCase()}, ${knappmal}`
  : `Kopiera ${roll.toLowerCase()}`;
---

<figure class:list={['kodkort', tat && 'tat']}>
  <figcaption class="huvud">
    <span class="roll">{roll}</span>
    {vag && <code class="vag">{vag}</code>}
    {/* Namnet räknas fram ovanför, se `knappnamn`. */}
    <button type="button" class="kopiera" aria-label={knappnamn} hidden>Kopiera</button>
  </figcaption>
  <pre class="kod"><code set:html={farglagg(kod, sprak)} /></pre>
  <span class="kvittens" role="status"></span>
</figure>

<style>
  /* ---------------------------------------------------------------------
     KORTET

     RADIEN ÄR --r-control OCH INTE --r-card, alltså 10 och inte 12, och det
     är mätt och inte tyckt. Uppmätt 2026-09-05 på de två förlagor som över
     huvud taget har ett kodblock: Stripes kort ligger på 8 px och Resends på
     4. Ingen av dem behandlar koden som ett kort i vår mening, och 12 hade
     varit dubbelt Resends. 10 är närmast det vi redan har.

     `overflow: hidden` gör att huvudradens raka kant klipps av radien i
     stället för att sticka ut i hörnen.

     INGEN SKUGGA, och det är mätt. Stripes kodkort har `boxShadow: none` med en
     1 px ram mot fyllningen, och Resend har varken ram eller skugga. Vi tar
     ramen och inte skuggan, och den är numera --hairline rakt av: mot en ljus
     yta gör tokenet exakt det arbete det finns för, alltså 1,24:1 mot vitt,
     vilket är samma linje som varje annat kort på sajten bär. */
  .kodkort {
    margin: var(--s-4) 0 0;
    background: color-mix(in srgb, var(--text) 5%, var(--card));
    border-radius: var(--r-control);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--hairline);
  }

  /* HJÄLTENS RUTA LYFTER, KROPPENS GÖR DET INTE.
     ──────────────────────────────────────────────────────────────────────
     Skillnaden är vad rutan ÄR på sin plats. I brödtexten är den ett block i
     ett dokument, och Stripe och Resend ger båda sina kodblock noll skugga.
     I hjälten är den ett FÖREMÅL som ska lossna från bandet under: Stripes
     hjältekort, det som visar kassan, bär
     `rgba(50,50,93,.25) 0 30px 60px -12px` plus ett andra lager.

     Vår motsvarighet är --shadow-pop rakt av, alltså sajtens befintliga lyft,
     som redan är ringen plus skuggan i ett token. Inga egna tal alls här
     längre: den ljusa ringen fanns bara så länge ytan var svart. */
  .tat { box-shadow: var(--shadow-pop); }

  /* ---------------------------------------------------------------------
     HUVUDRADEN

     Höjden är --h-control, 40 px, alltså samma som sajtens knapp och väljare.
     Ytan är ett steg MÖRKARE än kortet, gjord av samma två färger som kortet
     och inte av en ny ton: 10 procent --text i --card landar på ungefär
     #E8E8E9, vilket ligger på 1,10:1 mot kortets #F3F3F4. Det är precis nog
     för att raden ska läsa som en rad utan att bli ett eget fält.

     Riktningen vände med ytan. Mot en svart botten var raden ljusare, mot en
     ljus är den mörkare, och det är samma regel och inte två.
     --------------------------------------------------------------------- */
  .huvud {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    height: var(--h-control);
    padding-inline: var(--s-4);
    background: color-mix(in srgb, var(--text) 10%, var(--card));
    border-bottom: 1px solid var(--hairline);
  }

  .roll {
    flex: none;
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    letter-spacing: .06em;
    text-transform: uppercase;
    font-weight: 600;
    /* --text-muted, alltså #6E6E73, som ligger på 4,57:1 mot kortets #F3F3F4.
       Mot den svarta ytan gick tokenet inte att använda och värdet fick skrivas
       ut för hand; mot en ljus yta är det precis den grå tokenet finns för. */
    color: var(--text-muted);
  }

  /* Adressen får krympa och kapas, aldrig knuffa ut kopieraknappen. En
     kommunadress är 38 tecken och huvudraden är 300 px på telefon. */
  .vag {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }

  /* Knappen sitter längst till höger även när `.vag` saknas. */
  .vag + .kopiera { margin-left: 0; }
  .kopiera { margin-left: auto; }

  .kopiera {
    flex: none;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    padding: 4px 12px;
    font: 600 var(--fs-micro)/1.4 var(--font-sans);
    letter-spacing: .02em;
    cursor: pointer;
  }

  .kopiera:hover { border-color: var(--brand); color: var(--brand-ink); }

  /* ---------------------------------------------------------------------
     KODEN
     --------------------------------------------------------------------- */
  .kod {
    margin: 0;
    padding: var(--s-4);
    overflow-x: auto;
    color: var(--text);
    font-size: var(--fs-caption);
    line-height: 22px;
  }

  .tat .kod { font-size: 12px; line-height: 20px; }

  .kod code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: pre;
  }

  /* Rullningslisten är tunn och i sidans egen grå. Regeln fanns när kortet var
     svart, eftersom Chromes ljusa list då blev kortets ljusaste element, och
     den står kvar av det mildare skälet att en standardlist är 15 px hög under
     en ruta som är 22 px per rad. */
  .kod { scrollbar-width: thin; scrollbar-color: rgb(0 0 0 / .22) transparent; }

  /* ---------------------------------------------------------------------
     PALETTEN

     ALLT PÅ TVÅ KULÖRER, OCH DET ÄR ETT BESLUT MED SKÄL.
     ──────────────────────────────────────────────────────────────────────
     Sajten har fem färger som redan BETYDER något: grön, gul och röd är
     bedömningsskalan, mässing är utmärkelsen, blå är märket. Bibeln §14 säger
     "Grönt endast i betygsskalan". En syntaxfärgläggning som plockar in grönt
     för strängar och rött för tal hade gett sajten sin enda gröna text som
     inte betyder "utan anmärkning", på den sida som ska förklara vad
     `verdict` betyder. Det är precis fel sida att göra det på.

     Kvar står grå-axeln, 240 grader, som --text, --ink-quiet och --tone-quiet
     alla ligger exakt på, plus märkesblåns kulör, 207 grader. Paletten är
     alltså densamma som när kortet var svart, VÄND: varje värde är samma
     kulör med ljusheten spegelvänd, och kontrasten är mätt mot kortets nya
     #F3F3F4 i stället för mot dess gamla #1D1D1F.

       t-strang   --text        #1D1D1F                              15,17:1
       t-tal      #143652       hsl(207 60% 20%), samma kulör mörkad 11,27:1
       t-nyckel   --brand-ink   #0063B4                               5,50:1
       t-tom      #5A5A5E       hsl(240 2,3% 36%)                     6,44:1
       t-skilje   --text-muted  #6E6E73                               4,57:1

     Tre av fem är numera TOKEN och inte handskrivna hexvärden, och det är hela
     vinsten med att vända: mot en svart yta fanns ingen av sajtens textfärger
     att låna, mot en ljus finns de allihop.

     ROLLERNA ÄR OFÖRÄNDRADE, alltså vad läsaren faktiskt ska kunna göra med
     färgen. Det enda som vänt är vilket håll "starkast" ligger åt:
       Blått är ett NAMN man kan slå upp. Fältnamnet finns i fälttabellen
       längre ned, och terminalflaggan i curls manual. Samma färg, samma löfte.
       Mörkast är VÄRDET, alltså det man kom hit för att läsa. Mot svart var
       det den ljusaste tonen, mot vitt är det den mörkaste, och det är samma
       regel.
       Dämpat är FRÅNVARO: null, true och false. Att `verdict: null` läser som
       tystare än ett riktigt värde är sant och inte dekoration.
       Svagast är STRUKTUREN, alltså klammer och komma, som man aldrig läser.
     --------------------------------------------------------------------- */
  .kod :global(.t-nyckel) { color: var(--brand-ink); }
  .kod :global(.t-strang) { color: var(--text); }
  .kod :global(.t-tal) { color: #143652; }
  .kod :global(.t-tom) { color: #5a5a5e; font-style: italic; }
  .kod :global(.t-skilje) { color: var(--text-muted); }
  .kod :global(.t-kommando) { color: var(--text); font-weight: 600; }
  .kod :global(.t-flagga) { color: var(--brand-ink); }

  .kod :global(.t-klipp) { color: var(--text-muted); font-style: italic; }

  /* ---------------------------------------------------------------------
     KVITTENSEN

     Ligger UTANFÖR kortet och under det, i sidans egen färg, eftersom den är
     ett meddelande till läsaren och inte en del av svaret. Den tar plats även
     tom, annars hoppar allt under kortet första gången någon klickar.
     --------------------------------------------------------------------- */
  .kvittens {
    display: block;
    min-height: var(--lh-caption);
    margin-top: var(--s-2);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .kvittens { min-height: 0; margin-top: 0; }
    .kvittens:empty { display: none; }
    .kod { font-size: 12px; line-height: 20px; }
  }
</style>

<script>
  /**
   * Kopieraknappen syns först när urklippet finns.
   *
   * Skriptet skapar ingenting, det bara AVDÖLJER och kopplar. Se komponentens
   * huvudkommentar för varför det är omvänt mot den förra sidan.
   *
   * Kvittensen är `role="status"`, alltså läses den upp utan att fokus flyttas.
   * Knappen byter aldrig sin egen text: en knapp som säger "Kopierat" har
   * tappat sitt namn för den som kommer tillbaka till den med tangentbordet.
   */
  if (typeof navigator.clipboard?.writeText === 'function') {
    document.querySelectorAll<HTMLElement>('.kodkort').forEach((kort) => {
      const knapp = kort.querySelector<HTMLButtonElement>('.kopiera');
      const kod = kort.querySelector('code');
      const kvittens = kort.querySelector<HTMLElement>('.kvittens');
      if (!knapp || !kod || !kvittens) return;

      knapp.hidden = false;
      knapp.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(kod.textContent ?? '');
          kvittens.textContent = 'Kopierat.';
        } catch {
          kvittens.textContent = 'Kunde inte kopiera. Markera texten i stället.';
        }
      });
    });
  }
</script>
