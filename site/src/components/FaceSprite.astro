---
/**
 * Sprite för bedömningsmärket — läggs ut EN gång per sida, listorna pekar
 * på den med <use>.
 *
 * Varför den finns: på en kommunlista står märket bredvid varje rad, och
 * Stockholms hubb har tusentals. Inlinat kostar varje märke sin fulla markup,
 * och märkena var en gång den enskilt största posten i ett elva megabyte stort
 * dokument. Med sprite betalas ansiktet en gång per sida och varje rad kostar
 * bara en <use>-rad.
 *
 * ── Symbolerna byggs ur RIK-nivån, och det är en ändring ────────────────
 *
 * De byggdes tidigare ur nal-nivån, alltså platta, ögon, bryn och mun och
 * ingenting annat, med argumentet att märkena i en lista står i 24 till 40 px
 * och att pupillen och pälsnyanserna ändå inte syns där.
 *
 * Argumentet var mätt men ställde fel fråga. Nal-nivån ritade inte samma
 * ansikte enklare, den ritade ett annat ansikte: rundad rektangel i stället
 * för huvudkontur, inga öron, ingen nos, banden som piller och brynen som två
 * ellipser tjocka nog att läsa som ett andra par ögonlock. Ägaren såg det live
 * och kallade den "den basic grävlingen". En maskot som byter utseende mellan
 * listan och verksamhetssidan är två maskotar.
 *
 * Priset är mätt och det är litet, eftersom SPRITEN ÄR EN KONSTANT: fyra
 * symboler per dokument oavsett om sidan har tio rader eller 8 511. Bytet
 * kostar 32 350 byte rått och 1,3 till 1,5 kB gzippat per sida med lista, och
 * inte en byte mer för den som har flest rader. Talen står i lib/face.ts.
 *
 * Ansiktet kommer ur lib/face.ts. Den här filen har inga egna banor.
 */
import { FACE_KEYS, FACE_MARKUP, FACE_PLATE, FACE_RAM_RADIE, FACE_SPRITE_ID } from '../lib/face';

interface Props {
  /**
   * Finns kvar för att inte tvinga fram en ändring på varje anropsplats.
   * Formen är numera alltid en rundad kvadrat, se noten i lib/face.ts.
   */
  variant?: 'round' | 'box';
  /**
   * Detaljnivå. Lämna orörd. Nivåerna är avställda och `rik` gäller överallt,
   * se lib/face.ts. Propen står kvar så att en mätning av de gamla nivåerna
   * går att göra utan att röra komponenten.
   */
  detalj?: 'rik' | 'enkel' | 'nal';
}

const { detalj = 'rik' } = Astro.props;
---

<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0">
  {FACE_KEYS.map((key) => (
    <symbol id={`${FACE_SPRITE_ID}-${key}`} viewBox="0 0 100 100">
      <clipPath id={`${FACE_SPRITE_ID}-clip-${key}`}>
        <rect width="100" height="100" rx={FACE_RAM_RADIE} />
      </clipPath>
      <g clip-path={`url(#${FACE_SPRITE_ID}-clip-${key})`}>
        <rect width="100" height="100" fill={FACE_PLATE[key]} />
        <Fragment set:html={FACE_MARKUP[key][detalj]} />
      </g>
    </symbol>
  ))}
</svg>

<style>
  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
