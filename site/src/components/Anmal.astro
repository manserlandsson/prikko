---
/**
 * Vägen till kommunens eget anmälningsformulär.
 *
 * ---------------------------------------------------------------------------
 * DEN GAMLA INVÄNDNINGEN ÄR UPPFYLLD, INTE ÖVERTRÄDD
 * ---------------------------------------------------------------------------
 * Handlingsrad.astro säger att "Anmäl en brist" är borttagen och inte kommer
 * tillbaka, eftersom Prikko inte är tillsynsmyndighet och inte kan ta emot en
 * anmälan om dålig hygien. Skälet var att PRIKKO tog emot anmälan. Här sker
 * det motsatta: länken lämnar sajten och landar i kommunens eget formulär. Vi
 * tar inte emot någonting, vi kortar vägen till den som gör det.
 *
 * ---------------------------------------------------------------------------
 * VARFÖR RUBRIKEN NÄMNER MOTTAGAREN OCH INTE ANKLAGELSEN
 * ---------------------------------------------------------------------------
 * Sidan handlar om en namngiven verksamhet, och den får inte antyda att just
 * det här stället gjort någon sjuk. "Blev du sjuk här?" gör precis det.
 * "Anmäl till kommunen" är ett konstaterande om VAR en anmälan hamnar, aldrig
 * ett påstående om verksamheten. Ordet "misstänkt" i den första länken är
 * kommunens eget och bär hela förbehållet: man anmäler en misstanke.
 *
 * Ingen brödtext. Rubriken säger redan vart det går, alltså faller en rad om
 * att anmälan inte går till Prikko under docs/18_sprakregler.md.
 *
 * ---------------------------------------------------------------------------
 * KOMPONENTEN VET INTE VILKEN KOMMUN DET ÄR
 * ---------------------------------------------------------------------------
 * Den fick tidigare Stockholms id, namn och adress och byggde två URL:er
 * själv. Nu tar den emot färdiga vägar från lib/anmalan.ts, som är den enda
 * plats där tolv kommuners egenheter bor: förifyllning, fältnamn, tysta
 * fällor och det faktum att en kommun kan ha noll, en eller två vägar.
 *
 * Rutan säger ingenting om huruvida länken är förifylld eller allmän.
 * Besökaren bryr sig om att komma till rätt formulär, inte om hur mycket vi
 * kunde fylla i åt hen.
 *
 * En tom lista ritar ingenting. Sidmallen ska ändå låta bli att sätta ut
 * panelen då, så att den tomma `.panel`-ramen inte blir kvar.
 */

import type { Anmalningsvag } from '../lib/anmalan.ts';

interface Props {
  /** En eller två vägar, i ordning. Se lib/anmalan.ts. */
  vagar: Anmalningsvag[];
}

const { vagar } = Astro.props;
---

{/* `data-nosnippet` av samma skäl som sidopanelens övriga rutor: två
    länketiketter är en väg vidare och inte sidans svar. Google har byggt ett
    utdrag av knappnamn förut, se Handlingsrad.astro. */}
{vagar.length > 0 && (
  <div data-nosnippet>
    <h2 class="rubrik">Anmäl till kommunen</h2>

    {vagar.map((vag) => (
      <a class="btn-ghost" href={vag.href} target="_blank" rel="noopener nofollow">
        <span>{vag.etikett}</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M6 3h7v7M13 3 3.5 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ))}
  </div>
)}

<style>
  /* Samma panelrubriknivå som resten av sidopanelen. Regeln står här och inte
     i sidmallen eftersom Astros scopeade selektorer inte korsar
     komponentgränser, se ActionPanel.astro. */
  .rubrik {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    margin-top: var(--s-4);
  }

  /*
   * PANELENS EGET SPRÅK, inte ett nytt.
   *
   * Här stod först en punktlista med två råa textlänkar under en rubrik.
   * Ägaren 2026-08-25: "vad är det där för UI? ser ju sämst ut." Han har rätt,
   * och felet var inte smak. Sidopanelen har EN form för en väg vidare, och
   * den står tre centimeter längre upp i samma spalt: `.btn-ghost` i
   * ActionPanel.astro, alltså en fullbred kontur i pillerform med
   * träffytegolvets höjd. Två understrukna textrader bredvid den läser som
   * något någon glömt att göra färdigt.
   *
   * Kontur och inte fylld yta. Invändningen som stod här höll: rutan ligger
   * under "Något som inte stämmer?", vars knapp vetter mot den som DRIVER
   * stället, och två fyllda knappar här hade ropat högre än den. Konturen är
   * exakt samma vikt som grannen, vilket är hela poängen.
   *
   * Pilen säger att länken lämnar sajten. Det är en verklig skillnad mot
   * grannknappen, som stannar kvar, och den enda skillnad besökaren behöver
   * se innan hen trycker.
   */
  .btn-ghost {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    width: 100%;
    margin-top: var(--s-3);
    background: transparent;
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    min-height: var(--h-tap);
    padding: var(--s-2) 22px;
    font: 600 var(--fs-body-s) / 1.3 var(--font-sans);
    text-align: left;
  }

  .btn-ghost:hover {
    background: var(--canvas);
    color: var(--text);
    text-decoration: none;
  }

  /* Pilen krymper aldrig, texten bryts i stället. "Brister i
     livsmedelshanteringen" är 29 tecken och ryms inte på en rad i en 300 px
     spalt, alltså är radbrytning det normala fallet och inte undantaget. */
  .btn-ghost svg {
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--text-muted);
  }
</style>
