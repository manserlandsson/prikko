---
/**
 * Vad brister oftast i den här kommunen.
 *
 * Det här är hubbens enda egentliga insikt, och den fanns i datan hela tiden.
 * En besökare som kommer till /linkoping vill inte bara ha ett register — hon
 * vill veta något om orten. "Av de 117 verksamheter i Linköping som fick en
 * anmärkning gällde 36 kylkedjan" är ett svar som ingen enskild
 * restaurangsida kan ge, och som ingen annan svensk sajt publicerar.
 *
 * Talen kommer ur kommunens egna kontrollrapporter, se lib/kommunprofil.ts.
 * Formuleringarna är kommunens, inte våra: Stockholm skriver "Hygien",
 * Linköping skriver "Upprätthållande av kylkedjan och uppfyllande av
 * temperaturkriterier", Lomma skriver "rengöring". Vi skriver inte om dem —
 * det vore att lägga vår tolkning ovanpå ett myndighetsbeslut.
 *
 * Kommuner vars källa inte redovisar kontrollpunkter alls (Karlstad,
 * Jönköping) får ingen tom ruta. De får ingen ruta.
 */
import { formatNumber } from '../lib/data';
import type { CommonIssue } from '../lib/kommunprofil';
import Stapel from './Stapel.astro';

interface Props {
  issues: CommonIssue[];
  withRemarks: number;
  city: string;
  limit?: number;
}

const { issues, withRemarks, city, limit = 6 } = Astro.props;

// Stapelns längd sätts mot den vanligaste bristen, inte mot 100 %. Annars är
// varje stapel kort i en välskött kommun och sidan säger ingenting om det
// inbördes förhållandet, som är det man faktiskt läser här. Stapel.astro gör
// det utan scale-prop, men listan är redan sorterad så den största är shown[0]
// och det är värt att säga varför den skalan är rätt just här.
const rows = issues.slice(0, limit).map((i) => ({
  label: i.description,
  value: i.count,
  display: formatNumber(i.count),
}));
---

{rows.length > 0 && (
  <section class="issues" aria-labelledby="brister">
    <h2 id="brister">Vanligast bland anmärkningarna i {city}</h2>
    {/* "Så här fördelar de sig" berättade vad listan under gör. Listan gör
        det. Kvar är att formuleringarna är kommunens, och den meningen står
        inte för proveniensens skull utan för att myndighetsspråket i raderna
        annars läses som vårt. Se docs/18_sprakregler.md. */}
    <p class="intro text-secondary">
      {formatNumber(withRemarks)} verksamheter fick minst en anmärkning vid sin
      senaste kontroll. Formuleringarna är kommunens.
    </p>

    {/* Stapeln är avläsningshjälp åt siffran som redan står i klartext
        bredvid. Den bär ingen egen information och är därför neutral i färg
        (ton="tyst"). Bedömningens grön, gul och röd betyder något och får
        inte användas för att pigga upp ett stapeldiagram. */}
    <Stapel
      rows={rows}
      ton="tyst"
      label={`Vanligaste anmärkningarna i ${city}`}
    />
  </section>
)}

<style>
  /* Ingen ruta. Blocket står i fördjupningsbandet på kommunhubben, där
     sektionerna hålls isär av hårlinje och luft. Se KommunHub.astro och
     regeln i docs/19_formsystem.md: huvudinnehåll ligger aldrig i ett kort. */
  .issues h2 {
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  .intro {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  /* Raderna ritas av Stapel.astro. Spåret var 4 px här och 8 px på
     rapportsidorna, utan att skillnaden betydde något. */
</style>
