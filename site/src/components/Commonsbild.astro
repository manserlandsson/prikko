---
/**
 * Bild ur Wikimedia Commons, utpekad av Wikidatas P18.
 *
 * Ritas på 27 av 9 995 konsumentvända verksamheter. Det är genomgående de
 * gamla krogarna: Den Gyldene Freden, Operakällaren, Riche, Ekstedt, Sturehof,
 * Pelikan, Mäster Anders. Se docs/37_osm_taggar.md §5 och
 * pipeline/prikko/commons.py för hur urvalet görs och spärras.
 *
 * `image.url` pekar på VÅR kopia i vår egen objektlagring, aldrig på Commons
 * adress. Att peka på upload.wikimedia.org för 27 bilder är att lägga vår last
 * på en stiftelses infrastruktur, och en URL som ändras ger en trasig bild utan
 * att något bygge klagar. Samma regel som gatubilderna följer, se StreetPhoto.
 *
 *
 * ═══ VARFÖR ATTRIBUTIONEN INTE LIGGER I (i)-KNAPPEN ═══
 *
 * Ägaren har sagt ordagrant om öppettidernas och kontaktuppgifternas källa:
 * "skriv inte ut openstreetmap, den ska ligga i I-ikonen, HA INGET SÅNT där."
 * Den regeln följs överallt annars på sidan. Här bryts den, med avsikt, och
 * skälet är licensen och ingenting annat.
 *
 * VAD SOM ÄR MINIMIKRAVET. CC BY-SA 4.0 avsnitt 3(a)(1)(A) kräver att den som
 * delar materialet behåller, i den mån upphovspersonen lämnat dem: namnet på
 * upphovspersonen, en upphovsrättsnotis, en notis som hänvisar till licensen,
 * en notis som hänvisar till garantifriskrivningen, och en URI till materialet
 * "to the extent reasonably practicable". 3(a)(1)(B) kräver att ändringar
 * anges. Avsnitt 3(a)(2) lägger till att villkoren får uppfyllas "in any
 * reasonable manner based on the medium, means, and context", och nämner
 * uttryckligen att en länk till en resurs som innehåller uppgifterna kan räcka.
 * Äldre versioner (3.0 och 2.0) har samma krav med annan numrering.
 *
 * VAD SOM ÄR VÅR TOLKNING. Sista meningen betyder att en (i)-knapp med en länk
 * till filsidan formellt SKULLE kunna räcka. Vi gör ändå inte så. "Reasonable
 * manner" prövas mot mediet, och på en webbsida med en enda liten bild i en
 * spalt är den vedertagna formen en synlig bildtext; det är också den form
 * Commons själv rekommenderar sina återanvändare. Att gömma fotografens namn
 * bakom ett klick när det får plats på raden under bilden är att välja den
 * snålaste tolkningen av ett villkor som finns till för någon annan än oss.
 *
 * SKILLNADEN MOT ÖPPETTIDEN ÄR ALLTSÅ INTE EN INKONSEKVENS. ODbL kräver att
 * upphovet är rimligt synligt där uppgiften visas, och en (i) intill uppgiften
 * är den form kartbranschen använder mot precis den licensen. CC BY och CC
 * BY-SA är avtal med varje enskild fotograf, och 23 av de 27 bilderna bär
 * `AttributionRequired = true` i Commons egna metadata.
 *
 *
 * ═══ VARFÖR EN FORM OCH INTE TVÅ ═══
 *
 * Fyra av de 27 är public domain och kräver ingen attribution alls. De får
 * ändå samma bildtext, av två skäl som inte är juridiska:
 *
 *   1. Årtalet är ett ÄRLIGHETSkrav och inte ett licenskrav. Tre av de 27
 *      föreställer rätt ställe fel årtionde: Wirströms 1959, Blå porten
 *      1912 till 1920, Rosendals värdshus 1966. En bild från 1915 utan årtal
 *      är ett påstående om hur det ser ut i dag, och det påståendet är falskt.
 *      Alla tre är dessutom just public domain, så formen måste finnas där.
 *   2. Commons vet vem som tog dem, Lennart af Petersens och Ingemar Gram. Att
 *      stryka en fotograf ur bildtexten för att vi juridiskt får är sämre för
 *      läsaren och gör de fyra sidorna till de enda utan proveniens.
 *
 * En andra form hade alltså kostat kod och en delad läsupplevelse för att
 * spara en rad på fyra sidor av 9 995.
 *
 *
 * `loading="lazy"`: bilden ska aldrig konkurrera med sidans LCP. Bedömningen
 * är hjälten, inte fasaden.
 */
import type { StreetImage } from '../lib/data';

interface Props {
  image: StreetImage;
  name: string;
}

const { image, name } = Astro.props;

/**
 * Licensen skrivs av koden i datan och gissas aldrig här.
 *
 * `image.licence` är den kod pipelinen läste ur Commons `extmetadata.License`,
 * alltså källans eget maskinvärde och inte en text vi tolkat. Kommer en kod vi
 * inte känner igen visas ingen bild alls: en bild utan sann licensrad är
 * precis det vi inte får publicera, och tomt är alltid det säkra utfallet.
 *
 * Fördelningen över de 27, mätt 2026-08-18: CC BY-SA 3.0 elva, CC BY-SA 4.0
 * åtta, public domain fyra, CC BY-SA 2.0 två, CC BY 2.0 en, CC BY 3.0 en.
 * De fyra återstående koderna står med för att en fil kan byta licens på
 * Commons utan att någon här märker det.
 */
const LICENCES: Record<string, { label: string; href: string | null }> = {
  'CC-BY-SA-4.0': { label: 'CC BY-SA 4.0', href: 'https://creativecommons.org/licenses/by-sa/4.0/deed.sv' },
  'CC-BY-SA-3.0': { label: 'CC BY-SA 3.0', href: 'https://creativecommons.org/licenses/by-sa/3.0/deed.sv' },
  'CC-BY-SA-2.5': { label: 'CC BY-SA 2.5', href: 'https://creativecommons.org/licenses/by-sa/2.5/deed.sv' },
  'CC-BY-SA-2.0': { label: 'CC BY-SA 2.0', href: 'https://creativecommons.org/licenses/by-sa/2.0/deed.sv' },
  'CC-BY-4.0': { label: 'CC BY 4.0', href: 'https://creativecommons.org/licenses/by/4.0/deed.sv' },
  'CC-BY-3.0': { label: 'CC BY 3.0', href: 'https://creativecommons.org/licenses/by/3.0/deed.sv' },
  'CC-BY-2.5': { label: 'CC BY 2.5', href: 'https://creativecommons.org/licenses/by/2.5/deed.sv' },
  'CC-BY-2.0': { label: 'CC BY 2.0', href: 'https://creativecommons.org/licenses/by/2.0/deed.sv' },
  'CC0-1.0': { label: 'CC0', href: 'https://creativecommons.org/publicdomain/zero/1.0/deed.sv' },
  // Public domain är ingen licens och har ingen licenstext att länka till.
  // Raden står ändå, för läsaren ska få veta varför just den här bilden inte
  // bär något villkor.
  PD: { label: 'Public domain', href: null },
};

const licence = image.licence ? LICENCES[image.licence] ?? null : null;

/**
 * URI:n till materialet, som avsnitt 3(a)(1)(A)(v) ber om.
 *
 * Filsidan och inte bildfilen: filsidan bär originalet, licensen, fotografen
 * och filens hela historik, medan bildfilen bär ingenting av det. Adressen
 * byggs av `image.id`, som är filens namn på Commons, samma form som
 * pipeline/prikko/commons.py `file_page_url` skriver.
 */
const filePage = image.id
  ? `https://commons.wikimedia.org/wiki/File:${encodeURIComponent(image.id.replace(/ /g, '_'))}`
  : null;

/**
 * Bildtexten byggs i pipelinen och skrivs ut ordagrant här.
 *
 * "Foto: Holger.Ellgaard, 2013", eller "Okänd fotograf, 1912 till 1920" när
 * Commons säger att upphovspersonen är okänd. Att bygga meningen där och inte
 * här är ett val: attributionen är ett licensvillkor, och den ska följa bilden
 * genom databasen i stället för att sättas ihop på nytt av varje mall som
 * råkar visa den. Se commons.credit_line.
 */
const credit = image.attribution ?? null;

// Utan känd licens visas ingenting. Se LICENCES.
const show = licence !== null;
---

{show && (
  <figure class="photo">
    <img
      src={image.url}
      alt={`Foto på ${name}`}
      width="600"
      height="400"
      loading="lazy"
      decoding="async"
      data-commons-photo
    />
    <figcaption class="text-muted">
      {credit && <span class="line">{credit}</span>}
      <span class="line">
        {filePage ? (
          <a href={filePage} target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>
        ) : (
          <span>Wikimedia Commons</span>
        )}
        {' · '}
        {licence.href ? (
          <a href={licence.href} target="_blank" rel="noopener noreferrer">{licence.label}</a>
        ) : (
          <span>{licence.label}</span>
        )}
        {/* Ändringsangivelsen enligt 3(a)(1)(B). Vi lagrar en nedskalad kopia
            i 1024 bildpunkters bredd och WebP i stället för originalets upp
            till 6 720 × 4 480 JPEG, och det ska stå. Ordet är också det som
            gör länken ovan meningsfull: den som vill ha originalet vet nu att
            det finns ett och var. */}
        {' · nedskalad'}
      </span>
    </figcaption>
  </figure>
)}

{/*
  En bild som inte går att hämta ska ta med sig sin bildtext ut.

  Samma sista försvar som StreetPhoto.astro har, och av samma skäl: objekt kan
  försvinna ur lagringen och en URL som var sann vid bygget behöver inte vara
  det en månad senare. Utan det här blir utfallet en trasig ruta med en söndrig
  ikon, under en bildtext som namnger en fotograf vars bild inte syns.
*/}
<script is:inline>
  document.querySelectorAll('img[data-commons-photo]').forEach((img) => {
    img.addEventListener('error', () => img.closest('figure')?.remove(), { once: true });
    // Bilder som redan hunnit misslyckas innan skriptet kördes har complete
    // satt men ingen naturlig bredd.
    if (img.complete && img.naturalWidth === 0) img.closest('figure')?.remove();
  });
</script>

<style>
  .photo {
    margin: 0 0 var(--s-3);
  }

  .photo > img {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: var(--r-control);
    background: var(--canvas);
  }

  /* Två rader och inte en, till skillnad från gatubildens bildtext.
     Den övre är den mänskliga uppgiften, vem som tog bilden och när. Den
     undre är licensmaskineriet. Att pressa ihop dem till en rad hade gett
     fem segment på 268 px, alltså ett radbrott mitt i ett fotografnamn. */
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--s-1);
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
  }

  .line {
    min-width: 0;
  }
</style>
