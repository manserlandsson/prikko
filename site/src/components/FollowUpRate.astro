---
/**
 * Ledde återbesöken till åtgärd, i kommunen?
 *
 * Hubbens andra egentliga insikt, vid sidan av vad som brister oftast. Den
 * svarar på något ingen enskild verksamhetssida kan svara på och som ingen
 * annan svensk sajt publicerar: när kommunen väl kommer tillbaka, är det då
 * åtgärdat?
 *
 * Talet är en summa av per-verksamhetsutfall och inte starkare än varje
 * enskilt utfall. Det är därför nämnaren är byggd som den är: varje rad i den
 * är TVÅ KONKRETA KONTROLLER på samma adress med veckor emellan, inte en
 * summering av en verksamhets historia över år. Se followUpRecord() i
 * kommunprofil.ts och followUp() i data.ts.
 *
 * Kommuner utan underlag får ingen ruta, inte en tom sådan.
 */
import InfoTip from './InfoTip.astro';
import Kommunstapel from './Kommunstapel.astro';
import { formatNumber } from '../lib/data';
import type { FollowUpRecord } from '../lib/kommunprofil';

interface Props {
  record: FollowUpRecord | null;
  city: string;
}

const { record: r, city } = Astro.props;

/*
 * Två rader, inte en mätare plus ett rutnät med samma två tal i.
 *
 * Avsnittet ritade tidigare en egen stapel, svart och nästan full bredd, och
 * DÄRUNDER en lista med de två talen mätaren redan handlade om. Talen stod
 * alltså två gånger, och stapeln var ett annat formspråk än de i avsnittet
 * ovanför. Nu är det två rader i bandets enda stapelform, skalade mot
 * helheten så att de går ihop till hela underlaget.
 */
const rows = r
  ? [
      {
        label: 'utan kvarstående anmärkning',
        value: r.resolved,
        display: formatNumber(r.resolved),
        andel: `${r.share} %`,
      },
      {
        label: 'där något kvarstod',
        value: r.remaining,
        display: formatNumber(r.remaining),
        andel: `${100 - r.share} %`,
      },
    ]
  : [];
---

{r && (
  <section class="rate" aria-labelledby="uppfoljning">
    <h2 id="uppfoljning">
      Ledde återbesöken till åtgärd i {city}?
      <InfoTip
        label="återbesöken"
        text="Räknat per verksamhet. Varje fall är två kontroller på samma adress med veckor emellan: en som noterade brister och en uppföljning. Utfallet är kommunens egen anteckning eller bedömning av uppföljningen, aldrig vår slutsats."
      />
    </h2>

    {/* Meningen sätter nämnaren och stannar där. Den sa förut också hur många
        av dem som var åtgärdade, alltså exakt det talet den första stapeln
        under den säger, och tredje gången samma tal stod på ytan var i listan
        som nu är borta. */}
    <p class="answer">
      Kommunen följde upp en anmärkning hos <b>{formatNumber(r.total)}</b> verksamheter.
    </p>

    {/* Neutrala staplar. Andelen står i klartext bredvid, så stapeln bär
        ingen egen information, och bedömningens grön, gul och röd betyder
        något och får inte lånas ut till dekor. */}
    <Kommunstapel
      rows={rows}
      scale={r.total}
      label={`Av ${formatNumber(r.total)} uppföljningar i ${city}`}
    />

    <p class="caveat">
      Talet går inte att ställa mot en annan kommuns: källorna redovisar
      uppföljningen på olika sätt.
      {' '}<a href="/metodik/#jamfor">Varför vi inte rangordnar kommuner</a>.
    </p>
  </section>
)}

<style>
  /* Ingen ruta, se CommonIssues.astro och docs/19_formsystem.md. */
  .rate h2 {
    display: flex;
    align-items: center;
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  .answer {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .answer b {
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Staplarna ritas av Kommunstapel.astro, bandets enda stapelform. Den egna
     mätaren som stod här var svart och nästan full bredd, alltså ett annat
     formspråk än staplarna i avsnittet ovanför. Se Kommunstapel.astro. */

  /* Samma småstil som i Kontrollen, Tathet och Uncovered. */
  .caveat {
    margin-top: var(--s-4);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }
</style>
