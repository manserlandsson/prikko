---
/**
 * Bedömningsmärket — varumärket och bedömningen i samma tecken.
 *
 * Märket är Prikkos grävling, beskuren till ansiktet. All geometri kommer ur
 * lib/face.ts och komponenten har INGA egna kopior. Den bar tidigare en egen
 * uppsättning banor med en kommentar om att den borde importera i stället, och
 * två kopior av en sanning divergerar alltid till slut.
 *
 * FORMEN ÄR EN RUNDAD KVADRAT, ÖVERALLT. Ägarens beslut, och skälen står i
 * lib/face.ts. Propen `variant` finns kvar för att inte tvinga fram en ändring
 * på ett fyrtiotal anropsplatser, men båda värdena ritar numera samma form.
 * `round` var förr en vit cirkel med färgad ring, en lättare form för listor,
 * och den skillnaden bärs nu av storleken i stället för av formen.
 *
 * DETALJNIVÅN VÄLJS AV KOMPONENTEN, inte av anropsplatsen. Ett ansikte med
 * pupill och pälsnyanser är meningslöst i 16 px och kostar tio gånger så mycket
 * att skicka. Regeln bor i faceDetalj() och gränserna är mätta, inte valda.
 *
 * Tillgänglighet: ansiktet är förstärkning. Betydelsen bärs alltid av texten
 * bredvid, aldrig av färgen eller minen ensam. Skillnaden mellan de tre
 * bedömningarna sitter i brynens vinkel och munnens båge, och båda är prövade
 * ensamma i 24 px i gråskala.
 */
import type { VerdictOrNone } from '../lib/site';
import { FACE_MARKUP, FACE_PLATE, faceDetalj, faceKey } from '../lib/face';

interface Props {
  verdict: VerdictOrNone;
  size?: number;
  variant?: 'box' | 'round';
  /** Låt munnen ritas upp när märket kommer in. */
  animate?: boolean;
  /**
   * Låt märket blinka, med långt uppehåll mellan blinkningarna.
   *
   * Bara för godkända verksamheter. Måste sättas medvetet per användning: en
   * kommunsida listar hundratals gröna ansikten, och skulle de blinka allihop
   * vore sidan oläslig. Blinkningen hör hemma på det stora märket högst upp på
   * en verksamhets sida, där den är ett enskilt tecken och inte ett myller.
   */
  wink?: boolean;
  /**
   * Tvinga en detaljnivå. Finns för prov och för de få ställen där ytan är
   * större än storleken antyder. Lämna orörd i vanliga fall.
   */
  detalj?: 'rik' | 'enkel' | 'nal';
}

const {
  verdict,
  size = 56,
  variant = 'box',
  animate = false,
  wink = false,
  detalj,
} = Astro.props;

const key = faceKey(verdict);
const niva = detalj ?? faceDetalj(size);
const ansikte = FACE_MARKUP[key][niva];

// Blinkningen är förstärkning av ett gott besked. Att låta en verksamhet med
// brister blinka vore att sockra ett underkännande.
const winking = wink && verdict === 'clean';
---

<svg
  class:list={['face', variant, { animate, winking }]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="100" height="100" fill={FACE_PLATE[key]} />
  <Fragment set:html={ansikte} />
</svg>

<style>
  /* Ramen rundas med CSS och inte med en clipPath i svg:n, och det är en
     mätt skillnad och ingen stilfråga.
     
     Första versionen la ett <defs><clipPath> i varje märke. På kedjesidan för
     ICA blev det 104 clipPath-block, alltså omkring 18 kB på en enda sida, för
     en form som är identisk i varenda instans. `inset(0 round 17%)` ligger i
     stilmallen en gång och kostar noll per märke.
     
     17 procent är samma radie som viewBoxens rx 17 på 100 enheter, alltså
     exakt samma form. Se FACE_RAM_RADIE i lib/face.ts. */
  .face {
    display: block;
    flex-shrink: 0;
    clip-path: inset(0 round 17%);
  }

  /* Munnen ritas upp när märket kommer in. Diskret — det här är ett
     register, inte en app-onboarding.

     Munnen är en egen bana i figuren och bär klassen `mun`, så uppritningen
     kan hitta den utan att komponenten känner till geometrin. */
  .animate :global(.mun) {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: draw .45s cubic-bezier(.4, 0, .2, 1) .1s forwards;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  /* Blinkningen. Den bor numera i ÖGONLOCKEN, som figuren redan har som eget
     system, i stället för i en hoptryckning av hela ögat. Skillnaden är att ett
     lock som faller läser som en blinkning, medan ett öga som skalas i höjd
     läser som en bild som klämts ihop.

     Namnet måste vara unikt. @keyframes är GLOBALA i CSS. Astro scopar
     selektorer men inte keyframe-namn, och den här hette tidigare `wink`,
     vilket krockade med sidhuvudets, som numera heter `wordmark-wink`.

     ── Varför den ser ut som den gör ─────────────────────────────────────
     En tidigare version var 0,4 sekunder lång, kördes en enda gång 0,65 s
     efter sidladdning och tryckte ihop ögat till 12 %. Den avlöpte medan
     besökaren fortfarande läste verksamhetens namn och var över innan blicken
     hann till märket. En animation som bara syns om man råkar titta på rätt
     plats vid rätt tiondels sekund finns i praktiken inte.

     Locket sitter i viloläget precis ovanför ögats överkant och är därmed
     osynligt. Blinkningen skalar det NEDÅT, alltså med origo i överkanten, så
     att det faller över ögat och lyfts igen.

     Nu är cykeln 8 sekunder och blinkningen upptar de första tio procenten:
     locket faller på 0,32 s, står nere i 0,12 s och lyfts på 0,32 s. Drygt sju
     sekunders stillhet följer, och det är uppehållet som gör att upprepningen
     läser som ett andetag och inte som en tic.

     Fördröjningen på 0,9 s låter munnen ritas klart först. Två animationer på
     samma ansikte samtidigt läser som en glitch. */
  .winking :global(.lock-hoger) {
    transform-box: fill-box;
    transform-origin: top;
    animation: facemark-wink 8s cubic-bezier(.4, 0, .2, 1) .9s infinite;
  }

  @keyframes facemark-wink {
    0%, 1%      { transform: scaleY(1); }
    5%, 6.5%    { transform: scaleY(6); }
    10.5%, 100% { transform: scaleY(1); }
  }

  /* Rörelse kan utlösa yrsel och illamående hos den som har en vestibulär
     sjukdom. Att respektera inställningen är inte en artighet — den som
     bett om mindre rörelse har oftast ett medicinskt skäl. */
  @media (prefers-reduced-motion: reduce) {
    .animate :global(.mun) {
      animation: none;
      stroke-dashoffset: 0;
    }

    .winking :global(.lock-hoger) {
      animation: none;
    }
  }
</style>
