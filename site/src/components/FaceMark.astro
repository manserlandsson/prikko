---
/**
 * Bedömningsmärket — varumärket och bedömningen i samma tecken.
 *
 * Geometrin är Måns egen, ritad i Figma och levererad som SVG i brand/:
 * green/yellow/red-smiley-box.svg och -round.svg. Banorna nedan är kopierade
 * ordagrant därifrån. Ändras filerna ska den här komponenten följa — den är
 * inte en tolkning av logotypen, den ÄR logotypen.
 *
 * Två varianter:
 *   box   — fylld kvadrat med gradient, vit min. Bär tyngd, används där
 *           bedömningen är sidans huvudbudskap och som kartnål.
 *   round — vit cirkel med färgad ring. Lättare, används i listor där många
 *           märken står bredvid varandra och fyllda rutor blir tunga.
 *
 * Tillgänglighet: ansiktet är förstärkning. Betydelsen bärs alltid av texten
 * bredvid, aldrig av färgen eller minen ensam.
 */
import type { VerdictOrNone } from '../lib/site';

interface Props {
  verdict: VerdictOrNone;
  size?: number;
  variant?: 'box' | 'round';
  /** Låt munnen ritas upp när märket kommer in. */
  animate?: boolean;
}

const { verdict, size = 56, variant = 'box', animate = false } = Astro.props;

const key = verdict ?? 'none';

/** Gradientstopp ur originalfilerna. */
const FILL: Record<string, [string, string]> = {
  clean: ['#00B92B', '#009523'],
  minor: ['#FECB00', '#DEB201'],
  major: ['#FF0000', '#C50000'],
  none: ['#C7C7CC', '#AEAEB2'],
};

/** Ringfärg i den runda varianten. */
const RING: Record<string, string> = {
  clean: '#00B92B',
  minor: '#FECB00',
  major: '#FF0000',
  none: '#C7C7CC',
};

/** Munnens bana. Glad, rak, ledsen — exakt som i originalen. */
const MOUTH: Record<string, string> = {
  clean: 'M32 57.4883C44.2457 69.1509 56.4915 69.1509 68.7372 57.4883',
  minor: 'M32 61.0004C44.5 61 56.5 60.9995 68.7372 61.0004',
  major: 'M32 64.2196C44.5511 57.3262 56.6858 57.1944 68.7372 64.2196',
  none: 'M40 61.0004C46 61 54 61 60 61.0004',
};

const EYE_LEFT =
  'M39.8719 45.2457C43.2535 45.2457 45.9948 42.5044 45.9948 39.1229C45.9948 35.7413 43.2535 33 39.8719 33C36.4903 33 33.749 35.7413 33.749 39.1229C33.749 42.5044 36.4903 45.2457 39.8719 45.2457Z';
const EYE_RIGHT =
  'M62.6141 45.2457C65.9957 45.2457 68.737 42.5044 68.737 39.1229C68.737 35.7413 65.9957 33 62.6141 33C59.2325 33 56.4912 35.7413 56.4912 39.1229C56.4912 42.5044 59.2325 45.2457 62.6141 45.2457Z';

// Unikt id per instans — flera märken på samma sida får inte dela gradient.
const gradientId = `pg-${key}-${Math.random().toString(36).slice(2, 8)}`;

const ink = variant === 'box' ? '#fff' : RING[key];
---

<svg
  class:list={['face', variant, { animate }]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {variant === 'box' ? (
    <>
      <defs>
        <linearGradient id={gradientId} x1="50" y1="0" x2="50" y2="100" gradientUnits="userSpaceOnUse">
          <stop stop-color={FILL[key][0]} />
          <stop offset="1" stop-color={FILL[key][1]} />
        </linearGradient>
      </defs>
      <rect width="100" height="100" rx="17" fill={`url(#${gradientId})`} />
    </>
  ) : (
    <rect x="3.5" y="3.5" width="93" height="93" rx="46.5" fill="#fff" stroke={RING[key]} stroke-width="7" />
  )}

  <path d={EYE_LEFT} fill={ink} />
  <path d={EYE_RIGHT} fill={ink} />
  <path d={MOUTH[key]} stroke={ink} stroke-width="7.87226" stroke-linecap="round" fill="none" />
</svg>

<style>
  .face {
    display: block;
    flex-shrink: 0;
  }

  /* Munnen ritas upp när märket kommer in. Diskret — det här är ett
     register, inte en app-onboarding. */
  .animate path:last-child {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: draw .45s cubic-bezier(.4, 0, .2, 1) .1s forwards;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate path:last-child {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
