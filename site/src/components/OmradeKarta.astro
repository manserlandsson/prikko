---
/**
 * Områdets egen karta: konturen och verksamheterna i den, ritad vid bygget.
 *
 * Ingen MapLibre och ingen JavaScript. Skälet är detsamma som gav kommunhubben
 * sin punktbild i stället för en levande karta, och det står utskrivet i
 * KartaPuff.astro: kartprogrammet väger 231 kB brotlat och den här sidan väger
 * några tiotal. Skillnaden är att ett område har något en kommun saknar, en
 * KONTUR, och konturen är det som gör bilden till en karta i stället för till
 * ett punktmoln. Man ser var Södermalm slutar.
 *
 * Konturen är OSM:s egen och ritas oförändrad. Den är därmed en återgiven
 * uppgift och inte en härledd, vilket är exakt varför sidtypen bara finns där
 * polygonen finns. Se pipeline/omraden.py.
 *
 * Punkterna bär bedömningens färger, samma som listan under. De är dekor i den
 * meningen att ingen kan klicka dem, och information i den meningen att man ser
 * var i området bristerna ligger.
 */
import type { Area } from '../lib/omraden';
import { areaBounds } from '../lib/omraden';
import type { Establishment } from '../lib/data';
import '../styles/kartram.css';

interface Props {
  area: Area;
  items: Establishment[];
  /** Områdets namn, för den alternativa texten. */
  city: string;
}

const { area, items, city } = Astro.props;

const W = 640;
const H = 420;
const PAD = 14;

const [west, south, east, north] = areaBounds(area);

/*
 * Longituden krymps med latitudens cosinus. Utan det blir Stockholm ihoptryckt
 * på höjden: en longitudgrad är ungefär halva en latitudgrads längd på 59:e
 * breddgraden, och en kontur ritad rakt av i grader ser fel ut på ett sätt man
 * inte kan sätta fingret på men genast ser.
 */
const k = Math.cos(((south + north) / 2) * (Math.PI / 180));
const spanX = Math.max((east - west) * k, 1e-9);
const spanY = Math.max(north - south, 1e-9);

// En skala för båda axlarna, annars sträcks konturen ur form.
const scale = Math.min((W - PAD * 2) / spanX, (H - PAD * 2) / spanY);
const offX = (W - spanX * scale) / 2;
const offY = (H - spanY * scale) / 2;

function px(lon: number, lat: number): [number, number] {
  return [
    offX + (lon - west) * k * scale,
    // SVG räknar y nedåt, kartan räknar norr uppåt.
    offY + (north - lat) * scale,
  ];
}

function ringPath(ring: number[][]): string {
  return (
    ring
      .map(([lon, lat], i) => {
        const [x, y] = px(lon, lat);
        return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
      })
      .join('') + 'Z'
  );
}

// Ytterringar och hål i samma bana. `fill-rule: evenodd` gör hålen till hål.
const outline = [...area.outer, ...area.inner].map(ringPath).join('');

const COLOUR: Record<string, string> = {
  clean: 'var(--verdict-clean)',
  minor: 'var(--verdict-minor)',
  major: 'var(--verdict-major)',
};

const dots = items
  .filter((e) => e.lat !== null && e.lng !== null)
  .map((e) => {
    const [x, y] = px(e.lng!, e.lat!);
    return { x: x.toFixed(1), y: y.toFixed(1), fill: e.verdict ? COLOUR[e.verdict] : 'var(--verdict-none)' };
  });
---

<figure class="omradeskarta">
  <div class="kartram">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      width={W}
      height={H}
      role="img"
      aria-label={`Karta över ${area.name} i ${city} med ${dots.length} verksamheter utsatta`}
    >
      <path d={outline} class="yta" fill-rule="evenodd" />
      {dots.map((d) => <circle cx={d.x} cy={d.y} r="2.6" fill={d.fill} class="prick" />)}
    </svg>
  </div>
</figure>

<style>
  .omradeskarta {
    margin: 0;
  }

  /* Rutan sätter sitt eget mått, ramen kommer från kartram.css. */
  .kartram {
    aspect-ratio: 640 / 420;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Ytan är tonad och kanten hårfin. Konturen ska läsa som en avgränsning,
     inte som en markerad figur: sidan handlar om verksamheterna i området,
     inte om områdets form. */
  .yta {
    fill: color-mix(in srgb, var(--brand) 7%, transparent);
    stroke: color-mix(in srgb, var(--brand) 45%, transparent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* Vit ring runt varje prick, så att två grannar inte flyter ihop till en
     klump i de tätaste kvarteren. */
  .prick {
    stroke: var(--card);
    stroke-width: 0.9;
  }
</style>
