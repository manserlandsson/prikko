---
/**
 * Områdets karta: en riktig karta med gator och omgivning, med gränsen ovanpå.
 *
 * Här låg tidigare en ritad kontur: en blå polygon med prickar i, svävande i
 * vitt. Ägarens dom var att det inte var en karta, och den är riktig. En
 * kontur visar formen på ett administrativt område, vilket är det enda ingen
 * besökare undrar över. Den som läser om Bandhagen vill veta VAR i Stockholm
 * det ligger och vad som finns runt omkring, och den frågan kan bara en karta
 * med omgivning besvara.
 *
 * Fyra saker följer av det, och alla fyra är krav och inte smak:
 *
 * 1. **Riktiga kartblad.** MapLibre mot vår egen stil, samma som kartsöksidan
 *    och kommunhubben. Gator, vatten och kvarter, inte tomt papper.
 * 2. **Gränsen är ett LAGER, inte bilden.** Den ligger ovanpå kartan som en
 *    markering och tar inte hela ytan i anspråk.
 * 3. **Omgivningen syns och går att panorera till.** Ett område är ingen ö.
 *    Fönstret öppnar därför vidare än gränsen, se PADDING nedan.
 * 4. **Verksamheterna utanför gränsen ritas också**, nedtonade. Ett område
 *    där allt utanför är tomt ser ut som ett fel, och gränsen betyder
 *    ingenting om det inte finns något på andra sidan den.
 *
 * ## Masken, och varför den inte bryter mot färgregeln
 *
 * Utanför gränsen ligger ett mörkt skikt över UNDERLAGSKARTAN. Området läses
 * då direkt, utan att ögat först måste följa en tunn linje runt hela ytan.
 * Greppet är Boolis, uppmätt och inte gissat, se `masken` nedan för talen.
 *
 * Det här ser ut att krocka med regeln längre ned, att nedtoning sker med
 * storlek och opacitet och ALDRIG med färg eftersom grått betyder "ingen
 * bedömning" överallt annars på sajten. Det gör det inte, och skillnaden är
 * hela poängen:
 *
 * - Regeln gäller **bedömningsmärkena**. En nål, en prick eller en bubbla
 *   bär en bedömning, och den betydelsen får aldrig lånas ut till en färg
 *   som betyder något annat.
 * - Masken rör **ingen enda nål**. Den ligger under varje punktlager och
 *   mörknar gator, vatten och kvarter. En grön restaurang tvärs över gatan
 *   är fortfarande grön, bara ställd på mörkare mark.
 *
 * Riv alltså inte ut masken med hänvisning till färgregeln. Rör den däremot
 * ett punktlager är det färgregeln som gäller, och då är det masken som är
 * fel byggd.
 *
 * ## Vikten
 *
 * Villkoren för uppvaknandet är ordagrant KartaPuffs, och skälen står där i
 * sin helhet: MapLibre väger 231 kB brotlat och får aldrig ligga i
 * sidladdningen. Kartan vaknar när rutan syns, efter `load`, i en
 * tomgångslucka, och den vaknar inte alls vid `saveData`, vid uppkoppling
 * sämre än 4g eller vid `prefers-reduced-data`. Den som kommer från Google på
 * en telefon med dålig uppkoppling får stillbilden och knappen och betalar
 * noll extra byte.
 *
 * ## Var punkterna kommer ifrån
 *
 * Rutarkivet, alltså `punkter-<hash>.bin`, samma fil som kommunhubbens ruta
 * och den delade vyn läser. Här låg tidigare kommunens egen punktfil ur
 * `map-data.ts`, och den var sajtens SISTA andra dataväg: två pipelines mot
 * samma sanning, som kunde glida isär utan att något sa ifrån. Med den borta
 * försvinner `map-data.ts` och `pages/kartdata/[file].json.ts` helt, se steg 7
 * i docs/23_rikskartan.md.
 *
 * Bytet kostar en sak och ger en.
 *
 * Kostnaden är att rutorna är KLUSTRADE upp till zoom 13, och de femtiotre
 * områdena öppnar mellan z11,2 och z18,5. På de flesta av dem ligger alltså
 * merparten av punkterna i bubblor vid första anblicken, i stället för som
 * lösa prickar. Bubblorna tonas ned på samma sätt som nålarna och innanför och
 * utanför skiljs likadant, så bilden säger samma sak; att i stället gömma dem
 * hade lämnat en tom karta på varje område i innerstaden.
 *
 * Vinsten är att webbläsaren hämtar sitt UTSNITT och inte hela kommunen.
 * Stockholms punktfil vägde 106 kB brotlad innan en enda prick kunde ritas,
 * och ett områdesutsnitt är några kilobyte.
 *
 * Stillbilden ritas fortfarande vid bygget, och den ritar varje punkt löst.
 * Den läser `establishments()`, alltså precis de rader rutarkivet självt
 * byggs av, ett steg tidigare i samma kedja. Det är inte en andra dataväg
 * tillbaka: det är databasen, och rutorna är det enda som härleds ur den.
 *
 * ## Var gränsen delas
 *
 * Vilken punkt som ligger innanför avgörs på TVÅ ställen: här vid bygget för
 * stillbilden, och i webbläsaren för den levande kartan. De måste svara
 * likadant, annars hoppar prickarna färg i samma sekund som kartbladen kommer.
 *
 * Byggsidan använder `containsPoint` i lib/omraden.ts. Klientsidan bar en egen
 * kopia av strålmetoden, eftersom modulen inte följer med till webbläsaren.
 * Kopian är borta: MapLibres `within` prövar punkten mot samma ringar i ett
 * lagerfilter, alltså i arbetartråden när rutan packas upp. En kopierad
 * algoritm mindre är en sanning mindre att hålla synkroniserad.
 *
 * Ringarna skickas som en MultiPolygon med EN polygon per ytterring och hålen
 * på var och en. Det är `containsPoint` uttryckt i GeoJSON: innanför någon
 * ytterring och inte i något hål. Formen `[...outer, ...inner]` som stod här
 * förut betyder något annat i GeoJSON, nämligen att allt utom den första
 * ringen är ett hål, och den läser fel för Torvinge industriområde i
 * Linköping, som har elva ytterringar.
 */
import { establishments, formatNumber, type Municipality } from '../lib/data';
import { MAP_VERDICTS, tileSet } from '../lib/kartrutor';
import { areaBounds, areaSource, containsPoint, type Area, type AreaSourceId } from '../lib/omraden';
import '../styles/kartram.css';

interface Props {
  kommun: Municipality;
  area: Area;
  /** Antal verksamheter i området. Bara för den alternativa texten. */
  count: number;
}

const { kommun, area, count } = Astro.props;

/** Stillbildens låda. Ramen är bredare än hög, som en kartvy ska vara. */
const W = 640;
const H = 420;

/**
 * Hur mycket utanför gränsen fönstret öppnar, som andel av områdets egen
 * storlek per axel.
 *
 * Det här är punkt 3 ovan uttryckt som ett tal. Noll gav den kritiserade
 * bilden: gränsen fyllde rutan kant i kant och ingenting fanns utanför den.
 * Fyrtio procent är valt för att Gamla stan, som är vårt minsta område med
 * egen sida, då får med Slussen, Norrmalm och en bit av Riddarfjärden, alltså
 * tillräckligt för att man ska se var i staden det ligger. Södermalm, som är
 * det största, får med Kungsholmen och Årsta utan att staden blir ett suddigt
 * översiktsläge.
 */
const PADDING = 0.4;

const [aw, as, ae, an] = areaBounds(area);
const padX = (ae - aw) * PADDING;
const padY = (an - as) * PADDING;
let west = aw - padX;
let east = ae + padX;
let south = as - padY;
let north = an + padY;

// Breddgradskorrigering, samma som KartaPuff: en longitudgrad är smalare än
// en latitudgrad utanför ekvatorn, och utan cosinus blir varje svensk stad
// dubbelt så bred som i verkligheten.
const kx = Math.cos(((south + north) / 2) * (Math.PI / 180));

/*
 * Fönstret vidgas till ramens proportion i stället för att bilden rymmas i
 * ramen. Skälet är KartaPuffs, mätt och utskrivet där: en rymd bild lämnar
 * tomma remsor vid sidan om, och en kartvy lägger aldrig sådana. Här VIDGAR
 * vi i stället för att beskära, eftersom mer omgivning aldrig är fel på just
 * den här kartan; att beskära hade kunnat klippa bort halva området.
 */
const ratio = W / H;
const spanY = north - south;
const spanX = (east - west) * kx;
if (spanX / spanY < ratio) {
  const want = (spanY * ratio) / kx;
  const mid = (west + east) / 2;
  west = mid - want / 2;
  east = mid + want / 2;
} else {
  const want = spanX / ratio;
  const mid = (south + north) / 2;
  south = mid - want / 2;
  north = mid + want / 2;
}

const scale = W / ((east - west) * kx);

function px(lon: number, lat: number): [number, number] {
  return [(lon - west) * kx * scale, (north - lat) * scale];
}

/** Ringar till SVG-bana, en delbana per ring. */
function bana(ringar: number[][][]): string {
  return ringar
    .map(
      (ring) =>
        ring
          .map(([lon, lat], i) => {
            const [x, y] = px(lon, lat);
            return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
          })
          .join('') + 'Z',
    )
    .join('');
}

/* Områdets kontur. Ytterringar och hål i samma bana, så att
   `fill-rule: evenodd` gör hålen till hål. */
const outline = bana([...area.outer, ...area.inner]);

/*
 * Stillbildens mask: hela ramen som delbana, områdets ytterringar som
 * ytterligare delbanor, och `fill-rule: evenodd` som gör dem till hål.
 *
 * Samma sak som `masken` längre ned gör i den levande kartan, i SVG i stället
 * för i ett kartlager, och av samma skäl: utan den här hoppar utseendet i
 * samma sekund som kartbladen kommer.
 *
 * Evenodd bär elva ytterringar lika bra som en. En punkt utanför alla ringar
 * ligger i EN delbana, alltså udda, alltså fylld. En punkt innanför en ring
 * ligger i två, alltså jämnt, alltså ofylld. Det är Torvinge industriområde i
 * Linköping som ställer det kravet; se filhuvudet.
 */
const mask = `M0 0H${W}V${H}H0Z` + bana(area.outer);

/*
 * En bana per bedömning plus en för allt utanför gränsen. "M123 45h0" med
 * rund linjeände är en punkt för en tiondel av markupen, samma grepp som
 * KartaPuff en gång använde för att få plats med 8 511 punkter i en sida på
 * 30 kB.
 */
/*
 * Punkterna utanför gränsen behåller sin BEDÖMNINGSFÄRG och tonas ned med
 * storlek och opacitet, aldrig med grått.
 *
 * Grått betyder "ingen bedömning" överallt annars på sajten. Ritade vi allt
 * utanför området grått hade samma färg fått en andra betydelse på just den
 * här kartan, och en grön restaurang tvärs över gatan hade sett ut som en
 * okontrollerad. Vikten säger vad som är sammanhang; färgen fortsätter säga
 * vad den alltid säger.
 */
const inne: Record<string, string[]> = { '3': [], '0': [], '1': [], '2': [] };
const ute: Record<string, string[]> = { '3': [], '0': [], '1': [], '2': [] };

for (const e of establishments(kommun.slug)) {
  if (e.lat === null || e.lng === null) continue;
  const lon = e.lng;
  const la = e.lat;

  const x = (lon - west) * kx * scale;
  const y = (north - la) * scale;
  // Utanför fönstret ritas ingenting. Det ÄR beskärningen, och den görs före
  // punkt-i-polygon så att punkter i andra änden av kommunen varken kostar
  // ett polygontest eller blir stora tal i markupen utan att någon får se dem.
  if (x < -4 || x > W + 4 || y < -4 || y > H + 4) continue;

  const raw = e.verdict ? MAP_VERDICTS.indexOf(e.verdict) : 3;
  const v = String(raw < 0 ? 3 : raw);

  const dot = `M${Math.round(x)} ${Math.round(y)}h0`;
  if (containsPoint(area, lon, la)) inne[v]?.push(dot);
  else ute[v]?.push(dot);
}

const FARG: Record<string, string> = {
  '3': 'var(--verdict-none)',
  '0': 'var(--verdict-clean)',
  '1': 'var(--verdict-minor)',
  '2': 'var(--verdict-major)',
};

/* Ritordning: allt utanför först, sedan områdets egna. Inom varje grupp
   grått, grönt, gult, rött, så att en anmärkning aldrig hamnar under
   mängden. */
const LAGER = [
  ...['3', '0', '1', '2'].map((v) => ({ d: ute[v].join(''), color: FARG[v], ute: true })),
  ...['3', '0', '1', '2'].map((v) => ({ d: inne[v].join(''), color: FARG[v], ute: false })),
];

const label = `Karta över ${area.name} i ${kommun.city} med ${formatNumber(count)} verksamheter`;

/** Rutarkivet. Adressen bär innehållets hash, se lib/kartrutor.ts. */
const rutor = tileSet();

/*
 * Gränsen som GeoJSON, och den formen är inte godtycklig. Se filhuvudet: en
 * polygon per ytterring, med hålen på var och en, är `containsPoint` uttryckt
 * i GeoJSON. Samma objekt ritar gränsen OCH avgör vad som ligger innanför, så
 * de två kan inte säga emot varandra.
 *
 * Fem decimaler räcker till en meter och är samma precision som pipelinen
 * lagrar.
 */
const omradet = JSON.stringify({
  type: 'MultiPolygon',
  coordinates: area.outer.map((ring) => [ring, ...area.inner]),
});

/*
 * Masken: en polygon som täcker världen med områdets ytterringar som HÅL.
 *
 * Formen är GeoJSON:s egen och kräver ingen omskrivning. Första ringen i en
 * Polygon är ytterkonturen, alla följande är hål. Ytterkonturen är därför
 * hela jordklotet och hålen är områdets ytterringar, en per ring.
 *
 * ## Uppmätt hos Booli, inte gissat
 *
 * booli.se/sok/till-salu?areaIds=115349 (Vasastan), avläst i webbläsaren
 * 2026-08-14 ur kartans egen stil. De kör MapLibre precis som vi, och deras
 * `maskLayer` lyder ordagrant:
 *
 *     fill-color          #878787
 *     fill-opacity        0,6
 *     fill-outline-color  #505050
 *
 * Deras `maskSource` är en Polygon vars första ring är
 * [180,90] [-180,90] [-180,-90] [180,-90] [180,90] och vars andra ring är
 * området, 82 punkter. Alltså exakt konstruktionen här.
 *
 * Talen går att flytta rakt över, för underlaget är detsamma. Boolis mark är
 * rgb(244,238,231) och vår är #F2F1EC, alltså rgb(242,241,236), en skillnad
 * på högst fem steg per kanal. Sammansatt landar deras utsida på
 * rgb(179,176,173) och vår på rgb(178,177,175). Nedtoningen är därmed
 * densamma som förebildens, inte en tolkning av den.
 *
 * Stillbilden har inga kartblad och ligger därför på vitt i stället för på
 * marken. Samma två tal ger där rgb(183,183,183), alltså fem steg ljusare än
 * den levande kartan. Två procent av skalan är under vad ögat hinner se i
 * bytet, och det är skälet till att stillbilden får samma värden och inte
 * egna.
 *
 * ±90 grader latitud går inte att projicera i Mercator, men geojson-vt
 * klipper varje ring till rutan innan projektionen och klämmer y till [0,1].
 * Booli skickar samma ring och den ritas.
 *
 * ## Hål i själva området
 *
 * Ett hål i ett område ligger UTANFÖR området och ska alltså tonas ned, inte
 * lysa. Det sker av sig självt här: bara `area.outer` blir hål i masken, och
 * `area.inner` lämnas orörd, alltså täckt.
 *
 * Räknat över datan 2026-08-14, efter att RegSO kommit in: 158 områden i tio
 * kommunfiler, varav NOLL har en enda inre ring. Konstruktionen är alltså rätt
 * utan att någonsin ha prövats mot verkligheten, och den dagen ett område får
 * ett hål behöver ingenting här ändras. Det är skälet till att det inte står
 * någon handskriven specialhantering här.
 */
const masken = JSON.stringify({
  type: 'Polygon',
  coordinates: [
    [[180, 90], [-180, 90], [-180, -90], [180, -90], [180, 90]],
    ...area.outer,
  ],
});

/**
 * Gränsens upphov, som en färdig sträng.
 *
 * Skrivs EN gång och används på två ställen: i stillbildens hörn och som
 * `attribution` på kartans gränskälla, alltså inne i MapLibres egen
 * upphovsrad. Två formuleringar av samma uppgift hade förr eller senare blivit
 * två olika uppgifter, och den ena hade då stått fel.
 *
 * Kartdatat är alltid OpenStreetMap genom kakelleverantören, och den delen
 * skriver MapLibre själv ur stilens TileJSON. GRÄNSEN är inte alltid det: den
 * kommer ur OSM där någon kartlagt stadsdelarna och ur SCB:s RegSO i övriga
 * kommuner. Namnet på källan hämtas därför ur datafilen och skrivs inte av,
 * se `areaSource` i lib/omraden.ts. Adressen till licensen är det enda som
 * står här, eftersom den inte finns i filen.
 *
 * Kravet är ODbL för OSM-ytorna. RegSO är CC0 och kräver ingenting, men står
 * ändå: en gräns på den här sajten säger alltid var den kommer ifrån.
 */
const KALLANK: Record<AreaSourceId, string> = {
  osm: 'https://www.openstreetmap.org/copyright',
  regso: 'https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/regso/',
};

const kalla = areaSource(kommun.slug, area);
const gransUpphov = kalla
  ? `Områdesgräns <a href="${KALLANK[area.source]}" target="_blank" rel="noopener noreferrer">${kalla.attribution}</a>`
  : null;
---

<div class="omradeskarta">
  <div
    class="kartram"
    data-omradeskarta
    data-url={rutor.url}
    data-bounds={[west, south, east, north].join(',')}
    data-omrade={omradet}
    data-mask={masken}
    data-keys={JSON.stringify(rutor.keys)}
    data-upphov={gransUpphov ?? undefined}
    data-label={label}
  >
    <div class="still" data-still>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
        {/* Masken först, alltså under punkterna, precis som lagerordningen i
            den levande kartan. Se `mask` i frontmatter. */}
        <path d={mask} class="mask" fill-rule="evenodd" />
        <path d={outline} class="kant" fill-rule="evenodd" />
        {LAGER.map((l) => l.d && (
          <path
            d={l.d}
            stroke={l.color}
            stroke-width={l.ute ? 3 : 5}
            stroke-opacity={l.ute ? 0.5 : 1}
            stroke-linecap="round"
            fill="none"
          />
        ))}
      </svg>

      {/*
        Stillbildens upphovsrad.

        Den syns bara innan kartan vaknat, och det är precis då den behövs:
        stillbilden ritar en områdesgräns och hade annars ingen attribution
        alls. Den som får saveData, en sämre uppkoppling än 4g eller ett fel
        vid uppvaknandet ser BARA den här bilden, och attribution är ett
        licensvillkor och inte en artighet.

        Ingen rad om kartblad: stillbilden har inga. Den ritar en gräns och
        våra egna punkter mot ett tomt papper, och en rad som tackar
        OpenFreeMap för kakel som inte finns i bilden vore fel om sig själv.

        Raden försvinner när kartan vaknar, och MapLibres egen upphovsrad tar
        över i samma hörn med samma mening i sig. De två står alltså aldrig
        samtidigt.
      */}
      {gransUpphov && <p class="upphov" set:html={gransUpphov} />}

      <button type="button" class="knapp" data-aktivera>Visa kartan</button>
    </div>

    <div class="duk" data-duk aria-hidden="true"></div>

    <p class="fel" data-fel hidden role="alert">Kartan gick inte att ladda.</p>
  </div>
</div>

{/*
  Här stod en figcaption med "Sök på kartan över <stad>".

  Ägaren: "'Sök på kartan över Stockholm' det behövs ju inte". Han har rätt,
  och skälet är att raden stod tio pixlar ovanför "Öppna <område> i hela
  kartan" i OmradeHub.astro. Två länkar till samma karta, den ena med
  områdets utsnitt i fragmentet och den andra utan. Den som var kvar är den
  som tar med sig var man står.

  Med bildtexten borta har <figure> inget kvar att göra, så elementet är en
  vanlig div.
*/}

<style>
  .omradeskarta { margin: 0; }

  /* Rutan sätter sitt eget mått, ramen kommer från kartram.css. */
  .kartram {
    aspect-ratio: 640 / 420;
  }

  @media (max-width: 560px) {
    .kartram { aspect-ratio: 4 / 3; }
  }

  .still,
  .duk {
    position: absolute;
    inset: 0;
  }

  .still svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
   * Masken. Samma två tal som kartlagret, se `masken` i frontmatter, och de
   * två MÅSTE följas åt: står de olika hoppar utsidan när kartan vaknar.
   *
   * Skrivna som hexvärde och inte som token av samma skäl som FARG och BRAND
   * i skriptet nedan. Det finns ingen neutral i tokens.css som ligger här, och
   * en ny token för ett värde som bara kartan använder hade lagt sajtens
   * gråskala en nivå djupare för ingenting.
   */
  .mask {
    fill: #878787;
    fill-opacity: 0.6;
  }

  /*
   * Gränsen är en LINJE och inte en fylld figur.
   *
   * Här låg tidigare en fyllning på tio procent märkesblått innanför gränsen.
   * Den föll när masken kom: en tonad insida OCH en mörknad utsida säger
   * samma sak två gånger, och den svagare av de två gjorde det genom att
   * lägga blått över den mark våra gröna, gula och röda punkter står på.
   * Boolis insida är kartan i normal ljusstyrka, utan påläggning, och det är
   * masken som bär läsningen.
   *
   * Booli ritar sin egen kant grå streckad (#505050, 1 px, 10/2). Vår är kvar
   * i märkesblått: masken säger var området ungefär är, linjen säger var det
   * exakt slutar, och den precisionen är vår egen och får synas som vår.
   */
  .kant {
    fill: none;
    stroke: var(--brand);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-opacity: 0.75;
  }

  /* Upphovsraden i stillbildens hörn, på MapLibres plats. Måtten och färgen
     är upphovsradens i kartram.css, inklusive glorian: kartan är ljus, men
     stillbildens gräns kan ligga över en mörknad utsida. */
  .upphov {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    margin: 0;
    padding: 0 5px;
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    color: var(--text);
    text-shadow:
      0 0 3px rgba(255, 255, 255, .95),
      0 0 6px rgba(255, 255, 255, .75);
  }

  /* `:global` krävs och är inte slarv. Länken kommer ur `set:html`, alltså ur
     en sträng, och Astro hänger sitt scope-attribut bara på element som står i
     mallen. Utan global väljare föll regeln bort och länken ritades i
     sajtens blå utan understrykning, uppmätt i bygget. Upphovsraden ska läsa
     som en uppgift om kartans ursprung och inte som en länk som vill bli
     klickad, precis som MapLibres egen rad i kartram.css. */
  .upphov :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  /* Duken ligger under stillbilden tills kartan är målad, så att bytet inte
     blinkar. Samma ordning som KartaPuff. */
  .duk { opacity: 0; }
  .kartram.live .duk { opacity: 1; }

  /* `visibility: hidden` och inte bara opacitet. Stillbilden bär en knapp och
     en länk, och ett genomskinligt element ligger kvar i tabbordningen. Det
     gav en fokusring mitt på den levande kartan och krockade dessutom med
     `aria-hidden`, som skriptet sätter på samma element. */
  .kartram.live .still {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .knapp {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-end: var(--s-3);
    transform: translateX(-50%);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    background: var(--card);
    color: var(--text);
    font-size: var(--fs-caption);
    font-weight: 600;
    cursor: pointer;
  }

  .fel {
    position: absolute;
    inset-inline: var(--s-3);
    inset-block-end: var(--s-3);
    margin: 0;
    font-size: var(--fs-caption);
    color: var(--text-secondary);
  }
</style>

<script>
  /**
   * Uppvaknandet. Villkoren är KartaPuffs, ordagrant, och resonemanget står
   * där: rutan ska synas, sidan ska vara klar, huvudtråden ska vara ledig, och
   * uppkopplingen ska tåla en halv megabyte.
   */
  import { KARTA_I_DOKUMENT, KARTSTIL, laddaMaplibre, laddaMaplibreCss } from '../lib/kartbas';
  import { slugify } from '../lib/slug';

  const root = document.querySelector<HTMLElement>('[data-omradeskarta]');

  if (root) {
    const duk = root.querySelector<HTMLElement>('[data-duk]')!;
    const still = root.querySelector<HTMLElement>('[data-still]')!;
    const knapp = root.querySelector<HTMLButtonElement>('[data-aktivera]')!;
    const fel = root.querySelector<HTMLElement>('[data-fel]')!;

    const reducerad = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Bedömningens ytfärger. Samma värden som tokens.css, skrivna som tal av
       samma skäl som i Karta.astro och KartaPuff: MapLibre målar i WebGL och
       kan inte läsa en CSS-variabel. */
    const FARG = ['#00B92B', '#FECB00', '#FF0000', '#C7C7CC'];
    /** --brand i tokens.css. Ändras den där ändras den här. */
    const BRAND = '#007BE0';
    /** Maskens grå och dess täckning. Samma två tal som `.mask` i stilblocket
     *  ovan, uppmätta hos Booli. Ändras det ena ändras det andra, annars
     *  hoppar utsidan när kartan vaknar. */
    const MASKGRA = '#878787';
    const MASKTACKNING = 0.6;

    /** Kommunernas slugar i den ordning `m` i rutorna pekar på dem. Rutorna är
     *  rikets, så en nål i det här utsnittet kan tillhöra grannkommunen, och
     *  länken måste då peka dit. Samma uppslagning som KartaPuff. */
    const KOMMUNER: string[] = JSON.parse(root.dataset.keys!);

    /** Gränsen. Ritas som lager OCH används som filter, se filhuvudet. */
    const OMRADET = JSON.parse(root.dataset.omrade!);
    /** Världen med området som hål, se `masken` i frontmatter. */
    const MASKEN = JSON.parse(root.dataset.mask!);

    /*
     * De fyra villkoren som lagren nedan sätts ihop av.
     *
     * `within` är MapLibres eget punkt-i-polygon och får bara stå i ett
     * FILTER, aldrig i en målningsegenskap. Det är därför nedtoningen är två
     * lager per sak i stället för ett lager med ett uttryck för opaciteten:
     * varje synlig grupp är sitt eget lager med sitt eget filter.
     */
    const BUBBLA: any = ['has', 'point_count'];
    const NAL: any = ['!', ['has', 'point_count']];
    const INNE: any = ['within', OMRADET];
    const UTE: any = ['!', ['within', OMRADET]];

    let startad = false;

    async function start() {
      if (startad) return;
      startad = true;
      knapp.disabled = true;

      try {
        laddaMaplibreCss();
        const [maplibre, pmtiles] = await Promise.all([
          laddaMaplibre(),
          import('pmtiles'),
        ]);

        /* Byter namn på MapLibres Map: den skuggar annars JavaScripts inbyggda
           i hela funktionen. Se den dyrköpta anteckningen i Karta.astro. */
        const {
          Map: MapLibreKarta,
          NavigationControl,
          AttributionControl,
          FullscreenControl,
        } = maplibre;

        /*
         * Räckviddskällan, med reserv för en värd som struntar i Range.
         *
         * Samma funktion och samma skäl som i Karta.astro och KartaPuff, se den
         * långa anteckningen där: Cloudflares kant besvarar `Range` ur sin
         * cache, och en fil utanför cachen strömmas rakt igenom med 200 och
         * hela kroppen. PMTiles hittar då ingen ruta, och kartan blir tom utan
         * ett ord i konsolen. Behåller vi kroppen vi ändå fick kostar felet
         * bandbredd i stället för en tom karta.
         */
        function rutkalla(url: string) {
          let hel: Promise<ArrayBuffer> | null = null;

          return {
            getKey: () => url,
            async getBytes(offset: number, length: number) {
              if (hel) {
                const buf = await hel;
                return { data: buf.slice(offset, offset + length) };
              }

              const svar = await fetch(url, {
                headers: { Range: `bytes=${offset}-${offset + length - 1}` },
              });
              if (!svar.ok) throw new Error('rutarkivet svarade ' + svar.status);

              if (svar.status === 200) {
                const buf = await svar.arrayBuffer();
                hel = Promise.resolve(buf);
                return { data: buf.slice(offset, offset + length) };
              }

              return { data: await svar.arrayBuffer() };
            },
          };
        }

        const arkiv = root!.dataset.url!;
        if (!(window as any).__prikkoPmtiles) {
          const protokoll = new pmtiles.Protocol();
          protokoll.add(new pmtiles.PMTiles(rutkalla(arkiv) as any));
          maplibre.addProtocol('pmtiles', protokoll.tile);
          (window as any).__prikkoPmtiles = true;
        }

        const b = root!.dataset.bounds!.split(',').map(Number);

        const karta = new MapLibreKarta({
          container: duk,
          style: KARTSTIL,
          bounds: [[b[0], b[1]], [b[2], b[3]]],
          // Noll padding: fönstret är redan vidgat vid bygget, så kartbladen
          // lägger sig exakt där stillbildens punkter redan står.
          fitBoundsOptions: { padding: 0, animate: false },
          attributionControl: false,
          /* Samarbetande gester och MapLibres ord på svenska. Kartan sitter
             mitt i en sida man rullar, se kartbas.ts. */
          ...KARTA_I_DOKUMENT,
        });

        karta.addControl(new FullscreenControl({ container: root! }), 'top-right');
        karta.addControl(new NavigationControl({ showCompass: false }), 'top-right');
        /*
         * `compact: false`, alltså upphovsraden utfälld i alla lägen och utan
         * knapp att fälla ihop den med.
         *
         * Det här är samma beslut som Karta.astro rad 429 och framåt, och
         * villkoret där gäller ordagrant här: fritextraden under kartan fick
         * tas bort NÄR kontrollen inte längre kan fällas ihop, aldrig förr.
         * Attribution till OpenStreetMap är ett licensvillkor.
         *
         * Kartan är sidbred, alltså 760 px vid --w-page och omkring 358 på en
         * telefon i 390. Utfälld raden ryms i båda; KartaPuffs `compact: true`
         * är motiverad med att den rutan är 328 px, och det måttet finns inte
         * här.
         *
         * Ändra ALDRIG tillbaka till true utan att samtidigt sätta tillbaka en
         * synlig upphovsrad under kartan.
         */
        karta.addControl(new AttributionControl({ compact: false }), 'bottom-right');

        karta.on('load', () => {
          karta.addSource('verksamheter', {
            type: 'vector',
            url: 'pmtiles://' + arkiv,
          });

          /*
           * Masken och gränsen först, så att båda ligger UNDER punkterna.
           *
           * Ordningen är hela skälet till att masken inte bryter mot
           * färgregeln, se filhuvudet: den mörknar kartbladen och når aldrig
           * en nål, en prick eller en bubbla.
           *
           * Attributionen sitter på källan och inte i en textrad: gränsen
           * kommer ur OpenStreetMap och MapLibre väver in strängen i
           * upphovsraden bredvid kakelleverantörens egen. Masken är härledd ur
           * samma gräns och bär den därför inte en gång till.
           */
          karta.addSource('omrade', {
            type: 'geojson',
            data: { type: 'Feature', properties: {}, geometry: OMRADET },
            attribution: root!.dataset.upphov,
          } as any);
          karta.addSource('omrade-mask', {
            type: 'geojson',
            data: { type: 'Feature', properties: {}, geometry: MASKEN },
          });
          karta.addLayer({
            id: 'omrade-mask',
            type: 'fill',
            source: 'omrade-mask',
            paint: { 'fill-color': MASKGRA, 'fill-opacity': MASKTACKNING },
          });
          /* Ingen fylld yta innanför gränsen. Skälet står vid `.kant` i
             stilblocket: masken bär läsningen, och en tonad insida ovanpå den
             hade lagt blått över den mark punkterna står på. */
          karta.addLayer({
            id: 'omrade-kant',
            type: 'line',
            source: 'omrade',
            paint: { 'line-color': BRAND, 'line-width': 2, 'line-opacity': 0.75 },
          });

          /*
           * Lagren, i par: allt utanför gränsen först, sedan områdets egna.
           *
           * Nedtoningen sker med STORLEK och OPACITET, aldrig med färg. Se
           * anteckningen vid stillbilden: grått betyder "ingen bedömning"
           * överallt annars på sajten och får inte låna en andra betydelse här.
           *
           * Bubblorna bär ANTAL och aldrig bedömning, samma regel som på
           * kartsidan: en klusterfärg efter andel anmärkningar vore en
           * värmekarta över vilka kvarter som sköter sig sämst. Talen är
           * Karta.astros, oförändrade.
           *
           * En bubbla prövas mot gränsen på sin egen punkt, alltså på klustrets
           * tyngdpunkt. En bubbla som spänner över gränsen hamnar därmed på den
           * sida tyngdpunkten ligger. Det är en approximation och den står
           * utskriven här, men den upphör i samma stund man zoomar in förbi
           * z13, där rutorna är oklustrade och varje punkt prövas för sig.
           *
           * Ingen skuggcirkel under bubblorna, till skillnad från KartaPuff:
           * de nedtonade bubblorna är genomskinliga, och en suddig skugga som
           * lyser igenom läser som smuts i stället för som djup.
           */
          const bubbelYta = {
            'circle-color': BRAND,
            'circle-stroke-width': 1.5,
            'circle-stroke-color': '#fff',
            'circle-radius': ['step', ['get', 'point_count'], 13, 25, 15, 100, 18, 500, 22],
            'circle-radius-transition': { duration: reducerad ? 0 : 250 },
          };

          const bubbelText = {
            'text-field': ['get', 'point_count_abbreviated'],
            // Stilens egna kakelfonter, och fet: vit normalvikt på mättat
            // blått blir grumlig. Se Karta.astro.
            'text-font': ['Noto Sans Bold'],
            'text-size': ['step', ['get', 'point_count'], 12, 100, 13, 500, 14],
            'text-allow-overlap': true,
            'text-ignore-placement': true,
          };

          const nalFarg = ['match', ['get', 'v'], 0, FARG[0], 1, FARG[1], 2, FARG[2], FARG[3]];

          karta.addLayer({
            id: 'ute-nalar',
            type: 'circle',
            source: 'verksamheter',
            'source-layer': 'punkter',
            filter: ['all', NAL, UTE],
            paint: {
              'circle-radius': ['interpolate', ['linear'], ['zoom'], 10, 2, 14, 3.5, 17, 5],
              'circle-color': nalFarg,
              'circle-opacity': 0.5,
              'circle-stroke-width': 1,
              'circle-stroke-color': '#fff',
              'circle-stroke-opacity': 0.5,
            },
          } as any);

          karta.addLayer({
            id: 'ute-bubblor',
            type: 'circle',
            source: 'verksamheter',
            'source-layer': 'punkter',
            filter: ['all', BUBBLA, UTE],
            paint: { ...bubbelYta, 'circle-opacity': 0.4, 'circle-stroke-opacity': 0.4 },
          } as any);

          karta.addLayer({
            id: 'ute-antal',
            type: 'symbol',
            source: 'verksamheter',
            'source-layer': 'punkter',
            filter: ['all', BUBBLA, UTE],
            layout: bubbelText,
            paint: { 'text-color': '#fff', 'text-opacity': 0.7 },
          } as any);

          karta.addLayer({
            id: 'inne-nalar',
            type: 'circle',
            source: 'verksamheter',
            'source-layer': 'punkter',
            filter: ['all', NAL, INNE],
            paint: {
              'circle-radius': ['interpolate', ['linear'], ['zoom'], 10, 3, 14, 5, 17, 8],
              'circle-color': nalFarg,
              // Vit kontur av samma skäl som nålen har den: utan kant drunknar
              // en gul punkt i en gul gata.
              'circle-stroke-width': 1,
              'circle-stroke-color': '#fff',
            },
          } as any);

          karta.addLayer({
            id: 'inne-bubblor',
            type: 'circle',
            source: 'verksamheter',
            'source-layer': 'punkter',
            filter: ['all', BUBBLA, INNE],
            paint: bubbelYta,
          } as any);

          karta.addLayer({
            id: 'inne-antal',
            type: 'symbol',
            source: 'verksamheter',
            'source-layer': 'punkter',
            filter: ['all', BUBBLA, INNE],
            layout: bubbelText,
            paint: { 'text-color': '#fff' },
          } as any);

          /*
           * ── Kartan går att peta på ──────────────────────────────────────
           *
           * Ägaren: "vad är denna karta, det är ju bara prickar man inte kan
           * klicka på?". Han hade rätt. Rutan var en BILD av en karta: den
           * ritade nålar och bubblor som ser klickbara ut överallt annars på
           * sajten, och svarade inte på ett enda klick.
           *
           * Två utvägar fanns, och den ena föll direkt. Att göra rutan
           * avsiktligt orörlig och bara leda vidare till den delade vyn hade
           * krävt att den slutade se ut som en karta, alltså tillbaka till den
           * ritade kontur ägaren redan underkänt en gång, se filhuvudet. Kvar
           * står den enda ärliga: det som ser klickbart ut ÄR klickbart.
           *
           * En nål leder till verksamhetens sida. En bubbla delar sig.
           *
           * ## Även utanför gränsen
           *
           * Nedtoningen betyder SAMMANHANG och inte avstängt. En nedtonad nål
           * är en riktig verksamhet med en riktig sida, och en karta där halva
           * ytan tyst ignorerar klick är trasig på ett sätt ingen kan se.
           *
           * ## Varför inget nålkort
           *
           * Den delade vyn öppnar ett kort vid nålen. Det kortet är byggt av
           * bläddring mellan verksamheter på samma adress, filtrerade träffar
           * och en lista som markeras i takt, alltså av allt det som gör
           * kartsöksidan till en egen sida. Att bygga om det här vore att lägga
           * den delade vyn på områdessidan, en gång till och sämre. Ett klick
           * går därför direkt dit man ändå var på väg.
           *
           * Mönstret är KartaPuffs, rad 416 till 475, och avvikelserna är två:
           * lagren heter `inne-*` och `ute-*` och finns i par, och luften kring
           * kameran är 56 som i den delade vyn i stället för KartaPuffs 32,
           * eftersom den här rutan är sidbred och inte 328 px.
           */

          /** Två punkter närmare varandra än så räknas som samma adress. Samma
           *  tal som lib/kartrutor.ts använder när rutorna byggs. */
          const SAMMA_PLATS = 3e-5;
          /** Zoomen där en adressstapel är uppdelad i enskilda nålar. */
          const STAPELZOOM = 18;

          const NALLAGER = ['inne-nalar', 'ute-nalar'];
          const BUBBELLAGER = ['inne-bubblor', 'ute-bubblor'];

          /*
           * Bubblan delar sig.
           *
           * `ez` och `bx` bakas in i varje bubbla vid bygget, se
           * lib/kartrutor.ts: en vektorrutekälla har ingen
           * `getClusterExpansionZoom` att fråga, så svaret följer med i rutan.
           * Kameran läggs på LÖVENS utbredning, dock minst expansionszoomen.
           * Utbredningen delar bubblan hela vägen ned till nålar i ett svep när
           * det går, och `Math.max` är garantin mot en bubbla som inte släpper.
           *
           * Ligger alla löv på samma adress finns ingen zoom som delar dem.
           * Kameran går då in till den zoom där nålarna finns och lämnar resten
           * till den delade vyn, precis som i kommunhubbens ruta. En bubbla blir
           * därmed aldrig en återvändsgränd.
           */
          function delaBubbla(f: any) {
            const bx = String(f.properties.bx ?? '').split(',').map(Number);
            const expansion = Number(f.properties.ez);

            if (bx.length !== 4 || bx.some((v) => !Number.isFinite(v))) {
              karta.easeTo({
                center: f.geometry.coordinates,
                zoom: karta.getZoom() + 2,
                duration: reducerad ? 0 : 400,
              });
              return;
            }

            const [vast, syd, ost, nord] = bx;

            if (ost - vast < SAMMA_PLATS && nord - syd < SAMMA_PLATS) {
              karta.easeTo({
                center: f.geometry.coordinates,
                zoom: STAPELZOOM,
                duration: reducerad ? 0 : 500,
              });
              return;
            }

            const luft = Math.min(
              56,
              Math.floor(Math.min(root!.clientWidth, root!.clientHeight) / 4),
            );
            const kamera = karta.cameraForBounds([[vast, syd], [ost, nord]], { padding: luft });

            karta.easeTo({
              center: kamera ? kamera.center : f.geometry.coordinates,
              zoom: Math.max(kamera ? kamera.zoom : 0, Number.isFinite(expansion) ? expansion : 0),
              duration: reducerad ? 0 : 500,
            });
          }

          for (const lager of BUBBELLAGER) {
            karta.on('click', lager, (ev: any) => {
              /* Frågan ställs om mot BÅDA bubbellagren i stället för att lita
                 på `ev.features`. Två bubblor kan överlappa vid gränsen, och
                 den som ligger överst är den man tryckte på. */
              const f = karta.queryRenderedFeatures(ev.point, { layers: BUBBELLAGER })[0];
              if (f) delaBubbla(f);
            });
          }

          /*
           * Ett klick på en nål går till verksamheten.
           *
           * Slugen härleds ur namnet och följer med i rutan bara när
           * härledningen inte stämmer; bygget jämför alltid mot den slug
           * pipelinen satte, se lib/slug.ts.
           */
          for (const lager of NALLAGER) {
            karta.on('click', lager, (ev: any) => {
              const p = ev.features?.[0]?.properties;
              if (!p) return;
              const kommunSlug = KOMMUNER[p.m] ?? KOMMUNER[0];
              const slug = p.s ?? slugify(String(p.nm));
              location.href = `/${kommunSlug}/${slug}/`;
            });
          }

          /* Pekaren säger vad som går att trycka på innan man provar. Utan den
             är kartan lika stum som förut för den som bara för musen över den. */
          for (const lager of [...NALLAGER, ...BUBBELLAGER]) {
            karta.on('mouseenter', lager, () => (karta.getCanvas().style.cursor = 'pointer'));
            karta.on('mouseleave', lager, () => (karta.getCanvas().style.cursor = ''));
          }

          karta.getCanvas().setAttribute('aria-label', root!.dataset.label!);
          duk.removeAttribute('aria-hidden');
          root!.classList.add('live');
          still.setAttribute('aria-hidden', 'true');
        });
      } catch (error) {
        console.error(error);
        // Stillbilden står kvar. Den bär samma punkter och samma gräns.
        fel.hidden = false;
        knapp.hidden = true;
      }
    }

    knapp.addEventListener('click', start);

    /** Tål uppkopplingen en karta? Se KartaPuff för varför villkoren är hårda. */
    function uppkopplingenTal(): boolean {
      const c = (navigator as any).connection;
      if (c) {
        if (c.saveData) return false;
        if (c.effectiveType && c.effectiveType !== '4g') return false;
      }
      return !window.matchMedia('(prefers-reduced-data: reduce)').matches;
    }

    if (uppkopplingenTal()) {
      knapp.hidden = true;

      const nar = (fn: () => void) => {
        const idle = (window as any).requestIdleCallback;
        if (idle) idle(fn, { timeout: 3000 });
        else setTimeout(fn, 200);
      };

      const efterLoad = (fn: () => void) => {
        if (document.readyState === 'complete') nar(fn);
        else window.addEventListener('load', () => nar(fn), { once: true });
      };

      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (poster) => {
            if (!poster.some((p) => p.isIntersecting)) return;
            obs.disconnect();
            efterLoad(start);
          },
          { rootMargin: '200px' },
        );
        obs.observe(root);
      } else {
        efterLoad(start);
      }
    }
  }
</script>
