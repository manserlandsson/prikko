---
/**
 * Kommunens fördelning som en smal rad ovanför listan.
 *
 * Ersätter det stora fördelningskortet (VerdictBar). Kortet stod först i
 * huvudspalten och tryckte, tillsammans med tre insiktsrutor till, ner
 * verksamheterna en hel skärm. Ägarens ord: man ser inte restaurangerna.
 *
 * Samma information, mindre yta: bandet, antalen, andelarna och länken till
 * anmärkningarna finns kvar. Det som försvann är kortchromet och de stora
 * talen, inte innehållet. Fördjupningen ligger kvar på sidan, efter listan,
 * och raden länkar dit så att den som kom för statistiken hittar den utan
 * att rulla på måfå.
 *
 * Förebilden är Ednia och hitta.se: en tunn rad med sammanhang direkt under
 * sidhuvudet, sedan innehållet. Ingen statistikvägg emellan.
 *
 * Färgerna är bedömningens egna och betyder här precis vad de betyder
 * överallt annars. Varje segment bär sin etikett i text: färg ensam är
 * aldrig ett budskap.
 *
 * ## Vilka poster som är klickbara, och varför inte alla fyra
 *
 * Ägaren: "på dom här brister som kvarstår, inga anmärkningar, etc dom ska
 * vara klickbara." Tre av fyra är det nu. Den fjärde är det inte, och skälet
 * är att den inte HAR något att leda till.
 *
 * BRISTER och BRISTER SOM KVARSTÅR leder båda till /[kommun]/anmarkningar.
 * Samma adress för två poster ser fel ut tills man ser vad sidan är:
 * `municipalityRemarks()` i data.ts tar allt som är bedömt och inte rent,
 * alltså de två posterna TILLSAMMANS och exakt dem. Sidans egen svarsmening
 * skriver ut båda talen, listan sorterar kvarstående först, och varje rad bär
 * sin nivå i klartext. Det finns alltså ingen bättre adress för någon av dem,
 * och en sida per nivå vore två nya rutter per kommun för en sökning ingen gör.
 *
 * MATSNUSK är INTE svaret för "brister som kvarstår", hur nära det än låter.
 * Den listan har tre krav till (bevisat konsumentnära avvikelse, kontroll
 * högst tolv månader gammal, kommunen över radgränsen), och det syns i talen:
 * Stockholm har 156 kvarstående men 64 matsnuskrader, och i tio av tolv
 * kommuner finns sidan inte alls. En post som säger 156 får inte leda till 64.
 * Sidan länkas i stället från anmärkningssidans fot, där läsaren redan står
 * bland de kvarstående.
 *
 * INGEN BEDÖMNING leder till avsnittet som förklarar just det talet,
 * "Utan aktuell kontroll", längre ner på samma sida. `unseen()` räknar samma
 * mängd som posten (verdict === null) och delar den i aldrig kontrollerade och
 * för länge sedan kontrollerade. Det är den enda plats på sajten som säger vad
 * grått betyder, och att komma dit är hela nyttan av att klicka.
 *
 * INGA ANMÄRKNINGAR har ingen länk. Ingen söker på "verksamheter utan
 * anmärkning i Stockholm" som en egen sida, så en sida får inte byggas
 * (funktioner kostar aldrig en sida), och ett filter på plats kan inte bära
 * den heller: registret under raden är sidindelat i hundra rader åt gången,
 * och Stockholms rena mängd är 6 497 verksamheter på sextiofem sidor. Ett
 * filter som döljer rader på sidan man står på hade visat sjuttiosex av
 * 6 497 och kallat det svaret. Samma skäl som gör kategorifiltret till länkar
 * och inte kryssrutor, se KommunHub.astro. Posten står alltså kvar som tal och
 * etikett, och mängden den räknar är registret man redan tittar på.
 */
import { formatNumber } from '../lib/data';
import { VERDICT } from '../lib/site';

interface Props {
  counts: { clean: number; minor: number; major: number; none: number };
  /**
   * Anmärkningssidan. Bär BÅDE "Brister" och "Brister som kvarstår", se
   * huvudkommentaren. Utelämnad när kommunen inte har några.
   */
  remarksHref?: string;
  /**
   * Ankare till avsnittet "Utan aktuell kontroll". Utelämnat när avsnittet
   * inte ritas: ett ankare till något som inte finns leder ingenstans, och
   * besökaren märker det först efter att ha klickat.
   */
  unseenHref?: string;
  /** Ankare till fördjupningen längre ner på sidan, när den finns. */
  statsHref?: string;
  city: string;
}

const { counts, remarksHref, unseenHref, statsHref, city } = Astro.props;

const total = counts.clean + counts.minor + counts.major + counts.none;

const segments = [
  {
    key: 'clean',
    n: counts.clean,
    label: VERDICT.clean.label,
    surface: 'var(--verdict-clean)',
    href: undefined as string | undefined,
  },
  {
    key: 'minor',
    n: counts.minor,
    label: VERDICT.minor.label,
    surface: 'var(--verdict-minor)',
    href: remarksHref,
  },
  {
    key: 'major',
    n: counts.major,
    label: VERDICT.major.label,
    surface: 'var(--verdict-major)',
    href: remarksHref,
  },
  {
    key: 'none',
    n: counts.none,
    // "Ingen bedömning" är inte en nivå och får aldrig läsas som en mild
    // variant av de andra. Därför grått, och därför sist.
    label: 'Ingen bedömning',
    surface: 'var(--verdict-none)',
    href: unseenHref,
  },
];

const barLabel = segments
  .filter((s) => s.n > 0)
  .map((s) => `${s.label}: ${formatNumber(s.n)}`)
  .join('. ');

/** Andel i hela procent. Visas inte under 1 %, för "0 %" bredvid ett tal som
 *  inte är noll läser som ett fel. */
function share(n: number): string | null {
  if (!total) return null;
  const pct = Math.round((n / total) * 100);
  return pct >= 1 ? `${pct} %` : null;
}
---

<section class="oversikt" aria-labelledby="fordelning">
  <div class="rubrikrad">
    <h2 id="fordelning" class="eyebrow">Fördelning i kommunen</h2>
    {statsHref && <a class="mer" href={statsHref}>{city} i siffror</a>}
  </div>

  <div class="bar" role="img" aria-label={barLabel}>
    {segments.map((s) => s.n > 0 && (
      <span style={`width:${(s.n / total) * 100}%;background:${s.surface}`}></span>
    ))}
  </div>

  {/* Teckenförklaringen var en enda tät rad: prick, fetstilt tal, etikett och
      procent gånger fyra, sexton textbitar efter varandra som inte gick att
      läsa i ett svep. Nu är varje post en egen cell i två våningar, talet
      överst och etiketten under, alltså samma ordning som Nyckeltal.astro och
      Kommunstapel.astro håller nere i bandet. */}
  <ul class="legend">
    {segments.map((s) => {
      const pct = share(s.n);
      const body = (
        <>
          <span class="varde">
            <b>{formatNumber(s.n)}</b>
            {pct && <span class="pct">{pct}</span>}
          </span>
          {/* Etiketten ligger i en egen span inuti .lbl, och det är inte en
              extra låda för sakens skull: understrykningen som märker ut en
              klickbar post ritas på texten, och en understrykning på .lbl hade
              dragit linjen under färgpricken också. */}
          <span class="lbl">
            <span class="swatch" style={`background:${s.surface}`} aria-hidden="true"></span>
            <span class="txt">{s.label}</span>
          </span>
        </>
      );
      return (
        <li>
          {s.href && s.n > 0 ? (
            <a href={s.href}>{body}</a>
          ) : (
            <span class="rad">{body}</span>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  /* Inget kort. Raden är sammanhang, inte innehåll, och ska väga därefter. */
  .rubrikrad {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .mer {
    flex-shrink: 0;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 600;
  }

  /* Bandet var 8 px med 4 px radie och läste som en linje snarare än som en
     stapel. Ägaren: "tunn och hård i kanterna".

     24 px med 8 px radie är inte valt, det är mätt. Ednias könsfördelning och
     deras regionfördelning ritas båda som ett 24 px högt spår med radie 8 px,
     segmenten kant i kant utan egen radie och 8 px luft över och under.
     Uppmätt på ednia.se/hogskola/gu/program/lakarprogrammet-goteborg
     2026-08-12. Vår egen Andelsstapel.astro, som artiklarna använder, har
     samma två mått sedan tidigare, så det här är också det som gör
     fördelningsstapeln till EN form på hela sajten.

     Full radie vore fel vid den här höjden: en 24 px hög stapel med 12 px
     radie ger ändsegment som läser som tabletter och inte som delar av ett
     band. Samma resonemang står i Andelsstapel.astro.

     Blocket är fortfarande en RAD och inte ett kort: rubrikrad, band och
     teckenförklaring går på omkring 110 px, och registret börjar direkt
     under.

     Områdessidan har en egen kopia av formen, se OmradeHub.astro och skälet
     där. Ändras måtten här ska de ändras där också. */
  .bar {
    display: flex;
    height: 24px;
    border-radius: var(--s-2);
    overflow: hidden;
    margin-top: var(--s-2);
    background: var(--verdict-none);
  }

  .bar > span { display: block; height: 100%; }

  /* auto-fit och inte flex-wrap: posterna ska stå i spalter under varandra
     och inte packas efter varandra med olika breda mellanrum. 150 px ger fyra
     spalter i huvudkolumnen och två på en telefon. */
  .legend {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s-3) var(--s-4);
  }

  .legend a, .rad {
    display: block;
    color: var(--text);
  }

  /*
   * Att posten går att klicka på ska synas UTAN att man pekar på den.
   *
   * Den var en länk vars enda tecken var en understrykning vid hovring, alltså
   * osynlig för den som inte redan gissat, och helt osynlig på telefon. Ägaren:
   * "dom ska vara klickbara". Det räcker inte att de ÄR det.
   *
   * Formen är Boolis, uppmätt på booli.se 2026-08-13. De märker klickbar data
   * på exakt ett sätt: understrykning i vila, i bläck, aldrig i accentfärg.
   * "Se Boolis värdering" på objektsidan är 14/600 understruken i #1A1A1A,
   * föreningens lägenhetsrader är 14/400 understrukna i samma bläck, och
   * artikellänken mitt i brödtexten likaså. Accenten (#FF610D) förekommer en
   * till fyra gånger på en hel sida och bär aldrig en länk i ett datablock.
   * Deras enda ramade varianter är knappar och flikar, alltså kontroller.
   *
   * Därför: understruken etikett i vila och ingenting mer. Ingen ram, ingen
   * platta, ingen pil. Fyra inramade poster på rad hade läst som en knapprad
   * mitt i en sida som annars är lugn, och det är precis vad raden inte får bli.
   *
   * Understrykningen sitter på ETIKETTEN och inte på talet. Talet är
   * uppgiften, och en understruken siffra läser som en rättelse. Hela cellen
   * är ändå träffyta, eftersom länken är blocket.
   *
   * Etiketten går samtidigt från --text-secondary till fullt bläck. Grått plus
   * understrykning läser som en fotnot; en länk ska väga som text.
   */
  .legend a .lbl { color: var(--text); }

  /* INGEN understrykning i vila. Ägaren: "dem ska ej vara understrykna, ska
     bara vara klickbara."

     Bäraren blir i stället färgen, alltså sajtens länkblå, plus att hela
     cellen är träffyta. Det håller för att posten ÄR en länk i sin helhet och
     inte en länk inuti löptext: kravet på att färg aldrig får vara ensam
     bärare gäller när en länk ska gå att skilja från texten omkring den, och
     här finns ingen text omkring. Understrykningen kommer tillbaka vid
     hovring och tangentbordsfokus, alltså i de lägen där den svarar på något
     man gör. */
  /* Varken blå eller understruken. Ägaren: "ta bort att det är blått och att
     det blir understruket på hover."

     Kvar som bärare är att hela cellen är träffyta och att pekaren byter form,
     plus att etiketten mörknar vid hovring och fokus. Posten står i en rad där
     varje syskon är en länk till samma sorts sida, alltså finns ingen text
     omkring den som den behöver skilja sig från. */
  .legend a .txt {
    text-decoration: none;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  /* Hovring bär färgen, i sajtens länkblå. Booli byter inte färg alls, men
     deras bläck ÄR länkfärgen; hos oss är blått det som säger "aktiv" i
     sökpanelen, i kartan och i pagineringen, och en post som inte svarar på
     pekaren läser som död. */
  .legend a:hover .lbl,
  .legend a:focus-visible .lbl { color: var(--brand-ink); }

  /* Talet och andelen delar rad, talet i bläck och andelen tyst efter det.
     Etiketten står under, alltså inte i motsatt kant. */
  .varde {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }

  .legend b {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    letter-spacing: -.015em;
    font-variant-numeric: tabular-nums;
  }

  .pct {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .lbl {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text-secondary);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  /* Färgprickens enda uppgift är att koppla posten till sitt segment i
     bandet. Betydelsen står i texten bredvid, så prickens kontrast bär ingen
     information och behöver inte klara 3:1.

     10 px och inte 8. Ednia ger sin motsvarande prick 12 px mot en rad i
     16 px; vår rad är 13 px, och 10 är samma förhållande. En prick som är
     mindre än så tappar sin färg vid normalt läsavstånd, vilket är det enda
     den finns för. */
  .swatch {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    /* Prickens baslinje ligger annars på textens och den ser då ut att hänga
       under raden. Samma justering som i Andelsstapel.astro. */
    transform: translateY(-1px);
  }
</style>
