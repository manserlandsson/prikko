---
/**
 * Vad kommunens kontroll inte når.
 *
 * Fördelningsstapeln har alltid haft ett grått segment, "Ingen bedömning". Vad
 * grått betyder har aldrig stått någonstans, och det är två helt olika saker:
 * ett ställe som aldrig kontrollerats, och ett som kontrollerats men för länge
 * sedan. Skillnaden finns i datan sedan första dagen och används redan på
 * verksamhetssidan för att välja svarsmening. På hubben har den aldrig visats.
 *
 * Det här är ett påstående om KOMMUNEN och aldrig om en namngiven verksamhet.
 * Vi skriver inte att ett visst ställe är ohygieniskt för att det saknar
 * kontroll; vi skriver hur stor del av registret kontrollen inte har nått.
 *
 * Förbehållet om nedlagda verksamheter är obligatoriskt och får inte kortas
 * bort. En registerpost utan kontroll kan lika gärna vara ett ställe som
 * stängt utan att avregistreras, och utan den meningen läses siffran som en
 * anklagelse mot kommunen som vi inte kan belägga.
 */
import InfoTip from './InfoTip.astro';
import Nyckeltal from './Nyckeltal.astro';
import { formatNumber } from '../lib/data';
import type { Unseen } from '../lib/kommunprofil';

interface Props {
  unseen: Unseen;
  city: string;
}

const { unseen: u, city } = Astro.props;

const tal = [
  ...(u.never > 0
    ? [{ value: formatNumber(u.never), label: 'har ingen publicerad kontroll alls' }]
    : []),
  ...(u.stale > 0
    ? [
        {
          value: formatNumber(u.stale),
          label: 'kontrollerades senast för mer än tre år sedan',
        },
      ]
    : []),
];

/**
 * Under tio är talet trivia, inte en insikt. Jönköping har två verksamheter
 * utan kontroll av 1 120, och en egen rubrik för dem säger mer om att vi ville
 * fylla sidan än om Jönköping.
 */
const worthShowing = u.total >= 10;
---

{worthShowing && (
  <section class="uncovered" aria-labelledby="utan-kontroll">
    <h2 id="utan-kontroll">
      Utan aktuell kontroll i {city}
      <InfoTip
        label="utan aktuell kontroll"
        text="Verksamheter kommunen publicerar som saknar bedömning hos oss."
      />
    </h2>

    {/*
      "verksamheter kommunen publicerar" och inte "i kommunens register".
      Nämnaren är antalet rader kommunen lämnar ut till oss, vilket är något
      annat än registret. Rutan ovanför visar registret som det rapporterats
      till Livsmedelsverket, och de två talen är inte samma sak: de gäller
      olika år och räknar olika saker. I Borgholm har vi fler rader än
      registret hade anläggningar det året. Att skriva "av registret" här hade
      alltså varit ett påstående vi inte kan belägga, och två tal som ser ut
      att motsäga varandra på samma sida.
    */}
    <p class="answer">
      <b>{formatNumber(u.total)}</b> av {formatNumber(u.register)} verksamheter
      kommunen publicerar har ingen kontroll som säger något om läget i dag.
    </p>

    <Nyckeltal tal={tal} />

    <p class="caveat">
      En verksamhet utan kontroll kan också ha upphört utan att strykas ur
      registret.
    </p>
  </section>
)}

<style>
  /* Ingen ruta, se CommonIssues.astro och docs/19_formsystem.md. */
  .uncovered h2 {
    display: flex;
    align-items: center;
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  .answer {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .answer b {
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Talen ritas av Nyckeltal.astro, bandets enda nyckeltalsform. */

  /* Samma småstil som i Kontrollen och Tathet: 16 px luft, --fs-caption,
     ingen hårlinje. */
  .caveat {
    margin-top: var(--s-4);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }
</style>
