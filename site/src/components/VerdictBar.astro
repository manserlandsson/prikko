---
/**
 * Fördelningen över bedömningsnivåerna, som band plus läslig teckenförklaring.
 *
 * Ersätter tre nakna tal bredvid varandra. Talen svarade på "hur många", men
 * inte på "hur ser kommunen ut" — och det är den frågan man kommer till en
 * kommunsida med. Ett band svarar på en halv sekund, siffrorna under det svarar
 * exakt. Samma grepp som kommunkortet på startsidan använder, men i läsbar
 * storlek och med etiketterna utskrivna.
 *
 * Färgerna är bedömningens egna och betyder här precis vad de betyder överallt
 * annars. Varje segment bär dessutom sin etikett i text: färg ensam är aldrig
 * ett budskap.
 */
import { formatNumber } from '../lib/data';
import { VERDICT } from '../lib/site';

interface Props {
  counts: { clean: number; minor: number; major: number; none: number };
  /** Länkmål för raden "med brister", när kommunen har några. */
  remarksHref?: string;
}

const { counts, remarksHref } = Astro.props;

const total = counts.clean + counts.minor + counts.major + counts.none;

const segments = [
  {
    key: 'clean',
    n: counts.clean,
    label: VERDICT.clean.label,
    surface: 'var(--verdict-clean)',
    ink: 'var(--verdict-clean-ink)',
  },
  {
    key: 'minor',
    n: counts.minor,
    label: VERDICT.minor.label,
    surface: 'var(--verdict-minor)',
    ink: 'var(--verdict-minor-ink)',
  },
  {
    key: 'major',
    n: counts.major,
    label: VERDICT.major.label,
    surface: 'var(--verdict-major)',
    ink: 'var(--verdict-major-ink)',
  },
  {
    key: 'none',
    n: counts.none,
    // "Ingen bedömning" är inte en nivå och får aldrig läsas som en mild
    // variant av de andra. Därför grått, och därför sist.
    label: 'Ingen bedömning',
    surface: 'var(--verdict-none)',
    ink: 'var(--verdict-none-ink)',
  },
];

const barLabel = segments
  .filter((s) => s.n > 0)
  .map((s) => `${s.label}: ${formatNumber(s.n)}`)
  .join('. ');

/** Andel i hela procent. Visas inte under 1 % — "0 %" bredvid ett tal som
 *  inte är noll läser som ett fel. */
function share(n: number): string | null {
  if (!total) return null;
  const pct = Math.round((n / total) * 100);
  return pct >= 1 ? `${pct} %` : null;
}
---

<section class="dist" aria-labelledby="fordelning">
  <h2 id="fordelning" class="eyebrow">Fördelning i kommunen</h2>

  <div class="bar" role="img" aria-label={barLabel}>
    {segments.map((s) => s.n > 0 && (
      <span style={`width:${(s.n / total) * 100}%;background:${s.surface}`}></span>
    ))}
  </div>

  <ul class="legend">
    {segments.map((s) => {
      const pct = share(s.n);
      const body = (
        <>
          <span class="swatch" style={`background:${s.surface}`}></span>
          <span class="txt">
            <b style={`color:${s.ink}`}>{formatNumber(s.n)}</b>
            <span class="lbl">{s.label}</span>
            {pct && <span class="pct">{pct}</span>}
          </span>
        </>
      );
      return (
        <li>
          {s.key === 'minor' && remarksHref && s.n > 0 ? (
            <a href={remarksHref}>{body}</a>
          ) : (
            <span class="row">{body}</span>
          )}
        </li>
      );
    })}
  </ul>
</section>

<style>
  .dist {
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    padding: var(--s-4);
  }

  .bar {
    display: flex;
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
    margin-top: var(--s-3);
    background: var(--verdict-none);
  }

  .bar > span { display: block; height: 100%; }

  .legend {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s-3) var(--s-4);
  }

  .legend a, .row {
    display: flex;
    align-items: flex-start;
    gap: var(--s-2);
    color: var(--text);
  }

  .legend a:hover { text-decoration: none; }
  .legend a:hover .lbl { color: var(--brand-ink); text-decoration: underline; }

  /* Färgprickens enda uppgift är att koppla raden till sitt segment i bandet.
     Betydelsen står i texten bredvid, så prickens kontrast bär ingen
     information och behöver inte klara 3:1. */
  .swatch {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-top: 5px;
  }

  .txt { min-width: 0; }

  .txt b {
    display: block;
    font-size: 21px;
    line-height: 25px;
    font-weight: 600;
    letter-spacing: -.015em;
    font-variant-numeric: tabular-nums;
  }

  .lbl {
    display: block;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .pct {
    display: block;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
