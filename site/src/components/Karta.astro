    line-height: var(--lh-body-s);
    font-weight: 600;
    color: var(--brand-ink);
  }

  .kort :global(.kort-lank:hover) { background: var(--canvas); }
  .kort :global(.kort-lank svg) { width: 16px; height: 16px; flex: none; }

  /* Bläddringen mellan verksamheter på samma adress. Ligger under länken och
     får därför bära kortets nedre radie i stället för den. */
  .kort :global(.kort-blad) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-2);
    border-top: 1px solid var(--hairline);
  }

  .kort :global(.kort-lank:has(+ .kort-blad)) { border-radius: 0; }

  .kort :global(.kort-blad-text) {
    flex: 1;
    text-align: center;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
