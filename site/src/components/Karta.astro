---
/**
 * Delad vy: listan till vänster, kartan till höger.
 *
 * Förebilden är Airbnbs sökresultat. Kartan är inte en illustration bredvid
 * listan utan sidans andra halva, den syns direkt utan att man ber om den, och
 * den sitter kvar när man rullar. Nålarna bär bedömningen, som är vår
 * motsvarighet till deras pris.
 *
 * ## Varför vyn ligger här och inte på kommunhubben
 *
 * Det här är den enda avvägning som verkligen kostade något, och den avgjordes
 * med mätning.
 *
 * Kommunhubben väger 30,4 kB gzippat med allt inräknat: HTML, fyra skript och
 * två stilmallar. En delad vy med levande karta kostar 231 kB brotlat för
 * MapLibre plus 84 kB för Stockholms punkter. Att lägga den på hubben gör
 * alltså sajtens mest besökta sidtyp ungefär tio gånger tyngre, och den sidan
 * är den vi minst har råd att sakta ner: Core Web Vitals är en rankningssignal
 * och sajten har ingen länkprofil att kompensera med.
 *
 * Kartan får därför en egen adress, /<kommun>/karta/, som bär HELA den delade
 * vyn. Hubben behåller sin vikt och länkar hit tydligt. Skillnaden mot Airbnb
 * är ett klick, och det klicket är priset för att hubben ska fortsätta ranka.
 *
 * På DEN HÄR sidan laddas kartan omedelbart. Den som gått hit har bett om
 * kartan, och en knapp till hade varit ett andra klick för samma sak.
 *
 * ## Varför listan inte laddas om när man drar
 *
 * Airbnb frågar servern vid varje panorering, och skelettet man ser är väntan
 * på det anropet. De måste: miljontals objekt, priser som beror på datum,
 * tillgänglighet som ändras.
 *
 * Vi frågar ingen. Punkterna ligger i en förgenererad rutpyramid, och rutorna
 * för utsnittet är redan hämtade när listan ritas. Ingen omladdning, inget
 * skelett, ingen väntan: listan följer med medan man drar.
 *
 * ## Var klustringen tog vägen
 *
 * Det här är det som förvirrar mest vid första läsningen, så det står först.
 *
 * Källan var förut hela kommunen som GeoJSON med `cluster: true`, alltså
 * supercluster i MapLibres arbetare. Den lösningen hade en vägg: en fil per
 * kommun kan bara svara på "vad finns i Linköping", och en rikskarta ställer
 * frågan "vad finns i den här rektangeln". Vid 290 kommuner är beståndet
 * dessutom omkring 90 000 punkter, som inte skickas till en telefon.
 *
 * Källan är därför en VEKTORRUTEKÄLLA mot ett PMTiles-arkiv, och en sådan kan
 * inte klustras av MapLibre. Klustringen finns kvar och ser likadan ut, men
 * den är körd EN gång vid bygget av `lib/kartrutor.ts`, med samma supercluster
 * och samma tre tal: radie 38, minst fem punkter, upp till zoom 13.
 *
 * Det som följde med bytet, och som annars ser ut som saknad funktionalitet:
 * `getClusterExpansionZoom()` och `getClusterLeaves()` finns bara på en
 * GeoJSON-källa. Svaren är i stället inbakade i varje bubbla som `ez` och
 * `bx`, så `delaKluster()` nedan blev synkron och gör exakt samma sak. Samma
 * med antalsbrickan: `h` och `n` sätts vid bygget.
 *
 * Klienten läser fortfarande punkter genom EN funktion, `punktKalla` nedan.
 * Det var den ordningen som gjorde det här bytet möjligt utan att röra listan,
 * kortet, arket eller samspelet mellan rad och nål.
 */
import FaceMark from './FaceMark.astro';
import FaceRef from './FaceRef.astro';
import FaceSprite from './FaceSprite.astro';
import {
  formatDate,
  formatNumber,
  latestInspectionDate,
  municipalityListing,
  type Municipality,
} from '../lib/data';
import { MAP_EPOCH, tileSet, type Utsnitt } from '../lib/kartrutor';
import { hasMark, markRatio } from '../lib/marke';
import { VERDICT } from '../lib/site';
import { path } from '../lib/urls';
import { latestEdition } from '../lib/utmarkelser';

interface Props {
  kommun: Municipality;
  /** Utsnittet kartan öppnar på, och talen under den. Kommunens i dag, hela
   *  rikets när `/karta/` byggs. Kommer ur lib/kartrutor.ts. */
  data: Utsnitt;
}

const { kommun, data } = Astro.props;
const base = `/${kommun.slug}`;

/*
 * Rutarkivet, hela riket i en fil.
 *
 * Adressen är innehållsbaserad och kan därför cachas för alltid. Kommunernas
 * slugar följer med som ordbok: nålen i rutan bär bara ett index, och länken
 * /<kommun>/<slug>/ går inte att bygga utan den. Tolv rader i dag, 290 den dag
 * täckningen är hel, alltså några hundra byte i sidans HTML mot en extra
 * hämtning som skulle behöva vara klar innan första nålen kan klickas.
 */
const rutor = tileSet();

/*
 * Listan som ligger i HTML.
 *
 * Sextio rader, inte hela kommunen. Sidan ska vara läsbar och länkad utan en
 * rad JavaScript, men Stockholms 8 511 rader i dokumentet hade gett samma
 * 11 MB HTML som en gång tvingade fram sidindelningen av hubben. Sextio rader
 * räcker för att sidan ska ha innehåll, och hela beståndet finns länkat från
 * hubben, som är den kanoniska listan.
 *
 * Klienten ersätter raderna med dem som syns i kartans utsnitt så fort
 * punkterna är hämtade.
 */
const SERVER_ROWS = 60;
const initial = municipalityListing(kommun.slug)
  .filter((e) => e.lat !== null && e.lng !== null)
  .slice(0, SERVER_ROWS);

/*
 * Utmärkelseikonen i nålens kort är den riktiga ritningen, samma fil som
 * verksamhetssidorna länkar: /utmarkelser/<år>/marke.svg. Kortet byggs av
 * klienten, så adressen och bredden vid 20 px höjd skickas med som data-
 * attribut. Bredden räknas ur ritningens egen proportion så att raden inte
 * hoppar när bilden landar.
 */
const MARKE_H = 20;
const utgava = latestEdition();
const marke = utgava && hasMark(utgava.year) ? utgava : null;
const markeUrl = marke ? `${path('utmarkelser', marke.year)}marke.svg` : '';
const markeW = marke ? Math.round(MARKE_H * markRatio(marke.year)) : 0;

const LEGEND = [
  { v: 0, verdict: 'clean' as const, label: VERDICT.clean.label, count: data.counts[0] },
  { v: 1, verdict: 'minor' as const, label: VERDICT.minor.label, count: data.counts[1] },
  { v: 2, verdict: 'major' as const, label: VERDICT.major.label, count: data.counts[2] },
  { v: 3, verdict: null, label: 'Ingen bedömning', count: data.counts[3] },
];
---

<div
  class="split"
  data-karta
  data-url={rutor.url}
  data-keys={JSON.stringify(rutor.keys)}
  data-bounds={data.bounds.join(',')}
  data-city={kommun.city}
  data-epoch={MAP_EPOCH}
  data-count={data.count}
  data-marke={markeUrl}
  data-marke-w={markeW || undefined}
  data-marke-h={MARKE_H}
>
  <FaceSprite />

  {/* ── Listan ─────────────────────────────────────────────────────────── */}
  <section class="lista" aria-labelledby="listrubrik" data-ark>
    {/*
      Handtagsremsan. Finns bara i markup för smal skärm, där listan är ett
      ark som dras upp underifrån, och göms med display: none över 900 px.

      Den ligger FÖRE listhuvudet och inte i det, eftersom den ska stå still
      medan resten av arket rullar under den. Knappen är hela remsan: ett
      3 mm brett streck är inte en träffyta, och tryckytan måste vara raden.
    */}
    <button type="button" class="handtag" data-handtag aria-expanded="false">
      <span class="grepp" aria-hidden="true"></span>
      <span class="visually-hidden" data-handtag-text>Visa listan</span>
    </button>

    <div class="arkinne" data-arkinne>
    <header class="listhuvud">
      <h2 id="listrubrik" data-rubrik>
        {formatNumber(data.count)} verksamheter i {kommun.city}
      </h2>
      <p class="text-secondary" data-underrubrik>
        Med känd plats. Dra i kartan för att se dem som ligger där.
      </p>

      {/* Syns bara vid tomt resultat MED filter. Vid tomt utsnitt utan filter
          är rådet att dra i kartan, och då finns inget att rensa. */}
      <button type="button" class="rensa" data-rensa hidden>Rensa filtret</button>

      {/* Filtret. Sidhuvudets sök leder till andra sidor; det här fältet
          filtrerar vyn man står i, kort och nålar samtidigt, medan man
          skriver. Ingen knapp: fältet ÄR handlingen. Skriptet nedan äger
          beteendet, inklusive att Escape rensar och att värdet inte får
          överleva ett sidbyte. */}
      <div class="filterfalt">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="9" cy="9" r="5.4" fill="none" stroke="currentColor" stroke-width="1.7" />
          <path d="M13.2 13.2 17 17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <label class="visually-hidden" for="kartfilter-q">Filtrera på namn eller typ</label>
        <input
          id="kartfilter-q"
          type="search"
          placeholder="Filtrera på namn eller typ"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          data-filter
        />
      </div>
    </header>

    {/* Kortgrid i två kolumner, som Airbnbs resultat. Strukturen här MÅSTE
        spegla ritaLista i skriptet exakt: klienten byter ut korten vid varje
        panorering, och två olika kortformer hade synts som ett hopp i samma
        sekund som kartan vaknar. */}
    <ol class="rader" data-rader>
      {initial.map((e) => (
        <li>
          <a href={path(base, e.slug)}>
            <span class="k-topp">
              <FaceRef verdict={e.verdict} size={28} />
              <b>{e.name}</b>
            </span>
            {e.types[0] && <span class="k-typ text-secondary">{e.types[0]}</span>}
            <span class="k-meta">
              {e.verdict ? VERDICT[e.verdict].label : 'Ingen bedömning'}
              {latestInspectionDate(e) && (
                <> · {formatDate(latestInspectionDate(e)!)}</>
              )}
            </span>
          </a>
        </li>
      ))}
    </ol>

    <p class="listfot text-secondary" data-listfot>
      Visar de {formatNumber(Math.min(SERVER_ROWS, data.count))} första i
      bokstavsordning. <a href={path(base)}>Hela listan för {kommun.city}</a>.
    </p>
    </div>
  </section>

  {/* ── Kartan ─────────────────────────────────────────────────────────── */}
  <section class="kartkolumn" aria-label={`Karta över ${kommun.city}`}>
    <div class="kartram" data-kartram>
      <div class="duk" data-duk></div>

      {/* Nålens kort. Ett element, två skepnader: ett kort vid nålen på stora
          skärmar, ett ark mot underkanten på små. Se stilarna längst ned. */}
      <div class="kort" data-kort hidden role="dialog" aria-label="Vald verksamhet">
        <button type="button" class="kort-stang" data-kort-stang aria-label="Stäng">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
        <div class="kort-inne" data-kort-inne></div>
      </div>

      <p class="fel" data-fel hidden role="alert">
        Kartan gick inte att ladda. Listan bredvid fungerar ändå.
      </p>
    </div>

    <div class="under">
      <ul class="teckenforklaring">
        {LEGEND.filter((l) => l.count > 0).map((l) => (
          <li>
            <FaceMark verdict={l.verdict} size={18} />
            <span>{l.label}</span>
            <span class="n text-muted">{formatNumber(l.count)}</span>
          </li>
        ))}
      </ul>

      {/* Attributionen står här OCH i kartans hörn. Kravet är att den syns,
          och ett kontrollelement som kan fällas ihop är ingen garanti. */}
      <p class="attribution text-muted">
        Kartdata <a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer" target="_blank">© OpenStreetMap</a>,
        kakel från <a href="https://openfreemap.org" rel="noopener noreferrer" target="_blank">OpenFreeMap</a>.
        {data.derived && (
          <> Platserna i {kommun.city} är beräknade ur adressen och kan ligga några tiotal meter fel.</>
        )}
      </p>
    </div>
  </section>

  {/*
    Växelknappen som låg här är borta.

    Den lät kartan och listan turas om att äga skärmen, alltså två vyer man
    hoppade emellan och aldrig såg samtidigt. Mätt i Airbnbs sökresultat på
    375 px gör de något annat: kartan ligger kvar över HELA skärmen och listan
    är ett ark ovanpå den, med överkanten på 52 procent av höjden, 24 px radie
    upptill och ett litet grått grepp i mitten. Man ser båda hela tiden och
    väljer själv hur mycket av vardera. Arket är byggt nedan.
  */}
</div>

<script>
  /**
   * Kartans klientdel.
   *
   * ## Hur MapLibre laddas
   *
   * Från /maplibre/, alltså som statiska filer, INTE genom paketeraren.
   *
   * MapLibre startar sin vektorarbetare med
   * `new URL('./maplibre-gl-worker.mjs', import.meta.url)`. Paketerar Vite
   * biblioteket pekar den adressen in i /_astro/ där ingen sådan fil finns,
   * arbetaren blir 404, och kartan går sönder UTAN att säga något: stilen
   * laddas, kontrollerna ritas, attributionen står där, och kartytan förblir
   * vit. Rasterkällor fungerar samtidigt, eftersom bilder avkodas på
   * huvudtråden — det var den skillnaden som avslöjade orsaken.
   *
   * Som statiska filer stämmer `import.meta.url` med var filerna ligger,
   * arbetaren hittar sig själv, och huvudtråd och arbetare DELAR
   * maplibre-gl-shared.mjs i stället för att ladda var sin kopia. Se
   * scripts/kopiera-maplibre.mjs.
   *
   * `@vite-ignore` krävs för att Vite inte ska försöka lösa upp adressen vid
   * bygget. Formen blir därmed exakt densamma i dev som i bygget, vilket är
   * vad som sänkte det förra försöket.
   *
   * maplibre-gl 6 har ingen default-export. Destrukturera namn ur modulen,
   * skriv aldrig `mod.default`.
   */
  import { FACE_KEYS, type FaceKey } from '../lib/face';
  /* Nålen ritas av lib/kartnal.ts. Den här filen hade tidigare en EGEN kopia
     av samma funktion, alltså två sanningar om hur en nål ser ut, och de hade
     hunnit divergera i kommentarerna redan. Samma fel som FaceMark bar mot
     lib/face. En kopia av en sanning divergerar alltid till slut.

     Nålen bor i en egen fil och inte i kartbas.ts, eftersom kartbas importerar
     maplibre ur public och därför bara får laddas dynamiskt i webbläsaren. */
  import { faceSvg } from '../lib/kartnal';
  import { lockPage, unlockPage } from '../lib/page-lock';
  import { slugify } from '../lib/slug';
  import { VERDICT } from '../lib/site';

  const MAPLIBRE_URL = '/maplibre/maplibre-gl.mjs';
  const MAPLIBRE_CSS = '/maplibre/maplibre-gl.css';

  /** Etiketter per bedömningssiffra i datafilen. */
  const LABEL = [VERDICT.clean.label, VERDICT.minor.label, VERDICT.major.label, 'Ingen bedömning'];
  const COLOR = ['#00B92B', '#FECB00', '#FF0000', '#C7C7CC'];
  const FACE_BY_V: FaceKey[] = ['clean', 'minor', 'major', 'none'];

  interface Punkt {
    /** Radnummer i datafilen, och nålens id på kartan. Det är den kopplingen
     *  som gör att en rad och en nål kan peka ut varandra. */
    i: number;
    lng: number;
    lat: number;
    v: number;
    namn: string;
    slug: string;
    /** Kommunens slug. Nålen bär ett index mot ordboken i sidans HTML, och
     *  utan det kan en rikskarta inte bygga länken till verksamheten. */
    kommun: string;
    /** Dagar sedan epok. 0 = ingen kontroll. */
    d: number;
    /** Kommunens egen benämning på verksamheten. Tom när källan saknar den. */
    typ: string;
    /** Antal kontroller i historiken. */
    k: number;
    /** Har utmärkelse. */
    u: boolean;
  }

  /**
   * Hur nära två punkter måste ligga för att räknas som SAMMA ADRESS.
   *
   * Koordinaterna i datafilen är avrundade till hundratusendels grad, alltså
   * ungefär en meter, så två verksamheter i samma hus har oftast identiska
   * tal. Tröskeln är ändå satt något över noll: en gallerias verksamheter kan
   * ha geokodats mot samma adress med en meters spridning, och för en besökare
   * är det samma plats. Tre hundratusendelar är omkring tre meter i nordsydlig
   * led, alltså inom en byggnad och aldrig två grannhus.
   */
  const SAMMA_PLATS = 3e-5;

  const root = document.querySelector<HTMLElement>('[data-karta]');

  if (root) {
    const duk = root.querySelector<HTMLElement>('[data-duk]')!;
    const rader = root.querySelector<HTMLOListElement>('[data-rader]')!;
    const rubrik = root.querySelector<HTMLElement>('[data-rubrik]')!;
    const underrubrik = root.querySelector<HTMLElement>('[data-underrubrik]')!;
    const listfot = root.querySelector<HTMLElement>('[data-listfot]')!;
    const filterFalt = root.querySelector<HTMLInputElement>('[data-filter]')!;
    const rensa = root.querySelector<HTMLButtonElement>('[data-rensa]')!;
    const kartram = root.querySelector<HTMLElement>('[data-kartram]')!;
    const kort = root.querySelector<HTMLElement>('[data-kort]')!;
    const kortInne = root.querySelector<HTMLElement>('[data-kort-inne]')!;
    const kortStang = root.querySelector<HTMLButtonElement>('[data-kort-stang]')!;
    const fel = root.querySelector<HTMLElement>('[data-fel]')!;
    const ark = root.querySelector<HTMLElement>('[data-ark]')!;
    const arkInne = root.querySelector<HTMLElement>('[data-arkinne]')!;
    const handtag = root.querySelector<HTMLButtonElement>('[data-handtag]')!;
    const handtagText = root.querySelector<HTMLElement>('[data-handtag-text]')!;

    /** Nedskruvad rörelse. Läses en gång: arket, kortet och kartans easeTo
     *  ska alla följa samma inställning, och den ändras inte under besöket. */
    const reducerad = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /**
     * Kartan. Deklareras HÄR och inte nere vid sitt eget avsnitt.
     *
     * Arket sätts upp långt före kartan startar och rör den i samma andetag:
     * `slaPaArk` kallar `karta.resize()`, eftersom rutan byter mått när
     * app-ytan slås på. Låg deklarationen kvar nere vid kartavsnittet läste
     * den raden en binding som ännu inte fanns, och hela skriptet dog med
     * "Cannot access before initialization" innan `start()` ens kallades.
     * Resultatet var lömskt: arket fungerade, listan stod kvar med sina
     * server-renderade rader, och kartrutan var bara vit. Ingen felrad syntes,
     * för felet inträffade utanför det try som visar den.
     */
    let karta: any = null;

    /**
     * Adressen till en verksamhet.
     *
     * Byggd ur PUNKTENS egen kommun och inte ur sidans. På kommunens kartsida
     * är de alltid samma, men rikskartan visar hela landet i samma vy, och en
     * nål i Uppsala som länkade till /stockholm/ hade varit en 404 med rätt
     * utseende.
     */
    function adress(p: Punkt): string {
      return `/${p.kommun}/${p.slug}/`;
    }
    const EPOK = Date.parse(root.dataset.epoch!);
    const DAG = 86_400_000;

    /** Kommunernas slugar, i den ordning `m` i rutorna pekar på dem. En
     *  rikskarta kan inte gissa vilken kommun en nål tillhör, och länken
     *  /<kommun>/<slug>/ behöver veta det. */
    const KOMMUNER: string[] = JSON.parse(root.dataset.keys!);

    /**
     * En nål ur rutan till en punkt.
     *
     * Rutorna bär allt kortet och raden behöver, av ett skäl som står utskrivet
     * i lib/kartrutor.ts: rutan hämtas ändå bara för det utsnitt man tittar på,
     * och att i stället skicka id och hämta namnen hade lagt en andra rundtur
     * mitt i en panorering.
     *
     * Två fält räknas fram i stället för att skickas. Slugen härleds ur namnet
     * och följer med i rutan bara när härledningen inte stämmer; bygget jämför
     * alltid mot den slug pipelinen satte, så en felräknad slug kan inte nå
     * hit. Se lib/slug.ts. Kommunen är ett index mot ordboken ovan.
     */
    function franRuta(props: any, lng: number, lat: number): Punkt {
      const namn = props.nm as string;
      return {
        i: props.i,
        lng,
        lat,
        v: props.v,
        namn,
        slug: props.s ?? slugify(namn),
        kommun: KOMMUNER[props.m] ?? KOMMUNER[0],
        d: props.dt ?? 0,
        typ: props.ty ?? '',
        k: props.k ?? 0,
        u: props.u === 1,
      };
    }

    /**
     * Datakällans enda gränssnitt mot kartan.
     *
     * FÖRUT: hela kommunen i en fil, hämtad en gång, filtrerad lokalt. Det höll
     * upp till några tiotusen punkter, alltså en kommun i taget, och gick inte
     * att sträcka till en rikskarta. Ingen kommunfil kan svara på "vad finns i
     * den här rektangeln", och vid 290 kommuner är beståndet omkring 90 000
     * punkter.
     *
     * NU: en rutpyramid över hela riket i EN PMTiles-fil, byggd av
     * lib/kartrutor.ts. Webbläsaren läser de rutor som ligger i utsnittet,
     * alltså tiotals kilobyte, aldrig arkivet. Funktionen läser därför ur de
     * rutor MapLibre redan hämtat.
     *
     * Allt nedanför tar emot en lista punkter och bryr sig fortfarande inte om
     * varifrån de kom. Det var hela poängen med att lägga källan i EN funktion,
     * och den höll.
     *
     * `version` räknas upp varje gång rutor kommit eller kartan rört sig, och
     * är det som gör att mängden räknas om en gång per bild i stället för en
     * gång per anropare.
     */
    let lastade: Punkt[] = [];
    let lastadVersion = -1;
    let version = 0;

    function punktKalla(): Punkt[] {
      if (lastadVersion === version) return lastade;
      if (!karta || !karta.getSource('verksamheter')) return lastade;

      /*
       * `querySourceFeatures` ger allt i de LADDADE rutorna, alltså även en bit
       * utanför skärmen. Det är rätt mängd här: listan beskärs ändå mot
       * utsnittet längre ned, och grupperingen av adresser blir mer korrekt med
       * marginal runt kanten.
       *
       * Avdubbleringen på `i` är INTE valfri. Vektorrutor har en kantbuffert, så
       * en nål nära en rutgräns ligger i båda rutorna. Utan mängden får listan
       * dubbletter och kortets bläddring räknar samma verksamhet två gånger.
       */
      const sedda = new Map<number, Punkt>();
      const features = karta.querySourceFeatures('verksamheter', {
        sourceLayer: 'punkter',
        filter: ['!', ['has', 'point_count']],
      });

      for (const f of features) {
        const props = f.properties;
        if (sedda.has(props.i)) continue;
        // MapLibre lämnar ut geometrin i longitud och latitud, inte i rutans
        // egna heltal, vilket är precis vad listan och kortet vill ha.
        const c = f.geometry.coordinates;
        sedda.set(props.i, franRuta(props, c[0], c[1]));
      }

      lastade = [...sedda.values()];
      lastadVersion = version;
      // Grupperna och söktexten hörde till den förra mängden.
      byggGrupper(lastade);
      sokbar = null;
      return lastade;
    }

    /** Punkten med ett visst radnummer, om den ligger i en laddad ruta. */
    function punktMed(i: number): Punkt | undefined {
      return punktKalla().find((p) => p.i === i);
    }

    // ── Punkter på samma adress ──────────────────────────────────────────

    /**
     * Verksamheter som delar adress, grupperade.
     *
     * Det här är den andra halvan av klusterfrågan. Ett kluster kan alltid
     * delas genom att zooma, ända tills punkterna ligger på SAMMA punkt, och
     * då tar zoomen slut: en galleria med tolv serveringar är tolv nålar
     * ovanpå varandra, och den understa går inte att peka på hur nära man än
     * går. Stockholm har gott om dem, och Sturegallerian är typfallet.
     *
     * Mätt i webbläsaren gör Hemnet exakt två saker åt det, och båda byggs
     * här: nålen får en liten ANTALSBRICKA i övre högra hörnet, och ett klick
     * på den öppnar ett kort som BLÄDDRAS, med raden "Visar 1 av 6" i foten.
     * Ingen spindel som slår ut nålarna i en ring, ingen lista som växer ur
     * kartan.
     *
     * `nyckel` avrundar till SAMMA_PLATS-rutor. Två punkter i samma ruta
     * hamnar i samma grupp; grannhus hamnar aldrig i samma ruta.
     *
     * Grupperna byggs EN gång, direkt efter avkodningen, och lever sedan
     * oförändrade. Filtret ändrar vilka nålar som RITAS men aldrig var de
     * ligger, så grupperingen behöver inte räknas om per tangent.
     */
    let grupp: Map<number, Punkt[]> = new Map();

    function byggGrupper(punkter: Punkt[]) {
      const rutor = new Map<string, Punkt[]>();
      for (const p of punkter) {
        const nyckel =
          Math.round(p.lng / SAMMA_PLATS) + ':' + Math.round(p.lat / SAMMA_PLATS);
        const lista = rutor.get(nyckel);
        if (lista) lista.push(p);
        else rutor.set(nyckel, [p]);
      }

      grupp = new Map();
      for (const lista of rutor.values()) {
        /*
         * Ordningen i kortet är bokstavsordning, alltså samma ordning som
         * listan bredvid. Den som bläddrar i kortet och den som läser listan
         * ska möta samma sex namn i samma följd.
         */
        lista.sort((a, z) => a.namn.localeCompare(z.namn, 'sv'));
        for (const p of lista) grupp.set(p.i, lista);
      }
    }

    /** Gruppen punkten tillhör, alltid minst en lång. */
    function gruppFor(p: Punkt): Punkt[] {
      return grupp.get(p.i) ?? [p];
    }

    /**
     * Den nål som ritas för en grupp.
     *
     * Den SÄMSTA bedömningen i gruppen, inte den första i bokstavsordning.
     * Skälet är samma som ritordningen på kartsidan redan följer: en
     * anmärkning får aldrig gömmas under en granne som klarade sig. Ligger
     * ett rött och ett grönt ansikte på samma adress är det röda det som
     * syns, och bläddringen visar båda.
     *
     * Talen är bedömningens ordning i datafilen, där 3 betyder ingen
     * bedömning. Sorteringen är därför 2, 1, 0, 3 och inte rakt fallande.
     */
    const ALLVAR = [2, 1, 0, 3];

    function huvudnal(lista: Punkt[]): Punkt {
      let bast = lista[0];
      for (const p of lista) {
        if (ALLVAR.indexOf(p.v) < ALLVAR.indexOf(bast.v)) bast = p;
      }
      return bast;
    }

    function datumText(d: number): string | null {
      if (!d) return null;
      return new Date(EPOK + d * DAG).toLocaleDateString('sv-SE', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }

    // ── Filtret ──────────────────────────────────────────────────────────

    /**
     * Textfiltret ovanför listan.
     *
     * Ett extra villkor OVANPÅ kartutsnittet: det som visas är snittet av det
     * man ser i kartan och det man skrivit. Matchningen är ordstart utan
     * skiftlägeskänslighet, med svenska tecken intakta: "sus" träffar
     * "Sushi Yama" och "Café Susanne", inte "Rakhusets". Varje ord i frågan
     * måste träffa var sin ordstart i namnet eller typen.
     *
     * `traffar` är radnumren som matchar, null när fältet är tomt. Null och
     * inte en full mängd: tomt filter ska vara gratis att testa mot, och
     * återställningen av kartkällan ska kunna se skillnad på "inget filter"
     * och "filter som råkar träffa allt".
     */
    let traffar: Set<number> | null = null;
    /** Fältets värde som det står, för rubriken och tomtexten. */
    let filterVarde = '';

    /**
     * Sökbar text per punkt: gemener, skiljetecken ersatta med mellanslag, och
     * ett inledande mellanslag så att varje ordstart kan hittas med ett enda
     * includes. Byggs en gång per mängd laddade rutor, inte per tangent.
     *
     * En Map och inte en array. Radnumret var förut punktens plats i kommunens
     * egen fil, alltså tätt från noll. Nu är det ett radnummer i HELA riket och
     * mängden som ligger i de laddade rutorna är gles: en array indexerad på
     * det talet hade blivit tiotusentals tomma platser.
     */
    let sokbar: Map<number, string> | null = null;

    function normalisera(s: string): string {
      return s
        .toLocaleLowerCase('sv')
        .replace(/[^\p{L}\p{N}]+/gu, ' ')
        .trim();
    }

    function raknaTraffar(tokens: string[]): Set<number> {
      const punkter = punktKalla();
      if (!sokbar) {
        sokbar = new Map(punkter.map((p) => [p.i, ' ' + normalisera(p.namn + ' ' + p.typ)]));
      }
      const ut = new Set<number>();
      for (const p of punkter) {
        const text = sokbar.get(p.i)!;
        let allaMed = true;
        for (const tok of tokens) {
          if (!text.includes(' ' + tok)) {
            allaMed = false;
            break;
          }
        }
        if (allaMed) ut.add(p.i);
      }
      return ut;
    }

    /**
     * Fältets lyssnare sätts vid sidladdning, men filtret kan verka först när
     * punkterna och kartan finns. Kartans load-hanterare pekar om `tillampa`
     * till den riktiga tillämpningen; innan dess gör tangenterna ingenting,
     * och värdet plockas upp när kartan vaknar.
     */
    let tillampa: (() => void) | null = null;

    filterFalt.addEventListener('input', () => tillampa?.());

    rensa.addEventListener('click', () => {
      filterFalt.value = '';
      tillampa?.();
      filterFalt.focus();
    });

    filterFalt.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && filterFalt.value) {
        filterFalt.value = '';
        tillampa?.();
        // Stanna här: dokumentlyssnaren längre ned stänger annars nålens
        // kort i samma tryckning. Ett Escape, en sak.
        ev.stopPropagation();
      }
    });

    /*
     * Filtret ska INTE överleva ett sidbyte. bfcache återställer fältet vid
     * tillbaka-navigering utan att köra om skriptet, och Firefox gör det även
     * vid vanlig omladdning trots autocomplete="off". pageshow är den händelse
     * som täcker båda.
     */
    window.addEventListener('pageshow', () => {
      if (filterFalt.value) {
        filterFalt.value = '';
        tillampa?.();
      }
    });

    // ── Listan ───────────────────────────────────────────────────────────

    /** Hur många kort som ritas. Sänkt från 120 när raderna blev kort: varje
     *  post kostar fler element nu, och DOM-kostnaden vid varje panorering är
     *  det som avgör om dragningen känns mjuk. Sextio kort är trettio rader i
     *  tvåkolumnsgriden, mer än någon rullar igenom medan kartan rör sig. */
    const MAX_RADER = 60;

    /**
     * @param synliga  Nålarna i utsnittet, alltså de som blir kort.
     * @param totalt   Hur många av dem det är.
     * @param iBubbla  Hur många verksamheter i utsnittet som ligger inne i en
     *                 bubbla och därför INTE kan bli kort. Noll när ett filter
     *                 är på, eftersom bubblorna göms då.
     */
    function ritaLista(synliga: Punkt[], totalt: number, iBubbla = 0) {
      const visa = synliga.slice(0, MAX_RADER);
      const frag = document.createDocumentFragment();

      for (const p of visa) {
        const li = document.createElement('li');
        // Radnumret är nålens id. Utan det kan kortet inte peka ut sin nål.
        li.dataset.i = String(p.i);
        const a = document.createElement('a');
        a.href = adress(p);

        // Samma struktur som de server-renderade korten i mallen ovan, av
        // samma skäl som stilarna ligger under :global: klienten byter ut
        // korten, och två kortformer hade synts som ett hopp.
        const topp = document.createElement('span');
        topp.className = 'k-topp';
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('class', 'face');
        svg.setAttribute('width', '28');
        svg.setAttribute('height', '28');
        svg.setAttribute('viewBox', '0 0 100 100');
        svg.setAttribute('aria-hidden', 'true');
        const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
        use.setAttribute('href', `#pk-face-${FACE_BY_V[p.v]}`);
        svg.appendChild(use);
        const b = document.createElement('b');
        // textContent, aldrig innerHTML: namnen kommer ur kommunernas register
        // och har inte passerat någon sanering.
        b.textContent = p.namn;
        topp.append(svg, b);
        a.appendChild(topp);

        if (p.typ) {
          const typ = document.createElement('span');
          typ.className = 'k-typ text-secondary';
          typ.textContent = p.typ;
          a.appendChild(typ);
        }

        const meta = document.createElement('span');
        meta.className = 'k-meta';
        const datum = datumText(p.d);
        meta.textContent = LABEL[p.v] + (datum ? ` · ${datum}` : '');
        a.appendChild(meta);

        li.appendChild(a);
        frag.appendChild(li);
      }

      rader.replaceChildren(frag);

      /*
       * En rad, inte två.
       *
       * Här stod tidigare "Listan följer kartan. Dra för att se andra delar av
       * staden." under varje rubrik. Den meningen förklarar något användaren
       * upptäcker i samma sekund som hen drar första gången, och den låg kvar
       * på skärmen i all evighet efteråt. Undantaget är det tomma utsnittet,
       * där det inte finns något att upptäcka och en instruktion är det enda
       * som hjälper.
       */
      const stad = root!.dataset.city;
      const filtrerat = traffar !== null;

      /*
       * Rubriken räknar HELA utsnittet, alltså nålarna plus det som ligger inne
       * i bubblorna. Listan kan bara visa nålarna.
       *
       * Skillnaden fanns inte förut. Hela kommunen låg då i minnet och varje
       * punkt var en rad, oavsett om kartan råkade rita den som en bubbla. Med
       * rutor finns bara det rutan bär, och på kommunens öppningszoom är nästan
       * allt sammanslaget: ett Stockholm med 8 499 verksamheter ger ett
       * femtontal lösa nålar. En rubrik som sa "15 verksamheter" hade varit
       * falsk, inte bara mindre användbar.
       */
      const iVyn = totalt + iBubbla;

      if (iVyn === 0) {
        // Samma tomrubrik med och utan filter, men förklaringen är en annan:
        // med filter är det filtret som tömde vyn, och rensknappen visas.
        rubrik.textContent = 'Inga verksamheter här';
        underrubrik.textContent = filtrerat
          ? `Ingenting i utsnittet matchar ”${filterVarde}”. Dra i kartan eller rensa filtret.`
          : `Dra eller zooma ut för att se fler i ${stad}.`;
        underrubrik.hidden = false;
      } else {
        rubrik.textContent = filtrerat
          ? `${iVyn.toLocaleString('sv-SE')} ${iVyn === 1 ? 'träff' : 'träffar'}`
          : `${iVyn.toLocaleString('sv-SE')} verksamheter`;
        underrubrik.hidden = true;
      }
      rensa.hidden = !(filtrerat && iVyn === 0);

      /*
       * Foten säger vad man inte ser, och varför. Två olika skäl, två olika
       * meningar: antingen ryms inte alla kort på en gång, eller så ligger
       * verksamheterna i bubblor som måste delas först.
       */
      if (iBubbla > 0) {
        listfot.hidden = false;
        listfot.textContent = totalt === 0
          ? `Zooma in eller klicka på en prick för att se dem i listan.`
          : `Visar ${visa.length} av ${iVyn.toLocaleString('sv-SE')}. Zooma in för att se resten.`;
      } else {
        listfot.hidden = totalt <= MAX_RADER;
        if (!listfot.hidden) {
          listfot.textContent = `Visar ${visa.length} av ${totalt.toLocaleString('sv-SE')}. Zooma in för att se färre åt gången.`;
        }
      }
    }

    // ── Samspel lista ↔ karta ────────────────────────────────────────────

    /**
     * Den nål och den rad som pekar ut varandra.
     *
     * Nålen lyfts genom att lagret `nal-lyft` filtreras på radnumret. Skälet
     * till att det INTE görs med feature-state står vid lagret längre ned:
     * `icon-size` är en layout-egenskap, och MapLibre tillåter feature-state
     * bara i paint-egenskaper. `setFilter` rör ett lager som innehåller noll
     * eller en nål, så det kostar ingenting per bild.
     */
    let hovrad: number | null = null;

    function satHovrad(i: number | null) {
      if (hovrad === i) return;
      hovrad = i;

      const gammal = rader.querySelector('li.aktiv');
      if (gammal) gammal.classList.remove('aktiv');

      if (i !== null) {
        const ny = rader.querySelector(`li[data-i="${i}"]`);
        if (ny) ny.classList.add('aktiv');
      }

      // Lyftlagret innehåller den nål vars radnummer filtret pekar ut, alltså
      // noll eller en. -1 finns inte i datan och betyder "ingen".
      if (karta && karta.getLayer('nal-lyft')) {
        karta.setFilter('nal-lyft', ['==', ['get', 'i'], i ?? -1]);
      }
    }

    // Rad → nål. Delegerat på listan, eftersom raderna byts ut vid varje
    // panorering och en lyssnare per rad hade fått sättas om hela tiden.
    rader.addEventListener('mouseover', (e) => {
      const li = (e.target as HTMLElement).closest('li');
      if (li && li.dataset.i) satHovrad(Number(li.dataset.i));
    });
    rader.addEventListener('mouseleave', () => satHovrad(null));

    /*
     * Kort → nål på pekskärm.
     *
     * Hovring finns inte på ett finger, så kopplingen måste hänga på något
     * annat. Det som finns är rullningen: den nål som hör till det översta
     * kortet i arket lyfts, och lyftet följer med när man rullar. Man ser
     * alltså hela tiden var på kartan man befinner sig i listan, utan en enda
     * extra knapp i korten. Motsatt väg, nål → kort, sköts av kartans
     * klickhanterare längre ned.
     *
     * Läses i en rAF och inte per rullningshändelse: elementFromPoint tvingar
     * fram layout, och en gång per bildruta är det som gör att arket fortsätter
     * kännas mjukt medan det rullar.
     */
    let rullVantar = false;

    function foljRullning() {
      if (rullVantar) return;
      rullVantar = true;
      requestAnimationFrame(() => {
        rullVantar = false;
        if (!arkAktivt) return;
        const topp = rader.getBoundingClientRect().top;
        for (const li of rader.children) {
          const r = (li as HTMLElement).getBoundingClientRect();
          if (r.bottom > Math.max(topp, arkInne.getBoundingClientRect().top) + 4) {
            const i = (li as HTMLElement).dataset.i;
            if (i) satHovrad(Number(i));
            return;
          }
        }
      });
    }

    // ── Nålens kort ──────────────────────────────────────────────────────

    let valdSlug: string | null = null;
    let valdPunkt: Punkt | null = null;

    /*
     * Textfärgen för bedömningen är INTE nålens färg.
     *
     * COLOR är märkesfärgerna, valda för att synas som fyllda ytor mot en
     * karta. Som text på vitt är gult (#FECB00) i praktiken oläsligt och grått
     * (#C7C7CC) nästan osynligt. Sajten har redan mörkare varianter avsedda
     * för text i tokens.css, och det är de som ska användas här.
     */
    const INK = [
      'var(--verdict-clean-ink)',
      'var(--verdict-minor-ink)',
      'var(--verdict-major-ink)',
      'var(--text-secondary)',
    ];

    function e(tagg: string, klass?: string): HTMLElement {
      const n = document.createElement(tagg);
      if (klass) n.className = klass;
      return n;
    }

    /** Rund knapp med en pil i, för bläddringen i stapelkortet. */
    function knappMedPil(etikett: string, d: string, vid: () => void): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'kort-blad-knapp';
      b.setAttribute('aria-label', etikett);
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('aria-hidden', 'true');
      const bana = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      bana.setAttribute('d', d);
      bana.setAttribute('fill', 'none');
      bana.setAttribute('stroke', 'currentColor');
      bana.setAttribute('stroke-width', '2');
      bana.setAttribute('stroke-linecap', 'round');
      bana.setAttribute('stroke-linejoin', 'round');
      svg.appendChild(bana);
      b.appendChild(svg);
      b.addEventListener('click', vid);
      return b;
    }

    function ansikte(v: number, storlek: number): SVGElement {
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'face');
      svg.setAttribute('width', String(storlek));
      svg.setAttribute('height', String(storlek));
      svg.setAttribute('viewBox', '0 0 100 100');
      svg.setAttribute('aria-hidden', 'true');
      const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
      use.setAttribute('href', `#pk-face-${FACE_BY_V[v]}`);
      svg.appendChild(use);
      return svg;
    }

    /**
     * Gruppen kortet bläddrar i, null när kortet visar en ensam verksamhet.
     * Se stapelresonemanget vid byggGrupper: formen är Hemnets bläddring,
     * "Visar 1 av 6", och inte en lista som växer ur kartan.
     */
    let valdGrupp: Punkt[] | null = null;

    function visaKort(p: Punkt, gruppen: Punkt[] | null = null) {
      valdGrupp = gruppen && gruppen.length > 1 ? gruppen : null;
      valdSlug = p.slug;
      valdPunkt = p;
      const datum = datumText(p.d);

      const inne = document.createDocumentFragment();

      const topp = e('div', 'kort-topp');
      const titel = e('div', 'kort-titel');
      const namn = document.createElement('b');
      namn.textContent = p.namn;
      titel.appendChild(namn);
      if (p.typ) {
        const typ = e('span', 'kort-typ');
        typ.textContent = p.typ;
        titel.appendChild(typ);
      }
      topp.append(ansikte(p.v, 38), titel);
      inne.appendChild(topp);

      const mitt = e('div', 'kort-mitt');
      const mittText = e('div', 'kort-mitt-text');
      const bedomning = e('span', 'kort-bedomning');
      bedomning.textContent = LABEL[p.v];
      bedomning.style.color = INK[p.v];
      mittText.appendChild(bedomning);

      /*
       * Två fakta, inte fler. Kortet ska gå att läsa på en blick medan man
       * fortfarande har kartan i ögat; allt som kräver läsning hör hemma på
       * verksamhetssidan som länken går till.
       */
      const fakta: string[] = [];
      if (datum) fakta.push(`Kontrollerad ${datum}`);
      if (p.k > 1) fakta.push(`${p.k} kontroller i historiken`);
      if (fakta.length > 0) {
        const rad = e('p', 'kort-fakta');
        rad.textContent = fakta.join(' · ');
        mittText.appendChild(rad);
      }
      mitt.appendChild(mittText);

      /*
       * Utmärkelsen är den riktiga ritningen, inte en generisk stjärna, och
       * ingen text: märket ÄR beskedet, precis som i ett skyltfönster. Den
       * ligger inline i mittsektionen i stället för i en egen hårlinjesektion,
       * så kortet blir en rad kortare. Bilden är samma URL som verksamhets-
       * sidorna visar och ligger därför redan i cachen för många besökare.
       * alt-texten är det tillgängliga namnet; syns gör bara kransen.
       */
      const MARKE = root!.dataset.marke;
      if (p.u && MARKE) {
        const bild = document.createElement('img');
        bild.className = 'kort-marke';
        bild.src = MARKE;
        bild.alt = 'Utmärkelse';
        bild.width = Number(root!.dataset.markeW);
        bild.height = Number(root!.dataset.markeH);
        mitt.appendChild(bild);
      }
      inne.appendChild(mitt);

      const lank = document.createElement('a');
      lank.className = 'kort-lank';
      lank.href = adress(p);
      const lankText = document.createElement('span');
      lankText.textContent = 'Se kontrollerna';
      const pil = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      pil.setAttribute('viewBox', '0 0 24 24');
      pil.setAttribute('width', '16');
      pil.setAttribute('height', '16');
      pil.setAttribute('aria-hidden', 'true');
      const pilBana = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      pilBana.setAttribute('d', 'M5 12h13m-5-5l5 5-5 5');
      pilBana.setAttribute('fill', 'none');
      pilBana.setAttribute('stroke', 'currentColor');
      pilBana.setAttribute('stroke-width', '1.8');
      pilBana.setAttribute('stroke-linecap', 'round');
      pilBana.setAttribute('stroke-linejoin', 'round');
      pil.appendChild(pilBana);
      lank.append(lankText, pil);
      inne.appendChild(lank);

      /*
       * Bläddringen. Bara när adressen bär fler än en verksamhet, och alltid
       * längst ned: kortet läses uppifrån, och det man gör härnäst står sist.
       * Formuleringen är Hemnets, för den säger både var man är och hur många
       * som finns, vilket en ren pilrad inte gör.
       */
      if (valdGrupp) {
        const nu = valdGrupp.indexOf(p);
        const rad = e('div', 'kort-blad');
        const stega = (steg: number) => {
          const nasta = (nu + steg + valdGrupp!.length) % valdGrupp!.length;
          visaKort(valdGrupp![nasta], valdGrupp);
        };

        const bak = knappMedPil('Föregående', 'M15 5l-6 7 6 7', () => stega(-1));
        const fram = knappMedPil('Nästa', 'M9 5l6 7-6 7', () => stega(1));
        const text = e('span', 'kort-blad-text');
        text.textContent = `Visar ${nu + 1} av ${valdGrupp.length} på samma adress`;

        rad.append(bak, text, fram);
        inne.appendChild(rad);
      }

      kortInne.replaceChildren(inne);
      kort.hidden = false;

      /*
       * Nål → kort på telefon. Arket dras ned till remsan så att kortet får
       * plats ovanför det, och raden som hör till nålen markeras och rullas
       * fram. Väljer man sedan att dra upp arket igen står man alltså på rätt
       * ställe i listan. Andra halvan av kopplingen, kort → nål, ligger på
       * arkets rullning längre upp.
       */
      if (arkAktivt) {
        if (lage !== 'remsa') stallArk('remsa');
        satHovrad(p.i);
        const li = rader.querySelector(`li[data-i="${p.i}"]`);
        if (li) li.scrollIntoView({ block: 'nearest', behavior: 'auto' });
      }

      // Den valda nålen lyfts, som hos Airbnb. Samma lager som hovringen
      // använder, och av samma skäl: icon-size är layout och kan inte styras
      // av feature-state.
      if (karta?.getLayer('nal-lyft')) karta.setFilter('nal-lyft', ['==', ['get', 'i'], p.i]);

      placeraKort();
    }

    /**
     * Lägger kortet vid nålen.
     *
     * Ovanför när det får plats, annars nedanför, annars klämt inom ramen.
     * Vågrätt centreras det över nålen men trycks in från ramens kanter, och
     * pilen flyttas då i motsvarande grad så att den fortsätter peka på nålen
     * i stället för på kortets mitt.
     */
    function placeraKort() {
      if (!valdPunkt || !karta || kort.hidden) return;

      // På smal skärm är kortet ett ark mot underkanten och styrs av CSS.
      if (smal.matches) {
        kort.classList.remove('under');
        kort.style.removeProperty('left');
        kort.style.removeProperty('top');
        kort.style.removeProperty('--pil');
        return;
      }

      const pt = karta.project([valdPunkt.lng, valdPunkt.lat]);
      const ramW = kartram.clientWidth;
      const ramH = kartram.clientHeight;
      const kW = kort.offsetWidth;
      const kH = kort.offsetHeight;
      const M = 10; // minsta avstånd till ramens kant
      const G = 12; // luft mellan nål och kort

      const ovan = pt.y - NAL_H - G - kH;
      const under = pt.y + G;
      let top: number;
      let flippad = false;
      if (ovan >= M) {
        top = ovan;
      } else if (under + kH <= ramH - M) {
        top = under;
        flippad = true;
      } else {
        top = Math.max(M, Math.min(ovan, ramH - kH - M));
      }

      const left = Math.max(M, Math.min(pt.x - kW / 2, ramW - kW - M));

      kort.classList.toggle('under', flippad);
      kort.style.left = `${Math.round(left)}px`;
      kort.style.top = `${Math.round(top)}px`;
      kort.style.setProperty('--pil', `${Math.round(pt.x - left)}px`);
    }

    function stangKort() {
      kort.hidden = true;
      valdSlug = null;
      valdPunkt = null;
      valdGrupp = null;
      if (karta?.getLayer('nal-lyft')) karta.setFilter('nal-lyft', ['==', ['get', 'i'], -1]);
    }

    kortStang.addEventListener('click', stangKort);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !kort.hidden) stangKort();
    });

    // ── Mobilarket ───────────────────────────────────────────────────────

    /**
     * Listan som ark, på skärmar där en delad vy inte får plats.
     *
     * ## Formen
     *
     * Mätt i Airbnbs sökresultat på 375 px: kartan ligger över hela ytan,
     * listan är ett vitt ark ovanpå med överkanten på 52 procent av höjden,
     * 24 px radie i de övre hörnen, ingen skugga, och ett litet grått grepp
     * centrerat i överkanten. Booli och Hemnet gör något annat på telefon,
     * nämligen en knapp i kontrollraden som byter hela vyn, alltså precis den
     * växel som stod här förut. Arket är det bättre svaret och det är Airbnbs.
     *
     * ## Tre lägen
     *
     * REMSA visar bara greppet och rubrikraden, alltså mest karta.
     * HALV är vilolägets 52 procent, samma tal som Airbnb.
     * HOG är nästan hela skärmen, för den som läser listan och inte kartan.
     *
     * Lägena är andelar av arkets höjd och inte fasta pixlar, så att en liten
     * telefon och en stor får samma proportioner.
     *
     * ## Varför transform och inte height
     *
     * Arket har alltid HOG höjd och skjuts ned med translateY. Att animera
     * höjden hade lagt om layouten i varje bildruta, alltså ett omflöde per
     * fingerrörelse i en lista med sextio kort. En transform rör bara
     * sammansättningen och går på grafikkortet.
     *
     * ## Rullningen
     *
     * Sidan bakom låses med lib/page-lock.ts hela tiden arket är uppe. Det är
     * inte kosmetika: utan låset rullar webbläsaren själv sidan när filtret
     * får fokus och tangentbordet fälls upp, och då glider hela app-ytan iväg.
     * Låset ger dessutom `--keyboard-inset`, som arket lyfter sig med, och det
     * är den enda källan som vet tangentbordets höjd på iOS: dvh räknar den
     * inte, visualViewport gör det.
     */
    const smal = window.matchMedia('(max-width: 900px)');

    const LAGEN = { remsa: 0, halv: 1, hog: 2 } as const;
    type Lage = keyof typeof LAGEN;

    /**
     * Hur stor del av arkets höjd som SYNS i respektive läge.
     *
     * `halv` är 0,52, mätt i Airbnbs ark på 375 px. `remsa` är satt så att
     * greppet OCH rubrikraden syns: ett ark som bara visar ett streck säger
     * inte vad som ligger under det, och då blir det en knapp man måste gissa
     * sig till. `hog` lämnar en remsa karta kvar upptill, så att man aldrig
     * tappar bort att kartan finns kvar bakom.
     */
    const SYNS: Record<Lage, number> = { remsa: 0.15, halv: 0.52, hog: 0.94 };
    const ORDNING: Lage[] = ['remsa', 'halv', 'hog'];

    let arkAktivt = false;
    let lage: Lage = 'halv';
    /** Arkets höjd i pixlar, mätt en gång per storleksändring. */
    let arkH = 0;

    /** Hur långt ned arket ska stå i ett läge, i pixlar från sitt eget tak. */
    function nedskjut(l: Lage): number {
      return Math.round(arkH * (1 - SYNS[l]));
    }

    function stallArk(nytt: Lage, mjukt = true) {
      lage = nytt;
      ark.style.transition = mjukt && !reducerad ? 'transform 260ms cubic-bezier(.2,.8,.3,1)' : 'none';
      ark.style.transform = `translateY(${nedskjut(nytt)}px)`;
      handtag.setAttribute('aria-expanded', String(nytt !== 'remsa'));
      handtagText.textContent = nytt === 'remsa' ? 'Visa listan' : 'Fäll ned listan';
      /*
       * Innehållet får bara rulla i det högsta läget. I remsa och halv ska ett
       * svep i arket DRA arket, inte rulla listan, vilket är samma regel som
       * varje inbyggt ark på iOS följer.
       */
      arkInne.style.overflowY = nytt === 'hog' ? 'auto' : 'hidden';
      if (nytt !== 'hog') arkInne.scrollTop = 0;
      root!.dataset.lage = nytt;

      /*
       * Hur högt arket når, som CSS-variabel.
       *
       * Attributionen till OpenStreetMap är ett LICENSKRAV och får aldrig
       * döljas. Den ligger i kartans nedre högra hörn, alltså precis där
       * arket är, och en fast bottenmarginal räcker inte: arket flyttar sig i
       * tre lägen och skulle lägga sig över upphovet i två av dem. Kontrollen
       * följer därför arkets överkant, se regeln i stilarna.
       */
      root!.style.setProperty('--ark-syns', `${arkH - nedskjut(nytt)}px`);
    }

    function matArk() {
      if (!arkAktivt) return;
      arkH = ark.offsetHeight;
      stallArk(lage, false);
    }

    function slaPaArk() {
      if (arkAktivt) return;
      arkAktivt = true;
      root!.classList.add('ark');
      lockPage();
      arkH = ark.offsetHeight;
      stallArk('halv', false);
      // Kartan har haft ramens gamla mått och måste räkna om till app-ytan.
      if (karta) requestAnimationFrame(() => karta.resize());
    }

    function slaAvArk() {
      if (!arkAktivt) return;
      arkAktivt = false;
      root!.classList.remove('ark');
      delete root!.dataset.lage;
      ark.style.transform = '';
      ark.style.transition = '';
      arkInne.style.overflowY = '';
      unlockPage();
      if (karta) requestAnimationFrame(() => karta.resize());
    }

    function stallInArk() {
      if (smal.matches) slaPaArk();
      else slaAvArk();
    }

    /*
     * Dragningen.
     *
     * Pointer events och inte touch: samma kod bär finger, penna och mus, och
     * setPointerCapture gör att ett finger som glider utanför remsan ändå
     * fortsätter styra arket i stället för att tappas.
     *
     * Greppet startar alltid en dragning. Innehållet startar en dragning bara
     * när listan står i topp och fingret går NEDÅT, annars äger rullningen
     * gesten. Det är regeln som gör att man kan rulla i listan utan att arket
     * åker ned under fingret.
     */
    let dragFran = 0;
    let dragStart = 0;
    let drar = false;
    let dragTid = 0;
    /** Vilken yta som startade den pågående dragningen. */
    let franGreppNu = false;

    function borjaDrag(ev: PointerEvent, franGrepp: boolean) {
      if (!arkAktivt || ev.button !== 0) return;
      if (!franGrepp && (lage !== 'hog' || arkInne.scrollTop > 0)) return;
      drar = true;
      dragFran = ev.clientY;
      dragStart = nedskjut(lage);
      dragTid = ev.timeStamp;
      ark.style.transition = 'none';
      /*
       * Kastar NotFoundError om pekaren redan släppts, till exempel när ett
       * samtal tar över skärmen mellan pointerdown och den här raden. Utan
       * try hade hela hanteraren avbrutits och arket fastnat mitt i en
       * dragning som aldrig kan avslutas.
       */
      try {
        (ev.currentTarget as HTMLElement).setPointerCapture(ev.pointerId);
      } catch {
        /* Utan fångad pekare fungerar dragningen ändå, den tappas bara om
           fingret glider utanför remsan. */
      }
    }

    function underDrag(ev: PointerEvent) {
      if (!drar) return;
      const delta = ev.clientY - dragFran;
      if (!franGreppNu && delta < 0) {
        // Uppåt från listans topp är en rullning, inte en dragning.
        drar = false;
        ark.style.transform = `translateY(${dragStart}px)`;
        return;
      }
      ev.preventDefault();
      /*
       * Gummiband uppåt. Över det högsta läget blir varje pixel en fjärdedel,
       * så arket känns fjädrat i stället för dött mot ett tak.
       */
      const min = nedskjut('hog');
      const max = nedskjut('remsa');
      let y = dragStart + delta;
      if (y < min) y = min - (min - y) / 4;
      if (y > max) y = max + (y - max) / 4;
      ark.style.transform = `translateY(${y}px)`;
    }

    function slutaDrag(ev: PointerEvent) {
      if (!drar) return;
      drar = false;

      const delta = ev.clientY - dragFran;
      const tid = Math.max(1, ev.timeStamp - dragTid);
      const fart = delta / tid;

      /*
       * En snabb flick hoppar ett steg åt sitt håll, oavsett hur långt
       * fingret hann. Under den farten avgör var arket SLÄPPTES, alltså
       * närmaste läge. Tröskeln är mätt på känsla mot iOS egna ark: 0,5 px per
       * millisekund är ungefär den rörelse man gör när man menar "iväg".
       */
      const nu = ORDNING.indexOf(lage);
      if (Math.abs(fart) > 0.5) {
        stallArk(ORDNING[Math.min(ORDNING.length - 1, Math.max(0, nu + (fart > 0 ? -1 : 1)))]);
        return;
      }

      const y = dragStart + delta;
      let bast: Lage = lage;
      let minsta = Infinity;
      for (const l of ORDNING) {
        const d = Math.abs(nedskjut(l) - y);
        if (d < minsta) {
          minsta = d;
          bast = l;
        }
      }
      stallArk(bast);
    }

    handtag.addEventListener('pointerdown', (ev) => {
      franGreppNu = true;
      borjaDrag(ev, true);
    });
    arkInne.addEventListener('pointerdown', (ev) => {
      franGreppNu = false;
      borjaDrag(ev, false);
    });

    for (const yta of [handtag, arkInne]) {
      yta.addEventListener('pointermove', underDrag);
      yta.addEventListener('pointerup', slutaDrag);
      yta.addEventListener('pointercancel', slutaDrag);
    }

    arkInne.addEventListener('scroll', foljRullning, { passive: true });

    /*
     * Ett tryck på remsan utan dragning stegar uppåt, och från det högsta
     * läget hela vägen ned. Klicket kommer efter pointerup, så en avslutad
     * dragning får inte också räknas som ett tryck.
     */
    let dragLangd = 0;
    handtag.addEventListener('pointerdown', (ev) => (dragLangd = ev.clientY));
    handtag.addEventListener('click', (ev) => {
      if (!arkAktivt) return;
      if (Math.abs((ev as PointerEvent).clientY - dragLangd) > 6) return;
      stallArk(lage === 'hog' ? 'remsa' : lage === 'halv' ? 'hog' : 'halv');
    });

    smal.addEventListener('change', stallInArk);
    window.addEventListener('resize', matArk);
    window.visualViewport?.addEventListener('resize', matArk);
    stallInArk();

    // ── Kartan ───────────────────────────────────────────────────────────


    /** Droppens proportion är 100×132. Vid pixelRatio 2 blir nålen 36×47
     *  CSS-pixlar, alltså i nivå med märket i listan. */
    const PIN_W = 72;
    const PIN_H = 95;

    /**
     * Den valda nålens höjd på skärmen i CSS-pixlar, alltså hur högt över
     * koordinaten kortet måste börja.
     *
     * Bitmappen är PIN_H hög och läggs in med pixelRatio 2, vilket ger PIN_H
     * genom 2 CSS-pixlar vid icon-size 1. Den valda nålen ritas av lagret
     * `nal-lyft` med icon-size 0.74. Spetsen ligger på koordinaten, så hela
     * höjden ligger ovanför punkten.
     *
     * Konstanten MÅSTE stå efter PIN_H. Den låg först uppe hos placeraKort,
     * och eftersom den beräknas när skriptet initieras kastade den ett
     * ReferenceError på PIN_H innan kartan hann starta: inga kontroller, ingen
     * stil hämtad, ingen rad i konsolen som pekade ut orsaken.
     */
    const NAL_H = (PIN_H / 2) * 0.74;

    function faceBitmap(key: FaceKey): Promise<ImageData> {
      return new Promise((resolve, reject) => {
        const img = new Image(PIN_W, PIN_H);
        img.onload = () => {
          const c = document.createElement('canvas');
          c.width = PIN_W;
          c.height = PIN_H;
          const ctx = c.getContext('2d');
          if (!ctx) return reject(new Error('ingen 2d-kontext'));
          ctx.drawImage(img, 0, 0, PIN_W, PIN_H);
          resolve(ctx.getImageData(0, 0, PIN_W, PIN_H));
        };
        img.onerror = () => reject(new Error('kunde inte rita ' + key));
        img.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(faceSvg(key))}`;
      });
    }

    // ── Positionen i adressens fragment ──────────────────────────────────

    /**
     * `#map=<zoom>/<lat>/<lng>`, satt av platsknappen i sökpanelen.
     *
     * FRAGMENT och inte frågesträng, och det är ett integritetsbeslut och
     * inte en formsak: enligt HTTP skickas fragmentet aldrig med i en
     * begäran, så besökarens position lämnar aldrig enheten. Den är dessutom
     * avrundad till tre decimaler, ungefär 110 meter, vilket är den siffra
     * integritetspolicyn anger. Skriver kartan någon gång själv tillbaka till
     * fragmentet MÅSTE den avrundningen behållas.
     *
     * Talformatet är OpenStreetMaps, alltså zoom före latitud före longitud,
     * så att kontraktet syns i adressen utan att någon behöver slå upp det.
     */
    interface Vy {
      zoom: number;
      lat: number;
      lng: number;
    }

    function lasFragment(): Vy | null {
      const m = /^#map=([\d.]+)\/(-?[\d.]+)\/(-?[\d.]+)$/.exec(location.hash);
      if (!m) return null;
      const zoom = Number(m[1]);
      const lat = Number(m[2]);
      const lng = Number(m[3]);
      /*
       * Grinden mot skräp i adressen. Fragmentet kan skrivas av vem som helst,
       * och en NaN-koordinat lägger MapLibre i ett läge det inte kommer ur:
       * kartan blir svart och ingenting säger varför.
       */
      if (!Number.isFinite(zoom) || !Number.isFinite(lat) || !Number.isFinite(lng)) return null;
      if (zoom < 1 || zoom > 20 || lat < -90 || lat > 90 || lng < -180 || lng > 180) return null;
      return { zoom, lat, lng };
    }

    /**
     * "Du är här".
     *
     * En ring på koordinaten, inte en nål med ansikte: nålarna betyder
     * verksamhet och bedömning, och en av dem på besökarens egen position
     * hade läst som att det ligger en restaurang precis där. Ringen är
     * dessutom kartkonventionen för egen position, samma tecken som varje
     * telefonkarta använder.
     *
     * Punkten läggs i en egen källa och inte i verksamheternas, av den enkla
     * anledningen att den inte är en verksamhet: den ska inte klustras, inte
     * räknas i listan och inte gå att söka fram.
     */
    function satHar(vy: Vy) {
      if (!karta || !karta.isStyleLoaded()) return;
      const data = {
        type: 'FeatureCollection' as const,
        features: [
          {
            type: 'Feature' as const,
            properties: {},
            geometry: { type: 'Point' as const, coordinates: [vy.lng, vy.lat] },
          },
        ],
      };

      const kalla = karta.getSource('har');
      if (kalla) {
        kalla.setData(data);
        return;
      }

      karta.addSource('har', { type: 'geojson', data });
      karta.addLayer({
        id: 'har-ring',
        type: 'circle',
        source: 'har',
        paint: {
          // Ytan är svag och ringen tydlig: cirkeln säger "ungefär här", och
          // ungefär är sant, eftersom koordinaten är avrundad till 110 meter.
          'circle-radius': 9,
          'circle-color': '#007BE0',
          'circle-opacity': 0.25,
          'circle-stroke-width': 3,
          'circle-stroke-color': '#007BE0',
        },
      });
    }

    /**
     * Fragmentet ändras utan att sidan laddas om.
     *
     * Det är inte ett kantfall utan huvudfallet: står besökaren REDAN på sin
     * kommuns kartsida och trycker på platsraden i sökpanelen byts bara
     * fragmentet, ingen navigering sker, och `hashchange` är den enda signal
     * som finns. Utan den här lyssnaren händer ingenting alls vid det trycket.
     */
    window.addEventListener('hashchange', () => {
      const vy = lasFragment();
      if (!vy || !karta) return;
      karta.easeTo({
        center: [vy.lng, vy.lat],
        zoom: vy.zoom,
        duration: reducerad ? 0 : 600,
      });
      satHar(vy);
      // På telefon ligger arket över halva kartan. Dras det ned till remsan
      // ser man platsen man just bad om i stället för listan.
      if (arkAktivt && lage !== 'remsa') stallArk('remsa');
    });

    /** Stilmallen läggs in som <link> och inte som import, av samma skäl som
     *  koden: adressen ska vara densamma i dev och i bygget. */
    function laddaCss() {
      if (document.querySelector(`link[href="${MAPLIBRE_CSS}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = MAPLIBRE_CSS;
      document.head.appendChild(link);
    }

    async function start() {
      laddaCss();

      /*
       * Två moduler, hämtade på olika sätt, och skillnaden är inte godtycklig.
       *
       * MapLibre kommer från /maplibre/ som statiska filer, av skälet överst i
       * filen: den startar en vektorarbetare med en adress relativ sig själv,
       * och paketeras den blir arbetaren 404 utan att något syns.
       *
       * `pmtiles` går genom paketeraren som vanligt. Den startar ingen
       * arbetare, den är 18 kB minifierad, och den behövs bara här. Den lär
       * MapLibre att läsa `pmtiles://`-adresser med räckviddsförfrågningar in i
       * arkivet, alltså att hämta de rutor utsnittet kräver i stället för hela
       * filen.
       */
      const [maplibre, pmtiles] = await Promise.all([
        import(/* @vite-ignore */ MAPLIBRE_URL),
        import('pmtiles'),
      ]);

      /* Protokollet registreras en gång per sida. Kommunhubbens puff och den
         här kartan kan båda ligga på samma dokument, och MapLibre kastar om
         samma namn registreras två gånger. */
      if (!(window as any).__prikkoPmtiles) {
        maplibre.addProtocol('pmtiles', new pmtiles.Protocol().tile);
        (window as any).__prikkoPmtiles = true;
      }

      /*
       * `Map` byter namn här, och det är ingen stilfråga.
       *
       * MapLibres klass heter Map, precis som JavaScripts inbyggda. Plockas
       * den ut med sitt eget namn SKUGGAR den den inbyggda i hela den här
       * funktionen, alltså även i allt som skrivs inuti kartans load-hanterare
       * längre ned. Där finns `new Map()` för grupperingen av adresser, och
       * den raden byggde då en andra kartinstans utan argument i stället för
       * en uppslagstabell. Felet blev "Cannot read properties of undefined
       * (reading 'canvasContextAttributes')" kastat inuti en async-hanterare,
       * alltså en obehandlad promise: kartbladen ritades, kontrollerna satt
       * där, och INGA nålar eller kluster lades in, utan en rad som pekade ut
       * varför.
       */
      const {
        Map: MapLibreKarta,
        NavigationControl,
        AttributionControl,
        FullscreenControl,
      } = maplibre;
      const [w, s, e, n] = root!.dataset.bounds!.split(',').map(Number);

      /*
       * Utgångsläget: fragmentets position när det finns, annars kommunens
       * utsträckning. Talen sätts som center och zoom och INTE genom en
       * easeTo efter start, eftersom en kamera som först visar hela kommunen
       * och sedan flyger till kvarteret är en halv sekunds förvirring för
       * ingenting. Den som klickat på platsraden har bett om sitt kvarter.
       */
      const startVy = lasFragment();

      karta = new MapLibreKarta({
        container: duk,
        /*
         * Vår egen stil, byggd av scripts/kartstil.mjs och utlagd som statisk
         * fil. Skälen står i skriptet: positron är CARTO:s och grå rakt
         * igenom, liberty och bright är för mättade för att nålarna ska synas.
         * Vår version är liberty med nedskruvad mättnad i landskapet och
         * uppskruvad kontrast i vägnätet.
         *
         * Att den ligger hos oss betyder också att kartans utseende inte kan
         * ändras av någon annan mellan två besök.
         */
        style: '/kartstil/prikko.json',
        ...(startVy
          ? { center: [startVy.lng, startVy.lat] as [number, number], zoom: startVy.zoom }
          : { bounds: [w, s, e, n] as [number, number, number, number], fitBoundsOptions: { padding: 32 } }),
        attributionControl: false,
      });

      /*
       * Helskärm på ramen, inte på dokumentet.
       *
       * `container: kartram` gör att det är kartrutan som fylls ut, alltså
       * följer nålkortet och felmeddelandet med in i helskärmsläget. Fylldes
       * duken ensam skulle kortet ligga kvar bakom helskärmslagret och vara
       * osynligt så länge läget var på.
       */
      karta.addControl(new FullscreenControl({ container: kartram }), 'top-right');
      karta.addControl(new NavigationControl({ showCompass: false }), 'top-right');
      karta.addControl(new AttributionControl({ compact: false }), 'bottom-right');

      karta.on('load', async () => {
        let ansikten = true;
        try {
          const bitmaps = await Promise.all(FACE_KEYS.map(faceBitmap));
          FACE_KEYS.forEach((key, i) => {
            if (!karta.hasImage('face-' + key)) {
              karta.addImage('face-' + key, bitmaps[i], { pixelRatio: 2 });
            }
          });
        } catch {
          ansikten = false;
        }

        /*
         * Källan är en VEKTORRUTEKÄLLA, inte GeoJSON.
         *
         * Här låg tidigare hela kommunen som ett GeoJSON-objekt med
         * `cluster: true`, alltså supercluster i MapLibres arbetare. Klustringen
         * finns kvar och ser likadan ut, men den är körd EN gång vid bygget i
         * stället för i varje besökares webbläsare. Se lib/kartrutor.ts, där de
         * tre talen 38, 5 och 13 står kvar ordagrant.
         *
         * VAD SOM FÖLJDE MED BYTET, och som nästa läsare annars kommer att
         * undra över: `getClusterExpansionZoom()` och `getClusterLeaves()` finns
         * bara på en GeoJSON-källa. `delaKluster()` längre ned byggde hela sitt
         * beteende på dem, och de var dessutom asynkrona, alltså en väntan mitt
         * i ett klick. Svaren är nu INBAKADE i bubblan av bygget:
         *
         *     ez   expansionszoomen, det minsta steg som delar bubblan
         *     bx   lövens utbredning som "väst,syd,öst,nord"
         *
         * Klustringen tog alltså inte vägen någonstans. Den flyttade till
         * lib/kartrutor.ts, och frågorna man förut ställde till källan besvaras
         * numera av rutan man redan har.
         *
         * `n` och `h` bakas in på samma sätt. `h` är ett på den enda nål i en
         * stapel som ska bära antalsbrickan, `n` är hur många adressen rymmer.
         * Förut räknades de om i klienten vid varje filterändring, ur hela
         * kommunens punktlista; den listan finns inte längre.
         */
        karta.addSource('verksamheter', {
          type: 'vector',
          url: 'pmtiles://' + root!.dataset.url!,
        });

        /*
         * Klustret är en blå cirkel med vit siffra. Blått är ägarens beslut,
         * uttalat efter att en vit variant provats: pricken ska vara blå.
         * Det som INTE ska finnas är den genomskinliga glorian runt kärnan,
         * som lästes som en ful pulsring. I stället ligger en mjuk skugga
         * under cirkeln, så att den ligger PÅ kartan i stället för att vara
         * målad i den. En circle-layer kan inte rita skugga, så en något
         * större cirkel i svag svärta en pixel under gör det jobbet.
         *
         * Klustret bär ANTAL, aldrig bedömning: ett kluster färgat efter
         * andelen anmärkningar är en värmekarta över vilka kvarter som sköter
         * sig sämst, alltså den rangordning sajten aldrig publicerar.
         */
        const KLUSTER_R = ['step', ['get', 'point_count'], 13, 25, 15, 100, 18, 500, 22] as any;

        karta.addLayer({
          id: 'kluster-skugga',
          type: 'circle',
          source: 'verksamheter',
          'source-layer': 'punkter',
          filter: ['has', 'point_count'],
          paint: {
            'circle-color': '#000',
            'circle-opacity': 0.14,
            'circle-blur': 0.9,
            'circle-translate': [0, 2],
            'circle-radius': ['step', ['get', 'point_count'], 15, 25, 17, 100, 20, 500, 24],
          },
        });

        karta.addLayer({
          id: 'kluster',
          type: 'circle',
          source: 'verksamheter',
          'source-layer': 'punkter',
          filter: ['has', 'point_count'],
          paint: {
            'circle-color': '#007BE0',
            'circle-opacity': 1,
            'circle-stroke-width': 1.5,
            'circle-stroke-color': '#fff',
            'circle-radius': KLUSTER_R,
            /*
             * Övergångarna är skillnaden mellan en karta som känns billig och
             * en som känns dyr. Utan dem byter ett kluster storlek i ETT hopp
             * när man zoomar och antalet i det ändras.
             *
             * Det som INTE går att göra på det här sättet är att låta ett
             * kluster som delar sig glida isär till sina delar: klustren är
             * nya features efter varje omindexering, och en övergång kan bara
             * tona mellan två värden på samma feature. Verklig uppdelning
             * kräver egna markörer som interpoleras för hand. Det är ett eget
             * arbete, och det står i rapporten.
             */
            'circle-radius-transition': { duration: reducerad ? 0 : 250 },
            'circle-opacity-transition': { duration: reducerad ? 0 : 250 },
          },
        });

        karta.addLayer({
          id: 'kluster-antal',
          type: 'symbol',
          source: 'verksamheter',
          'source-layer': 'punkter',
          filter: ['has', 'point_count'],
          layout: {
            'text-field': ['get', 'point_count_abbreviated'],
            /*
             * Fet, inte normal. Vit text i normalvikt på en mättad blå yta
             * blir tunn och grumlig, för antialiaseringen äter av de smala
             * dragen. Ägaren såg det direkt.
             *
             * Stilens egna kakelfonter, INTE Instrument Sans: en font som
             * saknas i glyfkällan gör att etiketten uteblir helt i stället för
             * att falla tillbaka. OpenFreeMap levererar Noto Sans Regular och
             * Bold men inte Medium, kontrollerat mot glyfslutpunkten.
             */
            'text-font': ['Noto Sans Bold'],
            'text-size': ['step', ['get', 'point_count'], 12, 100, 13, 500, 14],
            'text-allow-overlap': true,
            'text-ignore-placement': true,
          },
          paint: { 'text-color': '#fff' },
        });

        karta.addLayer(
          ansikten
            ? {
                id: 'nalar',
                type: 'symbol',
                source: 'verksamheter',
                'source-layer': 'punkter',
                filter: ['!', ['has', 'point_count']],
                layout: {
                  'icon-image': ['match', ['get', 'v'], 0, 'face-clean', 1, 'face-minor', 2, 'face-major', 'face-none'],
                  'icon-size': 0.5,
                  'icon-allow-overlap': true,
                  // Droppens spets ligger på adressen, inte märkets mitt.
                  'icon-anchor': 'bottom',
                },
              }
            : {
                id: 'nalar',
                type: 'circle',
                source: 'verksamheter',
                'source-layer': 'punkter',
                filter: ['!', ['has', 'point_count']],
                paint: {
                  'circle-radius': 7,
                  'circle-stroke-width': 2,
                  'circle-stroke-color': '#fff',
                  'circle-color': ['match', ['get', 'v'], 0, COLOR[0], 1, COLOR[1], 2, COLOR[2], COLOR[3]],
                },
              },
        );

        /*
         * Den lyfta nålen ligger i ETT EGET LAGER, inte i en feature-state på
         * det vanliga.
         *
         * Feature-state hade varit den självklara lösningen och är fel:
         * MapLibre tillåter `['feature-state', …]` i PAINT-egenskaper, och
         * `icon-size` är en LAYOUT-egenskap. En symbol kan alltså inte växa på
         * feature-state, hur rimligt det än ser ut i koden.
         *
         * Ett eget lager med ett filter på radnumret gör samma sak med medel
         * som finns. `setFilter` rör bara det lagret, som innehåller noll
         * eller en nål, så det kostar ingenting per bild.
         */
        /*
         * Antalsbrickan: en liten blå cirkel med vit siffra i nålens övre
         * högra hörn, för adresser där mer än en verksamhet ligger.
         *
         * Formen är Hemnets, mätt i deras karta: en upphöjd liten ring vid
         * märket, inte en siffra i märket och inte en utfälld ring av nålar.
         * Färgen är klustrets blå, och det är avsiktligt. En blå ring med en
         * siffra betyder samma sak överallt på kartan: här ligger fler än en,
         * klicka så kommer du åt dem. Att klustret och stapeln talar samma
         * språk är hela skillnaden mot att lära sig två tecken.
         *
         * Talen: nålen är PIN_H/2 gånger icon-size hög över koordinaten och
         * PIN_W/2 gånger icon-size bred, alltså 24 x 18 CSS-pixlar vid
         * icon-size 0,5. Brickan läggs vid dess övre högra hörn.
         */
        const BRICKA = ['all', ['!', ['has', 'point_count']], ['==', ['get', 'h'], 1], ['>', ['get', 'n'], 1]] as any;
        const BRICKA_FLYTT: [number, number] = [8, -20];

        karta.addLayer({
          id: 'stapel-ring',
          type: 'circle',
          source: 'verksamheter',
          'source-layer': 'punkter',
          filter: BRICKA,
          paint: {
            'circle-color': '#007BE0',
            'circle-radius': 8,
            'circle-stroke-width': 1.5,
            'circle-stroke-color': '#fff',
            'circle-translate': BRICKA_FLYTT,
          },
        });

        karta.addLayer({
          id: 'stapel-antal',
          type: 'symbol',
          source: 'verksamheter',
          'source-layer': 'punkter',
          filter: BRICKA,
          layout: {
            'text-field': ['to-string', ['get', 'n']],
            // Noto Sans Bold av samma skäl som klustersiffran: stilens egna
            // kakelfonter, och vit normalvikt på mättat blått blir grumligt.
            'text-font': ['Noto Sans Bold'],
            'text-size': 10,
            'text-allow-overlap': true,
            'text-ignore-placement': true,
          },
          paint: { 'text-color': '#fff', 'text-translate': BRICKA_FLYTT },
        });

        karta.addLayer({
          id: 'nal-lyft',
          type: 'symbol',
          source: 'verksamheter',
          'source-layer': 'punkter',
          filter: ['==', ['get', 'i'], -1],
          layout: {
            'icon-image': ['match', ['get', 'v'], 0, 'face-clean', 1, 'face-minor', 2, 'face-major', 'face-none'],
            'icon-size': 0.74,
            'icon-allow-overlap': true,
            'icon-ignore-placement': true,
            'icon-anchor': 'bottom',
          },
        });

        /*
         * Listan speglar utsnittet.
         *
         * `move` och inte bara `moveend`: hela poängen med att ha punkterna
         * lokalt är att listan följer med medan man drar i stället för att komma
         * efter. Det gäller fortfarande, men "lokalt" betyder numera de rutor
         * som hunnit landa.
         *
         * Därför lyssnar den också på `sourcedata`. En panorering kan hinna
         * sluta innan rutan under den nya kanten kommit, och utan den signalen
         * hade listan stått kvar och saknat de verksamheter som just ritats ut
         * på kartan bredvid.
         */
        function uppdatera() {
          const b = karta.getBounds();
          const punkter = punktKalla();

          /*
           * Träffarna räknas om mot den NYA mängden, inte mot den gamla.
           *
           * Förut låg hela kommunen i minnet, så en sökning kunde räknas en gång
           * och gälla resten av besöket. Nu byts mängden varje gång en ruta
           * landar, och ett radnummer som inte fanns när man skrev bokstaven
           * hade annars aldrig kunnat bli en träff: man drar kartan västerut,
           * nya nålar dyker upp, och ingen av dem matchar det man skrivit.
           */
          if (traffar !== null) {
            const tokens = normalisera(filterFalt.value).split(' ').filter(Boolean);
            if (tokens.length > 0) traffar = raknaTraffar(tokens);
            filtreraNalar();
          }

          const synliga = punkter.filter(
            (p) =>
              (traffar === null || traffar.has(p.i)) &&
              p.lng >= b.getWest() && p.lng <= b.getEast() && p.lat >= b.getSouth() && p.lat <= b.getNorth(),
          );
          synliga.sort((a, z) => a.namn.localeCompare(z.namn, 'sv'));
          ritaLista(synliga, synliga.length, traffar === null ? iBubblor(b) : 0);
        }

        /**
         * Hur många verksamheter i utsnittet som ligger inne i en bubbla.
         *
         * Rubriken sa förut hur många punkter listan hade, och det stämde,
         * eftersom hela kommunen låg i minnet och varenda punkt var en rad.
         * Med rutor är det inte längre sant: på kommunens öppningszoom är
         * nästan allt sammanslaget till bubblor, och nålarna som ligger lösa är
         * ett femtontal. En rubrik som sa "15 verksamheter" över ett Stockholm
         * med 8 499 hade varit fel, inte bara mindre användbar.
         *
         * Talet räknas därför ur bubblornas egna summor. Avdubbleringen på läge
         * och antal är nödvändig av samma skäl som för nålarna: rutorna har en
         * kantbuffert, så en bubbla nära en rutgräns ligger i två rutor.
         */
        function iBubblor(b: any): number {
          const sedda = new Set<string>();
          let summa = 0;
          for (const f of karta.querySourceFeatures('verksamheter', {
            sourceLayer: 'punkter',
            filter: ['has', 'point_count'],
          })) {
            const [lng, lat] = f.geometry.coordinates;
            if (lng < b.getWest() || lng > b.getEast() || lat < b.getSouth() || lat > b.getNorth()) continue;
            const nyckel = lng.toFixed(5) + ':' + lat.toFixed(5) + ':' + f.properties.point_count;
            if (sedda.has(nyckel)) continue;
            sedda.add(nyckel);
            summa += f.properties.point_count;
          }
          return summa;
        }

        karta.on('move', () => {
          version += 1;
          uppdatera();
        });

        karta.on('sourcedata', (ev: any) => {
          if (ev.sourceId !== 'verksamheter' || !ev.isSourceLoaded) return;
          version += 1;
          uppdatera();
        });

        uppdatera();

        // ── Filtret mot kartan ───────────────────────────────────────────

        /*
         * Filtret gäller det man KAN SE, och det är inte en försämring utan vad
         * fältets egen etikett alltid har lovat.
         *
         * Förut låg hela kommunen i minnet och filtret sökte igenom den. Med en
         * rikskarta finns ingen sådan mängd: 90 000 punkter skickas inte till en
         * telefon, och det var hela skälet till rutorna. Fältet filtrerar därför
         * listan och nålarna i utsnittet. Den som vill söka i hela landet gör
         * det i sidhuvudets sökfält, som har hela registret.
         *
         * Lagret `nalar` filtreras med ett uttryck på radnumret. `match` med en
         * literal lista, inte `in`: match kompileras till ett uppslag och kostar
         * konstant per nål, medan in söker listan linjärt och hade gjort varje
         * tangent dyrare ju fler träffar filtret har.
         *
         * KLUSTREN GÖMS medan ett filter är på, och det är ett medvetet val.
         * Bubblorna är räknade vid bygget och kan inte räknas om i webbläsaren;
         * en bubbla som säger 300 bredvid en lista med fyra träffar påstår något
         * som inte stämmer. Att gömma dem säger i stället sanningen: det här är
         * vad som matchar, zooma in för att se mer.
         *
         * `nal-lyft` behöver inget eget uttryck: lyftet pekar alltid på en rad
         * eller nål man just rör vid, och de är filtrerade redan. Det som
         * däremot måste städas är en hovring eller ett öppet kort vars punkt
         * filtreras bort, annars står kortet kvar och pekar på ingenting.
         */
        const KLUSTERLAGER = ['kluster-skugga', 'kluster', 'kluster-antal'];

        function filtreraNalar() {
          const bas = ['!', ['has', 'point_count']];
          karta.setFilter(
            'nalar',
            traffar === null
              ? bas
              : traffar.size === 0
                ? ['boolean', false]
                : ['all', bas, ['match', ['get', 'i'], [...traffar], true, false]],
          );

          for (const lager of KLUSTERLAGER) {
            karta.setLayoutProperty(lager, 'visibility', traffar === null ? 'visible' : 'none');
          }

          /* Brickan säger hur många som FINNS på adressen och inte hur många
             sökningen träffar. Med ett filter på blir den därför missvisande
             och göms, av samma skäl som bubblorna. */
          for (const lager of ['stapel-ring', 'stapel-antal']) {
            karta.setLayoutProperty(lager, 'visibility', traffar === null ? 'visible' : 'none');
          }
        }

        function tillampaFilter() {
          const tokens = normalisera(filterFalt.value).split(' ').filter(Boolean);
          filterVarde = filterFalt.value.trim();
          traffar = tokens.length === 0 ? null : raknaTraffar(tokens);

          if (traffar !== null) {
            if (hovrad !== null && !traffar.has(hovrad)) satHovrad(null);
            if (valdPunkt && !traffar.has(valdPunkt.i)) stangKort();
          }

          filtreraNalar();
          uppdatera();
        }

        tillampa = tillampaFilter;
        // Hann någon skriva innan kartan vaknade plockas värdet upp här.
        if (filterFalt.value) tillampaFilter();

        // Kortet är limmat vid sin nål och följer med när kartan rör sig, i
        // stället för att stå still medan nålen glider iväg under det.
        karta.on('move', placeraKort);
        window.addEventListener('resize', placeraKort);

        /*
         * ── Klustret delar sig ───────────────────────────────────────────
         *
         * Här stod tidigare `getClusterExpansionZoom` och `getClusterLeaves`,
         * två ASYNKRONA anrop mot GeoJSON-källan, alltså en väntan mitt i ett
         * klick. Ingen av dem finns på en vektorrutekälla.
         *
         * DE ÄR INTE BORTA. Svaren räknas fram vid bygget av lib/kartrutor.ts,
         * som kör samma supercluster mot samma tre tal, och bakas in i bubblan:
         *
         *     ez   expansionszoomen, alltså den zoom där bubblan slutar slås
         *          ihop. Det minsta steg som gör något alls.
         *     bx   lövens utbredning som "väst,syd,öst,nord".
         *
         * Funktionen är därmed synkron och gör exakt vad den gjorde förut.
         *
         * Varför utbredningen och inte bara expansionszoomen: klickar man på en
         * bubbla med 300 i ger expansionszoomen ofta fyra bubblor med 75 i, och
         * man får klicka fem gånger till för att komma åt en verksamhet. Läggs
         * kameran på LÖVENS utbredning delar sig bubblan hela vägen ned till
         * nålar i ett svep när det går, och till några få bubblor när
         * utbredningen är en hel stadsdel. `Math.max` mot expansionszoomen är
         * garantin: en utbredning som råkar rymmas i rutan vid nuvarande zoom
         * får ändå det steg som krävs för att bubblan ska släppa.
         *
         * Ligger löven på SAMMA ADRESS finns ingen zoom som delar dem. Det är
         * Sturegallerian, och grinden som gör att en bubbla aldrig kan bli en
         * återvändsgränd. Kameran flyger då in till den zoom där nålarna finns
         * och stapelkortet öppnas när rutan landat. Löven själva finns inte
         * längre att öppna kortet direkt ur, eftersom bubblan bara bär sin
         * utbredning och inte sina medlemmar.
         */
        const STAPELZOOM = 18;

        function delaKluster(f: any) {
          const bx = String(f.properties.bx ?? '').split(',').map(Number);
          const expansion = Number(f.properties.ez);

          if (bx.length !== 4 || bx.some((v) => !Number.isFinite(v))) {
            // Ska inte kunna hända: kartrutegrinden i bygget kräver båda
            // fälten på varje bubbla. Ett zoomsteg är ändå rätt svar, inte ett
            // fel i konsolen.
            karta.easeTo({ center: f.geometry.coordinates, zoom: karta.getZoom() + 2, duration: reducerad ? 0 : 400 });
            return;
          }

          const [vast, syd, ost, nord] = bx;

          if (ost - vast < SAMMA_PLATS && nord - syd < SAMMA_PLATS) {
            oppnaStapel(f.geometry.coordinates);
            return;
          }

          /*
           * cameraForBounds räknar på ramens verkliga mått, alltså tar den
           * hänsyn till att kartan är halva sidan på skrivbordet och hela
           * skärmen bakom arket på telefon. Paddingen hålls under en fjärdedel
           * av den kortaste sidan; större padding än så ger ett negativt
           * utrymme och en kamera som hoppar bakåt.
           */
          const luft = Math.min(56, Math.floor(Math.min(kartram.clientWidth, kartram.clientHeight) / 4));
          const kamera = karta.cameraForBounds([[vast, syd], [ost, nord]], { padding: luft });

          karta.easeTo({
            center: kamera ? kamera.center : f.geometry.coordinates,
            zoom: Math.max(kamera ? kamera.zoom : 0, Number.isFinite(expansion) ? expansion : 0),
            duration: reducerad ? 0 : 500,
          });
        }

        /**
         * En bubbla vars verksamheter alla ligger på samma adress.
         *
         * Kameran går in till den zoom där nålarna finns, och när rutan landat
         * öppnas stapelkortet på den punkt som ligger närmast mitten. `once`
         * och inte en vanlig lyssnare: den ska svara på DEN här inflygningen
         * och inte på varje gång kartan blir stilla efteråt.
         */
        function oppnaStapel(center: [number, number]) {
          karta.easeTo({ center, zoom: STAPELZOOM, duration: reducerad ? 0 : 500 });
          karta.once('idle', () => {
            version += 1;
            let bast: Punkt | null = null;
            let kortast = Infinity;
            for (const p of punktKalla()) {
              const d = (p.lng - center[0]) ** 2 + (p.lat - center[1]) ** 2;
              if (d < kortast) {
                kortast = d;
                bast = p;
              }
            }
            if (!bast) return;
            const lista = gruppFor(bast);
            visaKort(lista[0], lista.length > 1 ? lista : null);
          });
        }

        karta.on('click', 'kluster', (ev: any) => {
          const f = karta.queryRenderedFeatures(ev.point, { layers: ['kluster'] })[0];
          if (f) delaKluster(f);
        });

        /*
         * Klick på en nål, eller på dess antalsbricka. Ligger flera
         * verksamheter på adressen öppnas kortet med hela gruppen och en
         * bläddring i foten; ligger den ensam blir det ett vanligt kort.
         */
        function valjNal(i: number) {
          const p = punktMed(i);
          if (!p) return;
          const lista = gruppFor(p);
          visaKort(lista.length > 1 ? lista[0] : p, lista.length > 1 ? lista : null);
        }

        karta.on('click', 'nalar', (ev: any) => {
          const f = ev.features?.[0];
          if (f) valjNal(f.properties.i);
        });

        // Brickan är en egen liten yta bredvid nålen och måste kunna träffas
        // för sig. Utan det är den en skylt man inte kan peka på.
        for (const lager of ['stapel-ring', 'stapel-antal']) {
          karta.on('click', lager, (ev: any) => {
            const f = ev.features?.[0];
            if (f) valjNal(f.properties.i);
          });
        }

        // Klick vid sidan av en nål stänger kortet, som hos Airbnb. Brickan
        // räknas som en del av nålen och får därför inte stänga.
        karta.on('click', (ev: any) => {
          const träff = karta.queryRenderedFeatures(ev.point, {
            layers: ['nalar', 'kluster', 'stapel-ring', 'stapel-antal'],
          });
          if (träff.length === 0) stangKort();
        });

        for (const lager of ['kluster', 'nalar', 'stapel-ring', 'stapel-antal']) {
          karta.on('mouseenter', lager, () => (karta.getCanvas().style.cursor = 'pointer'));
          karta.on('mouseleave', lager, () => (karta.getCanvas().style.cursor = ''));
        }

        // Nål → rad. Andra halvan av samspelet: raden markeras och rullas fram
        // så att den syns, precis som hos Airbnb.
        karta.on('mousemove', 'nalar', (ev: any) => {
          const f = ev.features?.[0];
          if (!f) return;
          satHovrad(f.properties.i);
          const li = rader.querySelector(`li[data-i="${f.properties.i}"]`);
          // `nearest` och inte `center`: raden ska bara fram i vyn, inte rycka
          // listan till mitten varje gång musen råkar passera en nål.
          if (li) li.scrollIntoView({ block: 'nearest', behavior: reducerad ? 'auto' : 'smooth' });
        });

        karta.on('mouseleave', 'nalar', () => satHovrad(null));

        // "Du är här" kan inte läggas in förrän stilen finns, så den sätts
        // här och inte vid konstruktionen.
        if (startVy) satHar(startVy);

        karta.getCanvas().setAttribute('aria-label', `Karta över hygienkontroller i ${root!.dataset.city}`);
        root!.classList.add('live');
      });
    }

    start().catch((error) => {
      console.error(error);
      fel.hidden = false;
    });
  }
</script>

<style>
  /* ── Delad vy ─────────────────────────────────────────────────────────── */

  .split {
    display: grid;
    /* Kartan får något mer än halva bredden. Listan är text och blir svårläst
