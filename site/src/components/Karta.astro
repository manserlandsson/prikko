      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    /* Rubriken står kvar i remsläget och är det enda man ser av arket då, så
       den bär hela beskedet om vad som ligger under. */
    .split.ark .listhuvud { margin-bottom: var(--s-3); }

    /*
     * 16 px, inte --fs-body-s.
     *
     * iOS Safari zoomar in hela sidan när ett fält med mindre text än 16 px
     * får fokus, och zoomen går inte tillbaka av sig själv. På en app-yta med
     * ett ark blir det obrukbart. Golvet gäller alla fält på smal skärm och är
     * inte förhandlingsbart.
     */
    .split.ark .filterfalt input { font-size: 16px; }

    /* ── Nålens kort på telefon ─────────────────────────────────────────── */

    /*
     * Kortet ligger ÖVER arket och strax ovanför remsan, inte mot skärmens
     * underkant. Skälet är att arket redan äger underkanten: två ark mot samma
     * kant hade legat ovanpå varandra, och det som låg under hade sett ut som
     * ett fel. Skriptet drar dessutom ned arket till remsan när ett kort
     * öppnas, så kartan under kortet syns.
     */
    .split.ark .kort {
      position: fixed;
      left: var(--s-3);
      right: var(--s-3);
      top: auto;
      bottom: calc(var(--ark-syns, 122px) + var(--s-3) + var(--keyboard-inset, 0px));
      z-index: 17;
      width: auto;
      border-radius: var(--r-card);
    }

    /* Pilen pekar på en nål som kan ligga var som helst, alltså inte alls. */
    .split.ark .kort::after { display: none; }
  }

  /*
   * Utan JavaScript, och över 900 px, står kartan kvar i sitt flöde. Den
   * gamla regeln lade kartkolumnen fixed och gömde den bakom en växelknapp;
   * nu finns ingen knapp, så en sida utan skript ska helt enkelt visa listan
   * och kartrutan under varandra.
   */
  @media (max-width: 900px) {
    .split:not(.ark) .kartram { height: 60vh; min-height: 320px; }
  }
