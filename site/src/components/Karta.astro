    /* 32 px, inte 26 som stängknappen. Bläddringen används flera gånger i
       följd och ska gå att träffa med tummen utan att sikta. */
    width: 32px;
    height: 32px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .kort :global(.kort-blad-knapp:hover) { background: var(--canvas); color: var(--text); }
  .kort :global(.kort-blad-knapp svg) { width: 18px; height: 18px; }

  /* ── Under kartan ─────────────────────────────────────────────────────── */

  .under {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    margin-top: var(--s-3);
  }

  .teckenforklaring {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .teckenforklaring li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .teckenforklaring .n { font-variant-numeric: tabular-nums; }

  .attribution {
    flex: 1 1 240px;
    font-size: 11px;
    line-height: 15px;
  }

  /* MapLibres egna element bär inte Astros scope-attribut. */
  .kartram :global(.maplibregl-map) {
    font: 400 var(--fs-caption) / var(--lh-caption) var(--font-sans);
  }

  .kartram :global(.maplibregl-ctrl-attrib) { font-size: 10px; line-height: 14px; }

  /* ── Mobilarket ───────────────────────────────────────────────────────── */

  /* Handtagsremsan finns bara på smal skärm. Se arkresonemanget i skriptet. */
  .handtag { display: none; }

  /*
   * Under 900 px får en delad vy inte plats. Kartan fyller då HELA ytan och
   * listan blir ett ark ovanpå den, som hos Airbnb. Se skriptets arkavsnitt
   * för måtten och för varför det inte längre är en växel mellan två vyer.
   */
  @media (max-width: 900px) {
    .split { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }

    /*
     * Två helt skilda världar: utan JavaScript är sidan ett vanligt dokument
     * med lista och karta under varandra, med JavaScript är den en app-yta med
     * ark. Klassen .ark sätts av skriptet, alltså bara när arket verkligen
     * kan styras.
     */
    .split.ark {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 15;
      gap: 0;
      background: var(--canvas);
    }

    .split.ark .kartkolumn { position: static; height: 100%; }

    .split.ark .kartram {
      position: absolute;
      inset: 0;
      height: auto;
      min-height: 0;
      border: 0;
      border-radius: 0;
    }

    /* Raden under kartan finns inte på app-ytan: den ligger per definition
       under kartan, och kartan är hela skärmen. Teckenförklaringen faller
       därmed bort på telefon, vilket är rimligt eftersom varje kort i listan
       skriver ut sin bedömning i klartext bredvid ansiktet. Attributionen gör
       det INTE, och den bärs i stället av MapLibres egen kontroll nedan. */
    .split.ark .under { display: none; }

    /*
     * Upphovet till OpenStreetMap är ett licenskrav och får aldrig hamna
