    box-shadow: 0 0 0 1px var(--brand);
  }

  .listfot {
    margin-top: var(--s-4);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  /* ── Kartan ───────────────────────────────────────────────────────────── */

  /* Kartan sitter kvar när listan rullar. Det är hela poängen med den delade
     vyn: man läser listan och behåller kartan i blickfånget. */
  .kartkolumn {
    position: sticky;
    top: var(--s-4);
  }

  /*
   * Rundade hörn, hårfin kant, ingen skugga. Som Airbnbs karta.
   *
   * Ägarens ord: "rutan sitter liksom helt fast, är en perfekt fyrkant, fast
   * med rundade hörn, och inget fluff". Radien är kortradien, kanten bara en
   * hårlinje så att den ljusa kartan inte flyter ihop med sidan, och ingen
   * skugga: kartan är en av sidans två halvor, inte ett kort som svävar.
   *
   * Höjden är dvh, inte vh, så att mobilens adressrad inte äter ur kartan.
   * Avdraget är sticky-avståndet upptill plus raden med teckenförklaringen
   * under; tidigare låg en död remsa under kartan för att avdraget var för
   * stort i förhållande till det som faktiskt ligger ovanför och under.
   */
  .kartram {
    position: relative;
    height: calc(100dvh - var(--s-8) - 56px);
