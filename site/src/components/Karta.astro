     har tryckts in från kanten. */
  .kort::after {
    content: '';
    position: absolute;
    left: var(--pil, 50%);
    bottom: -7px;
    margin-left: -8px;
    border: 8px solid transparent;
    border-bottom: 0;
    border-top-color: var(--card);
