---
/**
 * Filterraden. En vågrät rad val i stället för en pillervägg.
 *
 * ## Vad den är till för, efter delningen
 *
 * Raden är till för LÅNGA och VARIERANDE listor, alltså i praktiken för
 * stadsdelarna. Den bar tidigare två fall: kommunens sex verksamhetstyper och
 * dess upp till trettio stadsdelar. Det var ett fel, och mätningen visade
 * varför: sex typer är 546 px innehåll i ett spår på 640 till 736, alltså
 * rullade den raden aldrig på dator, medan Stockholms trettio stadsdelar är
 * 2 639 px i samma spår och rullar på riktigt. Två olika problem såg likadana
 * ut, och det ena var en rullrad som inte rullade.
 *
 * Typerna ligger nu i Kategorival.astro, som är ett rutnät utan skript. Hela
 * mätningen står där.
 *
 * Ett läge per fall i EN komponent var alternativet, och det valdes bort. Det
 * som skiljer fallen är allt: rutnät mot rullspår, med skript mot utan,
 * ikonspår mot inget, radbrytning mot `nowrap`. Kvar som gemensamt är bara
 * hur ett aktivt val märks ut, och det är tre rader CSS. En komponent med två
 * lägen hade varit den här filen en gång till med `if` runt varannan rad.
 * Regeln om aktivt val står i stället skriven i båda filerna, eftersom den är
 * ett tillgänglighetskrav och inte en implementationsdetalj.
 *
 * ## Varför den finns
 *
 * Kommunhubbens två filteravsnitt låg som chips som radbröt. Stockholm har 30
 * områden, och mätt i webbläsaren på 1280 px tog de 390 pixlar, plus 130 för
 * kategorierna: en halv skärm innan registret ens börjar. Ägarens dom var
 * "det blir för mycket, täcker ju typ en hel sida", och hans förslag var en
 * banner. Det här är den.
 *
 * ## Formen
 *
 * Mätt på ednia.se 2026-08-08, som är en av sajtens namngivna referenser.
 * Deras rad: varje val är en `<a>` i en flexkolumn, ikon 24 px (20 under
 * 800 px), 12 px luft, etikett 12/16 halvfet med `white-space: nowrap`,
 * 14 px bottenluft och en 2 px underkant. Inaktiv är #717171 med genomskinlig
 * kant, hovring ger #222 och en ljusgrå kant, aktiv ger #222 och en svart
 * kant. Mellanrummet är 28 px, och efter det första valet står en 1 px hög
 * hårlinje på 40 px i #ebebeb med 24 px marginal. Banden avgränsas av en
 * hårlinje. Rullningen ligger på en egen behållare med dold rullningslist,
 * och `overscroll-behavior` sätts BARA under `pointer: fine`, alltså aldrig
 * på telefon, där den annars kan äta sidans lodräta rullning.
 *
 * Måtten är översatta till våra tokens och inte kopierade i pixlar. Ednias
 * filterknapp längst till höger följer inte med: den öppnar deras filterark,
 * och en knapp som inte gör något är sämre än ingen knapp. Deras ikoner
 * följer inte heller med, se `Ingen bild` nedan.
 *
 * ## Vad raden ÄR
 *
 * Riktiga länkar till riktiga adresser. Sidor byggs för SEO, aldrig för
 * funktioner: kategorisidorna och områdessidorna finns kvar som egna URL:er
 * eftersom de kan rankas, och raden är en genväg till dem. Utan JavaScript
 * fungerar varenda val, och tabbning når varenda val. Skriptet längst ned
 * lägger bara till piltangenter och två rullknappar ovanpå det.
 *
 * ## Aktivt val
 *
 * Understreck, vikt och `aria-current="page"`. Aldrig färg ensam, av samma
 * tillgänglighetsskäl som gör att bedömningsmärkena alltid bär både min,
 * färg och textetikett.
 */
import { formatNumber } from '../lib/data';

export interface FilterVal {
  /** Adressen valet leder till. Utelämnad betyder ett val utan egen sida. */
  href?: string;
  label: string;
  /** Talet under etiketten. Utelämnat ger en rad utan tal. */
  count?: number;
  /** Är det här sidan man står på? */
  current?: boolean;
}

interface Props {
  items: FilterVal[];
  /**
   * Ett val som står först och skiljs från de andra av en hårlinje. Ednias
   * "Alla program". Utelämnas där ett hemläge inte betyder något.
   */
  lead?: FilterVal;
  /** Läses upp som navigeringens namn. */
  label: string;
}

const { items, lead, label } = Astro.props;

/*
 * Ingen bild, och det är ett beslut och inte något som fattas.
 *
 * Raden bär ortnamn. Södermalm, Gamla stan och Hägerstensåsen har inga
 * symboler, och trettio påhittade ikoner hade varit trettio påståenden om
 * platser vi inte kan stå för. Kategorierna HAR naturliga symboler, och de
 * ligger numera i Kategorival.astro, som ritar dem.
 *
 * Raden hade tidigare ett valfritt ikonspår för just det fallet. Det är
 * borttaget med kategorierna: en gren som ingen anropare tar är inte
 * flexibilitet, den är en fälla för nästa läsare.
 */
const alla = lead ? [lead, ...items] : items;

/*
 * Talraden reserveras på samma sätt, och av ett handfastare skäl.
 *
 * Raden bottenjusterar valen, så att understrecken hamnar på en linje. Ett val
 * utan tal får då en etikett som sitter femton pixlar lägre än grannarnas, och
 * det syns direkt: hemläget "Hela Stockholm" på områdessidan bär inget tal.
 * Har NÅGOT val ett tal får alla en talrad, tom där talet saknas.
 */
const talrad = alla.some((v) => v.count !== undefined);
---

<div class="filterrad">
  {/* Knapparna är server-renderade och dolda. Skriptet visar dem när spåret
      faktiskt svämmar över och pekdonet är en mus. De ligger UTANFÖR spåret
      och tar inte tabbfokus: varje val nås redan med tabb och piltangent, så
      knapparna är en musaffordans och inget mer. */}
  <button class="rulla vanster" type="button" hidden tabindex="-1" aria-hidden="true" data-rulla="-1">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M15 5 8 12l7 7" />
    </svg>
  </button>

  <div class="spar" data-spar>
    <nav class="rad" aria-label={label}>
      {alla.map((val, i) => {
        const inner = (
          <>
            <span class="etikett">{val.label}</span>
            {talrad && (
              <span class="tal">{val.count === undefined ? '' : formatNumber(val.count)}</span>
            )}
          </>
        );
        return (
          <>
            {val.href ? (
              <a class="val" href={val.href} aria-current={val.current ? 'page' : undefined}>
                {inner}
              </a>
            ) : (
              /* Ingen länk. Kategorin finns och talet är sant, men den
                 förtjänar ingen egen URL. Nedtonad, aldrig dold, eftersom siffran är
                 svaret. Samma regel som chipsen hade före raden. */
              <span class="val av">{inner}</span>
            )}
            {lead && i === 0 && <span class="delare" aria-hidden="true"></span>}
          </>
        );
      })}
    </nav>
  </div>

  <button class="rulla hoger" type="button" hidden tabindex="-1" aria-hidden="true" data-rulla="1">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m9 5 7 7-7 7" />
    </svg>
  </button>
</div>

<style>
  /* Bandet. Hårlinje över och under, precis som referensen, så att raden
     läser som en egen list och inte som innehåll som råkat ligga vågrätt. */
  .filterrad {
    position: relative;
    display: flex;
    align-items: stretch;
    border-block: 1px solid var(--hairline);
  }

  /* Rullningsspåret.

     `padding-block` plus lika stor negativ marginal är inte pynt: en
     rullningsbehållare klipper allt utanför sin padding-box, och sajtens
     fokusring ligger 2 px utanför elementet med 2 px offset. Utan luften
     kapas ringen på det val som har tangentbordsfokus, alltså precis den
     besökare regeln finns för. Luften tas tillbaka med marginalen så att
     bandets höjd är oförändrad. */
  .spar {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--s-2);
    margin-block: calc(var(--s-2) * -1);
    /* Rullningslisten är dold, inte rullningen. Knapparna och
       piltangenterna ersätter den; på telefon rullar man med fingret. */
    scrollbar-width: none;
  }

  .spar::-webkit-scrollbar { display: none; }

  /*
   * Kedjad rullning stoppas BARA för mus.
   *
   * `overscroll-behavior` på ett vågrätt spår hindrar även den lodräta
   * kedjan i flera webbläsare, och då fastnar sidans rullning så fort
   * fingret råkar landa i raden. Referensen gör exakt samma undantag
   * (`fine:overscroll-contain`), och det är värt att kopiera: raden ligger
   * mitt i en lång sida som man rullar förbi tio gånger oftare än man
   * använder den.
   */
  @media (pointer: fine) {
    .spar { overscroll-behavior-x: contain; }
  }

  .rad {
    display: flex;
    align-items: flex-end;
    gap: var(--s-6);
    width: max-content;
  }

  /* Valet. Kolumn, centrerad, med underkanten som markering. Bredden följer
     innehållet, alltså blir understrecket exakt så brett som etiketten. */
  .val {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding-block: var(--s-1) var(--s-3);
    border-bottom: 2px solid transparent;
    /* Etiketten är sajtens vanliga bläck, inte grått.
       Den var `--text-secondary`, alltså grå på varenda val utom det
       aktiva, och hela raden läste som avstängd. Ägaren: "rubriken är ju i
       grått istället för vår mörka/svarta". Det aktiva valet skiljs ut av
       understreck och halvfet vikt, vilket är två bärare och räcker. Talet
       under är fortfarande tyst, se .antal. */
    color: var(--text);
    text-align: center;
    white-space: nowrap;
  }

  .val:hover {
    text-decoration: none;
    border-bottom-color: var(--text-muted);
  }

  /* Aktivt val: understreck OCH halvfet etikett OCH aria-current. Tre bärare,
     ingen av dem en färg i sig. Se komponentens huvudkommentar.

     Understrecket är märkesblått och inte svart. Ednias rad markerar med
     #222222, som är deras bläck rakt igenom, uppmätt på ednia.se 2026-08-12.
     Men sajten har ingen annan svart markering: valt läge är blått i
     sökpanelen, i kartan och i pagineringen, och en svart list under ett
     kategorival såg lånad ut bredvid dem. Ägaren: "hör inte ihop med resten
     av sajtens formspråk". --brand och inte --brand-ink, eftersom det här är
     en YTA och inte text, se färgnoten i tokens.css. */
  .val[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--brand);
  }

  .val[aria-current='page'] .etikett { font-weight: 600; }

  /* Utan egen sida. Ingen hovring, ingen pekare, inget understreck. */
  .val.av { color: var(--text-muted); }
  .val.av:hover { border-bottom-color: transparent; color: var(--text-muted); }

  .etikett {
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    font-weight: 600;
  }

  /* `display: block` och `min-height`, inte bara `line-height`: en tom inline-
     span är noll pixlar hög, och det är precis den som ska hålla platsen för
     ett val utan tal. Se `talrad` i frontmatter.

     Talet var 11 px i --text-muted, alltså sajtens minsta grad i dess ljusaste
     grå, och ägaren läste det som "litet och grått". Det är ett riktigt tal
     och inte en fotnot: 12 px i --text-secondary, samma grad som etiketten
     ovanför, så att valet läser som en enhet. */
  .tal {
    display: block;
    min-height: var(--lh-eyebrow);
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  /* Hårlinjen efter hemläget. Skiljer "ingen filtrering" från valen, precis
     som referensen. Står bara när ett hemläge finns. */
  .delare {
    flex: none;
    align-self: center;
    width: 1px;
    height: 32px;
    background: var(--hairline);
  }

  /* ── Rullknapparna ──────────────────────────────────────────────────────
     Ligger ovanpå spårets kanter med en tona-ut bakom sig, så att valet
     under inte ser avhugget ut. Bara mus, se skriptet. */
  /*
   * Rullknappen: en rund knapp ovanpå en tonad yta, som hos referensen.
   *
   * Den var tidigare bara en tonning mot `--canvas`, alltså sidans grå, men
   * raden ligger på kortets vita. Färgerna gick isär och det avklippta ordet
   * syntes rakt igenom. Ägaren: "det är en rulle åt vänster men täcker ju
   * inte ens på typ".
   *
   * Ytan tas nu ur `--filterrad-yta`, som förvalt är kortets vita och kan
   * sättas om av den som placerar raden på en annan botten. Och själva
   * knappen är en ogenomskinlig cirkel, vilket löser problemet oavsett hur
   * väl tonningen råkar träffa: en bokstav bakom en fylld cirkel syns inte.
   */
  .rulla {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    width: 56px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .rulla::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .rulla svg {
    /* Cirkeln är knappen. 28 px är samma mått som sökpanelens runda
       kontroller, se tokens.css. */
    box-sizing: content-box;
    width: 16px;
    height: 16px;
    padding: 6px;
    background: var(--filterrad-yta, var(--card));
    border: 1px solid var(--hairline);
    border-radius: 50%;
    box-shadow: var(--shadow-sm);
  }

  .rulla:hover svg { background: var(--canvas); }

  .rulla.vanster {
    left: 0;
    justify-content: flex-start;
  }

  .rulla.vanster::before {
    background: linear-gradient(
      to right,
      var(--filterrad-yta, var(--card)) 60%,
      transparent
    );
  }

  .rulla.hoger {
    right: 0;
    justify-content: flex-end;
  }

  .rulla.hoger::before {
    background: linear-gradient(
      to left,
      var(--filterrad-yta, var(--card)) 60%,
      transparent
    );
  }

  /* `hidden` överlever inte en egen display, och knappen är flex. */
  .rulla[hidden] { display: none; }

  @media (max-width: 640px) {
    .rad { gap: var(--s-4); }

    /* Två 44-pixlarsknappar över ett spår på 343 är en fjärdedel av raden
       täckt av kontroller. Referensen döljer sina av samma skäl. Skriptet
       håller dem dolda på pekskärm ändå; det här gäller den smala
       skrivbordsrutan, där pekdonet är en mus. */
    .rulla { display: none; }
  }
</style>

<script>
  /**
   * Piltangenter och rullknappar. Progressiv förbättring, ingenting annat.
   *
   * Utan det här skriptet är raden fortfarande fullt användbar: valen är
   * länkar, tabb når dem, Enter följer dem, och fingret rullar spåret. Faller
   * skriptet bort förlorar besökaren två knappar och en genväg.
   */
  for (const rad of document.querySelectorAll<HTMLElement>('.filterrad')) {
    const spar = rad.querySelector<HTMLElement>('[data-spar]');
    const knappar = rad.querySelectorAll<HTMLButtonElement>('[data-rulla]');
    if (!spar) continue;

    /* Bara länkarna. Ett val utan egen sida är ingen tabbstopp och ska inte
       vara ett pilstopp heller. */
    const val = () => [...spar.querySelectorAll<HTMLAnchorElement>('a.val')];

    /*
     * Aktivt val i blickfånget vid inläsning.
     *
     * scrollLeft skrivs direkt i stället för scrollIntoView(): den senare
     * rullar även närmaste lodräta förfader, alltså hela sidan, och en sida
     * som hoppar ner till sitt filter när den öppnas är ett fel och inte en
     * hjälp.
     */
    const har = spar.querySelector<HTMLElement>('[aria-current="page"]');
    if (har) {
      const mitt = har.offsetLeft + har.offsetWidth / 2 - spar.clientWidth / 2;
      spar.scrollLeft = Math.max(0, mitt);
    }

    /* Knapparna visas bara för mus och bara när det finns något att rulla
       till. På pekskärm rullar man med fingret, och en pil som inte pekar
       någonstans är brus. */
    const mus = window.matchMedia('(pointer: fine)');

    /* Hur mycket som måste sticka ut innan raden får rulla alls.
       ────────────────────────────────────────────────────────────────────
       Tröskeln stod på 1 px, alltså räckte en enda pixels överskott för att
       raden skulle bli rullbar och få sina pilar. Det är rätt för Stockholms
       trettio områden, som rullar 1 943 px, och fel för en kommun vars
       områden nätt och jämnt inte får plats. Ägaren: "det är inte ens en full
       skroll". En pil som flyttar raden tolv pixlar och sedan slocknar läser
       som ett fel, inte som en funktion.

       Åttiofyra pixlar är bredden på det smalaste valet plus dess luft,
       alltså det minsta som kan vara dolt och ändå vara värt att rulla
       fram. Under det låter vi hellre raden sluta någon pixel innanför
       kanten, vilket ingen ser. */
    const RULLTROSKEL = 84;

    const uppdatera = () => {
      const kvar = spar.scrollWidth - spar.clientWidth;
      const kan = mus.matches && kvar > RULLTROSKEL;
      for (const k of knappar) {
        const rikt = Number(k.dataset.rulla);
        k.hidden = !kan || (rikt < 0 ? spar.scrollLeft <= 1 : spar.scrollLeft >= kvar - 1);
      }
    };

    for (const k of knappar) {
      k.addEventListener('click', () => {
        const rikt = Number(k.dataset.rulla);
        /* Mjuk rullning bara när besökaren inte bett om lugnare rörelse.
           tokens.css släcker övergångar och animationer globalt, men
           scroll-behavior är varken det ena eller det andra. */
        const lugn = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        spar.scrollBy({
          left: rikt * spar.clientWidth * 0.8,
          behavior: lugn ? 'auto' : 'smooth',
        });
      });
    }

    spar.addEventListener('scroll', uppdatera, { passive: true });
    window.addEventListener('resize', uppdatera);
    mus.addEventListener('change', uppdatera);
    uppdatera();

    /*
     * Piltangenter. Fokus flyttas mellan valen, Home och End till ändarna.
     *
     * Ingen roving tabindex: kravet är att BÅDE pilar och tabbning ska
     * fungera, och roving tabindex tar bort alla utom ett ur tabbordningen.
     * Pilarna är alltså en genväg ovanpå tabb, inte en ersättning för den.
     */
    spar.addEventListener('keydown', (e) => {
      const nyckel = e.key;
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(nyckel)) return;

      const lista = val();
      const nu = lista.indexOf(document.activeElement as HTMLAnchorElement);
      if (nu === -1) return;

      let till: number;
      if (nyckel === 'Home') till = 0;
      else if (nyckel === 'End') till = lista.length - 1;
      else till = nu + (nyckel === 'ArrowLeft' ? -1 : 1);

      const mal = lista[till];
      if (!mal) return;

      /* preventScroll: fokus får flytta spåret i sidled, aldrig sidan i
         höjdled. Spåret ställs in för hand direkt efteråt. */
      e.preventDefault();
      mal.focus({ preventScroll: true });
      const mitt = mal.offsetLeft + mal.offsetWidth / 2 - spar.clientWidth / 2;
      spar.scrollTo({ left: Math.max(0, mitt), behavior: 'smooth' });
    });
  }
</script>
