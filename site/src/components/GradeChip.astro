---
/**
 * Betygschipet — sajtens viktigaste komponent.
 *
 * Tillgänglighetsregel från bibeln §14: betyg kommuniceras ALDRIG med enbart
 * färg. Alltid färg + bokstav + textetikett (8 % av män är färgblinda).
 * Samma chip dubblar som kartnål i mindre variant.
 */
import { GRADE_LABEL, GRADE_COLOR_VAR, type GradeOrNone } from '../lib/site';

interface Props {
  grade: GradeOrNone;
  size?: 'sm' | 'md' | 'lg';
  /** Visa textetiketten under bokstaven. */
  showLabel?: boolean;
}

const { grade, size = 'lg', showLabel = false } = Astro.props;

const color = grade ? GRADE_COLOR_VAR[grade] : 'var(--grade-none)';
const label = grade ? GRADE_LABEL[grade] : 'Otillräckligt underlag';
const glyph = grade ?? '–';
---

<div class="wrap">
  <div
    class:list={['chip', size]}
    style={`--chip-color: ${color}`}
    role="img"
    aria-label={grade ? `Hygienbetyg ${grade} — ${label}` : label}
  >
    <span class="glyph" aria-hidden="true">{glyph}</span>
  </div>
  {showLabel && (
    <span class="label" style={`color: ${color}`}>{label}</span>
  )}
</div>

<style>
  .wrap {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }

  .chip {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--chip-color);
    color: #fff;
    border-radius: var(--r-chip);
  }

  .glyph {
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.02em;
  }

  .lg { width: 96px; height: 96px; }
  .lg .glyph { font-size: 46px; }

  .md { width: 64px; height: 64px; border-radius: 16px; }
  .md .glyph { font-size: 30px; }

  .sm { width: 40px; height: 40px; border-radius: 11px; }
  .sm .glyph { font-size: 19px; }

  .label {
    font-size: var(--fs-body-s);
    font-weight: 600;
    text-align: center;
  }
</style>
