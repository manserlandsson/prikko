---
/**
 * Ikon per toppkategori.
 *
 * Egna ikoner, ritade på samma 24-rutnät med 1.6 px streck som AreaIcon.astro.
 * Inga lånade emoji, inget ikonbibliotek, ingenting avritat från någon annans
 * sajt. Det är en del av att inte se generisk ut.
 *
 * Formerna ritas i rutnätet och normaliseras sedan optiskt, se OPTIK längre
 * ner. Rita fritt i 24-rutnätet och mät om faktorn efteråt.
 *
 * Fem former som INTE går att förväxla med varandra vid 24 pixlar: bestick,
 * kopp, kasse, byggnad, låda. Det är villkoret som styrde varje val. Butiken
 * ritades först som butiksfasad med markis och byttes till kasse, eftersom en
 * fasad och en skolbyggnad är samma silhuett i den här storleken.
 *
 * `alla` är inte en kategori utan filterradens hemläge, alltså "ingen
 * filtrering". Den bor här för att den ritas i samma språk som de fem.
 */
import type { IkonNyckel } from '../lib/ikoner';

interface Props {
  namn: IkonNyckel;
  size?: number;
}

const { namn, size = 24 } = Astro.props;

const PATHS: Record<IkonNyckel, string> = {
  // Hemläget. Staplade lager, alltså hela bunten.
  alla:
    'M5 11.5h14a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19v-6A1.5 1.5 0 0 1 5 11.5z' +
    'M5.5 8h13M8 4.5h8',
  // Restauranger. Gaffel och kniv.
  restaurang:
    'M5 3v4.5a2.5 2.5 0 0 0 5 0V3M7.5 10v11' +
    'M16 3c1.5 2.1 2.2 4.4 2.2 6.7 0 1.8-.8 3.3-2.2 3.3zM16 13v8',
  // Caféer och bagerier. Kopp med öra.
  cafe:
    'M4 8.5h13v4.5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8.5z' +
    'M17 10h1.5a2.5 2.5 0 0 1 0 5H17M3 21h15',
  // Butiker. Kasse med handtag.
  butik:
    'M5 8h14l-1.2 11.3a2 2 0 0 1-2 1.7H8.2a2 2 0 0 1-2-1.7L5 8z' +
    'M9 8V6.5a3 3 0 0 1 6 0V8',
  // Skolor och omsorg. Byggnad med sadeltak och valvport.
  //
  // Porten är valvformad och inte rak, och det är hela skillnaden mellan en
  // institution och ett bostadshus i den här storleken. Ett fönsterband låg
  // först ovanför porten och togs bort: det hamnade i skarven mellan tak och
  // vägg och läste som en garageport vid 24 pixlar.
  skola: 'M12 3.2 3 8v12.8h18V8zM9.5 20.8v-4.3a2.5 2.5 0 0 1 5 0v4.3',
  // Övrigt. Låda: tillverkare, grossister, lager, det man inte besöker.
  ovrigt: 'M12 3.2 3.8 7.3v9.4L12 20.8l8.2-4.1V7.3zM3.8 7.3 12 11.4l8.2-4.1M12 11.4v9.4',
};

/**
 * Optisk utjämning. Samma rutnät räcker inte, formerna måste också väga lika.
 *
 * Ägaren såg raden i filtret som ikoner ur olika uppsättningar, "olika
 * streckvikt och olika optisk storlek". Streckvikten var densamma i alla sex,
 * 1,6 px. Storleken var det inte. Mätt med getBBox() i webbläsaren:
 *
 *   alla        17,0 × 16,0   mitt (12,0 / 12,5)
 *   restaurang  13,2 × 18,0   mitt (11,6 / 12,0)
 *   cafe        18,0 × 12,5   mitt (12,0 / 14,8)
 *   butik       14,0 × 17,5   mitt (12,0 / 12,3)
 *   skola       18,0 × 17,6   mitt (12,0 / 12,0)
 *   ovrigt      16,4 × 17,6   mitt (12,0 / 12,0)
 *
 * Skolan var alltså 36 procent bredare än restaurangen och tog 33 procent
 * större yta, och koppen satt nästan tre pixlar för lågt i rutan. Bredvid
 * varandra i en rad läses det som olika ikonstorlekar, inte som olika motiv.
 *
 * Rättningen är räknad och inte tyckt. Varje form skalas så att roten ur dess
 * yta blir 16,23, vilket är genomsnittet av de sex, och centreras på (12,12).
 * Streckvikten delas med samma faktor så att linjen är 1,6 px på skärmen i
 * alla sex, vilket är hela poängen: skalar man en ikon utan att kompensera
 * blir den lilla ikonen också den tunnaste.
 *
 * Mät om med getBBox() om en form ritas om, och räkna om faktorn. Gissa inte.
 */
const OPTIK: Record<IkonNyckel, { skala: number; cx: number; cy: number }> = {
  alla:       { skala: 0.984, cx: 12,   cy: 12.5 },
  restaurang: { skala: 1.052, cx: 11.6, cy: 12 },
  cafe:       { skala: 1.082, cx: 12,   cy: 14.75 },
  butik:      { skala: 1.037, cx: 12,   cy: 12.25 },
  skola:      { skala: 0.912, cx: 12,   cy: 12 },
  ovrigt:     { skala: 0.955, cx: 12,   cy: 12 },
};

const { skala, cx, cy } = OPTIK[namn];
const transform = `translate(12 12) scale(${skala}) translate(${-cx} ${-cy})`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={(1.6 / skala).toFixed(3)}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={PATHS[namn]} transform={transform} />
</svg>
