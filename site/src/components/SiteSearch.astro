---
/**
 * Sökfältet, och sajtens enda sökpanel.
 *
 * ---------------------------------------------------------------------------
 * VARFÖR DET HÄR ÄR EN KOMPONENT OCH INTE TVÅ
 * ---------------------------------------------------------------------------
 * Fältet hade tidigare två paneler: sin egen förslagslista och
 * kommandopaletten som cmd+K fällde ut ur samma fält. De såg likadana ut,
 * hängde på samma ställe och svarade olika. Fältets panel nådde verksamheter
 * och kommuner; paletten nådde dessutom sajtens egna sidor, kartorna och
 * artiklarna. Skillnaden var ett medvetet val, dokumenterat som "det som gör
 * mönstret värt något", och den höll inte: besökaren kan inte se vilken av de
 * två hon har framför sig, och den som klickade fick ett sämre svar än den
 * som kunde en tangentgenväg. Ägarens ord: "nu är sök annorlunda om du
 * trycker cmd K mot bara söker i sökrutan genom klick."
 *
 * Nu finns EN panel. cmd+K är inte längre ett annat gränssnitt utan en
 * genväg till det som redan finns: den fokuserar fältet och fäller ut samma
 * panel, varhelst på sidan man står. Träffarna, ordningen, tangenterna och
 * tomma läget är därmed samma sak oavsett väg in, för att det ÄR samma sak.
 *
 * Sammanslagningen tog dessutom bort tre lappar som bara fanns för att hålla
 * de två isär: attributet data-palette-open som fick det ena skriptet att
 * tiga medan det andra körde, flytten av palettens markup in i fältets rot
 * vid första öppningen, och de två uppsättningarna markering och
 * musspärrar. Panelen är författad inuti fältet och ärver dess bredd av sig
 * själv.
 *
 * ---------------------------------------------------------------------------
 * VAD SOM LADDAS NÄR
 * ---------------------------------------------------------------------------
 * Grundläget är ett vanligt formulär som postar till /sok. Det fungerar utan
 * en rad JavaScript, och det är därför /sok ligger kvar även sedan länken
 * försvann ur menyn: sidan är formulärets mål, inte en meningslös dubblett.
 *
 * Registret (/sok-index/<hash>.json, ~970 kB) hämtas FÖRST när panelen
 * öppnas. Sidhuvudet finns på 14 711 sidor. Hämtades registret vid
 * sidladdning skulle varje besök på varje restaurangsida dra ner en megabyte
 * som de allra flesta aldrig använder. Adressen är innehållsbaserad och
 * kommer från lib/search-index; den skickas som data-attribut eftersom
 * klientskriptet är en egen bunt utan tillgång till frontmattern.
 *
 * Panelens EGET innehåll (populära sökningar, sidor, kartor, artiklar) ligger
 * däremot i dokumentet, som JSON. Panelen ska vara ifylld i samma ögonblick
 * som fältet fokuseras, alltså kan den inte vänta på nätverket. Som JSON och
 * inte som färdiga rader: raderna bär inlinade ikonbanor och vägde ungefär
 * elva kilobyte mer per sida än datan de ritades ur, på varenda sida sajten
 * har. Raderna byggs i stället av lib/sokforslag, samma funktion som ritar
 * träffarna, vilket är själva garantin för att tomt läge och träffläge är
 * samma lista.
 */
import { siteCommands } from '../lib/kommandon';
import { SEARCH_INDEX_FALLBACK_URL, SEARCH_INDEX_URL } from '../lib/search-index';
import type { Suggestion } from '../lib/sokforslag';

interface Props {
  /**
   * bar:  sidhuvudets fält, grundläget.
   * hero: startsidans stora centrerade fält.
   *
   * Ett läge i samma komponent, aldrig en kopia: fältet har nyss fått
   * uppmätta mobilmått och två exemplar glider isär. Skillnaden är bara
   * mått, allt beteende är gemensamt. En sida får bära EN instans:
   * skriptet ankras i document.querySelector och id:t site-search-q är
   * skrivet en gång. Startsidan stänger därför av sidhuvudets fält via
   * Header-propen search innan den renderar hero-läget.
   */
  size?: 'bar' | 'hero';
}

const { size = 'bar' } = Astro.props;

const sections = await siteCommands();

/* `<` maskeras: en artikelrubrik med "</script>" i sig skulle annars stänga
   taggen mitt i datan. Enda tecknet som kan göra det, och JSON-parsern läser
   < som ett vanligt <. */
const suggestData = JSON.stringify({ sections }).replace(/</g, '\\u003c');
---

<div
  class:list={['site-search', size === 'hero' && 'is-hero']}
  data-sitesearch
  data-index={SEARCH_INDEX_URL}
  data-index-fallback={SEARCH_INDEX_FALLBACK_URL}
>
  <form class="search-field" role="search" action="/sok/" method="get" data-field>
    <label class="visually-hidden" for="site-search-q">Sök verksamhet eller kommun</label>
    <input
      id="site-search-q"
      name="q"
      type="text"
      placeholder="Sök restaurang, café eller kommun"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      data-input
    />
    {/* Genvägsmärket, hitta.se-mönstret på ägarens uttryckliga begäran: TVÅ
        separata tangentrutor i fältets högerkant, ⌘ i den ena och K i den
        andra, med litet mellanrum. Skriptet byter modifierarrutans tecken
        efter plattformen (⌘ på Mac, Ctrl annars), visar märket bara på
        enheter med hover+fin pekare och kopplar klicket till att fälla ut
        panelen. Därför startar märket hidden och med ⌘ som degraderings-
        tecken: utan skript finns det inte.

        I båda lägena, även heron: panelen fälls ut ur just det här fältet,
        så märket pekar på fältets egen förmåga och inte på en främmande
        ruta. Hitta.se har det i sitt stora fält av samma skäl. */}
    <button
      type="button"
      class="palette-hint"
      data-palette-hint
      hidden
      aria-label="Öppna snabbsökningen"
    >
      <kbd data-palette-mod>⌘</kbd><kbd>K</kbd>
    </button>
    <button type="submit" class="go" aria-label="Sök">
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="9" cy="9" r="5.4" fill="none" stroke="currentColor" stroke-width="1.9" />
        <path d="M13.2 13.2 17.2 17.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
      </svg>
    </button>
  </form>

  <div class="panel glass" hidden data-panel>

    {/* Beskedet står FÖRE listan, inte efter den. Det bär tre lägen: hämtar
        registret, registret gick inte att hämta, och inga träffar. I alla
        tre är det svaret på frågan besökaren just ställde, och då kan det
        inte ligga under raden som föreslår vad man gör i stället. Det ligger
        dessutom utanför listboxen med flit: en listbox får bara innehålla
        alternativ, och beskedet är inget man kan välja. aria-live gör att en
        skärmläsare hör det utan att flytta fokus. */}
    <p class="note" hidden aria-live="polite" data-note></p>

    {/* Raderna byggs av skriptet, ur JSON-datan nedanför och ur registret.
        Tomt i HTML alltså, och det är inget bortfall: panelen är hidden och
        öppnas bara av skript. */}
    <ul
      class="list"
      id="site-search-list"
      role="listbox"
      aria-label="Förslag"
      data-list
    ></ul>

    {/* aria-hidden med avsikt: tipsen beskriver tangenter en skärmläsare
        redan känner till från listbox-mönstret, och raden är ren dekor.
        Den visas bara där tangenterna finns, se .hints i stilarna. */}
    <footer class="hints" aria-hidden="true">
      <span><kbd class="key">↑</kbd><kbd class="key">↓</kbd> bläddra</span>
      <span><kbd class="key">⏎</kbd> öppna</span>
      <span><kbd class="key">esc</kbd> stäng</span>
    </footer>
  </div>

  <script type="application/json" data-suggest set:html={suggestData} />
</div>

<style>
  .site-search {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 380px;
  }

  /* Piller, som Airbnbs — men ETT fält. Knappen sitter inuti pillret och är
     rund; den är fältets enda färgade yta och därmed dess tyngdpunkt.

     Klassen hette .field och FICK inte heta så. styles/konto.css är ett
     globalt, oscopeat ark med en `.field { display: block; margin-top:
     var(--s-4) }` för kontoformulären. Det arket laddas av ActionPanel,
     Reviews och SignInDialog, alltså på varje verksamhetssida, och träffade
     då sökfältet i sidhuvudet. Astros scoping skyddar inte: den höjer bara
     specificiteten på de deklarationer komponenten själv skriver, och
     margin-top skrevs inte här. Fältet fick 16 px marginal ovanför sig och
     hängde 8 px för lågt i raden, men bara på de sidor som laddade konto.css.
     Det var därför snedheten syntes på verksamhetssidan och inte på
     startsidan. Namnet måste vara unikt så länge konto.css är globalt. */
  .search-field {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    height: 40px;
    padding: 3px 3px 3px var(--s-4);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-sm);
  }

  .search-field:hover { border-color: var(--text-muted); }
  .search-field:focus-within { border-color: var(--brand); }

  /* Ringen ligger på pillret, inte på input-elementet: ett textfält matchar
     alltid :focus-visible, och en ring runt den osynliga inre rutan hade
     ritats tvärs över pillrets rundning. */
  .search-field:has(input:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .search-field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    font-size: var(--fs-body-s);
    color: var(--text);
  }

  .search-field input:focus { outline: none; }
  .search-field input::placeholder { color: var(--text-muted); }

  .go {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--brand);
    color: #fff;
    cursor: pointer;
  }

  .go:hover { background: var(--brand-ink); }
  .go svg { width: 18px; height: 18px; }

  /* Genvägsmärket: två separata tangentrutor, hitta.se:s form. Knappen
     själv är osynlig — det är rutorna som är märket. Varje ruta delar
     tangentform med tipsradens key-caps (22 px, canvas-yta, hårlinje,
     6 px radie) så de två läser som samma familj.
     [hidden]-regeln måste stå: en display-regel på klassen slår annars ut
     attributet, och märket ska kunna släckas på pekskärm. */
  .palette-hint {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .palette-hint[hidden] { display: none; }

  .palette-hint kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--canvas);
    font: 500 var(--fs-eyebrow)/1 var(--font-sans);
    color: inherit;
  }

  .palette-hint:hover { color: var(--text); }
  .palette-hint:hover kbd { border-color: var(--text-muted); }

  /* ── Hero-läget: startsidans stora fält ─────────────────────────────────
     Bara mått. 600 px brett, 56 px högt, brödtextens 17 px och en 44 px
     knapp. Skuggan är ett snäpp djupare än sidhuvudets: fältet är sidans
     främsta handling och ska lyfta en aning från botten, inte flyta ihop
     med korten under. Fortfarande inga nya färger. */
  .site-search.is-hero {
    max-width: 600px;
  }

  .site-search.is-hero .search-field {
    height: 56px;
    padding: 6px 6px 6px var(--s-6);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .05), 0 6px 20px rgba(0, 0, 0, .06);
  }

  .site-search.is-hero .search-field input { font-size: var(--fs-body); }

  .site-search.is-hero .go { width: 44px; height: 44px; }
  .site-search.is-hero .go svg { width: 19px; height: 19px; }

  /* ── Panelen ────────────────────────────────────────────────────────────
     Samma svävande lager som platsväljaren bredvid. De två panelerna ligger
     tio centimeter från varandra i sidhuvudet och måste läsa som syskon,
     numera garanterat, eftersom ytan står en gång i .glass i tokens.css i
     stället för i en kopia per fil. Här bor bara mått och layout. */
  .panel {
    position: absolute;
    top: calc(100% + var(--s-2));
    left: 0;
    z-index: 50;
    width: 100%;
    min-width: 340px;

    /* HÖJDEN RÄKNAS MOT UTRYMMET UNDER FÄLTET, inte mot en vh-siffra.
       Ägaren: "på cmd k sökningen, då blir popupen för lång, den läcker
       liksom för långt ner." Panelen bar 70vh, och 70 % av fönstret är för
       mycket när fältet redan börjar en bit ner: på startsidan sitter
       herofältet mitt på sidan, så panelen fortsatte förbi skärmkanten och
       resten gick bara att nå genom att skrolla sidan — vilket flyttade
       panelen med sig.

       --panel-room sätts av skriptet till fönsterhöjden minus fältets
       underkant minus en marginal, och räknas om vid rullning och
       storleksändring. En fast siffra kan inte klara både sidhuvudet och
       heron, eftersom det är fältets läge som avgör hur mycket som finns
       kvar.

       --keyboard-inset kommer ur visualViewport och sätts av lib/page-lock,
       samma variabel som arken använder. iOS krymper inte layoutviewporten
       när tangentbordet fälls upp, så innerHeight vet ingenting om det;
       dvh vet det inte heller. Panelen låser INTE sidan (den är en popup,
       inte ett ark) och prenumererar därför bara på mätningen.

       max() är golvet, och det är en sista utväg: står fältet så långt ner
       att tangentbordet lämnar mindre än tre rader under det får panelen
       hellre gå utanför än falla ihop till en remsa. Läget varar inte:
       webbläsaren rullar fram fältet när tangentbordet kommer, och
       mätningen räknas om vid varje rullning. 560 är taket, annars blir
       tomma läget en katalog på en hög skärm. */
    max-height: max(
      160px,
      min(560px, calc(var(--panel-room, 60vh) - var(--keyboard-inset, 0px)))
    );

    display: flex;
    flex-direction: column;
    padding: var(--s-3);

    /* Panelen ärver ALDRIG sidans textjustering.
       Det här är felet ägaren fotograferade. Startsidans .hero-kort sätter
       text-align: center för rubriken och underraden, och panelen hänger
       inuti kortet. Varje namn centrerades därför över sin adress, medan
       adressen — som är längre och fyller radens hela bredd — såg
       vänsterställd ut. Resultatet var en sicksackande vänsterkant.
       Regeln står på panelen och inte på .is-hero med flit: fältet ska
       kunna monteras var som helst, i vilken centrerad förälder som helst,
       utan att listan går sönder igen. Booli och hitta.se har båda en
       centrerad hero och en strikt vänsterställd förslagslista under den. */
    text-align: left;
  }

  .panel[hidden] { display: none; }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 600;
    color: var(--text);
  }

  .chip:hover {
    text-decoration: none;
    border-color: var(--text-muted);
  }

  /* Listan är det enda som rullar. Chipsen, beskedet och tipsraden står
     kvar, så panelen aldrig ser avhuggen ut i överkanten. */
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .list :global(.group) {
    margin: var(--s-3) var(--s-2) var(--s-1);
  }

  /* Första gruppen ska inte skjuta ner listan: luften ovanför den bärs
     redan av chipsraden eller av panelens egen padding. */
  .list :global(.group:first-child) {
    margin-top: var(--s-1);
  }

  /* :global på raderna: de byggs av skriptet och bär inte Astros
     scopingattribut. */
  .list :global(a) {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2);
    border-radius: var(--r-control);
    color: var(--text);
  }

  .list :global(a:hover),
  .list :global(a[data-active]) {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 6%, transparent);
  }

  /* Märkeskolumnen. Fast bredd så att namnen står på EN linje oavsett vad
     raden bär: ett bedömningsmärke, en kommunnål eller en förstoringsglas.

     Den ljusgrå rutan bakom ikonen är borta. Den var 36 px, identisk på var
     enda verksamhetsrad, och sa därmed ingenting alls — den enda skillnad
     den gjorde var att skjuta namnet 48 px in på raden. Booli har ingen
     ikonkolumn över huvud taget; hitta.se har en, men lätt och vit. Kvar är
     märket självt, och för verksamheter är det ansiktet. */
  .list :global(.mark) {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--text-secondary);
  }

  .list :global(.mark svg) { width: 20px; height: 20px; }
  .list :global(.mark .face) { width: 28px; height: 28px; }

  .list :global(.body) {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .list :global(.name),
  .list :global(.meta) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Namnet i halvfet, den skrivna delen i fet. Boolis mönster: de sätter
     "Stor" fett i "Stora Ursvik" och låter resten stå kvar. Skillnaden
     mellan 500 och 700 är liten med flit — raden ska kunna läsas som ett
     namn, inte som två. */
  .list :global(.name) {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 500;
  }

  .list :global(.name b) { font-weight: 700; }

  .list :global(.meta) {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .list :global(.meta b) { font-weight: 700; color: var(--text); }

  /* Sista raden går till /sok. En handling, inte en träff, och avskild som
     en sådan: hårlinje ovanför, en rad i stället för två, och namnet i
     dämpad färg så att den inte konkurrerar med verkliga träffar. */
  .list :global(.handling) {
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--hairline);
  }

  .list :global(.action .name) {
    font-weight: 500;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list :global(.action:hover .name),
  .list :global(.action[data-active] .name) { color: var(--text); }

  /* Beskedet. Brödtextens mindre grad och inte bildtextens: det är svaret på
     en fråga besökaren just ställde, inte en fotnot till något annat. */
  .note {
    flex-shrink: 0;
    margin: 0;
    padding: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .note[hidden] { display: none; }

  /* Tipsen finns bara där tangenterna finns. hover+fine pointer är den
     träffsäkraste signalen webben har för "här sitter ett tangentbord". */
  .hints {
    flex-shrink: 0;
    display: none;
    gap: var(--s-4);
    align-items: center;
    padding: var(--s-3) var(--s-2) var(--s-1);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-caption);
    color: var(--text-secondary);
  }

  .hints span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
  }

  .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--canvas);
    font: 500 var(--fs-caption)/1 var(--font-sans);
    color: var(--text-secondary);
  }

  @media (hover: hover) and (pointer: fine) {
    .hints { display: flex; }
  }

  /* Under 900 px konkurrerar fältet med menyn om bredden; menyn får vika
     först, den finns i sin helhet i sidfoten. Gäller bara sidhuvudsläget:
     hero-fältet delar inte rad med någonting och behåller sin bredd. */
  @media (max-width: 900px) {
    .site-search:not(.is-hero) { max-width: 300px; }
  }

  @media (max-width: 640px) {
    .site-search {
      /* Panelen ankras till hela sidhuvudsraden i stället för till fältet.
         Ett fält som börjar 110 px in på skärmen kan inte bära en panel som
         är bredare än resten av raden. */
      position: static;
    }

    /* Fältet ska väga mindre på en telefon, där det delar en 58 px rad med
       wordmarken och menyn. Höjden och knappen krymper, inte texten.
       36 px är fortfarande en bekväm träffyta, och knappen på 30 px sitter
       kvar mitt i pillret med samma 3 px luft runt om. */
    .search-field { height: 36px; }
    .search-field .go { width: 30px; height: 30px; }

    /* 16px är ett GOLV, inte ett val. Safari på iOS zoomar in hela sidan när
       ett fält med mindre än 16 px text får fokus, och zoomar aldrig ut igen.
       Ska fältet läsa som mindre får det ske genom höjd, padding och en
       kortare platshållare. Aldrig genom att gå under det här talet.
       Ingen typografitoken ligger på 16: body är 17 och body-s är 14, och 14
       skulle utlösa just den zoomen. Därför står talet skrivet. */
    .search-field input { font-size: 16px; }

    .panel {
      left: var(--s-4);
      right: var(--s-4);
      width: auto;
      min-width: 0;
    }

    /* Hero-läget behåller sin egen förankring på mobilen. static-regeln
       ovanför finns för sidhuvudet, där ett fält som börjar 110 px in på
       skärmen inte kan bära panelen. Hero-fältet spänner nästan hela
       spalten, så panelen ska sitta på fältet, inte på någon förälder. */
    .site-search.is-hero { position: relative; }
    .site-search.is-hero .panel { left: 0; right: 0; }

    /* Något lägre än sidhuvudets 40 vore för lätt här: fältet är ensamt på
       raden och sidans huvudhandling. 52 ger samma proportioner som 56 på
       desktop, och knappen 40 sitter kvar med 6 px luft. */
    .site-search.is-hero .search-field {
      height: 52px;
      padding-left: var(--s-4);
    }
    .site-search.is-hero .go { width: 40px; height: 40px; }

    /* Herotexten ner till golvet på mobil. 17 px (--fs-body) är för grovt i
       en smal spalt, men 16 är ett GOLV och inte ett val: under det zoomar
       iOS Safari in sidan vid fokus, se regeln ovanför. Känns fältet ändå
       stort är det höjden och platshållaren som får jobba — skriptet kortar
       redan platshållaren till "Sök ställe eller ort" på smala skärmar. */
    .site-search.is-hero .search-field input { font-size: 16px; }
  }

  @media (max-width: 380px) {
    .search-field { padding-left: var(--s-3); }
  }
</style>

<script>
  /**
   * Panelen. Allt här är förstärkning — formuläret ovanför fungerar utan
   * skript och postar till /sok.
   *
   * Raden, grupperingen, rankningen och registret bor i lib/sokforslag.
   * /sok läser samma modul, så resultatsidan kan inte rangordna annorlunda
   * än panelen som skickade dit besökaren.
   */
  import { trackKeyboard, untrackKeyboard } from '../lib/page-lock';
  import {
    actionLi,
    collect,
    completionFor,
    indexFailed,
    loadIndex,
    matchPages,
    normalise,
    ranked,
    searchIndex,
    sectionHtml,
    type Suggestion,
  } from '../lib/sokforslag';

  const root = document.querySelector<HTMLElement>('[data-sitesearch]');

  if (root) {
    const field = root.querySelector<HTMLElement>('[data-field]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;

    /** Panelens eget innehåll, ur JSON i dokumentet. Ingen hämtning. */
    const data = JSON.parse(
      root.querySelector<HTMLElement>('[data-suggest]')!.textContent!,
    ) as {
      sections: { name: string; items: Suggestion[] }[];
    };

    /** Sidorna, kartorna och artiklarna i en följd, för rankningen. */
    const pages = data.sections.flatMap((s) => s.items);

    /**
     * Tomma läget, byggt en gång. Samma funktion som ritar träffarna, alltså
     * samma rad, samma märke och samma grupprubrik. Det var precis den här
     * likheten som gick förlorad när två komponenter renderade var sin
     * variant av listan.
     */
    /* Ägaren: "ta bort populära sökningar raden i alla sökrutor på sidan".
       Tomma läget visar nu bara sajtens egna ytor, alltså sidorna, kartorna
       och artiklarna. Raden med räknade populärsökningar är borta både här
       och under heron; den fanns för den som inte visste vad hon skulle
       skriva, och den frågan löser fältets ledtext lika bra utan att fylla
       panelen med fyra genvägar till något annat än det man kom för. */
    const emptyHtml = data.sections
      .map((s) => sectionHtml(s.name, s.items, ''))
      .join('');

    /** Mac har cmd+K; ctrl+K på en Mac är dessutom emacs-bindningen "radera
     *  till radslut" i textfält och får inte kapas där. */
    const mac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);

    /**
     * Kort platshållare på smala skärmar.
     *
     * Den långa ryms inte på en telefon. Vid 375 px har fältet 152 px inre
     * bredd och texten mäter 253 px vid 16 px teckenstorlek, så en tredjedel
     * kapas och snittet hamnar mitt i "café". En avhuggen mening ser ut som
     * ett fel, inte som en ledtext.
     *
     * Texten kan inte bytas i CSS, och den får inte krympas med font-size:
     * under 16 px zoomar iOS in sidan vid fokus. Alltså byts strängen, och
     * bara i det läge där den inte får plats.
     *
     * Den långa står kvar i HTML som grundvärde. Utan skript blir mobilen
     * exakt som förut, alltså aldrig sämre än i dag, och desktop får rätt
     * text redan vid första målningen utan att vänta på den här bunten.
     */
    const PLACEHOLDER_WIDE = input.placeholder;
    const PLACEHOLDER_NARROW = 'Sök ställe eller ort';
    const narrow = matchMedia('(max-width: 640px)');
    const syncPlaceholder = () => {
      input.placeholder = narrow.matches ? PLACEHOLDER_NARROW : PLACEHOLDER_WIDE;
    };
    syncPlaceholder();
    narrow.addEventListener('change', syncPlaceholder);

    /**
     * Så många rader varje grupp visar.
     *
     * Sju verksamheter och kommuner: fler blir en katalog, inte ett förslag.
     * Tre sidor och kartor: gruppen är ett komplement till svaret, inte
     * svaret. Talen är samtidigt hur djupt rankningen sparar, se collect.
     */
    const PLACE_MAX = 7;
    const PAGE_MAX = 3;

    /** Luft mellan panelens underkant och skärmkanten. */
    const PANEL_GAP = 16;

    // Rollerna sätts av skriptet. Utan skript finns ingen combobox, och då
    // ska en skärmläsare heller inte få höra att det finns en.
    input.setAttribute('role', 'combobox');
    input.setAttribute('aria-expanded', 'false');
    input.setAttribute('aria-controls', 'site-search-list');
    input.setAttribute('aria-autocomplete', 'both');
    input.setAttribute('aria-haspopup', 'listbox');

    // ---- Registret ------------------------------------------------------

    /** Registret hämtas en gång per dokument, ur den delade modulen. */
    const fetchRegister = () =>
      loadIndex(root!.dataset.index!, root!.dataset.indexFallback ?? null);

    // ---- Panelens tillstånd ---------------------------------------------

    let options: HTMLAnchorElement[] = [];
    let active = -1;

    /**
     * id:na sätts här och inte i markupen. Raderna byggs av den delade
     * modulen, som inte vet vilken lista den ritar åt, och
     * aria-activedescendant kräver ett id per rad.
     */
    function refreshOptions() {
      options = Array.from(list.querySelectorAll<HTMLAnchorElement>('a[role="option"]'));
      options.forEach((a, i) => { a.id = `site-search-o${i}`; });
      active = -1;
      input.removeAttribute('aria-activedescendant');
    }

    function setActive(i: number) {
      const previous = options[active];
      if (previous) {
        previous.removeAttribute('data-active');
        previous.setAttribute('aria-selected', 'false');
      }
      active = i;
      const next = options[active];
      if (!next) {
        input.removeAttribute('aria-activedescendant');
        return;
      }
      next.setAttribute('data-active', '');
      next.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', next.id);
      next.scrollIntoView({ block: 'nearest' });
    }

    /**
     * Utrymmet under fältet, i pixlar, till CSS.
     *
     * Fönsterhöjden och inte visualViewport: rektangeln är i layout-
     * koordinater, och att blanda de två gav fel svar vid nypzoom. Det
     * tangentbordet tar drar CSS av separat via --keyboard-inset, som är
     * definierad mot exakt samma innerHeight (se lib/page-lock).
     */
    function sizePanel() {
      const room = window.innerHeight - field.getBoundingClientRect().bottom - PANEL_GAP;
      root!.style.setProperty('--panel-room', `${Math.round(room)}px`);
    }

    function open() {
      if (!panel.hidden) return;
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');

      sizePanel();
      // Fältet flyttar sig när sidan rullar, och då ändras utrymmet under
      // det. Passivt: mätningen får aldrig hålla upp rullningen.
      window.addEventListener('scroll', sizePanel, { passive: true });
      window.addEventListener('resize', sizePanel);
      trackKeyboard();

      // Två svävande lager i samma sidhuvud får aldrig stå öppna samtidigt.
      const picker = document.querySelector<HTMLDetailsElement>('[data-picker]');
      if (picker) picker.open = false;
    }

    function close() {
      if (panel.hidden) return;
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      setActive(-1);
      window.removeEventListener('scroll', sizePanel);
      window.removeEventListener('resize', sizePanel);
      untrackKeyboard();
    }

    function say(text: string) {
      note.textContent = text;
      note.hidden = !text;
    }

    // ---- Rendering ------------------------------------------------------

    /** Sant när senaste ändringen var framåtskrivning, inte radering. */
    let forward = false;

    function render(allowComplete: boolean) {
      const raw = input.value;
      const text = raw.trim();
      const q = normalise(text);

      if (!q) {
        list.innerHTML = emptyHtml;
        say('');
        refreshOptions();
        return;
      }


      // Sidorna ligger i dokumentet och kan svara direkt. Registret kan
      // fortfarande vara på väg, och då är en halv lista bättre än ingen.
      const loaded = searchIndex().rows.length > 0;
      const groups = loaded ? collect(q, PLACE_MAX) : null;
      const places = groups ? ranked(groups).slice(0, PLACE_MAX) : [];
      const hits = matchPages(pages, q, PAGE_MAX);

      // Sista raden går alltid till /sok. Panelen visar ett urval; den som
      // söker något bredare ska inte hamna i en återvändsgränd. Raden är en
      // handling och ritas som en sådan, avskild med en hårlinje.
      list.innerHTML =
        sectionHtml('Verksamheter och kommuner', places, q) +
        sectionHtml('Sidor och kartor', hits, q) +
        actionLi(text, `/sok/?q=${encodeURIComponent(text)}`);

      refreshOptions();

      say(
        !loaded
          ? indexFailed()
            ? 'Sökregistret gick inte att hämta just nu.'
            : 'Hämtar sökregistret…'
          : places.length || hits.length
            ? ''
            : `Inga träffar för ”${text}”`,
      );

      if (!allowComplete || !forward || !groups) return;
      // Utfyllnad bara vid framåtskrivning. Vid backsteg måste fältet lyda —
      // annars går det inte att radera det man skrivit.
      if (raw !== raw.trim() || q.length < 2) return;

      const completion = completionFor(groups);
      if (!completion || completion.length <= raw.length) return;
      if (normalise(completion).slice(0, q.length) !== q) return;

      input.value = raw + completion.slice(raw.length);
      input.setSelectionRange(raw.length, input.value.length);
      setActive(0);
    }

    /** Öppna och rita. Registret hämtas första gången någon gör det här. */
    function reveal() {
      fetchRegister().then(() => {
        // Registret kan komma efter att fältet fått text. Rita om, men fyll
        // inte i något — markören kan ha flyttats sedan dess.
        if (!panel.hidden) render(false);
      });
      open();
      render(false);
    }

    // ---- Händelser ------------------------------------------------------

    let lastLength = input.value.length;

    input.addEventListener('focus', reveal);

    input.addEventListener('input', (event) => {
      const e = event as InputEvent;
      if (e.isComposing) return;
      forward = e.inputType
        ? e.inputType.startsWith('insert')
        : input.value.length > lastLength;
      lastLength = input.value.length;
      open();
      render(true);
      lastLength = input.value.length;
    });

    input.addEventListener('keydown', (event) => {
      const key = event.key;

      if (key === 'Escape') {
        if (!panel.hidden) {
          event.preventDefault();
          close();
        }
        return;
      }

      if (key === 'ArrowDown' || key === 'ArrowUp') {
        event.preventDefault();
        if (panel.hidden) reveal();
        if (!options.length) return;
        const step = key === 'ArrowDown' ? 1 : -1;
        const next = (active + step + options.length + 1) % (options.length + 1);
        // Ett varv går genom listan och tillbaka till fältet självt (-1), så
        // att man kan bläddra sig ur listan utan att välja något. Ingen rad
        // står förvald: enter utan bläddring ska gå till /sok, precis som
        // utan skript. Kommandopaletten hade motsatt kontrakt och förvalde
        // första raden, vilket gjorde "Visa alla träffar" onåbart därifrån.
        setActive(next === options.length ? -1 : next);
        return;
      }

      if (key === 'Enter') {
        const chosen = options[active];
        if (!panel.hidden && chosen) {
          event.preventDefault();
          window.location.assign(chosen.href);
        }
        // Annars får formuläret gå till /sok, precis som utan skript.
        return;
      }

      if (key === 'Tab') close();
    });

    // ---- Genvägen -------------------------------------------------------

    /**
     * cmd+K, ctrl+K på allt annat.
     *
     * FORMEN ÄR HITTA.SE:S, PÅ ÄGARENS UTTRYCKLIGA BEGÄRAN: genvägen öppnar
     * ingen fristående ruta mitt på skärmen utan fäller ut panelen ur det
     * sökfält sidan redan har. Ägarens ord: "den kommer liksom ut från
     * original sökrutan, vilket makear sense". Den centrerade rutan (Linear,
     * Raycast) är ett appmönster; på en sökdriven sajt där fältet redan är
     * synligt ska genvägen förstärka fältet, inte konkurrera med det.
     *
     * Det den gör är alltså att fokusera fältet och markera det som står
     * där. Ingen egen vy, ingen egen lista, ingen egen rankning — det var
     * just det som gjorde att två vägar in gav två olika svar.
     */
    function shortcut() {
      input.focus();
      input.select();
      // reveal() alltid, inte bara när fokus redan låg i fältet. focus()
      // fyrar ingen händelse när elementet redan är fokuserat, och den
      // fyrar heller inte pålitligt när dokumentet självt saknar fokus.
      // Att låta genvägen bero på att en händelse råkar gå fram var en
      // onödig risk; open() gör ingenting om panelen redan är öppen.
      reveal();
    }

    document.addEventListener('keydown', (event) => {
      const chord = mac
        ? event.metaKey && !event.ctrlKey
        : event.ctrlKey && !event.metaKey;
      if (!chord || event.shiftKey || event.altKey) return;
      if (event.key !== 'k' && event.key !== 'K') return;
      if (event.repeat) return;
      // preventDefault även när vi stänger: webbläsarens egen ctrl+K
      // (sökfältet i Firefox) får aldrig slå igenom halva gångerna.
      event.preventDefault();
      if (!panel.hidden && document.activeElement === input) close();
      else shortcut();
    });

    /*
     * Genvägsmärket i fältet ([data-palette-hint]): tecknet byts efter
     * plattformen, märket väcks bara på enheter med tangentbord, och klicket
     * gör samma sak som genvägen. Bara den första rutan är
     * plattformsberoende — K-rutan står orörd.
     */
    const hint = root.querySelector<HTMLElement>('[data-palette-hint]');
    if (hint) {
      const mod = hint.querySelector<HTMLElement>('[data-palette-mod]');
      if (mod) mod.textContent = mac ? '⌘' : 'Ctrl';
      const fine = matchMedia('(hover: hover) and (pointer: fine)');
      const sync = () => { hint.hidden = !fine.matches; };
      sync();
      fine.addEventListener('change', sync);
      hint.addEventListener('click', shortcut);
    }

    // ---- Musen ----------------------------------------------------------

    // Musen ska markera samma rad som tangentbordet skulle ha gjort.
    list.addEventListener('mousemove', (event) => {
      const link = (event.target as HTMLElement).closest('a[role="option"]');
      if (!link) return;
      const i = options.indexOf(link as HTMLAnchorElement);
      if (i >= 0 && i !== active) setActive(i);
    });

    /**
     * Att klicka på ett förslag ska ta en dit. Direkt.
     *
     * Det är svårare än det låter. Raderna ÄR länkar, men ett klick i panelen
     * tar först fokus från fältet. Stänger vi panelen när fokus försvinner
     * hinner raden försvinna innan musknappen släpps — klicket landar på
     * sidan bakom och ingenting händer. Precis det felet fanns här: fältet
     * fylldes i, men man kom ingenstans.
     *
     * Tre spärrar, för de tre vägarna in:
     *  - mousedown utan default → mus flyttar aldrig fokus från fältet
     *  - pointerdown-flaggan    → pekskärm, där fokus tappas ändå
     *  - egen click-hanterare   → navigerar även om länkens default missas
     */
    panel.addEventListener('mousedown', (event) => event.preventDefault());

    let pointerHeld = false;
    panel.addEventListener('pointerdown', () => { pointerHeld = true; });
    document.addEventListener('pointerup', () => { pointerHeld = false; });

    list.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        'a[role="option"]',
      );
      if (!link) return;
      const e = event as MouseEvent;
      // Cmd/Ctrl/shift och mittenklick öppnar i ny flik — rör dem inte.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      event.preventDefault();
      window.location.assign(link.href);
    });

    root.addEventListener('focusout', (event) => {
      if (pointerHeld) return;
      const to = (event as FocusEvent).relatedTarget as Node | null;
      if (!to || !root.contains(to)) close();
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) close();
    });

    // Öppnas platsväljaren ska sökpanelen stänga, och tvärtom.
    const picker = document.querySelector<HTMLDetailsElement>('[data-picker]');
    if (picker) picker.addEventListener('toggle', () => { if (picker.open) close(); });
  }
</script>
