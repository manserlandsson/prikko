---
/**
 * Faktarutor i rutnät — mönstret från ednia.
 *
 * Stort värde, liten etikett, tunn ram mellan cellerna. Skälet det fungerar:
 * siffran blir skumbar på en halv sekund, och rutnätet ger sidan struktur
 * utan att lägga till ännu ett flytande kort.
 */
import InfoTip from './InfoTip.astro';

export interface Fact {
  label: string;
  value: string;
  /** Liten enhet efter värdet, t.ex. "%" eller "kontroller". */
  unit?: string;
  /** Färgar värdet. Utelämna för neutral text. */
  color?: string;
  tip?: string;
}

interface Props {
  title?: string;
  titleTip?: string;
  facts: Fact[];
}

const { title, titleTip, facts } = Astro.props;
---

<section class="factgrid">
  {title && (
    <h3 class="title">
      {title}
      {titleTip && <InfoTip label={title} text={titleTip} />}
    </h3>
  )}

  <div class="grid">
    {facts.map((f) => (
      <div class="cell">
        <p class="label">
          {f.label}
          {f.tip && <InfoTip label={f.label} text={f.tip} />}
        </p>
        <p class="value" style={f.color ? `color: ${f.color}` : undefined}>
          {f.value}
          {f.unit && <span class="unit">{f.unit}</span>}
        </p>
      </div>
    ))}
  </div>
</section>

<style>
  .title {
    font-size: var(--fs-body-s);
    font-weight: 600;
    color: var(--brand);
    margin-bottom: var(--s-3);
  }

  /* Delade ramar: ett rutnät, inte fyra fristående kort.
   *
   * INGEN overflow: hidden här. Den satt tidigare för att kapa cellernas
   * ramar vid de rundade hörnen — men den kapade också InfoTip-bubblorna,
   * som ligger ovanför sin cell. Följden var att förklaringarna till
   * "Kontroller totalt", "Utan anmärkning" och "Återbesök" inte gick att
   * läsa alls.
   *
   * Rundade hörn och utstickande bubblor går inte att förena i ren CSS, och
   * sajten är noll-JS. Då väger informationen tyngre än hörnen: kvar blir en
   * hårfin linje som korsar kurvan i nedre högra hörnet. Den kostnaden är
   * mindre än en förklaring ingen kan läsa. */
  /* Linjerna mellan cellerna är MELLANRUM, inte ramar.
   *
   * Cellerna hade tidigare border-right och border-bottom var. De ritades
   * ovanpå rutnätets egen ram, så höger- och underkanten fick dubbla linjer,
   * och eftersom overflow: hidden är borttagen korsade de raka cellramarna de
   * rundade hörnen. Resultatet såg ut som en grå fyrkant runt en redan rundad
   * ruta.
   *
   * Nu är rutnätets bakgrund hårlinjefärgen och cellerna ligger med en pixels
   * mellanrum ovanpå den. Linjerna blir exakt en pixel, aldrig dubbla, och de
   * slutar av sig själva vid kanten. Det fungerar dessutom när rutnätet bryter
   * till flera rader på smal skärm, vilket en border-lösning gör klumpigt. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
  }

  .cell {
    padding: var(--s-3) var(--s-4);
    background: var(--card);
  }

  .label {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
  }

  .value {
    margin-top: 2px;
    font-size: 21px;
    font-weight: 600;
    line-height: 26px;
    letter-spacing: -.015em;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    font-size: var(--fs-body-s);
    font-weight: 400;
    color: var(--text-secondary);
    margin-left: 3px;
  }
</style>
