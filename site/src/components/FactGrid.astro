---
/**
 * Nyckelfakta i rad — Boolis form.
 *
 * Liten etikett över stort värde, kolumner skilda av luft i stället för
 * ramar. Rutnätet med hårlinjer mellan cellerna (ednias mönster) satt här
 * tidigare, men ägarens riktmärke är numera booli, och deras faktarad är
 * öppen: inga lådor, ingen ram, bara typografin som bär hierarkin. Det är
 * det som gör att mycket information läser lugnt.
 */
import InfoTip from './InfoTip.astro';

export interface Fact {
  label: string;
  value: string;
  /** Liten enhet efter värdet, t.ex. "%" eller "kontroller". */
  unit?: string;
  /** Färgar värdet. Utelämna för neutral text. */
  color?: string;
  /**
   * Färgprick före etiketten, som CSS-värde, när raden är teckenförklaring
   * till en stapel ovanför.
   *
   * Prickens mått är Fordelning.astro:s, ned till pixeln: 10 x 10, radie 3,
   * 8 px före etiketten och en pixel upp så att den inte hänger under raden.
   * Kommunhubbens och verksamhetspanelens fördelningar har den redan, och
   * kedjesidan hade en stapel i fyra färger med en helt oprickad rad under.
   * Färgen kunde alltså inte kopplas till någon text.
   *
   * Prickar bara VÄRDET som redan står i klartext bredvid; den är aldrig
   * ensam informationsbärare, se tokens.css. Utelämnad ritas ingenting, och
   * verksamhetssidans faktarad ser därför ut precis som förut.
   */
  dot?: string;
  tip?: string;
}

interface Props {
  title?: string;
  titleTip?: string;
  facts: Fact[];
}

const { title, titleTip, facts } = Astro.props;
---

<section class="factgrid">
  {title && (
    <h3 class="title">
      {title}
      {titleTip && <InfoTip label={title} text={titleTip} />}
    </h3>
  )}

  <div class="grid">
    {facts.map((f) => (
      <div class="cell">
        <p class="label">
          {f.dot && <span class="prick" style={`background:${f.dot}`} aria-hidden="true"></span>}
          {f.label}
          {f.tip && <InfoTip label={f.label} text={f.tip} />}
        </p>
        <p class="value" style={f.color ? `color: ${f.color}` : undefined}>
          {f.value}
          {f.unit && <span class="unit">{f.unit}</span>}
        </p>
      </div>
    ))}
  </div>
</section>

<style>
  .title {
    font-size: var(--fs-body-s);
    font-weight: 600;
    color: var(--brand);
    margin-bottom: var(--s-3);
  }

  /* Öppna kolumner utan lådor, som Boolis rad under priset. Kolumnbredden
   * är innehållets egen och luften däremellan gör avgränsningen. En tidigare
   * version ritade ett rutnät med hårlinjer mellan cellerna; historien om
   * dess overflow-problem med InfoTip-bubblorna ligger i git-historiken.
   * Den öppna formen har inget att kapa, så problemet finns inte längre. */
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-8);
  }

  .label {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
  }

  /* Samma prick som i Fordelning.astro, samma mått av samma skäl: två
     teckenförklaringar på samma sajt får inte ha var sin form. Betydelsen
     står i texten bredvid, alltså bär prickens kontrast ingen information
     och behöver inte klara 3:1.

     Luften ligger på prickens marginal och inte som `gap` på raden. InfoTip
     bär redan sina egna 6 px margin-left, och ett gap hade lagt 8 px till
     dem och flyttat varenda informationsprick på verksamhetssidan. */
  .prick {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-right: var(--s-2);
    border-radius: 3px;
  }

  .value {
    margin-top: 2px;
    font-size: var(--fs-h-s);
    font-weight: 600;
    line-height: var(--lh-body);
    letter-spacing: -.015em;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    font-size: var(--fs-body-s);
    font-weight: 400;
    color: var(--text-secondary);
    margin-left: 3px;
  }
</style>
