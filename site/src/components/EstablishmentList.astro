---
/**
 * Kommunhubbens lista. Delas av sida 1 (/[kommun]) och resten
 * (/[kommun]/sida/[n]) — markup får inte glida isär mellan dem.
 */
import FaceRef from './FaceRef.astro';
import FaceSprite from './FaceSprite.astro';
import { formatDate, isIndexable, latestInspectionDate, type Establishment } from '../lib/data';
import { VERDICT } from '../lib/site';
import { path } from '../lib/urls';

interface Props {
  items: Establishment[];
  kommunSlug: string;
}

const { items, kommunSlug } = Astro.props;
---

<FaceSprite />

<ul class="list">
  {items.map((e) => {
    const date = latestInspectionDate(e);
    return (
      <li class="item">
        <a href={path(kommunSlug, e.slug)} rel={isIndexable(e) ? undefined : 'nofollow'}>
          <FaceRef verdict={e.verdict} size={38} />
          <span class="info">
            <b>{e.name}</b>
            <span class="meta text-secondary">
              {/* Karlstad publicerar ingen adress. Utan filtret blir raden
                  " · kontrollerad 17 juni 2026" med en hängande punkt. */}
              {[e.address, date && `kontrollerad ${formatDate(date)}`].filter(Boolean).join(' · ')}
            </span>
          </span>
          <span
            class="verdict"
            style={`color: ${e.verdict ? VERDICT[e.verdict].colorVar : 'var(--verdict-none-ink)'}`}
          >
            {e.verdict ? VERDICT[e.verdict].label : 'Ingen kontroll'}
          </span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  /* Raderna är inga kort.
   *
   * Booli mätt i webbläsaren på sökresultatsidan: träffraden har genomskinlig
   * bakgrund, ingen ram, ingen skugga, radie 0 och 24 px luft, och listan
   * hålls ihop av en hårlinje per rad. Vi låg tvärtom på ett vitt kort per
   * verksamhet, alltså hundra svävande rutor efter varandra, sidans
   * tydligaste avvikelse från förlagan. Se docs/19_formsystem.md.
   *
   * Luften är --s-3 och inte Boolis 24: deras rad bär en 308 px bild, vår bär
   * ett ansikte på 38 px. Samma luft hade gett en rad som är mest tomrum.
   */
  .list {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    /* Hårlinje över och under listan stänger den mot lyftet ovanför och
       sidnumreringen under. */
    border-block: 1px solid var(--hairline);
  }

  .item + .item { border-top: 1px solid var(--hairline); }

  .item a {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    /* Vågrät luft med negativ marginal: texten står kant i kant med spalten,
       men markeringen vid pekning får andas utanför den. */
    padding: var(--s-3) var(--s-3);
    margin-inline: calc(var(--s-3) * -1);
    color: var(--text);
  }

  .item a:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 4%, transparent);
    border-radius: var(--r-control);
  }

  .info {
    flex: 1;
    min-width: 0;
  }

  .info b {
    display: block;
    font-size: var(--fs-body-s);
    font-weight: 600;
  }

  .meta {
    font-size: var(--fs-caption);
  }

  .verdict {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-align: right;
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .verdict { display: none; }
  }
</style>
