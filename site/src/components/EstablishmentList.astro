---
/**
 * Kommunhubbens lista. Delas av sida 1 (/[kommun]) och resten
 * (/[kommun]/sida/[n]) — markup får inte glida isär mellan dem.
 */
import FaceRef from './FaceRef.astro';
import FaceSprite from './FaceSprite.astro';
import { formatDate, isIndexable, latestInspectionDate, type Establishment } from '../lib/data';
import { avregistrerad } from '../lib/registrering';
import { AVREGISTRERAD, VERDICT } from '../lib/site';
import { path } from '../lib/urls';

interface Props {
  items: Establishment[];
  kommunSlug: string;
}

const { items, kommunSlug } = Astro.props;
---

<FaceSprite />

{/* MALLEN FÖR EN RAD SOM RITAS I WEBBLÄSAREN.
    Registerfilter.astro byter listan mot kommunens hela register när någon
    söker eller smalnar av. Raden klonas härifrån och inte ur en sträng i
    skriptet, av två skäl: markupen kan inte glida isär från raderna nedanför,
    och Astros scopeade klassattribut följer med, så att samma stilar gäller
    utan att de görs globala. Fälten fylls via data-f. */}
<template data-register-rad>
  <li class="item">
    <a href="/">
      <FaceRef verdict={null} size={38} />
      <span class="info">
        <b>
          <span data-f="namn"></span>
          <span class="avreg" data-f="avreg" hidden>{AVREGISTRERAD.heading}</span>
        </b>
        <span class="meta text-secondary" data-f="meta"></span>
      </span>
      <span class="verdict" data-f="verdict"></span>
    </a>
  </li>
</template>

<ul class="list" data-register-lista>
  {items.map((e) => {
    const date = latestInspectionDate(e);
    return (
      <li class="item">
        <a href={path(kommunSlug, e.slug)} rel={isIndexable(e) ? undefined : 'nofollow'}>
          <FaceRef verdict={e.verdict} size={38} />
          <span class="info">
            {/* MÄRKET LIGGER I NAMNRADEN, inte i metaraden under.

                Metaraden bär adress och kontrolldatum, alltså uppgifter om
                stället. Att registreringen upphört är en uppgift om RADEN
                man tittar på, och den ska mötas i samma ögonkast som namnet.
                Inuti <b> och inte som syskon: elementet är display:block, så
                ett syskon hade hamnat på egen rad medan pillret nu flyter
                efter namnet och bryter först när det inte får plats. */}
            <b>
              {e.name}
              {avregistrerad(e) && <span class="avreg">{AVREGISTRERAD.heading}</span>}
            </b>
            <span class="meta text-secondary">
              {/* Karlstad publicerar ingen adress. Utan filtret blir raden
                  " · kontrollerad 17 juni 2026" med en hängande punkt. */}
              {[e.address, date && `kontrollerad ${formatDate(date)}`].filter(Boolean).join(' · ')}
            </span>
          </span>
          <span
            class="verdict"
            style={`color: ${e.verdict ? VERDICT[e.verdict].colorVar : 'var(--verdict-none-ink)'}`}
          >
            {e.verdict ? VERDICT[e.verdict].label : 'Ingen kontroll'}
          </span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  /* Raderna är inga kort.
   *
   * Booli mätt i webbläsaren på sökresultatsidan: träffraden har genomskinlig
   * bakgrund, ingen ram, ingen skugga, radie 0 och 24 px luft, och listan
   * hålls ihop av en hårlinje per rad. Vi låg tvärtom på ett vitt kort per
   * verksamhet, alltså hundra svävande rutor efter varandra, sidans
   * tydligaste avvikelse från förlagan. Se docs/19_formsystem.md.
   *
   * Luften är --s-3 och inte Boolis 24: deras rad bär en 308 px bild, vår bär
   * ett ansikte på 38 px. Samma luft hade gett en rad som är mest tomrum.
   */
  .list {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    /* Hårlinje över och under listan stänger den mot lyftet ovanför och
       sidnumreringen under. */
    border-block: 1px solid var(--hairline);
  }

  .item + .item { border-top: 1px solid var(--hairline); }

  .item a {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    /* Vågrät luft med negativ marginal: texten står kant i kant med spalten,
       men markeringen vid pekning får andas utanför den. */
    padding: var(--s-3) var(--s-3);
    margin-inline: calc(var(--s-3) * -1);
    color: var(--text);
  }

  .item a:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 4%, transparent);
    border-radius: var(--r-control);
  }

  .info {
    flex: 1;
    min-width: 0;
  }

  .info b {
    display: block;
    font-size: var(--fs-body-s);
    font-weight: 600;
  }

  .meta {
    font-size: var(--fs-caption);
  }

  /*
   * ══ MÄRKET FÖR EN VERKSAMHET SOM INTE LÄNGRE ÄR REGISTRERAD ════════════
   *
   * GRÅTT OCH OFYLLT, och det är ett krav och inte smak. Raden bär redan en
   * färgskala i ansiktet till vänster och i bedömningsordet till höger, och
   * varje färg i den betyder något om HYGIENEN. Ett fyllt pillret i en fjärde
   * färg hade lästs in i samma skala och blivit ett omdöme vi inte har täckning
   * för. Kanten är --hairline, samma linje som skiljer raderna åt, och texten
   * är --text-secondary, alltså exakt metaradens ton.
   *
   * VIKT 500 OCH INTE 600. Namnet bredvid står i 600, och två halvfeta ord
   * intill varandra ger inget företräde åt namnet, som är det man letar efter.
   */
  .avreg {
    display: inline-block;
    margin-left: var(--s-2);
    padding: 0 8px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    font-size: var(--fs-caption);
    line-height: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    /* Namnet klipps aldrig mitt i märket. */
    white-space: nowrap;
    vertical-align: 1px;
  }

  /* Mallens märke bär `hidden` tills skriptet vet att raden är avregistrerad.
     Sajten har ingen global regel för [hidden], och `display: inline-block`
     ovan hade annars vunnit, alltså hade varje filtrerad rad burit märket. */
  .avreg[hidden] { display: none; }

  .verdict {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-align: right;
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .verdict { display: none; }
  }
</style>
