---
/**
 * Kontrollhistorik.
 *
 * Varje kontroll som hade avvikelser går att fälla ut och visa vad de gällde.
 * Vi håller den datan för hela historiken — tidigare visades den bara för den
 * senaste kontrollen, alltså låg ungefär 87 % av materialet oanvänt.
 *
 * Progressiv fördjupning: den som bara vill veta läget ser raden, den som vill
 * gräva öppnar den. Rader utan avvikelser är inte klickbara — en tom utfällning
 * är sämre än ingen.
 */
import KontrollTidslinje from './KontrollTidslinje.astro';
import OwnerReply from './OwnerReply.astro';
import {
  ASSESSMENT_COLOR,
  ASSESSMENT_INK,
  ASSESSMENT_LABEL,
  INSPECTION_TYPE_LABEL,
  deviations,
  formatDate,
  type Inspection,
} from '../lib/data';

interface Props {
  inspections: Inspection[];
}

const { inspections } = Astro.props;
const decisive = inspections.slice(0, 3);
const older = inspections.slice(3);

function detail(i: Inspection): string {
  const parts = [INSPECTION_TYPE_LABEL[i.type]];
  if (i.prenotified === false) parts.push('oanmäld');
  else if (i.prenotified === true) parts.push('föranmäld');
  if (i.audit) parts.push('revision');
  if (!i.onSite) parts.push('utan platsbesök');
  return parts.join(' · ');
}
---

<section class="history">
  <div class="head">
    <h2>Kontrollhistorik</h2>
    {inspections.length > 0 && (
      <p class="note text-secondary">
        Bedömningen vilar på {decisive.length === 1 ? 'den senaste kontrollen' : `de ${decisive.length} senaste`}.
      </p>
    )}
  </div>

  {inspections.length === 0 ? (
    <p class="empty text-secondary">
      Kommunen har inte registrerat någon livsmedelskontroll för den här
      verksamheten. Det betyder inte att hygienen är dålig — bara att underlag
      saknas.
    </p>
  ) : (
    <>
      {/* Översikten före detaljerna: tidslinjen visar mönstret på en blick,
          listan under bär varje kontrolls innehåll. Komponenten avgör själv
          om den har något att tillföra — under fyra kontroller eller två år
          ritas ingenting. */}
      <KontrollTidslinje inspections={inspections} />

      <ol class="rows">
        {decisive.map((i) => {
          const found = deviations(i);
          return (
            <li>
              {found.length > 0 ? (
                <details class="row expandable">
                  <summary>
                    <span class="dot" style={`background: ${ASSESSMENT_COLOR[i.assessment]}`}></span>
                    <span class="cell">
                      <b>{formatDate(i.date)}</b>
                      <span class="text-secondary">
                        {detail(i)} · {found.length} {found.length === 1 ? 'avvikelse' : 'avvikelser'}
                      </span>
                    </span>
                    <span class="status" style={`color: ${ASSESSMENT_INK[i.assessment]}`}>
                      {ASSESSMENT_LABEL[i.assessment]}
                    </span>
                  </summary>
                  <ul class="what">
                    {found.map((a) => (
                      <li>
                        <b>{a.description}</b>
                        {a.group && a.group !== a.description && (
                          <span class="text-secondary"> · {a.group}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <div class="row">
                  <span class="dot" style={`background: ${ASSESSMENT_COLOR[i.assessment]}`}></span>
                  <span class="cell">
                    <b>{formatDate(i.date)}</b>
                    <span class="text-secondary">{detail(i)}</span>
                  </span>
                  <span class="status" style={`color: ${ASSESSMENT_INK[i.assessment]}`}>
                    {ASSESSMENT_LABEL[i.assessment]}
                  </span>
                </div>
              )}
              {i.ownerComment && <OwnerReply text={i.ownerComment} />}
            </li>
          );
        })}
      </ol>

      {older.length > 0 && (
        <details class="older">
          <summary>
            Visa {older.length} tidigare {older.length === 1 ? 'kontroll' : 'kontroller'}
          </summary>
          <ol class="rows">
            {older.map((i) => {
              const found = deviations(i);
              return (
                <li>
                  {found.length > 0 ? (
                    <details class="row expandable">
                      <summary>
                        <span class="dot" style={`background: ${ASSESSMENT_COLOR[i.assessment]}`}></span>
                        <span class="cell">
                          <b>{formatDate(i.date)}</b>
                          <span class="text-secondary">
                            {detail(i)} · {found.length} {found.length === 1 ? 'avvikelse' : 'avvikelser'}
                          </span>
                        </span>
                        <span class="status text-secondary">{ASSESSMENT_LABEL[i.assessment]}</span>
                      </summary>
                      <ul class="what">
                        {found.map((a) => (
                          <li>
                            <b>{a.description}</b>
                            {a.group && a.group !== a.description && (
                              <span class="text-secondary"> · {a.group}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <div class="row">
                      <span class="dot" style={`background: ${ASSESSMENT_COLOR[i.assessment]}`}></span>
                      <span class="cell">
                        <b>{formatDate(i.date)}</b>
                        <span class="text-secondary">{detail(i)}</span>
                      </span>
                      <span class="status text-secondary">{ASSESSMENT_LABEL[i.assessment]}</span>
                    </div>
                  )}
                  {i.ownerComment && <OwnerReply text={i.ownerComment} />}
                </li>
              );
            })}
          </ol>
        </details>
      )}
    </>
  )}
</section>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .note,
  .empty { font-size: var(--fs-body-s); line-height: 20px; }
  .empty { margin-top: var(--s-2); }

  .rows { list-style: none; margin: var(--s-4) 0 0; padding: 0; }
  .rows > li { border-top: 1px solid var(--hairline); }

  .row,
  .row.expandable > summary {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) 0;
  }

  /* details får ALDRIG vara grid: då hamnar hela summary i första kolumnen,
     som är 8 px bred, och raden kollapsar till en tecken-per-rad-spalt. */
  .row.expandable {
    display: block;
    padding: 0;
  }

  .row.expandable > summary {
    cursor: pointer;
    list-style: none;
  }
  .row > summary::-webkit-details-marker { display: none; }
  .row > summary:hover b { color: var(--brand); }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    align-self: center;
  }

  .cell b {
    display: block;
    font-size: var(--fs-body-s);
    font-weight: 600;
    line-height: 20px;
    font-variant-numeric: tabular-nums;
  }

  .cell span { font-size: var(--fs-caption); }

  .status {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-align: right;
    min-width: 92px;
  }

  /* Utfälld lista över vad kontrollen faktiskt anmärkte på. */
  .what {
    list-style: none;
    margin: 0 0 var(--s-3);
    padding: var(--s-3) 0 0 20px;
    border-top: 1px dashed var(--hairline);
  }

  .what li {
    font-size: var(--fs-caption);
    line-height: 19px;
    padding: 3px 0;
  }

  .what b { font-weight: 600; }
  .code { font-variant-numeric: tabular-nums; }

  .older { margin-top: var(--s-4); }

  .older > summary {
    font-size: var(--fs-body-s);
    color: var(--brand);
    cursor: pointer;
  }
</style>
