---
/**
 * Leaderboard: verksamheter med anmärkningar. Hela sidan, delad mellan
 * sida 1 (/[kommun]/anmarkningar) och resten (.../sida/[n]).
 *
 * SEO-dimensioneringen visade att enskilda restaurangnamn knappt söks alls,
 * men att "sämsta restaurangen i [stad]" autocompletar i åtta svenska städer.
 * Den här sidtypen är alltså spjutspetsen, inte katalogen.
 *
 * Rubriken är medvetet "med anmärkningar" och inte "sämst". Juridiskt är
 * skillnaden avgörande: "sämst" är vårt eget omdöme att försvara, medan
 * "har anmärkningar vid senaste kontrollen" är kommunens konstaterande som vi
 * återger. Sidan fångar samma sökintention utan att bli ett påstående.
 */
import Base from '../layouts/Base.astro';
import FaceRef from './FaceRef.astro';
import FaceSprite from './FaceSprite.astro';
import Pagination from './Pagination.astro';
import {
  formatDate,
  formatNumber,
  latestInspectionDate,
  type Municipality,
  type RemarkedEstablishment,
} from '../lib/data';
import { hasMatsnuskPage } from '../lib/matsnusk';
import { pageUrl } from '../lib/pagination';
import { report } from '../lib/rapporter';
import { SITE, VERDICT } from '../lib/site';
import { absolute, path } from '../lib/urls';

interface Props {
  kommun: Municipality;
  items: RemarkedEstablishment[];
  currentPage: number;
  lastPage: number;
  start: number;
  total: number;
  /** Antal bedömda verksamheter i kommunen — nämnaren i svarsmeningen. */
  assessed: number;
  major: number;
  fetchedAt: string;
}

const { kommun, items, currentPage, lastPage, start, total, assessed, major, fetchedAt } =
  Astro.props;

const city = kommun.city;
const base = `/${kommun.slug}/anmarkningar`;

/*
 * Självbärande första mening, skriven för att kunna citeras rakt av.
 *
 * Svansen sade "varav N där bristerna kvarstår efter uppföljning" fram till
 * 2026-09-05. Uppföljningen är bara en av tre grunder för nivån: 130 av 403
 * verksamheter i beståndet har ingen uppföljning alls i datan, bara
 * avvikelser också vid kontrollen före. Etiketten bär alla tre och används
 * därför rakt av här; grunden per verksamhet står på verksamhetssidan. Se
 * lib/omdome.ts.
 */
const answer = `${formatNumber(total)} av ${formatNumber(assessed)} kontrollerade verksamheter i ${city} hade anmärkningar vid sin senaste hygienkontroll, varav ${formatNumber(major)} med brister som kvarstår.`;

const title =
  currentPage === 1
    ? `Restauranger med anmärkningar i ${city}`
    : `Restauranger med anmärkningar i ${city}, sida ${currentPage} av ${lastPage}`;

const description =
  currentPage === 1
    ? answer
    : `Plats ${formatNumber(start)}–${formatNumber(start + items.length - 1)} av ${formatNumber(total)} verksamheter med anmärkningar i ${city}. Sida ${currentPage} av ${lastPage}.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
      { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(kommun.slug) },
      ...(currentPage === 1
        ? [{ '@type': 'ListItem', position: 3, name: 'Anmärkningar' }]
        : [
            { '@type': 'ListItem', position: 3, name: 'Anmärkningar', item: absolute(base) },
            { '@type': 'ListItem', position: 4, name: `Sida ${currentPage}` },
          ]),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Verksamheter med anmärkningar i ${city}`,
    numberOfItems: total,
    // Bara sidans egna poster, med sin riktiga position i hela listan.
    itemListElement: items.slice(0, 25).map((e, i) => ({
      '@type': 'ListItem',
      position: start + i,
      url: absolute(kommun.slug, e.slug),
      name: e.name,
    })),
  },
];

/**
 * Den enda rapport som svarar på frågan sidan väcker.
 *
 * Sidan listar anmärkningar utan att säga vad en anmärkning gäller, och det
 * är precis vad rapporten räknat fram. Länken är redaktionell och inte
 * dekoration: fram tills nu länkades ingen enskild rapport från någon annan
 * sida än rapportindex, alltså var sajtens två citerbaraste sidor de sämst
 * länkade av alla.
 *
 * Slugen slås upp genom `report()`, som kastar på okänd slug. Byter rapporten
 * adress stannar bygget här i stället för att lämna en död länk på tjugotre
 * sidor.
 */
const areaReport = report('vad-anmarkningarna-galler');

const prev = currentPage > 1 ? pageUrl(base, currentPage - 1, SITE.url) : undefined;
const next = currentPage < lastPage ? pageUrl(base, currentPage + 1, SITE.url) : undefined;
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  dataUpdated={fetchedAt.slice(0, 10)}
  prev={prev}
  next={next}
>
  <FaceSprite />

  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path(kommun.slug)}>{city}</a>
      {currentPage > 1 && (
        <>
          <span aria-hidden="true">›</span>
          <a href={path(base)}>Anmärkningar</a>
        </>
      )}
    </nav>

    <header>
      <p class="eyebrow">{kommun.name}</p>
      <h1>
        Restauranger med anmärkningar i {city}
        {currentPage > 1 && <span class="text-secondary">, sida {currentPage}</span>}
      </h1>
      <p class="answer">{answer}</p>
    </header>

    <ol class="list" start={start}>
      {items.map((e, i) => {
        const date = latestInspectionDate(e);
        return (
          <li>
            <a href={path(kommun.slug, e.slug)}>
              <span class="rank text-muted">{start + i}</span>
              <FaceRef verdict={e.verdict} size={36} />
              <span class="body">
                <b>{e.name}</b>
                <span class="meta text-secondary">
                  {/*
                    DATUMET FÖRST, OCH BEDÖMNINGEN SIST. Rättat 2026-09-05.

                    Adressen stod först och saknas i vissa kommuner: Karlstad
                    och Lomma publicerar knappt någon. Uppmätt över de tolv
                    kommunernas 1 730 listrader: 181 av dem, 10,5 procent,
                    saknar adress medan 0 saknar datum. Raden utan adress
                    började alltså med ett datum medan grannraderna började med
                    en gata, och kolumnen bröts precis där. Med datumet först är
                    radens FÖRSTA uppgift av samma slag på varenda rad, och det
                    som kan utebli står inuti raden i stället för i dess kant.

                    Bedömningen stod som en egen spalt i högerkanten, i rött
                    halvfett. Se `.verdict` i stilarna nedan för varför den
                    spalten är borta och ordet står här. Sist av samma skäl som
                    datumet står först: radens båda ändar ska vara av samma
                    slag på alla rader.

                    Separatorerna får aldrig hänga löst, därav filtret.
                  */}
                  {[
                    date && formatDate(date),
                    e.address,
                    e.remarks > 0 && `${e.remarks} ${e.remarks === 1 ? 'avvikelse' : 'avvikelser'}`,
                    VERDICT[e.verdict!].label,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>

    <Pagination
      base={base}
      current={currentPage}
      last={lastPage}
      label={`verksamheter med anmärkningar i ${city}`}
    />

    <footer class="foot">
      <p class="text-secondary">
        Många anmärkningar åtgärdas snabbt och följs upp vid ett återbesök.
        Hela historiken står på varje verksamhets sida. Bedömningen är Prikkos,
        räknad ur kommunens senaste kontroll, hämtad
        {' '}{formatDate(fetchedAt.slice(0, 10))}.
        {' '}<a href="/metodik/">Så räknas den fram</a>.
      </p>
      {/* Matsnusklistan finns bara i kommuner med nog många rader för en
          egen sida (lib/matsnusk.ts). Länken får aldrig peka ut i tomma
          intet, därför grinden även här. */}
      {hasMatsnuskPage(kommun.slug) && (
        <p>
          <a href={path(kommun.slug, 'matsnusk')}>
            Matsnusk i {city}: verksamheter där bristerna kvarstår
          </a>
        </p>
      )}
      <p>
        <a href={path('rapporter', areaReport.slug)}>{areaReport.title}</a>: vilka
        områden i livsmedelslagstiftningen anmärkningarna faktiskt gäller,
        räknat över hela beståndet
      </p>
      <p>
        <a href={path(kommun.slug)}>Se alla verksamheter i {city}</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .page { max-width: var(--w-page); padding-block: var(--s-6) var(--s-16); }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  h1 { font-size: var(--fs-title); line-height: var(--lh-title); margin-top: var(--s-1); }
  h1 span { font-weight: 400; }

  .answer {
    margin-top: var(--s-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  .list {
    list-style: none;
    counter-reset: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .list li + li { border-top: 1px solid var(--hairline); }

  .list a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
  }

  .list a:hover { text-decoration: none; background: color-mix(in srgb, var(--brand) 4%, transparent); }
  .list a:hover b { color: var(--brand); }

  .rank {
    width: 28px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-variant-numeric: tabular-nums;
    text-align: right;
    flex-shrink: 0;
  }

  /* Radens två textrader bar prosans radhöjd, 26 px, för att ingen av dem satte
     någon egen och `body` ärver ned. Det är fel grad på fel plats: 26 px är
     avvägt för 17 px löpande text, och här bär det ett 14 px namn (kvot 1,86)
     och en 13 px metarad (kvot 2,00). Raden blev 76 px hög varav 52 px enbart
     radavstånd, och det är vad ägaren såg.

     Varje grad får nu sin egen radhöjd ur skalan, 14/24 och 13/18. Inga nya tal
     uppfunna: 24 är Boolis uppmätta metatextvärde och 18 är vår egen
     bildtextrad. Raden går från 76 till 66 px. */
  .body { flex: 1; min-width: 0; }
  .body b { display: block; font-size: var(--fs-body-s); line-height: var(--lh-body-s); font-weight: 600; }
  .meta { display: block; font-size: var(--fs-caption); line-height: var(--lh-caption); }

  /* HÄR LÅG `.verdict`, EN EGEN SPALT I RÖTT HALVFETT.
   *
   * Listan är sorterad allvarligast först, så etiketten byter värde exakt en
   * gång i hela listan och står oförändrad på varenda synlig rad: tretton
   * "Brister som kvarstår" i rad på `/stockholm/anmarkningar/`, uppmätt
   * 2026-09-05. Kolumnen skilde alltså inga rader åt, den drog ett rött band
   * längs sidans högerkant och blev sidans starkaste grafiska element. Sidan
   * heter "med anmärkningar" och ingressen har redan sagt vad listan är.
   *
   * Ordet är inte borttaget utan flyttat in i metaraden, i samma grå som
   * resten av den. Det VINNER dessutom på flytten: spalten doldes under
   * 560 px, alltså fanns bedömningen inte alls i text på telefon, och
   * bedömningsmärket till vänster är `aria-hidden`. Nu står den i klartext
   * vid varje bredd och för varje skärmläsare.
   *
   * Färgen bärs av märket, som ligger kvar. Det är samma ordning som resten
   * av sajten: färgen är aldrig ensam bärare, och ordet behöver inte färgas
   * för att bära. Se tokens.css.
   */

  .foot {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .foot p { font-size: var(--fs-body-s); line-height: 21px; }
  .foot p + p { margin-top: var(--s-3); }
</style>
