---
/**
 * Leaderboard: verksamheter med anmärkningar. Hela sidan, delad mellan
 * sida 1 (/[kommun]/anmarkningar) och resten (.../sida/[n]).
 *
 * SEO-dimensioneringen visade att enskilda restaurangnamn knappt söks alls,
 * men att "sämsta restaurangen i [stad]" autocompletar i åtta svenska städer.
 * Den här sidtypen är alltså spjutspetsen, inte katalogen.
 *
 * Rubriken är medvetet "med anmärkningar" och inte "sämst". Juridiskt är
 * skillnaden avgörande: "sämst" är vårt eget omdöme att försvara, medan
 * "har anmärkningar vid senaste kontrollen" är kommunens konstaterande som vi
 * återger. Sidan fångar samma sökintention utan att bli ett påstående.
 */
import Base from '../layouts/Base.astro';
import FaceRef from './FaceRef.astro';
import FaceSprite from './FaceSprite.astro';
import Pagination from './Pagination.astro';
import {
  formatDate,
  formatNumber,
  latestInspectionDate,
  type Municipality,
  type RemarkedEstablishment,
} from '../lib/data';
import { pageUrl } from '../lib/pagination';
import { SITE, VERDICT } from '../lib/site';

interface Props {
  kommun: Municipality;
  items: RemarkedEstablishment[];
  currentPage: number;
  lastPage: number;
  start: number;
  total: number;
  /** Antal bedömda verksamheter i kommunen — nämnaren i svarsmeningen. */
  assessed: number;
  major: number;
  fetchedAt: string;
}

const { kommun, items, currentPage, lastPage, start, total, assessed, major, fetchedAt } =
  Astro.props;

const city = kommun.city;
const base = `/${kommun.slug}/anmarkningar`;

// Självbärande första mening, skriven för att kunna citeras rakt av.
const answer = `${formatNumber(total)} av ${formatNumber(assessed)} kontrollerade verksamheter i ${city} hade anmärkningar vid sin senaste hygienkontroll, varav ${formatNumber(major)} där bristerna kvarstår efter uppföljning.`;

const title =
  currentPage === 1
    ? `Restauranger med anmärkningar i ${city}`
    : `Restauranger med anmärkningar i ${city}, sida ${currentPage} av ${lastPage}`;

const description =
  currentPage === 1
    ? answer
    : `Plats ${formatNumber(start)}–${formatNumber(start + items.length - 1)} av ${formatNumber(total)} verksamheter med anmärkningar i ${city}. Sida ${currentPage} av ${lastPage}.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Prikko', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: kommun.name, item: `${SITE.url}/${kommun.slug}` },
      ...(currentPage === 1
        ? [{ '@type': 'ListItem', position: 3, name: 'Anmärkningar' }]
        : [
            { '@type': 'ListItem', position: 3, name: 'Anmärkningar', item: `${SITE.url}${base}` },
            { '@type': 'ListItem', position: 4, name: `Sida ${currentPage}` },
          ]),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Verksamheter med anmärkningar i ${city}`,
    numberOfItems: total,
    // Bara sidans egna poster, med sin riktiga position i hela listan.
    itemListElement: items.slice(0, 25).map((e, i) => ({
      '@type': 'ListItem',
      position: start + i,
      url: `${SITE.url}/${kommun.slug}/${e.slug}`,
      name: e.name,
    })),
  },
];

const prev = currentPage > 1 ? pageUrl(base, currentPage - 1, SITE.url) : undefined;
const next = currentPage < lastPage ? pageUrl(base, currentPage + 1, SITE.url) : undefined;
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  dataUpdated={fetchedAt.slice(0, 10)}
  prev={prev}
  next={next}
>
  <FaceSprite />

  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={`/${kommun.slug}`}>{city}</a>
      {currentPage > 1 && (
        <>
          <span aria-hidden="true">›</span>
          <a href={base}>Anmärkningar</a>
        </>
      )}
    </nav>

    <header>
      <p class="eyebrow">{kommun.name}</p>
      <h1>
        Restauranger med anmärkningar i {city}
        {currentPage > 1 && <span class="text-secondary">, sida {currentPage}</span>}
      </h1>
      <p class="answer">{answer}</p>
      <p class="caption text-muted">
        Bygger på kommunens senaste kontroll av varje verksamhet, hämtad
        {' '}{formatDate(fetchedAt.slice(0, 10))}.
        <a href="/metodik">Så räknas bedömningen fram</a>.
      </p>
    </header>

    <ol class="list" start={start}>
      {items.map((e, i) => {
        const date = latestInspectionDate(e);
        return (
          <li>
            <a href={`/${kommun.slug}/${e.slug}`}>
              <span class="rank text-muted">{start + i}</span>
              <FaceRef verdict={e.verdict} size={36} />
              <span class="body">
                <b>{e.name}</b>
                <span class="meta text-secondary">
                  {/* Adressen saknas i vissa kommuner — Karlstad publicerar
                      ingen. Separatorerna får inte hänga löst då. */}
                  {[
                    e.address,
                    date && formatDate(date),
                    e.remarks > 0 && `${e.remarks} ${e.remarks === 1 ? 'avvikelse' : 'avvikelser'}`,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </span>
              <span class="verdict" style={`color: ${VERDICT[e.verdict!].colorVar}`}>
                {VERDICT[e.verdict!].label}
              </span>
            </a>
          </li>
        );
      })}
    </ol>

    <Pagination
      base={base}
      current={currentPage}
      last={lastPage}
      label={`verksamheter med anmärkningar i ${city}`}
    />

    <footer class="foot">
      <p class="text-secondary">
        En anmärkning betyder att kommunen konstaterat en avvikelse vid
        kontrollen. Många åtgärdas snabbt och följs upp vid ett återbesök.
        Varje verksamhets sida visar hela historiken.
      </p>
      <p>
        <a href={`/${kommun.slug}`}>Se alla verksamheter i {city}</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .page { max-width: 820px; padding-block: var(--s-6) var(--s-16); }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  h1 { font-size: 34px; line-height: 38px; margin-top: var(--s-1); }
  h1 span { font-weight: 400; }

  .answer {
    margin-top: var(--s-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  header .caption { margin-top: var(--s-3); }

  .list {
    list-style: none;
    counter-reset: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .list li + li { border-top: 1px solid var(--hairline); }

  .list a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
  }

  .list a:hover { text-decoration: none; background: color-mix(in srgb, var(--brand) 4%, transparent); }
  .list a:hover b { color: var(--brand); }

  .rank {
    width: 28px;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    text-align: right;
    flex-shrink: 0;
  }

  .body { flex: 1; min-width: 0; }
  .body b { display: block; font-size: var(--fs-body-s); font-weight: 600; }
  .meta { display: block; font-size: var(--fs-caption); }

  .verdict {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-align: right;
    flex-shrink: 0;
  }

  .foot {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .foot p { font-size: var(--fs-body-s); line-height: 21px; }
  .foot p + p { margin-top: var(--s-3); }

  @media (max-width: 560px) {
    .verdict { display: none; }
  }
</style>
