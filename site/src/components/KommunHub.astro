---
/**
 * Kommunhubben — hela sidan, delad mellan sida 1 och resten av serien.
 *
 * Bär den interna länkgrafen: utan den här sidan är varje restaurangsida
 * föräldralös, och Google hittar dem bara via sitemap — vilket är en svagare
 * signal än en riktig länk från en sida med kontext.
 *
 * Sidan är indelad i riktiga sidor (se lib/pagination.ts). Sida 1 ligger på
 * /[kommun] och har ingen egen /sida/1 — annars hade vi publicerat samma
 * innehåll på två URL:er.
 */
import Base from '../layouts/Base.astro';
import EstablishmentList from './EstablishmentList.astro';
import Pagination from './Pagination.astro';
import {
  formatNumber,
  municipalityCategories,
  sourceLimits,
  type Establishment,
  type Municipality,
} from '../lib/data';
import { pageUrl } from '../lib/pagination';
import { SITE } from '../lib/site';

interface Props {
  kommun: Municipality;
  /** Verksamheter på just den här sidan. */
  items: Establishment[];
  currentPage: number;
  lastPage: number;
  /** Ordningsnummer för första raden på sidan, 1-baserat. */
  start: number;
  /** Antal i hela kommunen, inte bara på sidan. */
  total: number;
  counts: { clean: number; minor: number; major: number; none: number };
}

const { kommun, items, currentPage, lastPage, start, total, counts } = Astro.props;

const city = kommun.city;
const base = `/${kommun.slug}`;
const remarks = counts.minor + counts.major;

// Vissa kommuner lämnar ut så lite att modellen aldrig kan nå alla utfall.
// Då är en nolla i tabellen ovan ett besked om källan, inte om verksamheterna,
// och det måste stå på den sida där siffran visas. Se sourceLimits i data.ts.
const limits = sourceLimits(kommun.slug);

// Kategorierna. Filtret är länkar till egna sidor, inte kryssrutor: sajten
// kör inget JavaScript, och listan är dessutom sidindelad — en kryssruta hade
// bara nått de hundra raderna på just den här sidan. Se KategoriHub.astro.
//
// Kategorier utan egen sida visas ändå, med sin siffra men utan länk. Antingen
// är de för små för att förtjäna en URL, eller så kan kommunens källa inte
// skilja dem åt. I det andra fallet står det VARFÖR: ett filter som inte finns
// ljuger inte, men ett filter som ger noll träffar gör det.
const categories = currentPage === 1 ? municipalityCategories(kommun.slug) : null;
const categoryNotes = categories?.slices.map((s) => s.note).filter((n): n is string => n !== null) ?? [];

// Titel och beskrivning måste skilja sig mellan sidorna i serien, annars
// rapporterar Search Console dubbletter genom hela katalogen.
const title =
  currentPage === 1
    ? `Hygienkontroller i ${city}`
    : `Hygienkontroller i ${city}, sida ${currentPage} av ${lastPage}`;

const description =
  currentPage === 1
    ? `Hygienkontroller för ${formatNumber(total)} restauranger och livsmedelsverksamheter i ${city}. ${formatNumber(remarks)} har anmärkningar vid senaste kontrollen.`
    : `Verksamheter ${formatNumber(start)}–${formatNumber(start + items.length - 1)} av ${formatNumber(total)} i ${city}, i bokstavsordning. Sida ${currentPage} av ${lastPage}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: SITE.url },
    ...(currentPage === 1
      ? [{ '@type': 'ListItem', position: 2, name: kommun.name }]
      : [
          { '@type': 'ListItem', position: 2, name: kommun.name, item: `${SITE.url}${base}` },
          { '@type': 'ListItem', position: 3, name: `Sida ${currentPage}` },
        ]),
  ],
};

const prev = currentPage > 1 ? pageUrl(base, currentPage - 1, SITE.url) : undefined;
const next = currentPage < lastPage ? pageUrl(base, currentPage + 1, SITE.url) : undefined;
---

<Base title={title} description={description} jsonLd={jsonLd} prev={prev} next={next}>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      {currentPage > 1 && (
        <>
          <span aria-hidden="true">›</span>
          <a href={base}>{city}</a>
        </>
      )}
    </nav>

    <header class="head">
      <p class="eyebrow">{kommun.name}</p>
      <h1>
        Hygienkontroller i {city}
        {currentPage > 1 && <span class="text-secondary">, sida {currentPage}</span>}
      </h1>
      <p class="lede text-secondary">
        {currentPage === 1 ? (
          <>
            {formatNumber(total)} verksamheter från {kommun.name}s livsmedelskontroll,
            i bokstavsordning. Bedömningen speglar den senaste kontrollen.
          </>
        ) : (
          <>
            Verksamhet {formatNumber(start)}–{formatNumber(start + items.length - 1)} av
            {' '}{formatNumber(total)} i {kommun.name}s livsmedelskontroll.
          </>
        )}
      </p>
    </header>

    {currentPage === 1 && (
      <>
        <ul class="stats">
          <li>
            <b style="color: var(--verdict-clean-ink)">{formatNumber(counts.clean)}</b>
            <span class="text-secondary">utan anmärkningar</span>
          </li>
          <li>
            <b style="color: var(--verdict-minor-ink)">{formatNumber(counts.minor)}</b>
            <span class="text-secondary">med brister</span>
          </li>
          <li>
            <b style="color: var(--verdict-major-ink)">{formatNumber(counts.major)}</b>
            <span class="text-secondary">med kvarstående brister</span>
          </li>
        </ul>

        {limits.note && (
          <p class="limits">
            {limits.note} <a href="/metodik#jamfor">Så påverkar källan bedömningen</a>.
          </p>
        )}

        {remarks > 0 && (
          <p class="jump">
            {/* Listan är alfabetisk och därför stabil mellan bygg. Den som
                vill se det som avviker ska inte behöva bläddra sig fram. */}
            <a href={`${base}/anmarkningar`}>
              Se de {formatNumber(remarks)} verksamheterna med anmärkningar i {city}
            </a>
          </p>
        )}
      </>
    )}

    {categories && (
      <section class="filter" aria-labelledby="kategorier">
        <h2 id="kategorier">Verksamheter efter typ</h2>
        <ul class="chips">
          {categories.slices.map(({ category, count, linked }) =>
            linked ? (
              <li>
                <a href={`${base}/kategori/${category.slug}`} class="chip">
                  {category.name} <span class="n">{formatNumber(count)}</span>
                </a>
              </li>
            ) : (
              <li>
                {/* Ingen länk. En kategori med en handfull verksamheter, eller
                    ingen alls, förtjänar ingen egen URL — men siffran ska stå
                    där ändå, annars ser summan ut som hela kommunen. */}
                <span class="chip off">
                  {category.name} <span class="n">{formatNumber(count)}</span>
                </span>
              </li>
            ),
          )}
        </ul>

        {(categoryNotes.length > 0 || categories.gapNote) && (
          <div class="notes">
            {categoryNotes.map((note) => <p>{note}</p>)}
            {categories.gapNote && <p>{categories.gapNote}</p>}
          </div>
        )}
      </section>
    )}

    <EstablishmentList items={items} kommunSlug={kommun.slug} />

    <Pagination base={base} current={currentPage} last={lastPage} label={`verksamheter i ${city}`} />
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-8) var(--s-12);
    max-width: 780px;
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-body-s);
    color: var(--text-muted);
    margin-bottom: var(--s-4);
  }

  .head h1 {
    font-size: 32px;
    line-height: 36px;
    margin-top: var(--s-1);
  }

  .head h1 span {
    font-weight: 400;
  }

  .lede {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
  }

  .stats b {
    display: block;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stats span {
    font-size: var(--fs-caption);
  }

  .jump {
    margin-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .filter {
    margin-top: var(--s-8);
  }

  .filter h2 {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--card);
    color: var(--text-secondary);
    font-size: var(--fs-caption);
    font-weight: 600;
  }

  a.chip:hover {
    text-decoration: none;
    border-color: var(--brand);
    color: var(--brand);
  }

  /* Utan länk: kategorin finns men förtjänar ingen egen sida, eller går inte
     att fylla i den här kommunen. Nedtonad, aldrig dold — siffran är svaret. */
  .chip.off {
    background: transparent;
    color: var(--text-muted);
    font-weight: 400;
  }

  .chip .n {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .notes {
    margin-top: var(--s-4);
    padding-left: var(--s-4);
    border-left: 3px solid var(--verdict-none);
  }

  .notes p {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .notes p + p { margin-top: var(--s-2); }

  /* Dämpad, inte varnande. Det är en upplysning om datan, inte ett larm. */
  .limits {
    margin-top: var(--s-6);
    padding-left: var(--s-4);
    border-left: 3px solid var(--verdict-none);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }
</style>
