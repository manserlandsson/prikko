  /* ── Smal skärm ───────────────────────────────────────────────────────── */

  /*
   * Under 900 px blir sidan en spalt, och då är ordningen hela frågan.
   *
   * Den var: lista, karta, paneler. Kartan låg alltså hundra listrader ner,
   * i praktiken osynlig, och en svävande kartknapp i underkant fick bära
   * kartan i stället. Det var samma fel som ägaren pekade ut på skrivbordet:
   * kartan fanns som länk, inte som karta. Knappen är därför borta.
   *
   * Den är nu: karta, lista, paneler. Kartan är 200 px hög här och står
   * direkt under fördelningsraden, alltså syns den utan att bli en vägg
   * framför registret. Panelerna står kvar EFTER listan: de bär källa och
   * färskhet, som hör hemma efter uppgifterna på en smal skärm.
   *
   * `display: contents` på sidopanelen löser det utan att markupen dubbleras.
   * Panelens barn blir egna flexbarn i .layout och kan ordnas var för sig,
   * så att kartan går före huvudspalten medan panelerna stannar efter den.
   */
  @media (max-width: 900px) {
    .layout {
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
    }

    .side {
      display: contents;
      position: static;
    }

    .side > :global(.kartruta) { order: -1; }
    .main { order: 0; }
    .side > :global(.panel) { order: 1; }
  }
