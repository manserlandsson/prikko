---
/**
 * Kommunhubben — hela sidan, delad mellan sida 1 och resten av serien.
 *
 * Bär den interna länkgrafen: utan den här sidan är varje restaurangsida
 * föräldralös, och Google hittar dem bara via sitemap — vilket är en svagare
 * signal än en riktig länk från en sida med kontext.
 *
 * Sidan är indelad i riktiga sidor (se lib/pagination.ts). Sida 1 ligger på
 * /[kommun] och har ingen egen /sida/1 — annars hade vi publicerat samma
 * innehåll på två URL:er.
 *
 * ## Ordningen i huvudspalten
 *
 * Verksamheterna först, statistiken efter. Sidan öppnade tidigare med fyra
 * statistikrutor som tryckte ner listan en hel skärm, och ägarens dom var
 * rättvis: man kom för restaurangerna och möttes av metod. Ednia, hitta.se
 * och Booking gör alla samma sak på sina ortssidor: en tunn rad sammanhang
 * under sidhuvudet, sedan innehållet, och fördjupningen efter resultaten.
 *
 * Statistiken är samtidigt sidans egen kunskap och en stor del av dess
 * sökvärde, så den flyttar inte till en egen sida och göms inte i en
 * hopfällbar panel. Den står i sin helhet efter listan, i ett eget tonat
 * band, och översiktsraden längst upp länkar dit med ett ankare.
 *
 * Booli gör exakt samma sak på sin områdessida, som är sökresultatet med
 * karta: en rad sammanhang i 14 px överst, filtren, träffarna, och först
 * DÄREFTER kunskapsavsnitten under egna rubriker i 24/600. Uppmätt på
 * /sok/till-salu?areaIds=115349 i augusti 2026.
 */
import Base from '../layouts/Base.astro';
import CommonIssues from './CommonIssues.astro';
import EstablishmentList from './EstablishmentList.astro';
import FaceMark from './FaceMark.astro';
import Filterrad from './Filterrad.astro';
import Kategorival from './Kategorival.astro';
import FollowUpRate from './FollowUpRate.astro';
import KartaPuff from './KartaPuff.astro';
import KommunBanner from './KommunBanner.astro';
import KommunOversikt from './KommunOversikt.astro';
import Kontrollen from './Kontrollen.astro';
import Kontrolltakt from './Kontrolltakt.astro';
import Pagination from './Pagination.astro';
import RenHistorik from './RenHistorik.astro';
import Tathet from './Tathet.astro';
import Uncovered from './Uncovered.astro';
import {
  formatDate,
  formatNumber,
  latestInspectionDate,
  municipalityCategories,
  sourceFor,
  sourceLimits,
  type Establishment,
  type Municipality,
} from '../lib/data';
import { utsnitt } from '../lib/kartrutor';
import {
  MIN_CLEAN_RECORD_SECTION,
  MIN_UNSEEN_SECTION,
  cleanRecord,
  cleanRecordTotal,
  followUpRecord,
  kommunProfil,
  recentlyInspected,
  unseen,
} from '../lib/kommunprofil';
import { kontrollen } from '../lib/kontrollen';
import { linkedAreas } from '../lib/omraden';
import { pageUrl } from '../lib/pagination';
import { hasMovementPage } from '../lib/rorelse';
import { SITE } from '../lib/site';
import { tathet } from '../lib/tathet';
import { absolute, path } from '../lib/urls';

interface Props {
  kommun: Municipality;
  /** Verksamheter på just den här sidan. */
  items: Establishment[];
  currentPage: number;
  lastPage: number;
  /** Ordningsnummer för första raden på sidan, 1-baserat. */
  start: number;
  /** Antal i hela kommunen, inte bara på sidan. */
  total: number;
  counts: { clean: number; minor: number; major: number; none: number };
}

const { kommun, items, currentPage, lastPage, start, total, counts } = Astro.props;

const city = kommun.city;
const base = `/${kommun.slug}`;
const remarks = counts.minor + counts.major;

// Vissa kommuner lämnar ut så lite att modellen aldrig kan nå alla utfall.
// Då är en nolla i bandet en upplysning om källan, inte om verksamheterna,
// och det måste stå på den sida där siffran visas. `distributionNote` och inte
// `note`: bara utfall bandet faktiskt visar hör hemma här. Utmärkelsen syns
// inte på den här sidan, och en mening om att den är onåbar hade infört ett
// begrepp bara för att meddela att det saknas. Se sourceLimits i data.ts.
const limits = sourceLimits(kommun.slug);

/*
 * Kategorierna. Filtret är länkar till egna sidor, inte kryssrutor: sajten kör
 * inget JavaScript, och listan är dessutom sidindelad — en kryssruta hade bara
 * nått de hundra raderna på just den här sidan. Se KategoriHub.astro.
 *
 * Bara kategorier kommunen faktiskt har verksamheter i visas, och bara i
 * kommuner där filtret kan filtrera. Här stod tidigare ett chip per kategori
 * även när det var tomt, plus en mening under filtret som förklarade varför
 * det var tomt. "Caféer 0" i Uppsala är inte en tom hylla utan ett felaktigt
 * besked, och förklaringen under var en rättelse av ett påstående sidan själv
 * hittat på. Se municipalityCategories i data.ts.
 */
const cats = currentPage === 1 ? municipalityCategories(kommun.slug) : null;
const categories = cats?.usable ? cats : null;

/*
 * Stadsdelarna, som egna sidor. Bara de som förtjänar en URL, alltså bara de
 * som klarar MIN_AREA_PAGE, och bara i kommuner där det finns riktiga gränser
 * att gå på. Här står inga oklickbara chips som för kategorierna: ett område
 * under gränsen är inte en tom hylla som behöver redovisas, det är ett område
 * vi inte gjort en sida av, och kommunens verksamheter finns fullständigt i
 * listan under ändå. Se lib/omraden.ts.
 */
const areas = currentPage === 1 ? linkedAreas(kommun.slug) : [];

/*
 * Kommunens två egna insikter. Båda är påståenden om KOMMUNEN och aldrig om en
 * namngiven verksamhet, vilket är vad som gör dem trygga att publicera.
 */
const record = currentPage === 1 ? followUpRecord(kommun.slug) : null;
const unassessed = currentPage === 1 ? unseen(kommun.slug) : null;

/**
 * Kommunens tredje insikt, och den enda som inte är räknad ur vår egen data.
 *
 * De två ovan säger vad kontrollen gav. Den här säger vad kontrollen var: hur
 * stort registret är, hur mycket av det kommunen hinner med och hur många
 * anläggningar varje inspektör har att gå på. Det är förklaringen till att
 * samma modell ger så olika tal i olika kommuner, och den fanns inte att ge
 * förrän Livsmedelsverkets myndighetsrapportering låg i datan.
 *
 * Se lib/kontrollen.ts för varför talen aldrig sorteras mellan kommuner.
 */
const control = currentPage === 1 ? kontrollen(kommun.code) : null;

/**
 * Kommunens fjärde insikt, och den enda som inte handlar om hygien.
 *
 * Restauranger och caféer per invånare är en uppgift om orten och inte om hur
 * rent det är på den, och den är därför också det enda talet på sajten som
 * skulle få rangordnas mellan kommuner. Se lib/tathet.ts.
 */
const density = currentPage === 1 ? tathet(kommun.slug, kommun.code) : null;

/**
 * Sida 1 bär kommunens profil. Sidorna 2 och framåt är fortsättningen på ett
 * register och ska inte upprepa den — dels vore det samma innehåll på 86
 * URL:er i Stockholms fall, dels är den som bläddrat sig till sida 12 redan
 * förbi frågan "hur ser kommunen ut".
 */
const profil = currentPage === 1 ? kommunProfil(kommun.slug) : null;

/** Fördjupningen efter listan finns bara när minst en insikt har underlag. */
const hasDjup = Boolean(profil || record || control || unassessed || density);

/**
 * Fördelningsradens grå post pekar hit, alltså till det avsnitt som förklarar
 * vad grått är: hur många som aldrig kontrollerats och hur många vars kontroll
 * är för gammal. `unseen()` räknar samma mängd som posten, verksamheter utan
 * bedömning, så ankaret leder till en uppdelning av exakt det talet man klickat
 * på.
 *
 * Villkoret är avsnittets eget. Uncovered.astro ritar ingenting under
 * MIN_UNSEEN_SECTION, och en post som länkar till ett avsnitt som inte finns
 * skickar besökaren till sidans slut utan besked. Är unassessed satt är också
 * hasDjup sant, alltså står bandet på sidan.
 */
const unseenAnchor =
  unassessed && unassessed.total >= MIN_UNSEEN_SECTION ? '#utan-kontroll' : undefined;

/**
 * "Senast kontrollerade" bara på sida 1. Panelen "Om uppgifterna" står på
 * alla sidor: källa och hämtdatum hör hemma där uppgifterna visas, och sida
 * 47 visar lika många uppgifter som sida 1.
 *
 * Sidopanelen finns alltså på hela serien, vilket också är skälet till att
 * listans spaltbredd är densamma på sida 1 och sida 47. Utan den hoppade
 * raderna i bredd så fort man bläddrade.
 */
const recent = currentPage === 1 ? recentlyInspected(kommun.slug, 5) : [];
const source = sourceFor(kommun.slug);

/**
 * Ren historik i kommunen, sida 1.
 *
 * Sidan öppnar med "verksamheter i bokstavsordning", och den som söker de
 * skötsamma fick börja på A. `restauranger [stad] högst betyg` kompletteras
 * för varje prövad stad, omprövat till 8 av 8 i docs/31 §5.1, och fyra
 * dokument har bett om att kvaliteten ska synas. Registret sorteras ändå
 * aldrig om, skälen står i cleanRecord i lib/kommunprofil.ts.
 *
 * Två villkor, inte ett. `distinctionPossible` är källans gräns: i Höganäs,
 * Karlstad, Lomma och Oskarshamn lämnas aldrig tre kontroller ut, alltså kan
 * ingen verksamhet där nå märkningen. MIN_CLEAN_RECORD_SECTION är avsnittets
 * egen gräns: Kristinehamn och Svenljunga har en verksamhet var, och en enda
 * rad under rubriken hade lästs som att kommunen har ett enda skötsamt kök.
 *
 * Villkoren ställs här och inte i komponenten, av samma skäl som
 * MIN_UNSEEN_SECTION ovan: en sida som länkar till eller räknar med ett
 * avsnitt måste kunna ställa villkoret ur samma tal som ritar det.
 */
const cleanTotal = currentPage === 1 ? cleanRecordTotal(kommun.slug) : 0;
const clean =
  limits.distinctionPossible && cleanTotal >= MIN_CLEAN_RECORD_SECTION
    ? cleanRecord(kommun.slug, 6)
    : [];

/*
 * Kartan, om kommunen har koordinater.
 *
 * Viktargumentet i Karta.astro gäller: kartprogrammet väger 231 kB brotlat
 * och den här sidan väger 30 kB gzippat med allt inräknat, så MapLibre får
 * aldrig ligga här. Men "bara en textlänk" var ägarens klagomål, och svaret
 * är KartaPuff: en platshållare i sidladdningen som byts mot den riktiga
 * kartan först när rutan syns och uppkopplingen tål det. Kartan SYNS på sidan
 * utan att sidan betalar för kartprogrammet.
 *
 * Puffen står på hela sidserien och inte bara på sida 1. Den som bläddrat
 * till sida 47 av Stockholm har snarare mer nytta av en karta än mindre.
 * På smala skärmar står den FÖRE listan, se ordningsresonemanget i stilarna
 * längst ner.
 *
 * Villkoret är `utsnitt`, alltså rutarkivets eget svar på om kommunen har
 * någon punkt att rita. Det var `mapDataset` medan puffen läste kommunfilen,
 * och den modulen finns inte längre.
 */
const karta = utsnitt(kommun.slug);

/** Kommunens senaste kontroll över huvud taget. Färskhetsbeskedet. */
const newest = recentlyInspected(kommun.slug, 1)[0];
const latestInKommun = newest ? latestInspectionDate(newest) : null;

// Titel och beskrivning måste skilja sig mellan sidorna i serien, annars
// rapporterar Search Console dubbletter genom hela katalogen.
const title =
  currentPage === 1
    ? `Hygienkontroller i ${city}`
    : `Hygienkontroller i ${city}, sida ${currentPage} av ${lastPage}`;

const description =
  currentPage === 1
    ? `Hygienkontroller för ${formatNumber(total)} restauranger och livsmedelsverksamheter i ${city}. ${formatNumber(remarks)} har anmärkningar vid senaste kontrollen.`
    : `Verksamheter ${formatNumber(start)}–${formatNumber(start + items.length - 1)} av ${formatNumber(total)} i ${city}, i bokstavsordning. Sida ${currentPage} av ${lastPage}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
    ...(currentPage === 1
      ? [{ '@type': 'ListItem', position: 2, name: kommun.name }]
      : [
          { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(base) },
          { '@type': 'ListItem', position: 3, name: `Sida ${currentPage}` },
        ]),
  ],
};

const prev = currentPage > 1 ? pageUrl(base, currentPage - 1, SITE.url) : undefined;
const next = currentPage < lastPage ? pageUrl(base, currentPage + 1, SITE.url) : undefined;
---

<Base title={title} description={description} jsonLd={jsonLd} prev={prev} next={next}>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      {currentPage > 1 && (
        <>
          <span aria-hidden="true">›</span>
          <a href={path(base)}>{city}</a>
        </>
      )}
    </nav>

    <KommunBanner
      kommun={kommun}
      photo={currentPage === 1}
      heading={
        currentPage === 1
          ? `Hygienkontroller i ${city}`
          : `Hygienkontroller i ${city}, sida ${currentPage}`
      }
    />

    <p class="lede text-secondary">
      {currentPage === 1 ? (
        <>
          {formatNumber(total)} verksamheter i bokstavsordning, bedömda efter
          sin senaste hygienkontroll.
        </>
      ) : (
        <>
          Verksamhet {formatNumber(start)}–{formatNumber(start + items.length - 1)} av
          {' '}{formatNumber(total)} i {city}, i bokstavsordning.
        </>
      )}
    </p>

    {/* Två spalter från och med här. Huvudspalten bär det man läser uppifrån
        och ner, sidopanelen det man vill ha kvar i blickfånget — samma
        uppdelning som restaurangsidan, så sidtyperna känns igen. */}
    <div class="layout">
      <div class="main">
        {currentPage === 1 && (
          <>
            {/* En tunn rad, inte ett kort. Hela svaret på "hur ser kommunen
                ut" i tre centimeter, med ankare till fördjupningen. */}
            <KommunOversikt
              counts={counts}
              remarksHref={remarks > 0 ? path(base, 'anmarkningar') : undefined}
              unseenHref={unseenAnchor}
              statsHref={hasDjup ? '#om-kontrollen' : undefined}
              city={city}
            />

            {limits.distributionNote && (
              <p class="limits">
                {limits.distributionNote}{' '}
                <a href="/metodik/#jamfor">Så påverkar källan bedömningen</a>.
              </p>
            )}
          </>
        )}

        {categories && (
          <section class="filter" aria-labelledby="kategorier">
            <h2 id="kategorier">Verksamheter efter typ</h2>
            {/* Ett rutnät och inte filterraden. De sex typerna är ett fast och
                känt antal som är detsamma i varje kommun, och mätt i
                webbläsaren rullade raden aldrig på dator: 546 px innehåll i
                ett spår på 640 till 736. Se Kategorival.astro för hela
                mätningen. Stadsdelarna nedanför är det motsatta fallet och
                behåller rullraden. */}
            <Kategorival
              label={`Verksamheter efter typ i ${city}`}
              items={[
                { href: path(base), label: 'Alla', count: total, ikon: 'alla' as const, current: true },
                ...categories.shown.map(({ category, count, linked }) => ({
                  // Utan länk: kategorin finns och siffran är sann, men en
                  // kategori med en handfull verksamheter förtjänar ingen egen
                  // URL. Kategorival tonar ner den i stället för att dölja den.
                  href: linked ? path(base, 'kategori', category.slug) : undefined,
                  label: category.name,
                  count,
                  ikon: category.id,
                })),
              ]}
            />
          </section>
        )}

        {areas.length > 0 && (
          <section class="filter" aria-labelledby="omraden">
            <h2 id="omraden">Verksamheter efter område</h2>
            {/* Inga ikoner, se resonemanget i Filterrad.astro: stadsdelarna
                är ortnamn och har inga symboler vi kan stå för. Inget
                hemläge heller, eftersom områdena inte delar upp kommunen:
                långt ifrån varje verksamhet ligger i ett område med egen
                sida, så "Alla" hade lovat en helhet raden inte är en del av. */}
            <Filterrad
              label={`Verksamheter efter område i ${city}`}
              items={areas.map(({ area, count }) => ({
                href: path(base, 'omrade', area.slug),
                label: area.name,
                count,
              }))}
            />
          </section>
        )}

        {/* Ovanför registret och under filtren. Ordningen är avsiktlig: den
            som vet vilken typ eller stadsdel hen vill ha väljer den först, och
            inslaget svarar sedan på nästa fråga, alltså vilka i mängden som är
            skötsamma. Under registret hade det legat efter hundra rader och
            aldrig setts. */}
        {clean.length > 0 && (
          <RenHistorik
            items={clean}
            total={cleanTotal}
            kommunSlug={kommun.slug}
            city={city}
          />
        )}

        <EstablishmentList items={items} kommunSlug={kommun.slug} />

        <Pagination base={base} current={currentPage} last={lastPage} label={`verksamheter i ${city}`} />
      </div>

      <aside class="side">
        {karta && <KartaPuff kommun={kommun} />}

        {recent.length > 0 && (
          <section class="panel">
            <h2 class="panel-title">Senast kontrollerade</h2>
            <ul class="recent">
              {recent.map((e) => (
                <li>
                  <a href={path(base, e.slug)}>
                    <FaceMark verdict={e.verdict} size={30} variant="round" />
                    <span class="recent-info">
                      <b>{e.name}</b>
                      <span class="text-secondary">
                        {formatDate(latestInspectionDate(e)!)}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Var uppgifterna kommer ifrån, på den sida där de visas. Låg
            tidigare bara på restaurangsidan och på /kallor, alltså aldrig
            på den sidtyp som tar emot mest trafik. */}
        <section class="panel">
          <h2 class="panel-title">Om uppgifterna</h2>
          <dl class="facts">
            <div>
              <dt>Källa</dt>
              <dd>{kommun.name}</dd>
            </div>
            {source && (
              <div>
                <dt>Hämtat</dt>
                <dd>{formatDate(source.fetchedAt.slice(0, 10))}</dd>
              </div>
            )}
            {latestInKommun && (
              <div>
                <dt>Senaste kontroll</dt>
                <dd>{formatDate(latestInKommun)}</dd>
              </div>
            )}
            <div>
              <dt>Bedömda</dt>
              <dd>
                {formatNumber(counts.clean + counts.minor + counts.major)} av
                {' '}{formatNumber(total)}
              </dd>
            </div>
          </dl>
          <p class="panel-foot">
            Bedömningen är Prikkos, inte kommunens.
            {' '}<a href="/metodik/">Så räknas den fram</a>.
          </p>
        </section>
      </aside>
    </div>
  </div>

  {/* Fördjupningen. Allt som tidigare stod ovanför listan står här,
      oavkortat: sidan har kvar hela sitt kunskaps- och sökvärde, men
      registret får komma först. Den som vill hit direkt tar ankaret i
      översiktsraden.

      Bandet ligger UTANFÖR sidbehållaren och går kant i kant, på --brand-wash.
      Det är den ytan tokenet finns för: ett avsnitt som ska läsa som eget
      kapitel utan att bli ett kort. Booli gör samma sak under sin träfflista,
      där kunskapsinnehållet står under en egen rubrik i 24/600 efter
      resultaten, och sektionerna skiljs av hårlinje och luft, aldrig av en
      ruta. Innehållet i bandet ligger därför öppet, utan kortchrome. */}
  {currentPage === 1 && hasDjup && (
    <section class="djup" id="om-kontrollen" aria-labelledby="djup-rubrik">
      <div class="djup-inner">
        {/* Rubriken hette "Så ser kontrollen ut i {city}" så länge bandet bara
            bar kontrolltal. Restaurangtätheten är inte ett kontrolltal, och
            en rubrik som lovar kontroll över ett avsnitt om hur många
            restauranger orten har är fel i sak. */}
        <h2 id="djup-rubrik">{city} i siffror</h2>

        <Tathet tathet={density} city={city} />

        {profil && (
          <CommonIssues
            issues={profil.issues}
            withRemarks={profil.withRemarks}
            city={city}
          />
        )}

        <FollowUpRate record={record} city={city} />

        {/* Utvecklingen över tid, efter nuläget och före förklaringen av hur
            kontrollen bedrivs. Den läser bäst där, eftersom den svarar på
            "har det blivit fler besök" som en naturlig följdfråga på "hur gick
            uppföljningen". */}
        <Kontrolltakt slug={kommun.slug} city={city} />

        {/* Efter hur uppföljningen gick och före vad som inte hunnits med:
            avsnittet förklarar båda, och det läser bäst mellan dem. */}
        <Kontrollen kontrollen={control} city={city} />

        {unassessed && <Uncovered unseen={unassessed} city={city} />}

        {remarks > 0 && (
          <p class="jump">
            {/* Listan är alfabetisk och därför stabil mellan bygg. Den som
                vill se det som avviker ska inte behöva bläddra sig fram. */}
            <a href={path(base, 'anmarkningar')}>
              Se de {formatNumber(remarks)} verksamheterna med anmärkningar i {city}
            </a>
          </p>
        )}

        {/* Rörelsen i beståndet. Sidan finns bara i kommuner där loggen bär
            något, se lib/rorelse.ts, och länken följer samma villkor: en
            länk till en sida som inte byggts fäller byggrinden. */}
        {hasMovementPage(kommun.slug) && (
          <p class="jump">
            <a href={path(base, 'nytt-och-borta')}>
              Se vad som tillkommit och försvunnit i {city}
            </a>
          </p>
        )}
      </div>
    </section>
  )}
</Base>

<style>
  /* Bredden var 780 px i en behållare på 1080. Det gav en smal pelare med
     tomma marginaler på båda sidor — samma intryck som en textsida, fast
     innehållet är ett register. Nu används hela bredden, och läslängden
     hålls nere av att listan ligger i en spalt bredvid panelen. */
  .page {
    padding-block: var(--s-6) var(--s-12);
    max-width: var(--w-wide);
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-body-s);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .lede {
    margin-top: var(--s-4);
    max-width: var(--w-read);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  /* Spalten är 320 och inte 300. Kartan bor där, och hos Booli är kartan
     bredare än träfflistan. Så långt kan vi inte gå av viktskäl, men 20 px
     till gör skillnaden mellan en ruta med prickar i och något som läser som
     en karta. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--s-8);
    align-items: start;
    margin-top: var(--s-6);
  }

  /* Mellanrummet mellan blocken i huvudspalten sätts en gång här i stället
     för av varje block. :global krävs — Astros scopeade selektorer korsar
     inte komponentgränser, och halva innehållet är egna komponenter. */
  .main > :global(* + *) { margin-top: var(--s-6); }

  .jump { font-size: var(--fs-body-s); }

  /* Rubriken över chipsraden ligger i huvudkolumnen och måste därför väga
     minst lika mycket som sidopanelens rubriker. Den låg på --fs-body-s och
     blev mindre än "Senast kontrollerade" bredvid, alltså läste sidan som
     att panelen var viktigare än innehållet. Samma nivå som .panel-title. */
  /* Fullt bläck, inte grått. En rubrik är en rubrik: står den i sekundär grå
     läser den som en etikett över en kontroll, alltså som formulärtext, och
     inte som en avdelning på sidan. Ägaren: "texten Verksamheter efter område
     är också i fel färg, den är typ grå vilket rubriker ej ska vara." */
  .filter h2 {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    color: var(--text);
  }

  /* Luften mellan rubriken och innehållet. Allt annat bor i komponenterna:
     Filterrad.astro för stadsdelarnas rullrad, som också används på
     områdessidan, och Kategorival.astro för typernas rutnät. Måtten,
     tangentbordet och markeringen av aktivt val ska stå på ETT ställe.

     Rutnätet får mer luft än raden. Raden bär hårlinjer över och under och är
     ett eget band, alltså skiljer den ut sig själv. Rutnätet är öppet på
     sidan och behöver avståndet i stället. */
  .filter :global(.filterrad) { margin-top: var(--s-3); }
  .filter :global(.kategorival) { margin-top: var(--s-4); }

  /* Dämpad, inte varnande. Det är en upplysning om datan, inte ett larm. */
  .limits {
    padding-left: var(--s-4);
    border-left: 3px solid var(--verdict-none);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  /* ── Fördjupningsbandet ──────────────────────────────────────────────── */

  /* Kant i kant, men VIT. Se markupkommentaren för varför bandet ligger
     utanför sidbehållaren. Ingen marginal ovanför: sidans egen nedre luft
     (--s-12 i .page) är avståndet, och bandet ska börja där sidan slutar.

     Bandet låg på --brand-wash, alltså ljusblått, och ägaren underkände det.
     Han har rätt av ett skäl som blev synligt först när statistiken gjordes om:
     staplarna i bandet ritas i --brand mot ett spår som är samma blå tonat mot
     vitt, och den kontrasten räknar med vit botten. På ljusblått blir spåret
     nästan osynligt och stapeln simmar. Hårlinjen ovanför skiljer bandet från
     sidan i stället, vilket är vad Booli gör: sektioner skiljs av linje och
     luft, aldrig av en färgad ruta. */
  .djup {
    background: var(--card);
    border-top: 1px solid var(--hairline);
    padding-block: var(--s-12);
    /* Ankaret från översiktsraden ska inte landa med rubriken klistrad mot
       fönstrets överkant. */
    scroll-margin-top: var(--s-6);
  }

  /* Innehållet i bandet står smalare än registret ovanför. Raderna i
     "Vanligast bland anmärkningarna" är löptext ur kommunens egna
     formuleringar, och 1080 px gav en radlängd ingen läser. --w-page är
     sajtens mått för en enkelspaltig datasida och är precis det här är. */
  .djup-inner {
    max-width: var(--w-page);
    margin-inline: auto;
    padding-inline: var(--s-4);
  }

  /*
   * Sektionerna hålls isär av LUFT, aldrig av en ruta och inte längre av en
   * linje.
   *
   * De skildes tidigare av 32 px, en hårlinje och 32 px till. Med fem avsnitt
   * blev det fyra hårlinjer på en och samma yta, plus en femte över källraden
   * inuti två av avsnitten, och ägarens dom var att bandet saknade rytm. En
   * linje mellan två avsnitt säger samma sak som luften mellan dem redan
   * sagt, och sex likadana linjer säger ingenting alls.
   *
   * Kvar är 48 px, alltså mellan Boolis 32 och 64, och rubrikerna som bär
   * indelningen. Linjerna inuti avsnitten är borttagna i sina egna filer, se
   * Tathet.astro och Kontrollen.astro.
   */
  .djup-inner > :global(* + *) { margin-top: var(--s-12); }

  /* Bandets rubrik tillhör det första avsnittet och ska inte skiljas från
     det med samma avstånd som skiljer två avsnitt åt. Grad och vikt kommer
     från h2 i tokens, alltså 24/600, samma nivå som Booli ger sina
     kunskapsavsnitt under träfflistan. */
  .djup-inner > :global(h2 + *) { margin-top: var(--s-6); }

  /* ── Sidopanel ────────────────────────────────────────────────────────── */

  .side {
    position: sticky;
    top: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .panel {
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    padding: var(--s-4);
  }

  /* Panelrubrik = kort- och sidopanelsnivån i skalan. Booli har exakt en
     sådan nivå (16/600) och använder den på varje kort på varje sidtyp.
     Vår motsvarighet är --fs-h-xs. Skriv den aldrig som --fs-body-s igen:
     då blir en rubrik lika stor som texten under sig. */
  .panel-title {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    margin-bottom: var(--s-2);
  }

  .recent {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .recent a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
    color: var(--text);
  }

  .recent a:hover { text-decoration: none; }
  .recent a:hover b { color: var(--brand-ink); }

  .recent li + li { border-top: 1px solid var(--hairline); }

  .recent-info { min-width: 0; }

  .recent-info b {
    display: block;
    font-size: var(--fs-caption);
    line-height: 17px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .recent-info span { font-size: var(--fs-micro); line-height: var(--lh-micro); }

  .facts { margin: 0; }

  .facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-2) 0;
  }

  .facts div + div { border-top: 1px solid var(--hairline); }

  .facts dt {
    flex-shrink: 0;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .facts dd {
    margin: 0;
    text-align: right;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 600;
  }

  .panel-foot {
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  /* ── Smal skärm ───────────────────────────────────────────────────────── */

  /*
   * Under 900 px blir sidan en spalt, och då är ordningen hela frågan.
   *
   * Den var: lista, karta, paneler. Kartan låg alltså hundra listrader ner,
   * i praktiken osynlig, och en svävande kartknapp i underkant fick bära
   * kartan i stället. Det var samma fel som ägaren pekade ut på skrivbordet:
   * kartan fanns som länk, inte som karta. Knappen är därför borta.
   *
   * Den är nu: karta, lista, paneler. Kartan är 200 px hög här och står
   * direkt under fördelningsraden, alltså syns den utan att bli en vägg
   * framför registret. Panelerna står kvar EFTER listan: de bär källa och
   * färskhet, som hör hemma efter uppgifterna på en smal skärm.
   *
   * `display: contents` på sidopanelen löser det utan att markupen dubbleras.
   * Panelens barn blir egna flexbarn i .layout och kan ordnas var för sig,
   * så att kartan går före huvudspalten medan panelerna stannar efter den.
   */
  @media (max-width: 900px) {
    .layout {
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
    }

    .side {
      display: contents;
      position: static;
    }

    .side > :global(.kartruta) { order: -1; }
    .side > :global(.panel) { order: 1; }

    /*
     * `align-self: stretch` och `min-width: 0` är inte pynt. Utan dem rullar
     * inte filterraden, den spränger sidan.
     *
     * .layout sätter `align-items: start` för rutnätet ovanför, och den
     * deklarationen följer med hit ner. I ett rutnät betyder den "toppställ
     * spalterna". I en flexkolumn betyder den något helt annat: tväraxeln är
     * vågrät, så varje barn blir INNEHÅLLSBRETT i stället för att fylla
     * spalten. Det syntes aldrig så länge huvudspalten bara innehöll text och
     * chips som radbryter. Filterradens spår är max-content brett, 2 407 px
     * för Stockholms trettio områden, och då blev .main 2 407 px, hela sidan
     * fick vågrät rullning, och raden rullade inte alls eftersom den hade
     * fått all plats den bad om.
     *
     * `align-self` och inte `align-items` på föräldern: kartpuffen och
     * panelerna är också barn här, och deras bredd är inte det här ärendet.
     *
     * `min-width: 0` står kvar som andra spärr, alltså mot att innehållet
     * trycker ut spalten inifrån. Skrivbordsläget har den redan i form av
     * nollan i `minmax(0, 1fr)`.
     */
    .main { order: 0; align-self: stretch; min-width: 0; }
  }
</style>
