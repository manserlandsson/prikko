  }

  /* ------------------------------------------------------------------ */
  /* De valda bilderna i rutan                                            */
  /* ------------------------------------------------------------------ */
  /* Samma skäl som ovan: raderna byggs i skript och når inte de scopeade
     reglerna. Håll selektorerna under .write-dialog. */
  .write-dialog .picked li {
