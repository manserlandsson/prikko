---
/**
 * Platsväljaren, sajtens meny i sidhuvudet.
 *
 * Grundläget är ett <details>. Det är inte en genväg: elementet ger
 * öppna/stäng, tangentbord och skärmläsarsemantik utan en rad JavaScript,
 * och kommunlistan ligger i DOM:en som vanliga länkar. Utan skript fungerar
 * väljaren alltså fullt ut som en meny, och Google följer länkarna. Sajten
 * är noll-JS av princip; det som JavaScript lägger till här är bekvämlighet
 * ovanpå något som redan går att använda.
 *
 * Skriptet tillför tre saker: sökfältet, platsknappen och en fokusfälla.
 * De två första ligger i markup men dolda, så att de aldrig syns för någon
 * som inte kan använda dem.
 *
 * Platsdelning utlöses ALDRIG av sidladdning. Webbläsarens tillståndsdialog
 * som dyker upp oombedd är påträngande, och en besökare som möts av den
 * innan hen sett något litar mindre på sajten efteråt. Den kommer bara när
 * någon aktivt trycker på knappen.
 *
 * Panelen är mer än en lista. Överst det som folk kommer hit för: välja
 * kommun. Under en hårfin avdelare den framhävda raden till /ratta, som är
 * sajtens replikrätt och det enda vi ber besökaren om. Längst ned de
 * sekundära vägarna till hur bedömningen räknas fram, var datan kommer
 * ifrån och vilka vi är. Allra sist, under en egen linje, kontoraden.
 *
 * Kontoraden placerades där med avsikt och efter förebild. Den som kommer hit
 * kommer för att välja kommun eller rätta en uppgift; inloggningen är det
 * fåtal återvändande gör och hör därför sist. Airbnb löser det likadant.
 *
 * Bara kommunlistan rullar. Panelen är en flexkolumn där listan är enda
 * elementet som får krympa, så att raderna under den ligger kvar även när
 * listan innehåller 290 kommuner. Ligger de i samma rullande yta hamnar de
 * utom räckhåll så fort täckningen växer.
 */
import { municipalities, municipalityPoints } from '../lib/data';
import { path } from '../lib/urls';

const kommuner = municipalities();
const points = municipalityPoints();
---

<details class="picker" data-picker>
  {/*
    Bara ikonen, ingen etikett. Knappen hette "Kommun" när panelen bara
    innehöll kommunväljaren. Nu rymmer den även rättelse, metodik, källor och
    om, och då ljuger etiketten om vad som finns bakom.

    Namnet ligger i aria-label i stället, så att den som använder skärmläsare
    får veta vad knappen gör utan att texten begränsar innehållet.
  */}
  <summary class="trigger" aria-label="Meny">
    <svg class="glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
    </svg>
  </summary>

  <div class="panel glass" data-panel>
    <p class="eyebrow head">Välj kommun</p>

    <div class="tools" hidden data-tools>
      <label class="visually-hidden" for="picker-q">Sök kommun</label>
      <input
        id="picker-q"
        type="search"
        placeholder="Sök kommun"
        autocomplete="off"
        data-search
      />
      <button type="button" class="locate" data-locate>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="10" cy="10" r="3.2" stroke="currentColor" stroke-width="1.6" fill="none" />
          <circle cx="10" cy="10" r="6.6" stroke="currentColor" stroke-width="1.6" fill="none" />
          <path d="M10 1.2v2.2M10 16.6v2.2M1.2 10h2.2M16.6 10h2.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        Använd min plats
      </button>
    </div>

    <p class="message" role="status" aria-live="polite" hidden data-message></p>

    <div class="scroll">
      <ul class="kommuner" aria-label="Kommuner med kontroller" data-list>
        {kommuner.map((m) => (
          <li data-name={m.city.toLowerCase()} data-slug={m.slug}>
            <a href={path(m.slug)}>
              <span class="city">{m.city}</span>
              <span class="admin text-muted">{m.name}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="empty" hidden data-empty>Ingen kommun matchar sökningen.</p>

      {/* Täckningen står sist i den rullande ytan, inte i panelens fasta
          nederkant. Den hör ihop med listan och är det man vill läsa när
          man rullat igenom den utan att hitta sin kommun. I den fasta
          delen hade den dessutom stulit höjd från just listan. */}
      <p class="coverage text-muted">
        Prikko täcker {kommuner.length} {kommuner.length === 1 ? 'kommun' : 'kommuner'} i dag.
        Fler tillkommer efterhand.
      </p>
    </div>

    <a class="feature" href="/ratta/">
      <span class="feature-text">
        <span class="feature-title">Rätta en uppgift</span>
        <span class="feature-body">
          Ser något fel ut, eller vill du svara på en kontroll? Hör av dig.
        </span>
      </span>
      {/* Linjeteckning, inte ikon: raden ska väga tyngre än länkarna under
          den. Bladet i sekundärgrå, pennan i brandblått. En enda accent,
          ingen toning. */}
      <svg class="art" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="6" width="19" height="28" rx="3" />
          <path d="M8 14h11M8 20h11M8 26h7" />
        </g>
        <g class="pen" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M24.5 33 26 29.6l7.5-7.4 1.8 1.8-7.4 7.5Z" />
          <path d="M26 29.6l1.9 1.9" />
        </g>
      </svg>
    </a>

    <nav class="more" aria-label="Mer om Prikko">
      <a href="/metodik/">Metodik</a>
      <a href="/kallor/">Källor</a>
      <a href="/om/">Om Prikko</a>
    </nav>

    {/* Kontoraden, längst ned under en egen linje. Samma placering som
        Airbnb: menyns innehåll först, sedan en avdelare, sedan en enda rad
        om vem du är.

        Server-renderad som utloggad. Sajten är statisk och sidhuvudet ligger
        på 16 000 sidor, så vem som är inloggad kan omöjligt vara känt vid
        bygget. Skriptet nedan skriver om raden när det vet bättre. Det gör
        att en utloggad besökare ser rätt sak utan att något behöver köras,
        och en inloggad ser fel i några millisekunder. Motsatt förval hade
        visat "Ditt konto" för alla som har JavaScript avstängt.

        `hidden` på den inloggade delen i stället för två separata
        renderingar: raden ska inte hoppa i höjd när skriptet byter läge. */}
    <div class="account">
      <button type="button" class="account-in" data-signin>Logga in eller skapa konto</button>

      <div class="account-out" hidden data-account>
        <p class="who" data-who></p>
        <a href="/konto/">Ditt konto</a>
        <button type="button" class="linky" data-signout>Logga ut</button>
      </div>
    </div>
  </div>
</details>

<script type="application/json" data-points set:html={JSON.stringify(points)} />

<style>
  .picker {
    position: relative;
    flex-shrink: 0;
  }

  /* Kvadratiska mått, inte höjd plus padding.
   *
   * Knappen var ett piller med texten "Kommun" bredvid ikonen. När texten
   * togs bort behöll den `padding-inline`, så bredden blev ikonen plus två
   * paddingar medan höjden satt låst på 36. Resultatet blev en oval.
   *
   * Nu samma tal på båda ledder, och cirkeln följer av det.
   *
   * Cirkeln får vara kvar och den får vara tom. Den markerar att ikonen är
   * något man trycker på och ger en träffyta på 36 px, vilket är ungefär
   * gränsen för en fingertopp. En fylld yta hade vägt lika tungt som
   * wordmarken i andra änden av raden, och sidhuvudet ska vara lugnt.
   * Fyllningen kommer i stället vid hover, som en kvittens. */
  .trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .trigger:hover {
    background: var(--canvas);
    border-color: var(--text-muted);
  }

  /* Safari ritar en egen triangel på summary. */
  .trigger::-webkit-details-marker { display: none; }

  .trigger:hover { border-color: var(--text-muted); }

  .glyph {
    width: 18px;
    height: 18px;
    color: var(--text-secondary);
  }

  /* Det svävande lagret. Ytan står i .glass i tokens.css: kant, fyllning,
     oskärpa, lyft och reservregeln utan backdrop-filter. Sätt aldrig någon
     av dem här: den här filen och SiteSearch hade var sin kopia av samma
     yta, och två kopior glider isär.

     Här bor bara panelens mått och layout. */
  .panel {
    position: absolute;
    top: calc(100% + var(--s-2));
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    width: 340px;
    max-width: calc(100vw - var(--s-8));
    /* Höjd tagen ur menyns nya innehåll: den framhävda raden och länkarna
       under den äter drygt 200 px som listan förut hade. 620 ger listan
       omkring sex synliga kommuner på en normal laptop, vilket är vad som
       krävs för att den ska läsa som en lista och inte som en glugg. */
    max-height: min(76vh, 620px);
    /* Sista utvägen. Normalt rullar bara .scroll, men på en riktigt låg
       skärm räcker inte höjden ens till listans minsta mått, och då är en
       rullande panel bättre än avklippta länkar. */
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s-4);
  }

  /* Rubriken, sökfältet och statusraden ska aldrig krympa när listan växer.
     Det är listan som ger vika, inte kontrollerna som styr den. */
  .head,
  .tools,
  .message { flex-shrink: 0; }

  .head { margin-bottom: var(--s-3); }

  .tools {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
  }

  .tools input {
    width: 100%;
    height: 40px;
    padding-inline: var(--s-3);
    font-family: inherit;
    font-size: var(--fs-body-s);
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
  }

  /* display på en klass slår [hidden] i webbläsarens egen stilmall, eftersom
     författarens regler alltid vinner över UA:ns. Utan den här raden syntes
     sökfältet och platsknappen för den som saknar JavaScript, alltså precis
     de två kontroller som inte gör någonting utan skript. */
  .tools[hidden] { display: none; }

  /* --ink-faint och inte --text-muted: fältet har en egen vit fyllning och
     ligger alltså inte på glaset. Lagrets mörkare bläck hade gjort en
     platshållare lika tung som en ifylld sökning. */
  .tools input::placeholder { color: var(--ink-faint); }

  .locate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    height: 40px;
    padding-inline: var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    background: var(--card);
    font: 400 var(--fs-body-s)/1 var(--font-sans);
    /* Etiketten är --text, inte --brand. Knappen ligger i ett glaslager som
       kan falla över en stadsbild, och --brand (#007BE0) ligger på 2,80:1
       mot den ytan, och --brand-ink hjälper inte heller, den når 3,99:1. Blån
       sitter kvar där den klarar sig: på ikonen, som är grafik bredvid en
       läsbar etikett och inte ensam informationsbärare. */
    color: var(--text);
    cursor: pointer;
  }

  .locate:hover { border-color: var(--brand); }
  .locate:disabled { color: var(--text-secondary); cursor: default; }

  .locate svg { width: 16px; height: 16px; color: var(--brand); }

  .message {
    margin-bottom: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-control);
    background: color-mix(in srgb, var(--brand) 7%, var(--card));
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text);
  }

  /* Enda ytan som rullar. min-height: 0 måste stå ut: utan den vägrar ett
     flexbarn krympa under sitt innehåll, och 290 kommuner hade tryckt ut
     raderna under panelens nederkant. */
  .scroll {
    flex: 1 1 auto;
    min-height: 88px;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-inline: calc(var(--s-1) * -1);
    padding-inline: var(--s-1);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--hairline);
  }

  .kommuner {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kommuner a {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-control);
    color: var(--text);
  }

  .kommuner a:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 6%, transparent);
  }

  .city { font-size: var(--fs-body-s); font-weight: 600; }
  .admin { font-size: var(--fs-eyebrow); }

  .empty,
  .coverage {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .empty { padding: var(--s-2) var(--s-3); }

  /* Avdelarna ligger på texten och på nav-behållaren, aldrig på länkarna
     själva: en border-top följer border-radius och hade böjt sig runt den
     framhävda radens hörn i stället för att gå rakt tvärs över panelen. */
  .coverage {
    padding: var(--s-3) var(--s-3) var(--s-1);
  }

  /* Den framhävda raden. Avdelarna omkring är hela skillnaden mellan en
     lista som fortsätter och ett nytt stycke i menyn. */
  .feature {
    flex-shrink: 0;
    margin-top: var(--s-2);
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-control);
    color: var(--text);
  }

  .feature:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 6%, transparent);
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .feature-title {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
  }

  .feature-body {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .art {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    color: var(--text-secondary);
  }

  .art .pen { color: var(--brand); }

  .more {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--hairline);
  }

  .more a {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-control);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text);
  }

  /* Kontoraden. Egen linje ovanför, så att den läser som en avdelning för sig
     och inte som en fjärde länk bland Metodik, Källor och Om. */
  .account {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--hairline);
  }

  /* Knappen ska se ut som länkarna ovanför, inte som en knapp. Den gör samma
     sorts sak: den tar dig vidare. Att den tekniskt är en <button> beror bara
     på att den öppnar en ruta i stället för att byta sida, och det är ett
     genomförandedetalj som inte ska synas. */
  .account-in,
  .account-out a,
  .linky {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-control);
    font: inherit;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .account-in:hover,
  .account-out a:hover,
  .linky:hover {
    background: var(--canvas);
    text-decoration: none;
  }

  .account-out {
    display: flex;
    flex-direction: column;
  }

  /* Måste stå utskrivet. `hidden` är display: none i webbläsarens egen
     stilmall, och varje egen display-regel vinner över den. Utan de här två
     raderna syns både kontoraden och den inloggade delen alltid. */
  .account[hidden],
  .account-out[hidden] { display: none; }

  /* Adressen man loggat in med. Inte en länk och inte klickbar: den är en
     upplysning om vem sajten tror att du är, och det enda man vill göra med
     den är att läsa den. */
  .who {
    padding: var(--s-2) var(--s-3) 0;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .more a:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 6%, transparent);
  }

  @media (max-width: 480px) {
    .trigger span { display: none; }
    .trigger { padding-inline: var(--s-2); }
    /* right: 0, inte ett negativt utfall. Containern har redan 16 px luft åt
       höger, och drog panelen ut lika mycket låg den dikt an mot skärmkanten
       med 32 px kvar på andra sidan. Nu står den lika långt in på båda. */
    .panel { width: calc(100vw - var(--s-4) * 2); right: 0; }
  }
</style>

<script>
  import { configured, currentUser, onAuthChange, signedIn, signOut } from '../lib/community';
  import { openSignIn } from '../lib/signin-dialog';

  /**
   * Kontoraden längst ned i menyn.
   *
   * Ligger före platsväljarens egen kod eftersom den inte har med platser att
   * göra och inte får falla bort om något i den delen brister.
   *
   * Server-renderad som utloggad, se markupen. Den här funktionen skriver om
   * raden när den vet bättre. Är inloggning inte uppsatt alls, alltså när
   * anon-nyckeln saknas vid bygget, döljs raden helt: en knapp som öppnar en
   * ruta som aldrig kan logga in någon är sämre än ingen knapp.
   */
  {
    const box = document.querySelector<HTMLElement>('.account');
    const signin = document.querySelector<HTMLButtonElement>('[data-signin]');
    const out = document.querySelector<HTMLElement>('[data-account]');
    const who = document.querySelector<HTMLElement>('[data-who]');
    const signout = document.querySelector<HTMLButtonElement>('[data-signout]');

    if (box && signin && out && who && signout) {
      /* Bara `configured`, ALDRIG signInAvailable() här.
         signInAvailable() svarar på om rutan hunnit registrera sig, och det
         beror på skriptordningen: menyn ligger i sidhuvudet och rutan sist i
         body, så menyns skript kör först och får alltid nej. Raden doldes
         därför alltid, och eftersom `hidden` inte överlever en egen
         `display: flex` syntes den ändå, fast utan klickhanterare.

         openSignIn() svarar redan false när rutan saknas, så hanteraren får
         sitta ovillkorligt. */
      if (!configured) {
        box.hidden = true;
      } else {
        const paint = async () => {
          const authed = await signedIn();
          const user = authed ? currentUser() : null;
          signin.hidden = authed;
          out.hidden = !authed;
          who.textContent = user?.email ?? '';
        };

        signin.addEventListener('click', async () => {
          if (await openSignIn(signin)) await paint();
        });

        signout.addEventListener('click', async () => {
          await signOut();
          await paint();
          /* Sidan laddas om. Bevakningsknappen på verksamhetssidan och
             omdömesformuläret har egna tillstånd som satts vid laddning, och
             att låta dem tro att någon fortfarande är inloggad är värre än en
             omladdning. */
          location.reload();
        });

        /* Loggar man in via bevakningsknappen eller omdömesknappen ska
           raden här visa det utan omladdning. */
        onAuthChange(() => void paint());

        void paint();
      }
    }
  }

  /**
   * Progressiv förstärkning av platsväljaren. Allt här är sådant som inte
   * går att göra utan skript — markupen ovanför fungerar utan.
   */
  const picker = document.querySelector<HTMLDetailsElement>('[data-picker]');
  if (picker) {
    const summary = picker.querySelector('summary')!;
    const panel = picker.querySelector<HTMLElement>('[data-panel]')!;
    const tools = picker.querySelector<HTMLElement>('[data-tools]')!;
    const search = picker.querySelector<HTMLInputElement>('[data-search]')!;
    const locate = picker.querySelector<HTMLButtonElement>('[data-locate]')!;
    const message = picker.querySelector<HTMLElement>('[data-message]')!;
    const list = picker.querySelector<HTMLElement>('[data-list]')!;
    const empty = picker.querySelector<HTMLElement>('[data-empty]')!;
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));

    // Skriptet kör — nu får de skriptberoende kontrollerna synas.
    tools.hidden = false;
    summary.setAttribute('aria-expanded', 'false');

    function say(text: string) {
      message.textContent = text;
      message.hidden = false;
    }

    // --- Öppna och stäng -----------------------------------------------

    picker.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', String(picker.open));
      if (picker.open) {
        search.focus();
      } else {
        search.value = '';
        filter('');
        message.hidden = true;
      }
    });

    document.addEventListener('click', (event) => {
      if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
    });

    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false;
        summary.focus();
        return;
      }
      if (event.key !== 'Tab' || !picker.open) return;

      // Fokusfälla: lagret ligger ovanpå sidan, och att tabba ut ur det utan
      // att stänga det lämnar användaren med fokus på något osynligt.
      const focusable = [
        summary,
        ...panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled])',
        ),
      ].filter((el) => el.offsetParent !== null || el === summary);

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    // --- Sök i listan ---------------------------------------------------

    function normalise(s: string) {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    }

    function filter(term: string) {
      const q = normalise(term.trim());
      let shown = 0;
      for (const li of items) {
        const hit = !q || normalise(li.dataset.name || '').includes(q);
        li.hidden = !hit;
        if (hit) shown++;
      }
      empty.hidden = shown > 0;
    }

    search.addEventListener('input', () => filter(search.value));

    // Enter i sökfältet går till första träffen — annars måste man byta hand
    // mellan tangentbord och mus för att avsluta något man började skriva.
    search.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      const first = items.find((li) => !li.hidden)?.querySelector('a');
      if (first) first.click();
    });

    // --- Använd min plats -----------------------------------------------

    interface Point { slug: string; city: string; lat: number; lng: number }

    const pointsEl = document.querySelector('[data-points]');
    const points: Point[] = pointsEl ? JSON.parse(pointsEl.textContent || '[]') : [];

    /** Avstånd i meter (haversine). Samma formel som lib/data.ts. */
    function distance(aLat: number, aLng: number, bLat: number, bLng: number) {
      const R = 6371000;
      const rad = (d: number) => (d * Math.PI) / 180;
      const dLat = rad(bLat - aLat);
      const dLng = rad(bLng - aLng);
      const h =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(rad(aLat)) * Math.cos(rad(bLat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    }

    /** Så långt bort en kommun får ligga för att räknas som "din". Grovt
     *  tilltaget: en kommun är stor, och punkten är verksamheternas median,
     *  inte en gräns. */
    const NEAR_METRES = 40000;

    if (!('geolocation' in navigator)) {
      locate.disabled = true;
      locate.title = 'Din webbläsare kan inte dela plats.';
    }

    locate.addEventListener('click', () => {
      if (!('geolocation' in navigator)) {
        say('Din webbläsare kan inte dela din plats. Välj kommun i listan i stället.');
        return;
      }
      if (points.length === 0) {
        say('Vi kan inte matcha en plats mot kommun just nu. Välj i listan i stället.');
        return;
      }

      locate.disabled = true;
      say('Hämtar din plats…');

      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          locate.disabled = false;
          let nearest = points[0];
          let best = Infinity;
          for (const p of points) {
            const d = distance(coords.latitude, coords.longitude, p.lat, p.lng);
            if (d < best) {
              best = d;
              nearest = p;
            }
          }

          if (best <= NEAR_METRES) {
            say(`Närmast dig: ${nearest.city}. Öppnar…`);
            location.href = `/${nearest.slug}`;
            return;
          }

          // Utanför täckningen. Att säga vad som ÄR närmast är mer användbart
          // än att bara konstatera att vi inte hittade något.
          const km = Math.round(best / 1000);
          say(
            `Vi har ingen kommun där du är än. Närmast dig är ${nearest.city}, ungefär ${km} km bort.`,
          );
        },
        (error) => {
          locate.disabled = false;
          if (error.code === error.PERMISSION_DENIED) {
            /* Nekad kan betyda två helt olika saker, och besökaren kan bara
               åtgärda den ena. Antingen sa hen nej nyss, eller så är
               platsdelning blockerad sedan tidigare och webbläsaren svarar
               nej UTAN att ens fråga. Det andra fallet ser ut som att
               knappen är trasig.

               navigator.permissions säger vilket det är. Saknas API:et
               (Safari länge) faller vi tillbaka på den neutrala texten. */
            const blockerad = 'Platsdelning är blockerad för den här sidan. '
              + 'Ändra det i webbläsarens adressfält, eller välj kommun i listan.';
            const nekad = 'Du delade inte din plats. Välj kommun i listan i stället.';
            if (navigator.permissions?.query) {
              navigator.permissions.query({ name: 'geolocation' })
                .then((p) => say(p.state === 'denied' ? blockerad : nekad))
                .catch(() => say(nekad));
            } else {
              say(nekad);
            }
          } else if (error.code === error.TIMEOUT) {
            say('Det tog för lång tid att hämta din plats. Försök igen, eller välj i listan.');
          } else {
            say('Din plats gick inte att avgöra. Välj kommun i listan i stället.');
          }
        },
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 },
      );
    });
  }
</script>
