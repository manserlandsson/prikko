---
/**
 * Sajtens meny i sidhuvudet.
 *
 * KOMMUNLISTAN ÄR BORTA, OCH DET ÄR HELA POÄNGEN MED FILEN SOM DEN SER UT NU.
 * Menyn hette platsväljare och bar tolv kommuner, ett eget sökfält för att
 * hitta bland dem och en platsknapp. Ägarens dom: "välj kommun i
 * hamburgareikonen bringar inget värde", och han har rätt. Sidhuvudets sökfält
 * hittar redan kommuner, verksamheter, kartor, sidor och artiklar i EN panel,
 * och en lista i menyn var en andra väg till samma sak med sämre svar. Ett
 * gränssnitt som erbjuder två vägar till samma mål tvingar besökaren att välja
 * mellan dem innan hon vet vad de gör.
 *
 * Platsknappen flyttade till sökpanelen och bor numera i SiteSearch.astro. Den
 * fyllde tidigare i ett val åt besökaren; nu tar den henne direkt till kartan
 * över den kommun hon står i. Skälen står där.
 *
 * Kvar är en meny, och bara det: den framhävda raden till /ratta, tre länkar om
 * oss, och kontoraden. Förebilden är hitta.se, vars hamburgare rymmer ett
 * kontoblock, fyra destinationer och en liten rad med Privacy, Cookies och
 * Support. Ingen av dem har en ortlista i menyn.
 *
 * Menyn växte INTE tillbaka med rapporter, utmärkelser och jämförelsen för att
 * fylla tomrummet. De ligger alla i sökpanelens grupp "Sidor" (se
 * lib/kommandon) och i sidfoten, som är fullständig. Att flytta in dem här
 * hade återskapat exakt den dubbleringen som kommunlistan straffades för.
 *
 * Grundläget är ett <details>. Det är inte en genväg: elementet ger
 * öppna/stäng, tangentbord och skärmläsarsemantik utan en rad JavaScript.
 * Utan skript fungerar menyn alltså fullt ut, och Google följer länkarna.
 * Skriptet tillför två saker: kontoraden och en fokusfälla.
 *
 * Kontoraden ligger sist med avsikt och efter förebild. Den som öppnar menyn
 * kommer för att rätta en uppgift eller läsa om oss; inloggningen är det fåtal
 * återvändande gör och hör därför sist. Airbnb löser det likadant.
 */
---

<details class="picker" data-picker>
  {/*
    Bara ikonen, ingen etikett. Knappen hette "Kommun" när panelen bara
    innehöll kommunväljaren. Nu rymmer den rättelse, metodik, källor, om och
    kontot, och då ljuger etiketten om vad som finns bakom.

    Namnet ligger i aria-label i stället, så att den som använder skärmläsare
    får veta vad knappen gör utan att texten begränsar innehållet.
  */}
  <summary class="trigger" aria-label="Meny" data-trigger>
    <svg class="glyph" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
    </svg>

    {/* Klockan. Dold tills skriptet vet att det finns något oläst.

        SYNS BARA NÄR DET FINNS EN OLÄST NOTIS, och det är ett val och inte en
        förenkling. Förlagan är Booking, som har klockan framme jämt, men de
        har ett sidhuvud att ta av. Vårt är 58 px och bär redan wordmark,
        sökfält och avatar; en tredje ikon i samma piller som alltid står där
        och för det mesta inte betyder något är brus. En ikon som dyker upp
        just när den bär ett besked går däremot inte att missa.

        Den är INTE klickbar, och kan inte vara det: hela knappen är en
        <summary>, och en knapp inuti en knapp går varken att träffa med
        tangentbord eller att förklara för en skärmläsare. Vägen till listan
        är raden "Notiser" i panelen, som alltid finns för den som är inloggad.
        Klockan här är en markering, ingen genväg.

        aria-hidden av samma skäl som avataren: knappens namn skrivs om till
        "Meny, N olästa notiser" av skriptet, så beskedet finns i klartext
        utan att skärmläsaren först läser upp en ensam ikon. */}
    <span class="bell" hidden data-bell aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="none" focusable="false">
        <path
          d="M10 3a4.5 4.5 0 0 0-4.5 4.5c0 3-1.2 4-1.7 4.6-.2.2 0 .6.3.6h11.8c.3 0 .5-.4.3-.6-.5-.6-1.7-1.6-1.7-4.6A4.5 4.5 0 0 0 10 3Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="M8.4 15.3a1.7 1.7 0 0 0 3.2 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <span class="pip"></span>
    </span>

    {/* Avataren. Dold tills skriptet vet att någon är inloggad.

        Bokstaven är e-postadressens första tecken, inte en gubbe. En generisk
        siluett säger "någon är inloggad", en bokstav säger "DU är inloggad",
        och skillnaden märks på en delad dator. Ingen bilduppladdning finns för
        profiler, så alternativet hade varit samma siluett för alla.

        aria-hidden: knappen heter redan Meny, och att skärmläsaren läser upp
        en ensam bokstav efter det är brus. Vem man är står i klartext i
        panelen, som är där man kan göra något åt det. */}
    <span class="avatar" hidden data-avatar aria-hidden="true"></span>
  </summary>

  <div class="panel glass" data-panel>
    <a class="feature" href="/ratta/">
      <span class="feature-text">
        <span class="feature-title">Rätta en uppgift</span>
        <span class="feature-body">
          Ser något fel ut, eller vill du svara på en kontroll? Hör av dig.
        </span>
      </span>
      {/* Linjeteckning, inte ikon: raden ska väga tyngre än länkarna under
          den. Bladet i sekundärgrå, pennan i brandblått. En enda accent,
          ingen toning. */}
      <svg class="art" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="6" width="19" height="28" rx="3" />
          <path d="M8 14h11M8 20h11M8 26h7" />
        </g>
        <g class="pen" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M24.5 33 26 29.6l7.5-7.4 1.8 1.8-7.4 7.5Z" />
          <path d="M26 29.6l1.9 1.9" />
        </g>
      </svg>
    </a>

    <nav class="more" aria-label="Mer om Prikko">
      <a href="/metodik/">Metodik</a>
      <a href="/kallor/">Källor</a>
      <a href="/om/">Om Prikko</a>
    </nav>

    {/* Kontoraden, längst ned under en egen linje. Samma placering som
        Airbnb: menyns innehåll först, sedan en avdelare, sedan en enda rad
        om vem du är.

        Server-renderad som utloggad. Sajten är statisk och sidhuvudet ligger
        på 16 000 sidor, så vem som är inloggad kan omöjligt vara känt vid
        bygget. Skriptet nedan skriver om raden när det vet bättre. Det gör
        att en utloggad besökare ser rätt sak utan att något behöver köras,
        och en inloggad ser fel i några millisekunder. Motsatt förval hade
        visat "Ditt konto" för alla som har JavaScript avstängt.

        `hidden` på den inloggade delen i stället för två separata
        renderingar: raden ska inte hoppa i höjd när skriptet byter läge. */}
    <div class="account">
      <button type="button" class="account-in" data-signin>Logga in eller skapa konto</button>

      <div class="account-out" hidden data-account>
        <p class="who" data-who></p>
        {/* Vägen till notiserna. Står FÖRST bland kontoraderna: det är den
            enda av dem som kan ha förändrats sedan förra besöket.

            Antalet står i raden och inte bara som en prick. En prick i en
            panel man redan öppnat har inget kvar att säga; siffran avgör om
            det är värt att klicka. */}
        <a class="notis-rad" href="/konto/notiser/">
          Notiser
          <span class="notis-antal" hidden data-notis-antal></span>
        </a>
        <a href="/konto/">Ditt konto</a>
        <button type="button" class="linky" data-signout>Logga ut</button>
      </div>
    </div>
  </div>
</details>

<style>
  .picker {
    position: relative;
    flex-shrink: 0;
  }

  /* Kvadratiska mått, inte höjd plus padding.
   *
   * Knappen var ett piller med texten "Kommun" bredvid ikonen. När texten
   * togs bort behöll den `padding-inline`, så bredden blev ikonen plus två
   * paddingar medan höjden satt låst på 36. Resultatet blev en oval.
   *
   * Nu samma tal på båda ledder, och cirkeln följer av det.
   *
   * Cirkeln får vara kvar och den får vara tom. Den markerar att ikonen är
   * något man trycker på och ger en träffyta på 36 px, vilket är ungefär
   * gränsen för en fingertopp. En fylld yta hade vägt lika tungt som
   * wordmarken i andra änden av raden, och sidhuvudet ska vara lugnt.
   * Fyllningen kommer i stället vid hover, som en kvittens. */
  /* Inloggad blir knappen ett piller med hamburgaren och avataren bredvid
     varandra, som hos Airbnb. Utloggad är den en tom cirkel som förut.
     Bredden får växa, höjden aldrig: sidhuvudet är 58 px och en knapp som
     ändrar höjd skulle flytta wordmarken och sökfältet när man loggar in. */
  .picker[data-signed-in] .trigger {
    width: auto;
    gap: 6px;
    padding: 0 5px 0 10px;
    border-radius: var(--r-pill);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: var(--fs-caption);
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .avatar[hidden] { display: none; }

  /* Klockan. Ligger mellan hamburgaren och avataren, alltså i knappen och
     intill avataren på samma gång.

     Ingen egen fyllning och ingen ram: den ska väga som glyfen till vänster om
     sig och inte som en andra knapp. Det som drar blicken är pricken. */
  .bell {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    color: var(--text-secondary);
  }

  .bell[hidden] { display: none; }

  .bell svg { width: 18px; height: 18px; }

  /* Pricken sitter på klockan och inte bredvid den. --brand mot --card ger
     3,3:1, alltså under 4,5:1 för text men klart över 3:1 för grafik, och
     pricken är grafik: beskedet finns i klartext i knappens aria-label och i
     panelens rad. Vit ring runt om så att den läser som en pålagd markering
     även när den hamnar över en linje i ikonen. */
  .pip {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--card);
    border-radius: 50%;
    background: var(--brand);
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .trigger:hover {
    background: var(--canvas);
    border-color: var(--text-muted);
  }

  /* Safari ritar en egen triangel på summary. */
  .trigger::-webkit-details-marker { display: none; }

  .glyph {
    width: 18px;
    height: 18px;
    color: var(--text-secondary);
  }

  /* Det svävande lagret. Ytan står i .glass i tokens.css: kant, fyllning,
     oskärpa, lyft och reservregeln utan backdrop-filter. Sätt aldrig någon
     av dem här: den här filen och SiteSearch hade var sin kopia av samma
     yta, och två kopior glider isär.

     Här bor bara panelens mått och layout. */
  .panel {
    position: absolute;
    top: calc(100% + var(--s-2));
    right: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    width: 300px;
    max-width: calc(100vw - var(--s-8));
    /* Sista utvägen. Menyn är sex rader och får plats överallt utom på en
       riktigt låg skärm i liggande läge, och där är en rullande panel bättre
       än avklippta länkar. Ingen inre rullande yta finns kvar: den fanns för
       kommunlistan, som är borta. */
    max-height: min(80vh, 480px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s-3);
  }

  /* Den framhävda raden. Ligger först i panelen, och det är avsiktligt: att
     rätta en uppgift är det enda vi ber besökaren om. */
  .feature {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3);
    border-radius: var(--r-control);
    color: var(--text);
  }

  .feature:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 6%, transparent);
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .feature-title {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
  }

  .feature-body {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .art {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    color: var(--text-secondary);
  }

  .art .pen { color: var(--brand); }

  /* Avdelarna ligger på nav-behållaren, aldrig på länkarna själva: en
     border-top följer border-radius och hade böjt sig runt den framhävda
     radens hörn i stället för att gå rakt tvärs över panelen. */
  .more {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--hairline);
  }

  .more a {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-control);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text);
  }

  .more a:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 6%, transparent);
  }

  /* Kontoraden. Egen linje ovanför, så att den läser som en avdelning för sig
     och inte som en fjärde länk bland Metodik, Källor och Om. */
  .account {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--hairline);
  }

  /* Knappen ska se ut som länkarna ovanför, inte som en knapp. Den gör samma
     sorts sak: den tar dig vidare. Att den tekniskt är en <button> beror bara
     på att den öppnar en ruta i stället för att byta sida, och det är ett
     genomförandedetalj som inte ska synas. */
  .account-in,
  .account-out a,
  .linky {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-control);
    font: inherit;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .account-in:hover,
  .account-out a:hover,
  .linky:hover {
    background: var(--canvas);
    text-decoration: none;
  }

  .account-out {
    display: flex;
    flex-direction: column;
  }

  /* Notisraden. Samma rad som "Ditt konto", plus ett tal längst ut. */
  .notis-rad {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
  }

  /* Talet. Piller i brandblått med vit text, alltså 4,5:1 och läsbart som
     text ska vara. Träffytan är radens, inte pillrets: hela raden är länken. */
  .notis-antal {
    flex: none;
    min-width: 20px;
    padding: 1px 6px;
    border-radius: var(--r-pill);
    background: var(--brand);
    color: #fff;
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    font-weight: 600;
    text-align: center;
  }

  .notis-antal[hidden] { display: none; }

  /* Måste stå utskrivet. `hidden` är display: none i webbläsarens egen
     stilmall, och varje egen display-regel vinner över den. Utan de här två
     raderna syns både kontoraden och den inloggade delen alltid. */
  .account[hidden],
  .account-out[hidden] { display: none; }

  /* Adressen man loggat in med. Inte en länk och inte klickbar: den är en
     upplysning om vem sajten tror att du är, och det enda man vill göra med
     den är att läsa den. */
  .who {
    padding: var(--s-2) var(--s-3) 0;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    /* Här stod `.trigger span { display: none }`. Regeln är från den tid då
       knappen bar etiketten "Kommun" i ett span bredvid ikonen, och etiketten
       är borta sedan panelen fick mer än kommuner i sig. Kvar blev en regel
       som på telefon dolde precis det som ska synas där: avataren, klockan och
       pricken, alla tre spans i knappen. Just på en telefon är sidhuvudet det
       enda man ser av kontot utan att öppna menyn.

       Regeln är alltså borttagen och inte ersatt. Paddingen står kvar: den
       gäller bara utloggad, där knappen är en cirkel med fast bredd, eftersom
       .picker[data-signed-in] .trigger väger tyngre. */
    .trigger { padding-inline: var(--s-2); }

    /* HÄR LÅG FULLSKÄRMSARKET, OCH DET SKA INTE KOMMA TILLBAKA.
       Menyn öppnade som en hel yta på mobil så länge den bar en kommunlista
       som kunde växa till 290 rader. Den listan är borta. Sex rader utlagda
       över en 812 px hög vit yta läser inte som en meny utan som en sida som
       inte hunnit ladda klart, och arket krävde dessutom ett eget stängkryss
       eftersom ett ark inte har något "utanför". Panelen är förankrad i
       knappen i alla bredder nu, precis som hitta.se gör med sin. */
  }
</style>

<script>
  import {
    configured,
    currentUser,
    onAuthChange,
    signedIn,
    signOut,
    unreadNotices,
  } from '../lib/community';
  import { openSignIn } from '../lib/signin-dialog';

  /**
   * Kontoraden längst ned i menyn.
   *
   * Ligger före menyns egen kod eftersom den inte har med öppna och stäng att
   * göra och inte får falla bort om något i den delen brister.
   *
   * Server-renderad som utloggad, se markupen. Den här funktionen skriver om
   * raden när den vet bättre. Är inloggning inte uppsatt alls, alltså när
   * anon-nyckeln saknas vid bygget, döljs raden helt: en knapp som öppnar en
   * ruta som aldrig kan logga in någon är sämre än ingen knapp.
   */
  {
    const box = document.querySelector<HTMLElement>('.account');
    const signin = document.querySelector<HTMLButtonElement>('[data-signin]');
    const out = document.querySelector<HTMLElement>('[data-account]');
    const who = document.querySelector<HTMLElement>('[data-who]');
    const signout = document.querySelector<HTMLButtonElement>('[data-signout]');

    if (box && signin && out && who && signout) {
      /* Bara `configured`, ALDRIG signInAvailable() här.
         signInAvailable() svarar på om rutan hunnit registrera sig, och det
         beror på skriptordningen: menyn ligger i sidhuvudet och rutan sist i
         body, så menyns skript kör först och får alltid nej. Raden doldes
         därför alltid, och eftersom `hidden` inte överlever en egen
         `display: flex` syntes den ändå, fast utan klickhanterare.

         openSignIn() svarar redan false när rutan saknas, så hanteraren får
         sitta ovillkorligt. */
      if (!configured) {
        box.hidden = true;
      } else {
        const picker = document.querySelector<HTMLElement>('[data-picker]');
        const avatar = document.querySelector<HTMLElement>('[data-avatar]');
        const trigger = document.querySelector<HTMLElement>('[data-trigger]');
        const bell = document.querySelector<HTMLElement>('[data-bell]');
        const antal = document.querySelector<HTMLElement>('[data-notis-antal]');

        /**
         * Klockan och talet i panelen.
         *
         * ETT anrop, och bara för den som är inloggad. Sidhuvudet ligger på
         * 15 500 sidor, så räkningen görs av community.unread_notices() i
         * databasen i stället för av tre frågor härifrån. Se
         * pipeline/schema_community.sql.
         *
         * Anropet läggs sist i paint() och inte först: raden ska vara rätt
         * målad innan vi väntar på nätet. Faller anropet svarar
         * unreadNotices() noll, och klockan uteblir i stället för att skrika
         * om ett fel besökaren inte kan göra något åt.
         */
        const paintBell = async (authed: boolean) => {
          const unread = authed ? await unreadNotices() : 0;

          if (bell) bell.hidden = unread === 0;
          if (antal) {
            /* Nio och uppåt skrivs som "9+". Ett tresiffrigt tal i ett piller
               spränger raden, och skillnaden mellan 14 och 40 olästa ändrar
               ingenting för den som ska bestämma sig för att klicka. */
            antal.textContent = unread > 9 ? '9+' : String(unread);
            antal.hidden = unread === 0;
          }

          /* Knappens namn i klartext. Ikonen är aria-hidden, så det här är
             enda stället beskedet finns för den som inte ser pricken. */
          if (trigger) {
            trigger.setAttribute(
              'aria-label',
              unread === 0
                ? 'Meny'
                : `Meny, ${unread} ${unread === 1 ? 'oläst notis' : 'olästa notiser'}`,
            );
          }
        };

        const paint = async () => {
          const authed = await signedIn();
          const user = authed ? currentUser() : null;
          signin.hidden = authed;
          out.hidden = !authed;
          who.textContent = user?.email ?? '';

          /* Sidhuvudet ska visa att någon är inloggad utan att man behöver
             öppna menyn för att få veta det. */
          if (avatar) {
            const letter = (user?.email ?? '').trim().charAt(0);
            avatar.textContent = letter;
            avatar.hidden = !authed || letter === '';
          }
          if (picker) {
            if (authed) picker.dataset.signedIn = '';
            else delete picker.dataset.signedIn;
          }

          await paintBell(authed);
        };

        signin.addEventListener('click', async () => {
          if (await openSignIn(signin)) await paint();
        });

        signout.addEventListener('click', async () => {
          await signOut();
          await paint();
          /* Sidan laddas om. Bevakningsknappen på verksamhetssidan och
             omdömesformuläret har egna tillstånd som satts vid laddning, och
             att låta dem tro att någon fortfarande är inloggad är värre än en
             omladdning. */
          location.reload();
        });

        /* Loggar man in via bevakningsknappen eller omdömesknappen ska
           raden här visa det utan omladdning. */
        onAuthChange(() => void paint());

        void paint();
      }
    }
  }

  /**
   * Progressiv förstärkning av menyn. Allt här är sådant som inte går att
   * göra utan skript. Markupen ovanför fungerar utan.
   */
  const picker = document.querySelector<HTMLDetailsElement>('[data-picker]');
  if (picker) {
    const summary = picker.querySelector('summary')!;
    const panel = picker.querySelector<HTMLElement>('[data-panel]')!;

    summary.setAttribute('aria-expanded', 'false');

    picker.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', String(picker.open));
    });

    document.addEventListener('click', (event) => {
      if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
    });

    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false;
        summary.focus();
        return;
      }
      if (event.key !== 'Tab' || !picker.open) return;

      // Fokusfälla: lagret ligger ovanpå sidan, och att tabba ut ur det utan
      // att stänga det lämnar användaren med fokus på något osynligt.
      const focusable = [
        summary,
        ...panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled])',
        ),
      ].filter((el) => el.offsetParent !== null || el === summary);

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
