</details>

<style>
  .picker {
    /* Ingen `position: relative` längre. Panelen är helbredd och ankras i
       viewporten, inte i knappen, och en relativ förälder hade inte ändrat
       det, men den hade gjort det oklart vad panelen egentligen räknar mot. */
    flex-shrink: 0;
  }

  /* ── KNAPPEN ───────────────────────────────────────────────────────────── */

  /* Kvadratiska mått, inte höjd plus padding. Knappen var ett piller med
     texten "Kommun" bredvid ikonen; när texten togs bort behöll den sin
     padding-inline och blev en oval. Nu samma tal på båda ledder.

     Cirkeln får vara tom. Den markerar att ikonen är något man trycker på.
     En fylld yta hade vägt lika tungt som wordmarken i andra änden av raden.

     Här stod att 36 px är "ungefär gränsen för en fingertopp". Det är fel:
     WCAG 2.5.5 och Apples egen riktlinje säger 44, och det här är sajtens
     enda meny och står längst ut vid skärmkanten på en telefon. Cirkeln
     ritas fortfarande 36 för att inte väga över wordmarken; träffytan bärs
     av ett genomskinligt ::after längre ned. Se --h-tap i tokens.css. */
  .trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
    /* Knappen ska ligga över panelen och skuggan. Den är krysset. */
    position: relative;
    z-index: 2;
  }

  /* Inloggad blir knappen ett piller med hamburgaren och avataren bredvid
     varandra, som hos Airbnb. Utloggad är den en tom cirkel. Bredden får växa,
     höjden aldrig: sidhuvudet är --h-bar högt och en knapp som ändrar höjd skulle
     flytta wordmarken och sökfältet när man loggar in. */
  .picker[data-signed-in] .trigger {
    width: auto;
    gap: 6px;
    padding: 0 5px 0 10px;
    border-radius: var(--r-pill);
  }

  .trigger:hover {
    background: var(--canvas);
    border-color: var(--tone-quiet);
  }

  /* Träffytan, 44 px, oberoende av cirkelns 36. Ett genomskinligt ::after
     4 px utanför åt alla håll, samma grepp som kartknapparna i kartram.css.
     Inloggad är knappen ett bredare piller och då hänger ytan lika mycket
     utanför det. */
  .trigger::after {
    content: '';
    position: absolute;
    inset: -4px;
  }

  /* Safari ritar en egen triangel på summary. */
  .trigger::-webkit-details-marker { display: none; }

  .glyph {
    width: 18px;
    height: 18px;
    color: var(--text-secondary);
  }

  /* Glyfbytet. Ett kryss när menyn är öppen, tre streck när den är stängd.
     Bytet sker i CSS ur <details open>, alltså utan en rad skript, och därför
     stämmer ikonen även för den som har JavaScript avstängt. */
  .glyph .g-kryss { display: none; }
  .picker[open] .glyph .g-meny { display: none; }
  .picker[open] .glyph .g-kryss { display: block; }

  /* Under utgången är menyn tekniskt fortfarande öppen, se skriptet. Knappen
     ska ändå säga "meny" direkt vid klicket: besked om att stängningen tagit
     emot ska inte vänta på att den blivit klar. */
  .picker[data-stanger] .glyph .g-meny { display: block; }
  .picker[data-stanger] .glyph .g-kryss { display: none; }

  .picker[open] .trigger {
    background: var(--canvas);
    border-color: var(--tone-quiet);
  }

  .picker[data-stanger] .trigger {
    background: var(--card);
    border-color: var(--hairline);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-size: var(--fs-caption);
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .avatar[hidden] { display: none; }

  /* Klockan mellan hamburgaren och avataren. Ingen egen fyllning och ingen
     ram: den ska väga som glyfen till vänster om sig och inte som en andra
     knapp. Det som drar blicken är pricken. */
  .bell {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    color: var(--text-secondary);
  }

  .bell[hidden] { display: none; }
  .bell svg { width: 18px; height: 18px; }

  /* Pricken sitter PÅ klockan och inte bredvid den. --brand mot --card ger
     3,3:1, alltså under 4,5:1 för text men klart över 3:1 för grafik, och
     pricken är grafik: beskedet finns i klartext i knappens aria-label och i
     panelens rad. Vit ring runt om så att den läser som en pålagd markering
     även när den hamnar över en linje i ikonen. */
  .pip {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--card);
    border-radius: 50%;
    background: var(--brand);
  }

  /* ── PANELEN ───────────────────────────────────────────────────────────── */

  /* --h-bar är sidhuvudsradens höjd, satt i tokens.css och använd i
     Header.astro. Panelen börjar där
     raden slutar, alltså under wordmarken och sökfältet, som båda blir kvar
     synliga och användbara. Se filhuvudet för varför den inte täcker raden. */
  .panel {
    position: fixed;
    top: var(--h-bar);
    left: 0;
    right: 0;
    z-index: 1;
    background: var(--card);
    border-bottom: 1px solid var(--hairline);
    /* Sista utvägen på en låg skärm i liggande läge. dvh och inte vh: på iOS
       är vh den utfällda adressfältets höjd, alltså fel varje gång fältet är
       inne. */
    max-height: calc(100dvh - var(--h-bar));

    /* Rullningslistens bredd, medan låset håller. Panelen ligger FAST i
       vyporten och mäter alltså mot den, medan sidan under mäter mot en body
       som page-lock redan gett samma tal i padding. Utan den här raden blir
       panelen 15 px bredare än sidan i samma ögonblick som låset tar bort
       listen, och innehållet, som är centrerat i en container, flyttar sig
       halva talet åt höger. Mätt vid 1440 px: kortens vänsterkant hoppade
       från 181,0 till 188,5 och blev kvar där.

       Det bröt dessutom mot det panelen är byggd för, se filhuvudet: dess
       vänsterkant ska ligga exakt under wordmarken i raden ovanför, och raden
       ovanför sitter i sidans flöde.

       Variabeln sätts av lib/page-lock.ts och finns bara medan något ark är
       öppet. Den är noll på telefon, där det inte finns någon list. */
    padding-right: var(--lock-gutter, 0px);

    /* Rutnätet finns bara för att höjden ska gå att animera.
       `grid-template-rows` mellan 0fr och 1fr är den enda vägen till ett
       höjdförlopp som slutar på innehållets EGEN höjd, utan att någon mäter
       panelen i skript och utan ett påhittat max-height att räkna ned från.
       Se förloppet längst ned i filen. */
    display: grid;
    grid-template-rows: 1fr;
    overflow: hidden;
  }

  /* Raden i rutnätet ovanför. `min-height: 0` är det som gör att raden får
     krympa till noll: ett rutnätsspår vägrar annars bli mindre än sitt
     innehåll, och hela höjdförloppet uteblir utan att något ser trasigt ut. */
  .rull {
    min-height: 0;
    overflow-y: auto;
    /* Rullar man klart inuti panelen ska sidan bakom inte ta vid. */
    overscroll-behavior: contain;

    /* HÄR SATT SJÄLVA HOPPET, och det är mätt bildruta för bildruta.
     *
     * Luckan ovanför animerar höjden från noll. Under hela det förloppet är
     * .rull alltså LÄGRE än sitt innehåll, och `overflow-y: auto` gör då det
     * den ska: den ritar en rullningslist. Listen är 15 px bred och äter av
     * innehållsrutan. I samma ögonblick som luckan når full höjd får
     * innehållet plats, listen försvinner, rutan blir 15 px bredare och allt
     * centrerat i den flyttar sig halva talet åt höger.
     *
     * Mätt vid 1440 px, som avstånd mellan panelens container och
     * sidhuvudets, alltså noll när de ligger i linje:
     *
     *   under förloppet   .rull har 15 px list, avvikelse -7,5 px
     *   när menyn satt sig .rull har 0 px list, avvikelse 0
     *
     * Hoppet kommer alltså precis när menyn slutar röra sig, vilket är exakt
     * när ögat vilar på den. Det är ägarens "hoppar till lite till höger",
     * och det har ingenting med sidans egen rullningslist att göra: det
     * händer inuti panelen.
     *
     * `stable both-edges` reserverar listens plats på BÅDA sidor, alltid,
     * oavsett om någon list ritas. Bredden slutar därmed bero på om
     * innehållet råkar få plats just nu. Båda sidor och inte bara höger,
     * eftersom innehållsrutan då förblir CENTRERAD i panelen, och det är det
     * som håller panelens container i linje med sidhuvudets. Mätt efteråt:
     * noll avvikelse i varenda bildruta genom hela förloppet.
     *
     * På telefon ritas listen ovanpå innehållet i stället för bredvid, och då
     * reserverar regeln ingenting alls. Den kostar alltså bara något där det
     * finns en list som faktiskt tar plats. */
    scrollbar-gutter: stable both-edges;
  }

  .inner {
    padding-top: var(--s-6);
    padding-bottom: var(--s-8);
  }

  /* Skuggan. Täcker allt under raden, alltså exakt det panelen inte gör.
     Svag: sidan ska läsa som nedtonad, inte som bortsläckt. */
  .scrim {
    position: fixed;
    top: var(--h-bar);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    background: rgba(0, 0, 0, .28);
  }

  /* ── ÖVERDELEN: KORT OCH LÄNKAR ────────────────────────────────────────── */

  /* Ednia ger korten 520 av 1416 px, alltså 37 procent, och länkspalterna
     resten. Samma förhållande här, uttryckt i fraktioner så att det håller i
     varje bredd. */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 37fr) minmax(0, 63fr);
    gap: var(--s-8);
    align-items: start;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  /* Korten. --shadow-sm bär både ringen och lyftet, så ingen egen border:
     en border ovanpå ringen hade gett två linjer på samma kant. */
  .kort {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 108px;
    padding: var(--s-4);
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: var(--shadow-sm);
    color: var(--text);
  }

  .kort:hover {
    text-decoration: none;
    background: color-mix(in srgb, var(--brand) 5%, var(--card));
  }

  /* Samma mått som .ikon i avsnitten nedanför, inte större.
     Korten är bredare än plattorna, och ikonen fick tidigare 32 px för att
     fylla dem. Det gjorde den till panelens tyngsta grafik och till den enda
     som inte matchade de sex andra, trots att den ritades i samma streck.
     Ett kort får sin tyngd av sin ram och sin etikett, inte av sin ikon. */
  .kort-ikon {
    width: 26px;
    height: 26px;
    color: var(--text-secondary);
  }

  .kort-text {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
  }

  /* Länkspalterna. Tre kolumner med två, två och en rad, alltså exakt
     förlagans fördelning: Ednia har Räkna ut merit / Om Ednia, Karta med alla
     skolor / För SYVare, och För skolor ensam i tredje.

     Kolumnerna HUGGER sitt innehåll i stället för att delas lika. Med
     `1fr 1fr` sträcktes de över hela 63-procentsytan och kontoraden hamnade
     ensam ute vid högerkanten med tvåhundra tomma pixlar omkring sig. Ednias
     kolumner ligger 264 px isär, vilket är etiketten plus luft och inte en
     tredjedel av något. --s-12 är vårt närmaste mått på den luften. */
  .meta {
    display: flex;
    gap: var(--s-12);
    align-items: start;
  }

  /* Tre rader, sedan ny kolumn. Ordningen blir Metodik / Källor / Hjälp i
     första kolumnen och Om Prikko / Webbkarta / Kontakt i andra, alltså
     läsordning nedåt och inte i sicksack.

     Raderna var två så länge länkarna var fyra. Hjälp och Kontakt gjorde dem
     sex, och med två rader hade det blivit tre smala remsor med 48 px emellan.
     Talet här är alltså antalet länkar delat på två, och det ska ändras när
     listan gör det. */
  .lankar {
    display: grid;
    grid-template-rows: repeat(3, auto);
    grid-auto-flow: column;
    gap: 0 var(--s-12);
    justify-content: start;
  }

  /* Ikonen är 18 och inte 24. Avsnittens ikoner sitter på en 80 px platta och
     bär raden ensamma; de här sitter bredvid 14 px text och ska väga mindre än
     ordet, inte lika mycket. Samma 24-rutnät och samma 1,6 px streck, se
     filhuvudet: det är storleken som skiljer, inte språket. */
  .radikon {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--tone-quiet);
  }

  .lankar a,
  .account-in {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* Ikonen följer med i radens hovring. Utan det stannar den kvar i grått
     medan ordet blir svart, och raden ser halvt utsläckt ut. */
  .lankar a:hover .radikon,
  .account-in:hover .radikon { color: var(--text); }

  .account,
  .account-out {
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  /* Måste stå utskrivet. `hidden` är display: none i webbläsarens egen
     stilmall, och varje egen display-regel vinner över den. Utan de här två
     raderna syns både kontoblocket och den inloggade delen alltid. */
  .account[hidden],
  .account-out[hidden] { display: none; }

  /* En enda regel för varje klickbar rad i spalterna, oavsett om den tekniskt
     är en <a> eller en <button>. Att utloggningen är en knapp beror bara på
     att den inte byter sida, och det är ett genomförandedetalj som inte ska
     synas. */
  .lankar a,
  .account-in,
  .account-out a,
  .linky {
    padding: 6px 10px;
    margin-inline: -10px;
    border-radius: var(--r-control);
    font: inherit;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
    /* SVART, inte grått.
       ─────────────────────────────────────────────────────────────────────
       Ägaren 2026-08-22: "varför är länkarna i en grå och inte vår svarta
       färg?"

       Det fanns inget skäl. `--text-secondary` är sajtens DÄMPADE ton och
       hör hemma på underrader, metatext och det som förklarar något annat.
       De här raderna är menyns huvudinnehåll och det enda man kommit hit för
       att klicka på. Ikonen bredvid är fortsatt dämpad, se .radikon, för den
       ÄR en underordnad markering till ordet. */
    color: var(--text);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .lankar a:hover,
  .account-in:hover,
  .account-out a:hover,
  .linky:hover {
    text-decoration: none;
    color: var(--text);
    background: var(--canvas);
  }

  /* Notisraden. Samma rad som "Ditt konto", plus ett tal längst ut. */
  .notis-rad {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  /* Talet. Piller i brandblått med vit text, alltså 4,5:1 och läsbart som text
     ska vara. Träffytan är radens, inte pillrets: hela raden är länken. */
  .notis-antal {
    flex: none;
    min-width: 20px;
    padding: 1px 6px;
    border-radius: var(--r-pill);
    background: var(--brand);
    color: #fff;
    font-size: var(--fs-eyebrow);
    line-height: var(--lh-eyebrow);
    font-weight: 600;
    text-align: center;
  }

  .notis-antal[hidden] { display: none; }

  /* Adressen man loggat in med. Inte en länk och inte klickbar: den är en
     upplysning om vem sajten tror att du är, och det enda man vill göra med
     den är att läsa den. */
  .who {
    padding: 0 0 var(--s-1);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  /* ── HÅRLINJEN OCH AVSNITTEN ───────────────────────────────────────────── */

  .delare {
    height: 1px;
    margin: var(--s-6) 0;
    border: 0;
    background: var(--hairline);
  }

  /* Avsnitten sida vid sida.
   *
   * MÄTT I WEBBLÄSAREN DEN 12 AUGUSTI 2026, VID 1440 px, MED MENYN ÖPPEN:
   *
   *   ednia.se    panelen helbredd 1425 px och 250 px HÖG. Allt ligger i ETT
   *               band: två kort 234 och 246 px breda med 16 px emellan till
   *               vänster, och länkarna i två spalter till höger, 300 px isär,
   *               raddelning 40 px, radhöjd 32, text 14 px vikt 600 i #717171.
   *               Inga avdelare alls, bara luft.
   *   airbnb.se   en LITEN panel, 265 x 329 px, radie 12, skugga
   *               0 2px 16px rgba(0,0,0,.12), rader 36 px höga, text 14 px
   *               vikt 400, hårlinje mellan grupperna, kontoraden sist.
   *   booli.se    HAR INGEN meny på desktop. Fem länkar direkt i raden.
   *               Ingen panel att mäta, alltså ingen förlaga för det här.
   *
   * Vår panel var 525 px hög, alltså mer än dubbelt mot ednias 250. Skillnaden
   * satt inte i innehållet utan i att vi staplade tre band där ednia har ett:
   * kort och länkar överst, sedan Hitta ett ställe, sedan Läs vad siffrorna
   * säger. Två av banden tar 128 px var plus luft.
   *
   * Spalterna HUGGER sitt innehåll och delar inte panelen i halvor. Fyra rutor
   * blir 4 x 84 + 3 x 8 = 360 px och tre blir 268 px, med --s-12 emellan alltså
   * 676 px av 1080. Resten lämnas tom med flit: sträcks spalterna ut till
   * varsin halva hamnar tre rutor med 250 tomma pixlar bredvid sig, och då
   * läser panelen som en sida med kolumner i stället för som en meny. Det är
   * samma val som redan gjorts för länkspalterna i .meta ovanför, och det är
   * så ednia gör med sina 300 px.
   */
  .avsnitten {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6) var(--s-12);
    align-items: start;
  }

  .rubrik {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    color: var(--text);
  }

  .rutor {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rutor a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    width: 84px;
    padding: var(--s-2) 0;
    border-radius: var(--r-card);
    color: var(--text);
    text-align: center;
  }

  .rutor a:hover { text-decoration: none; }

  /* Plattan. Ednia har #f6f6f6 mot vitt; --canvas ligger tre RGB-steg från
     --card och hade inte synts alls, så tonen räknas ur bläcket i stället och
     följer därmed med i mörkt läge. */
  .platta {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--r-card);
    background: color-mix(in srgb, var(--text) 5%, transparent);
    color: var(--text-secondary);
  }

  .rutor a:hover .platta {
    background: color-mix(in srgb, var(--brand) 10%, transparent);
    color: var(--brand-ink);
  }

  .ikon {
    width: 26px;
    height: 26px;
  }

  .ruta-text {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  /* ── SMALA SKÄRMAR ─────────────────────────────────────────────────────── */

  @media (max-width: 720px) {
    /* Korten och länkarna över varandra. Under ungefär 720 px blir en 37/63-
       delning två kolumner som båda är för smala för sitt innehåll: kortens
       etiketter bryts mitt i ett ord och länkarna hamnar i två rader var. */
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }

    /* Länkarna blir EN spalt. Tre kolumner som hugger sitt innehåll får plats
       i bredd även här, men de blir tre smala remsor med 48 px emellan, och
       ögat läser dem då som tre orelaterade listor i stället för som en. */
    .meta {
      flex-direction: column;
      gap: var(--s-4);
    }

    .lankar {
      grid-auto-flow: row;
      grid-template-rows: none;
    }

    /* Avsnitten under varandra igen. Två spalter om 360 och 268 px får inte
       plats bredvid varandra under 720, och en spalt som bryter mitt i en rad
       rutor läser som att något saknas. */
    .avsnitten {
      flex-direction: column;
      gap: var(--s-6);
    }

    .inner {
      padding-top: var(--s-4);
      padding-bottom: var(--s-6);
    }

    .delare { margin: var(--s-4) 0; }
  }

  @media (max-width: 480px) {
    /* Här låg en regel som dolde varje span i knappen. Den var från den tid då
       knappen bar etiketten "Kommun", och när etiketten försvann dolde den i
       stället precis det som ska synas på telefon: avataren, klockan och
       pricken. Just där är sidhuvudet det enda man ser av kontot utan att
       öppna menyn. Regeln är borttagen och inte ersatt. */
    .trigger { padding-inline: var(--s-2); }

    /* Plattorna krymper så att fyra ryms i bredd på en 375 px skärm:
       4 x 76 + 3 x 8 = 328, mot 343 tillgängliga innanför containerns
       padding. Fem hade inte gått, och en rad som bryter mitt i ett avsnitt
       läser som att något saknas. */
    .rutor a { width: 76px; }
    .platta { width: 60px; height: 60px; }
  }

  /* ── FÖRLOPPET ─────────────────────────────────────────────────────────── */

  /* Här stod tidigare att panelen INTE skulle tona in, med skälet att text som
     tonar in läses senare än text som står där. Beställningen är en annan:
     menyn ska öppna mjukt. Skälet gäller fortfarande för långsam text, och
     det är därför innehållet är klart efter 280 ms medan luckan håller på i
     380 ms, alltså läser man medan panelen slutar röra sig, inte efteråt.
     Ingen läsare hinner vänta på 280 ms, och en meny som slår upp utan förlopp
     läser som ett sidbyte i stället för som ett lager ovanpå sidan.

     Talen är mätta på ednia.se den 12 augusti 2026, i webbläsaren, med deras
     egen desktopmeny öppen:

       luckan     transition height, .38s cubic-bezier(.48, .22, .04, 1)
       innehållet transform + opacity, .28s samma kurva, scale .95 till 1

     Kurvan är samma i båda riktningarna. Den startar snabbt och lägger sig
     långsamt, alltså rör sig menyn mest när den är minst och står nästan
     stilla när den är störst. Det är det som gör att en yta på en halv skärm
     inte känns tung.

     ── ETT AVSTEG: INGEN SKALA, UTAN EN FÖRSKJUTNING NEDÅT ──────────────────
     Här stod `scale(.97)`, och DET var hoppet i sidled ägaren såg två gånger:
     "när jag fäller ut hamburgaremenyn så hoppar den till lite till höger".

     En skala växer åt alla håll från sin mittpunkt, alltså också i sidled.
     Mätt bildruta för bildruta genom hela öppningen, med panelens innehåll:

       1440 px    högerkanten sveper 27,7 px åt höger, kortens vänsterkant
                  15,7 px åt vänster
        375 px    högerkanten 5,6 px åt höger, vänsterkanten 5,1 px

     Menyknappen står stilla hela tiden. Det som rör sig är innehållet, och
     det rör sig utåt just där handen nyss släppte knappen. Talen är dessutom
     desamma på telefon, där det inte finns någon rullningslist alls, vilket
     var vad som avslöjade att listen aldrig var förklaringen.

     Föregångaren såg samma sak och skrev ned den: skalan sänktes från ednias
     .95 till .97 för att "kortens vänsterkant drog synligt inåt från
     wordmarken ovanför". Det halverade sidledsrörelsen i stället för att ta
     bort den, och kvar blev precis så mycket att det läser som en bugg.

     `translateY` i stället. Åtta pixlar uppifrån och ned, alltså samma mjuka
     landning och samma riktning som luckan redan växer åt, med exakt noll i
     sidled. Ett värde som får ändras är talet, aldrig axeln: allt som rör
     panelen i x-led kommer tillbaka som samma felanmälan. */
  /* ÖVERGÅNG OCH INTE @KEYFRAMES, och det är mätt fram och inte valt.
   *
   * Första versionen la `animation: meny-lucka-in` på `.picker[open] .panel`
   * och lät alltså <details> starta förloppet genom att börja matcha. Det gav
   * en meny som ibland slog upp utan rörelse. Mätt i webbläsaren, samma sida,
   * samma bildruteloop: ena gången skapades tre animationer och panelen stod
   * på 0px i första bildrutan, andra gången skapades ingen alls och den stod
   * på 358px direkt. Samma kod, olika utfall.
   *
   * Skälet är att panelen byter från olayoutad till layoutad i exakt samma
   * ögonblick som regeln börjar gälla, och om en animation då startar eller
   * anses redan avslutad är inget man ska behöva gissa. Ett förlopp som
   * fungerar för det mesta är värre än inget förlopp: det ser ut som en bugg.
   *
   * En övergång mellan två lägen som SKRIPTET sätter är däremot entydig. Vi
   * ger panelen 0fr, låter en bildruta gå så att webbläsaren hinner se det
   * läget, och sätter sedan data-oppen. Då finns två tillstånd att gå emellan
   * och rörelsen blir densamma varje gång.
   *
   * UTAN SKRIPT gäller inget av det här. `.panel` står kvar på 1fr, menyn
   * fälls ut på studs och allt fungerar, precis som filhuvudet lovar. Motionen
   * ligger bakom data-mjuk, som skriptet sätter först när det vet att det kan
   * ta hand om både vägen in och vägen ut. */
  @media (prefers-reduced-motion: no-preference) {
    .picker[data-mjuk] .panel {
      grid-template-rows: 0fr;
      transition: grid-template-rows 380ms cubic-bezier(.48, .22, .04, 1);
    }

    .picker[data-mjuk] .inner {
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 280ms cubic-bezier(.48, .22, .04, 1),
        transform 280ms cubic-bezier(.48, .22, .04, 1);
    }

    .picker[data-mjuk] .scrim {
      opacity: 0;
      transition: opacity 180ms ease-out;
    }

    .picker[data-mjuk][data-oppen] .panel { grid-template-rows: 1fr; }
    .picker[data-mjuk][data-oppen] .inner { opacity: 1; transform: none; }
    .picker[data-mjuk][data-oppen] .scrim { opacity: 1; }

    /* Utgången är kortare än ingången, som allt som stänger: att öppna är ett
       svar på en fråga och får ta tid, att stänga är ett besked om att man är
       klar. Bara tiden skrivs om, aldrig kurvan: samma rörelse åt båda håll
       är det som gör att panelen känns som ETT föremål. Två attribut väger
       tyngre än ett, så reglerna vinner över tiderna ovanför oavsett ordning. */
    .picker[data-mjuk][data-stanger] .panel { transition-duration: 300ms; }
    .picker[data-mjuk][data-stanger] .inner { transition-duration: 200ms; }
    .picker[data-mjuk][data-stanger] .scrim { transition-duration: 260ms; }
  }
</style>

<script>
  import {
    configured,
    currentUser,
    onAuthChange,
    signedIn,
    signOut,
    unreadNotices,
  } from '../lib/community';
  import { openSignIn } from '../lib/signin-dialog';
  import { lockPage, unlockPage } from '../lib/page-lock';

  /**
   * Kontoblocket i panelen.
   *
   * Ligger före menyns egen kod eftersom det inte har med öppna och stäng att
   * göra och inte får falla bort om något i den delen brister.
   */
  {
    const box = document.querySelector<HTMLElement>('.account');
    const signin = document.querySelector<HTMLButtonElement>('[data-signin]');
    const out = document.querySelector<HTMLElement>('[data-account]');
    const who = document.querySelector<HTMLElement>('[data-who]');
    const signout = document.querySelector<HTMLButtonElement>('[data-signout]');

    if (box && signin && out && who && signout) {
      /* Bara `configured`, ALDRIG signInAvailable() här. signInAvailable()
         svarar på om rutan hunnit registrera sig, och det beror på
         skriptordningen: menyn ligger i sidhuvudet och rutan sist i body, så
         menyns skript kör först och får alltid nej. Blocket doldes därför
         alltid, och eftersom `hidden` inte överlever en egen `display: flex`
         syntes det ändå, fast utan klickhanterare.

         openSignIn() svarar redan false när rutan saknas, så hanteraren får
         sitta ovillkorligt. */
      if (!configured) {
        box.hidden = true;
      } else {
        const picker = document.querySelector<HTMLElement>('[data-picker]');
        const avatar = document.querySelector<HTMLElement>('[data-avatar]');
        const trigger = document.querySelector<HTMLElement>('[data-trigger]');
        const bell = document.querySelector<HTMLElement>('[data-bell]');
        const antal = document.querySelector<HTMLElement>('[data-notis-antal]');

        /**
         * Klockan och talet i panelen.
         *
         * ETT anrop, och bara för den som är inloggad. Sidhuvudet ligger på
         * 15 500 sidor, så räkningen görs av community.unread_notices() i
         * databasen i stället för av tre frågor härifrån.
         *
         * Anropet läggs sist i paint() och inte först: blocket ska vara rätt
         * målat innan vi väntar på nätet. Faller anropet svarar
         * unreadNotices() noll, och klockan uteblir i stället för att skrika
         * om ett fel besökaren inte kan göra något åt.
         */
        const paintBell = async (authed: boolean) => {
          const unread = authed ? await unreadNotices() : 0;

          if (bell) bell.hidden = unread === 0;
          if (antal) {
            /* Nio och uppåt skrivs som "9+". Ett tresiffrigt tal i ett piller
               spränger raden, och skillnaden mellan 14 och 40 olästa ändrar
               ingenting för den som ska bestämma sig för att klicka. */
            antal.textContent = unread > 9 ? '9+' : String(unread);
            antal.hidden = unread === 0;
          }

          /* Knappens namn i klartext. Ikonen är aria-hidden, så det här är
             enda stället beskedet finns för den som inte ser pricken. */
          if (trigger) {
            trigger.setAttribute(
              'aria-label',
              unread === 0
                ? 'Meny'
                : `Meny, ${unread} ${unread === 1 ? 'oläst notis' : 'olästa notiser'}`,
            );
          }
        };

        const paint = async () => {
          const authed = await signedIn();
          const user = authed ? currentUser() : null;
          signin.hidden = authed;
          out.hidden = !authed;
          who.textContent = user?.email ?? '';

          /* Sidhuvudet ska visa att någon är inloggad utan att man behöver
             öppna menyn för att få veta det. */
          if (avatar) {
            const letter = (user?.email ?? '').trim().charAt(0);
            avatar.textContent = letter;
            avatar.hidden = !authed || letter === '';
          }
          if (picker) {
            if (authed) picker.dataset.signedIn = '';
            else delete picker.dataset.signedIn;
          }

          await paintBell(authed);
        };

        signin.addEventListener('click', async () => {
          if (await openSignIn(signin)) await paint();
        });

        signout.addEventListener('click', async () => {
          await signOut();
          await paint();
          /* Sidan laddas om. Bevakningsknappen på verksamhetssidan och
             omdömesformuläret har egna tillstånd som satts vid laddning, och
             att låta dem tro att någon fortfarande är inloggad är värre än en
             omladdning. */
          location.reload();
        });

        /* Loggar man in via bevakningsknappen eller omdömesknappen ska
           blocket här visa det utan omladdning. */
        onAuthChange(() => void paint());

        void paint();
      }
    }
  }

  /**
   * Progressiv förstärkning av menyn. Allt här är sådant som INTE går att göra
   * utan skript. Markupen ovanför fungerar utan.
   */
  const picker = document.querySelector<HTMLDetailsElement>('[data-picker]');
  if (picker) {
    const summary = picker.querySelector('summary')!;
    const panel = picker.querySelector<HTMLElement>('[data-panel]')!;
    const scrim = picker.querySelector<HTMLElement>('[data-scrim]')!;

    summary.setAttribute('aria-expanded', 'false');

    /* Skrollåset. page-lock.ts och ingen egen rad: modulen räknar hållare, så
       kedjan meny -> inloggningsruta lämnar över låset utan att sidan hinner
       återgå och hoppa emellan. `held` finns för att toggle kan avfyras av
       annat än ett klick, och ett obalanserat lockPage/unlockPage lämnar
       sidan fixerad för gott. */
    let held = false;

    /**
     * Motionen slås PÅ HÄR och inte i markupen.
     *
     * `data-mjuk` är skriptets löfte om att det tar hand om både vägen in och
     * vägen ut. Stilen ger panelen 0fr bakom det attributet, och utan skript
     * sätts det aldrig, alltså står panelen kvar på 1fr och menyn fungerar på
     * studs. Det är skillnaden mellan en förstärkning och ett krav.
     */
    picker.setAttribute('data-mjuk', '');

    /* Står menyn redan öppen när skriptet kommer fram ska den FÖRBLI öppen.
       Skriptet ligger i sidhuvudet men körs som modul, alltså efter att sidan
       ritats, och hinner man klicka på hamburgaren dessförinnan är menyn öppen
       utan data-oppen. Raden ovanför ger då panelen 0fr och menyn viks ihop av
       sig själv i samma ögonblick som skriptet laddar. Ett attribut till, och
       det kan inte hända. */
    if (picker.open) picker.setAttribute('data-oppen', '');

    /**
     * Fäller ut panelen, alltså startar övergången från 0fr till 1fr.
     *
     * TVÅ BILDRUTOR, INTE EN. Panelen finns inte i layouten medan menyn är
     * stängd. Sätts data-oppen i samma bildruta som `open` ser webbläsaren bara
     * slutläget, och då finns ingenting att gå emellan: menyn slår upp utan
     * rörelse.
     *
     * OCH EN TIMER BAKOM DEM. requestAnimationFrame kör INTE i en dold flik.
     * Mätt på det byggda bygget: fliken låg i bakgrunden, `document.hidden` var
     * true, och återanropet kom aldrig inom 1,5 sekunder. Menyn öppnade sig då
     * till en enda pixel och blev kvar så, eftersom 0fr är utgångsläget och det
     * enda som tar den därifrån är just det attributet. En meny som öppnar sig
     * till ingenting är värre än en meny helt utan förlopp, och den sortens fel
     * märks först när någon byter flik mitt i.
     *
     * Är fliken redan dold hoppas rörelsen över helt. Det finns ingen att visa
     * den för, och panelen ska stå färdigt utfälld när man kommer tillbaka.
     */
    const visaPanelen = () => {
      const visa = () => {
        if (picker.open) picker.setAttribute('data-oppen', '');
      };

      if (document.hidden) {
        visa();
        return;
      }

      requestAnimationFrame(() => requestAnimationFrame(visa));
      setTimeout(visa, 100);
    };

    picker.addEventListener('toggle', () => {
      summary.setAttribute('aria-expanded', String(picker.open));

      if (picker.open) {
        visaPanelen();
      } else {
        picker.removeAttribute('data-oppen');
      }

      if (picker.open && !held) {
        held = true;
        lockPage();
      } else if (!picker.open && held) {
        held = false;
        unlockPage();
      }
    });

    /**
     * Stängningen, och varför den behöver en egen funktion.
     *
     * <details> tar bort panelen ur layouten i samma ögonblick som `open`
     * försvinner, alltså är det som skulle tona ut redan borta när bildrutan
     * ritas. Funktionen gör därför en enda sak: den tar bort data-oppen så att
     * övergången vänder, och skjuter upp `open = false` tills den spelat klart.
     *
     * Under uppskjutningen bär elementet `data-stanger`, som stilen använder
     * för att korta tiderna och för att vända glyfen tillbaka till tre streck
     * direkt. Menyn är alltså öppen i markupen men stängd för ögat, i 300 ms.
     *
     * Utan skript händer ingenting av detta, och menyn stänger på studs som
     * förut. Det är fortfarande ett fungerande läge och inte ett trasigt.
     */
    const mindreRorelse = matchMedia('(prefers-reduced-motion: reduce)');

    const stang = () => {
      if (!picker.open || picker.hasAttribute('data-stanger')) return;

      /* Den som bett om mindre rörelse ska INTE få stängningen fördröjd med
         300 ms i stället för animerad. Uteblir rörelsen ska även väntan göra
         det, annars känns menyn bara trög. */
      if (mindreRorelse.matches) {
        picker.open = false;
        return;
      }

      /* data-stanger kortar tiderna, data-oppen bort vänder riktningen. */
      picker.setAttribute('data-stanger', '');
      picker.removeAttribute('data-oppen');

      let klar = false;
      const slut = () => {
        if (klar) return;
        klar = true;
        /* `open` först, attributen sedan. I omvänd ordning finns det en
           bildruta där panelen varken är hopfälld eller borttagen, och då
           blinkar den upp i full höjd innan den försvinner. */
        picker.open = false;
        picker.removeAttribute('data-stanger');
      };

      /* Panelen bär det längsta förloppet, men transitionend BUBBLAR: kortens
         opacitet är klar efter 200 ms och skulle annars stänga menyn för
         tidigt. Därav både target och propertyName. */
      panel.addEventListener('transitionend', (event) => {
        if (event.target === panel && event.propertyName === 'grid-template-rows') slut();
      });

      /* Reservutgången. transitionend uteblir helt om fliken döljs mitt i
         förloppet, om höjden råkar vara oförändrad, eller om någon stilmall
         stryper övergången till noll. En meny som fastnar öppen med skrollåset
         på är värre än en meny som stänger utan förlopp. Talet ligger över de
         300 ms rörelsen tar. */
      setTimeout(slut, 420);
    };

    /* Klick på knappen när menyn är öppen. <details> hade stängt på studs, och
       preventDefault lämnar över till förloppet ovanför i stället. Öppningen
       rörs inte: den sköter elementet själv. */
    summary.addEventListener('click', (event) => {
      if (!picker.open || picker.hasAttribute('data-stanger')) return;
      event.preventDefault();
      stang();
    });

    /* Klick utanför stänger. Skuggan ligger INNE i <details>, alltså räknas
       den inte som utanför av contains(), och därför en egen rad för den. */
    scrim.addEventListener('click', stang);

    document.addEventListener('click', (event) => {
      if (picker.open && !picker.contains(event.target as Node)) stang();
    });

    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        stang();
        /* Fokus flyttas MED EN GÅNG och inte när förloppet är klart. Panelen är
           på väg bort, och 300 ms utan fokus någonstans är 300 ms då nästa
           tangenttryck går till dokumentet i stället för till knappen. */
        summary.focus();
        return;
      }
      if (event.key !== 'Tab' || !picker.open) return;

      /* Fokusfälla: panelen ligger ovanpå sidan, och att tabba ut ur den utan
         att stänga den lämnar användaren med fokus på något som ligger under
         en skugga. Listan räknas om vid varje Tab eftersom kontoblocket byter
         innehåll när någon loggar in medan menyn står öppen. */
      const focusable = [
        summary,
        ...panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled])',
        ),
      ].filter((el) => el.offsetParent !== null || el === summary);

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
