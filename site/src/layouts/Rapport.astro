---
/**
 * Layout för en rapport.
 *
 * Finns för att de tre sakerna som gör en rapport publicerbar inte får vara
 * upp till varje sidmall: egen title, egen description och kanonisk URL. Base
 * sätter canonical ur sökvägen, men titeln och beskrivningen skrivs för hand i
 * varje mall. En rapport som får en generisk beskrivning, eller ärver en
 * annans, är precis den tunna sidan kvalitetsgrinden finns för att stoppa.
 *
 * Därför läser den här layouten allt ur REPORTS i lib/rapporter.ts. En rapport
 * kan alltså inte publiceras utan att först ha en egen post i registret, och
 * registret är samma källa som indexsidan listar ur. De kan inte glida isär.
 *
 * Foten längst ned är en datumstämpel och tre länkar, ingenting mer. Den ska
 * INTE växa tillbaka till en källrad om varifrån talen kommer, och allra minst
 * till stycken med egen rubrik. Båda formerna har funnits och båda är strukna.
 * Se docs/18_sprakregler.md.
 */
import Base from './Base.astro';
import { SITE } from '../lib/site';
import { absolute, path } from '../lib/urls';
import { dataUpdated, report } from '../lib/rapporter';
import { formatDate } from '../lib/data';

interface Props {
  /** Nyckel i REPORTS. Allt annat härleds ur den. */
  slug: string;
}

const { slug } = Astro.props;
const r = report(slug);
const updated = dataUpdated();

/**
 * `@type: Report` och inte `Article`.
 *
 * Rapporten är en sammanställning av en datamängd, inte en artikel med en
 * mänsklig avsändare, och schema.org har en egen typ för just det. `author`
 * är organisationen av samma skäl: en byline med ett personnamn hade påstått
 * att någon skrivit slutsatserna, och de är räknade.
 *
 * `isBasedOn` pekar på källsidan, som redan bär datamängdens egen JSON-LD.
 * Det är den länk som gör kedjan sluten för en läsare som bara ser
 * strukturerad data.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  headline: r.title,
  description: r.description,
  inLanguage: 'sv-SE',
  datePublished: r.published,
  dateModified: updated,
  url: absolute('rapporter', r.slug),
  author: { '@type': 'Organization', name: SITE.legalName },
  publisher: { '@type': 'Organization', name: SITE.legalName },
  isBasedOn: {
    '@type': 'Dataset',
    name: 'Livsmedelskontroller i Sverige, normaliserade av Prikko',
    url: absolute('kallor'),
  },
};
---

<Base
  title={r.title}
  description={r.description}
  jsonLd={jsonLd}
  dataUpdated={updated}
>
  <article class="container read page">
    {/* FÄRSKHETSSTÄMPELN STÅR HÄR OCH INTE I FOTEN, sedan 2026-09-28.

        Rapportens tal räknas om vid varje bygge, publiceringsdatumet gör det
        inte. Förut stod bara publiceringsdatumet här uppe och färskheten fem
        tusen tecken längre ned i foten. Den som läste de första styckena såg
        alltså ett datum intill talen, och det var fel datum: på
        /rapporter/kedja-eller-fristaende/ stod "12 augusti 2026" bredvid
        73 840 kontroller som hämtades den 22 september, alltså 41 dagar fel.

        Det spelar roll för hur vi citeras. Mätt 2026-09-28 bar Bings utdrag
        för /orebro/ talen 1 232 och 312 medan sidan sa 1 233 och 318. Ett tal
        utan sitt rätta datum blir gammalt utan att det syns, och det enda
        botemedlet är att datumet står där talet står.

        Båda datumen behövs och betyder olika saker: det första är textens,
        det andra talens. De skrivs bara ut var för sig när de skiljer sig åt,
        eftersom två identiska datum efter varandra bara är brus.

        Detta är en datumstämpel och inte proveniens, se docs/18
        "Skillnaden mot en datumstämpel". Foten får därför fortfarande INTE
        växa tillbaka till en källrad om varifrån talen kommer. */}
    <header>
      <p class="eyebrow">
        <a href={path('rapporter')}>Rapport</a> · {formatDate(r.published)}
        {updated.slice(0, 10) !== r.published && (
          <> · talen uppdaterade {formatDate(updated)}</>
        )}
      </p>
      <h1>{r.title}</h1>
      <p class="lede text-secondary">{r.lede}</p>
    </header>

    <slot />

    {/* Tre länkar. Foten var först tre stycken med egen rubrik, sedan en
        källrad om underlagets storlek och varifrån talen räknats. Båda är
        strukna: en rapport ska inte redogöra för sina källor mitt på sidan,
        den ska länka till metodiken och källsidan som gör det. Se
        docs/18_sprakregler.md.

        Datumstämpeln stod här och står nu i ingressraden, se skälet där. Den
        ska inte sättas tillbaka på båda ställena: samma datum två gånger på
        en sida är den upprepning docs/18 förbjuder. */}
    <section class="method">
      <p>
        <a href={path('metodik')}>Så räknas bedömningen fram</a> ·
        {' '}<a href={path('kallor')}>Källor och uppdatering</a> ·
        {' '}<a href={path('ratta')}>Rätta en uppgift</a>
      </p>
    </section>
  </article>
</Base>

<style>
  /* Bredden kommer ur `.container.read` i tokens.css och står inte här.
     Sidan satte tidigare `max-width: var(--w-read)` rakt på behållaren, som
     är border-box, och läste därför 584 px vid 1440 i stället för 680. */
  .page {
    padding-block: var(--s-12) var(--s-16);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-top: var(--s-2);
  }

  .eyebrow a {
    color: inherit;
  }

  .lede {
    margin-top: var(--s-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Rapportens egna avsnitt formas här, så att varje rapport ser likadan ut
     utan att kopiera stilblock. Global, eftersom innehållet kommer via slot. */
  .page :global(section) {
    margin-top: var(--s-12);
  }

  .page :global(section h2) {
    margin-bottom: var(--s-4);
  }

  .page :global(section h3) {
    margin-top: var(--s-8);
    margin-bottom: var(--s-3);
  }

  .page :global(section p) {
    line-height: var(--lh-body);
  }

  .page :global(section p + p) {
    margin-top: var(--s-4);
  }

  .page :global(.plain) {
    margin: 0;
    padding-left: var(--s-4);
  }

  .page :global(.plain li) {
    margin-top: var(--s-3);
    line-height: var(--lh-body);
  }

  .page :global(.callout) {
    margin-top: var(--s-4);
    padding: var(--s-4);
    background: var(--card);
    border-left: 3px solid var(--verdict-none);
    border-radius: 0 var(--r-control) var(--r-control) 0;
    font-size: var(--fs-body-s);
    line-height: 21px;
  }

  /* Tabell och stapelmått delas av rapporterna. Talen är alltid
     tabellsiffror: en kolumn med andelar där siffrorna hoppar i sidled är
     oläsbar, och det är kolumnen hela rapporten vilar på. */
  .page :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-body-s);
    margin-top: var(--s-4);
  }

  .page :global(th),
  .page :global(td) {
    text-align: left;
    padding: var(--s-3) var(--s-2) var(--s-3) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .page :global(th) {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Vänsterluften måste finnas: högerställda talkolumner har ingen egen kant,
     och utan den satt "60" och "80,0 %" ihop till "6080,0 %" på mobil. */
  .page :global(td.num),
  .page :global(th.num) {
    text-align: right;
    padding-left: var(--s-4);
    padding-right: 0;
    font-variant-numeric: tabular-nums;
  }

  .method {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .method p {
    line-height: 22px;
    color: var(--text-secondary);
  }

  .method p + p {
    margin-top: var(--s-3);
  }
</style>
