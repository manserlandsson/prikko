---
/**
 * Baslayout — bär hela sajtens SEO/AEO-kontrakt.
 *
 * Varje indexerbar sida MÅSTE ha: unik title, unik description, kanonisk URL
 * och (för entitetssidor) JSON-LD. `noindex` är kvalitetsgrinden från bibeln
 * §6 — tunna sidor utan data får aldrig indexeras, för "svagaste länken"
 * drar ner hela domänen vid scaled-content-bedömning.
 */
import '@fontsource-variable/instrument-sans';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignInDialog from '../components/SignInDialog.astro';
import Kvittens from '../components/Kvittens.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  /**
   * Utelämnar "| Prikko" i titeln. Sätts BARA där titeln behöver varje
   * tecken, se `varumarke` i title-mönstret nedan.
   */
  varumarkeITitel?: boolean;
  description: string;
  /** Sätts av kvalitetsgrinden när sidan saknar tillräcklig data. */
  noindex?: boolean;
  /** JSON-LD, ett eller flera objekt. Renderas server-side. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Egen delningsbild. Sätts BARA av sidor som har en riktig bild att visa,
   * alltså artiklarna med sina illustrationer.
   *
   * Lämnas den osatt får sidan sitt eget kort ur `/dela/...`, se nedan. Det
   * är inte en reservväg utan huvudvägen: 16 742 av 16 767 byggda sidor bar
   * samma og-default.png 2026-09-05, och 25 hade en egen.
   */
  ogImage?: string;
  /** ISO-datum då sidans DATA senast uppdaterades (färskhet = AEO-signal). */
  dataUpdated?: string;
  /**
   * Absoluta URL:er till föregående/nästa sida i en sidindelad serie.
   *
   * Google säger sig inte längre använda rel=prev/next som indexeringssignal,
   * men Bing gör det — och Bing driver ChatGPT:s webbsökning, vilket är en
   * uttalad kanal för oss (bibeln §6b). Taggarna kostar två rader och gör
   * dessutom seriens ordning explicit för varje annan läsare av sidan.
   */
  prev?: string;
  next?: string;
  /**
   * Falskt på sidor som inte ska bära sökfältet i raden alls.
   * Vidarebefordras rakt till Header; se resonemanget där.
   */
  headerSearch?: boolean;
  /**
   * Sant bara på startsidan. Sidhuvudet blir klistrat och bär sökfältet i
   * ett stort läge som fälls ihop vid rullning. Kräver att sidan lämnar
   * 144 px tomrum överst, se .storsok i index.astro.
   */
  hemhuvud?: boolean;
  /**
   * Falskt bara på kartsidan. Den är en app-yta som fyller hela höjden under
   * sidhuvudet och aldrig skrollar på sidnivå, och då finns inget "under
   * sidan" att lägga en sidfot på. Airbnb gör likadant på sin kartvy.
   * Sidfotens länkar finns på varje annan sida, inklusive kommunhubben som
   * kartan alltid länkar tillbaka till.
   */
  footer?: boolean;
}

const {
  title,
  varumarkeITitel = true,
  description,
  noindex = false,
  jsonLd,
  ogImage,
  dataUpdated,
  prev,
  next,
  headerSearch = true,
  hemhuvud = false,
  footer = true,
} = Astro.props;

// Kanonisk URL: alltid utan query/hash, alltid mot produktionsdomänen.
const canonical = new URL(Astro.url.pathname, SITE.url).href;

/*
 * DELNINGSBILDEN
 * ─────────────────────────────────────────────────────────────────────────
 * Mätt i site/dist 2026-09-05: 16 742 av 16 767 byggda sidor pekade på samma
 * `/og-default.png`. Titel och beskrivning var unika per sida, bilden var det
 * inte, alltså såg en länk till ett kök i Vasastan likadan ut som en länk till
 * startsidan i varje chatt och varje Slack-kanal. Delningsknappen fanns redan,
 * se `navigator.share` i Handlingsrad.astro.
 *
 * Sidan får därför sitt eget kort på `/dela/<sökväg>.png`, ritat av
 * `functions/dela/[[vag]].ts` när någon ber om det. Varför ritad och inte
 * byggd: en bild per sida är 17 868 nya filer ovanpå de 18 171 utgåvan redan
 * har, alltså 36 039 mot gratisplanens tak på 20 000. Rutten kostar i stället
 * en enda fil. Skälet och avvägningen står i `lib/delningsbild.ts` och i
 * docs/17 punkt 8b.
 *
 * Sökvägen speglar sidans egen: `/stockholm/ag/` blir `/dela/stockholm/ag.png`
 * och startsidan blir `/dela/start.png`. Funktionen läser sedan sidan tillbaka
 * ur bygget och hämtar orden därifrån, aldrig ur adressen.
 */
const kortVag = `/dela${Astro.url.pathname.replace(/\/$/, '') || '/start'}.png`;
const egenBild = ogImage !== undefined;
const ogImageUrl = new URL(ogImage ?? kortVag, SITE.url).href;

/*
 * Title-mönster: sidan leder, varumärket följer. Undvik dubblering på
 * startsidan.
 *
 * `varumarkeITitel={false}` stryker suffixet, och det finns för att
 * verksamhetssidorna behöver plats. Ägaren 2026-08-22 om ett verkligt
 * sökresultat: "borde inte titeln på google vara typ 'Hygienkontroll på
 * Normal, Sveavägen 17, Stockholm - Prikko'". Han har rätt i att sökordet
 * saknades. Mätt över alla 16 047 verksamheter, med Googles kapning omkring
 * 60 tecken:
 *
 *   Namn, Stad | Prikko                      median 37   över 60:  1,0 %
 *   Hygienkontroll på Namn, Stad | Prikko    median 55   över 60: 25,3 %
 *   Hygienkontroll på Namn, Stad             median 46   över 60:  6,3 %
 *
 * Sökordet först och varumärket struket ger alltså var sextonde kapad i
 * stället för var fjärde. Varumärket förloras inte: Google skriver "prikko.se"
 * på egen rad ovanför titeln, och SITE.name står kvar i og:site_name och i
 * WebSite-schemat.
 */
const fullTitle =
  title === SITE.name || !varumarkeITitel ? title : `${title} | ${SITE.name}`;

const structuredData = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {prev && <link rel="prev" href={prev} />}
    {next && <link rel="next" href={next} />}

    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {/* Måtten skrivs bara ut för vårt eget kort, som alltid är 1200 x 630 och
        alltid PNG. Artiklarnas egna bilder har sina egna mått, och en tagg som
        ljuger om dem är värre än ingen tagg: Yelp deklarerar 2000 x 1500 för en
        fil som är 1000 x 750, uppmätt 2026-09-05.

        Måtten är inte kosmetik. Facebook och LinkedIn kan visa kortet direkt
        vid första delningen i stället för att vänta på att bilden hämtats, och
        1200 x 630 ligger över varje dokumenterat minimum: Meta 600 x 315,
        LinkedIn 1200 x 627, iMessage 900 px bredd, WhatsApp 300 px. */}
    {!egenBild && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    {/* Alternativtexten säger vad bilden visar, alltså sidans egen rubrik.
        Ingen av de fyra jämförbara sajterna har den, GitHub har det. */}
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    {dataUpdated && <meta name="last-modified" content={dataUpdated} />}

    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Manifestet gör att sajten kan läggas på en Android-hemskärm med rätt
        namn och ikon. Saknades helt till 2026-09-14: temafärgen och
        iPhone-ikonen fanns, men /manifest.webmanifest svarade 404.
        `minimal-ui` och inte `standalone`, för det här är en innehållssajt
        där länkar delas och bakåtknappen behövs. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {structuredData.map((data) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(data)}
      />
    ))}
  </head>

  <body>
    <a href="#main" class="skip-link glass">Hoppa till innehåll</a>
    <Header search={headerSearch} hem={hemhuvud} />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}

    {/* Inloggningsrutan hör till layouten och inte till enskilda sidor.
        Den låg tidigare på tre sidtyper: kontosidorna och verksamhetssidan.
        openSignIn() svarar false när rutan saknas, alltså hände ingenting
        alls om något annat än de tre försökte öppna den. En inloggningsrad i
        menyn var därför omöjlig, eftersom menyn finns i sidhuvudet på varje
        sida medan rutan fanns på tre.

        Rutan renderas som ett stängt <dialog> och öppnas aldrig av sig själv,
        så att lägga den överallt kostar bara markup. Den väger runt tre
        kilobyte och skriptet laddas ändå bara en gång per sida. */}
    <SignInDialog />

    {/* Kvittenslagret, av samma skäl som inloggningsrutan ovanför: det hör
        till layouten och inte till enskilda sidor. Lagret är en tom div som
        aldrig visar något av sig själv, alltså kostar det bara markup, och
        varje yta som vill kvittera en handling kan importera visaKvittens
        utan att först behöva lägga till en komponent på sin egen sida.

        Det ligger EFTER sidfoten i dokumentet med flit. Lagret är fast
        placerat, så ordningen syns inte, men den som tabbar sig genom sidan
        ska inte träffa en länk i hörnet mitt i innehållet. */}
    <Kvittens />

    {/* Kommandopaletten låg här, som en egen panel som cmd+K fällde ut ur
        sökfältet. Den finns inte längre: genvägen och fältet delar numera
        EN panel, författad inuti SiteSearch. Två paneler under samma fält
        gav två olika svar på samma sökord, och sidhuvudet följer med varje
        sida ändå, så genvägen fungerar överallt utan att layouten behöver
        rendera något extra. */}
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }

  /* Hoppa-länken svävar över sidhuvudet när den får fokus och bär därför
     samma glasyta som resten av lagren, via .glass i tokens.css. Den landar
     i praktiken alltid över sidhuvudet, som är --card, så fyllningen blir
     rent vit och länken lika läsbar som förut. Glaset syns här på kanten
     och lyftet, inte på genomskinligheten. Radien är kontrollradien, inte
     kortradien: det är en knappstor yta. */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-control);
  }

  .skip-link:focus {
    left: var(--s-4);
    top: var(--s-4);
  }
</style>
