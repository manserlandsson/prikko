---
import Maskot from '../components/Maskot.astro';
/**
 * Layout för en författad artikel.
 *
 * Systerlayout till Rapport.astro, och skillnaden mellan dem är hela poängen:
 * en rapport är räknad ur beståndet och bär Report-schema med organisationen
 * som avsändare, en artikel är skriven text och bär Article-schema. De två
 * får aldrig låna varandras form, för läsaren ska kunna se på sidtypen vad
 * som är räknat och vad som är formulerat.
 *
 * Metadatan kommer ur content collection-posten, aldrig ur mallen. En artikel
 * kan därför inte publiceras utan egen titel, beskrivning och datum, eftersom
 * schemat i content.config.ts stoppar bygget innan sidan finns.
 *
 * Kvalitetsgrinden: så länge sektionen har färre än MIN_ARTICLES publicerade
 * artiklar bär varje artikelsida noindex och hålls ur sitemapen (samma
 * funktion läses av astro.config.mjs). Sidorna byggs ändå och går att läsa
 * på plats, de bjuds bara inte ut till index förrän sektionen bär sin vikt.
 */
import { getImage, Image } from 'astro:assets';
import Base from './Base.astro';
import { SITE } from '../lib/site';
import { absolute, path } from '../lib/urls';
import { sectionReady } from '../lib/artiklar';
import {
  creditLine,
  HERO_SIZES,
  HERO_WIDTHS,
  type ArticleImage,
} from '../lib/artikelbilder';
import { formatDate } from '../lib/data';

interface Props {
  slug: string;
  title: string;
  description: string;
  lede: string;
  category: string;
  published: string;
  updated?: string;
  minutes: number;
  /**
   * Färdig bild från lib/artikelbilder.ts, eller ingen alls. Mallen letar
   * inte själv efter filer: gör den det kan artikelsidan och kortet i listan
   * komma fram till olika svar om samma artikel.
   */
  image?: ArticleImage | null;
}

const {
  slug,
  title,
  description,
  lede,
  category,
  published,
  updated,
  minutes,
  image = null,
} = Astro.props;

const noindex = !sectionReady();

/**
 * En jpeg på 1 200 px, delad av delningsbilden och JSON-LD.
 *
 * Bredden är Googles golv för bild i rika resultat och samtidigt det mått
 * Facebook, LinkedIn och `summary_large_image` vill ha. Formatet är utskrivet
 * som jpeg med flit: <Image> nedan lämnar webp, vilket är rätt för läsaren,
 * men flera delningsrobotar hämtar bilden utan att förhandla format och visar
 * en tom ruta i stället. Källfilerna är 1400 × 788, så 1 200 blir 1200 × 675
 * utan beskärning.
 *
 * Saknar artikeln bild lämnas ogImage osatt, och Base faller tillbaka på
 * sajtens egen delningsbild precis som förut.
 */
const shareImage = image
  ? new URL((await getImage({ src: image.src, width: 1200, format: 'jpeg' })).src, SITE.url).href
  : null;

/**
 * `Article`, inte `Report` och inte `BlogPosting`. Texten är redaktionell
 * sakprosa med Prikko som avsändare, och author är organisationen tills en
 * namngiven skribent finns. Byter en artikel till en personlig byline ska
 * author bli en Person, se docs/16_seo_strategi_innehall.md.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'sv-SE',
  datePublished: published,
  ...(updated ? { dateModified: updated } : {}),
  url: absolute('artiklar', slug),
  mainEntityOfPage: absolute('artiklar', slug),
  /**
   * `image` bara när artikeln faktiskt har en. Ett tomt eller påhittat
   * bildfält i strukturerad data är en felaktig uppgift om sidan, och Google
   * behandlar bilden i Article som ett löfte om att den finns på sidan.
   */
  ...(shareImage ? { image: [shareImage] } : {}),
  author: { '@type': 'Organization', name: SITE.legalName, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.legalName, url: SITE.url },
};
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  noindex={noindex}
  ogImage={shareImage ?? undefined}
  dataUpdated={updated ?? published}
>
  <article class="container page">
    <header>
      <p class="eyebrow">
        <a href={path('artiklar')}>Artiklar</a> · {category} · {minutes} min lästid
      </p>
      <h1>{title}</h1>
      <p class="lede text-secondary">{lede}</p>
      <p class="caption text-secondary dates">
        Publicerad {formatDate(published)}{updated && ` · Uppdaterad ${formatDate(updated)}`}
      </p>
    </header>

    {image && (
      <figure class="hero">
        {/* Sidans största bild och därmed dess LCP: eager och utan
            lazy-attribut, så webbläsaren får börja hämta den direkt.
            Måtten skrivs ut så att raden under bilden inte hoppar när den
            laddas. */}
        <Image
          src={image.src}
          alt={image.alt}
          width={HERO_WIDTHS.at(-1)}
          widths={HERO_WIDTHS}
          sizes={HERO_SIZES}
          loading="eager"
        />
        {/* Attributionen står vid bilden och inte bara i listan på källsidan.
            Den som ser fotot ska se varifrån det kommer utan att leta. */}
        <figcaption class="caption text-muted">
          Foto: {image.creditUrl ? (
            <a href={image.creditUrl} target="_blank" rel="noopener noreferrer nofollow">
              {creditLine(image)}
            </a>
          ) : (
            creditLine(image)
          )} · <a href={`${path('kallor')}#artikelbilder`}>Bildkrediter</a>
        </figcaption>
      </figure>
    )}

    <slot />

    <section class="method">
      {/* Maskoten som avsändare, och det är hela skälet till att han står just
          här. Rutan säger att artiklarna är skrivna av Prikko, alltså är detta
          en byline och inte dekoration. Ytan är dessutom den enda i en artikel
          där ingen enskild verksamhet nämns, så den bärande regeln håller.

          Posen är `soker`: han förklarar, han dömer inte. En artikel är den yta
          där tjänsten är mest pedagogisk och minst myndighetsutövande.

          Storleken är 112 och inte 72. Vid 72 blev han en ikon bredvid en
          rubrik, alltså läst som en dekoration man sveper förbi. Det här är
          den enda ytan i en artikel där maskoten är avsändare, och en avsändare
          som syns sämre än sin egen bildtext gör inte sitt jobb.

          Rörelsen är spaningen, samma som på 404. Den går EN gång när rutan
          kommer in i vyn och sedan står han still. En figur som rör sig i
          evighet längst ned på en artikel drar blicken från texten som är
          sidans poäng, och prefers-reduced-motion släcker den helt. */}
      <Maskot pose="soker" size={112} rorelse="m-spana" class="byline" />
      <h2>Om artikeln</h2>
      <p>
        Artiklarna är skrivna och redigerade av Prikko, till skillnad från
        {' '}<a href={path('rapporter')}>rapporterna</a>, som räknas fram ur
        beståndet vid varje bygge. Varje siffra i texten har en angiven källa,
        och siffror ur vårt eget bestånd avser läget det datum som står
        ovanför. Aktuella tal finns alltid på kommun- och verksamhetssidorna.
      </p>
      <p>
        <a href={path('metodik')}>Så räknas bedömningen fram</a> ·
        {' '}<a href={path('kallor')}>Källor och uppdatering</a> ·
        {' '}<a href={path('ratta')}>Rätta en uppgift</a>
      </p>
    </section>
  </article>
</Base>

<style>
  /* Figuren flyter till höger så att rubriken och texten lindar sig runt den.
     Första försöket var absolut positionerad i rutans hörn och lade sig i
     samma rad som rubriken. Ett absolut positionerat element vet ingenting om
     texten bredvid, och rubrikens längd ändras med språket och bredden.

     Statisk, ingen rörelse: rutan står under hela artikeln, och NN/g:s
     specifika varning gäller rörliga bilder intill stillastående text. */
  .method :global(.byline) {
    float: right;
    margin: 0 0 var(--s-3) var(--s-4);
    shape-outside: circle(50%);
  }

  @media (max-width: 640px) {
    .method :global(.byline) {
      float: none;
      margin: 0 0 var(--s-2);
    }
  }

  .page {
    max-width: var(--w-read);
    padding-block: var(--s-12) var(--s-16);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-top: var(--s-2);
  }

  .eyebrow a {
    color: inherit;
  }

  .lede {
    margin-top: var(--s-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .dates {
    margin-top: var(--s-3);
  }

  /* Bilden ligger under ingressen och inte över rubriken. Rubrik och ingress
     är det som talar om vad sidan är; en bild överst skjuter ner dem under
     vikningen på en telefon och byter ut ett besked mot ett stämningsläge.
     Samma proportion som stadsfotona, 16:9, så att artikelbilden och
     kommunkorten ser ut att komma från samma sajt. */
  .hero {
    margin: var(--s-8) 0 0;
  }

  .hero :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-card);
    background: var(--card);
  }

  .hero figcaption {
    margin-top: var(--s-2);
  }

  /* Kreditraden är sidans minst viktiga text och ska läsas som det, men den
     är ett villkor och inte dekoration: den får därför inte tonas ner så långt
     att den underskrider kontrastkravet. --text-muted är räknad mot vitt i
     tokens.css. */
  .hero figcaption a {
    color: inherit;
    text-decoration: underline;
  }

  /* Markdown-innehållet kommer via slot och formas här, så att varje artikel
     ser likadan ut utan egna stilblock. Samma mått som Rapport.astro: de två
     sidtyperna ska kännas som syskon, inte som olika sajter. */
  .page :global(h2) {
    margin-top: var(--s-12);
    margin-bottom: var(--s-4);
  }

  .page :global(h3) {
    margin-top: var(--s-8);
    margin-bottom: var(--s-3);
  }

  .page :global(p) {
    line-height: var(--lh-body);
  }

  .page :global(p + p) {
    margin-top: var(--s-4);
  }

  /* Listreglerna gäller PROSANS listor och ingenting inuti ett diagram.
   *
   * En Stapel är en <ul> och en Parstapel är två. Utan undantaget fick de
   * listans padding-left och började alltså en bit in medan brödtexten
   * började vid kanten, vilket är precis det ägaren såg som "inte helt left
   * aligned". li-regelns margin-top lade dessutom på ett extra hopp mellan
   * diagrammets rader.
   *
   * Undantaget är skrivet som :not() på prosans egen selektor i stället för
   * som en nollställning efteråt, och det är ett medvetet val. En
   * nollställning måste väga tyngre än prosan men lättare än varje
   * diagramkomponents egna mått, och det spannet är för smalt för att vara
   * stabilt: `.page .diagram li` väger tyngre än `.spannrader li + li` och
   * hade tyst ätit upp avståndet mellan raderna i Spann. Med :not() når
   * reglerna aldrig in i ett diagram, och komponenten råder ensam över sitt
   * inre.
   *
   * Undantaget måste stå här och inte i Diagram.astro, eftersom en scoped
   * stil där inte når in i det som skickas via <slot />. */
  .page :global(ul:not(.diagram *)),
  .page :global(ol:not(.diagram *)) {
    margin: var(--s-4) 0 0;
    padding-left: var(--s-4);
  }

  .page :global(li:not(.diagram *)) {
    margin-top: var(--s-3);
    line-height: var(--lh-body);
  }

  .page :global(blockquote) {
    margin: var(--s-4) 0 0;
    padding: var(--s-4);
    background: var(--card);
    border-left: 3px solid var(--verdict-none);
    border-radius: 0 var(--r-control) var(--r-control) 0;
    font-size: var(--fs-body-s);
    line-height: 21px;
  }

  .page :global(blockquote p) {
    line-height: 21px;
  }

  .page :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-body-s);
    margin-top: var(--s-4);
  }

  .page :global(th),
  .page :global(td) {
    text-align: left;
    padding: var(--s-3) var(--s-2) var(--s-3) 0;
    border-bottom: 1px solid var(--hairline);
  }

  .page :global(th) {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .method {
    margin-top: var(--s-12);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .method h2 {
    margin-top: 0;
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
    margin-bottom: var(--s-3);
  }

  .method p {
    line-height: 22px;
    color: var(--text-secondary);
  }

  .method p + p {
    margin-top: var(--s-3);
  }
</style>
