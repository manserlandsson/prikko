---
/**
 * Leaderboard: verksamheter med anmärkningar.
 *
 * SEO-dimensioneringen visade att enskilda restaurangnamn knappt söks alls,
 * men att "sämsta restaurangen i [stad]" autocompletar i åtta svenska städer.
 * Den här sidtypen är alltså spjutspetsen, inte katalogen.
 *
 * Rubriken är medvetet "med anmärkningar" och inte "sämst". Juridiskt är
 * skillnaden avgörande: "sämst" är vårt eget omdöme att försvara, medan
 * "har anmärkningar vid senaste kontrollen" är kommunens konstaterande som vi
 * återger. Sidan fångar samma sökintention utan att bli ett påstående.
 */
import Base from '../../layouts/Base.astro';
import FaceMark from '../../components/FaceMark.astro';
import {
  establishments,
  municipalities,
  sourceFor,
  formatDate,
  isRemark,
  latestInspectionDate,
} from '../../lib/data';
import { SITE, VERDICT } from '../../lib/site';

export async function getStaticPaths() {
  return municipalities().map((m) => ({
    params: { kommun: m.slug },
    props: { kommun: m },
  }));
}

const { kommun } = Astro.props;
const source = sourceFor(kommun.slug)!;
const assessed = establishments(kommun.slug).filter((e) => e.verdict !== null);

// Allvarliga först, sedan mindre. Inom varje nivå: flest avvikelser överst,
// därefter senast kontrollerad — så listan är stabil mellan bygg.
const severity = { major: 0, minor: 1, clean: 2 } as const;
const listed = assessed
  .filter((e) => e.verdict !== 'clean')
  .map((e) => ({
    ...e,
    remarks: e.inspections[0]?.areas.filter(isRemark).length ?? 0,
  }))
  .sort((a, b) => {
    const s = severity[a.verdict!] - severity[b.verdict!];
    if (s !== 0) return s;
    if (b.remarks !== a.remarks) return b.remarks - a.remarks;
    return (latestInspectionDate(b) ?? '').localeCompare(latestInspectionDate(a) ?? '');
  });

const major = listed.filter((e) => e.verdict === 'major').length;
const city = kommun.city;

// Självbärande första mening, skriven för att kunna citeras rakt av.
const answer = `${listed.length} av ${assessed.length} kontrollerade verksamheter i ${city} hade anmärkningar vid sin senaste hygienkontroll, varav ${major} med allvarliga brister.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Prikko', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: kommun.name, item: `${SITE.url}/${kommun.slug}` },
      { '@type': 'ListItem', position: 3, name: 'Anmärkningar' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Verksamheter med anmärkningar i ${city}`,
    numberOfItems: listed.length,
    itemListElement: listed.slice(0, 25).map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/${kommun.slug}/${e.slug}`,
      name: e.name,
    })),
  },
];
---

<Base
  title={`Restauranger med anmärkningar i ${city}`}
  description={answer}
  jsonLd={jsonLd}
  dataUpdated={source.fetchedAt.slice(0, 10)}
>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={`/${kommun.slug}`}>{city}</a>
    </nav>

    <header>
      <p class="eyebrow">{kommun.name}</p>
      <h1>Restauranger med anmärkningar i {city}</h1>
      <p class="answer">{answer}</p>
      <p class="caption text-muted">
        Bygger på kommunens senaste kontroll av varje verksamhet, hämtad
        {' '}{formatDate(source.fetchedAt.slice(0, 10))}.
        <a href="/metodik">Så räknas bedömningen fram</a>.
      </p>
    </header>

    <ol class="list">
      {listed.map((e, i) => (
        <li>
          <a href={`/${kommun.slug}/${e.slug}`}>
            <span class="rank text-muted">{i + 1}</span>
            <FaceMark verdict={e.verdict} size={36} variant="round" />
            <span class="body">
              <b>{e.name}</b>
              <span class="meta text-secondary">
                {e.address}
                {latestInspectionDate(e) && ` · ${formatDate(latestInspectionDate(e)!)}`}
                {e.remarks > 0 && ` · ${e.remarks} ${e.remarks === 1 ? 'avvikelse' : 'avvikelser'}`}
              </span>
            </span>
            <span class="verdict" style={`color: ${VERDICT[e.verdict!].colorVar}`}>
              {VERDICT[e.verdict!].label}
            </span>
          </a>
        </li>
      ))}
    </ol>

    <footer class="foot">
      <p class="text-secondary">
        En anmärkning betyder att kommunen konstaterat en avvikelse vid
        kontrollen. Många åtgärdas snabbt och följs upp vid ett återbesök —
        varje verksamhets sida visar hela historiken.
      </p>
      <p>
        <a href={`/${kommun.slug}`}>Se alla verksamheter i {city}</a>
      </p>
    </footer>
  </div>
</Base>

<style>
  .page { max-width: 820px; padding-block: var(--s-6) var(--s-16); }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  h1 { font-size: 34px; line-height: 38px; margin-top: var(--s-1); }

  .answer {
    margin-top: var(--s-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  header .caption { margin-top: var(--s-3); }

  .list {
    list-style: none;
    counter-reset: none;
    margin: var(--s-8) 0 0;
    padding: 0;
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .list li + li { border-top: 1px solid var(--hairline); }

  .list a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    color: var(--text);
  }

  .list a:hover { text-decoration: none; background: color-mix(in srgb, var(--brand) 4%, transparent); }
  .list a:hover b { color: var(--brand); }

  .rank {
    width: 22px;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    text-align: right;
    flex-shrink: 0;
  }

  .body { flex: 1; min-width: 0; }
  .body b { display: block; font-size: var(--fs-body-s); font-weight: 600; }
  .meta { display: block; font-size: var(--fs-caption); }

  .verdict {
    font-size: var(--fs-caption);
    font-weight: 600;
    text-align: right;
    flex-shrink: 0;
  }

  .foot {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .foot p { font-size: var(--fs-body-s); line-height: 21px; }
  .foot p + p { margin-top: var(--s-3); }

  @media (max-width: 560px) {
    .verdict { display: none; }
  }
</style>
