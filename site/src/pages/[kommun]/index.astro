---
/**
 * Kommunhubb, sida 1.
 *
 * Sidan låg tidigare på att rendera hela kommunen i ett dokument. Stockholm
 * blev 11 MB HTML. Nu är serien indelad: sida 1 här, sida 2 och framåt i
 * sida/[page].astro. Allt gemensamt bor i KommunHub.astro så att de två
 * routefilerna inte kan glida isär.
 */
import KommunHub from '../../components/KommunHub.astro';
import { establishments, municipalities, municipalityListing } from '../../lib/data';
import { slicePage } from '../../lib/pagination';

export async function getStaticPaths() {
  return municipalities().map((m) => ({
    params: { kommun: m.slug },
    props: { kommun: m },
  }));
}

const { kommun } = Astro.props;
const all = establishments(kommun.slug);
const page = slicePage(municipalityListing(kommun.slug), 1);

const counts = {
  clean: all.filter((e) => e.verdict === 'clean').length,
  minor: all.filter((e) => e.verdict === 'minor').length,
  major: all.filter((e) => e.verdict === 'major').length,
  none: all.filter((e) => e.verdict === null).length,
};
---

<KommunHub
  kommun={kommun}
  items={page.items}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  start={page.start}
  total={page.total}
  counts={counts}
/>
