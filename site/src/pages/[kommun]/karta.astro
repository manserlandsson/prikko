---
/**
 * Kommunens kartsida.
 *
 * Egen adress, inte en flik på hubben. Skälet står i Karta.astro: hubben är
 * sidtypen som bär trafiken och väger 30 kB, kartan väger tolv gånger så
 * mycket, och de flesta som läser hubben ska inte betala för den.
 *
 * Sidan finns bara för kommuner som faktiskt har koordinater. Fyra av tolv
 * lämnar inga alls (Borgholm, Höganäs, Lomma, Svenljunga), och en kartsida
 * utan nålar hade varit precis en sådan tunn sida som kvalitetsgrinden i
 * bibeln §6 finns för att hålla borta. De får ingen sida och ingen länk.
 */
import Base from '../../layouts/Base.astro';
import Karta from '../../components/Karta.astro';
import { formatNumber, municipalities, sourceFor } from '../../lib/data';
import { utsnitt } from '../../lib/kartrutor';
import { absolute, path } from '../../lib/urls';

export async function getStaticPaths() {
  return municipalities()
    .map((m) => ({ kommun: m, data: utsnitt(m.slug) }))
    .filter((x) => x.data !== undefined)
    .map(({ kommun, data }) => ({
      params: { kommun: kommun.slug },
      props: { kommun, data: data! },
    }));
}

const { kommun, data } = Astro.props;
const city = kommun.city;
const base = `/${kommun.slug}`;

const source = sourceFor(kommun.slug);
const title = `Karta över hygienkontroller i ${city}`;
const description =
  `Karta med ${formatNumber(data.count)} restauranger och livsmedelsverksamheter i ${city}. ` +
  `Varje nål visar hur verksamheten klarade sin senaste hygienkontroll.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
    { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(base) },
    { '@type': 'ListItem', position: 3, name: 'Karta' },
  ],
};
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  dataUpdated={source?.fetchedAt.slice(0, 10)}
  footer={false}
>
  <div class="page">
    {/*
      Brödsmulorna och rubriken ligger i listkolumnen, inte ovanför kartan.

      Här stod tidigare en ingress som förklarade täckningen, vad en nål
      betyder och hur många som har anmärkningar. Allt var sant och inget av
      det behövdes: en karta med färgade ansikten och en teckenförklaring
      under sig förklarar sig själv, och täckningssiffran står redan i
      listrubriken.

      Sedan 2026-08-25 flyttar även rubriken in i kolumnen, av samma skäl en
      gång till. Booli har ingenting ovanför sin delade vy: kartan börjar
      direkt under sidhuvudet. Rubriken kan inte tas bort, den är sidans
      SEO-svar, men den kan kosta listans höjd i stället för kartans.
      Beskrivningen finns kvar i sidans meta description, alltså där den
      faktiskt läses.
    */}
    <Karta kommun={kommun} data={data}>
      <Fragment slot="topp">
        <h1>Karta över hygienkontroller i {city}</h1>
      </Fragment>
    </Karta>
  </div>
</Base>

<style>
  /* Bredare än sajtens vanliga 1080. Den delade vyn är två spalter som båda
     vill ha plats, och en karta som klipps till en textspalts bredd är inte
     den halva av sidan den ska vara.

     APP-YTA, INTE DOKUMENT. Sidan fyller exakt höjden under sidhuvudet och
     skrollar aldrig på sidnivå: listan skrollar i sin egen spalt och kartan
     står still, precis som hos Airbnb. Det var ägarens andra klagomål på
     raken om skroll på den här sidan, och sticky-kartan löste det aldrig
     eftersom teckenförklaring och sidfot alltid låg kvar under och gav sidan
     en svans. Sidfoten är därför avstängd här via Base-propen footer.

     Höjden under sidhuvudet är --h-bar plus dess hårlinje. */
  .page {
    display: flex;
    flex-direction: column;
    /* Sidhuvudets rad plus dess hårlinje. Raden är en token sedan
       2026-08-18, se --h-bar i tokens.css; talet stod förr som 59. */
    height: calc(100dvh - var(--h-bar) - 1px);
    /*
     * KANT I KANT. Booli, uppmätt 2026-08-25: deras kartomslag är
     * `position: fixed` med `top: 64px; right: 0; bottom: 0`, alltså ligger
     * kartan an mot fönstrets högerkant och underkant på varje bredd.
     *
     * Vår sida låg i `.container`, alltså 1400 px bred med 48 px gutter på båda
     * sidor och centrerad. På en 1920-skärm betydde det 308 px tom yta till
     * höger om kartan och 48 px till vänster om den, medan Boolis karta där är
     * 1217 px bred. Det var den enskilt största skillnaden i hur stor kartan
     * KÄNNS, och den kostade ingenting att ha.
     *
     * Kolumnernas egen luft flyttar därför in i listkolumnen, se .lista i
     * Karta.astro. Kartan ska inte ha någon.
     */
    max-width: none;
    padding: 0;
  }

  /*
   * Brödsmulorna är BORTA, och bara härifrån.
   *
   * Ägaren 2026-08-25: "varför står det prikko > stockholm längst upp, det
   * behövs ju ej." Booli har inga brödsmulor alls på sin kartsida, och på en
   * app-yta är raden dyrare än på en dokumentsida: den tar 26 lodräta pixlar
   * ur listkolumnen på varenda kartsida, och den enda vägen den erbjuder är
   * tillbaka till en sida man just kom ifrån.
   *
   * BreadcrumbList i sidans strukturerade data står kvar. Den är för
   * sökmotorn och ritas aldrig, och kedjan Prikko till kommunen till kartan
   * är sann vare sig raden syns eller inte.
   */
  h1 {
    margin-block: var(--s-1) var(--s-4);
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  /*
   * Under 900 px lägger Karta.astro kartan över hela ytan med listan som ett
   * ark ovanpå, se arkavsnittet där. Sidan bakom ska då inte skrolla alls:
   * arket äger rullningen, och lib/page-lock.ts låser dokumentet så länge det
   * är uppe. Rubriken och brödsmulorna behövs inte i den vyn; de står kvar i
   * dokumentet för sökmotorn och för den som saknar skript, men skjuts undan
   * så snart arket tar över.
   *
   * Utan skript får sidan bete sig som ett vanligt dokument igen, alltså
   * rubrik, lista och karta under varandra.
   */
  @media (max-width: 900px) {
    .page {
      height: auto;
      display: block;
      padding-block: var(--s-4);
    }

    .page:has(.split.ark) {
      height: 100dvh;
      padding: 0;
      overflow: hidden;
    }

    .page:has(.split.ark) h1 {
      /* Kvar i dokumentet, ute ur vyn. Rubriken är sidans H1 och får inte
         tas bort; på app-ytan är den däremot ren höjdförlust, och kommunens
         namn står i arkets rubrik ändå. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .back {
    margin-top: var(--s-6);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }
</style>
