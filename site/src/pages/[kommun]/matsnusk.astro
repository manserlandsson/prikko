---
/**
 * Matsnusklistan: verksamheter där brister i livsmedelshanteringen
 * kvarstod efter kommunens uppföljning.
 *
 * ## Egen sidtyp, inte en skärpning av /[kommun]/anmarkningar
 *
 * Anmärkningssidan är ett REGISTER: varje verksamhet med någon anmärkning
 * vid senaste kontrollen, komplett och sidindelat, med en rad per namn. Den
 * här sidan är ett URVAL med hårdare beviskrav (bara kvarstående, bara
 * bevisat konsumentnära, bara färskt), och varje rad är ett referat av vad
 * kommunen fann, inte en registerpost. Hade urvalet lagts ovanpå registret
 * hade ettdera blivit lidande: registret hade tappat sin fullständighet
 * eller urvalet sina beviskrav. Registret finns kvar orört och länkas nedan.
 *
 * Sidan är utmärkelsens spegelbild (se lib/utmarkelser.ts) men fryses ALDRIG
 * i utgåvor: en verksamhet som åtgärdat allt ska försvinna härifrån vid nästa
 * datauppdatering, inte stå kvar i en årslista. Se lib/matsnusk.ts, där
 * urvalsreglerna och namnet bor och är motiverade.
 *
 * Kommuner med färre än MIN_MATSNUSK_PAGE rader får ingen sida alls (bibeln
 * §6). Någon riksvy finns inte och får inte byggas: radantalet styrs av hur
 * mycket kommunen publicerar, och en riksvy hade rangordnat kommunernas
 * publicering, inte köken.
 *
 * Urvalskriterierna står i sidfoten, inte före listan. Ägarens beslut
 * (2026-08-05): sidan ska visa saken, inte förklara sig först. Sidhuvudets
 * bildtext bär numera bara två länkar; hämtdatumet och replikrätten flyttades
 * ned till #urval, så att proveniensen står EN gång och längst ned. Se
 * docs/18_sprakregler.md.
 */
import Base from '../../layouts/Base.astro';
import FaceRef from '../../components/FaceRef.astro';
import FaceSprite from '../../components/FaceSprite.astro';
import OwnerReply from '../../components/OwnerReply.astro';
import {
  AREA_STATUS_INK,
  AREA_STATUS_LABEL,
  INSPECTION_TYPE_LABEL,
  formatDate,
  formatNumber,
  sourceFor,
} from '../../lib/data';
import { matsnuskMunicipalities, matsnuskRows } from '../../lib/matsnusk';
import { absolute, path } from '../../lib/urls';

export function getStaticPaths() {
  return matsnuskMunicipalities().map((m) => ({
    params: { kommun: m.slug },
    props: { kommun: m },
  }));
}

const { kommun } = Astro.props;
const city = kommun.city;
const rows = matsnuskRows(kommun.slug);
const source = sourceFor(kommun.slug)!;
const fetched = source.fetchedAt.slice(0, 10);

/*
 * Självbärande första mening, formulerad som referat: "hade brister som inte
 * var åtgärdade vid uppföljningen" är kommunens konstaterande återgivet, inte
 * vårt omdöme. Samma påstående som VERDICT.major.sentence i site.ts gör på
 * varje verksamhetssida; formuleringarna får inte glida isär.
 */
const answer =
  `${formatNumber(rows.length)} verksamheter i ${city} hade brister i hanteringen av ` +
  `livsmedel som inte var åtgärdade vid kommunens uppföljning. Samtliga konstaterade ` +
  `vid kontroller de senaste tolv månaderna.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
      { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(kommun.slug) },
      { '@type': 'ListItem', position: 3, name: 'Matsnusk' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Matsnusk i ${city}`,
    description: answer,
    numberOfItems: rows.length,
    itemListElement: rows.slice(0, 25).map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute(kommun.slug, r.establishment.slug),
      name: r.establishment.name,
    })),
  },
];

/** Referatet av varför raden står här, byggt av kommunens egen data. */
function groundText(r: (typeof rows)[number]): string {
  if (r.ground === 'stated') {
    return 'Kommunens bedömning av kontrollen är kvarstående avvikelse.';
  }
  if (r.ground === 'followup') {
    return 'Kontrollen var ett återbesök för att följa upp tidigare brister.';
  }
  return `Avvikelser fanns även vid kontrollen ${formatDate(r.previous!.date)}.`;
}
---

<Base
  title={`Matsnusk i ${city}`}
  description={answer}
  jsonLd={jsonLd}
  dataUpdated={fetched}
>
  <FaceSprite />

  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path(kommun.slug)}>{city}</a>
      <span aria-hidden="true">›</span>
      <span>Matsnusk</span>
    </nav>

    <header>
      <p class="eyebrow">{kommun.name}</p>
      <h1>Matsnusk i {city}</h1>
      <p class="answer">{answer}</p>
      {/* Bara vägvisning här, ingen proveniens och ingen replikrätt. Raden
          bar tidigare båda, alltså ett stycke om varifrån datan kom ovanför
          det den handlade om, samtidigt som avsnittet längst ned sade samma
          sak en gång till. Hämtdatumet och replikrätten står nu bara i
          #urval. Länkarna är kvar: de är navigation, inte förklaring. */}
      <p class="caption text-muted">
        <a href="#urval">Så väljs listan ut</a> ·
        {' '}<a href={path('ratta')}>Rätta en uppgift</a>
      </p>
    </header>

    <ul class="list" aria-label={`Verksamheter med kvarstående brister i ${city}`}>
      {rows.map((r) => {
        const e = r.establishment;
        const i = r.inspection;
        return (
          <li>
            <div class="row-head">
              <FaceRef verdict="major" size={36} />
              <div class="row-title">
                <a class="name" href={path(kommun.slug, e.slug)}>{e.name}</a>
                <span class="meta text-secondary">
                  {[e.address, `${INSPECTION_TYPE_LABEL[i.type]} ${formatDate(i.date)}`]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </div>
            </div>
            <p class="ground text-secondary">{groundText(r)}</p>
            <ul class="remarks">
              {r.remarks.map((a) => (
                <li>
                  <span class="status" style={`color: ${AREA_STATUS_INK[a.status]}`}>
                    {AREA_STATUS_LABEL[a.status]}
                  </span>
                  <span class="what">{a.description || a.group}</span>
                </li>
              ))}
            </ul>
            {i.ownerComment && <OwnerReply text={i.ownerComment} />}
            <p class="row-foot caption">
              <a href={path(kommun.slug, e.slug)}>Hela historiken och verksamhetens svar</a>
            </p>
          </li>
        );
      })}
    </ul>

    <section id="urval" class="method">
      <h2>Så väljs listan ut</h2>
      <p>
        Tre krav: bedömningen brister som kvarstår, minst en avvikelse som rör
        livsmedlen eller hanteringen av dem enligt Livsmedelsverkets
        lagstiftningsområden, och en kontroll som är högst tolv månader
        gammal. Rent administrativa avvikelser, som en saknad registrering,
        räcker aldrig, och inte heller en kontroll där kommunen inte redovisat
        vad avvikelserna gällde.
      </p>
      <p>
        Listan räknas om vid varje datauppdatering, och en rad försvinner så
        snart en ny kontroll visar att bristerna åtgärdats. Raderna står i
        datumordning, nyast först, utan rangordning.
      </p>
      {/* Replikrätten och proveniensen, en gång på sidan. Hämtdatumet stod
          tidigare även i sidhuvudet. */}
      <p>
        Varje verksamhet kan svara, och svaren publiceras ordagrant. Är en
        uppgift fel, <a href={path('ratta')}>begär rättelse</a>. Underlaget är
        {kommun.name}s kontrolldata, hämtad {formatDate(fetched)}.
      </p>
      <p>
        <a href={path(kommun.slug, 'anmarkningar')}>Alla verksamheter med
        anmärkningar i {city}</a> ·
        {' '}<a href={path(kommun.slug)}>Alla verksamheter i {city}</a> ·
        {' '}<a href={path('metodik')}>Så räknas bedömningen fram</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .page { max-width: var(--w-page); padding-block: var(--s-6) var(--s-16); }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  h1 { font-size: var(--fs-title); line-height: var(--lh-title); margin-top: var(--s-1); }

  .answer {
    margin-top: var(--s-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  header .caption { margin-top: var(--s-3); }

  .list {
    list-style: none;
    margin: var(--s-8) 0 0;
    padding: 0;
  }

  /* Flata rader med hårlinjer emellan, inte kort i staplar: raderna är långa
     och en ram runt var och en hade gjort sidan till en vägg av lådor. */
  .list > li {
    padding: var(--s-6) 0;
    border-top: 1px solid var(--hairline);
  }

  .list > li:last-child { border-bottom: 1px solid var(--hairline); }

  .row-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .row-title { min-width: 0; }

  .name {
    display: block;
    color: var(--text);
    font-size: var(--fs-body);
    font-weight: 600;
  }

  .name:hover { color: var(--brand-ink); }

  .meta {
    display: block;
    margin-top: 2px;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .ground {
    margin-top: var(--s-3);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .remarks {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
  }

  .remarks li {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-1) 0;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .status {
    flex-shrink: 0;
    width: 88px;
    font-size: var(--fs-caption);
    font-weight: 600;
  }

  .what { color: var(--text-secondary); }

  .row-foot { margin-top: var(--s-3); }

  .method {
    margin-top: var(--s-12);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .method h2 {
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
    margin-bottom: var(--s-3);
  }

  .method p {
    font-size: var(--fs-body-s);
    line-height: 22px;
    color: var(--text-secondary);
  }

  .method p + p { margin-top: var(--s-3); }
</style>
