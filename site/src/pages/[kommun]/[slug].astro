---
/**
 * Restaurangsidan — sajtens viktigaste sidtyp.
 *
 * Formen är Boolis objektsida, på ägarens uttryckliga riktning: "den gillar
 * jag ALLT med... den är SÅ Clean." Det som gör deras sida lugn trots mängden
 * information är tre saker, och alla tre används här:
 *
 *  1. Ingen kortlåda runt huvudinnehållet. Sektionerna ligger öppet på sidan,
 *     skilda av hårlinjer och luft, inte av ramar.
 *  2. Ett stort värde bär sidan. Hos dem priset under etiketten "Utropspris",
 *     hos oss bedömningen under etiketten "Bedömning", med nyckelfakta i en
 *     öppen rad direkt under: liten etikett över stort tal, luft emellan.
 *  3. Kartan är en egen sektion i huvudkolumnen med adressen under, inte en
 *     miniatyr i marginalen. Sidopanelen bär det man agerar med — hos dem
 *     mäklarkortet, hos oss bevakningen, omdömet och rättelsen.
 *
 * Layouten är tvåkolumn med sticky sidopanel, som booli. Huvudkolumnen läses
 * uppifrån och ner som en berättelse i tid: vad kontrollen visade, blev det
 * åtgärdat, återkommer det, hela historiken — och sedan var stället ligger.
 *
 * Titeln leder med NAKET NAMN + ORT, inte med "hygienkontroll". Skälet är
 * mätt: i Storbritannien, världens mognaste marknad för hygienbetyg, ger
 * "food hygiene rating" 54,7 i söktrend medan "nandos food hygiene rating"
 * ger 0,04 — under 0,1 % för en av landets största kedjor. Ingen söker på
 * "[restaurang] hygien". Sidan måste vinna på namnet, och hygienen är
 * differentieraren i beskrivningen.
 *
 * Två SEO/AEO-krav styr innehållet:
 *
 * 1. Led med svaret. Första meningen ska vara självbärande och citerbar.
 *    Så extraherar AI-svar fakta (bibeln §6b).
 * 2. Aldrig `Review`- eller `AggregateRating`-schema för hygienbedömningen.
 *    Den bygger på myndighetsdata, inte på omdömen insamlade hos oss.
 *    Schemat är `FoodEstablishment`. (När förstapartsomdömen finns får de
 *    eget schema — men hålls visuellt och strukturellt åtskilda.)
 */
import Base from '../../layouts/Base.astro';
import FaceMark from '../../components/FaceMark.astro';
import FactGrid from '../../components/FactGrid.astro';
import InfoTip from '../../components/InfoTip.astro';
import Platskarta from '../../components/Platskarta.astro';
import StreetPhoto from '../../components/StreetPhoto.astro';
import AwardNote from '../../components/AwardNote.astro';
import MatsnuskNote from '../../components/MatsnuskNote.astro';
import ControlBreakdown from '../../components/ControlBreakdown.astro';
import FollowUp from '../../components/FollowUp.astro';
import RecurringIssues from '../../components/RecurringIssues.astro';
import InspectionHistory from '../../components/InspectionHistory.astro';
import Reviews from '../../components/Reviews.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import ArtikelBanner from '../../components/ArtikelBanner.astro';
import Handlingsrad from '../../components/Handlingsrad.astro';
import Kontrolldatum from '../../components/Kontrolldatum.astro';
import {
  categoriesOf,
  establishments,
  followUp,
  municipalities,
  sourceFor,
  formatDate,
  formatDistance,
  formatNumber,
  isIndexable,
  latestInspectionDate,
  missingReason,
  municipalityCategories,
  municipalitySummary,
  nearby,
  recurringIssues,
  statistics,
  type CategorySlice,
  type Establishment,
} from '../../lib/data';
import { DISTINCTION, MISSING, SITE, VERDICT } from '../../lib/site';
import { absolute, path } from '../../lib/urls';

export async function getStaticPaths() {
  // Alla kommuner vi har data för. Ingen lista i kod — db.ts upptäcker dem.
  return municipalities().flatMap((m) =>
    establishments(m.slug).map((e) => ({
      params: { kommun: m.slug, slug: e.slug },
      props: { establishment: e },
    })),
  );
}

interface Props {
  establishment: Establishment;
}

const { establishment: e } = Astro.props;
const kommun = e.municipality;
const source = sourceFor(kommun.slug)!;

const presentation = e.verdict ? VERDICT[e.verdict] : MISSING[missingReason(e)];
const latest = latestInspectionDate(e);
const latestInspection = e.inspections[0];
const stats = statistics(e);
const neighbours = nearby(e);
const hasCoords = e.lat !== null && e.lng !== null;

/**
 * Kommunen som jämförelsepunkt.
 *
 * "Inga anmärkningar" säger ingenting om huruvida det är vanligt eller
 * sällsynt. I Jönköping har 98 % av de bedömda inga anmärkningar och beskedet
 * är alltså normaltillståndet; i Lomma har 45 % det och samma besked betyder
 * något helt annat. Utan nämnaren läser besökaren in en ranking som inte
 * finns.
 *
 * Panelen är också den enda länken härifrån till kommunhubben utöver
 * brödsmulan, och hubben är den sidtyp som bär trafiken.
 */
const kommunSummary = municipalitySummary(kommun);
const recurring = recurringIssues(e);
const indexable = isIndexable(e);

/**
 * Fördelningen bakom kommunsiffran, som en stapel.
 *
 * Samma tal som meningen under redan bär, tecknade som yta så att de går att
 * ta in på en blick. Andelarna räknas på BEDÖMDA, aldrig på totalen — samma
 * nämnare som cleanShare, av samma skäl. Stapeln bär fördelningen inom EN
 * kommun; kommuner emellan jämförs aldrig.
 */
const dist = kommunSummary.assessed
  ? (['clean', 'minor', 'major'] as const)
      .map((k) => ({
        k,
        n: kommunSummary[k],
        share: (kommunSummary[k] / kommunSummary.assessed) * 100,
      }))
      .filter((d) => d.n > 0)
  : [];

/**
 * Ledde uppföljningen till åtgärd?
 *
 * Sidans starkaste besked, och det enda som säger något om vad som HÄNDE efter
 * en anmärkning. Null för de flesta verksamheter, och då står ingenting. Se
 * followUp() i data.ts.
 */
const uppfoljning = followUp(e);

/**
 * Vägen tillbaka till kategorisidan.
 *
 * Verksamhetssidorna har hittills bara länkat uppåt till kommunhubben, aldrig
 * i sidled. "Restauranger i Örebro" är en sökning folk gör, och sidan som
 * svarar på den fick inga interna länkar alls utom från hubbens filterrad.
 * categoriesOf() har funnits i data.ts sedan kategorierna byggdes och har
 * aldrig anropats från någon sidmall.
 *
 * Bara kategorier som har en egen sida i den här kommunen, och bara där
 * filtret alls är användbart — samma villkor som styr chipsen på hubben, så
 * att en länk aldrig pekar på en URL som inte finns.
 */
const kommunCats = municipalityCategories(kommun.slug);
const ownCategories: CategorySlice[] = kommunCats.usable
  ? categoriesOf(e)
      .categories.map((id) => kommunCats.slices.find((s) => s.category.id === id))
      .filter((s): s is CategorySlice => s !== undefined && s.linked)
  : [];

/**
 * Svarsmeningen. Sidans första rad, och den enda rad en språkmodell
 * sannolikt citerar. Måste vara självbärande och sann i varje utfall.
 *
 * Den här limmade tidigare ihop ett datumled på ALLA utfall:
 * `${namn} ${sentence} den ${datum}.` Det bär bara när meningen handlar om
 * en kontroll som faktiskt ägt rum. På 2 136 sidor gjorde den inte det:
 *
 *  - 857 sidor läste "…så nuläget går inte att bedöma den 17 maj 2023",
 *    eftersom meningen för `stale_inspections` slutar i en bisats som inte
 *    tar något datumled. Det går inte att läsa.
 *  - 1 279 sidor sade "har ingen registrerad hygienkontroll hos kommunen"
 *    och bjöd i nästa mening in till att läsa kontrollhistoriken.
 *
 * Därför en gren per utfall i stället för en mall plus konkatenering. Datumet
 * får en egen mening när det inte hör hemma i den första, och den fasta
 * svansen sätts bara när det finns något att se.
 */
const areas = latestInspection?.areas.length ?? 0;

let answer: string;
let detail: string;

if (e.verdict !== null && latest) {
  // Bedömd. Datumet hör till kontrollen meningen handlar om.
  answer = `${e.name} ${presentation.sentence} den ${formatDate(latest)}.`;
  detail =
    areas > 0
      ? 'Se vilka kontrollområden som granskades och hela kontrollhistoriken.'
      : 'Se hela kontrollhistoriken hos kommunen.';
} else if (latest) {
  // För gammal kontroll. Kontrollen finns, men den är för gammal för att säga
  // något om nuläget, och då är datumet ett eget påstående, inte ett led i
  // meningen om att bedömningen uteblir.
  answer =
    `${e.name} ${presentation.sentence}. ` +
    `Den senaste kontrollen gjordes den ${formatDate(latest)}.`;
  detail =
    areas > 0
      ? 'Se vad som granskades då och hela kontrollhistoriken.'
      : 'Se hela kontrollhistoriken hos kommunen.';
} else {
  // Ingen kontroll alls. Ingen historik att hänvisa till, alltså ingen svans
  // om kontrollområden. Den var det som gjorde beskrivningen självmotsägande.
  answer = `${e.name} ${presentation.sentence}.`;
  detail = `Verksamheten finns i kommunens register, men ${kommun.name} har inte publicerat någon kontroll av den.`;
}

const description = `${answer} ${detail}`;

/**
 * Statistiken räknas på ADRESSEN, inte på företaget.
 *
 * Kommunerna registrerar kontrollerna på anläggningen, alltså lokalen, och
 * ingen av de nio källorna säger när verksamheten startade eller om ägaren
 * bytt. Tar en ny restaurang över en adress ärver den föregångarens hela
 * historik. Rutan hette tidigare "Först kontrollerad", vilket läses rakt av
 * som verksamhetens ålder, ett påstående vi inte har täckning för.
 *
 * Talen är oförändrade. Det är etiketterna som slutar tillskriva dem fel part.
 */
const facts = [
  /* "Kontroller" och inte "Kontroller på adressen". Att räkningen gäller
     adressen och inte företaget står i tipset, som är hela skälet till att
     tipset finns. */
  { label: 'Kontroller', value: String(stats.total),
    tip: `Samtliga kontroller kommunen publicerar på den här adressen, från ${stats.oldestYear} och framåt. Har lokalen bytt verksamhet ingår även den tidigare verksamhetens kontroller. Kommunen registrerar kontrollerna på lokalen och inte på företaget.` },
  { label: 'Utan anmärkning', value: String(stats.cleanShare), unit: '%',
    color: stats.cleanShare >= 80 ? 'var(--verdict-clean)' : undefined,
    tip: 'Andel av kontrollerna på adressen där inga avvikelser noterades.' },
  { label: 'Återbesök', value: String(stats.followUps),
    tip: 'Uppföljande kontroller som gjorts för att se om tidigare avvikelser åtgärdats.' },
  { label: 'Äldsta kontroll', value: stats.oldestYear ?? '–',
    tip: 'Året för den äldsta kontroll kommunen publicerar på adressen. Det är inte nödvändigtvis året verksamheten startade. Kommunerna publicerar bara ett begränsat antal år bakåt, och historiken följer lokalen.' },
];

/**
 * Kommunens egen utsaga om ägarbyte, när den finns. Återges attribuerad, aldrig
 * som vår slutsats. Se OWNERSHIP_POLICY i data.ts.
 */

/**
 * Upplysningen om lokalen visas på ALLA verksamheter med mer än en kontroll,
 * aldrig villkorad av ett uppehåll i historiken.
 *
 * Ett villkorat förbehåll lär läsaren att frånvaron betyder att historiken är
 * säker. Det är falskt: 64 % av de restaurangliknande verksamheterna i våra
 * djupa kommuner har inget uppehåll alls, och medianintervallet mellan två
 * restaurangkontroller i Stockholm är 272 dagar, så ett ägarbyte däremellan
 * syns inte. Den falska tryggheten hade legat just på de sidor där risken är
 * störst. Se HISTORY_GAP_DAYS i data.ts för mätningen.
 */

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: e.name,
  url: absolute(kommun.slug, e.slug),
  address: {
    '@type': 'PostalAddress',
    streetAddress: e.address ?? undefined,
    addressLocality: kommun.city,
    addressCountry: 'SE',
  },
};
/**
 * `geo` publiceras BARA för koordinater kommunen själv lämnat.
 *
 * Uppsala och Örebro lämnar inga koordinater. 1 570 verksamheter har därför en
 * punkt som pipelinen geokodat fram ur adressen mot OpenStreetMap
 * (`geoSource: 'osm'`), varav 228 bara matchat närmaste grannport.
 *
 * På skärmen ritar Platskarta nålen streckad och skriver förbehållet under
 * kartan. I JSON-LD stod ingenting: schemat såg identiskt ut för en
 * kommunlämnad och en härledd punkt, alltså saknades förbehållet exakt där
 * maskinen läser. Och det är JSON-LD en sökmotor, en språkmodell eller en
 * framtida datalicenstagare faktiskt hämtar.
 *
 * Schema.org har ingen flagga för "härledd" på GeoCoordinates, så det finns
 * ingen form som både publicerar punkten och bär förbehållet. Då är det rätta
 * att inte påstå den. Vi säger inte maskinellt att koordinaten kommer från
 * kommunen när den inte gör det. "Verifiera, aldrig gissa" gäller den
 * maskinläsbara sidan också.
 */
if (e.lat && e.lng && e.geoSource !== 'osm') {
  jsonLd.geo = { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lng };
}

/**
 * Vilken artikel bandet längst ned visar.
 *
 * Kopplingen är stark på den här sidtypen, alltså väljs artikel och inte den
 * senaste: den som just läst att stället har anmärkningar undrar rimligen vad
 * som händer sedan, och den som läst en ren kontroll har mer nytta av att
 * veta vad kontrollen faktiskt omfattar. Listan är en prioritetsordning;
 * ArtikelBanner faller tillbaka på den senast publicerade artikeln av sig
 * själv om slugen skulle försvinna, och visar ingenting alls så länge
 * artikelsektionen ligger under sin kvalitetströskel.
 */
const artikelval =
  e.verdict === 'minor' || e.verdict === 'major'
    ? ['vad-hander-efter-en-anmarkning', 'sa-laser-du-en-hygienkontroll']
    : ['sa-laser-du-en-hygienkontroll', 'vad-hander-efter-en-anmarkning'];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
    { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(kommun.slug) },
    { '@type': 'ListItem', position: 3, name: e.name },
  ],
};
---

<Base
  title={`${e.name}, ${kommun.city}`}
  description={description}
  noindex={!indexable}
  jsonLd={[jsonLd, breadcrumbs]}
  dataUpdated={latest ?? undefined}
>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path(kommun.slug)}>{kommun.city}</a>
    </nav>

    {/* Sidhuvudet efter Boolis: namnet, och under det en tyst rad med typ,
        adress och stad skilda av punkter. Kartlänken sist på raden hoppar
        till kartsektionen, som Boolis "Karta"-våde ovanför bilderna. */}
    <header class="masthead">
      <h1>{e.name}</h1>
      <p class="place text-secondary">
        {[e.types[0], e.address, kommun.city].filter(Boolean).join(' · ')}
        {hasCoords && (
          <>
            {' · '}
            <a class="kartlank" href="#karta">Visa på karta</a>
          </>
        )}
      </p>
    </header>

    {/* Handlingarna i ögonhöjd, som Boolis rad direkt under bilden. De låg
        tidigare i sidopanelen, alltså efter hela huvudkolumnen på telefon.
        Raden bär det besökaren gör; rättelsen och verksamhetens replikrätt
        står kvar i panelen, se ActionPanel.astro. Delningens text är
        svarsmeningen, som redan är skriven för att vara självbärande. */}
    <Handlingsrad
      establishmentId={e.id}
      establishmentName={e.name}
      municipalitySlug={kommun.slug}
      shareText={answer}
    />

    <div class="layout">
      <main class="main">
        {/* Bedömningen där booli har priset: en tyst etikett, ett stort
            besked, och svarsmeningen under. Metodiklänken är deras
            "Se Boolis värdering" — vägen till hur talet blev till. */}
        <section class="statement">
          <p class="eyebrow">Bedömning</p>
          <div class="verdict">
            <FaceMark verdict={e.verdict} size={52} animate wink />
            <div>
              <p class="level">
                {presentation.label}
                {e.distinction && (
                  <span class="badge" title={DISTINCTION.label}>★ {DISTINCTION.short}</span>
                )}
              </p>
              <p class="answer">{answer}</p>
            </div>
          </div>
          <p class="method caption">
            <a href="/metodik/">Så sätts bedömningen</a>
          </p>
        </section>

        {/* Datumet bedömningen vilar på, som ett kalenderblad. PAUSAD av
            ägaren: komponenten renderar ingenting, och flaggan som styr det
            bor i Kontrolldatum.astro tillsammans med skälet. Anropet står
            kvar så att beslutet ligger på ett ställe. */}
        {latestInspection && (
          <Kontrolldatum inspection={latestInspection} href="#kontrollhistorik" />
        )}

        {/* Nyckelfakta i öppen rad direkt under beskedet, som Boolis
            Boarea · Rum · Byggår under priset. Förbehållen bor i tipsen. */}
        <FactGrid facts={facts} />

        {/* Har verksamheten fått utmärkelsen är det det näst viktigaste
            sidan har att säga. */}
        <AwardNote establishment={e} />

        {/* Spegelbilden. Bägge komponenterna renderar ingenting när
            verksamheten inte uppfyller sina kriterier, och de kan aldrig
            gälla samtidigt: utmärkelsen kräver rena kontroller i rad,
            matsnusk kräver brister som kvarstod vid uppföljningen. */}
        <MatsnuskNote establishment={e} />

        {latestInspection && latestInspection.areas.length > 0 && (
          <ControlBreakdown
            areas={latestInspection.areas}
            inspectedAt={formatDate(latestInspection.date)}
          />
        )}

        {/* Efter vad kontrollen visade, före vad som återkommer: sidan läses
            som en berättelse i tid. Vad hittades, blev det åtgärdat, och
            händer det om och om igen. */}
        <FollowUp followUp={uppfoljning} kommun={kommun.name} />

        <RecurringIssues issues={recurring} />

        <InspectionHistory inspections={e.inspections} />

        {/* Kartan som egen sektion i huvudkolumnen med adressen under, som
            hos booli. Efter historiken: den hör till fakta om stället men
            ska inte klyva kontrollberättelsen. Verksamheter utan koordinat
            får ingen kartsektion alls. */}
        {hasCoords && (
          <Platskarta
            lat={e.lat!}
            lng={e.lng!}
            name={e.name}
            verdict={e.verdict}
            geoSource={e.geoSource}
            address={e.address}
            city={kommun.city}
          />
        )}

        {/*
          Omdömen ligger SIST i huvudkolumnen, efter allt som bygger på
          kommunens data och före källhänvisningen. Ordningen är ett
          påstående: kontrollen först, åsikterna sedan, och aldrig blandade.
          Avsnittet är tomt i HTML-filen och fylls i webbläsaren, så inget en
          besökare skrivit kommer in i ett bygge. Se Reviews.astro.
        */}
        <Reviews
          establishmentId={e.id}
          establishmentName={e.name}
          municipalitySlug={kommun.slug}
        />

        {/* En rad, inte sex: när uppgifterna senast hämtades. Källa och
            metodik är fullständiga på /kallor och /metodik, länkade i
            sidfoten på varje sida. Resonemanget står i git-historiken. */}
        <footer class="source">
          <p class="caption text-muted">
            Uppdaterat {formatDate(source.fetchedAt.slice(0, 10))}.
          </p>
        </footer>
      </main>

      <aside class="side">
        <div class="panel">
          {e.image && <StreetPhoto image={e.image} name={e.name} />}
          <ActionPanel
            establishmentId={e.id}
            establishmentName={e.name}
            municipalitySlug={kommun.slug}
          />
        </div>

        {neighbours.length > 0 && (
          <div class="panel">
            <h2 class="panel-title">
              Närliggande
              <InfoTip
                label="närliggande"
                text="Verksamheter med registrerad kontroll inom gångavstånd, sorterade efter avstånd."
              />
            </h2>
            <ul class="near">
              {neighbours.map((n) => (
                <li>
                  <a href={path(kommun.slug, n.slug)}>
                    <FaceMark verdict={n.verdict} size={30} variant="round" />
                    <span class="near-info">
                      <b>{n.name}</b>
                      <span class="text-muted">{formatDistance(n.metres)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="panel">
          <h2 class="panel-title">Så ser det ut i {kommun.city}</h2>
          {dist.length > 0 && (
            <div
              class="fordelning"
              role="img"
              aria-label={`Av ${formatNumber(kommunSummary.assessed)} bedömda verksamheter i ${kommun.city}: ${formatNumber(kommunSummary.clean)} utan anmärkningar, ${formatNumber(kommunSummary.minor)} med brister och ${formatNumber(kommunSummary.major)} med brister som kvarstår.`}
            >
              {dist.map((d) => (
                <span
                  style={`flex-basis:${d.share}%;background:var(--verdict-${d.k})`}
                ></span>
              ))}
            </div>
          )}
          <p class="kommun-line">
            <b>{kommunSummary.cleanShare} %</b> av de
            {' '}{formatNumber(kommunSummary.assessed)} bedömda verksamheterna i
            {' '}{kommun.city} fick inga anmärkningar vid sin senaste kontroll.
          </p>
          <ul class="kommun-links">
            <li><a href={path(kommun.slug)}>Alla hygienkontroller i {kommun.city}</a></li>
            {ownCategories.map((s) => (
              <li>
                {/* `short` och inte `plural`: Övrigts plural är "verksamheter",
                    och "Alla verksamheter i Uppsala" läses som hela kommunen —
                    alltså samma sak som länken raden ovanför. */}
                <a href={path(kommun.slug, 'kategori', s.category.slug)}>
                  Alla {s.category.short} i {kommun.city}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    {/* Längst ned, efter allt man kom för. Bandet ligger utanför .layout och
        kan därför aldrig skjuta ned bedömningen eller kontrollhistoriken; det
        börjar där de två spalterna tar slut. */}
    <ArtikelBanner prefer={artikelval} />
  </div>

</Base>

<style>
  .page {
    max-width: var(--w-wide);
    padding-block: var(--s-6) var(--s-16);
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

