---
/**
 * Restaurangsidan — sajtens viktigaste sidtyp.
 *
 * Layout: tvåkolumn med sticky sidopanel, mönstret som hitta.se, ednia,
 * TheFork och Zillow alla använder. Huvudinnehållet läses uppifrån och ner;
 * panelen bär det man vill ha kvar i blickfånget — bedömningen, kartan och
 * åtgärderna. En centrerad enkolumn ser generisk ut och slösar bredden.
 *
 * Titeln leder med NAKET NAMN + ORT, inte med "hygienkontroll". Skälet är
 * mätt: i Storbritannien, världens mognaste marknad för hygienbetyg, ger
 * "food hygiene rating" 54,7 i söktrend medan "nandos food hygiene rating"
 * ger 0,04 — under 0,1 % för en av landets största kedjor. Ingen söker på
 * "[restaurang] hygien". Sidan måste vinna på namnet, som hitta.se gör, och
 * hygienen är differentieraren i beskrivningen.
 *
 * Två SEO/AEO-krav styr innehållet:
 *
 * 1. Led med svaret. Första meningen ska vara självbärande och citerbar.
 *    Så extraherar AI-svar fakta (bibeln §6b).
 * 2. Aldrig `Review`- eller `AggregateRating`-schema för hygienbedömningen.
 *    Den bygger på myndighetsdata, inte på omdömen insamlade hos oss.
 *    Schemat är `FoodEstablishment`. (När förstapartsomdömen finns får de
 *    eget schema — men hålls visuellt och strukturellt åtskilda.)
 */
import Base from '../../layouts/Base.astro';
import FaceMark from '../../components/FaceMark.astro';
import FactGrid from '../../components/FactGrid.astro';
import InfoTip from '../../components/InfoTip.astro';
import LocationMap from '../../components/LocationMap.astro';
import StreetPhoto from '../../components/StreetPhoto.astro';
import ControlBreakdown from '../../components/ControlBreakdown.astro';
import RecurringIssues from '../../components/RecurringIssues.astro';
import InspectionHistory from '../../components/InspectionHistory.astro';
import {
  establishments,
  municipalities,
  sourceFor,
  formatDate,
  formatDistance,
  isIndexable,
  latestInspectionDate,
  missingReason,
  nearby,
  recurringIssues,
  statistics,
  type Establishment,
} from '../../lib/data';
import { DISTINCTION, MISSING, SITE, VERDICT } from '../../lib/site';

export async function getStaticPaths() {
  // Alla kommuner vi har data för. Ingen lista i kod — db.ts upptäcker dem.
  return municipalities().flatMap((m) =>
    establishments(m.slug).map((e) => ({
      params: { kommun: m.slug, slug: e.slug },
      props: { establishment: e },
    })),
  );
}

interface Props {
  establishment: Establishment;
}

const { establishment: e } = Astro.props;
const kommun = e.municipality;
const source = sourceFor(kommun.slug)!;

const presentation = e.verdict ? VERDICT[e.verdict] : MISSING[missingReason(e)];
const latest = latestInspectionDate(e);
const latestInspection = e.inspections[0];
const stats = statistics(e);
const neighbours = nearby(e);
const recurring = recurringIssues(e);
const indexable = isIndexable(e);

const answer = latest
  ? `${e.name} ${presentation.sentence} den ${formatDate(latest)}.`
  : `${e.name} ${presentation.sentence}.`;

const description = `${answer} Se vilka kontrollområden som granskades och hela kontrollhistoriken.`;

const facts = [
  { label: 'Kontroller totalt', value: String(stats.total),
    tip: `Samtliga registrerade livsmedelskontroller sedan ${stats.firstYear}.` },
  { label: 'Utan anmärkning', value: String(stats.cleanShare), unit: '%',
    color: stats.cleanShare >= 80 ? 'var(--verdict-clean)' : undefined,
    tip: 'Andel av kontrollerna där inga avvikelser noterades.' },
  { label: 'Återbesök', value: String(stats.followUps),
    tip: 'Uppföljande kontroller som gjorts för att se om tidigare avvikelser åtgärdats.' },
  { label: 'Först kontrollerad', value: stats.firstYear ?? '–' },
];

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: e.name,
  url: new URL(Astro.url.pathname, SITE.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: e.address ?? undefined,
    addressLocality: kommun.city,
    addressCountry: 'SE',
  },
};
if (e.lat && e.lng) {
  jsonLd.geo = { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lng };
}

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: kommun.name, item: `${SITE.url}/${kommun.slug}` },
    { '@type': 'ListItem', position: 3, name: e.name },
  ],
};
---

<Base
  title={`${e.name}, ${kommun.city}`}
  description={description}
  noindex={!indexable}
  jsonLd={[jsonLd, breadcrumbs]}
  dataUpdated={latest ?? undefined}
>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={`/${kommun.slug}`}>{kommun.city}</a>
    </nav>

    <header class="masthead">
      <h1>{e.name}</h1>
      <p class="place text-secondary">
        {[e.address, kommun.city].filter(Boolean).join(', ')}
        {e.types.length > 0 && <> · {e.types[0]}</>}
      </p>
    </header>

    <div class="layout">
      <main class="main">
        <section class="statement">
          <span class:list={['markring', e.verdict === 'clean' && 'spins']}>
            <FaceMark verdict={e.verdict} size={52} animate wink />
          </span>
          <div>
            <p class="level">
              {presentation.label}
              {e.distinction && (
                <span class="badge" title={DISTINCTION.label}>★ {DISTINCTION.short}</span>
              )}
            </p>
            <p class="answer">{answer}</p>
          </div>
        </section>

        <FactGrid
          title="Statistik"
          titleTip="Sammanräknat från verksamhetens hela kontrollhistorik hos kommunen."
          facts={facts}
        />

        {latestInspection && latestInspection.areas.length > 0 && (
          <ControlBreakdown
            areas={latestInspection.areas}
            inspectedAt={formatDate(latestInspection.date)}
          />
        )}

        <RecurringIssues issues={recurring} />

        <InspectionHistory inspections={e.inspections} />

        <footer class="source">
          <p class="caption text-muted">
            Källa: {kommun.name}, hämtat {formatDate(source.fetchedAt.slice(0, 10))}.
            Bedömningen är Prikkos — <a href="/metodik">så räknas den fram</a>.
            <a href="/ratta">Rätta en uppgift</a>.
          </p>
        </footer>
      </main>

      <aside class="side">
        <div class="panel">
          {e.image && <StreetPhoto image={e.image} name={e.name} />}
          {e.lat && e.lng && (
            <LocationMap lat={e.lat} lng={e.lng} name={e.name} verdict={e.verdict} />
          )}

          <div class="actions">
            <button type="button" class="btn-primary" disabled>Följ verksamheten</button>
            <button type="button" class="btn-ghost" disabled>Anmäl en brist</button>
            <button type="button" class="btn-ghost" disabled>Skriv ett omdöme</button>
          </div>
          <p class="soon caption text-muted">
            Bevakning, anmälan och omdömen öppnar när fler kommuner är på plats.
          </p>
        </div>

        {neighbours.length > 0 && (
          <div class="panel">
            <h2 class="panel-title">
              Närliggande
              <InfoTip
                label="närliggande"
                text="Verksamheter med registrerad kontroll inom gångavstånd, sorterade efter avstånd."
              />
            </h2>
            <ul class="near">
              {neighbours.map((n) => (
                <li>
                  <a href={`/${kommun.slug}/${n.slug}`}>
                    <FaceMark verdict={n.verdict} size={30} variant="round" />
                    <span class="near-info">
                      <b>{n.name}</b>
                      <span class="text-muted">{formatDistance(n.metres)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: 1080px;
    padding-block: var(--s-6) var(--s-16);
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  .masthead h1 {
    font-size: 34px;
    line-height: 38px;
    letter-spacing: -.024em;
  }

  .place {
    margin-top: 2px;
    font-size: var(--fs-body-s);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--s-8);
    align-items: start;
    margin-top: var(--s-6);
  }

  .main {
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    padding: var(--s-6) var(--s-8);
  }

  /* :global krävs — Astros scopeade selektorer korsar inte komponentgränser. */
  .main > :global(* + *) {
    margin-top: var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .statement {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
  }

  /* Ringen runt bedömningsmärket. Snurrar ETT varv när sidan öppnas och
     stannar sedan — den ska lyfta fram beskedet, inte snurra som en
     laddningsindikator och antyda att något är på väg att hända.
     Bara på godkänt: en ring som firar runt "brister som kvarstår" vore
     att fira fel sak. */
  .markring {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
  }

  /* Kanten följer märkets form — en rundad kvadrat, inte en cirkel.
     Märket har rx 17 på ett 100-rutnät och renderas i 52 px, alltså 8,8 px
     radie; plus 6 px utanförliggande inset blir ytterradien knappt 15.

     Kanten ligger I LIV med märket, inte utanför det: inset 0 och samma
     radie som märkets egen, så den läser som märkets kant och inte som en
     ring runt omkring.

     Två tekniker samverkar:
     1) Gradientkant. Ett vanligt `border` kan inte ha gradient. Elementet
        får därför gradienten som bakgrund, en padding lika bred som kanten,
        och en mask som skär bort allt utom paddingen. Kvar blir en kant som
        följer border-radius.
     2) Svepet roterar GRADIENTENS vinkel, inte elementet. Roteras elementet
        snurrar hela rektangeln som ett hjul; här står formen still medan
        ljuset vandrar runt den. Det kräver att vinkeln är en registrerad
        egenskap — annars kan CSS inte interpolera den. */
  @property --prikko-sweep {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .markring.spins::before {
    content: '';
    position: absolute;
    /* I liv med märket: inset 0 och samma radie som märkets egen.
       Märket har rx 17 på ett 100-rutnät och renderas i 52 px → 8,8 px. */
    inset: 0;
    border-radius: 8.8px;
    padding: 1.5px;
    /* Nästan vitt, inte grönt. Svepet låg tidigare i samma gröna som märkets
       egen fyllning och var därför osynligt — grönt på grönt. Ett ljust svep
       läser som en glans över kanten och fungerar mot alla tre
       betygsfärgerna, inte bara den gröna. */
    background: conic-gradient(
      from var(--prikko-sweep),
      rgba(255, 255, 255, 0) 0deg,
      rgba(255, 255, 255, .35) 55deg,
      rgba(255, 255, 255, .95) 150deg,
      rgba(255, 255, 255, .35) 230deg,
      rgba(255, 255, 255, 0) 310deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    animation: markring-sweep 1.2s cubic-bezier(.3, 0, .2, 1) .15s 1 both;
    pointer-events: none;
  }

  @keyframes markring-sweep {
    from { --prikko-sweep: 0deg;   opacity: 0; }
    15%  { opacity: 1; }
    75%  { opacity: 1; }
    to   { --prikko-sweep: 360deg; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .markring.spins::before { animation: none; opacity: 0; }
  }

  .level {
    color: var(--text);
    font-size: var(--fs-h-s);
    line-height: 26px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .badge {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--distinction);
    border: 1px solid color-mix(in srgb, var(--distinction) 45%, transparent);
    border-radius: var(--r-pill);
    padding: 2px 9px;
  }

  .answer {
    margin-top: var(--s-1);
    font-size: var(--fs-body-s);
    line-height: 21px;
    color: var(--text-secondary);
  }

  .source p {
    font-size: var(--fs-body-s);
    line-height: 21px;
    color: var(--text-secondary);
  }

  .source p + p { margin-top: var(--s-2); }

  /* Sidopanel */
  .side {
    position: sticky;
    top: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .panel {
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    padding: var(--s-4);
  }

  .panel-title {
    font-size: var(--fs-body-s);
    font-weight: 600;
    display: flex;
    align-items: center;
    margin-bottom: var(--s-3);
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .actions button {
    width: 100%;
    justify-content: center;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    padding: 11px 22px;
    font: 600 var(--fs-body-s)/1 var(--font-sans);
    cursor: pointer;
  }

  .actions button:disabled {
    opacity: .45;
    cursor: not-allowed;
  }

  .soon {
    margin-top: var(--s-3);
    text-align: center;
  }

  .near {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .near a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
    color: var(--text);
  }

  .near a:hover { text-decoration: none; }
  .near a:hover b { color: var(--brand); }

  .near li + li { border-top: 1px solid var(--hairline); }

  .near-info { min-width: 0; }

  .near-info b {
    display: block;
    font-size: var(--fs-caption);
    font-weight: 600;
    line-height: 17px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .near-info span { font-size: 11px; }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .main { padding: var(--s-6) var(--s-4); }

    .masthead h1 {
      font-size: 27px;
      line-height: 31px;
    }
  }
</style>
