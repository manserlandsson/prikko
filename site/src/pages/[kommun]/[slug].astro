---
/**
 * Restaurangsidan — sajtens viktigaste sidtyp.
 *
 * Formen är Boolis objektsida, på ägarens uttryckliga riktning: "den gillar
 * jag ALLT med... den är SÅ Clean." Det som gör deras sida lugn trots mängden
 * information är tre saker, och alla tre används här:
 *
 *  1. Ingen kortlåda runt huvudinnehållet. Sektionerna ligger öppet på sidan,
 *     skilda av hårlinjer och luft, inte av ramar.
 *  2. Ett stort värde bär sidan. Hos dem priset under etiketten "Utropspris",
 *     hos oss bedömningen under etiketten "Bedömning", med nyckelfakta i en
 *     öppen rad direkt under: liten etikett över stort tal, luft emellan.
 *  3. Kartan är en egen sektion i huvudkolumnen med adressen under, inte en
 *     miniatyr i marginalen. Sidopanelen bär det man agerar med — hos dem
 *     mäklarkortet, hos oss bevakningen, omdömet och rättelsen.
 *
 * Layouten är tvåkolumn med sticky sidopanel, som booli. Huvudkolumnen läses
 * uppifrån och ner som en berättelse i tid: vad kontrollen visade, blev det
 * åtgärdat, återkommer det, hela historiken — och sedan var stället ligger.
 *
 * Titeln leder med NAKET NAMN + ORT, inte med "hygienkontroll". Skälet är
 * mätt: i Storbritannien, världens mognaste marknad för hygienbetyg, ger
 * "food hygiene rating" 54,7 i söktrend medan "nandos food hygiene rating"
 * ger 0,04 — under 0,1 % för en av landets största kedjor. Ingen söker på
 * "[restaurang] hygien". Sidan måste vinna på namnet, och hygienen är
 * differentieraren i beskrivningen.
 *
 * Två SEO/AEO-krav styr innehållet:
 *
 * 1. Led med svaret. Första meningen ska vara självbärande och citerbar.
 *    Så extraherar AI-svar fakta (bibeln §6b).
 * 2. Aldrig `Review`- eller `AggregateRating`-schema för hygienbedömningen.
 *    Den bygger på myndighetsdata, inte på omdömen insamlade hos oss.
 *    Schemat är `FoodEstablishment`. (När förstapartsomdömen finns får de
 *    eget schema — men hålls visuellt och strukturellt åtskilda.)
 */
import Base from '../../layouts/Base.astro';
import FaceMark from '../../components/FaceMark.astro';
import FactGrid from '../../components/FactGrid.astro';
import InfoTip from '../../components/InfoTip.astro';
import Platskarta from '../../components/Platskarta.astro';
import TaMigHit from '../../components/TaMigHit.astro';
import Oppettider from '../../components/Oppettider.astro';
import Kontaktuppgifter from '../../components/Kontaktuppgifter.astro';
import Foretagsregister from '../../components/Foretagsregister.astro';
import Sidupphov from '../../components/Sidupphov.astro';
import Avregistrerad from '../../components/Avregistrerad.astro';
import { harNagot } from '../../lib/kontakt';
import { avregistrerad, registerrader } from '../../lib/registrering';
import OppetPille from '../../components/OppetPille.astro';
import Foretagsuppgifter from '../../components/Foretagsuppgifter.astro';
import Foretagsbilder from '../../components/Foretagsbilder.astro';
import Bildband from '../../components/Bildband.astro';
import AwardNote from '../../components/AwardNote.astro';
import JamforRuta from '../../components/JamforRuta.astro';
import ControlBreakdown from '../../components/ControlBreakdown.astro';
import FollowUp from '../../components/FollowUp.astro';
import RecurringIssues from '../../components/RecurringIssues.astro';
import InspectionHistory from '../../components/InspectionHistory.astro';
import Kontrollserien from '../../components/Kontrollserien.astro';
import Bilder from '../../components/Bilder.astro';
import Fordelning from '../../components/Fordelning.astro';
import Nyckeltal from '../../components/Nyckeltal.astro';
import Reviews from '../../components/Reviews.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import ArtikelBanner from '../../components/ArtikelBanner.astro';
import Handlingsrad from '../../components/Handlingsrad.astro';
import Anmal from '../../components/Anmal.astro';
import { anmalningsvagar, arKonsumentvand } from '../../lib/anmalan.ts';
import Kontrolldatum from '../../components/Kontrolldatum.astro';
import {
  BEST_NEARBY_M,
  bestNearby,
  categoriesOf,
  cleanStreak,
  establishments,
  followUp,
  isRemark,
  mergedAreas,
  municipalities,
  sourceFor,
  distanceLabel,
  formatDate,
  formatNumber,
  isIndexable,
  latestInspectionDate,
  missingReason,
  municipalityCategories,
  municipalitySummary,
  nearby,
  recurringIssues,
  statistics,
  type CategorySlice,
  type Establishment,
} from '../../lib/data';
import { chainFor } from '../../lib/kedjor';
import { JAMFOR_NYHET_SYNS, compareHref, compareSuggestions } from '../../lib/jamfor';
import { majorSentence } from '../../lib/omdome';
import { linkedAreaOf } from '../../lib/omraden';
import { MISSING, SITE, VERDICT } from '../../lib/site';
import { absolute, path } from '../../lib/urls';

export async function getStaticPaths() {
  // Alla kommuner vi har data för. Ingen lista i kod — db.ts upptäcker dem.
  return municipalities().flatMap((m) =>
    establishments(m.slug).map((e) => ({
      params: { kommun: m.slug, slug: e.slug },
      props: { establishment: e },
    })),
  );
}

interface Props {
  establishment: Establishment;
}

const { establishment: e } = Astro.props;
const kommun = e.municipality;
const source = sourceFor(kommun.slug)!;

/** Stadsdelen verksamheten ligger i, när den har en egen sida. */
const omrade = linkedAreaOf(e);

const presentation = e.verdict ? VERDICT[e.verdict] : MISSING[missingReason(e)];

/*
 * Meningen för "Brister som kvarstår" är en funktion av grunden, inte en
 * konstant. Skärpningen sker på tre olika grunder i grading.py och bara en av
 * dem är ett återbesök; se lib/omdome.ts för talen och för de tre meningarna.
 * `presentation.sentence` är reservtexten och används för de två andra
 * nivåerna som förut.
 */
const sentence = majorSentence(e) ?? presentation.sentence;
const latest = latestInspectionDate(e);
const latestInspection = e.inspections[0];
const stats = statistics(e);
const neighbours = nearby(e);
const hasCoords = e.lat !== null && e.lng !== null;

/*
 * Bilderna skickas HELA till bandet, och delas inte upp här.
 *
 * Här stod en uppdelning: bilder utan attributionskrav gick till bandet i
 * huvudkolumnen, och den första bilden med ett krav gick till en figur i
 * sidopanelen. Ägaren 2026-08-27: "kolla på 4340 och se hur holy smoke ser ut
 * nu, så det är annorlunda tillskillnad från wikipedia bilderna? så ska det
 * väl ej va?"
 *
 * Han har rätt. Det gav två komponenter som ritade samma sak, och vilken som
 * ritade avgjordes av om verksamheten råkade ha en bild eller flera. Uppmätt
 * i bygget: /hoganas/holy-smoke bar klassen `mosaik` och
 * /stockholm/restaurant-frantzen klassen `photo`. 366 sidor mot en, alltså var
 * undantaget normalfallet.
 *
 * Bandet bär numera varje bild och hela attributionen, se Bildband.astro, och
 * `photo`-vägen är borta. Grinden som avgör vad som FÅR visas bor kvar i
 * bandet, för det är samma grind som avgör om bilden kan bära sin licensrad.
 */

/*
 * Vad jämförelserutan föreslår. Grannarna är redan uträknade ovan och skickas
 * in, så förslagen kostar inget nytt svep över kommunen. Se lib/jamfor.ts.
 */
const compareWith = compareSuggestions(e, neighbours);
const compareMetres = Object.fromEntries(neighbours.map((n) => [n.slug, n.metres]));

/**
 * De bästa inom 500 meter, som EGEN lista bredvid den som sorterar på avstånd.
 *
 * De två listorna svarar på två frågor och ska därför inte vara en. "Vad
 * ligger närmast" och "var är det bäst" ger olika svar på 12 632 av de 13 210
 * sidor som har minst en ren granne inom radien, alltså på 95,6 procent av
 * dem. Räknat i bygget 2026-08-18 genom att räkna rubrikerna i utgåvan.
 *
 * Att den andra listan finns har också ett belagt sökskäl: `restauranger
 * [stad] högst betyg` är den enda frasform som mätts till 8 av 8, se docs/30
 * §5.1 och docs/29 §7. Ordet "betyg" får aldrig stå i en rubrik hos oss, av
 * skälet som står i docs/26 §8 punkt 5, men efterfrågan bakom det är den bäst
 * belagda vi har och den besvaras här, på den sida man redan står på. Ingen ny
 * URL: filtaket fäller bygget vid 19 500 filer och vi ligger på 17 000.
 *
 * Regeln som gör listan tillåten står i lib/data.ts vid bestNearby(): den
 * innehåller bara verksamheter UTAN anmärkningar, den går inte att vända, och
 * någon motsvarande lista över de sämsta finns inte och ska inte finnas.
 *
 * Blocket uteblir helt på sidor utan koordinat. En radie kan inte gälla en
 * verksamhet utan punkt, och en tom lista med rubrik vore ett påstående om att
 * det inte finns något bra i närheten. Ingen rubrik alls är det sanna.
 *
 * 2 431 av 16 047 verksamheter saknar koordinat. Fyra kommuner publicerar
 * ingen adress alls att geokoda och står därför på noll, se docs/33 §10.1:
 * Borgholm 406, Höganäs 316, Lomma 153 och Svenljunga 99, alltså 974 sidor.
 * Resten är OSM:s luckor i Uppsala 868, Örebro 588 och Oskarshamn 1.
 *
 * Utfallet i utgåvan, räknat på rubrikerna i bygget 2026-08-18:
 *
 *   13 616 sidor bär "Nära dig", alltså exakt de som har en koordinat.
 *   12 632 bär också "Bäst i närheten", 92,8 procent av dem.
 *      406 har en koordinat men ingen ren granne inom 500 meter.
 *      578 tappar blocket för att det säger samma sak som listan ovanför.
 */
const bastaResultat = bestNearby(e);
const bastaAlla = bastaResultat.items;

/**
 * Och blocket uteblir också när det säger EXAKT samma sak som listan ovanför.
 *
 * På glesa sidor är de fyra närmaste ofta just de fyra rena, och då blir andra
 * panelen samma fyra namn i annan ordning, direkt under den första. En läsare
 * läser det som att sidan är trasig, inte som två svar på två frågor.
 *
 * Villkoret är hårt satt: blocket faller bara när mängderna är IDENTISKA, inte
 * när de överlappar. Överlapp är normalt och ska synas, eftersom ett ställe som
 * både ligger närmast och är bäst belagt förtjänar att stå på båda ställena.
 * Med det villkoret faller blocket på 578 sidor. Hade regeln i stället varit
 * "bästlistan ryms i närlistan" hade den fällt fler, och den hade fällt fel:
 * en bästlista med tre namn ur en närlista med fyra är ett annat svar.
 */
const naraSlugs = new Set(neighbours.map((n) => n.slug));
const basta =
  bastaAlla.length === naraSlugs.size && bastaAlla.every((n) => naraSlugs.has(n.slug))
    ? []
    : bastaAlla;

/**
 * Kommunen som jämförelsepunkt.
 *
 * "Inga anmärkningar" säger ingenting om huruvida det är vanligt eller
 * sällsynt. I Jönköping har 98 % av de bedömda inga anmärkningar och beskedet
 * är alltså normaltillståndet; i Lomma har 45 % det och samma besked betyder
 * något helt annat. Utan nämnaren läser besökaren in en ranking som inte
 * finns.
 *
 * Panelen är också den enda länken härifrån till kommunhubben utöver
 * brödsmulan, och hubben är den sidtyp som bär trafiken.
 */
const kommunSummary = municipalitySummary(kommun);
const recurring = recurringIssues(e);
const indexable = isIndexable(e);

/**
 * Fördelningen bakom kommunsiffran, som ett band.
 *
 * Samma tal som meningen under redan bär, tecknade som yta så att de går att
 * ta in på en blick. Andelarna räknas på BEDÖMDA, aldrig på totalen, samma
 * nämnare som cleanShare och av samma skäl. Bandet bär fördelningen inom EN
 * kommun; kommuner emellan jämförs aldrig.
 *
 * Färgen sätts här och inte i Fordelning.astro: segmenten ÄR bedömningens tre
 * nivåer, i ordningen ren, avvikelse, kvarstående brist, och det är det enda
 * fallet där de tre färgerna får bära ett band. Varje mängd står dessutom i
 * klartext med sitt eget ord under bandet, så färgen är aldrig ensam
 * informationsbärare.
 *
 * TECKENFÖRKLARINGEN BÄR ANTAL OCH INGEN ANDEL, till skillnad från
 * kommunhubbens. Där finns inget huvudtal, och andelen måste stå någonstans.
 * Här ÄR huvudtalet andelen: 89 % står redan i --fs-title strax ovanför, och
 * eftersom både det och segmenten räknas på bedömda blev den rena mängdens
 * andel exakt samma tal en gång till, sextio pixlar bort. Ett tal som redan
 * står på sidan ska inte stå två gånger. Fordelning.astro gör andelen valfri
 * just för det här fallet.
 */
const dist = kommunSummary.assessed
  ? (['clean', 'minor', 'major'] as const)
      .map((k) => ({
        n: kommunSummary[k],
        label: VERDICT[k].label,
        surface: `var(--verdict-${k})`,
      }))
      .filter((d) => d.n > 0)
  : [];

const distLabel = dist
  .map((d) => `${d.label}: ${formatNumber(d.n)}`)
  .join('. ');

/**
 * Vad uppföljningen visade
 *
 * Sidans starkaste besked, och det enda som säger något om vad som HÄNDE efter
 * en anmärkning. Null för de flesta verksamheter, och då står ingenting. Se
 * followUp() i data.ts.
 *
 * Uppmätt 2026-08-20: 4 863 av 16 047 verksamhetssidor får ett utfall.
 * Talet används en gång till, i nyckeltalet Återbesök längre ned.
 */
const uppfoljning = followUp(e);

/**
 * Vägen tillbaka till kategorisidan.
 *
 * Verksamhetssidorna har hittills bara länkat uppåt till kommunhubben, aldrig
 * i sidled. "Restauranger i Örebro" är en sökning folk gör, och sidan som
 * svarar på den fick inga interna länkar alls utom från hubbens filterrad.
 * categoriesOf() har funnits i data.ts sedan kategorierna byggdes och har
 * aldrig anropats från någon sidmall.
 *
 * Bara kategorier som har en egen sida i den här kommunen, och bara där
 * filtret alls är användbart — samma villkor som styr chipsen på hubben, så
 * att en länk aldrig pekar på en URL som inte finns.
 */
const kommunCats = municipalityCategories(kommun.slug);
const ownCategories: CategorySlice[] = kommunCats.usable
  ? categoriesOf(e)
      .categories.map((id) => kommunCats.slices.find((s) => s.category.id === id))
      .filter((s): s is CategorySlice => s !== undefined && s.linked)
  : [];

/**
 * Vägen i sidled ut ur kommunen.
 *
 * Kategorilänken ovanför går till "Caféer i Stockholm". Den här går till
 * "Espresso House", alla 52, i alla kommuner vi har. Det är den enda länk på
 * sidan som lämnar kommunen, och den frågan är den enda ingen kommunal
 * livsmedelskarta i Sverige kan besvara.
 *
 * `chainFor` är null när kedjan inte har en sida, så länken kan aldrig peka
 * på en URL som kvalitetsgrinden håller borta. Se lib/kedjor.ts.
 */
const kedja = chainFor(e);

/**
 * Vägen till kommunens eget anmälningsformulär, noll, en eller två.
 *
 * Villkoret var tidigare `kommun.code === '0180'` med motiveringen att bara
 * Stockholm har formulär som tar emot verksamheten som parameter. Ägaren
 * 2026-08-27: "hur kan vi inte ha anmäl till kommunen på alla kommuner, visst,
 * vissa kanske vi bara länkar till någon basic e-tjänst ej specifierad för
 * just den restaurangen men ändå." Han har rätt: en allmän länk är inte ett
 * sämre svar, den är rätt svar för de kommunerna, och de 7 524 sidor utanför
 * Stockholm fick i praktiken ingenting.
 *
 * Uppslaget bor i lib/anmalan.data.ts och regeln i lib/anmalan.ts. Här står
 * bara nämnaren för matförgiftningslänken, för det är sidmallen som känner
 * kategorierna, och den nämnaren är öppettidernas: se `arKonsumentvand`.
 * Talet är 9 994 konsumentvända av 16 044.
 *
 * Utfallet, mätt i utgåvan 2026-08-27: 15 514 sidor får rutan mot 8 520 förut.
 * De 530 som inte får den ligger i de fem kommuner som saknar
 * klagomålstjänst, och är där verksamheter ingen ätit på: skolkök, grossister
 * och huvudkontor.
 *
 * Tom lista betyder ingen ruta, och då sätts ingen `.panel` heller ut.
 */
const anmalningsvagarna = anmalningsvagar(kommun.code, e, arKonsumentvand(categoriesOf(e)));

/**
 * Svarsmeningen. Sidans första rad, och den enda rad en språkmodell
 * sannolikt citerar. Måste vara självbärande och sann i varje utfall.
 *
 * Den här limmade tidigare ihop ett datumled på ALLA utfall:
 * `${namn} ${sentence} den ${datum}.` Det bär bara när meningen handlar om
 * en kontroll som faktiskt ägt rum. På 2 136 sidor gjorde den inte det:
 *
 *  - 857 sidor läste "…så nuläget går inte att bedöma den 17 maj 2023",
 *    eftersom meningen för `stale_inspections` slutar i en bisats som inte
 *    tar något datumled. Det går inte att läsa.
 *  - 1 279 sidor sade "har ingen registrerad hygienkontroll hos kommunen"
 *    och bjöd i nästa mening in till att läsa kontrollhistoriken.
 *
 * Därför en gren per utfall i stället för en mall plus konkatenering. Datumet
 * får en egen mening när det inte hör hemma i den första, och den fasta
 * svansen sätts bara när det finns något att se.
 */
const areas = latestInspection?.areas.length ?? 0;

let answer: string;
let detail: string;

if (e.verdict !== null && latest) {
  // Bedömd. Datumet hör till kontrollen meningen handlar om.
  answer = `${e.name} ${sentence} den ${formatDate(latest)}.`;
  detail =
    areas > 0
      ? 'Se vilka kontrollområden som granskades och hela kontrollhistoriken.'
      : 'Se hela kontrollhistoriken hos kommunen.';
} else if (latest) {
  // För gammal kontroll. Kontrollen finns, men den är för gammal för att säga
  // något om nuläget, och då är datumet ett eget påstående, inte ett led i
  // meningen om att bedömningen uteblir.
  answer =
    `${e.name} ${sentence}. ` +
    `Den senaste kontrollen gjordes den ${formatDate(latest)}.`;
  detail =
    areas > 0
      ? 'Se vad som granskades då och hela kontrollhistoriken.'
      : 'Se hela kontrollhistoriken hos kommunen.';
} else {
  // Ingen kontroll alls. Ingen historik att hänvisa till, alltså ingen svans
  // om kontrollområden. Den var det som gjorde beskrivningen självmotsägande.
  answer = `${e.name} ${sentence}.`;
  detail = `Verksamheten finns i kommunens register, men ${kommun.name} har inte publicerat någon kontroll av den.`;
}

const description = `${answer} ${detail}`;

/**
 * Andra meningen i huvudspalten. Står bara på skärmen, aldrig i metadatan.
 *
 * ## Varför den finns
 *
 * Google byggde sin egen text i sökresultatet för The Coffice Albano i stället
 * för att använda vår metabeskrivning, och tog listan i jämförelserutan:
 * "The Coffice Albano med Pressbyrån 4150206 Albanovägen 12 · 92 m …". Rutan
 * är åtgärdad var för sig (den bär `data-nosnippet`, se JamforRuta.astro), men
 * den andra halvan av felet var att sidans egen prosa var EN mening lång.
 * Bedömningen ritas som ett märke och en etikett, alltså grafik, och
 * nyckeltalen är tal med etiketter. En läsare ser en hel sida; en
 * utdragsbyggare ser en rad text och sedan listor.
 *
 * Meningen är därför den enda platsen där adressen, kommunen, antalet
 * kontroller och perioden står i löpande text. Tillsammans med svarsmeningen
 * blir stycket självbärande: vem, var, vilket besked, hur många kontroller och
 * sedan när. Det är också precis vad någon som söker på ett restaurangnamn
 * vill se.
 *
 * ## Varför den INTE går in i metabeskrivningen
 *
 * `answer` bär både beskrivningen och delningstexten och ligger på omkring 155
 * tecken, alltså på gränsen för vad Google visar. En mening till hade tryckt ut
 * slutet av den befintliga. Metadatan är oförändrad.
 *
 * ## Vad den får och inte får påstå
 *
 * Talet är antalet kontroller kommunen publicerar på ADRESSEN, inte på
 * företaget: kommunerna registrerar kontrollen på lokalen, och har lokalen
 * bytt verksamhet ingår föregångarens kontroller. Meningen säger därför
 * "på {adress}" och aldrig "verksamheten har haft". Samma förbehåll som står i
 * nyckeltalens tips, se `facts` nedan.
 *
 * Ordet "bedömningen" används bara när det FINNS en bedömning. På sidor där
 * kontrollerna är för gamla för att säga något om nuläget står meningen som ett
 * rent påstående om vad kommunen publicerat.
 */
const plats = e.address ? `på ${e.address}` : 'på adressen';

let grund: string | null = null;
if (stats.total > 1) {
  const antal = formatNumber(stats.total);
  grund =
    e.verdict !== null
      ? `Bedömningen vilar på ${antal} kontroller som kommunen publicerat ${plats} sedan ${stats.oldestYear}.`
      : `Kommunen har publicerat ${antal} kontroller ${plats} sedan ${stats.oldestYear}.`;
} else if (stats.total === 1) {
  grund =
    e.verdict !== null
      ? 'Bedömningen vilar på den enda kontroll kommunen publicerat ' + plats + '.'
      : `Kommunen har publicerat en kontroll ${plats}.`;
}

/**
 * "Vad betyder det här?" vid bedömningen, och SANT FÖR JUST DEN HÄR SIDAN.
 *
 * Besökaren möter "Inga anmärkningar" eller "Brister" och har hittills bara
 * haft en väg till vad det vilar på: länken till metodiken, som skickar iväg
 * hen från sidan hen kom för. Länken står kvar för den som vill läsa hela
 * modellen, men den är inte längre det enda svaret. Förklaringen sker där man
 * står, i det tips som redan satt på etiketten.
 *
 * TEXTEN GRENAR PER UTFALL, av samma skäl som `answer` och `detail` gör det
 * några rader upp. En generisk mening hade varit osann på de flesta sidor:
 *
 *  - 3 345 av 16 047 sidor bär granskade områden på den senaste kontrollen,
 *    alltså 20,8 procent. Där kan vi säga vad kommunen faktiskt tittade på.
 *    På 11 137 sidor finns en kontroll men inga områden, och där är svaret att
 *    kommunen publicerar utfallet och inte omfattningen. Det är också ett svar,
 *    och det är dessutom en upplysning om källan.
 *  - 1 565 sidor saknar helt en publicerad kontroll att beskriva.
 *  - 11 966 sidor är rena, 1 219 har brister, 373 har brister som kvarstår
 *    och 2 489 saknar bedömning. De fyra behöver olika meningar om HUR
 *    bedömningen satts, eftersom modellen gör olika saker i de fyra fallen.
 *    Se levels[] på metodiksidan, som speglar grading.py.
 *
 * Områdena räknas genom mergedAreas och isRemark, alltså samma två funktioner
 * som avsnittet "Vad kontrollen visade" längre ned använder. Talen i tipset
 * och talen i avsnittet får aldrig skilja sig åt, och Örebro bokför en del
 * punkter två gånger vid samma besök.
 *
 * Kommunens namn står EN gång i tipset. Det är därför `grund` ovan säger
 * "kommunen" och inte namnet: omfattningsmeningen kommer först och namnger
 * den, och `grund` kan aldrig stå utan omfattning, eftersom den kräver minst
 * en kontroll och omfattningen då alltid finns.
 */
const granskade = latestInspection ? mergedAreas(latestInspection.areas) : [];
const avvikelser = granskade.filter(isRemark).length;
const omradesord = granskade.length === 1 ? 'granskat område' : 'granskade områden';

let omfattning: string;
if (!latestInspection) {
  omfattning = `${kommun.name} har inte publicerat någon kontroll ${plats}.`;
} else if (granskade.length === 0) {
  omfattning =
    `${kommun.name} publicerar utfallet av kontrollen den ` +
    `${formatDate(latestInspection.date)}, men inte vilka områden som granskades.`;
} else if (avvikelser === 0) {
  omfattning =
    `Vid kontrollen den ${formatDate(latestInspection.date)} redovisar ` +
    `${kommun.name} ${granskade.length} ${omradesord} utan en enda avvikelse.`;
} else {
  omfattning =
    `Vid kontrollen den ${formatDate(latestInspection.date)} redovisar ` +
    `${kommun.name} ${granskade.length} ${omradesord}, varav ${avvikelser} med avvikelse.`;
}

/* Hur nivån satts. Formuleringarna speglar metodiksidans levels[], som i sin
   tur speglar pipeline/prikko/grading.py. Ändras modellen ändras båda. */
const regel =
  e.verdict === 'clean'
    ? 'Vi bedömer alltid den senaste kontrollen och aldrig ett snitt, så en anmärkning som åtgärdats drar inte ned beskedet.'
    : e.verdict === 'minor'
      ? 'Vi bedömer alltid den senaste kontrollen och aldrig ett snitt. Nivån skärps först när kommunen kallar bristerna allvarliga eller när de står kvar vid en uppföljning.'
      : e.verdict === 'major'
        ? 'Nivån läses ur mönstret och inte ur kommunens ordval: antingen kallade kommunen bristerna allvarliga, eller så stod de kvar vid ett återbesök.'
        : missingReason(e) === 'stale_inspections'
          ? 'Vi sätter ingen bedömning när den senaste kontrollen är äldre än fem år. Det betyder aldrig att hygienen är dålig.'
          : 'Utan publicerad kontroll sätter vi ingen bedömning. Det betyder aldrig att hygienen är dålig.';

const bedomningTips = [omfattning, regel, grund].filter(Boolean).join(' ');

/**
 * Statistiken räknas på ADRESSEN, inte på företaget.
 *
 * Kommunerna registrerar kontrollerna på anläggningen, alltså lokalen, och
 * ingen av de nio källorna säger när verksamheten startade eller om ägaren
 * bytt. Tar en ny restaurang över en adress ärver den föregångarens hela
 * historik. Rutan hette tidigare "Först kontrollerad", vilket läses rakt av
 * som verksamhetens ålder, ett påstående vi inte har täckning för.
 *
 * Talen är oförändrade. Det är etiketterna som slutar tillskriva dem fel part.
 */
const facts = [
  /* "Kontroller" och inte "Kontroller på adressen". Att räkningen gäller
     adressen och inte företaget står i tipset, som är hela skälet till att
     tipset finns. */
  { label: 'Kontroller', value: String(stats.total),
    tip: `Samtliga kontroller kommunen publicerar på den här adressen, från ${stats.oldestYear} och framåt. Har lokalen bytt verksamhet ingår även den tidigare verksamhetens kontroller. Kommunen registrerar kontrollerna på lokalen och inte på företaget.` },
  { label: 'Utan anmärkning', value: String(stats.cleanShare), unit: '%',
    color: stats.cleanShare >= 80 ? 'var(--verdict-clean)' : undefined,
    tip: 'Andel av kontrollerna på adressen där inga avvikelser noterades.' },
  /* Tipset får en andra mening på de sidor där talet är över noll men blocket
     "Vad uppföljningen visade" inte ritas. Utan den säger sidan emot sig
     själv: den räknar upp återbesök och redovisar sedan inget utfall. Ägaren
     har rätt i att den som sett blocket en gång undrar var det tog vägen.

     Uppmätt 2026-08-20 över site/src/data: 2 036 av 16 047 verksamhetssidor.
     Fyra skäl, och de överlappar: kontrollen före publiceras utan de punkter
     som granskades (914), mer än 180 dagar mellan de två (822), ingen
     kontroll före finns i registret (550), kontrollen före hade punkter men
     ingen avvikelse att följa upp (97). Jönköping står för 304 av sidorna och
     Karlstad för 219. Samtliga fyra skäl handlar om vad kommunen publicerar,
     inget om vad som hänt i lokalen.

     Meningen är därför skriven så att den är sann i alla fyra fallen och
     påstår varken ett utfall eller en utebliven uppföljning. Den säger bara
     att de två kontrollerna inte går att para ihop. Se FollowUp.astro för
     hela räkningen och för varför blocket inte får fyllas med en brasklapp. */
  { label: 'Återbesök', value: String(stats.followUps),
    tip: 'Uppföljande kontroller som gjorts för att se om tidigare avvikelser åtgärdats.'
      + (stats.followUps > 0 && uppfoljning === null
        ? ' Vad de ledde till står inte på sidan. Utfallet visas bara när ett återbesök går att ställa mot en kontroll strax före som noterade något att följa upp, och de två går inte att para ihop här. Det säger ingenting om hur återbesöket gick.'
        : '') },
  { label: 'Äldsta kontroll', value: stats.oldestYear ?? '–',
    tip: 'Året för den äldsta kontroll kommunen publicerar på adressen. Det är inte nödvändigtvis året verksamheten startade. Kommunerna publicerar bara ett begränsat antal år bakåt, och historiken följer lokalen.' },
];

/**
 * Raden rena kontroller i följd, som en mening under nyckeltalen.
 *
 * ## Varför en mening och inte ett femte nyckeltal
 *
 * Nyckeltalsraden har fyra platser och de är tagna. Ett femte tal hade dessutom
 * stått bredvid "Utan anmärkning" och sagt nästan samma sak med andra siffror,
 * vilket är precis vad två tal bredvid varandra inte får göra. Meningen står
 * under raden och KVALIFICERAR andelen i stället för att tävla med den, samma
 * grepp som ribban under listan i RenHistorik.astro.
 *
 * ## Varför den bara står ibland
 *
 * Två villkor, och båda har ett mätt skäl.
 *
 * MINST TVÅ. En rad på en enda kontroll är inte en rad. "Den senaste
 * kontrollen var utan anmärkning" står dessutom redan som svarsmening högst
 * upp på sidan.
 *
 * KORTARE ÄN HISTORIKEN. Är hela historiken ren säger meningen samma sak som
 * "Kontroller: 9" och "Utan anmärkning: 100 %" redan säger tio centimeter
 * ovanför. Det gäller 3 230 sidor.
 *
 * Kvar blir 3 375 av 16 047 sidor, alltså 21,0 procent, och det är exakt de
 * sidor där ingen befintlig siffra bär upplysningen: en rad rena kontroller som
 * andelen döljer för att det ligger en gammal anmärkning längst ned. Se
 * cleanStreak() i lib/data.ts för hela mätningen.
 *
 * Nämnaren står utskriven i meningen och är aldrig underförstådd. "De 8
 * senaste" utan "av 9" hade låtit läsaren gissa hur djup historiken är, och
 * djupet är kommunens publiceringsfönster och inte verksamhetens ålder.
 */
const renRad = cleanStreak(e);
const visaRenRad = renRad >= 2 && renRad < stats.total;

/**
 * Kommunens egen utsaga om ägarbyte, när den finns. Återges attribuerad, aldrig
 * som vår slutsats. Se OWNERSHIP_POLICY i data.ts.
 */

/**
 * Upplysningen om lokalen visas på ALLA verksamheter med mer än en kontroll,
 * aldrig villkorad av ett uppehåll i historiken.
 *
 * Ett villkorat förbehåll lär läsaren att frånvaron betyder att historiken är
 * säker. Det är falskt: 64 % av de restaurangliknande verksamheterna i våra
 * djupa kommuner har inget uppehåll alls, och medianintervallet mellan två
 * restaurangkontroller i Stockholm är 272 dagar, så ett ägarbyte däremellan
 * syns inte. Den falska tryggheten hade legat just på de sidor där risken är
 * störst. Se HISTORY_GAP_DAYS i data.ts för mätningen.
 */

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  /* Ett id att peka på.

     Öppettider och telefon kommer från företagsytan och hämtas i webbläsaren,
     alltså finns de inte när den här noden skrivs. Foretagsuppgifter.astro
     lägger till en andra nod med SAMMA @id när uppgifterna kommit hem, och den
     som läser strukturerad data slår då ihop de två i stället för att tro att
     adressen har två restauranger. Utan ett id går det inte att göra. */
  '@id': `${absolute(kommun.slug, e.slug)}#verksamhet`,
  name: e.name,
  url: absolute(kommun.slug, e.slug),
  address: {
    '@type': 'PostalAddress',
    streetAddress: e.address ?? undefined,
    addressLocality: kommun.city,
    addressCountry: 'SE',
  },
};
/**
 * `geo` publiceras BARA för koordinater kommunen själv lämnat.
 *
 * Uppsala och Örebro lämnar inga koordinater. 1 570 verksamheter har därför en
 * punkt som pipelinen geokodat fram ur adressen mot OpenStreetMap
 * (`geoSource: 'osm'`), varav 228 bara matchat närmaste grannport.
 *
 * På skärmen ritar Platskarta nålen streckad och skriver förbehållet under
 * kartan. I JSON-LD stod ingenting: schemat såg identiskt ut för en
 * kommunlämnad och en härledd punkt, alltså saknades förbehållet exakt där
 * maskinen läser. Och det är JSON-LD en sökmotor, en språkmodell eller en
 * framtida datalicenstagare faktiskt hämtar.
 *
 * Schema.org har ingen flagga för "härledd" på GeoCoordinates, så det finns
 * ingen form som både publicerar punkten och bär förbehållet. Då är det rätta
 * att inte påstå den. Vi säger inte maskinellt att koordinaten kommer från
 * kommunen när den inte gör det. "Verifiera, aldrig gissa" gäller den
 * maskinläsbara sidan också.
 */
if (e.lat && e.lng && e.geoSource !== 'osm') {
  jsonLd.geo = { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lng };
}

/**
 * Vilken artikel bandet längst ned visar.
 *
 * Kopplingen är stark på den här sidtypen, alltså väljs artikel och inte den
 * senaste: den som just läst att stället har anmärkningar undrar rimligen vad
 * som händer sedan, och den som läst en ren kontroll har mer nytta av att
 * veta vad kontrollen faktiskt omfattar. Listan är en prioritetsordning;
 * ArtikelBanner faller tillbaka på den senast publicerade artikeln av sig
 * själv om slugen skulle försvinna, och visar ingenting alls så länge
 * artikelsektionen ligger under sin kvalitetströskel.
 */
const artikelval =
  e.verdict === 'minor' || e.verdict === 'major'
    ? ['vad-hander-efter-en-anmarkning', 'sa-laser-du-en-hygienkontroll']
    : ['sa-laser-du-en-hygienkontroll', 'vad-hander-efter-en-anmarkning'];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
    { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(kommun.slug) },
    { '@type': 'ListItem', position: 3, name: e.name },
  ],
};
---

<Base
  title={`Hygienkontroll på ${e.name}, ${kommun.city}`}
  varumarkeITitel={false}
  description={description}
  noindex={!indexable}
  jsonLd={[jsonLd, breadcrumbs]}
  dataUpdated={latest ?? undefined}
>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path(kommun.slug)}>{kommun.city}</a>
    </nav>

    {/* Rubriken och handlingarna på SAMMA rad, inte på var sin.

        De låg på var sin rad med Följ och Dela ute till höger, och eftersom
        raden var tom till vänster blev det ett hål mellan namnet och
        bedömningen. Ägaren: "blir liksom ett stort glapp ner till
        anmärkningen". Knapparna flyttar därför upp bredvid namnet, och
        bedömningen stiger lika mycket som hålet var djupt.

        Kartknappen som fyllde vänsterhalvan är borttagen. Den hoppade till
        kartsektionen längre ned på samma sida, alltså en knapp vars hela
        ärende var att rulla; sektionen står kvar där den står. */}
    <div class="topp">
      <header class="masthead">
        <h1>{e.name}</h1>
        <p class="place text-secondary">
          {[e.types[0], e.address, kommun.city].filter(Boolean).join(' · ')}
          {/* Stadsdelen sist i raden, och bara när den har en egen sida. Den
              binder verksamheten till sitt område i länkgrafen, vilket är
              det som gör områdessidorna nåbara nerifrån och inte bara från
              kommunhubben. Se lib/omraden.ts. */}
          {omrade && (
            <> · <a href={path(kommun.slug, 'omrade', omrade.slug)}>{omrade.name}</a></>
          )}
        </p>

        {/* "Öppet nu" i ögonhöjd, en rad under namnet.

            Den satt förut i rubriken på öppettidsavsnittet, som ligger under
            kartan: uppmätt i 1 200 px på den här sidan 2 460 px ned i
            dokumentet mot rubrikens 127. Ägaren: "borde inte öppet nu/stängt
            nu, sitta typ längre upp vid namnet eller någon och sen hela stor
            widgeten där nere där den är nu." Veckoschemat står kvar.

            Två saker som gör att raden inte kostar något på de sidor som
            saknar tider: villkoret `e.hours` gör att elementet inte finns
            alls på 13 305 av 16 047 sidor, och på de övriga står det tomt och
            `hidden` tills skriptet fyllt i det. Tillståndet får aldrig skrivas
            vid bygget, se OppetPille.astro. */}
        {e.hours && <OppetPille hours={e.hours} />}
      </header>

      {/* Raden bär det som gäller stället i sin helhet; omdömesknappen bor i
          omdömesavsnittet där rutan den öppnar hör hemma, och rättelsen och
          replikrätten står kvar i panelen, se ActionPanel.astro.

          Delningens text är svarsmeningen, som redan är skriven för att vara
          självbärande. */}
      <Handlingsrad
        establishmentId={e.id}
        establishmentName={e.name}
        municipalitySlug={kommun.slug}
        shareText={answer}
      />
    </div>

    <div class="layout">
      <main class="main">
        {/* NOTEN OM REGISTRET STÅR FÖRE BEDÖMNINGEN, och det är en ordning
            och inte en placering.

            docs/35 §5.1 kräver att den ligger "högt på sidan, före
            kontrollhistoriken, eftersom den ändrar hur allt under den ska
            läsas". Före själva bedömningen är en skärpning av det kravet:
            bedömningen är sidans starkaste påstående, och "Inga anmärkningar"
            om ett ställe som kommunen inte längre har registrerat läses fel
            om beskedet om registret kommer efteråt.

            Villkoret är `active === false` och aldrig `!active`. Halva
            beståndet saknar intyg helt, och frånvaro är inte nedläggning. Se
            `avregistrerad` i lib/registrering.ts och docs/35 §5.2. */}
        {avregistrerad(e) && <Avregistrerad e={e} />}

        {/* Bedömningen där booli har priset: en tyst etikett, ett stort
            besked, och svarsmeningen under. Metodiklänken är deras
            "Se Boolis värdering" — vägen till hur talet blev till. */}
        <section class="statement">
          <p class="eyebrow">Bedömning</p>
          <div class="verdict">
            {/* DET ENDA MÄRKET PÅ SAJTEN SOM RÖR SIG.

                `liv` ger en loop som skiljer sig efter bedömning och `blick`
                låter pupillerna följa pekaren när det finns en mus. Båda är
                avstängda i förvalet i FaceMark, och skälet är att den
                komponenten renderas på sextontusen sidor medan den här raden
                är en. Se rörelsekatalogens avsnitt 5. */}
            <FaceMark verdict={e.verdict} size={52} animate liv blick />
            <div class="besked">
              {/* ETT märke, inte två.

                  Här stod "Ren historik" och "Utmärkelsen 2026" som två
                  likadana piller intill varandra. De sade nästan samma sak
                  med olika ord, och tillsammans vägde de tyngre än beskedet
                  de stod bredvid. Ägaren: "kanske vi ska ta bort genomgående
                  rent eller ngt o bara kör utmärkelse".

                  Utmärkelsen är den som får stå. Den är svårare att få, den
                  har ett årtal, och den har en egen sida att peka på. "Ren
                  historik" räknades vid varje bygge ur samma serie kontroller
                  som utmärkelsen redan vilar på, alltså sade den inget som
                  inte redan stod bredvid. Fältet `e.distinction` finns kvar i
                  datan och används av kartan och listorna.

                  Stjärnan framför "Ren historik" försvinner med den. Sajten
                  har tagit beslutet att stjärnor inte används, eftersom de
                  läser som betyg, och det är samma skäl som gör att omdömen
                  inte har stjärnbetyg (se Reviews.astro). */}
              <p class="level">
                {presentation.label}
                <InfoTip label="den här bedömningen" text={bedomningTips} />
              </p>
              {/* Grunden flyttad från stycket till ett tips på etiketten, och
                  tipset är sedan utvidgat till hela svaret på "vad betyder det
                  här?". Se `bedomningTips` ovan för grenarna och talen.

                  Meningen löd en gång "Bedömningen vilar på 9 kontroller som
                  Stockholms stad publicerat på Åkeshovs Gårdsväg 11 sedan
                  2019." och stod i stycket. Ägaren: "detta kan vara i en
                  i-ikon eller något, det blir för långt."

                  Den låg i stycket för att ge Google riktig prosa att bygga
                  sitt utdrag av, i stället för att låta sökmotorn plocka text
                  ur jämförelserutan. Priset för flytten är alltså känt: tipsets
                  text bär `data-nosnippet`, så meningen räknas inte längre som
                  utdragsmaterial. Det är rätt pris här: ett verktygstips är
                  skrivet för den som redan står på sidan, se InfoTip.astro, och
                  ett sökutdrag byggt ur en förklaring av metoden är precis fel
                  text att möta någon med som ännu inte klickat.

                  Tipset renderas nu på ALLA sidor och inte bara där `grund`
                  finns. På de 1 565 sidor som saknar publicerad kontroll är
                  frågan "vad betyder det här?" som mest berättigad, eftersom
                  beskedet där är att vi avstår från att bedöma.

                  Blir utdraget dåligt igen är rätt åtgärd att korta meningen
                  och sätta tillbaka den i stycket, inte att ta bort tipset. */}
              <p class="answer">{answer}</p>
            </div>
            {/* Utmärkelsens sigill, ute till höger på bedömningsraden. Som
                piller i rubriken syntes det knappt; som låda under
                nyckeltalen låg det i vägen. Här har det plats att vara ett
                sigill utan att skjuta ned något.

                MATSNUSKMÄRKET STOD FÖRUT PÅ SAMMA PLATS OCH ÄR BORTA, på
                ägarens beslut 2026-08-22: "ta bort matsnusk märket helt, vill
                inte köra det." Det gick att dela platsen eftersom de två
                aldrig kunde gälla samtidigt, en utmärkelse kräver ren historik
                och matsnusk kvarstående brister, men nu bär raden bara den
                ena. Komponenten, ritningen och det importerade märket är
                borttagna, inte utkommenterade. Se docs/24_maskotprogram.md.

                MatsnuskLISTAN lever kvar, se lib/matsnusk.ts och
                [kommun]/matsnusk.astro. Det var märket ägaren ville bort. */}
            <AwardNote establishment={e} />
          </div>
          {/* Här stod grunden för matsnuskmärket, alltså meningen som förklarade
              vad som konstaterats. Den fanns bara för märkets skull: ett sigill
              utan förklaring intill är en anklagelse utan grund. Utan märket
              säger den ingenting som inte redan står i svarsmeningen ovanför,
              som på en sida med kvarstående brister lyder till exempel "fick
              anmärkningar vid kommunens återbesök den 25 juni 2026". Två
              meningar i rad om samma sak är precis det ägaren kallade
              överförklarat.

              Meningen citeras med "till exempel" sedan 2026-09-05, för den
              är inte längre en konstant: den väljs ur grunden för skärpningen
              och har tre lydelser. Se lib/omdome.ts. */}
          <p class="method caption">
            <a href="/metodik/">Så sätts bedömningen</a>
          </p>
        </section>

        {/* VÅRA EGNA BILDER, DIREKT UNDER BEDÖMNINGEN OCH ALDRIG OVANFÖR.

            Ägaren 2026-08-27 om ednia.se och yelp.se: "vill vi visa bilderna
            lite mer... så länge vår bedömning fortfarande är tydlig."

            Placeringen är mätt fram och inte tyckt. Ednia lägger sin mosaik
            högst upp på sidan och betalar med att deras eget nyckeltal hamnar
            på y 862 i ett fönster som är 900 högt. Tripadvisor lägger beskedet
            över bilden på båda bredder, Yelp gör det på mobil och lägger det
            ovanpå bilden på dator. Två av tre förlagor gör alltså redan det
            som villkoret kräver.

            Som SYSKON EFTER `.statement` flyttar sig bedömningsraden noll
            pixlar vid varje bredd, eftersom den ligger ovanför bandet, och
            bilderna är ändå det andra ögat möter. Det är precis Yelps
            mobilordning: namn, besked, sedan bilder.

            Avsnittet finns inte alls på de sidor som saknar minst två egna
            Avsnittet finns inte alls på de sidor som saknar bild, alltså på
            15 678 av 16 044. Vilka bilder som får visas och vilken
            attribution var och en bär avgörs i Bildband.astro. */}
        <Bildband images={e.images} name={e.name} />

        {/* Datumet bedömningen vilar på, som ett kalenderblad. PAUSAD av
            ägaren: komponenten renderar ingenting, och flaggan som styr det
            bor i Kontrolldatum.astro tillsammans med skälet. Anropet står
            kvar så att beslutet ligger på ett ställe. */}
        {latestInspection && (
          <Kontrolldatum inspection={latestInspection} href="#kontrollhistorik" />
        )}

        {/* Nyckelfakta i öppen rad direkt under beskedet, som Boolis
            Boarea · Rum · Byggår under priset. Förbehållen bor i tipsen. */}
        <FactGrid facts={facts} />

        {/* Raden i följd, direkt under den andel den kvalificerar. Se
            `renRad` ovan för villkoren och för de 3 375 sidorna. */}
        {visaRenRad && (
          <p class="ren-rad caption text-secondary">
            De {formatNumber(renRad)} senaste av {formatNumber(stats.total)} kontrollerna
            {' '}{plats} var utan anmärkning.
          </p>
        )}

        {/* Jämförelsen står vid nyckeltalen och inte i handlingsraden.
            Handlingsraden är låst vid två knappar av dokumenterade skäl, se
            Handlingsrad.astro, och talen här ÄR det jämförelsen ställer
            bredvid varandra: kontroller, andel utan anmärkning, återbesök.
            En knapp hör hemma där dess verkan sker.

            Länk och inte knapp: utan JavaScript leder den till /jamfor/ med
            det här stället ifyllt, och väljaren där gör samma sak i två steg.
            Med JavaScript öppnas rutan i stället. Ingen knapp kan bli död. */}
        {compareWith.length > 0 && (
          /* EN rad, inte fyra.
             Introduktionen var ett eget stycke ovanför knappen: etikett,
             rubrik och två rader text, alltså fyra rader för att presentera
             en knapp på en. Ägaren: "jämför grejen och hela nytt grejen tar
             upp för mkt plats".
             Etiketten sitter nu PÅ knappen. Det är också vad Booli gör i
             förlagan han skickade: deras "Nytt!" står inline med rubriken,
             inte staplat ovanför den. Etiketten försvinner av sig själv, se
             JAMFOR_NYHET_SYNS i lib/jamfor.ts, och kvar blir en vanlig knapp.

             Introduktionen står här och inte på startsidan. Där hade den
             blivit reklam för oss själva; här står den intill det den
             jämför, hos någon som just läst ett besked. */
          <p class="jamfor-rad">
            <a class="jamfor-knapp" data-jamfor href={compareHref(kommun.slug, e.slug)}>
              {JAMFOR_NYHET_SYNS && <span class="jamfor-nytt">Nytt!</span>}
              Jämför med ett annat ställe
            </a>
          </p>
        )}

        {/* Här stod BÅDA märkena en gång, som var sitt inramade fält.
            Utmärkelsen flyttade upp till bedömningsraden först, se
            AwardNote.astro, och matsnusk lämnades kvar med skälet att den är
            ett påstående och inte ett erkännande och därför behöver sin plats
            i berättelsen.

            Det höll inte. Ägaren: "det ska ju vara som ett märke som
            utmärkelsen, eller?". Ett påstående som får ett eget avsnitt med
            rubrik långt ned på sidan väger TYNGRE än ett erkännande som står
            som ett sigill vid beskedet, inte lättare, och att behandla den
            hårdare av de två mer omständligt är fel ordning. Båda står nu på
            bedömningsraden, och grunden står under den. */}

        {latestInspection && latestInspection.areas.length > 0 && (
          <ControlBreakdown
            areas={latestInspection.areas}
            inspectedAt={formatDate(latestInspection.date)}
          />
        )}

        {/* Efter vad kontrollen visade, före vad som återkommer: sidan läses
            som en berättelse i tid. Vad hittades, blev det åtgärdat, och
            händer det om och om igen. */}
        <FollowUp followUp={uppfoljning} kommun={kommun.name} latest={latest} />

        <RecurringIssues issues={recurring} />

        {/* Kontrollserien i löpande text, som ingång till tidslinjen.

            Blocket är sidans svar på `docs/51_klickdjupet.md` §9.4: höj det
            EGNA innehållet i stället för att skriva mer. Fyra meningar byggda
            av kontrollernas datum, antal, former och anmälan, alltså av
            uppgifter som redan står på sidan som etiketter i en lista men
            aldrig som prosa. Median 232 tecken, och 1 574 poster utan
            publicerad kontroll får ingenting alls. Villkoren och nämnarna står
            i Kontrollserien.astro.

            `plats` skickas in och byggs inte där, så adressledet har en enda
            definition på sidan: samma sträng står i tipset vid bedömningen. */}
        <InspectionHistory inspections={e.inspections}>
          <Kontrollserien inspections={e.inspections} kommun={kommun.name} plats={plats} />
        </InspectionHistory>

        {/* Kartan som egen sektion i huvudkolumnen med adressen under, som
            hos booli. Efter historiken: den hör till fakta om stället men
            ska inte klyva kontrollberättelsen. Verksamheter utan koordinat
            får ingen kartsektion alls. */}
        {hasCoords && (
          <Platskarta
            lat={e.lat!}
            lng={e.lng!}
            name={e.name}
            verdict={e.verdict}
            geoSource={e.geoSource}
            address={e.address}
            city={kommun.city}
          />
        )}

        {/* "Ta dig hit" mellan kartan och öppettiderna, och ordningen är ett
            påstående: kartan svarar på VAR, det här avsnittet på HUR jag tar
            mig dit, öppettiderna på NÄR jag kan komma. Alla tre är dessutom
            härledda av oss ur OpenStreetMap i stället för hämtade ur kommunens
            register, så de hör ihop både för läsaren och i fråga om vad de är.

            Knappen "Beräkna restid" står här och inte i kartans nedre högra
            hörn som hos Ednia, eftersom det hörnet redan bär MapLibres
            upphovsrad. Vad som krävs för att flytta in den står i
            TaMigHit.astro och i docs/38_ta_mig_hit.md §7.

            Avsnittet ritas så snart vi har en koordinat, för knappen behöver
            inget mer än så. Hållplats- och parkeringsraderna finns bara på de
            sidor där uttaget gav något, och aldrig som en rad om att vi inte
            vet.

            `checkedAt` skickas inte längre hit. Datumet för närhetsuttaget
            hörde till avsnittets egen upphovsruta, och attributionen ligger
            numera i källfoten längst ned; det är Sidupphov som får fältet. */}
        {hasCoords && (
          <TaMigHit
            lat={e.lat!}
            lng={e.lng!}
            stop={e.stop}
            parking={e.parking}
          />
        )}

        {/* Öppettiderna står direkt under kartan, och det är ingen slump.

            De två avsnitten svarar på samma sorts fråga, var ligger det och
            när är det öppet, och båda är HÄRLEDDA av oss ur OpenStreetMap i
            stället för hämtade ur kommunens register. De hör alltså ihop både
            för läsaren och i fråga om vad de är.

            Ovanför kontrollberättelsen får de inte stå: en öppettid som
            hamnar mellan bedömningen och vad kontrollen visade läses som en
            del av beskedet, och den kommer inte från kommunen.

            Avsnittet finns inte alls på de sidor där vi saknar tider, och det
            är de allra flesta. Se docs/33_oppettider.md för nämnaren. */}
        {e.hours && <Oppettider hours={e.hours} name={e.name} />}

        {/*
          Verksamhetens egna uppgifter står EFTER hela kontrollberättelsen.

          Ordningen är ett påstående, samma som gäller bilder och omdömen: det
          kommunen funnit först, det verksamheten själv säger sedan. En
          presentation som stod ovanför bedömningen hade läst som en ingress
          till den, och det är precis vad den aldrig får vara.

          Tomt i HTML-filen och fyllt i webbläsaren. Avsnittet syns inte alls
          på de sidor där ingen skickat in något, alltså på nästan alla. Se
          Foretagsuppgifter.astro.
        */}
        <Foretagsuppgifter establishmentId={e.id} />

        {/*
          Verksamhetens egna bilder, direkt efter dess egna uppgifter och före
          gästernas bilder. De två bildavsnitten delar varken tabell eller kod;
          se Foretagsbilder.astro.
        */}
        <Foretagsbilder establishmentId={e.id} establishmentName={e.name} />

        {/*
          Bilderna står FÖRE omdömena och efter kartan.

          De hör till stället och inte till ett enskilt omdöme, alltså hör de
          hemma bland det som beskriver stället. Att de ändå ligger nedanför
          kontrollberättelsen följer samma ordning som resten av sidan: det vi
          själva räknat fram först, det besökarna bidragit med sedan.

          Tomt i HTML-filen och fyllt i webbläsaren, precis som omdömena, och
          avsnittet syns inte alls på de allra flesta sidor. Se Bilder.astro.
        */}
        <Bilder establishmentId={e.id} establishmentName={e.name} />

        {/*
          Omdömen ligger SIST i huvudkolumnen, efter allt som bygger på
          kommunens data och före källhänvisningen. Ordningen är ett
          påstående: kontrollen först, åsikterna sedan, och aldrig blandade.
          Avsnittet är tomt i HTML-filen och fylls i webbläsaren, så inget en
          besökare skrivit kommer in i ett bygge. Se Reviews.astro.
        */}
        <Reviews
          establishmentId={e.id}
          establishmentName={e.name}
          municipalitySlug={kommun.slug}
        />

      </main>

      <aside class="side">
        {/* Kontaktkortet ÖVERST i spalten, före "Något som inte stämmer?".

            Högerspalten är "det man gör" och huvudkolumnen är
            kontrollberättelsen. Telefon, webbplats och e-post är saker man
            agerar på och inte delar av bedömningen, alltså hör de hemma här
            och inte inklämda i berättelsen. Kortet stod först under
            öppettiderna i huvudkolumnen, och det var fel av just det skälet.

            "ÖPPET NU" FLYTTAR INTE HIT, och det är viktigt. Det står vid
            verksamhetens namn efter att ha mätts till 2 333 px från rubriken
            i sitt förra läge. På mobil kollapsar den här spalten till BOTTEN,
            efter hela huvudkolumnen, så ett klockslag här hade hamnat längre
            bort än det låg innan det flyttades. Och "öppet nu" avgör om man
            går dit över huvud taget, vilket är ett beslut man fattar när man
            läser namnet; kontakten är nästa steg.

            Villkoret är dubbelt med flit. `e.contact` finns på 3 274 sidor,
            men ett kort utan en enda utskrivbar rad hade ändå blivit en tom
            vit ruta i spalten, och `harNagot` är det som utesluter det. */}
        {e.contact && harNagot(e.contact) && (
          <div class="panel" data-kontakt-panel>
            <Kontaktuppgifter contact={e.contact} name={e.name} />
          </div>
        )}

        {/* Panelen börjar numera med handlingsrutan och inte med en bild.

            Bilden låg här fram till 2026-08-27, ritad av Commonsbild.astro
            eller StreetPhoto.astro. Båda är borta: bandet under bedömningen
            ritar varje bild, med samma attribution, och en verksamhet ska inte
            se olika ut beroende på hur många foton den råkar ha. Se
            Bildband.astro.

            Vad flytten gav, uppmätt vid 1440: bilden gick från panelens
            smala figur till 680 px bred i huvudkolumnen, alltså samma yta som
            ett band med tolv bilder får. Bildrutan mäter 680x227 på
            Restaurant Frantzén med sin enda Commons-bild och 680x227 på Holy
            Smoke med sina tolv, vid samma x och samma y. Panelen på Frantzén
            är 1 671 px hög efter flytten. */}
        <div class="panel">
          <ActionPanel
            establishmentId={e.id}
            establishmentName={e.name}
            municipalitySlug={kommun.slug}
          />
        </div>

        {/* Vägen till kommunens egna anmälningsformulär, UNDER "Något som inte
            stämmer?" och inte i handlingsraden.

            Handlingsraden är två knappar bred av princip och vetter mot den
            som vill följa eller dela. Regeln där är att en knapp hör hemma där
            dess verkan sker; verkan sker här utanför sajten, alltså har rutan
            ingen sektion att höra till, och då är sidopanelen rätt plats.
            Samma resonemang som redan gäller bevakningen, se Handlingsrad.astro.

            Villkoret är att kommunen har minst en fungerande väg. Elva av tolv
            har det; den tolfte skulle få en tom ram om vi satte ut panelen
            ändå. Vilken väg det blir avgörs i lib/anmalan.ts. */}
        {anmalningsvagarna.length > 0 && (
          <div class="panel">
            <Anmal vagar={anmalningsvagarna} />
          </div>
        )}

        {/* FÖRETAGET STÅR EFTER HANDLINGARNA OCH FÖRE VÄGARNA VIDARE.

            Rutan låg först direkt under kontaktkortet, med argumentet att båda
            svarar på frågan vem är det här. Ägaren 2026-08-27: "vet inte om
            'företaget' rutan i höger spalten ska vara längst upp, känns mer som
            ngt längre ner, iaf spontant."

            Han har rätt, och regeln som gör honom rätt är att panelen bär TVÅ
            sorters innehåll. HANDLINGAR är att ringa, gå till webbplatsen,
            rätta en uppgift, begära replik, anmäla till kommunen och följa
            stället. UPPSLAGSDATA är organisationsnummer, vem som driver stället
            och när det registrerades. Ingen kom hit för att slå upp ett
            organisationsnummer, men den som gör det hittar det var det än står;
            en handling tappar man däremot om den ligger för långt ned.

            VARFÖR FÖRE "NÄRA DIG" OCH INTE SIST. De tre panelerna längst ned,
            Nära dig, Bäst i närheten och Så ser det ut i kommunen, leder BORT
            från den här verksamheten. Företaget handlar fortfarande om den.
            Panelen läses därför i tre band uppifrån och ned: handlingar,
            uppslag om det här stället, vägar vidare till andra.

            Uppmätt på Wirströms Pub vid 1440, som då hade alla sju rutorna:
            rutan gick från plats två (y 554) till plats fyra (y 1 161), och
            panelens totala höjd var oförändrad 2 207 px. Ingenting som är en
            handling sköts ned: kontaktkortet, "Något som inte stämmer?" och
            "Anmäl till kommunen" låg alla kvar ovanför.

            Bildrutan i panelen är sedan dess borttagen, se rutan ovanför, så
            panelen är numera sex rutor och Företaget hamnar högre än 1 161.
            Ordningen mellan de sex är oförändrad.

            REGISTRERINGSDATUMET STANNAR HÄR, och det var en verklig fråga.
            "Registrerad" är den enda raden som säger något om hur länge stället
            funnits, och kontrollhistoriken bär redan ett tips om att "Äldsta
            kontroll" INTE är året verksamheten startade. Frestelsen är att
            flytta datumet dit.

            Det vore fel, för de två talar om olika saker. Kontrollerna är
            registrerade på ANLÄGGNINGEN och följer lokalen genom varje
            ägarbyte, se `establishment_names` i pipeline/schema.sql.
            Registreringen är gjord av LIVSMEDELSFÖRETAGAREN och börjar om när
            en ny tar över. Ett datum från operatören lagt intill anläggningens
            historik hade lästs som "då öppnade stället", vilket är precis den
            felläsning tipset finns för att hindra. Här, bland företagets egna
            uppgifter, läser samma datum som det administrativa faktum det är.

            Panelen ritas bara där kommunen lämnar uppgiften. Fältet finns i
            dag på Stockholms 8 520 rader och på ingen annan kommun, alltså
            saknas den på drygt sju tusen sidor, och där syns ingenting alls.
            Vad panelen visar och vad den medvetet utelämnar står i
            Foretagsregister.astro.

            Villkoret är dubbelt av samma skäl som kontaktkortets: en rad kan
            bära `registration` utan att en enda av de fyra raderna går att
            skriva, och då hade panelen blivit en tom vit ruta med bara en
            rubrik. `registerrader` är det som utesluter det. */}
        {e.registration && registerrader(e.registration, e.name).length > 0 && (
          <div class="panel">
            <Foretagsregister registration={e.registration} name={e.name} />
          </div>
        )}

        {/* `data-nosnippet`: panelen är en väg vidare, inte sidans svar.
            Listan är namn och avstånd till andra ställen, och i ett sökresultat
            för DEN HÄR verksamheten säger den ingenting. Google byggde ett
            sådant utdrag för The Coffice Albano, om än ur jämförelserutan, se
            JamforRuta.astro. Attributet påverkar bara utdraget: sidan
            indexeras som förut och länkarna räknas som förut. */}
        {neighbours.length > 0 && (
          <div class="panel" data-nosnippet>
            <h2 class="panel-title">
              {/* "Nära dig" och inte längre "Närliggande". Panelen har fått en
                  systerpanel under sig, och två rubriker som båda är adjektiv
                  om närhet går inte att skilja åt på en blick. Nu säger den ena
                  vad den sorterar på och den andra vad den väljer ut. */}
              Nära dig
              <InfoTip
                label="nära dig"
                text="De fyra närmaste verksamheterna med en bedömning, sorterade efter avstånd. Alla bedömningar förekommer i listan, eftersom den svarar på vad som ligger närmast och ingenting annat."
              />
            </h2>
            <ul class="near">
              {neighbours.map((n) => (
                <li>
                  <a href={path(kommun.slug, n.slug)}>
                    <FaceMark verdict={n.verdict} size={30} variant="round" />
                    <span class="near-info">
                      <b>{n.name}</b>
                      <span class="text-muted">{distanceLabel(n.metres, e.address, n.address)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            {/* Jämförelsen hör hemma här och inte i handlingsraden, som är
                låst vid två knappar av dokumenterade skäl. Panelen handlar om
                andra ställen, vilket är precis vad en jämförelse gör.
                Adressen bär kommunen, och det är den som gör jämförelsen
                ärlig: se lib/jamfor.ts. */}
            <p class="near-foot caption">
              <a data-jamfor href={compareHref(kommun.slug, e.slug)}>Jämför med ett annat ställe</a>
            </p>
          </div>
        )}

        {/* Systerlistan, sorterad på bedömning i stället för på avstånd.

            `data-nosnippet` av samma skäl som panelen ovanför, och här väger
            det tyngre: ett sökutdrag för DEN HÄR verksamheten som består av
            fyra ANDRA verksamheters namn under rubriken "Bäst i närheten"
            hade läst som att den man sökte på inte är bland dem.

            Underraden bär antalet kontroller och avståndet, alltså BÅDA
            nycklarna ordningen avgörs på och inga andra. En läsare som undrar
            varför ett ställe 496 meter bort står före ett på 140 läser svaret
            rakt ur raden. Bedömningen står inte i text eftersom den är
            densamma för alla fyra, och märket säger den redan.

            Att listan har två nycklar och inte tre är ett beslut med ett mätt
            skäl, se bestNearby i lib/data.ts. */}
        {basta.length > 0 && (
          <div class="panel" data-nosnippet>
            <h2 class="panel-title">
              Bäst i närheten
              {/* Tipset är kortat från fyra meningar till två, och skälet är
                  mätt i docs/53_egen_text_per_sida.md.

                  Meningarna som gick bort var "Båda talen står på varje rad, så
                  ordningen går att pröva" och "Listan visar bara de utan
                  anmärkningar, och vi publicerar aldrig den omvända". Den
                  första är meta om meningen före den: raden VISAR båda talen,
                  och att beskriva att den gör det säger inget en läsare inte
                  ser. Den andra är ett löfte om vad Prikko aldrig gör, alltså
                  policy och inte en förklaring av listan, och den står nu i
                  "Vad vi inte gör" på /metodik/ i stället. Att listan bara
                  innehåller ställen utan anmärkningar står kvar i första
                  meningen här, så inget en läsare behöver har försvunnit.

                  Kostnaden var 133 tecken ordagrant lika på de 78 procent av
                  verksamhetssidorna som bär panelen, alltså omkring 104 tecken
                  per sida i medel. Det är två procent av sidans brödtext, och
                  det ska läsas som det lilla det är: nästan all boilerplate på
                  sidan är sådan som måste stå kvar. */}
              <InfoTip
                label="bäst i närheten"
                text={`Verksamheter inom ${BEST_NEARBY_M} meter som fick inga anmärkningar vid sin senaste kontroll. Flest kontroller bakom bedömningen står först, och vid lika många den närmaste.`}
              />
            </h2>

            {/* Nämnaren FÖRE listan, av samma skäl som på kommunsidan: fyra
                rader ur en mängd på medianvis 39 är ett urval, och en läsare
                som inte får veta nämnaren tror att fyra är alla. Ordagrant
                samma hållning som leden i RenHistorik.astro.

                Meningen är ett tal om KVARTERET och inte om verksamheten
                sidan handlar om. Den är varken räknad i det eller ställd mot
                det, och den lyder likadant på varje sida i samma kvarter
                oavsett vilken bedömning sidan bär. Det är skillnaden mellan
                den här meningen och en jämförelse mot grannarnas median, som
                inte får byggas: en sådan hade behövt utebli på sidorna under
                medianen, och då blir frånvaron själva omdömet. */}
            <p class="near-lede caption text-secondary">
              {bastaResultat.total === 1
                ? `En verksamhet inom ${BEST_NEARBY_M} meter fick inga anmärkningar vid sin senaste kontroll.`
                : `${formatNumber(bastaResultat.total)} verksamheter inom ${BEST_NEARBY_M} meter fick inga anmärkningar vid sin senaste kontroll.`}
            </p>

            <ul class="near">
              {basta.map((n) => (
                <li>
                  <a href={path(kommun.slug, n.slug)}>
                    <FaceMark verdict={n.verdict} size={30} variant="round" />
                    <span class="near-info">
                      <b>{n.name}</b>
                      <span class="text-muted">
                        {n.controls === 1
                          ? '1 kontroll'
                          : `${formatNumber(n.controls)} kontroller`} · {distanceLabel(n.metres, e.address, n.address)}
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="panel">
          <h2 class="panel-title">Så ser det ut i {kommun.city}</h2>
          {dist.length > 0 && (
            <>
              {/* Talet först, bandet under, teckenförklaringen sist.

                  Rutan ritade förut sin egen statistikform: ett tal i --fs-h-s
                  över en caption, en 8 px linje och tre täta rader med prick,
                  tal och etikett. Ägaren tyckte den var ful, och den var
                  dessutom sajtens tredje sätt att teckna samma sak. Nu står
                  bandet och teckenförklaringen i den form kommunhubben fick
                  och ägaren godkände, och talet i bandets egen nyckeltalsform.

                  Talet får vara stort här, tvärtemot vad som stod i filen
                  förut. Skälet till 21 px var att en panel i en aside inte ska
                  ha något hjältetal, men 21 px över en caption på 13 var
                  varken tal eller etikett. Nyckeltal.astro håller Ednias och
                  Stripes förhållande, 32 över 14 med åtta pixlar emellan, och
                  det läser som ett nyckeltal utan att tävla med sidans egen
                  rubrik, som står i en annan spalt.

                  Staden står i panelrubriken och därför inte i etiketten. Ett
                  ortsnamn två gånger på samma tre rader är brus. */}
              <Nyckeltal
                kompakt
                tal={[{
                  value: `${kommunSummary.cleanShare} %`,
                  label: `utan anmärkningar av ${formatNumber(kommunSummary.assessed)} bedömda`,
                }]}
              />

              {/* 118 px och inte förvalets 150: panelen är 300 px bred med
                  16 px padding, och med 150 hade de tre mängderna fått var sin
                  spalt under varandra i stället för att stå två och två. */}
              <Fordelning delar={dist} label={distLabel} min="118px" kompakt />
            </>
          )}
          <ul class="kommun-links">
            <li><a href={path(kommun.slug)}>Alla hygienkontroller i {kommun.city}</a></li>
            {ownCategories.map((s) => (
              <li>
                {/* `short` och inte `plural`: Övrigts plural är "verksamheter",
                    och "Alla verksamheter i Uppsala" läses som hela kommunen —
                    alltså samma sak som länken raden ovanför. */}
                <a href={path(kommun.slug, 'kategori', s.category.slug)}>
                  Alla {s.category.short} i {kommun.city}
                </a>
              </li>
            ))}
            {kedja && (
              <li>
                <a href={path('kedja', kedja.id)}>
                  Alla {formatNumber(kedja.total)} {kedja.name}
                </a>
              </li>
            )}
          </ul>
        </div>
      </aside>
    </div>

    {/* KÄLLFOTEN, OCH VARFÖR DEN LIGGER UTANFÖR SPALTERNA
        ───────────────────────────────────────────────────────────────────────
        Två rader: när kommunens uppgifter senast hämtades, och vilka fält på
        sidan som kommer ur OpenStreetMap. Källa och metodik är fullständiga på
        /kallor och /metodik, länkade i sidfoten på varje sida.

        Foten stod tidigare SIST I HUVUDKOLUMNEN. Den flyttade ut hit när
        upphovet blev ett per sida i stället för ett per avsnitt, och skälet är
        mätt: i 390 px kollapsar spalterna till en enda, och huvudkolumnen tar
        slut på y 3 356 medan kontaktkortet ur OpenStreetMap börjar på y 3 404.
        En källfot inne i huvudkolumnen hade alltså stått 48 px OVANFÖR en av
        de uppgifter den redovisar, med ytterligare 1 400 px panel under sig.

        Utanför `.layout` ligger den efter BÅDA spalterna i båda lägena, vilket
        är vad en fotnot om hela sidan ska göra. Samma skäl som bandet nedanför
        har för att ligga här: det som gäller hela sidan börjar där de två
        spalterna tar slut. */}
    <footer class="source">
      <p class="caption text-muted">
        Uppdaterat {formatDate(source.fetchedAt.slice(0, 10))}.
      </p>
      <Sidupphov
        hours={e.hours}
        contact={e.contact}
        stop={e.stop}
        parking={e.parking}
        geoSource={e.geoSource}
        lat={e.lat}
        lng={e.lng}
        narhetCheckedAt={e.narhetCheckedAt}
      />
    </footer>

    {/* Längst ned, efter allt man kom för. Bandet ligger utanför .layout och
        kan därför aldrig skjuta ned bedömningen eller kontrollhistoriken; det
        börjar där de två spalterna tar slut. */}
    <ArtikelBanner prefer={artikelval} />
  </div>

  {/* Rutan ligger sist och utanför spalterna. Den lyfts av showModal() och
      syns aldrig förrän någon ber om den. */}
  {compareWith.length > 0 && (
    <JamforRuta
      establishment={e}
      kommunSlug={kommun.slug}
      city={kommun.city}
      suggestions={compareWith}
      metres={compareMetres}
    />
  )}
</Base>

<script>
  /**
   * Länkarna till jämförelsen öppnar rutan i stället för att lämna sidan.
   *
   * Båda ingångarna, den vid nyckeltalen och den i närliggande-panelen, bär
   * `data-jamfor` och är riktiga länkar till /jamfor/ med det här stället
   * ifyllt. Går skriptet inte fram leder de dit de säger.
   *
   * Modifierade klick lämnas i fred: den som cmd-klickar vill ha en ny flik,
   * och en ruta i den här fliken är inte det hen bad om.
   */
  import { openCompareDialog } from '../../lib/jamfor-dialog';

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-jamfor]')) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return;
      }
      if (openCompareDialog(link)) event.preventDefault();
    });
  }
</script>

<style>
  /* SIDAN ÄR LIKA BRED SOM RESTEN AV SAJTEN, OCH PANELEN TAR SLACKEN.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22, i tur och ordning: "titeln är rätt men bodyn har typ
     petats in från vänster till höger ojämnt", och sedan "verksamhetsidorna
     är ju ej stretchade lika brett som resten, varför tog du bort det?"

     Två krav som krockar så länge panelen är fast. Full bredd betyder att
     något måste fylla 1 304 px. Rak kant betyder att brödtexten inte får
     göra det: en rad mättes till 836 px i det första försöket, alltså
     omkring 119 tecken, mot läsbara 45 till 75.

     Det som ger är PANELEN. Huvudkolumnen står kvar på --w-read och panelen
     går från fasta 300 till `1fr`, alltså 576 vid 1440. Då gäller båda
     kraven: behållaren är --w-wide precis som startsidan och kommunsidan,
     varje block börjar på samma pixel och slutar på samma pixel, och
     brödtexten håller sitt läsmått.

     Ägarens val 2026-08-22 mellan fyra alternativ, där de tre andra var
     bred kolumn med kapade stycken (den ojämna kanten han redan sagt ifrån
     om), behålla 1 028, och vänsterställa i 1 400 med tom yta till höger. */
  /* EGET TAK PÅ VERKSAMHETSSIDAN, och bara det taket skiljer den från resten.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-24: först "allt ska vara samma tror jag", sedan "jag är
     fine med att vi har ett breddtak på restaurangsidan kanske, men liksom
     bara på stora skärmar i guess."

     Det andra är precis rätt avvägning, och skälet är att den här sidan är
     TVÅ SPALTER med brödtexten låst till --w-read. Ett rutnät blir bättre av
     mer bredd, det får fler eller större kort. En lässida blir det inte: hela
     tillskottet hamnar i gluggen mellan text och panel. Uppmätt vid 1800:
     gluggen växte till 644 px, alltså mer än brödtextens egen bredd, och två
     spalter med ett halvt kvarter emellan läser som två sidor.

     `min()` och inte en brytpunkt: sidan följer --w-wide hela vägen upp till
     1480 och stannar där. Under det taket är den alltså EXAKT lika bred som
     startsidan och kommunsidan, vilket var ägarens första önskemål, och det
     är bara på stora skärmar den skiljer sig, vilket var hans andra.

     1480 är räknat: 680 brödtext plus 480 panel plus 48 glugg är 1208, plus
     2 × 48 px gutter blir 1304, och 176 px kvar som glugg lägger panelen på
     behagligt avstånd utan att spalterna tappar varandra. */
  .page {
    max-width: min(var(--w-wide), 1480px);
    padding-block: var(--s-6) var(--s-16);
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  /* Namnet till vänster, Följ och Dela till höger, botten mot botten. Bryts
     till två rader först när namnet inte längre får plats bredvid dem. */
  .topp {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    flex-wrap: wrap;
  }

  .masthead h1 {
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: -.024em;
  }

  .place {
    margin-top: var(--s-1);
    font-size: var(--fs-body-s);
  }

  /* HUVUDKOLUMNENS LÖPTEXT ÄR ALDRIG BREDARE ÄN --w-read.
     ────────────────────────────────────────────────────────────────────────
     Regeln kom till 2026-08-22, när `--w-wide` gick från 1080 till 1400 på
     ägarens beslut. Sidan är byggd som en fluid huvudkolumn plus en fast
     300 px panel, så hela breddningen landade i löptexten: meningen "1
     avvikelse noterades vid kontrollen den 18 maj 2018" mättes till 836 px,
     alltså omkring 119 tecken per rad. Läsbart spann är 45 till 75, och
     docs/19_formsystem.md säger att brödtext aldrig går bredare än --w-read.

     Regeln träffar STYCKEN och listor, inte rutnät, diagram, tidslinjer
     eller tabeller. De ska fortsätta använda hela kolumnen, och det är
     själva vinsten med den bredare sidan: siffrorna får plats, texten
     behåller sitt mått. */
  /* REGELN ÄR BORTA, OCH DET ÄR POÄNGEN.
     Att kapa styckena till 680 medan kolumnen stod på 760 gav precis den
     ojämna vänsterkant ägaren såg 2026-08-22: "titeln är rätt men bodyn har
     typ petats in från vänster till höger ojämnt." Rubriker, kort och
     tidslinjer gick till 760, styckena stannade på 680, och ögat läste de
     80 px som ett slarvigt indrag som kom och gick nedför sidan.

     Måttet hör hemma på KOLUMNEN, inte på vartannat element i den. Se
     .layout nedan. */

  /* HUVUDKOLUMNEN TAR INTE EMOT HELA BREDDNINGEN.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22: "kontrollhistoriken på restaurangsidorna, blev dom
     inte väldigt stora nu när vi gjorde hemsidan mkt bredare?"

     Jo. Sidan var byggd som en FLYTANDE huvudkolumn plus en fast 300 px
     panel, så när --w-wide gick från 1080 till 1400 landade hela vinsten i
     huvudkolumnen: 732 px blev 956. Uppmätt vid 1440 px fönster.

     Följden var värre än bara bredd. Löptexten är låst till --w-read på 680,
     medan rutnät, karta och tidslinje sträckte sig till 956, alltså en ojämn
     högerkant genom hela sidan.

     Huvudkolumnen får därför ett tak, och taket är --w-read. Ett enda mått
     för hela kolumnen är det som gör kanterna raka: när kolumnen ÄR
     lässpalten behöver inget element inuti den kapas för sig, och rubrik,
     stycke, tidslinje och tabell börjar och slutar på samma två pixlar.
     Överskottet går till panelen, se `.page` ovan, inte till löptexten.

     Det första försöket satte kolumnen på --w-page (760) och kapade bara
     styckena till 680. Det löste bredden och skapade indraget. 680 plus 48
     px glugg plus 300 px panel blir 1028, alltså 52 px smalare än de 1080
     sidan hade före breddningen, och det är rätt håll: docs/19 säger att
     --w-wide bär "rutnät och hubbar", och verksamhetssidan är en LÄSSIDA med
     en sidopanel. Startsidan är skyltytan och behåller sina 1304.

     `justify-content: center` stod här och är BORTA. Den centrerade spalterna
     inne i en behållare som var bredare än de, vilket är precis det som drog
     isär rubriken och brödtexten. Behållaren är numera lika bred som
     spalterna, så det finns ingenting kvar att centrera inuti. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--w-read)) minmax(300px, 1fr);
    /* Överskottet hamnar i GLUGGEN, inte i rutorna. Se `.side` nedan för
       varför panelen inte får bli bredare än den är ritad för. */
    gap: var(--s-12);
    align-items: start;
    /* Luften under topraden bärs här och ingen annanstans. Den satt förut på
       handlingsraden, men när knapparna flyttade upp bredvid namnet blev
       avståndet till "Bedömning" så litet att etiketten läste som en tredje
       rad i metaraden.

       24 och inte 32 sedan 2026-08-27, samma beställning som gav sektionerna
       sina 24. Skälet ovan gäller fortfarande: etiketten "Bedömning" får inte
       läsa som en tredje rad i metaraden. Uppmätt vid 1440 är avståndet från
       metaradens underkant till etikettens överkant 24 px, medan raden över
       den, undertiteln, ligger 4 px under rubriken. Hierarkin står alltså
       kvar med god marginal. */
    margin-top: var(--s-6);
  }

  /* Huvudkolumnen ligger öppet på sidan — ingen kortlåda. Det är Boolis
     grepp: sektionerna skiljs av hårlinjer och luft, och lugnet kommer av
     att ingenting är inramat. Sidopanelens paneler ÄR kort, och kontrasten
     däremellan är det som gör att panelen läser som verktyg.

     24 OCH INTE 32, sedan 2026-08-27. Ägaren: "kan vi ta bort lite whitespace
     här?"

     Måttet är dubbelt och det är lätt att missa: varje sektion får både
     `margin-top` och `padding-top`, så avståndet från en sektions sista rad
     till nästa sektions första var 64 px och inte 32. Uppmätt vid 1440 på
     verksamhetssidan för Holy Smoke låg fem sådana skarvar ovanför
     kontrollhistoriken, alltså 320 px luft innan berättelsen ens började.

     24 plus 24 ger 48, och hårlinjen har fortfarande lika mycket luft på båda
     sidor, vilket är det som gör att den läser som en avdelare och inte som
     en ram. Att i stället ta bort padding och behålla marginalen hade lagt
     linjen tätt intill nästa rubrik och brutit just den symmetrin.

     Effekten uppmätt på samma sida: kontrollhistoriken gick från y 949 till
     848 vid 1440, och från 1116 till 1039 vid 375. Resten av vinsten kommer
     av svarsmeningen och bildbandet, se `.answer` nedan och Bildband.astro. */
  /* :global krävs — Astros scopeade selektorer korsar inte komponentgränser. */
  .main > :global(* + *) {
    margin-top: var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  /* Ingen versalisering här, till skillnad från .eyebrow i tokens.
     Etiketten står över sidans viktigaste besked och läses tillsammans med
     nyckeltalens etiketter strax under, som säger "Kontroller" och
     "Återbesök" i vanlig gemen. VERSALER plus halvfet gjorde att den vägde
     tyngre än beskedet den introducerar, och de två etikettsorterna kändes
     som två olika sajter. */
  .statement .eyebrow {
    margin-bottom: var(--s-3);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  /* Märket i höjd med beskedet, inte mitt i textblocket.
     `center` centrerade det mot hela blocket, alltså mot rubriken PLUS
     svarsmeningen under, och då hamnade märket en bit under den rad det hör
     ihop med. Ägaren såg det direkt. Nu ligger överkanterna i linje och
     märket nudgas ned till rubrikens optiska mitt. */
  .verdict {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .verdict > :global(.face) { margin-top: 2px; }

  .besked { flex: 1 1 auto; }

  /* På telefon får sigillet inte konkurrera med beskedet om bredden, och det
     ska ned på egen rad. Ett `flex-wrap` gör fel sak här: beskedet är brett
     nog att kräva egen rad, så ansiktet blir ensamt kvar på den första.
     Rutnätet håller ihop ansiktet och beskedet och lägger sigillet under.

     ATT DET MÅSTE BRYTA är mätt, inte antaget. Står sigillet kvar till höger
     blir det kvar till textspalten 390 - 2 * 16 - 52 ansikte - 2 * 16 mellanrum
     - 104 märke = 170 px, och vid 320 px bara 100. Rubriken "Inga
     anmärkningar" vill vara 231,5 px och dess längsta obrytbara del mäter
     154 px, alltså skulle rubriken svämma över spalten med 54 px vid 320.
     Ett märke som krymper till 50 px för att få plats är ingen utväg: kransen
     bär ett årtal som ska gå att läsa.

     `:global` krävs på sigillet: det är en komponentrot, och Astros scopeade
     selektorer korsar inte komponentgränser. */
  @media (max-width: 640px) {
    .verdict {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-4);
      row-gap: var(--s-3);
      /* `start` och inte `center`.

         Mätt vid 375 px: beskedet är 112 px högt och märket 52, och med
         `center` hamnade märket 31 px under textens överkant, alltså svävande
         mitt i stycket i stället för bredvid rubriken det hör till.
         Skrivbordsläget några rader upp gör tvärtom, `flex-start` plus två
         pixlars nudge, och de två lägena ska inte säga emot varandra.
         Ägaren: "ser ful ut på mobil, dåligt alignad typ." */
      align-items: start;
    }

    /* Nudgen som gör att märkets optiska mitt möter rubrikens, samma två
       pixlar som skrivbordsläget. Regeln ovanför gäller båda, men den ligger
       före mediefrågan och skulle annars slås ut av `align-items` här. */
    .verdict > :global(.face) { margin-top: 2px; }

    /* Sigillet på huvudkolumnens vänsterlinje, alltså 16 px, och inte i
       textspalten på 84.
       ────────────────────────────────────────────────────────────────────
       Det stod i spalt 2 med skälet att det hör ihop med beskedet och inte
       med ansiktet. Uppmätt vid 390 px blev följden att märkets ruta började
       på 84 medan allt annat i kolumnen börjar på 16: etiketten "Bedömning",
       ansiktet, "Så sätts bedömningen" och varje rubrik längre ned. Kvar blev
       ett 104 px brett märke med 84 px vitt till vänster och 186 px till
       höger, alltså ett element som inte mötte någon linje alls. Ägaren:
       "utmärkelse ser fult ut på mobil, ligger liksom centrerat under, ser
       helt out of place ut."

       Över hela raden och inte i spalt 1: ansiktets spalt är 52 px och
       märket 104, och en spalt får inte breddas av det som lagts under den.

       `justify-self: start` för att rutan ska hugga om ritningen. `display:
       block` i ett rutnät sträcker sig annars över hela raden, uppmätt till
       290 px vid 390 px skärm, och för utmärkelsen blev då 186 px tom yta
       klickbar och tog besökaren till utgåvesidan.

       Ritningens egen tomma marginal rättas där ritningen bor, alltså i
       AwardNote. Väljaren för matsnuskmärket stod här bredvid och är borttagen
       med märket. */
    .verdict > :global(.utmarkelse) {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  .level {
    color: var(--text);
    font-size: var(--fs-h);
    line-height: var(--lh-h);
    letter-spacing: -.02em;
    font-weight: 600;
  }

  /* SVARSMENINGEN KAPAS INTE EN ANDRA GÅNG.
     ────────────────────────────────────────────────────────────────────────
     Här stod `max-width: 56ch`. Ägaren 2026-08-27: "denna text kan väl gå
     längre åt höger utan att brytas: 'Holy Smoke fick anmärkningar vid den
     senaste hygienkontrollen den 23 september 2025.'"

     UPPMÄTT VID 1440 INNAN RADEN TOGS BORT. Huvudkolumnen är 680 px och
     `.besked`, alltså spalten till höger om märket, är 612. Spärren räknade
     56ch på 14 px till 522,14 px. Meningen vill vara 567 px på en rad. Den
     fattades alltså 45 px, medan kolumnen hade 90 px kvar att ge, och andra
     raden bar två ord: "september 2025."

     VARFÖR DET ÄR RÄTT ATT TA BORT DEN OCH INTE BARA HÖJA DEN. Kolumnen ÄR
     redan lässpalten: `.layout` låser huvudkolumnen till --w-read, se
     kommentaren där, och den globala regeln som kapade varje stycke till 680
     inuti en bredare kolumn togs bort 2026-08-22 just för att en andra spärr
     inuti en redan kapad spalt ger en ojämn högerkant. Den här raden var
     samma fel i litet format: `.level` och `.method` gick till 728 medan
     stycket mellan dem stannade på 638.

     LÄSBARHETEN ÄR INTE OFFRAD, den är räknad. 612 px på 14 px Instrument
     Sans blir omkring 68 tecken per rad, och det spann filen själv anger som
     läsbart är 45 till 75. Meningen är dessutom aldrig lång: den är byggd av
     lib/data och är en enda mening om en enda kontroll.

     På telefon binder spärren inte alls. Där är `.besked` 275 px, alltså
     långt under både 522 och 612, och meningen bryter på tre rader oavsett. */
  .answer {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .method {
    margin-top: var(--s-3);
  }

  /* Foten ligger numera utanför `.layout` och får därför inte längre sin luft
     och sin hårlinje ur `.main > * + *`. Måtten är samma som den regeln ger,
     så avståndet till innehållet ovanför är oförändrat.

     Ingen hårlinje däremot. Inne i huvudkolumnen skilde linjen foten från
     föregående sektion, som ligger öppet på sidan. Här skulle samma linje
     löpa tvärs under sidopanelens kort och läsas som en ram runt dem, och
     luften ensam räcker: nästa sak nedanför är artikelbandet, som bär sin
     egen yta. */
  .source {
    margin-top: var(--s-8);
  }

  .source p {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  /* Sidopanel */
  /* PANELEN LÄGGER SINA RUTOR I SPALTER, den stretchar dem inte.
     ────────────────────────────────────────────────────────────────────────
     När panelen växte från 300 till 576 för att fylla sidans bredd blev
     följden mätbar och ful: kartbilden gick från 300 × 160 till 544 × 160,
     alltså kvoten 3,4 och en brevlådremsa, och faktaraden "Uteservering ... Ja"
     fick 544 px mellan etikett och värde. Rutorna är ritade för omkring 300.

     `auto-fit` med ett golv på 260 löser det utan en enda brytpunkt: vid 576
     blir det två spalter à 276, alltså nästan precis måttet rutorna ritades
     för, och vid 300 eller på telefon faller det tillbaka till en spalt.

     Bonus som inte var syftet: panelens höjd halveras från omkring 1 700 till
     900, och `position: sticky` blir därmed meningsfull. En panel som är
     högre än fönstret kan aldrig rullas till slutet när den klistrats. */
  .side {
    position: sticky;
    top: var(--s-4);
    display: grid;
    /* EN SPALT, TILL HÖGER, I SIN RITADE BREDD.
       ──────────────────────────────────────────────────────────────────────
       Ägaren 2026-08-22: "spalten kan ju bara va till höger, i en singel och
       sen bodyn till vänster????"

       Han har rätt, och det var ett läge jag inte hade räknat på. Sidan ska
       vara --w-wide bred, brödtexten --w-read och rutorna sina 300. De tre
       går ihop så snart överskottet läggs i GLUGGEN mellan spalterna i
       stället för i rutorna.

       Rutnätets andra spalt är `1fr` och alltså 576 vid 1440, men panelen
       tar bara 380 av dem och `justify-self: end` klistrar den mot spaltens
       högra kant. Kvar blir 196 px som lägger sig som extra luft mellan
       texten och panelen. Båda ytterkanterna stämmer då med brödsmulorna,
       källfoten och artikelbandet: 68 till vänster, 1372 till höger.

       Två spalter i panelen provades först och var fel svar på rätt fråga.
       Måttet är hämtat ur vad rutorna tål: vid 576 gick kartbilden från
       300 × 160 till 544 × 160, alltså kvoten 3,4, och faktaraden
       "Uteservering ... Ja" fick 544 px mellan etikett och värde. Vid 380
       blir kartan 348 × 160, alltså 2,18, och raderna håller ihop.

       `flex` och inte `grid`: en enda spalt behöver inget rutnät, och
       flexkolumnen sträcker inte rutorna till varandras höjd. */
    justify-self: end;
    width: 100%;
    /* 480 sedan --w-wide gick till 1800. Panelen svälter annars medan gluggen
       växer: vid 1800 blev avståndet mellan text och panel 644 px, alltså mer
       än brödtextens egen bredd. 480 tar 100 av dem, och rutorna inuti är
       byggda för 260 och uppåt, se auto-fit-golvet nedan. */
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .panel {
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    padding: var(--s-4);
  }

  /* Samma panelrubriknivå som kommunhubben. Se KommunHub.astro. */
  .panel-title {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    display: flex;
    align-items: center;
    margin-bottom: var(--s-3);
  }

  /* Knapparna i panelen bor i ActionPanel.astro tillsammans med sin logik. */

  /* Nämnaren står mellan rubriken och listan. Rubriken bär redan 12 px under
     sig, så meningen får bara luft NEDÅT, annars hade den flutit mitt emellan
     de två i stället för att höra till listan den räknar. */
  .near-lede {
    margin: 0 0 var(--s-3);
  }

  .near {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .near a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
    color: var(--text);
  }

  .near a:hover { text-decoration: none; }
  .near a:hover b { color: var(--brand); }

  .near li + li { border-top: 1px solid var(--hairline); }

  .near-info { min-width: 0; }

  .near-info b {
    display: block;
    font-size: var(--fs-caption);
    font-weight: 600;
    line-height: 17px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .near-info span { font-size: var(--fs-micro); line-height: var(--lh-micro); }

  /* Meningen om raden i följd hänger på nyckeltalen och inte fritt under dem:
     8 px, alltså samma avstånd som Nyckeltal.astro sätter mellan ett tal och
     dess etikett. Med sidans vanliga sektionsluft hade den lästs som ett eget
     stycke i stället för som en fotnot till andelen den kvalificerar.

     Hårlinjen och padding-top ur `.main > * + *` nollas därför här. Regeln
     skiljer SEKTIONER åt, och meningen är ingen sektion utan en fotnot till
     den rad den hänger under. Med linjen kvar hade den sett ut som ett eget
     avsnitt med en enda mening i. */
  .ren-rad {
    margin-top: var(--s-2);
    padding-top: 0;
    border-top: 0;
    max-width: var(--w-read);
  }

  /* Mer luft när nyckeltalen bryter i två rader. Uppmätt vid 390 px: "Äldsta
     kontroll 2018" står ensamt på andra raden, och med 8 px läste meningen
     som bildtext till just det talet i stället för som en fotnot till hela
     raden. FactGrid sätter 12 px mellan sina cellrader, så 16 px är det
     minsta som gör meningen till något annat än ytterligare en cellrad.

     640 px och inte ett eget mått: det är sidans befintliga brytpunkt strax
     ovanför, och radbrytningen i FactGrid börjar långt före den. */
  @media (max-width: 640px) {
    .ren-rad { margin-top: var(--s-4); }
  }

  /* Stilla knapp under nyckeltalen. Formen är btn-quiet ur konto.css, men
     klassen kan inte lånas rakt av: den bor i ett stilark den här sidan inte
     laddar, och att dra in hela kontostilen för en knapp vore dyrare än de
     åtta raderna. Måtten är btn-tights, alltså radens knapp och inte sidans
     egen åtgärd — bedömningen ovanför är det man kom för. */
  .jamfor-rad { margin: var(--s-4) 0 0; }

  /* Måtten följer .btn-tight i konto.css, alltså radens knapp: --h-control
     högt, med träffytan buren av ett ::after på --h-tap. Höjden var räknad
     ur padding och landade på 34,5 px, uppmätt i bygget 2026-08-18, alltså
     under träffytegolvet. */
  .jamfor-knapp {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: var(--h-control);
    background: transparent;
    color: var(--text);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    padding-inline: 16px;
    font: 600 var(--fs-caption)/1 var(--font-sans);
  }

  .jamfor-knapp::after {
    content: '';
    position: absolute;
    inset: -2px 0;
  }

  /* Brandblå och aldrig grönt, gult eller rött. De tre färgerna är
     bedömningens och skulle läsas som ett omdöme om verksamheten. */
  /* Boolis form, uppmätt på deras egen nyhetsruta: fyrkantig etikett med
     liten radie och utropstecken, inte ett piller. Ett piller läser som ett
     antal, alltså som en notissiffra, medan en fyrkant läser som en stämpel.
     Ägaren: "vår nytt knapp ska vara Nytt! och sitta mer clean." */
  .jamfor-nytt {
    background: var(--brand);
    color: #fff;
    border-radius: 4px;
    padding: 1px 6px;
    /* --fs-micro ÄR 11 px. Ett rått värde med reservtoken hade sagt att
       skalan saknar graden, och nästa gång skalan justeras hade etiketten
       blivit kvar. Se docs/19_formsystem.md. */
    font-size: var(--fs-micro);
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: 0;
  }

  .jamfor-knapp:hover {
    background: var(--canvas);
    text-decoration: none;
  }

  .near-foot {
    margin: var(--s-3) 0 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
  }

  /* Statistikrutans form bor i Nyckeltal.astro och Fordelning.astro. Här stod
     tidigare en egen kopia av båda, alltså sajtens tredje sätt att teckna
     samma sak. Kvar här är bara luften mellan panelrubriken och talet:
     komponenterna bär inget eget yttermått, av samma skäl som de inte bär
     någon ram. */
  /* :global krävs, eftersom Astros scopeade selektorer inte korsar
     komponentgränser. */
  .panel > :global(.nyckeltal) { margin-top: var(--s-1); }

  .kommun-links {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: var(--s-3) 0 0;
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .kommun-links li + li { margin-top: var(--s-2); }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .side {
      position: static;
    }
  }

