---
/**
 * Restaurangsidan — sajtens viktigaste sidtyp.
 *
 * Formen är Boolis objektsida, på ägarens uttryckliga riktning: "den gillar
 * jag ALLT med... den är SÅ Clean." Det som gör deras sida lugn trots mängden
 * information är tre saker, och alla tre används här:
 *
 *  1. Ingen kortlåda runt huvudinnehållet. Sektionerna ligger öppet på sidan,
 *     skilda av hårlinjer och luft, inte av ramar.
 *  2. Ett stort värde bär sidan. Hos dem priset under etiketten "Utropspris",
 *     hos oss bedömningen under etiketten "Bedömning", med nyckelfakta i en
 *     öppen rad direkt under: liten etikett över stort tal, luft emellan.
 *  3. Kartan är en egen sektion i huvudkolumnen med adressen under, inte en
 *     miniatyr i marginalen. Sidopanelen bär det man agerar med — hos dem
 *     mäklarkortet, hos oss bevakningen, omdömet och rättelsen.
 *
 * Layouten är tvåkolumn med sticky sidopanel, som booli. Huvudkolumnen läses
 * uppifrån och ner som en berättelse i tid: vad kontrollen visade, blev det
 * åtgärdat, återkommer det, hela historiken — och sedan var stället ligger.
 *
 * Titeln leder med NAKET NAMN + ORT, inte med "hygienkontroll". Skälet är
 * mätt: i Storbritannien, världens mognaste marknad för hygienbetyg, ger
 * "food hygiene rating" 54,7 i söktrend medan "nandos food hygiene rating"
 * ger 0,04 — under 0,1 % för en av landets största kedjor. Ingen söker på
 * "[restaurang] hygien". Sidan måste vinna på namnet, och hygienen är
 * differentieraren i beskrivningen.
 *
 * Två SEO/AEO-krav styr innehållet:
 *
 * 1. Led med svaret. Första meningen ska vara självbärande och citerbar.
 *    Så extraherar AI-svar fakta (bibeln §6b).
 * 2. Aldrig `Review`- eller `AggregateRating`-schema för hygienbedömningen.
 *    Den bygger på myndighetsdata, inte på omdömen insamlade hos oss.
 *    Schemat är `FoodEstablishment`. (När förstapartsomdömen finns får de
 *    eget schema — men hålls visuellt och strukturellt åtskilda.)
 */
import Base from '../../layouts/Base.astro';
import FaceMark from '../../components/FaceMark.astro';
import FactGrid from '../../components/FactGrid.astro';
import InfoTip from '../../components/InfoTip.astro';
import Platskarta from '../../components/Platskarta.astro';
import Oppettider from '../../components/Oppettider.astro';
import Kontaktuppgifter from '../../components/Kontaktuppgifter.astro';
import OppetPille from '../../components/OppetPille.astro';
import Foretagsuppgifter from '../../components/Foretagsuppgifter.astro';
import Foretagsbilder from '../../components/Foretagsbilder.astro';
import StreetPhoto from '../../components/StreetPhoto.astro';
import AwardNote from '../../components/AwardNote.astro';
import JamforRuta from '../../components/JamforRuta.astro';
import MatsnuskNote from '../../components/MatsnuskNote.astro';
import ControlBreakdown from '../../components/ControlBreakdown.astro';
import FollowUp from '../../components/FollowUp.astro';
import RecurringIssues from '../../components/RecurringIssues.astro';
import InspectionHistory from '../../components/InspectionHistory.astro';
import Bilder from '../../components/Bilder.astro';
import Fordelning from '../../components/Fordelning.astro';
import Nyckeltal from '../../components/Nyckeltal.astro';
import Reviews from '../../components/Reviews.astro';
import ActionPanel from '../../components/ActionPanel.astro';
import ArtikelBanner from '../../components/ArtikelBanner.astro';
import Handlingsrad from '../../components/Handlingsrad.astro';
import Kontrolldatum from '../../components/Kontrolldatum.astro';
import {
  categoriesOf,
  establishments,
  followUp,
  municipalities,
  sourceFor,
  formatDate,
  formatDistance,
  formatNumber,
  isIndexable,
  latestInspectionDate,
  missingReason,
  municipalityCategories,
  municipalitySummary,
  nearby,
  recurringIssues,
  statistics,
  type CategorySlice,
  type Establishment,
} from '../../lib/data';
import { chainFor } from '../../lib/kedjor';
import { JAMFOR_NYHET_SYNS, compareHref, compareSuggestions } from '../../lib/jamfor';
import { linkedAreaOf } from '../../lib/omraden';
import { MISSING, SITE, VERDICT } from '../../lib/site';
import { absolute, path } from '../../lib/urls';

export async function getStaticPaths() {
  // Alla kommuner vi har data för. Ingen lista i kod — db.ts upptäcker dem.
  return municipalities().flatMap((m) =>
    establishments(m.slug).map((e) => ({
      params: { kommun: m.slug, slug: e.slug },
      props: { establishment: e },
    })),
  );
}

interface Props {
  establishment: Establishment;
}

const { establishment: e } = Astro.props;
const kommun = e.municipality;
const source = sourceFor(kommun.slug)!;

/** Stadsdelen verksamheten ligger i, när den har en egen sida. */
const omrade = linkedAreaOf(e);

const presentation = e.verdict ? VERDICT[e.verdict] : MISSING[missingReason(e)];
const latest = latestInspectionDate(e);
const latestInspection = e.inspections[0];
const stats = statistics(e);
const neighbours = nearby(e);
const hasCoords = e.lat !== null && e.lng !== null;

/*
 * Vad jämförelserutan föreslår. Grannarna är redan uträknade ovan och skickas
 * in, så förslagen kostar inget nytt svep över kommunen. Se lib/jamfor.ts.
 */
const compareWith = compareSuggestions(e, neighbours);
const compareMetres = Object.fromEntries(neighbours.map((n) => [n.slug, n.metres]));

/**
 * Kommunen som jämförelsepunkt.
 *
 * "Inga anmärkningar" säger ingenting om huruvida det är vanligt eller
 * sällsynt. I Jönköping har 98 % av de bedömda inga anmärkningar och beskedet
 * är alltså normaltillståndet; i Lomma har 45 % det och samma besked betyder
 * något helt annat. Utan nämnaren läser besökaren in en ranking som inte
 * finns.
 *
 * Panelen är också den enda länken härifrån till kommunhubben utöver
 * brödsmulan, och hubben är den sidtyp som bär trafiken.
 */
const kommunSummary = municipalitySummary(kommun);
const recurring = recurringIssues(e);
const indexable = isIndexable(e);

/**
 * Fördelningen bakom kommunsiffran, som ett band.
 *
 * Samma tal som meningen under redan bär, tecknade som yta så att de går att
 * ta in på en blick. Andelarna räknas på BEDÖMDA, aldrig på totalen, samma
 * nämnare som cleanShare och av samma skäl. Bandet bär fördelningen inom EN
 * kommun; kommuner emellan jämförs aldrig.
 *
 * Färgen sätts här och inte i Fordelning.astro: segmenten ÄR bedömningens tre
 * nivåer, i ordningen ren, avvikelse, kvarstående brist, och det är det enda
 * fallet där de tre färgerna får bära ett band. Varje mängd står dessutom i
 * klartext med sitt eget ord under bandet, så färgen är aldrig ensam
 * informationsbärare.
 *
 * TECKENFÖRKLARINGEN BÄR ANTAL OCH INGEN ANDEL, till skillnad från
 * kommunhubbens. Där finns inget huvudtal, och andelen måste stå någonstans.
 * Här ÄR huvudtalet andelen: 89 % står redan i --fs-title strax ovanför, och
 * eftersom både det och segmenten räknas på bedömda blev den rena mängdens
 * andel exakt samma tal en gång till, sextio pixlar bort. Ett tal som redan
 * står på sidan ska inte stå två gånger. Fordelning.astro gör andelen valfri
 * just för det här fallet.
 */
const dist = kommunSummary.assessed
  ? (['clean', 'minor', 'major'] as const)
      .map((k) => ({
        n: kommunSummary[k],
        label: VERDICT[k].label,
        surface: `var(--verdict-${k})`,
      }))
      .filter((d) => d.n > 0)
  : [];

const distLabel = dist
  .map((d) => `${d.label}: ${formatNumber(d.n)}`)
  .join('. ');

/**
 * Ledde uppföljningen till åtgärd?
 *
 * Sidans starkaste besked, och det enda som säger något om vad som HÄNDE efter
 * en anmärkning. Null för de flesta verksamheter, och då står ingenting. Se
 * followUp() i data.ts.
 */
const uppfoljning = followUp(e);

/**
 * Vägen tillbaka till kategorisidan.
 *
 * Verksamhetssidorna har hittills bara länkat uppåt till kommunhubben, aldrig
 * i sidled. "Restauranger i Örebro" är en sökning folk gör, och sidan som
 * svarar på den fick inga interna länkar alls utom från hubbens filterrad.
 * categoriesOf() har funnits i data.ts sedan kategorierna byggdes och har
 * aldrig anropats från någon sidmall.
 *
 * Bara kategorier som har en egen sida i den här kommunen, och bara där
 * filtret alls är användbart — samma villkor som styr chipsen på hubben, så
 * att en länk aldrig pekar på en URL som inte finns.
 */
const kommunCats = municipalityCategories(kommun.slug);
const ownCategories: CategorySlice[] = kommunCats.usable
  ? categoriesOf(e)
      .categories.map((id) => kommunCats.slices.find((s) => s.category.id === id))
      .filter((s): s is CategorySlice => s !== undefined && s.linked)
  : [];

/**
 * Vägen i sidled ut ur kommunen.
 *
 * Kategorilänken ovanför går till "Caféer i Stockholm". Den här går till
 * "Espresso House", alla 52, i alla kommuner vi har. Det är den enda länk på
 * sidan som lämnar kommunen, och den frågan är den enda ingen kommunal
 * livsmedelskarta i Sverige kan besvara.
 *
 * `chainFor` är null när kedjan inte har en sida, så länken kan aldrig peka
 * på en URL som kvalitetsgrinden håller borta. Se lib/kedjor.ts.
 */
const kedja = chainFor(e);

/**
 * Svarsmeningen. Sidans första rad, och den enda rad en språkmodell
 * sannolikt citerar. Måste vara självbärande och sann i varje utfall.
 *
 * Den här limmade tidigare ihop ett datumled på ALLA utfall:
 * `${namn} ${sentence} den ${datum}.` Det bär bara när meningen handlar om
 * en kontroll som faktiskt ägt rum. På 2 136 sidor gjorde den inte det:
 *
 *  - 857 sidor läste "…så nuläget går inte att bedöma den 17 maj 2023",
 *    eftersom meningen för `stale_inspections` slutar i en bisats som inte
 *    tar något datumled. Det går inte att läsa.
 *  - 1 279 sidor sade "har ingen registrerad hygienkontroll hos kommunen"
 *    och bjöd i nästa mening in till att läsa kontrollhistoriken.
 *
 * Därför en gren per utfall i stället för en mall plus konkatenering. Datumet
 * får en egen mening när det inte hör hemma i den första, och den fasta
 * svansen sätts bara när det finns något att se.
 */
const areas = latestInspection?.areas.length ?? 0;

let answer: string;
let detail: string;

if (e.verdict !== null && latest) {
  // Bedömd. Datumet hör till kontrollen meningen handlar om.
  answer = `${e.name} ${presentation.sentence} den ${formatDate(latest)}.`;
  detail =
    areas > 0
      ? 'Se vilka kontrollområden som granskades och hela kontrollhistoriken.'
      : 'Se hela kontrollhistoriken hos kommunen.';
} else if (latest) {
  // För gammal kontroll. Kontrollen finns, men den är för gammal för att säga
  // något om nuläget, och då är datumet ett eget påstående, inte ett led i
  // meningen om att bedömningen uteblir.
  answer =
    `${e.name} ${presentation.sentence}. ` +
    `Den senaste kontrollen gjordes den ${formatDate(latest)}.`;
  detail =
    areas > 0
      ? 'Se vad som granskades då och hela kontrollhistoriken.'
      : 'Se hela kontrollhistoriken hos kommunen.';
} else {
  // Ingen kontroll alls. Ingen historik att hänvisa till, alltså ingen svans
  // om kontrollområden. Den var det som gjorde beskrivningen självmotsägande.
  answer = `${e.name} ${presentation.sentence}.`;
  detail = `Verksamheten finns i kommunens register, men ${kommun.name} har inte publicerat någon kontroll av den.`;
}

const description = `${answer} ${detail}`;

/**
 * Andra meningen i huvudspalten. Står bara på skärmen, aldrig i metadatan.
 *
 * ## Varför den finns
 *
 * Google byggde sin egen text i sökresultatet för The Coffice Albano i stället
 * för att använda vår metabeskrivning, och tog listan i jämförelserutan:
 * "The Coffice Albano med Pressbyrån 4150206 Albanovägen 12 · 92 m …". Rutan
 * är åtgärdad var för sig (den bär `data-nosnippet`, se JamforRuta.astro), men
 * den andra halvan av felet var att sidans egen prosa var EN mening lång.
 * Bedömningen ritas som ett märke och en etikett, alltså grafik, och
 * nyckeltalen är tal med etiketter. En läsare ser en hel sida; en
 * utdragsbyggare ser en rad text och sedan listor.
 *
 * Meningen är därför den enda platsen där adressen, kommunen, antalet
 * kontroller och perioden står i löpande text. Tillsammans med svarsmeningen
 * blir stycket självbärande: vem, var, vilket besked, hur många kontroller och
 * sedan när. Det är också precis vad någon som söker på ett restaurangnamn
 * vill se.
 *
 * ## Varför den INTE går in i metabeskrivningen
 *
 * `answer` bär både beskrivningen och delningstexten och ligger på omkring 155
 * tecken, alltså på gränsen för vad Google visar. En mening till hade tryckt ut
 * slutet av den befintliga. Metadatan är oförändrad.
 *
 * ## Vad den får och inte får påstå
 *
 * Talet är antalet kontroller kommunen publicerar på ADRESSEN, inte på
 * företaget: kommunerna registrerar kontrollen på lokalen, och har lokalen
 * bytt verksamhet ingår föregångarens kontroller. Meningen säger därför
 * "på {adress}" och aldrig "verksamheten har haft". Samma förbehåll som står i
 * nyckeltalens tips, se `facts` nedan.
 *
 * Ordet "bedömningen" används bara när det FINNS en bedömning. På sidor där
 * kontrollerna är för gamla för att säga något om nuläget står meningen som ett
 * rent påstående om vad kommunen publicerat.
 */
const plats = e.address ? `på ${e.address}` : 'på adressen';

let grund: string | null = null;
if (stats.total > 1) {
  const antal = formatNumber(stats.total);
  grund =
    e.verdict !== null
      ? `Bedömningen vilar på ${antal} kontroller som ${kommun.name} publicerat ${plats} sedan ${stats.oldestYear}.`
      : `${kommun.name} har publicerat ${antal} kontroller ${plats} sedan ${stats.oldestYear}.`;
} else if (stats.total === 1) {
  grund =
    e.verdict !== null
      ? `Bedömningen vilar på den enda kontroll ${kommun.name} publicerat ${plats}.`
      : `${kommun.name} har publicerat en kontroll ${plats}.`;
}

/**
 * Statistiken räknas på ADRESSEN, inte på företaget.
 *
 * Kommunerna registrerar kontrollerna på anläggningen, alltså lokalen, och
 * ingen av de nio källorna säger när verksamheten startade eller om ägaren
 * bytt. Tar en ny restaurang över en adress ärver den föregångarens hela
 * historik. Rutan hette tidigare "Först kontrollerad", vilket läses rakt av
 * som verksamhetens ålder, ett påstående vi inte har täckning för.
 *
 * Talen är oförändrade. Det är etiketterna som slutar tillskriva dem fel part.
 */
const facts = [
  /* "Kontroller" och inte "Kontroller på adressen". Att räkningen gäller
     adressen och inte företaget står i tipset, som är hela skälet till att
     tipset finns. */
  { label: 'Kontroller', value: String(stats.total),
    tip: `Samtliga kontroller kommunen publicerar på den här adressen, från ${stats.oldestYear} och framåt. Har lokalen bytt verksamhet ingår även den tidigare verksamhetens kontroller. Kommunen registrerar kontrollerna på lokalen och inte på företaget.` },
  { label: 'Utan anmärkning', value: String(stats.cleanShare), unit: '%',
    color: stats.cleanShare >= 80 ? 'var(--verdict-clean)' : undefined,
    tip: 'Andel av kontrollerna på adressen där inga avvikelser noterades.' },
  { label: 'Återbesök', value: String(stats.followUps),
    tip: 'Uppföljande kontroller som gjorts för att se om tidigare avvikelser åtgärdats.' },
  { label: 'Äldsta kontroll', value: stats.oldestYear ?? '–',
    tip: 'Året för den äldsta kontroll kommunen publicerar på adressen. Det är inte nödvändigtvis året verksamheten startade. Kommunerna publicerar bara ett begränsat antal år bakåt, och historiken följer lokalen.' },
];

/**
 * Kommunens egen utsaga om ägarbyte, när den finns. Återges attribuerad, aldrig
 * som vår slutsats. Se OWNERSHIP_POLICY i data.ts.
 */

/**
 * Upplysningen om lokalen visas på ALLA verksamheter med mer än en kontroll,
 * aldrig villkorad av ett uppehåll i historiken.
 *
 * Ett villkorat förbehåll lär läsaren att frånvaron betyder att historiken är
 * säker. Det är falskt: 64 % av de restaurangliknande verksamheterna i våra
 * djupa kommuner har inget uppehåll alls, och medianintervallet mellan två
 * restaurangkontroller i Stockholm är 272 dagar, så ett ägarbyte däremellan
 * syns inte. Den falska tryggheten hade legat just på de sidor där risken är
 * störst. Se HISTORY_GAP_DAYS i data.ts för mätningen.
 */

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  /* Ett id att peka på.

     Öppettider och telefon kommer från företagsytan och hämtas i webbläsaren,
     alltså finns de inte när den här noden skrivs. Foretagsuppgifter.astro
     lägger till en andra nod med SAMMA @id när uppgifterna kommit hem, och den
     som läser strukturerad data slår då ihop de två i stället för att tro att
     adressen har två restauranger. Utan ett id går det inte att göra. */
  '@id': `${absolute(kommun.slug, e.slug)}#verksamhet`,
  name: e.name,
  url: absolute(kommun.slug, e.slug),
  address: {
    '@type': 'PostalAddress',
    streetAddress: e.address ?? undefined,
    addressLocality: kommun.city,
    addressCountry: 'SE',
  },
};
/**
 * `geo` publiceras BARA för koordinater kommunen själv lämnat.
 *
 * Uppsala och Örebro lämnar inga koordinater. 1 570 verksamheter har därför en
 * punkt som pipelinen geokodat fram ur adressen mot OpenStreetMap
 * (`geoSource: 'osm'`), varav 228 bara matchat närmaste grannport.
 *
 * På skärmen ritar Platskarta nålen streckad och skriver förbehållet under
 * kartan. I JSON-LD stod ingenting: schemat såg identiskt ut för en
 * kommunlämnad och en härledd punkt, alltså saknades förbehållet exakt där
 * maskinen läser. Och det är JSON-LD en sökmotor, en språkmodell eller en
 * framtida datalicenstagare faktiskt hämtar.
 *
 * Schema.org har ingen flagga för "härledd" på GeoCoordinates, så det finns
 * ingen form som både publicerar punkten och bär förbehållet. Då är det rätta
 * att inte påstå den. Vi säger inte maskinellt att koordinaten kommer från
 * kommunen när den inte gör det. "Verifiera, aldrig gissa" gäller den
 * maskinläsbara sidan också.
 */
if (e.lat && e.lng && e.geoSource !== 'osm') {
  jsonLd.geo = { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lng };
}

/**
 * Vilken artikel bandet längst ned visar.
 *
 * Kopplingen är stark på den här sidtypen, alltså väljs artikel och inte den
 * senaste: den som just läst att stället har anmärkningar undrar rimligen vad
 * som händer sedan, och den som läst en ren kontroll har mer nytta av att
 * veta vad kontrollen faktiskt omfattar. Listan är en prioritetsordning;
 * ArtikelBanner faller tillbaka på den senast publicerade artikeln av sig
 * själv om slugen skulle försvinna, och visar ingenting alls så länge
 * artikelsektionen ligger under sin kvalitetströskel.
 */
const artikelval =
  e.verdict === 'minor' || e.verdict === 'major'
    ? ['vad-hander-efter-en-anmarkning', 'sa-laser-du-en-hygienkontroll']
    : ['sa-laser-du-en-hygienkontroll', 'vad-hander-efter-en-anmarkning'];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
    { '@type': 'ListItem', position: 2, name: kommun.name, item: absolute(kommun.slug) },
    { '@type': 'ListItem', position: 3, name: e.name },
  ],
};
---

<Base
  title={`${e.name}, ${kommun.city}`}
  description={description}
  noindex={!indexable}
  jsonLd={[jsonLd, breadcrumbs]}
  dataUpdated={latest ?? undefined}
>
  <div class="container page">
    <nav class="crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path(kommun.slug)}>{kommun.city}</a>
    </nav>

    {/* Rubriken och handlingarna på SAMMA rad, inte på var sin.

        De låg på var sin rad med Följ och Dela ute till höger, och eftersom
        raden var tom till vänster blev det ett hål mellan namnet och
        bedömningen. Ägaren: "blir liksom ett stort glapp ner till
        anmärkningen". Knapparna flyttar därför upp bredvid namnet, och
        bedömningen stiger lika mycket som hålet var djupt.

        Kartknappen som fyllde vänsterhalvan är borttagen. Den hoppade till
        kartsektionen längre ned på samma sida, alltså en knapp vars hela
        ärende var att rulla; sektionen står kvar där den står. */}
    <div class="topp">
      <header class="masthead">
        <h1>{e.name}</h1>
        <p class="place text-secondary">
          {[e.types[0], e.address, kommun.city].filter(Boolean).join(' · ')}
          {/* Stadsdelen sist i raden, och bara när den har en egen sida. Den
              binder verksamheten till sitt område i länkgrafen, vilket är
              det som gör områdessidorna nåbara nerifrån och inte bara från
              kommunhubben. Se lib/omraden.ts. */}
          {omrade && (
            <> · <a href={path(kommun.slug, 'omrade', omrade.slug)}>{omrade.name}</a></>
          )}
        </p>

        {/* "Öppet nu" i ögonhöjd, en rad under namnet.

            Den satt förut i rubriken på öppettidsavsnittet, som ligger under
            kartan: uppmätt i 1 200 px på den här sidan 2 460 px ned i
            dokumentet mot rubrikens 127. Ägaren: "borde inte öppet nu/stängt
            nu, sitta typ längre upp vid namnet eller någon och sen hela stor
            widgeten där nere där den är nu." Veckoschemat står kvar.

            Två saker som gör att raden inte kostar något på de sidor som
            saknar tider: villkoret `e.hours` gör att elementet inte finns
            alls på 13 305 av 16 047 sidor, och på de övriga står det tomt och
            `hidden` tills skriptet fyllt i det. Tillståndet får aldrig skrivas
            vid bygget, se OppetPille.astro. */}
        {e.hours && <OppetPille hours={e.hours} />}
      </header>

      {/* Raden bär det som gäller stället i sin helhet; omdömesknappen bor i
          omdömesavsnittet där rutan den öppnar hör hemma, och rättelsen och
          replikrätten står kvar i panelen, se ActionPanel.astro.

          Delningens text är svarsmeningen, som redan är skriven för att vara
          självbärande. */}
      <Handlingsrad
        establishmentId={e.id}
        establishmentName={e.name}
        municipalitySlug={kommun.slug}
        shareText={answer}
      />
    </div>

    <div class="layout">
      <main class="main">
        {/* Bedömningen där booli har priset: en tyst etikett, ett stort
            besked, och svarsmeningen under. Metodiklänken är deras
            "Se Boolis värdering" — vägen till hur talet blev till. */}
        <section class="statement">
          <p class="eyebrow">Bedömning</p>
          <div class="verdict">
            {/* DET ENDA MÄRKET PÅ SAJTEN SOM RÖR SIG.

                `liv` ger en loop som skiljer sig efter bedömning och `blick`
                låter pupillerna följa pekaren när det finns en mus. Båda är
                avstängda i förvalet i FaceMark, och skälet är att den
                komponenten renderas på sextontusen sidor medan den här raden
                är en. Se rörelsekatalogens avsnitt 5. */}
            <FaceMark verdict={e.verdict} size={52} animate liv blick />
            <div class="besked">
              {/* ETT märke, inte två.

                  Här stod "Ren historik" och "Utmärkelsen 2026" som två
                  likadana piller intill varandra. De sade nästan samma sak
                  med olika ord, och tillsammans vägde de tyngre än beskedet
                  de stod bredvid. Ägaren: "kanske vi ska ta bort genomgående
                  rent eller ngt o bara kör utmärkelse".

                  Utmärkelsen är den som får stå. Den är svårare att få, den
                  har ett årtal, och den har en egen sida att peka på. "Ren
                  historik" räknades vid varje bygge ur samma serie kontroller
                  som utmärkelsen redan vilar på, alltså sade den inget som
                  inte redan stod bredvid. Fältet `e.distinction` finns kvar i
                  datan och används av kartan och listorna.

                  Stjärnan framför "Ren historik" försvinner med den. Sajten
                  har tagit beslutet att stjärnor inte används, eftersom de
                  läser som betyg, och det är samma skäl som gör att omdömen
                  inte har stjärnbetyg (se Reviews.astro). */}
              <p class="level">
                {presentation.label}
                {grund && <InfoTip label="vad bedömningen vilar på" text={grund} />}
              </p>
              {/* Grunden flyttad från stycket till ett tips på etiketten.

                  Meningen löd "Bedömningen vilar på 9 kontroller som
                  Stockholms stad publicerat på Åkeshovs Gårdsväg 11 sedan
                  2019." Ägaren: "detta kan vara i en i-ikon eller något, det
                  blir för långt."

                  Den lades dit för att ge Google riktig prosa att bygga sitt
                  utdrag av, i stället för att låta sökmotorn plocka text ur
                  jämförelserutan. Priset för flytten är alltså känt: tipsets
                  text bär `data-nosnippet`, så meningen räknas inte längre som
                  utdragsmaterial. Uppgiften finns kvar för läsaren, en klick
                  bort, och den står dessutom kvar i nyckeltalens egna tips.

                  Blir utdraget dåligt igen är rätt åtgärd att korta meningen
                  och sätta tillbaka den i stycket, inte att ta bort tipset. */}
              <p class="answer">{answer}</p>
            </div>
            {/* Märket som märke, ute till höger på bedömningsraden. Som
                piller i rubriken syntes det knappt; som låda under
                nyckeltalen låg det i vägen. Här har det plats att vara ett
                sigill utan att skjuta ned något.

                DE TVÅ SIGILLEN DELAR DEN HÄR PLATSEN, och det går för att de
                aldrig kan gälla samtidigt: utmärkelsen kräver ren historik och
                matsnusk kräver kvarstående brister. Ingen rad kan alltså bära
                båda, och ingen av dem behöver veta om den andra. */}
            <AwardNote establishment={e} />
            <MatsnuskNote establishment={e} />
          </div>
          {/* Grunden för matsnuskmärket, direkt under det sigill den hör till.
              Ett sigill utan förklaring intill är en anklagelse utan grund, och
              det är hela skälet till att märket inte fick flytta upp ensamt.
              Utmärkelsen behöver ingen motsvarighet: dess sigill bär sitt eget
              årtal och länkar till en utgåvesida som förklarar ribban.

              Före metodiklänken, som är generisk. Den här meningen gäller det
              här stället. */}
          <MatsnuskNote establishment={e} visa="grund" />
          <p class="method caption">
            <a href="/metodik/">Så sätts bedömningen</a>
          </p>
        </section>

        {/* Datumet bedömningen vilar på, som ett kalenderblad. PAUSAD av
            ägaren: komponenten renderar ingenting, och flaggan som styr det
            bor i Kontrolldatum.astro tillsammans med skälet. Anropet står
            kvar så att beslutet ligger på ett ställe. */}
        {latestInspection && (
          <Kontrolldatum inspection={latestInspection} href="#kontrollhistorik" />
        )}

        {/* Nyckelfakta i öppen rad direkt under beskedet, som Boolis
            Boarea · Rum · Byggår under priset. Förbehållen bor i tipsen. */}
        <FactGrid facts={facts} />

        {/* Jämförelsen står vid nyckeltalen och inte i handlingsraden.
            Handlingsraden är låst vid två knappar av dokumenterade skäl, se
            Handlingsrad.astro, och talen här ÄR det jämförelsen ställer
            bredvid varandra: kontroller, andel utan anmärkning, återbesök.
            En knapp hör hemma där dess verkan sker.

            Länk och inte knapp: utan JavaScript leder den till /jamfor/ med
            det här stället ifyllt, och väljaren där gör samma sak i två steg.
            Med JavaScript öppnas rutan i stället. Ingen knapp kan bli död. */}
        {compareWith.length > 0 && (
          /* EN rad, inte fyra.
             Introduktionen var ett eget stycke ovanför knappen: etikett,
             rubrik och två rader text, alltså fyra rader för att presentera
             en knapp på en. Ägaren: "jämför grejen och hela nytt grejen tar
             upp för mkt plats".
             Etiketten sitter nu PÅ knappen. Det är också vad Booli gör i
             förlagan han skickade: deras "Nytt!" står inline med rubriken,
             inte staplat ovanför den. Etiketten försvinner av sig själv, se
             JAMFOR_NYHET_SYNS i lib/jamfor.ts, och kvar blir en vanlig knapp.

             Introduktionen står här och inte på startsidan. Där hade den
             blivit reklam för oss själva; här står den intill det den
             jämför, hos någon som just läst ett besked. */
          <p class="jamfor-rad">
            <a class="jamfor-knapp" data-jamfor href={compareHref(kommun.slug, e.slug)}>
              {JAMFOR_NYHET_SYNS && <span class="jamfor-nytt">Nytt!</span>}
              Jämför med ett annat ställe
            </a>
          </p>
        )}

        {/* Här stod BÅDA märkena en gång, som var sitt inramade fält.
            Utmärkelsen flyttade upp till bedömningsraden först, se
            AwardNote.astro, och matsnusk lämnades kvar med skälet att den är
            ett påstående och inte ett erkännande och därför behöver sin plats
            i berättelsen.

            Det höll inte. Ägaren: "det ska ju vara som ett märke som
            utmärkelsen, eller?". Ett påstående som får ett eget avsnitt med
            rubrik långt ned på sidan väger TYNGRE än ett erkännande som står
            som ett sigill vid beskedet, inte lättare, och att behandla den
            hårdare av de två mer omständligt är fel ordning. Båda står nu på
            bedömningsraden, och grunden står under den. */}

        {latestInspection && latestInspection.areas.length > 0 && (
          <ControlBreakdown
            areas={latestInspection.areas}
            inspectedAt={formatDate(latestInspection.date)}
          />
        )}

        {/* Efter vad kontrollen visade, före vad som återkommer: sidan läses
            som en berättelse i tid. Vad hittades, blev det åtgärdat, och
            händer det om och om igen. */}
        <FollowUp followUp={uppfoljning} kommun={kommun.name} />

        <RecurringIssues issues={recurring} />

        <InspectionHistory inspections={e.inspections} />

        {/* Kartan som egen sektion i huvudkolumnen med adressen under, som
            hos booli. Efter historiken: den hör till fakta om stället men
            ska inte klyva kontrollberättelsen. Verksamheter utan koordinat
            får ingen kartsektion alls. */}
        {hasCoords && (
          <Platskarta
            lat={e.lat!}
            lng={e.lng!}
            name={e.name}
            verdict={e.verdict}
            geoSource={e.geoSource}
            address={e.address}
            city={kommun.city}
          />
        )}

        {/* Öppettiderna står direkt under kartan, och det är ingen slump.

            De två avsnitten svarar på samma sorts fråga, var ligger det och
            när är det öppet, och båda är HÄRLEDDA av oss ur OpenStreetMap i
            stället för hämtade ur kommunens register. De hör alltså ihop både
            för läsaren och i fråga om vad de är.

            Ovanför kontrollberättelsen får de inte stå: en öppettid som
            hamnar mellan bedömningen och vad kontrollen visade läses som en
            del av beskedet, och den kommer inte från kommunen.

            Avsnittet finns inte alls på de sidor där vi saknar tider, och det
            är de allra flesta. Se docs/33_oppettider.md för nämnaren. */}
        {e.hours && <Oppettider hours={e.hours} name={e.name} />}

        {/* Kontakt och egenskaper, ur SAMMA OSM-uttag som öppettiderna och
            därför direkt efter dem.

            Avsnittet står på FLER sidor än öppettiderna, inte färre: 3 274 av
            9 995 konsumentvända mot 2 747. Skälet är att uppgifterna hänger
            på hopparningen och inte på att OSM råkar ha en `opening_hours`.
            De 1 097 verksamheter vi vet vilket OSM-objekt de är men som
            saknar tider har lika belagda telefonnummer.

            Se docs/37_osm_taggar.md för nämnaren per kommun. */}
        {e.contact && <Kontaktuppgifter contact={e.contact} name={e.name} />}

        {/*
          Verksamhetens egna uppgifter står EFTER hela kontrollberättelsen.

          Ordningen är ett påstående, samma som gäller bilder och omdömen: det
          kommunen funnit först, det verksamheten själv säger sedan. En
          presentation som stod ovanför bedömningen hade läst som en ingress
          till den, och det är precis vad den aldrig får vara.

          Tomt i HTML-filen och fyllt i webbläsaren. Avsnittet syns inte alls
          på de sidor där ingen skickat in något, alltså på nästan alla. Se
          Foretagsuppgifter.astro.
        */}
        <Foretagsuppgifter establishmentId={e.id} />

        {/*
          Verksamhetens egna bilder, direkt efter dess egna uppgifter och före
          gästernas bilder. De två bildavsnitten delar varken tabell eller kod;
          se Foretagsbilder.astro.
        */}
        <Foretagsbilder establishmentId={e.id} establishmentName={e.name} />

        {/*
          Bilderna står FÖRE omdömena och efter kartan.

          De hör till stället och inte till ett enskilt omdöme, alltså hör de
          hemma bland det som beskriver stället. Att de ändå ligger nedanför
          kontrollberättelsen följer samma ordning som resten av sidan: det vi
          själva räknat fram först, det besökarna bidragit med sedan.

          Tomt i HTML-filen och fyllt i webbläsaren, precis som omdömena, och
          avsnittet syns inte alls på de allra flesta sidor. Se Bilder.astro.
        */}
        <Bilder establishmentId={e.id} establishmentName={e.name} />

        {/*
          Omdömen ligger SIST i huvudkolumnen, efter allt som bygger på
          kommunens data och före källhänvisningen. Ordningen är ett
          påstående: kontrollen först, åsikterna sedan, och aldrig blandade.
          Avsnittet är tomt i HTML-filen och fylls i webbläsaren, så inget en
          besökare skrivit kommer in i ett bygge. Se Reviews.astro.
        */}
        <Reviews
          establishmentId={e.id}
          establishmentName={e.name}
          municipalitySlug={kommun.slug}
        />

        {/* En rad, inte sex: när uppgifterna senast hämtades. Källa och
            metodik är fullständiga på /kallor och /metodik, länkade i
            sidfoten på varje sida. Resonemanget står i git-historiken. */}
        <footer class="source">
          <p class="caption text-muted">
            Uppdaterat {formatDate(source.fetchedAt.slice(0, 10))}.
          </p>
        </footer>
      </main>

      <aside class="side">
        <div class="panel">
          {e.image && <StreetPhoto image={e.image} name={e.name} />}
          <ActionPanel
            establishmentId={e.id}
            establishmentName={e.name}
            municipalitySlug={kommun.slug}
          />
        </div>

        {/* `data-nosnippet`: panelen är en väg vidare, inte sidans svar.
            Listan är namn och avstånd till andra ställen, och i ett sökresultat
            för DEN HÄR verksamheten säger den ingenting. Google byggde ett
            sådant utdrag för The Coffice Albano, om än ur jämförelserutan, se
            JamforRuta.astro. Attributet påverkar bara utdraget: sidan
            indexeras som förut och länkarna räknas som förut. */}
        {neighbours.length > 0 && (
          <div class="panel" data-nosnippet>
            <h2 class="panel-title">
              Närliggande
              <InfoTip
                label="närliggande"
                text="Verksamheter med registrerad kontroll inom gångavstånd, sorterade efter avstånd."
              />
            </h2>
            <ul class="near">
              {neighbours.map((n) => (
                <li>
                  <a href={path(kommun.slug, n.slug)}>
                    <FaceMark verdict={n.verdict} size={30} variant="round" />
                    <span class="near-info">
                      <b>{n.name}</b>
                      <span class="text-muted">{formatDistance(n.metres)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            {/* Jämförelsen hör hemma här och inte i handlingsraden, som är
                låst vid två knappar av dokumenterade skäl. Panelen handlar om
                andra ställen, vilket är precis vad en jämförelse gör.
                Adressen bär kommunen, och det är den som gör jämförelsen
                ärlig: se lib/jamfor.ts. */}
            <p class="near-foot caption">
              <a data-jamfor href={compareHref(kommun.slug, e.slug)}>Jämför med ett annat ställe</a>
            </p>
          </div>
        )}

        <div class="panel">
          <h2 class="panel-title">Så ser det ut i {kommun.city}</h2>
          {dist.length > 0 && (
            <>
              {/* Talet först, bandet under, teckenförklaringen sist.

                  Rutan ritade förut sin egen statistikform: ett tal i --fs-h-s
                  över en caption, en 8 px linje och tre täta rader med prick,
                  tal och etikett. Ägaren tyckte den var ful, och den var
                  dessutom sajtens tredje sätt att teckna samma sak. Nu står
                  bandet och teckenförklaringen i den form kommunhubben fick
                  och ägaren godkände, och talet i bandets egen nyckeltalsform.

                  Talet får vara stort här, tvärtemot vad som stod i filen
                  förut. Skälet till 21 px var att en panel i en aside inte ska
                  ha något hjältetal, men 21 px över en caption på 13 var
                  varken tal eller etikett. Nyckeltal.astro håller Ednias och
                  Stripes förhållande, 32 över 14 med åtta pixlar emellan, och
                  det läser som ett nyckeltal utan att tävla med sidans egen
                  rubrik, som står i en annan spalt.

                  Staden står i panelrubriken och därför inte i etiketten. Ett
                  ortsnamn två gånger på samma tre rader är brus. */}
              <Nyckeltal
                kompakt
                tal={[{
                  value: `${kommunSummary.cleanShare} %`,
                  label: `utan anmärkningar av ${formatNumber(kommunSummary.assessed)} bedömda`,
                }]}
              />

              {/* 118 px och inte förvalets 150: panelen är 300 px bred med
                  16 px padding, och med 150 hade de tre mängderna fått var sin
                  spalt under varandra i stället för att stå två och två. */}
              <Fordelning delar={dist} label={distLabel} min="118px" kompakt />
            </>
          )}
          <ul class="kommun-links">
            <li><a href={path(kommun.slug)}>Alla hygienkontroller i {kommun.city}</a></li>
            {ownCategories.map((s) => (
              <li>
                {/* `short` och inte `plural`: Övrigts plural är "verksamheter",
                    och "Alla verksamheter i Uppsala" läses som hela kommunen —
                    alltså samma sak som länken raden ovanför. */}
                <a href={path(kommun.slug, 'kategori', s.category.slug)}>
                  Alla {s.category.short} i {kommun.city}
                </a>
              </li>
            ))}
            {kedja && (
              <li>
                <a href={path('kedja', kedja.id)}>
                  Alla {formatNumber(kedja.total)} {kedja.name}
                </a>
              </li>
            )}
          </ul>
        </div>
      </aside>
    </div>

    {/* Längst ned, efter allt man kom för. Bandet ligger utanför .layout och
        kan därför aldrig skjuta ned bedömningen eller kontrollhistoriken; det
        börjar där de två spalterna tar slut. */}
    <ArtikelBanner prefer={artikelval} />
  </div>

  {/* Rutan ligger sist och utanför spalterna. Den lyfts av showModal() och
      syns aldrig förrän någon ber om den. */}
  {compareWith.length > 0 && (
    <JamforRuta
      establishment={e}
      kommunSlug={kommun.slug}
      city={kommun.city}
      suggestions={compareWith}
      metres={compareMetres}
    />
  )}
</Base>

<script>
  /**
   * Länkarna till jämförelsen öppnar rutan i stället för att lämna sidan.
   *
   * Båda ingångarna, den vid nyckeltalen och den i närliggande-panelen, bär
   * `data-jamfor` och är riktiga länkar till /jamfor/ med det här stället
   * ifyllt. Går skriptet inte fram leder de dit de säger.
   *
   * Modifierade klick lämnas i fred: den som cmd-klickar vill ha en ny flik,
   * och en ruta i den här fliken är inte det hen bad om.
   */
  import { openCompareDialog } from '../../lib/jamfor-dialog';

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-jamfor]')) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
        return;
      }
      if (openCompareDialog(link)) event.preventDefault();
    });
  }
</script>

<style>
  .page {
    max-width: var(--w-wide);
    padding-block: var(--s-6) var(--s-16);
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-caption);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
  }

  .crumbs a { color: var(--text-secondary); }

  /* Namnet till vänster, Följ och Dela till höger, botten mot botten. Bryts
     till två rader först när namnet inte längre får plats bredvid dem. */
  .topp {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    flex-wrap: wrap;
  }

  .masthead h1 {
    font-size: var(--fs-title);
    line-height: var(--lh-title);
    letter-spacing: -.024em;
  }

  .place {
    margin-top: var(--s-1);
    font-size: var(--fs-body-s);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--s-12);
    align-items: start;
    /* Luften under topraden bärs här och ingen annanstans. Den satt förut på
       handlingsraden, men när knapparna flyttade upp bredvid namnet blev
       avståndet till "Bedömning" så litet att etiketten läste som en tredje
       rad i metaraden. */
    margin-top: var(--s-8);
  }

  /* Huvudkolumnen ligger öppet på sidan — ingen kortlåda. Det är Boolis
     grepp: sektionerna skiljs av hårlinjer och luft, och lugnet kommer av
     att ingenting är inramat. Sidopanelens paneler ÄR kort, och kontrasten
     däremellan är det som gör att panelen läser som verktyg. */
  /* :global krävs — Astros scopeade selektorer korsar inte komponentgränser. */
  .main > :global(* + *) {
    margin-top: var(--s-8);
    padding-top: var(--s-8);
    border-top: 1px solid var(--hairline);
  }

  /* Ingen versalisering här, till skillnad från .eyebrow i tokens.
     Etiketten står över sidans viktigaste besked och läses tillsammans med
     nyckeltalens etiketter strax under, som säger "Kontroller" och
     "Återbesök" i vanlig gemen. VERSALER plus halvfet gjorde att den vägde
     tyngre än beskedet den introducerar, och de två etikettsorterna kändes
     som två olika sajter. */
  .statement .eyebrow {
    margin-bottom: var(--s-3);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  /* Märket i höjd med beskedet, inte mitt i textblocket.
     `center` centrerade det mot hela blocket, alltså mot rubriken PLUS
     svarsmeningen under, och då hamnade märket en bit under den rad det hör
     ihop med. Ägaren såg det direkt. Nu ligger överkanterna i linje och
     märket nudgas ned till rubrikens optiska mitt. */
  .verdict {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .verdict > :global(.face) { margin-top: 2px; }

  .besked { flex: 1 1 auto; }

  /* På telefon får sigillet inte konkurrera med beskedet om bredden, och det
     ska ned på egen rad. Ett `flex-wrap` gör fel sak här: beskedet är brett
     nog att kräva egen rad, så ansiktet blir ensamt kvar på den första.
     Rutnätet håller ihop ansiktet och beskedet och lägger sigillet under
     texten, i linje med den och inte med ansiktet.

     `:global` krävs på sigillet: det är en komponentrot, och Astros scopeade
     selektorer korsar inte komponentgränser. */
  @media (max-width: 640px) {
    .verdict {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--s-4);
      row-gap: var(--s-3);
      /* `start` och inte `center`.

         Mätt vid 375 px: beskedet är 112 px högt och märket 52, och med
         `center` hamnade märket 31 px under textens överkant, alltså svävande
         mitt i stycket i stället för bredvid rubriken det hör till.
         Skrivbordsläget några rader upp gör tvärtom, `flex-start` plus två
         pixlars nudge, och de två lägena ska inte säga emot varandra.
         Ägaren: "ser ful ut på mobil, dåligt alignad typ." */
      align-items: start;
    }

    /* Nudgen som gör att märkets optiska mitt möter rubrikens, samma två
       pixlar som skrivbordsläget. Regeln ovanför gäller båda, men den ligger
       före mediefrågan och skulle annars slås ut av `align-items` här. */
