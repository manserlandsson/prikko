---
/**
 * Rikskartan.
 *
 * Den enda sida som tillkommer av hela rutpyramiden, och den tillkommer för
 * att "karta över restauranger i Sverige" är en sökning. Inte för att
 * funktionen behöver en adress: funktionen finns redan på varje kommuns
 * kartsida, och ägarens princip är att sidor köps för SEO och aldrig för
 * funktioner. Se docs/23_rikskartan.md del 4.
 *
 * Ytan är densamma som `/<kommun>/karta/` in i minsta detalj: samma komponent,
 * samma arkiv, samma beteende. Det som skiljer är utsnittet den öppnar på och
 * att listan serverrenderar KOMMUNERNA med sina tal i stället för sextio
 * verksamheter. Skälet står i Karta.astro vid `kommunrader`: på hela landets
 * zoom ligger varenda punkt i en bubbla, alltså är kortlistan tom, och en tom
 * app-yta är precis den tunna sida kvalitetsgrinden finns för att hålla borta.
 *
 * `/<kommun>/karta/` omdirigeras INTE hit. Adresserna är publicerade och
 * crawlade, frågan "karta över hygienkontroller i Linköping" finns och har en
 * sida som svarar exakt på den, och en 301 hit hade indexerat rikskartan tolv
 * gånger under tolv olika frågor. Se `docs/adr/0003-slugen-ar-permanent.md`.
 */
import Base from '../layouts/Base.astro';
import Karta from '../components/Karta.astro';
import { formatNumber } from '../lib/data';
import { utsnitt } from '../lib/kartrutor';
import { absolute } from '../lib/urls';

/* Utan slug ger `utsnitt()` hela riket. Rikskartan kan inte sakna punkter så
   länge en enda kommun har koordinater, alltså finns ingen tom-gren här som
   motsvarigheten i `[kommun]/karta.astro` har. */
const data = utsnitt()!;

const title = 'Karta över hygienkontroller i Sverige';
const description =
  `Karta med ${formatNumber(data.count)} restauranger och livsmedelsverksamheter i Sverige. ` +
  `Varje nål visar hur verksamheten klarade sin senaste hygienkontroll.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
    { '@type': 'ListItem', position: 2, name: 'Karta' },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd} footer={false}>
  <div class="page">
    {/*
      Brödsmulorna och rubriken ligger i listkolumnen, inte ovanför kartan.

      Booli har ingenting alls ovanför sin delade vy: kartan börjar direkt
      under sidhuvudet och det första i vänsterkolumnen är flikraden. Vi kan
      inte ta bort rubriken, den är sidans SEO-svar på "karta över
      hygienkontroller i Sverige", men vi kan låta den kosta listans höjd i
      stället för kartans. Slotten finns i Karta.astro.
    */}
    <Karta data={data}>
      <Fragment slot="topp">
        <nav class="crumbs" aria-label="Brödsmulor">
          <a href="/">Prikko</a>
        </nav>
        <h1>Karta över hygienkontroller i Sverige</h1>
      </Fragment>
    </Karta>
  </div>
</Base>

<style>
  /* Måtten är kommunens kartsidas, ordagrant, eftersom det är samma yta. Se
     motiveringen där: app-yta och inte dokument, ingen sidskroll, sidfoten
     avstängd via Base-propen footer, --h-bar plus en pixel för sidhuvudet
     och dess hårlinje. */
  .page {
    display: flex;
    flex-direction: column;
    /* Sidhuvudets rad plus dess hårlinje. Raden är en token sedan
       2026-08-18, se --h-bar i tokens.css; talet stod förr som 59. */
    height: calc(100dvh - var(--h-bar) - 1px);
    /*
     * KANT I KANT. Booli, uppmätt 2026-08-25: deras kartomslag är
     * `position: fixed` med `top: 64px; right: 0; bottom: 0`, alltså ligger
     * kartan an mot fönstrets högerkant och underkant på varje bredd.
     *
     * Vår sida låg i `.container`, alltså 1400 px bred med 48 px gutter på båda
     * sidor och centrerad. På en 1920-skärm betydde det 308 px tom yta till
     * höger om kartan och 48 px till vänster om den, medan Boolis karta där är
     * 1217 px bred. Det var den enskilt största skillnaden i hur stor kartan
     * KÄNNS, och den kostade ingenting att ha.
     *
     * Kolumnernas egen luft flyttar därför in i listkolumnen, se .lista i
     * Karta.astro. Kartan ska inte ha någon.
     */
  
    max-width: none;
    padding: 0;
  }

  .crumbs {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    font-size: var(--fs-body-s);
    color: var(--text-muted);
  }

  h1 {
    margin-block: var(--s-1) var(--s-4);
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  /* Under 900 px tar arket över, se arkavsnittet i Karta.astro. Sidan bakom
     ska då inte skrolla alls, och rubriken står kvar i dokumentet men ute ur
     vyn: den är sidans H1 och får inte tas bort. */
  @media (max-width: 900px) {
    .page {
      height: auto;
      display: block;
      padding-block: var(--s-4);
    }

    .page:has(.split.ark) {
      height: 100dvh;
      padding: 0;
      overflow: hidden;
    }

    .page:has(.split.ark) .crumbs,
    .page:has(.split.ark) h1 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
