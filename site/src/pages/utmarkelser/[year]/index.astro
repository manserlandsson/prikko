---
/**
 * En årsutgåva av hederslistan.
 *
 * Sidan läser INTE beståndet. Den läser den frysta filen i src/editions/, och
 * det är hela poängen: en verksamhet som fick märket den 3 augusti 2026 ska
 * kunna slås upp här om fem år, oavsett hur många kontroller som skett sedan
 * dess. Se lib/utmarkelser.ts och scripts/utmarkelser.mjs.
 *
 * Nuläget finns kvar och står på verksamhetens egen sida. De två svarar på
 * olika frågor och får inte slås ihop.
 */
import Base from '../../../layouts/Base.astro';
import AwardList from '../../../components/AwardList.astro';
import AwardSeal from '../../../components/AwardSeal.astro';
import { formatDate, formatNumber } from '../../../lib/data';
import { SITE } from '../../../lib/site';
import { absolute, path } from '../../../lib/urls';
import {
  awardRevision,
  awardTarget,
  barRange,
  capitalise,
  edition,
  editionFacts,
  editions,
  freshnessYears,
  numeral,
  runGroups,
  topGroups,
} from '../../../lib/utmarkelser';

export function getStaticPaths() {
  return editions().map((e) => ({ params: { year: String(e.year) } }));
}

const { year } = Astro.params;
const e = edition(year!);
const facts = editionFacts(e.year);

/* Ribborna, aldrig siffror i löptext. Sidan sade "tre" medan utgåvan krävde
   fem, och sedan modell 3 finns inget gemensamt tal alls: varje kommuns ribba
   står i sin egen sektion. Här bara spannet. Se barFor och barRange. */
const range = barRange(e.year);
const rangeWords =
  range.min === range.max
    ? numeral(range.min)
    : `${numeral(range.min)} till ${numeral(range.max)}`;
const targetPct = numeral(Math.round(awardTarget(e.year) * 100));
/* Omräkningen står i utgåvan. En lista som ändrat storlek utan ett ord om saken
   är en lista man slutar tro på. */
const revision = awardRevision(e.year);

const sections = facts.listed.map((m) => {
  const groups = runGroups(m.qualified);
  const excerpt = m.ownPage ? topGroups(groups) : groups;
  const shown = excerpt.reduce((n, g) => n + g.entries.length, 0);
  return { m, groups, excerpt, shown };
});

const description =
  `${formatNumber(e.totals.qualified)} verksamheter i ${facts.listed.length} kommuner har den ` +
  `längsta obrutna raden av kontroller utan anmärkning i sin kommun. Prikkos utmärkelse ` +
  `${e.year}, fryst ${formatDate(e.asOf)}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Utmärkelsen ${e.year}`,
  description,
  inLanguage: 'sv-SE',
  url: absolute('utmarkelser', e.year),
  datePublished: e.asOf,
  publisher: { '@type': 'Organization', name: SITE.legalName },
  isBasedOn: {
    '@type': 'Dataset',
    name: 'Livsmedelskontroller i Sverige, normaliserade av Prikko',
    url: absolute('kallor'),
  },
};
---

<Base title={`Utmärkelsen ${e.year}`} description={description} jsonLd={jsonLd} dataUpdated={e.asOf}>
  <article class="container page">
    <header>
      <p class="eyebrow">
        <a href={path('utmarkelser')}>Utmärkelser</a> · fryst {formatDate(e.asOf)}
      </p>
      <h1>Utmärkelsen {e.year}</h1>
      <p class="lede text-secondary">
        {formatNumber(e.totals.qualified)} verksamheter i {facts.listed.length} kommuner
        hade vid frysningen den längsta obrutna raden av kontroller utan en enda
        anmärkning i sin kommun. Listan står still. Så här såg det ut
        {' '}{formatDate(e.asOf)}.
      </p>
      <p class="lede-note text-secondary">
        Ribban är {rangeWords} kontroller i rad beroende på kommun, satt så att
        utmärkelsen går till högst {targetPct} procent av de bedömda
        verksamheterna i varje kommun. Talet står överst i varje kommuns
        avsnitt. <a href={`${path('utmarkelser')}#ribban`}>Varför ribban är
        olika</a>.
      </p>
      {revision && (
        <p class="revision">
          Listan frystes {formatDate(revision.frozen)} med
          {' '}{formatNumber(revision.originalQualified ?? revision.previousQualified)}
          {' '}verksamheter. Modellen har rättats sedan dess, senast
          {' '}{formatDate(revision.revised)}, sedan den visat sig mäta hur ofta
          kommunen kontrollerade i stället för hur verksamheterna sköttes. Vid
          den omräkningen gick listan från
          {' '}{formatNumber(revision.previousQualified)} till
          {' '}{formatNumber(e.totals.qualified)} verksamheter:
          {' '}{formatNumber(revision.removed)} togs bort och
          {' '}{formatNumber(revision.added)} tillkom.
          {revision.lossesAccepted && (
            <> {revision.lossesAccepted.reason} Det är enda gången listan öppnas;
            härefter kan en verksamhet inte förlora sin plats i den.</>
          )}
        </p>
      )}
    </header>

    <nav class="jump" aria-label="Kommuner i utgåvan">
      {sections.map(({ m }) => (
        <a href={`#${m.slug}`}>{m.city} <span class="text-secondary">{formatNumber(m.qualified.length)}</span></a>
      ))}
    </nav>

    {sections.map(({ m, groups, excerpt, shown }) => (
      <section id={m.slug} class="kommun">
        <h2>
          {m.city}
          <span class="tally text-secondary">
            {formatNumber(m.qualified.length)}
            {' '}{m.qualified.length === 1 ? 'utmärkt' : 'utmärkta'}
          </span>
        </h2>
        <p class="bar">
          Ribban i {m.city}: {numeral(m.awardRun ?? 0)} kontroller i rad utan
          anmärkning. Kommunen publicerar upp till
          {' '}{numeral(m.maxHistory)} kontroller per verksamhet.
        </p>
        <p class="intro text-secondary">
          {/* `pool` räknas i scripts/utmarkelser.mjs mot kommunens egen ribba.
              Talet i meningen måste följa med den. */}
          {formatNumber(m.qualified.length)} av de {formatNumber(m.pool)} som
          alls hunnit kontrolleras så många gånger klarade samtliga de senaste
          utan anmärkning. <a href={path(m.slug)}>Alla kontroller i {m.city}</a>.
        </p>

        {excerpt.length > 0 ? (
          <AwardList groups={excerpt} kommun={m.slug} level={3} />
        ) : (
          <p class="intro text-secondary">
            {groups.length === 1
              ? `Samtliga ${formatNumber(m.qualified.length)} har ${numeral(groups[0].run)} kontroller i rad, alltså allt kommunen publicerar. Ingen av dem står före någon annan.`
              : `Den längsta serien i ${m.city} är ${numeral(m.topRun)} kontroller i rad. Hela listan står på kommunens egen sida.`}
          </p>
        )}

        {m.ownPage && (
          <p class="more">
            <a href={path('utmarkelser', e.year, m.slug)}>
              Hela listan för {m.city}, {formatNumber(m.qualified.length)} verksamheter
            </a>
            {shown > 0 && <span class="text-secondary"> · {shown} visas här</span>}
          </p>
        )}
      </section>
    ))}

    <section class="seal-block">
      <AwardSeal year={e.year} width={200} decorative />
      <div>
        <h2>Märket för {e.year}</h2>
        <p>
          Står verksamheten i listan ovan får den använda märket. Årtalet säger
          att den fanns med i {e.year} års utgåva, inte hur det ser ut i dag, så
          ett märke som sitter kvar i ett fönster kan inte bli osant.
        </p>
        {/* Länken gick förut rakt till SVG-filen. Den ensam räckte inte: en
            verksamhet som laddat ner ritningen har fortfarande varken koden som
            lägger den på en sajt, en PNG att skriva ut eller villkoren. Allt
            det står på emblemsidan, och filen ligger kvar som första rad där. */}
        <p>
          <a href={path('utmarkelser', 'emblem')}>Hämta märket och koden till din sajt</a>
        </p>
      </div>
    </section>

    <section>
      <h2>Kommunerna som inte är med</h2>
      {facts.impossible.length > 0 && (
        <>
          <p>
            I {numeral(facts.impossible.length)}
            {' '}{facts.impossible.length === 1 ? 'kommun' : 'kommuner'} kan
            utmärkelsen inte nås alls. Det beror på vad kommunen publicerar,
            inte på verksamheterna där.
          </p>
          <ul class="plain">
            {facts.impossible.map((m) => (
              <li>{m.blocked} <a href={path(m.slug)}>Se {m.city}</a>.</li>
            ))}
          </ul>
        </>
      )}
      {facts.noneYet.length > 0 && (
        <>
          <p>
            I {numeral(facts.noneYet.length)}
            {' '}{facts.noneYet.length === 1 ? 'kommun' : 'kommuner'} är
            utmärkelsen möjlig, men ingen hade nått den vid frysningen.
          </p>
          <ul class="plain">
            {facts.noneYet.map((m) => (
              <li>
                Ribban i {m.name} är {numeral(m.awardRun ?? 0)} kontroller i rad.
                {' '}{m.pool === 0 ? 'Ingen' : capitalise(numeral(m.pool))} av
                {' '}{formatNumber(m.establishments)} verksamheter har alls
                kontrollerats så många gånger med en kontroll färsk nog att
                bedöma. <a href={path(m.slug)}>Se {m.city}</a>.
              </li>
            ))}
          </ul>
        </>
      )}
      {facts.missingFromEdition.length > 0 && (
        <p>
          Sedan utgåvan frystes har Prikko tagit in
          {' '}{facts.missingFromEdition.join(', ')}. De kunde inte vara med i
          {' '}{e.year} års lista och står först i nästa.
        </p>
      )}
    </section>

    <section class="method">
      <h2>Hur utgåvan är gjord</h2>
      <p>
        {capitalise(rangeWords)} kontroller i rad utan anmärkning beroende på
        kommun, och en kontroll gjord de senaste
        {' '}{numeral(freshnessYears(e.year))} åren, räknat ur
        {' '}{formatNumber(e.totals.establishments)} verksamheter i
        {' '}{e.totals.municipalities} kommuner. Utgåvan står still; nuläget står
        på varje verksamhets egen sida.
        {' '}<a href={path('utmarkelser')}>Varför listan ser ut så här</a>.
      </p>
      <p>
        <a href={path('metodik')}>Så räknas bedömningen fram</a> ·
        {' '}<a href={path('kallor')}>Källor och uppdatering</a> ·
        {' '}<a href={path('ratta')}>Rätta en uppgift</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .page {
    max-width: var(--w-read);
    padding-block: var(--s-12) var(--s-16);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-top: var(--s-2);
  }

  .eyebrow a {
    color: inherit;
  }

  .lede {
    margin-top: var(--s-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .lede-note {
    margin-top: var(--s-3);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  /* Kommunens ribba står först i avsnittet, inte i en fotnot. En läsare ska
     aldrig behöva gissa varför Stockholm kräver åtta och Uppsala fyra. */
  .bar {
    margin-bottom: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
  }

  /* Rättelsen står i sidhuvudet, inte längst ner. Den som såg listan i går ska
     möta förklaringen innan listan, inte efter den. */
  .revision {
    margin-top: var(--s-4);
    padding: var(--s-4);
    background: var(--card);
    border-left: 3px solid var(--verdict-none);
    border-radius: 0 var(--r-control) var(--r-control) 0;
    font-size: var(--fs-body-s);
    line-height: 21px;
    color: var(--text-secondary);
  }

  /* Hoppnavigering. Utgåvan är lång, och utan den måste läsaren rulla förbi
     Stockholm för att hitta sin egen kommun. */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .jump a {
    display: inline-flex;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--card);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text);
  }

  .jump a:hover {
    border-color: var(--brand);
    color: var(--brand-ink);
    text-decoration: none;
  }

  .jump span {
    font-variant-numeric: tabular-nums;
  }

  section {
    margin-top: var(--s-12);
  }

  section h2 {
    margin-bottom: var(--s-4);
  }

  section p {
    line-height: var(--lh-body);
  }

  section p + p {
    margin-top: var(--s-4);
  }

  .kommun h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-3);
    margin-bottom: var(--s-2);
  }

  .tally {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .intro {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    margin-bottom: var(--s-6);
  }

  .more {
    margin-top: var(--s-4);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .seal-block {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    padding: var(--s-6);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
  }

  .seal-block h2 {
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
    margin-bottom: var(--s-2);
  }

  .seal-block p {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .seal-block p + p {
    margin-top: var(--s-3);
  }

  .plain {
    margin: var(--s-4) 0 0;
    padding-left: var(--s-4);
  }

  .plain li {
    margin-top: var(--s-3);
    line-height: var(--lh-body);
  }

  .method {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .method h2 {
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  .method p {
    line-height: 22px;
    color: var(--text-secondary);
  }

  .method p + p {
    margin-top: var(--s-3);
  }

  @media (max-width: 560px) {
    .seal-block {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
