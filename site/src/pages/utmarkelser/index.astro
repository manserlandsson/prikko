---
/**
 * Utmärkelsens hemvist: vad den är, vem som kan få den, och vilka utgåvor som
 * finns.
 *
 * Sidan är avsiktligt skild från utgåvan. Utgåvan är ett påstående om ett
 * datum och står still; den här sidan beskriver regeln och räknas om vid varje
 * bygge, precis som resten av sajten. Blandades de två skulle antingen regeln
 * frysa eller listan börja röra sig.
 */
import Base from '../../layouts/Base.astro';
import AwardSeal from '../../components/AwardSeal.astro';
import Maskot from '../../components/Maskot.astro';
import { coverage, formatDate, formatNumber } from '../../lib/data';
import { SITE } from '../../lib/site';
import { absolute, path } from '../../lib/urls';
import { dataUpdated } from '../../lib/rapporter';
import {
  awardRevision,
  awardTarget,
  barRange,
  capitalise,
  editionFacts,
  editions,
  latestEdition,
  numeral,
} from '../../lib/utmarkelser';

const all = editions();
const latest = latestEdition();
if (!latest) throw new Error('Ingen utgåva finns. Kör scripts/utmarkelser.mjs.');

const facts = editionFacts(latest.year);

/* Ribborna läses ur utgåvan, aldrig ur löptexten. Talet stod skrivet som "tre"
   på sex ställen här medan utgåvan krävde fem, så sidan motsade sina egna
   datadrivna stycken. Sedan modell 3 är ribban dessutom olika i olika kommuner,
   och den här sidan får därför bara tala om spannet. Varje kommuns eget tal står
   på kommunens egen sida. Se barFor och barRange i lib/utmarkelser.ts. */
const range = barRange(latest.year);
const rangeWords =
  range.min === range.max
    ? numeral(range.min)
    : `${numeral(range.min)} till ${numeral(range.max)}`;
/** Måltalet ribborna härleds ur. Skrivs som ord, enligt svensk skrivregel. */
const targetPct = numeral(Math.round(awardTarget(latest.year) * 100));
/* Omräkningen av 2026 står i utgåvan, inte i en mening någon skrivit här. Se
   revision i scripts/utmarkelser.mjs. */
const revision = awardRevision(latest.year);
/**
 * Längsta rena serien i hela utgåvan, med de år den tog.
 *
 * Talen står tillsammans med avsikt. Enbart serielängden hade inte visat något:
 * ett fönster på tre år rymmer sexton kontroller i Stockholm, där de tätast
 * kontrollerade verksamheterna har 28 inom fönstret. Det är tiden serien
 * spänner över som den gamla regeln stängde ute.
 */
const longestEntry = facts.listed
  .flatMap((m) => m.qualified)
  .reduce<(typeof facts.listed)[number]['qualified'][number] | null>(
    (best, q) => (best === null || q.run > best.run ? q : best),
    null,
  );
const longestYears = longestEntry
  ? Math.round(
      (Date.parse(longestEntry.to) - Date.parse(longestEntry.from)) / (365.25 * 864e5),
    )
  : 0;
const total = coverage();
const updated = dataUpdated();

/** Andelen bedömda som nådde utmärkelsen. Räknas på hela beståndet, aldrig
 *  per kommun: en kommunvis andel är precis den jämförelse som inte håller. */
const share = ((latest.totals.qualified / latest.totals.assessed) * 100)
  .toFixed(1)
  .replace('.', ',');

const description =
  `${formatNumber(latest.totals.qualified)} verksamheter i ${facts.listed.length} kommuner har ` +
  'den längsta obrutna raden av kontroller utan anmärkning i sin kommun. Prikkos utmärkelse är ' +
  'räknad ur kommunernas egna kontrolluppgifter och fryses en gång om året.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Utmärkelsen för genomgående skötsamhet',
  description,
  inLanguage: 'sv-SE',
  url: absolute('utmarkelser'),
  publisher: { '@type': 'Organization', name: SITE.legalName },
  hasPart: all.map((e) => ({
    '@type': 'CollectionPage',
    name: `Utmärkelsen ${e.year}`,
    url: absolute('utmarkelser', e.year),
    datePublished: e.asOf,
  })),
};
---

<Base
  title="Utmärkelsen för genomgående skötsamhet"
  description={description}
  jsonLd={jsonLd}
  dataUpdated={updated}
>
  <article class="container page">
    <header>
      <p class="eyebrow">Utmärkelser</p>
      <h1>Utmärkelsen för genomgående skötsamhet</h1>
      <p class="lede text-secondary">
        De verksamheter som har längst obruten rad av kontroller utan en enda
        anmärkning i sin kommun. {formatNumber(latest.totals.qualified)} stycken,
        alltså {share} procent av de {formatNumber(latest.totals.assessed)} som
        gick att bedöma när {latest.year} års utgåva frystes.
      </p>
    </header>

    <section class="seal-block">
      <AwardSeal year={latest.year} width={200} decorative />
      <div>
        <h2>{latest.year} års utgåva</h2>
        <p>
          Fryst {formatDate(latest.asOf)}. {formatNumber(latest.totals.qualified)}
          {' '}verksamheter i {facts.listed.length} av {latest.totals.municipalities}
          {' '}kommuner.
        </p>
        <p>
          <a href={path('utmarkelser', latest.year)}>Se hela {latest.year} års lista</a>
        </p>
      </div>
    </section>

    <section>
      <h2>Vad som krävs</h2>
      <p>
        Kontroller i rad utan en enda anmärkning, och en kontroll som är färsk
        nog att bedöma, alltså gjord de senaste tre åren. Hur lång tid raden tog
        spelar ingen roll: en verksamhet som kontrollerats en gång om året i
        åtta år räknas lika som en som hunnit lika många på halva tiden.
      </p>
      <p>
        Hur många kontroller som krävs är däremot inte samma tal i hela landet.
        Det avgörs av kommunens egen data, och landar i {latest.year} års utgåva
        på {rangeWords} kontroller.
        {' '}<a href="#ribban">Varför ribban är olika</a>.
      </p>
      <p>
        Att tiden inte räknas är en rättelse. Tidigare krävdes fem kontroller
        inom en treårsperiod, och den regeln mätte hur ofta kommunen kom på
        besök i stället för hur verksamheten sköts. En verksamhet som
        inspekteras ungefär en gång om året nådde aldrig upp, hur ren varje
        kontroll än var.
        {longestEntry && (
          <>
            {' '}Den längsta raden i utgåvan är {formatNumber(longestEntry.run)}
            {' '}kontroller över {numeral(longestYears)} år.
          </>
        )}
      </p>
      <p>
        Utmärkelsen påverkar aldrig hygienbedömningen: nuläget avgör
        bedömningen, historiken avgör erkännandet. En verksamhet utan
        utmärkelse har alltså inte fått något omdöme av oss.
        {' '}<a href={path('metodik')}>Hela modellen står på metodiksidan</a>.
      </p>
      <p class="callout">
        Någon lista över de verksamheter som klarat sig sämst finns inte, och
        kommer inte att finnas. En anmärkning hör hemma på verksamhetens egen
        sida, tillsammans med kommunens ord och verksamhetens svar.
      </p>
    </section>

    <section id="ribban">
      {/* Figuren står HÄR och inte i sidhuvudet, och båda skälen är hårda.
          Sidhuvudet följs direkt av märket i 200 px, och två blå figurer i rad
          läser som ett par och inte som en avsändare och ett emblem. Och det
          här avsnittet är det enda på sidan där tjänsten förklarar sitt eget
          resonemang, alltså samma sorts yta som metodikens granskare, samma
          pose och samma form.

          Ingen verksamhet nämns någonstans på sidan: de namngivna är
          KOMMUNER, och listorna med verksamheter ligger på egna sidor som
          inte får någon figur.

          Det som docs/24 §6 lämnar öppet för ägaren är EMBLEMET, alltså den
          fil en verksamhet laddar ner och sätter i sitt fönster. Den frågan är
          orörd av det här: emblemet ritas i lib/marke.ts och har ingen
          grävling. */}
      <Maskot pose="soker" size={80} class="avsandare" />
      <h2>Varför ribban är olika i olika kommuner</h2>
      <p>
        Utgåvan är en lista per kommun, och ribban räknas fram ur den kommunens
        egen data. Skälet är att ett gemensamt tal inte mäter det man tror att
        det mäter. Kommunerna kontrollerar olika ofta och publicerar olika
        djupt, så samma tal blir en låg tröskel på ett ställe och en omöjlighet
        på ett annat.
      </p>
      {facts.lowestCeiling && facts.highestCeiling && (
        <p>
          Skillnaden står i registren. {facts.lowestCeiling.name} lämnar aldrig
          ut fler än {numeral(facts.lowestCeiling.maxHistory)} kontroller per
          verksamhet, i {facts.highestCeiling.city} publiceras upp till
          {' '}{formatNumber(facts.highestCeiling.maxHistory)}. Ett krav på fem
          kontroller i rad, som utgåvan hade tidigare, gav Stockholm en lista på
          var sjunde bedömd verksamhet och samtidigt sex kommuner där ingen
          kunde nå den, hur välskött den än var.
        </p>
      )}
      <p>
        Därför sätts ribban där utmärkelsen blir ungefär lika sällsynt överallt:
        den lägsta rad som ges till högst {targetPct} procent av kommunens
        bedömda verksamheter. Det ger {rangeWords} kontroller beroende på
        kommun, och varje kommuns eget tal står överst på dess lista.
      </p>
      <p class="callout">
        En högre ribba är inget betyg på kommunen. Den betyder att kommunen
        publicerar djupare historik och kontrollerar oftare, inte att dess kök
        är renare eller dess inspektörer strängare. Av samma skäl är ett märke
        från en kommun med lägre ribba inte värt mindre: det säger samma sak,
        nämligen att verksamheten hör till de {targetPct} procent i sin kommun
        som har längst obruten ren historik. Det är den enda jämförelse som
        datan bär.
      </p>
      <p>
        Hur lång raden är går däremot aldrig att jämföra mellan kommuner, och
        listorna är därför ordnade inom varje kommun, grupperade på antal
        kontroller i rad och i bokstavsordning inom gruppen.
        {' '}<a href={`${path('metodik')}#jamfor`}>Därför jämför vi inte
        kommuner med varandra</a>.
      </p>
    </section>

    <section>
      <h2>Kommunerna som inte kan vara med</h2>
      <p>
        I några kommuner räcker registret inte till ribban, hur den än sätts.
        Det säger inget om verksamheterna där.
      </p>
      {facts.impossible.length > 0 && (
        <ul class="plain">
          {facts.impossible.map((m) => (
            <li>{m.blocked} <a href={path(m.slug)}>Se {m.city}</a>.</li>
          ))}
        </ul>
      )}
      {facts.noneYet.length > 0 && (
        <>
          <h3>Kommuner där ingen nått den ännu</h3>
          <p>
            Här är utmärkelsen möjlig, men ingen verksamhet har den i
            {' '}{latest.year} års utgåva.
          </p>
          <ul class="plain">
            {facts.noneYet.map((m) => (
              <li>
                Ribban i {m.name} är {numeral(m.awardRun ?? 0)} kontroller i rad.
                {' '}{m.pool === 0 ? 'Ingen' : capitalise(numeral(m.pool))} av
                {' '}{formatNumber(m.establishments)} verksamheter har alls
                kontrollerats så många gånger med en kontroll färsk nog att
                bedöma. <a href={path(m.slug)}>Se {m.city}</a>.
              </li>
            ))}
          </ul>
        </>
      )}
    </section>

    <section>
      <h2>Märket</h2>
      <p>
        En verksamhet som står i en utgåva får använda märket. Årtalet säger att
        den fanns med i den utgåvan, inte hur det ser ut i dag, så ett märke som
        sitter kvar i ett fönster kan inte bli osant. Nuläget står på
        verksamhetens egen sida och räknas om vid varje uppdatering.
      </p>
      <p>
        Det finns som SVG och som PNG, och med en färdig kodsnutt för en egen
        webbplats. Villkoren står på samma sida.
      </p>
      <p>
        <a href={path('utmarkelser', 'emblem')}>Emblemet: filer, kod och villkor</a>.
      </p>
    </section>

    {all.length > 1 && (
      <section>
        <h2>Utgåvor</h2>
        <ul class="plain">
          {all.map((e) => (
            <li>
              <a href={path('utmarkelser', e.year)}>Utmärkelsen {e.year}</a>
              {' '}· {formatNumber(e.totals.qualified)} verksamheter, fryst
              {' '}{formatDate(e.asOf)}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="method">
      <h2>Hur listan är gjord</h2>
      <p>
        Utmärkelsen räknas ur samma kontrolluppgifter som varje hygienbedömning
        på Prikko. Underlaget vid bygget: {formatNumber(total.inspections)}
        {' '}kontroller vid {formatNumber(total.establishments)} verksamheter i
        {' '}{total.municipalities} kommuner, senast hämtat {formatDate(updated)}.
      </p>
      <p>
        Utmärkelsen är inte samma sak som märkningen ”ren historik” på en
        verksamhetssida. Den säger att de tre senaste kontrollerna är utan
        anmärkning och räknas om varje gång vi hämtar data; utmärkelsen kräver
        en längre rad och står still.
        {' '}<a href={`${path('metodik')}#utmarkelsen`}>Skillnaden i sin
        helhet</a>.
      </p>
      {revision?.lossesAccepted && (
        <p>
          {latest.year} års lista frystes {formatDate(revision.frozen)} med
          {' '}{formatNumber(revision.originalQualified ?? 0)} verksamheter.
          Modellen har rättats sedan dess, senast {formatDate(revision.revised)},
          då listan gick från {formatNumber(revision.previousQualified)} till
          {' '}{formatNumber(latest.totals.qualified)} verksamheter:
          {' '}{formatNumber(revision.removed)} togs bort och
          {' '}{formatNumber(revision.added)} tillkom.
          {' '}{revision.lossesAccepted.reason} En fryst lista skrivs annars
          aldrig om så att någon förlorar sin plats, och den här öppnades en
          gång.
        </p>
      )}
      <p>
        <a href={path('metodik')}>Så räknas bedömningen fram</a> ·
        {' '}<a href={path('kallor')}>Källor och uppdatering</a> ·
        {' '}<a href={path('ratta')}>Rätta en uppgift</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .page {
    max-width: var(--w-read);
    padding-block: var(--s-12) var(--s-16);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-top: var(--s-2);
  }

  .lede {
    margin-top: var(--s-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  section {
    margin-top: var(--s-12);
  }

  section h2 {
    margin-bottom: var(--s-4);
  }

  section h3 {
    margin-top: var(--s-8);
    margin-bottom: var(--s-3);
  }

  section p {
    line-height: var(--lh-body);
  }

  section p + p {
    margin-top: var(--s-4);
  }

  /* Märket och utgåvan står tillsammans: märket är inte en illustration av
     texten, det ÄR det utgåvan delar ut. */
  .seal-block {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    padding: var(--s-6);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
  }

  .seal-block h2 {
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
    margin-bottom: var(--s-2);
  }

  .seal-block p {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .seal-block p + p {
    margin-top: var(--s-3);
  }

  .plain {
    margin: var(--s-4) 0 0;
    padding-left: var(--s-4);
  }

  .plain li {
    margin-top: var(--s-3);
    line-height: var(--lh-body);
  }

  .callout {
    margin-top: var(--s-4);
    padding: var(--s-4);
    background: var(--card);
    border-left: 3px solid var(--verdict-none);
    border-radius: 0 var(--r-control) var(--r-control) 0;
    font-size: var(--fs-body-s);
    line-height: 21px;
  }

  /* Flyter till höger om avsnittets text, samma form som metodiksidan. */
  #ribban :global(.avsandare) {
    float: right;
    margin: 0 0 var(--s-3) var(--s-6);
    shape-outside: circle(50%);
  }

  /* Rutan med den viktigaste brasklappen står för sig själv. En inramad ruta
     som viker sig runt en figur läser som ett bildtextfält. */
  #ribban .callout { clear: right; }

  @media (max-width: 700px) {
    #ribban :global(.avsandare) {
      float: none;
      margin: 0 0 var(--s-3);
    }
  }

  .method {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .method h2 {
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  .method p {
    line-height: 22px;
    color: var(--text-secondary);
  }

  .method p + p {
    margin-top: var(--s-3);
  }

  @media (max-width: 560px) {
    .seal-block {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
