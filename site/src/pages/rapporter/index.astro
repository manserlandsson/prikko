---
/**
 * Rapporternas indexsida.
 *
 * Ägaren frågade efter "en index page, jag antar att det är blogg". Det här är
 * inte en blogg, och skälet står i lib/rapporter.ts: den svenska
 * hygiensökvolymen är 400 till 1 200 sökningar i månaden totalt (R2, R3), så
 * en blogg om hygien skriver för en efterfrågan som inte finns. Det vi har som
 * ingen annan har är beståndet. Rapporterna räknar på det.
 *
 * Sidan listar ur REPORTS, samma register som varje rapportsida läser sin
 * titel och beskrivning ur. En rapport kan därför inte finnas utan att synas
 * här, och listan kan inte visa en rapport som inte finns.
 */
import Base from '../../layouts/Base.astro';
import Maskot from '../../components/Maskot.astro';
import { REPORTS, dataUpdated } from '../../lib/rapporter';
import { coverage, formatDate, formatNumber } from '../../lib/data';
import { SITE } from '../../lib/site';
import { absolute, path } from '../../lib/urls';

const total = coverage();
const updated = dataUpdated();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Rapporter',
  description:
    'Sammanställningar räknade ur Prikkos bestånd av svenska livsmedelskontroller.',
  inLanguage: 'sv-SE',
  url: absolute('rapporter'),
  publisher: { '@type': 'Organization', name: SITE.legalName },
  hasPart: REPORTS.map((r) => ({
    '@type': 'Report',
    headline: r.title,
    description: r.description,
    datePublished: r.published,
    url: absolute('rapporter', r.slug),
  })),
};
---

<Base
  title="Rapporter"
  description={`Prikko räknar på ${formatNumber(total.inspections)} livsmedelskontroller från ${total.municipalities} kommuner och publicerar vad summorna visar.`}
  jsonLd={jsonLd}
  dataUpdated={updated}
>
  <article class="container page">
    <header>
      {/* `hittat` får sin första yta här, och den är rätt vald och inte bara
          ledig. Läget betyder "något hittades och det är sidans poäng", och
          det är ordagrant vad rubriken säger. docs/24 §3 hade det som
          kandidat för "en sökning som ger många träffar", vilket är en yta som
          per frekvensregeln aldrig kan få en figur: den ytan är sökresultatet
          och står på varje sökning som lyckas.

          Listan under rubriken är RAPPORTER och inte verksamheter. Varje
          rapport räknar på hela beståndet, alltså finns ingen namngiven
          verksamhet någonstans på sidan. */}
      <Maskot pose="hittat" size={88} class="avsandare" />
      <p class="eyebrow">Rapporter</p>
      <h1>Vad {formatNumber(total.inspections)} kontroller visar</h1>
      <p class="lede text-secondary">
        Det som går att räkna fram ur hela beståndet, och bara det.
      </p>
    </header>

    <section>
      <ul class="list">
        {REPORTS.map((r) => (
          <li>
            <p class="caption text-secondary">{formatDate(r.published)}</p>
            <h2><a href={path('rapporter', r.slug)}>{r.title}</a></h2>
            <p class="text-secondary summary">{r.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    {/* Datumstämpel och länkar, samma form som varje rapports fot. Raden
        räknade tidigare upp underlagets storlek och varifrån talen kommer.
        Det står på metodiken och källsidan, som länken går till. */}
    <section class="about">
      <p>
        Uppdaterad {formatDate(updated)}.
        {' '}<a href={path('kallor')}>Källorna</a> ·
        {' '}<a href={path('metodik')}>Metodiken</a> ·
        {' '}<a href={path('artiklar')}>Artiklarna</a>
      </p>
    </section>
  </article>
</Base>

<style>
  /* Se om.astro för formen. */
  header :global(.avsandare) {
    float: right;
    margin: 0 0 var(--s-3) var(--s-6);
    shape-outside: circle(50%);
  }

  @media (max-width: 700px) {
    header :global(.avsandare) {
      float: none;
      margin: 0 0 var(--s-3);
    }
  }

  /* Floaten stängs in i sidhuvudet. Rubriktexten är alltid högre än 88 px i
     dag, alltså syns raden aldrig, och det är precis skälet till att den ska
     stå: den dag någon kortar en rubrik faller figuren annars ned över
     avsnittet under utan att något varnar. */
  header::after {
    content: '';
    display: table;
    clear: both;
  }

  /* Listan börjar med en hårlinje över hela bredden. Den får aldrig dras upp
     bredvid figuren, eftersom en linje som slutar mitt i ingenting läser som
     ett fel. */
  .list { clear: right; }

  .page {
    max-width: var(--w-read);
    padding-block: var(--s-12) var(--s-16);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-top: var(--s-2);
  }

  .lede {
    margin-top: var(--s-4);
    line-height: var(--lh-body);
  }

  section {
    margin-top: var(--s-12);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list li {
    padding: var(--s-6) 0;
    border-top: 1px solid var(--hairline);
  }

  .list li:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  /* Rubriken är länken, inte en rad ovanför den. Ett kort där titeln och
     länken är olika träffytor tvingar ögat att välja, och titeln är det enda
     läsaren siktar på. */
  .list h2 {
    margin-top: var(--s-1);
  }

  .list h2 a {
    color: var(--text);
  }

  .list h2 a:hover {
    color: var(--brand-ink);
    text-decoration: none;
  }

  .summary {
    margin-top: var(--s-2);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .about {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .about p {
    line-height: 22px;
    color: var(--text-secondary);
  }
</style>
