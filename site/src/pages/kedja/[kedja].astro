---
/**
 * Kedjesidan: /kedja/[kedja].
 *
 * Sajtens enda sidtyp som skär tvärs igenom kommunerna, och den enda fråga
 * ingen kommunal livsmedelskarta kan besvara. Stockholms e-tjänst kan visa 33
 * Espresso House i Stockholm; ingen svensk yta kan visa alla 52.
 *
 * Sidan svarar på tre frågor i den ordningen:
 *
 *   Hur står kedjan sig   Antalsraden överst. Antal, aldrig ett rikssnitt.
 *   Var ligger den        Kommuntabellen, och registret längst ner.
 *   Vilka är bäst, sämst  De två listorna däremellan.
 *
 * VARFÖR INGET RIKSSNITT I PROCENT: kommunerna publicerar olika. Andelen
 * kvarstående brister varierar mellan 0,3 procent i Jönköping och 23,7 i
 * Oskarshamn, och den skillnaden speglar hur kommunen publicerar snarare än
 * hur rent det är. Ett tal som "84 % av kedjans ställen är utan anmärkning"
 * hade vägt ihop tolv publiceringspraxis till en siffra som SER jämförbar ut.
 * Kommuntabellen ställer i stället kedjan mot sin egen kommuns bestånd, där
 * täljare och nämnare kommer från samma utgivare.
 *
 * VARFÖR KOMMUNRADERNA SORTERAS PÅ ANTAL: sorterade på utfall vore tabellen
 * en rangordning av kommuner på kontrollresultat, vilket sajten aldrig
 * publicerar. Sorteringen ligger i lib/kedjor.ts, inte här.
 */
import Base from '../../layouts/Base.astro';
import EstablishmentList from '../../components/EstablishmentList.astro';
import FaceSprite from '../../components/FaceSprite.astro';
import FactGrid from '../../components/FactGrid.astro';
import KedjeLista from '../../components/KedjeLista.astro';
import { formatNumber } from '../../lib/data';
import { chain, chains, type Chain } from '../../lib/kedjor';
import { DISTINCTION, VERDICT } from '../../lib/site';
import { absolute, path } from '../../lib/urls';
import '../../styles/kedja.css';

export async function getStaticPaths() {
  return chains().map((c) => ({ params: { kedja: c.id }, props: { id: c.id } }));
}

const { id } = Astro.props as { id: string };
const k = chain(id) as Chain;

/* Skalan för staplarna i Ställen-kolumnen: den kommun där kedjan har flest
   ställen blir full bredd. Mot 100 hade allt utom den största blivit strimmor,
   och det inbördes förhållandet är det enda man läser i den kolumnen.
   Math.max på tom lista ger -Infinity, därför nollan sist. */
const storsta = Math.max(...k.municipalities.map((m) => m.total), 1);

/**
 * Självbärande första mening, skriven för att kunna citeras rakt av.
 *
 * Andelen räknas på BEDÖMDA och aldrig på totalen, av samma skäl som på
 * kategorisidan: med totalen som nämnare hade en kedja i en kommun som
 * kontrollerat lite sett sämre ut än en i en kommun som kontrollerat mycket.
 * Här står den ändå som antal och inte som procent, se filhuvudet.
 */
const remarked = k.minor + k.major;
const answer =
  `${formatNumber(k.total)} ${k.name} i ${formatNumber(k.municipalities.length)} ` +
  `${k.municipalities.length === 1 ? 'kommun' : 'kommuner'}. ` +
  `${formatNumber(k.clean)} av de ${formatNumber(k.assessed)} vi kan bedöma fick inga ` +
  `anmärkningar vid sin senaste hygienkontroll, ${formatNumber(remarked)} fick anmärkningar.`;

const title = `${k.name}, hygienkontroller`;

const crumbs = [
  { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
  { '@type': 'ListItem', position: 2, name: 'Kedjor', item: absolute('kedja') },
  { '@type': 'ListItem', position: 3, name: k.name },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: title,
    numberOfItems: k.total,
    // Bara de första posterna, med sin riktiga position i hela listan. Samma
    // gräns som kategorisidan använder.
    itemListElement: k.municipalities
      .flatMap((m) => m.items)
      .slice(0, 25)
      .map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absolute(e.municipality.slug, e.slug),
        name: e.name,
      })),
  },
];

/** Övriga kedjor, för fotens länknät. Bokstavsordning, aldrig utfall. */
const siblings = chains().filter((c) => c.id !== k.id);

/**
 * Faktaraden under huvudtalet.
 *
 * Antal ställen och antal kommuner står INTE här. De står i topprutan bredvid
 * namnet, och ett tal som redan står på sidan ska inte stå två gånger. Kvar
 * blir raden som förklarar stapeln ovanför: de tre mängder huvudtalet inte
 * räknade.
 *
 * TALEN ÄR OFÄRGADE, med flit. Fyra färgade tal på rad läser som en
 * trafikljusparad och drar ögat till den starkaste färgen i stället för till
 * det största talet. Färgen bärs i stället av fördelningsstapeln ovanför, och
 * varje mängd har sin utskrivna etikett här. Färg är aldrig ensam
 * informationsbärare (tokens.css).
 */
const facts = [
  { label: VERDICT.minor.label, value: formatNumber(k.minor) },
  { label: VERDICT.major.label, value: formatNumber(k.major) },
  { label: 'Ingen bedömning', value: formatNumber(k.unassessed) },
];

/** Fördelningsstapelns segment, i samma ordning som faktaraden läses. */
const segments = [
  { value: k.clean, color: 'var(--verdict-clean)' },
  { value: k.minor, color: 'var(--verdict-minor)' },
  { value: k.major, color: 'var(--verdict-major)' },
  { value: k.unassessed, color: 'var(--verdict-none)' },
].filter((s) => s.value > 0);
---

<Base
  title={title}
  description={answer}
  jsonLd={jsonLd}
  dataUpdated={k.latest ?? undefined}
>
  <FaceSprite />

  <div class="container kedja-page">
    <nav class="kedja-crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
      <span aria-hidden="true">›</span>
      <a href={path('kedja')}>Kedjor</a>
    </nav>

    {/* Namnet till vänster, kedjans omfång till höger. Ögonbrynet "KEDJA" som
        stod här är borta: brödsmulan säger redan var man är, och en versal
        etikett över varje sidtitel är mallens signatur och inte ett beslut. */}
    <div class="kedja-topp">
      <h1>{k.name}</h1>
      <p class="kedja-omfang">
        {formatNumber(k.total)} ställen · {formatNumber(k.municipalities.length)}{' '}
        {k.municipalities.length === 1 ? 'kommun' : 'kommuner'}
      </p>
    </div>

    <div class="kedja-main">
      {/* Sidans tyngdpunkt, där booli har priset.

          Den som slår upp Espresso House vill veta en sak först: hur många av
          kedjans ställen som klarade sin senaste kontroll. Det stod förut som
          ett av fyra lika stora tal i en rad, alltså stod det ingenstans.
          Här är det ett ANTAL i sidans största grad, med fördelningen och
          resten av talen som stöd under. Aldrig ett rikssnitt i procent, se
          filhuvudet. */}
      <section class="kedja-svar" aria-labelledby="besked">
        <p class="kedja-etikett" id="besked">Utan anmärkning vid senaste kontrollen</p>
        <p class="kedja-tal">
          {formatNumber(k.clean)}
          <span class="av">av {formatNumber(k.assessed)} bedömda</span>
        </p>
        <p class="kedja-svarsmening">{answer}</p>

        <div class="kedja-stapel" aria-hidden="true">
          {segments.map((s) => (
            <span style={`flex: ${s.value}; background: ${s.color}`}></span>
          ))}
        </div>

        <FactGrid facts={facts} />

        <p class="kedja-metod caption">
          <a href="/metodik/">Så sätts bedömningen</a>
        </p>
      </section>

      <section aria-labelledby="kommuner">
        <div class="kedja-bar">
          <h2 id="kommuner">Var {k.name} finns</h2>
          <span>
            {formatNumber(k.municipalities.length)}{' '}
            {k.municipalities.length === 1 ? 'kommun' : 'kommuner'}
          </span>
        </div>
        <table class="kedja-tabell">
          <thead>
            <tr>
              <th scope="col">Kommun</th>
              <th scope="col" class="num">Ställen</th>
              <th scope="col" class="num">Utan anmärkning</th>
              {/* Referenslinjen. Kedjans siffra betyder ingenting utan kommunens
                  egen, och kommunens egen är det ENDA tal som går att jämföra
                  mot: samma utgivare, samma publiceringspraxis. */}
              <th scope="col" class="num">Kommunen i stort</th>
            </tr>
          </thead>
          <tbody>
            {k.municipalities.map((m) => (
              <tr>
                <th scope="row">
                  <a href={path(m.municipality.slug)}>{m.municipality.city}</a>
                </th>
                {/* Stapeln ligger i Ställen-kolumnen och delar högerkant med
                    sitt eget tal, så det aldrig går att läsa den som en
                    sammanfattning av hela raden. Den bär antal ställen, det
                    tabellen redan är sorterad på, och aldrig utfall. De två
                    utfallskolumnerna får ingen stapel, och det är med flit:
                    kvarstående brister ligger på 0,3 procent i Jönköping och
                    23,7 i Oskarshamn, och den skillnaden är
                    publiceringspraxis och inte renlighet. En stapel hade
                    gjort den till en tävling. */}
                <td class="num antal">
                  {formatNumber(m.total)}
                  <span class="stallen-spar" aria-hidden="true">
                    <span style={`width:${(m.total / storsta) * 100}%`}></span>
                  </span>
                </td>
                <td class="num tyst">
                  {m.assessed > 0 ? (
                    <>{formatNumber(m.clean)} av {formatNumber(m.assessed)}</>
                  ) : (
                    '–'
                  )}
                </td>
                <td class="num tyst">
                  {m.baselineAssessed > 0 ? `${m.baseline} %` : '–'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      {k.remarks.length > 0 && (
        <section aria-labelledby="brister">
          <div class="kedja-bar">
            <h2 id="brister">Anmärkningar vid senaste kontrollen</h2>
            <span>{formatNumber(k.remarks.length)} ställen</span>
          </div>
          <KedjeLista items={k.remarks} />
        </section>
      )}

      {k.spotless.length > 0 && (
        <section aria-labelledby="ren-historik">
          <div class="kedja-bar">
            <h2 id="ren-historik">{DISTINCTION.short}</h2>
            <span>{formatNumber(k.spotless.length)} ställen</span>
          </div>
          <KedjeLista items={k.spotless} />
        </section>
      )}

      <section aria-labelledby="alla">
        <div class="kedja-bar">
          <h2 id="alla">Alla {k.name}</h2>
          <span>{formatNumber(k.total)} ställen</span>
        </div>
        {k.municipalities.map((m) => (
          <div class="group">
            <h3>
              <a href={path(m.municipality.slug)}>{m.municipality.city}</a>
              <span class="text-muted">{formatNumber(m.total)}</span>
            </h3>
            <EstablishmentList items={m.items} kommunSlug={m.municipality.slug} />
          </div>
        ))}
      </section>

      {siblings.length > 0 && (
        <nav aria-labelledby="andra">
          <div class="kedja-bar">
            <h2 id="andra">Andra kedjor</h2>
            <span><a href={path('kedja')}>Alla kedjor</a></span>
          </div>
          <ul class="kedja-andra">
            {siblings.map((c) => (
              <li>
                <a href={path('kedja', c.id)}>
                  <span>{c.name}</span>
                  <span class="antal">{formatNumber(c.total)}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </div>
</Base>

<style>
  /* Sidans egna mått. Sidhuvudet, sektionsformen, tyngdpunkten och tabellen
     bor i styles/kedja.css tillsammans med registersidan, så att de två inte
     glider isär. Här står bara det som bara finns här. */

  /* Registret längst ner: en kommunrubrik med sitt antal, och listan under.
     Rubriken väger avsiktligt mindre än sektionsrubriken ovanför, eftersom det
     är en
     avdelare inuti en sektion och inte en egen sektion. */
  .group { margin-top: var(--s-6); }

  .group h3 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
  }

  .group h3 .text-muted {
    font-size: var(--fs-body-s);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
</style>
