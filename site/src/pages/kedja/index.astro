---
/**
 * Kedjeregistret: /kedja.
 *
 * Ingången till kedjesidorna, och det enda stället på sajten där kedjorna står
 * bredvid varandra.
 *
 * VARFÖR TABELLEN BARA VISAR STORLEK: en kolumn med "utan anmärkning" per kedja
 * hade läst som en liga, och den ligan hade varit falsk. Kedjorna ligger i
 * olika blandningar av kommuner, kommunerna publicerar olika mycket, och en
 * kedja som råkar ha alla sina ställen i en kommun med sparsam publicering
 * hade toppat listan utan att vara renare. Antal ställen och antal kommuner är
 * däremot samma sorts tal oavsett var kedjan finns. Jämförelsen som faktiskt
 * bär görs på kedjans egen sida, mot kommunens eget bestånd.
 */
import Base from '../../layouts/Base.astro';
import { formatNumber } from '../../lib/data';
import { chains } from '../../lib/kedjor';
import { absolute, path } from '../../lib/urls';
import '../../styles/kedja.css';

const all = chains();
const locations = all.reduce((n, c) => n + c.total, 0);
const kommuner = new Set(all.flatMap((c) => c.municipalities.map((m) => m.municipality.slug)));

/**
 * Bokstavsavdelarna.
 *
 * Femtiotvå rader i bokstavsordning är en katalog, och en katalog visar var i
 * alfabetet man befinner sig. Ratsit, allabolag och hitta.se gör alla samma
 * sak. Avdelaren är ren form: ordningen kommer fortfarande ur chains(), och
 * raden ritas när begynnelsebokstaven byts.
 *
 * Siffror samlas under en rubrik i stället för att få varsin: "7-Eleven" är
 * enda raden pa 7 i dag, och en avdelare med en rad under sig ser ut som ett
 * fel.
 */
function initial(name: string): string {
  const first = name.trim().charAt(0).toLocaleUpperCase('sv');
  return /[0-9]/.test(first) ? '0–9' : first;
}

const rows = all.map((c, i) => ({
  chain: c,
  letter: i === 0 || initial(c.name) !== initial(all[i - 1].name) ? initial(c.name) : null,
}));

const answer =
  `${formatNumber(all.length)} kedjor och ${formatNumber(locations)} ställen, ` +
  'samlade över kommungränserna.';

const crumbs = [
  { '@type': 'ListItem', position: 1, name: 'Prikko', item: absolute() },
  { '@type': 'ListItem', position: 2, name: 'Kedjor' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Kedjor på Prikko',
    numberOfItems: all.length,
    itemListElement: all.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absolute('kedja', c.id),
      name: c.name,
    })),
  },
];
---

<Base title="Kedjor" description={answer} jsonLd={jsonLd}>
  <div class="container kedja-page">
    <nav class="kedja-crumbs" aria-label="Brödsmulor">
      <a href="/">Prikko</a>
    </nav>

    {/* Registret leder med sitt omfång, inte med en mening om sig självt.
        Talet till höger är hela skälet till att sidan finns: ingen kommunal
        tjänst kan visa ett bestånd över kommungränserna. */}
    <div class="kedja-topp">
      <h1>Kedjor</h1>
      <p class="kedja-omfang">
        {formatNumber(all.length)} kedjor · {formatNumber(locations)} ställen ·{' '}
        {formatNumber(kommuner.size)} kommuner
      </p>
    </div>

    <div class="kedja-main">
      <section aria-labelledby="registret">
        {/* Rubriken finns för skärmläsaren och för dokumentets kontur. På
            skärmen vore den en etikett på det enda som står på sidan, alltså
            en rubrik som inte skiljer något från något. */}
        <h2 id="registret" class="visually-hidden">Alla kedjor</h2>

        <table class="kedja-tabell">
          <thead>
            <tr>
              <th scope="col">Kedja</th>
              <th scope="col" class="num">Ställen</th>
              <th scope="col" class="num">Kommuner</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(({ chain: c, letter }) => (
              <>
                {letter && (
                  <tr class="bokstav">
                    <th colspan="3">{letter}</th>
                  </tr>
                )}
                <tr>
                  <th scope="row"><a href={path('kedja', c.id)}>{c.name}</a></th>
                  <td class="num antal">{formatNumber(c.total)}</td>
                  <td class="num tyst">{formatNumber(c.municipalities.length)}</td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </section>
    </div>
  </div>
</Base>
