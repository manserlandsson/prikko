---
/**
 * Källsidan. Redovisar exakt vilken data vi har, varifrån den kommer och hur
 * färsk den är — inklusive vad som SAKNAS.
 *
 * Att vara öppen med luckorna är inte blygsamhet utan strategi: täckningen är
 * gles i början, och en besökare som upptäcker det själv utan att vi sagt det
 * tappar förtroendet för allt annat vi visar.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Maskot from '../components/Maskot.astro';
import { creditLine } from '../lib/artikelbilder';
import { path } from '../lib/urls';
import {
  coverage,
  establishments,
  formatDate,
  formatNumber,
  municipalities,
  sourceFor,
} from '../lib/data';
import { nationalSources } from '../lib/kontrollen';
import { SITE } from '../lib/site';

const national = nationalSources();
const total = coverage();
const all = establishments();
const dates = all.flatMap((e) => e.inspections.map((i) => i.date)).sort();

/**
 * Artikelbildernas krediter, hämtade ur artiklarnas frontmatter.
 *
 * Listan skrivs aldrig för hand. Den läses ur samma fält som bildtexten under
 * bilden, så en artikel kan inte ha en bild som saknas här, och krediterna
 * kan inte stå kvar när en bild byts ut. Med tjugo artiklar är det skillnaden
 * mellan en redovisning och en gissning.
 */
const articleImages = (await getCollection('artiklar', ({ data }) => !data.draft))
  .filter((e) => e.data.image)
  .map((e) => ({ slug: e.id, title: e.data.title, image: e.data.image! }))
  .sort((a, b) => a.title.localeCompare(b.title, 'sv'));

const sources = municipalities().map((m) => ({
  ...m,
  count: establishments(m.slug).length,
  source: sourceFor(m.slug),
}));

/**
 * `Dataset` är sajtens starkaste AEO-märkning och stod tidigare med fyra fält.
 *
 * Datasetet är det AI-svar citerar när frågan är "hur många restauranger i
 * Sverige har anmärkningar", alltså den fråga bara vi kan besvara. Ett schema
 * som säger namn och beskrivning svarar inte på någon av följdfrågorna:
 * vilken period, vilket område, vad som faktiskt är uppmätt, hur färskt det
 * är. Alla fyra finns i datan och räknas fram nedan.
 *
 * LICENSEN ÄR ÄNDRAD OCH DET ÄR EN RÄTTELSE, INTE EN UTBYGGNAD. Fältet stod
 * på CC0, alltså en avsägelse av alla rättigheter till hela datamängden.
 * Sidans egen licenssektion säger något annat: underlaget är allmänna
 * handlingar, men normaliseringen och bedömningen är Prikkos arbete och den
 * som vill använda datan ska höra av sig. Ett strukturerat påstående som
 * motsäger den synliga texten är en felaktig uppgift, och just på licens är
 * den dyr: CC0 är oåterkallelig för den som hunnit förlita sig på den.
 * Fältet pekar nu på sidans egen licenstext. Vill ägaren faktiskt CC0-märka
 * beståndet är det ett beslut som ska stå i texten först.
 */
const licenceUrl = `${SITE.url}/kallor/#licens`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Livsmedelskontroller i Sverige, normaliserade av Prikko',
  description:
    `Kommunala livsmedelskontroller sammanställda till ett jämförbart format: ` +
    `${formatNumber(total.inspections)} kontroller vid ${formatNumber(total.establishments)} ` +
    `verksamheter i ${total.municipalities} svenska kommuner, med kontrolldatum, ` +
    `kontrolltyp, bedömning och de kontrollområden kommunen redovisar.`,
  inLanguage: 'sv-SE',
  url: `${SITE.url}/kallor/`,
  license: licenceUrl,
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: SITE.legalName, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.legalName, url: SITE.url },
  /* Färskheten, som är den AEO-signal bibeln §6b prissätter högst. Samma
     datum som sidan visar i tabellen, inte byggtidpunkten. */
  dateModified: sources.reduce(
    (latest, m) => (m.source && m.source.fetchedAt > latest ? m.source.fetchedAt : latest),
    '',
  ).slice(0, 10),
  /* ISO 8601-intervall ur beståndets äldsta och färskaste kontroll. */
  temporalCoverage: `${dates[0]}/${dates[dates.length - 1]}`,
  spatialCoverage: sources.map((m) => ({
    '@type': 'AdministrativeArea',
    name: m.name,
    /* Kommunkoden är SCB:s officiella identifierare. Den är det som gör
       "Stockholm" i vår data till samma entitet som "Stockholm" i någon
       annans, vilket är hela poängen med entitetskonsistens. */
    identifier: m.code,
    containedInPlace: { '@type': 'Country', name: 'Sverige' },
  })),
  /* Vad som faktiskt är uppmätt. Fälten motsvarar kolumnerna i beståndet, en
     mot en, och inget av dem är påhittat för schemats skull. */
  variableMeasured: [
    { '@type': 'PropertyValue', name: 'Kontrolldatum', description: 'Datum för kontrollbesöket.' },
    {
      '@type': 'PropertyValue',
      name: 'Kontrolltyp',
      description: 'Rutinkontroll, uppföljande kontroll eller händelsestyrd kontroll.',
    },
    {
      '@type': 'PropertyValue',
      name: 'Bedömning',
      description:
        'Kommunens utfall per kontroll: inga avvikelser, avvikelser, eller avvikelser som kvarstår.',
    },
    {
      '@type': 'PropertyValue',
      name: 'Kontrollområde',
      description:
        'Livsmedelsverkets rapporteringspunkt per konstaterad avvikelse, där kommunen publicerar den.',
    },
  ],
  measurementTechnique: `${SITE.url}/metodik/`,
};
---

<Base
  title="Källor och uppdatering"
  description={`Prikko bygger på ${formatNumber(total.inspections)} livsmedelskontroller från svenska kommuner. Här redovisas varje källa, hur ofta den hämtas och vilka kommuner som ännu saknas.`}
  jsonLd={jsonLd}
>
  <article class="container page">
    <header>
      {/* `soker` och inte `clean`. Läget betyder att figuren letar med blicken
          bortåt, och den här sidan handlar om var uppgifterna hämtas ifrån.
          Tabellen längre ned räknar upp KOMMUNER och inte verksamheter, alltså
          finns ingen bedömning av någon namngiven verksamhet på sidan. */}
      <Maskot pose="soker" size={88} class="avsandare" />
      <p class="eyebrow">Källor</p>
      <h1>Varifrån datan kommer</h1>
      <p class="lede text-secondary">
        Varje källa Prikko använder, när den senast hämtades och vad som ännu
        saknas.
      </p>
    </header>

    <section>
      <h2>Täckning just nu</h2>
      <dl class="stats">
        <div><dt>Kommuner</dt><dd>{total.municipalities} av 290</dd></div>
        <div><dt>Verksamheter</dt><dd>{formatNumber(total.establishments)}</dd></div>
        <div><dt>Kontroller</dt><dd>{formatNumber(total.inspections)}</dd></div>
        <div><dt>Med bedömning</dt><dd>{formatNumber(total.assessed)}</dd></div>
      </dl>
      <p class="text-secondary">
        Kontrollerna sträcker sig från {formatDate(dates[0])} till{' '}
        {formatDate(dates[dates.length - 1])}.
      </p>
    </section>

    <section>
      <h2>Källor</h2>
      <table>
        <thead>
          <tr><th>Kommun</th><th>Verksamheter</th><th>Källa</th><th>Hämtad</th></tr>
        </thead>
        <tbody>
          {sources.map((m) => (
            <tr>
              <td>{m.name}</td>
              <td>{formatNumber(m.count)}</td>
              <td>
                {m.source && <a href={m.source.url} rel="nofollow">Källa</a>}
              </td>
              <td>{m.source && formatDate(m.source.fetchedAt.slice(0, 10))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Tre nationella källor</h2>
      <p>
        Kontrollerna kommer från kommunerna. Hur kontrollen bedrivs, och hur
        stor restaurangbranschen är på orten, kommer från tre nationella
        källor. De står längst ner på varje kommunsida.
      </p>
      <ul class="plain">
        <li>
          <b>{national.report.publisher}s myndighetsrapportering.</b> Varje
          kontrollmyndighet rapporterar sin kontroll till {national.report.publisher}
          {' '}senast 31 januari. Uppgifterna publiceras per myndighet i
          {' '}<a href={national.report.url} rel="nofollow">{national.report.title}</a>,
          {' '}{national.report.series}. Vi läser raderna för
          {' '}{national.report.authorities} kontrollmyndigheter ur den.
        </li>
        <li>
          <b>Kolada.</b> Invånarantal ({national.kolada.population.kpi}) och
          företagens betyg på kommunens livsmedelskontroll i SKR:s
          Insiktsmätning ({national.kolada.rating.kpi}).
          {' '}{national.kolada.attribution}.
        </li>
        <li>
          <b>SCB:s statistikdatabas.</b> Sysselsatta inom hotell och restaurang
          efter arbetsställets belägenhet, per kommun och år (tabell
          {' '}{national.scb.jobs.table}). Licens {national.scb.license}, som
          inte kräver någon källhänvisning.
          {' '}{national.scb.attribution}.
        </li>
      </ul>
      <p>
        Kontrolltalen visas alltid mot medianen för landets
        kontrollmyndigheter, aldrig mot en annan kommun.
        {' '}<a href="/metodik/#jamfor">Vi rangordnar inte kommuner</a> på
        kontrollresultat.
      </p>
    </section>

    {/* OSM-avsnittet, och varför det finns.

        Verksamhetssidan bär en rad i sin källfot som säger vilka fält som
        kommer ur OpenStreetMap, se Sidupphov.astro. Den raden är
        attributionen ODbL 4.3 kräver, och den ryms inte med hela
        redovisningen: vilka fält, hur många sidor, vilken licens och vad
        kartbilden är för något. Den här sidan bär det, och sidfoten på varje
        sida länkar hit. Foten på verksamhetssidan får INTE en tredje länk för
        det: den bär redan två, till licensen och till objektet, och en fotnot
        med tre länkar slutar läsas som en fotnot.

        Talen räknas inte fram här utan står som mätta tal från 2026-08-18. De
        ändras när uttaget körs om, och då ska de skrivas om. Ett tal som
        räknas ur `establishments()` vid varje bygge hade varit finare, men
        `hours`, `contact`, `stop` och `parking` är valfria fält på 16 047
        poster och en sådan räkning kostar en genomgång av hela datamängden
        för fyra siffror i en text. */}
    <section id="openstreetmap">
      <h2>Öppettider, kontakt och kartan</h2>
      <p>
        Några uppgifter på en verksamhetssida kommer inte från kommunen utan
        från{' '}
        <a href="https://www.openstreetmap.org/copyright" rel="nofollow">
          OpenStreetMap</a>, en öppen databas som frivilliga skriver. De är
        märkta med källan i en rad längst ned på sidan, och det är fem saker:
        öppettiderna, kontaktkortet med telefon, webbplats, e-post och Bra att
        veta, närmaste hållplats, antalet parkeringar i närheten, och på
        kartan nålens läge när kommunen inte lämnat någon koordinat.
      </p>
      <p>
        Uppgifterna finns långt ifrån överallt, mätt den 18 augusti 2026: en
        öppettid på 2 747 av 16 047 verksamheter, ett kontaktkort på 3 274, en
        hållplats på 12 870, en parkering på 10 606 och en beräknad nål på
        1 631. Saknas uppgiften skriver vi ingenting alls i stället för att
        skriva att vi inte vet.
      </p>
      <p>
        Databasen ligger under{' '}
        <a href="https://opendatacommons.org/licenses/odbl/" rel="nofollow">
          ODbL 1.0</a>, som kräver att källan anges där uppgifterna visas.
        Ser du ett fel är det bästa du kan göra att rätta det i
        OpenStreetMap; länken finns i raden längst ned på verksamhetssidan, och
        rättelsen når då alla som använder databasen och inte bara oss.
      </p>
      <p>
        Kartbilden är en annan sak än uppgifterna ovan. Rutorna kommer från{' '}
        <a href="https://openfreemap.org" rel="nofollow">OpenFreeMap</a> och är
        ritade ur{' '}
        <a href="https://www.openmaptiles.org/" rel="nofollow">OpenMapTiles</a>
        {' '}data, som i sin tur kommer ur OpenStreetMap. Det upphovet står i
        kartans eget hörn, ritat av kartprogrammet självt, och det ska stå kvar
        där även på sidor som inte visar en enda annan OSM-uppgift.
      </p>
    </section>

    <section id="gatubilder">
      <h2>Gatubilderna</h2>
      <p>
        Bilden på en verksamhetssida är en gatubild, tagen från gatan utanför.
        Den kommer i första hand från{' '}
        <a href="https://www.mapillary.com" rel="nofollow">Mapillary</a> och i
        andra hand från{' '}
        <a href="https://panoramax.xyz" rel="nofollow">Panoramax</a>, två öppna
        tjänster där frivilliga fotograferar gatumiljöer. Bilderna är
        licensierade{' '}
        <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.sv" rel="nofollow">
          CC BY-SA</a>, och fotografen, källan och licensen står alltid intill
        bilden. Vilken version av licensen som gäller står per bild, eftersom
        tjänsterna anger den olika: Panoramax skriver ut den för varje enskild
        bild, medan Mapillarys villkor bara säger CC BY-SA.
      </p>
      <p>
        En bild ska visa rätt hus, annars gör den mer skada än nytta. Därför
        krävs tre saker av den: att den är tagen inom fyrtio meter från
        adressen, att kameran pekade mot verksamheten och inte längs gatan
        förbi den, och att den är tagen i dagsljus. Vi lagrar sedan en
        nedskalad kopia hos oss i stället för att länka till källan. Den
        nedskalade kopian är ett bearbetat verk och bär samma licens.
      </p>
      <p>
        Kraven kostar täckning, och det är avsikten. De flesta verksamheter får
        ingen bild, och sidan är byggd för att se hel ut utan den. Finns ingen
        bild som visar rätt hus visar vi hellre ingen alls.
      </p>
      <p>
        Är du fotografen och vill ha bort en bild härifrån,{' '}
        <a href="/ratta/">hör av dig</a>.
      </p>
    </section>

    {/* id:t är en måladress: bildtexten under varje artikelbild länkar hit.
        Byt det inte utan att ändra länken i layouts/Artikel.astro.

        Sektionen renderas bara när någon artikel har bild. En rubrik över en
        tom lista säger att vi glömt något, och artiklarna får sina bilder en
        i taget. */}
    {articleImages.length > 0 && (
      <section id="artikelbilder">
        <h2>Bilderna i artiklarna</h2>
        <p>
          Artiklarna illustreras med foton från fria bildbanker. Ingen av dem är
          tagen hos en verksamhet vi bedömer, och ingen är AI-genererad. Bilden
          visar ett sammanhang, aldrig ett exempel: köket på bilden är inte
          köket i texten.
        </p>
        <ul class="plain">
          {articleImages.map((a) => (
            <li>
              <a href={path('artiklar', a.slug)}>{a.title}</a>
              {' · '}
              {a.image.creditUrl ? (
                <a href={a.image.creditUrl} rel="nofollow">{creditLine(a.image)}</a>
              ) : (
                creditLine(a.image)
              )}
              {!a.image.credit && (
                <span class="text-muted"> (fotograf ej angiven)</span>
              )}
            </li>
          ))}
        </ul>
        <p>
          Saknas ditt namn på ett foto du tagit, eller vill du att en bild tas
          bort, <a href="/ratta/">hör av dig</a>.
        </p>
      </section>
    )}

    {/* id:t är en måladress och inte dekoration: platsraden i sökpanelen
        skickar hit den vars plats ligger utanför täckningen, och då ska sidan
        öppna på den här förklaringen och inte på tabellen ovanför. Byt det
        inte utan att ändra länken i SiteSearch.astro. */}
    <section id="fler-kommuner">
      <h2>Varför så få kommuner</h2>
      <p>
        Sverige saknar ett nationellt system för publicering av
        livsmedelskontroller. Varje kommun bestämmer själv, och de allra flesta
        publicerar ingenting alls. Ett fåtal har öppna gränssnitt, några
        publicerar på egen webbplats, och resten lämnar ut uppgifterna först på
        begäran enligt offentlighetsprincipen.
      </p>
      <p>
        Det är därför den här sajten inte fanns tidigare, och det är arbetet vi
        gör: hämta, normalisera och göra jämförbart. Nya kommuner tillkommer
        efterhand.
      </p>
    </section>

    <section>
      <h2>Hur ofta uppdateras det</h2>
      <p>
        Källorna hämtas om regelbundet, och varje verksamhets sida visar
        datumet för den senaste hämtningen. Kontrollresultat kan dröja innan de
        publiceras av kommunen. En kontroll som gjordes i går syns alltså inte
        nödvändigtvis här i dag.
      </p>
    </section>

    {/* id:t är en måladress: `license` i sidans Dataset-schema pekar hit, så
        att det strukturerade påståendet och den synliga texten är samma sak.
        Byt det inte utan att ändra licenceUrl ovan. */}
    {/* Texten sa fram till 2026-08-31 "vill du använda datan i egna
        sammanhang, hör av dig", vilket var sant så länge det inte fanns något
        att hämta. Nu finns /api/, och en sida som ber om ett mejl bredvid ett
        öppet API säger emot sig själv. Villkoret står därför utskrivet här
        också, i samma två lager som lib/api.ts beskriver. */}
    <section id="licens">
      <h2>Licens</h2>
      <p>
        Kommunernas underlag är allmänna handlingar och bär varken upphovsrätt
        eller katalogskydd, eftersom 9 § upphovsrättslagen undantar yttranden
        av svenska myndigheter och 49 § tredje stycket låter det undantaget
        gälla även för en sammanställning. Vi äger alltså ingenting av
        uppgifterna och kan inte licensiera dem.
      </p>
      <p>
        Normaliseringen, identifierarna och bedömningen är Prikkos eget arbete,
        och det arbetet är fritt att använda med attribution,
        {' '}<a href="https://creativecommons.org/licenses/by/4.0/deed.sv" rel="nofollow">
          CC BY 4.0</a>. <a href="/metodik/">Metodiken är publicerad</a>, och
        {' '}<a href="/api/">datan går att hämta maskinellt</a> med villkoren
        utskrivna i varje svar.
      </p>
      <p>
        Bilderna och uppgifterna ur OpenStreetMap står under andra villkor och
        omfattas inte. De redovisas var för sig ovan, och de ingår inte i
        API:et.
      </p>
    </section>
  </article>
</Base>

<style>
  /* Se om.astro för formen. Samma regel på varje sida där avsändaren står i
     sidhuvudets text: flyter höger, faller ovanför på smal skärm. */
  header :global(.avsandare) {
    float: right;
    margin: 0 0 var(--s-3) var(--s-6);
    shape-outside: circle(50%);
  }

  @media (max-width: 700px) {
    header :global(.avsandare) {
      float: none;
      margin: 0 0 var(--s-3);
    }
  }

  /* Floaten stängs in i sidhuvudet. Rubriktexten är alltid högre än 88 px i
     dag, alltså syns raden aldrig, och det är precis skälet till att den ska
     stå: den dag någon kortar en rubrik faller figuren annars ned över
     avsnittet under utan att något varnar. */
  header::after {
    content: '';
    display: table;
    clear: both;
  }

  .page {
    max-width: var(--w-read);
    padding-block: var(--s-12) var(--s-16);
  }

  h1 { font-size: var(--fs-display); line-height: var(--lh-display); margin-top: var(--s-2); }

  .lede { margin-top: var(--s-4); line-height: var(--lh-body); }

  section { margin-top: var(--s-12); }
  section h2 { margin-bottom: var(--s-4); }
  section p { line-height: var(--lh-body); }
  section p + p { margin-top: var(--s-4); }

  .plain { margin: var(--s-4) 0 var(--s-4); padding-left: var(--s-4); }
  .plain li { margin-top: var(--s-3); line-height: var(--lh-body); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    overflow: hidden;
    margin: 0 0 var(--s-4);
  }

  .stats > div {
    padding: var(--s-3) var(--s-4);
    border-right: 1px solid var(--hairline);
  }

  .stats dt { font-size: var(--fs-caption); color: var(--text-secondary); }
  .stats dd {
    margin: 2px 0 0;
    font-size: var(--fs-h-s);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-body-s);
  }

  th, td {
    text-align: left;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--hairline);
  }

  th {
    font-size: var(--fs-caption);
    font-weight: 600;
    color: var(--text-secondary);
  }
</style>
