---
/**
 * Startsidan.
 *
 * Ledstjärna, mätt mot TheFork, Airbnb, Ednia, hitta.se och brittiska FSA:
 * startsidan ÄR produkten, inte en beskrivning av den. Ingen av referenserna
 * förklarar sig ovanför vikningen; första skärmen är ett instrument.
 *
 * Strukturen, uppifrån: hero med fyra saker (wordmark i sidhuvudet, rubrik,
 * underrad, sökfält), kommunerna störst först,
 * en rad om källan. Inget mer. Sökfältet ligger HÄR och inte i sidhuvudet:
 * Base får headerSearch={false}, och fältet är samma komponent i sitt
 * hero-läge. En sida får aldrig två sökfält: dubbleringen var det som fick
 * den gamla heron att kännas tom.
 *
 * Kommunlistan är inte bara navigation. SEO-mätningen mot den brittiska
 * motsvarigheten visade att områdes- och kommunsidor stod för ~90 % av
 * trafiken medan enskilda restaurangsidor stod för 5,8 %. Kommunnivån är
 * alltså den bärande sidtypen, och startsidan behöver inte själv bära SEO.
 *
 * Inga påhittade siffror: allt räknas ur faktisk data.
 */
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import KommunKort from '../components/KommunKort.astro';
import SiteSearch from '../components/SiteSearch.astro';
import {
  coverage,
  formatNumber,
  municipalitySummaries,
} from '../lib/data';
import { SITE } from '../lib/site';
import { absolute, path } from '../lib/urls';

const total = coverage();

// Sammanräkningen ligger i lib/data. Kortet och sidan får aldrig räkna var
// för sig.
const summaries = municipalitySummaries();

/**
 * Störst först, inte bokstavsordning. Bokstavsordningen gav Borgholm och
 * Höganäs de två översta platserna och begravde Stockholm under vikningen,
 * samtidigt som genvägsraden i gamla heron redan visste rätt ordning.
 */
const byTotal = [...summaries].sort((a, b) => b.total - a.total);

/**
 * Kommuner med foto blir kort, kommuner utan blir rader. Aldrig tomma
 * bildrutor: fyra av tolv kommuner renderades som vita fält märkta "ingen
 * bild ännu", en tredjedel av rutnätet, och vid 50 kommuner hade det varit
 * en vägg. Raden skalar till 290, kortraden växer i takt med Måns foton.
 *
 * Upptäcks från filsystemet precis som i KommunKort, så ett nytt foto
 * flyttar kommunen från listan till korten utan att någon rör den här filen.
 */
const withPhoto = new Set(
  Object.keys(
    import.meta.glob<{ default: ImageMetadata }>('../assets/stad/*.jpg'),
  ).map((p) => p.split('/').pop()!.replace('.jpg', '')),
);

const cards = byTotal.filter((m) => withPhoto.has(m.slug));
const rows = byTotal.filter((m) => !withPhoto.has(m.slug));

const description = `Prikko samlar ${formatNumber(total.establishments)} livsmedelsverksamheter från ${total.municipalities} kommuner och visar hur var och en klarade sin senaste hygienkontroll.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: absolute(),
    inLanguage: 'sv-SE',
    description: SITE.description,
    /*
     * Ingen `potentialAction`/`SearchAction` här, och det är ett beslut.
     *
     * Markeringen fanns för sitelinks-sökrutan, som Google tog bort ur
     * sökresultaten i november 2024. Den kunde dessutom aldrig ha fungerat:
     * `urlTemplate` pekade på `/sok/?q={search_term_string}`, och robots.txt
     * blockerar just den formen med `Disallow: /sok/?` för att tunna
     * resultatsidor inte ska hamna i indexet. Sajten deklarerade alltså en
     * ingång den samtidigt bad sökmotorerna att inte gå in genom.
     *
     * Blockeringen är rätt och sökrutan är borta, så det som ska falla är
     * påståendet. Kommer funktionen tillbaka behöver den en crawlbar
     * målsökväg först, inte bara en återinsatt rad.
     */
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.legalName,
    url: absolute(),
    logo: `${SITE.url}/prikko-mark.svg`,
  },
];
---

<Base title={SITE.name} description={description} jsonLd={jsonLd} headerSearch={false}>
  {/*
    Heron är fyra saker: wordmarken i sidhuvudet ovanför, rubriken,
    underraden och fältet. Centrerad stapel: en vänsterställd rubrik
    ovanför ett centrerat fält drar åt två håll.

    Rubriken har besökaren som subjekt, inte kommunerna: sidan ska säga vad
    man GÖR här. Varifrån datan kommer sägs EN gång, i underraden. Det är
    sidans enda proveniensrad; den upprepas inte längre ned.

    Graden är 32 px och inte tokens 40: fältet är sidans främsta handling,
    och en display-rubrik över flera rader tog den rollen.
  */}
  <section class="container topp">
    {/* Formen är JobbSafaris hero, som ägaren pekade ut: en liten rad med
        omfånget överst, en stor rubrik med besökaren som subjekt, fältet.
        Omfångsraden gör två jobb samtidigt: den bevisar att tjänsten täcker
        något, och den säger vilka slags ställen man kan söka på, så att
        rubriken slipper räkna upp dem.

        Rubriken säger vad man FÅR här, inte vad sajten är. "Se vad
        inspektören såg" är löftet i sex stavelser: myndighetens egna ögon,
        tillgängliga för dig. Hårt mellanslag så att "såg" aldrig hamnar
        ensamt på en egen rad. */}
    <p class="omfang">Sök bland {formatNumber(total.establishments)} restauranger, caféer och butiker</p>
    <h1>Se vad inspektören&nbsp;såg</h1>
    <p class="under">
      Kommunernas officiella hygienkontroller, samlade på ett ställe.
    </p>

    <div class="hero-sok">
      <SiteSearch size="hero" />
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Välj kommun</h2>
      <a href="/kallor/">Om täckningen</a>
    </div>

    <ul class="kommuner">
      {cards.map((m, i) => (
        <li>
          {/* Översta raden ligger nära vikningen på de flesta skärmar och
              laddas därför direkt; resten lazy. */}
          <KommunKort kommun={m} eager={i < 3} />
        </li>
      ))}
    </ul>

    {rows.length > 0 && (
      <div class="fler">
        <p class="fler-head">Även med i Prikko</p>
        <ul class="fler-lista">
          {rows.map((m) => (
            <li>
              <a href={path(m.slug)}>
                <b>{m.city}</b>
                <span>{formatNumber(m.total)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* Avsändaren, en rad. Sidan förklarade sig tidigare två gånger, i
        heron och i tre spalter längst ned. Kvar är det som inte står någon
        annanstans på sidan: källan och replikrätten. */}
    <div class="grund">
      <p>
        Underlaget är kommunernas egna kontrollrapporter, allmänna
        handlingar. Hela beräkningen är publicerad och verksamheten har rätt
        att svara.
      </p>
      <a href="/metodik/">Läs metodiken</a>
    </div>
  </section>
</Base>

<style>
  /* Heron. Luften under fältet bärs av sektionen själv och inte av nästa
     blocks marginal, så att den står för sig själv oavsett vad som ligger
     närmast ovanför. */
  .topp {
    padding-block: var(--s-12);
    text-align: center;
  }

  /* Omfångsraden, JobbSafaris "Sök bland över 67 945 lediga jobb". Liten och
     sekundär: den är en försats till rubriken, inte en rubrik själv. */
  .omfang {
    margin-bottom: var(--s-3);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  /* Rubriken kortades till fyra ord och får då bära mer grad än de 32 px den
     låg på när den var en hel mening. Fältet väger fortfarande tyngst. */
  .topp h1 {
    margin-inline: auto;
    max-width: 24ch;
    font-size: 38px;
    line-height: 42px;
    letter-spacing: -.02em;
  }

  .under {
    margin-top: var(--s-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  /* Fältet centreras här; måtten bor i SiteSearchs hero-läge. */
  .hero-sok {
    position: relative;
    max-width: 600px;
    margin: var(--s-6) auto 0;
  }
  .hero-sok :global(.site-search) { margin-inline: auto; }


  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .block-head a { font-size: var(--fs-body-s); }

  /* Kommunkorten. Rutnätet äger bara placeringen, kortets egen form bor i
     KommunKort.astro. Minsta spalt 250 px: under det blir bildzonen bredare i
     förhållande till sin höjd än fotot tål. */
  .kommuner {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--s-4);
  }

  /* Kommuner utan foto: rader, aldrig tomma bildrutor. Se frontmattern. */
  .fler {
    margin-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .fler-head {
    padding-top: var(--s-4);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  .fler-lista {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 var(--s-6);
  }

  .fler-lista li { border-top: 1px solid var(--hairline); }
  .fler-lista li:nth-child(-n+3) { border-top: 0; }

  .fler-lista a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: 11px 0;
    color: var(--text);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .fler-lista a:hover { text-decoration: none; }
  .fler-lista a:hover b { color: var(--brand); }
  .fler-lista b { font-weight: 600; }

  .fler-lista span {
    color: var(--text-muted);
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
  }

  .grund {
    margin-top: var(--s-12);
    padding-block: var(--s-6);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
  }

  .grund p {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
    max-width: 68ch;
  }

  .grund a { font-size: var(--fs-body-s); white-space: nowrap; }

  @media (max-width: 900px) {
    .fler-lista { grid-template-columns: repeat(2, 1fr); }
    .fler-lista li:nth-child(-n+3) { border-top: 1px solid var(--hairline); }
    .fler-lista li:nth-child(-n+2) { border-top: 0; }
  }

  @media (max-width: 680px) {
    .topp { padding-block: var(--s-8); }

    /* Fyra ord ryms på två rader även vid 32 i den smala spalten. */
    .topp h1 { font-size: 32px; line-height: 36px; }


    .fler-lista { grid-template-columns: 1fr; }
    .fler-lista li:nth-child(-n+2) { border-top: 1px solid var(--hairline); }
    .fler-lista li:first-child { border-top: 0; }
  }
</style>
