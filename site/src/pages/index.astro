---
/**
 * Startsidan.
 *
 * Struktur: stor rubrik + EN dominant sökruta (Ratsit- och Zillow-mönstret),
 * därefter kommunerna som egna ingångar — samma grepp som ednia använder för
 * program.
 *
 * Kommunlistan är inte bara navigation. SEO-mätningen mot den brittiska
 * motsvarigheten visade att områdes- och kommunsidor stod för ~90 % av
 * trafiken medan enskilda restaurangsidor stod för 5,8 %. Kommunnivån är
 * alltså den bärande sidtypen, inte katalogen.
 *
 * Inga påhittade siffror: allt räknas ur faktisk data.
 */
import Base from '../layouts/Base.astro';
import FaceMark from '../components/FaceMark.astro';
import {
  coverage,
  establishments,
  formatDate,
  formatNumber,
  latestInspectionDate,
  municipalities,
} from '../lib/data';
import { SITE, VERDICT } from '../lib/site';

const total = coverage();

const summaries = municipalities().map((m) => {
  const all = establishments(m.slug);
  const assessed = all.filter((e) => e.verdict !== null);
  const remarks = assessed.filter((e) => e.verdict !== 'clean');
  return {
    ...m,
    count: all.length,
    assessed: assessed.length,
    remarks: remarks.length,
    major: remarks.filter((e) => e.verdict === 'major').length,
  };
});

// Senast kontrollerade i landet. Färskhet är en dokumenterad citeringsfaktor
// för AI-svar, och det enda på sidan som ändras av sig självt.
const recent = establishments()
  .filter((e) => e.verdict !== null && latestInspectionDate(e))
  .sort((a, b) => (latestInspectionDate(b)! > latestInspectionDate(a)! ? 1 : -1))
  .slice(0, 8);

const description = `Prikko samlar ${formatNumber(total.establishments)} livsmedelsverksamheter från ${total.municipalities} kommuner och visar hur var och en klarade sin senaste hygienkontroll.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'sv-SE',
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/sok?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.legalName,
    url: SITE.url,
    logo: `${SITE.url}/prikko-mark.svg`,
  },
];
---

<Base title={SITE.name} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <h1>Hur ren är restaurangen du tänkte gå till?</h1>
      <p class="lede">
        Kommunerna kontrollerar hygienen och resultaten är offentliga — men de
        ligger utspridda hos 290 kommuner. Prikko samlar dem.
      </p>

      <form class="search" action="/sok" method="get" role="search">
        <label for="q" class="visually-hidden">Sök restaurang eller adress</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Sök restaurang, café eller adress"
          autocomplete="off"
        />
        <button type="submit" class="btn-primary">Sök</button>
      </form>

      <p class="counts">
        <strong>{formatNumber(total.establishments)}</strong> verksamheter ·
        <strong>{formatNumber(total.inspections)}</strong> kontroller ·
        <strong>{total.municipalities}</strong> {total.municipalities === 1 ? 'kommun' : 'kommuner'}
      </p>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Välj kommun</h2>
      <a href="/kallor">Om täckningen</a>
    </div>

    <ul class="kommuner">
      {summaries.map((m) => (
        <li>
          <a href={`/${m.slug}`}>
            <span class="k-head">
              <b>{m.city}</b>
              <span class="k-count text-muted">{formatNumber(m.count)} verksamheter</span>
            </span>
            <span class="k-bar" aria-hidden="true">
              <span
                class="k-fill"
                style={`width: ${Math.round(((m.assessed - m.remarks) / Math.max(m.assessed, 1)) * 100)}%`}
              ></span>
            </span>
            <span class="k-meta text-secondary">
              {m.remarks} med anmärkningar
              {m.major > 0 && <> · {m.major} kvarstående</>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Senast kontrollerade</h2>
      <a href="/sok">Sök alla</a>
    </div>

    <ul class="rows">
      {recent.map((e) => (
        <li>
          <a href={`/${e.municipality.slug}/${e.slug}`}>
            <FaceMark verdict={e.verdict} size={32} variant="round" />
            <span class="row-body">
              <b>{e.name}</b>
              <span class="text-secondary">
                {e.municipality.city} · {formatDate(latestInspectionDate(e)!)}
              </span>
            </span>
            <span class="verdict" style={`color: ${VERDICT[e.verdict!].colorVar}`}>
              {VERDICT[e.verdict!].label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container block how">
    <h2>Så fungerar bedömningen</h2>
    <div class="steps">
      <article>
        <h3>Officiella kontroller</h3>
        <p class="text-secondary">
          Underlaget är kommunernas egna kontrollrapporter — allmänna
          handlingar, inte tyckande och inte recensioner.
        </p>
      </article>
      <article>
        <h3>Tre nivåer</h3>
        <p class="text-secondary">
          Inga anmärkningar, brister, eller brister som kvarstår efter
          kommunens uppföljning. Saknas underlag bedömer vi inte.
        </p>
      </article>
      <article>
        <h3>Öppen metodik</h3>
        <p class="text-secondary">
          Hela beräkningen är publicerad, och verksamheten har rätt att svara.
          Svaret publiceras oredigerat.
        </p>
      </article>
    </div>
    <p class="method-link"><a href="/metodik">Läs hela metodiken</a></p>
  </section>
</Base>

<style>
  .hero {
    background: var(--card);
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--s-16);
  }

  .hero-inner { max-width: 660px; text-align: center; }

  h1 { font-size: 44px; line-height: 48px; letter-spacing: -.028em; }

  .lede {
    margin-top: var(--s-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  .search { display: flex; gap: var(--s-2); margin-top: var(--s-8); }

  .search input {
    flex: 1;
    min-width: 0;
    height: 54px;
    padding-inline: var(--s-4);
    font-family: inherit;
    font-size: var(--fs-body);
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
  }

  .search input::placeholder { color: var(--text-muted); }
  .search .btn-primary { padding-inline: var(--s-8); }

  .counts { margin-top: var(--s-4); font-size: var(--fs-caption); color: var(--text-muted); }
  .counts strong { font-weight: 600; color: var(--text-secondary); }

  .block { padding-block: var(--s-12) 0; max-width: 900px; }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .block-head a { font-size: var(--fs-body-s); }

  /* Kommunkort. Andelen utan anmärkning visas som ett band — en siffra till
     säger mindre än en form man uppfattar på en halv sekund. */
  .kommuner {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--s-3);
  }

  .kommuner a {
    display: block;
    background: var(--card);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    padding: var(--s-4);
    color: var(--text);
  }

  .kommuner a:hover { text-decoration: none; box-shadow: var(--shadow-pop); }
  .kommuner a:hover b { color: var(--brand); }

  .k-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2);
  }

  .k-head b { font-size: var(--fs-h-s); font-weight: 600; letter-spacing: -.01em; }
  .k-count { font-size: var(--fs-caption); }

  .k-bar {
    display: block;
    height: 5px;
    border-radius: 3px;
    background: var(--verdict-minor);
    margin: var(--s-3) 0 var(--s-2);
    overflow: hidden;
  }

  .k-fill { display: block; height: 100%; background: var(--verdict-clean); }

  .k-meta { display: block; font-size: var(--fs-caption); }

  .rows { list-style: none; margin: var(--s-4) 0 0; padding: 0; }
  .rows li { border-top: 1px solid var(--hairline); }

  .rows a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    color: var(--text);
  }

  .rows a:hover { text-decoration: none; }
  .rows a:hover b { color: var(--brand); }

  .row-body { flex: 1; min-width: 0; }
  .row-body b { display: block; font-size: var(--fs-body-s); font-weight: 600; }
  .row-body span { font-size: var(--fs-caption); }

  .verdict { font-size: var(--fs-caption); font-weight: 600; flex-shrink: 0; }

  .how { padding-bottom: var(--s-12); }
  .how h2 { text-align: center; }

  .steps {
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-6);
  }

  .steps h3 { font-size: var(--fs-body); }
  .steps p { margin-top: var(--s-2); font-size: var(--fs-body-s); line-height: 21px; }

  .method-link { text-align: center; margin-top: var(--s-8); font-size: var(--fs-body-s); }

  @media (max-width: 640px) {
    .hero { padding-block: var(--s-12); }
    h1 { font-size: 32px; line-height: 36px; }
    .search { flex-direction: column; }
    .search .btn-primary { height: 50px; }
    .verdict { display: none; }
  }
</style>
