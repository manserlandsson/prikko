---
/**
 * Startsidan.
 *
 * Struktur: stor rubrik + EN dominant sökruta (Ratsit- och Zillow-mönstret),
 * därefter kommunerna som egna ingångar — samma grepp som ednia använder för
 * program.
 *
 * Kommunlistan är inte bara navigation. SEO-mätningen mot den brittiska
 * motsvarigheten visade att områdes- och kommunsidor stod för ~90 % av
 * trafiken medan enskilda restaurangsidor stod för 5,8 %. Kommunnivån är
 * alltså den bärande sidtypen, inte katalogen.
 *
 * Inga påhittade siffror: allt räknas ur faktisk data.
 */
import Base from '../layouts/Base.astro';
import FaceMark from '../components/FaceMark.astro';
import KommunKort from '../components/KommunKort.astro';
import {
  coverage,
  establishments,
  formatDate,
  formatNumber,
  latestInspectionDate,
  municipalitySummaries,
} from '../lib/data';
import { SITE, VERDICT } from '../lib/site';
import { absolute, path } from '../lib/urls';

const total = coverage();

// Sammanräkningen ligger i lib/data — kortet och sidan får aldrig räkna var
// för sig.
const summaries = municipalitySummaries();

// Senast kontrollerade i landet. Färskhet är en dokumenterad citeringsfaktor
// för AI-svar, och det enda på sidan som ändras av sig självt.
const recent = establishments()
  .filter((e) => e.verdict !== null && latestInspectionDate(e))
  .sort((a, b) => (latestInspectionDate(b)! > latestInspectionDate(a)! ? 1 : -1))
  .slice(0, 8);

const description = `Prikko samlar ${formatNumber(total.establishments)} livsmedelsverksamheter från ${total.municipalities} kommuner och visar hur var och en klarade sin senaste hygienkontroll.`;

/**
 * Rikets fördelning över de tre nivåerna.
 *
 * Heron visade tidigare bara "hur ren är restaurangen du tänkte gå till?" och
 * en sökruta. Den sa vad sajten VILL, aldrig vad den HAR. Brittiska FSA löser
 * samma problem genom att lägga en bild av själva betygsdekalen i heron: den
 * som aldrig sett tjänsten förstår på en sekund vad han får ut av den.
 *
 * Vår motsvarighet till dekalen är skalan. Här räknas den ur faktisk data och
 * blir samtidigt legend och bevis på omfattning. Ingen enskild verksamhet
 * pekas ut, vilket vore både godtyckligt och orättvist på en startsida.
 */
const scale = summaries.reduce(
  (acc, m) => ({
    clean: acc.clean + m.clean,
    minor: acc.minor + m.minor,
    major: acc.major + m.major,
  }),
  { clean: 0, minor: 0, major: 0 },
);

const levels = [
  { verdict: 'clean' as const, count: scale.clean },
  { verdict: 'minor' as const, count: scale.minor },
  { verdict: 'major' as const, count: scale.major },
];

/**
 * Genvägar till kommunerna, störst först.
 *
 * Sidans egen kommentar konstaterar att kommunsidorna bär trafiken. Då ska de
 * gå att nå utan att först formulera en sökfråga — det är samma resonemang
 * som FSA:s "Search a local authority area" bredvid fritextsökningen.
 */
const shortcuts = [...summaries].sort((a, b) => b.total - a.total).slice(0, 6);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: absolute(),
    inLanguage: 'sv-SE',
    description: SITE.description,
    /*
     * Ingen `potentialAction`/`SearchAction` här, och det är ett beslut.
     *
     * Markeringen fanns för sitelinks-sökrutan, som Google tog bort ur
     * sökresultaten i november 2024. Den kunde dessutom aldrig ha fungerat:
     * `urlTemplate` pekade på `/sok/?q={search_term_string}`, och robots.txt
     * blockerar just den formen med `Disallow: /sok/?` för att tunna
     * resultatsidor inte ska hamna i indexet. Sajten deklarerade alltså en
     * ingång den samtidigt bad sökmotorerna att inte gå in genom.
     *
     * Blockeringen är rätt och sökrutan är borta, så det som ska falla är
     * påståendet. Kommer funktionen tillbaka behöver den en crawlbar
     * målsökväg först, inte bara en återinsatt rad.
     */
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.legalName,
    url: absolute(),
    logo: `${SITE.url}/prikko-mark.svg`,
  },
];
---

<Base title={SITE.name} description={description} jsonLd={jsonLd}>
  {/*
    KOMPRIMERAD HERO — ingen egen sökruta.

    Den gamla heron fyllde första skärmen med en rubrik, en underrad och ett
    sökfält som stod tio pixlar under ett identiskt sökfält i sidhuvudet.
    Dubbleringen var det som fick den att kännas tom: en hel skärm som bara
    upprepade det som redan fanns.

    Kvar är det bara heron kan göra. Rubriken bär sidans ämne för Google.
    Meningen säger vem avsändaren är. Talen är beviset. Kommunnamnen är
    genvägen, och de är sidans egentliga uppgift — mätningen mot brittiska
    FSA ger kommunsidor 37,9 % av trafiken mot restaurangsidornas 5,8 %.

    Höjden är ungefär en tredjedel av den gamla, så kommunkorten når över
    vikningen på en normal laptop.
  */}
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Kommunernas livsmedelskontroller</p>
      <h1>Hur ren är restaurangen du tänkte gå till?</h1>
      <p class="lede">
        Kommunerna kontrollerar hygienen och resultaten är offentliga, men de
        ligger utspridda hos 290 kommuner. Prikko samlar
        {' '}<b>{formatNumber(total.establishments)}</b> verksamheter och
        {' '}<b>{formatNumber(total.inspections)}</b> kontroller från
        {' '}<b>{total.municipalities}</b>{' '}
        {total.municipalities === 1 ? 'kommun' : 'kommuner'}.
      </p>

      <p class="shortcuts">
        Gå direkt till{' '}
        {shortcuts.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={path(m.slug)}>{m.city}</a>
          </>
        ))}
      </p>
    </div>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Välj kommun</h2>
      <a href="/kallor/">Om täckningen</a>
    </div>

    <ul class="kommuner">
      {summaries.map((m, i) => (
        <li>
          {/* Översta raden ligger nära vikningen på de flesta skärmar och
              laddas därför direkt; resten lazy. */}
          <KommunKort kommun={m} eager={i < 3} />
        </li>
      ))}
    </ul>
  </section>

  <section class="container block">
    <div class="block-head">
      <h2>Senast kontrollerade</h2>
      <a href="/sok/">Sök alla</a>
    </div>

    <ul class="rows">
      {recent.map((e) => (
        <li>
          <a href={path(e.municipality.slug, e.slug)}>
            <FaceMark verdict={e.verdict} size={32} variant="round" />
            <span class="row-body">
              <b>{e.name}</b>
              <span class="text-secondary">
                {e.municipality.city} · {formatDate(latestInspectionDate(e)!)}
              </span>
            </span>
            <span class="verdict" style={`color: ${VERDICT[e.verdict!].colorVar}`}>
              {VERDICT[e.verdict!].label}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="container block how">
    <h2>Så fungerar bedömningen</h2>

    {/* Skalan med rikets egna tal: legend och omfattning i samma rad. Låg en
        stund i heron, men hör hemma här — den som redan skrollat hit vill
        veta vad nivåerna betyder, medan den som kom för sin kommun ska nå
        korten först. Färgerna är semantiska, aldrig dekor. */}
    <ul class="scale">
      {levels.map((l) => (
        <li>
          <FaceMark verdict={l.verdict} size={40} variant="round" />
          <span class="scale-body">
            <b>{VERDICT[l.verdict].label}</b>
            <span class="text-secondary">
              {formatNumber(l.count)} verksamheter
            </span>
          </span>
        </li>
      ))}
    </ul>

    <div class="steps">
      <article>
        <h3>Officiella kontroller</h3>
        <p class="text-secondary">
          Underlaget är kommunernas egna kontrollrapporter, allmänna
          handlingar, inte tyckande och inte recensioner.
        </p>
      </article>
      {/* Nivåerna står redan i heron med sina tal. Här får steget i stället
          bära det som INTE syns någon annanstans: att en kontroll är många
          punkter och att vi visar dem var för sig. */}
      <article>
        <h3>Punkt för punkt</h3>
        <p class="text-secondary">
          En kontroll gäller allt från kylkedja och rengöring till
          allergenmärkning. Varje sida visar vilka punkter som granskades och
          vilka som fick avvikelse.
        </p>
      </article>
      <article>
        <h3>Öppen metodik</h3>
        <p class="text-secondary">
          Hela beräkningen är publicerad, och verksamheten har rätt att svara.
          Svaret publiceras oredigerat.
        </p>
      </article>
    </div>
    <p class="method-link"><a href="/metodik/">Läs hela metodiken</a></p>
  </section>
</Base>

<style>
  /* Heron ligger på en egen botten.
   *
   * --canvas är numera ren vit på ägarens begäran, så en vit hero mot en vit
   * sida är ingen sektion alls — den flyter ut i intet, och det var precis
   * det som fick den att läsa som tom och overklig. Botten här är Prikkos
   * egen blå på 6 %, inte grått: det grå var det ägaren ville bort ifrån.
   *
   * Uträknat mot #F0F7FD (= --brand 6 % över vitt):
   *   --text          15,6:1  ✓
   *   --text-secondary 4,69:1 ✓
   *   --brand-ink      5,64:1 ✓
   *   --text-muted     2,38:1 ✗  — får alltså inte användas här.
   */
  .hero {
    padding-block: var(--s-8) 0;
  }

  .hero-inner { max-width: 720px; }

  h1 {
    margin-top: var(--s-1);
    font-size: 36px;
    line-height: 40px;
    letter-spacing: -.026em;
  }

  .lede {
    margin-top: var(--s-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
  }

  /* Talen står i löptexten, inte som en egen rad stora siffror. De är ett
     belägg för meningen de sitter i, och blir mindre trovärdiga när de bryts
     ut och blåses upp — då läser de som en marknadsföringsplansch. */
  .lede b { font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }

  .shortcuts {
    margin-top: var(--s-4);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  .shortcuts a { margin-inline: 3px; }
  .shortcuts span { color: var(--text-secondary); }

  /* Skalan: tre celler i ett rutnät med delade hårlinjer, samma grepp som
     FactGrid. Inga fristående kort — det är en skala, inte tre erbjudanden. */
  .scale {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin: var(--s-6) 0 0;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
  }

  .scale li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
  }

  .scale li + li { border-left: 1px solid var(--hairline); }

  .scale-body { min-width: 0; }

  .scale-body b {
    display: block;
    font-size: var(--fs-body-s);
    line-height: 19px;
    font-weight: 600;
  }

  .scale-body span {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  .block { padding-block: var(--s-12) 0; max-width: 900px; }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .block-head a { font-size: var(--fs-body-s); }

  /* Kommunkorten. Rutnätet äger bara placeringen — kortets egen form bor i
     KommunKort.astro. Minsta spalt 250 px: under det blir bildzonen bredare i
     förhållande till sin höjd än fotot tål. */
  .kommuner {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--s-4);
  }

  .rows { list-style: none; margin: var(--s-4) 0 0; padding: 0; }
  .rows li { border-top: 1px solid var(--hairline); }

  .rows a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    color: var(--text);
  }

  .rows a:hover { text-decoration: none; }
  .rows a:hover b { color: var(--brand); }

  .row-body { flex: 1; min-width: 0; }
  .row-body b { display: block; font-size: var(--fs-body-s); font-weight: 600; }
  .row-body span { font-size: var(--fs-caption); }

  .verdict { font-size: var(--fs-caption); font-weight: 600; flex-shrink: 0; }

  .how { padding-bottom: var(--s-12); }
  .how h2 { text-align: center; }

  .steps {
    margin-top: var(--s-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s-6);
  }

  .steps h3 { font-size: var(--fs-body); }
  .steps p { margin-top: var(--s-2); font-size: var(--fs-body-s); line-height: 21px; }

  .method-link { text-align: center; margin-top: var(--s-8); font-size: var(--fs-body-s); }

  /* Under 700 px innehållsbredd ryms inte tre skalceller bredvid varandra.
     Rutnätet radbryter då av sig självt, och kanterna måste följa med:
     vänsterlinjen hör till en rad som inte längre finns. */
  @media (max-width: 760px) {
    .scale { grid-template-columns: minmax(0, 1fr); }
    .scale li + li {
      border-left: 0;
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 640px) {
    .hero { padding-block: var(--s-6); }
    h1 { font-size: 30px; line-height: 34px; }
    .verdict { display: none; }
  }
</style>
