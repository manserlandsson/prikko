---
/**
 * Startsidan.
 *
 * ══ FORMEN, OCH VAR DEN KOMMER IFRÅN ════════════════════════════════════
 *
 * Två förlagor, båda uppmätta i webbläsaren 2026-08-21 och inte skrivna ur
 * minnet. Elva skärmbilder ligger i research/forlagor/ och måtten i
 * docs/40_startsidan.md.
 *
 *   airbnb.se   `h1` är 1 × 1 pixel. Ingen hjälte, ingen värdetext, ingen
 *               förklaring av tjänsten. Sökfält, kategorirad, kort.
 *               Sökfältet fälls ihop vid rullning: 850 × 66 blir 458 × 46
 *               på 452 ms.
 *   ednia.se    ingen `h1` alls. Sökfält i sidhuvudet, ikonrad under, kort
 *               direkt. Kortet är ett BILDBAND med en rund bricka nedsänkt
 *               i nedre vänstra hörnet.
 *
 * Sidan gör samma sak. `h1` finns för sökmotorn och skärmläsaren och syns
 * inte. Ingen rubrik, ingen hjälte, ingen förklaring.
 *
 * ══ TRE SAKER ÄGAREN UNDERKÄNDE, OCH VAD SOM GJORDES ════════════════════
 *
 * 1. "du gjorde ju inte animationen som airbnb har, det ser seriöst sämst
 *    ut". Rätt. Måtten var uppmätta men aldrig byggda. Ihopfällningen ligger
 *    nu i Header.astro med Airbnbs egen fjäder, samplad i elva steg, och
 *    .storsok nedan är tomrummet det stora läget hänger i.
 *
 * 2. "vi kör bilder på dom som finns ... bildens attribution visas ju när
 *    man väl klickar in, vilket var deras krav". Rätt igen, och CC BY-SA
 *    4.0 §3(a)(2) säger det rakt ut. Korten bär foto där foto finns. Se
 *    Verksamhetskort.astro för hela licensresonemanget.
 *
 * 3. "vi måste bygga egna kategorier själva, för vi har för få nu ... och
 *    restauranger säger ingenting". Rätt. Fem breda kategorier är ingen
 *    rad att rulla. Tjugo matkategorier byggda ur OpenStreetMaps `cuisine`,
 *    `amenity` och `shop` ligger nu i lib/matkategori.ts.
 *
 * ══ EN POOL, INTE TJUGOEN LISTOR ════════════════════════════════════════
 *
 * Kategoriraden filtrerar med `:has()` på radioknappar, alltså utan skript
 * och utan sidladdning, samma grepp som artikellistans sortering redan
 * använder. Priset är att allt som kan visas måste stå i markupen.
 *
 * Tjugoen grupper à tolv kort vore 252 kort. I stället renderas varje
 * verksamhet EN gång och bär sina grupper i `data-kat`. Ett ställe som är
 * både Pizza och Italienskt står i markupen en gång och syns under båda.
 * Unionen blir omkring 130 kort i stället för 252.
 *
 * Faller `:has()` bort visas hemgruppen, vilket är sidans grundläge ändå.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import FaceSprite from '../components/FaceSprite.astro';
import Matikon from '../components/Matikon.astro';
import Verksamhetskort from '../components/Verksamhetskort.astro';

import { articleImage, HERO_WIDTHS } from '../lib/artikelbilder';
import { readingMinutes, sectionReady } from '../lib/artiklar';
import {
  categoriesOf,
  coverage,
  establishments,
  formatNumber,
  latestInspectionDate,
  municipalityCategories,
  municipalitySummaries,
  topCategory,
  visbarBild,
  type Establishment,
  type TopCategoryId,
} from '../lib/data';
import {
  arMatplats,
  MATKATEGORIER,
  matkategorierFor,
  type MatkategoriId,
} from '../lib/matkategori';
import { bildmotiv, bildmotivAntal } from '../lib/bildmotiv';
import {
  hasNationalPage,
  movementMunicipalities,
  nationalMovement,
} from '../lib/rorelse';
import { PLATS_HANDELSE, PLATS_NYCKEL } from '../lib/platsminne';
import { SITE } from '../lib/site';
import { absolute, path } from '../lib/urls';

const total = coverage();

// ---------------------------------------------------------------------------
// Beståndet, genomgånget EN gång
// ---------------------------------------------------------------------------

/**
 * Verksamhetens rad i poolens urval.
 *
 * `foto` är sant bara när bilden får visas. Samma grind som
 * Verksamhetskort.astro och Bildband.astro sätter, och den bor i lib/db.ts:
 * en bild vars licens vi inte kan skriva ut på verksamhetssidan får inte
 * heller stå på ett kort, för då finns ingen resurs att hänvisa
 * attributionen till. En bild vi tagit själva behöver ingen licenskod.
 */
interface Rad {
  e: Establishment;
  kategorier: MatkategoriId[];
  datum: string | null;
  foto: boolean;
  konsument: boolean;
}

/**
 * Konsumentvänd betyder restaurang, café eller butik enligt categories.ts.
 * Resten är förskolekök, äldreboenden, matmäklare, grossister och
 * dricksvattenposter. Samma grind som pipeline/oppettider.py sätter, och
 * samma lista: ändras den där ska den ändras här.
 */
const KONSUMENT = new Set<TopCategoryId>(['restaurang', 'cafe', 'butik']);

const rader: Rad[] = establishments().map((e) => {
  const topp = categoriesOf(e).categories;
  return {
    e,
    kategorier: matkategorierFor(e),
    datum: latestInspectionDate(e),
    /* Grinden bor i lib/db.ts och stod här som `e.image.licence` rakt av.
       Det var för hårt: en bild vi tagit själva har ingen licenskod och
       behöver ingen, så våra egna foton hade räknats som "utan bild" i hela
       urvalet till startsidan. Se `visbarBild`. */
    foto: Boolean(visbarBild(e.image)),
    /*
     * INTE bara "har en konsumentkategori", utan också "är inte en skola".
     *
     * Blackebergs Gymnasium bär både `Skola och omsorg` och ett cafévärde i
     * kommunens typer, alltså blev det både skola OCH café och slank igenom
     * den mildare grinden rakt in i "Kända ställen". Ett gymnasium med
     * skolcafé är fortfarande ett gymnasium.
     */
    konsument: topp.some((c) => KONSUMENT.has(c)) && !topp.includes('skola'),
  };
});

/**
 * Nyast först. Ordningen är KRONOLOGISK och går inte att vända, och det är
 * villkoret som gör hela sidan tillåten: en rad som visar bedömningar får
 * aldrig kunna läsas som en rangordning, och ett datum rangordnar ingenting.
 * Det finns ingen sorteringskontroll, ingen "sämst först", och kommunerna
 * ställs aldrig mot varandra på kontrollresultat.
 */
const kronologi = [...rader]
  .filter((r) => r.datum !== null)
  .sort(
    (a, b) =>
      b.datum!.localeCompare(a.datum!) ||
      a.e.name.localeCompare(b.e.name, 'sv'),
  );

/**
 * Plocka ur en sorterad lista med tak per kommun.
 *
 * Taket är spridning och inte rangordning. Utan det blir varje rad
 * Stockholm: av de 60 senast kontrollerade i landet ligger 42 där, vilket
 * följer av att Stockholm är 8 520 av 16 047 verksamheter och publicerar
 * oftast. Ingen kommun kan hamna över eller under en annan av ett tak.
 */
/**
 * Plockar `antal` rader med ett tak per kommun, och FYLLER PÅ när taket
 * svälter listan.
 *
 * Påfyllningen kom till 2026-08-25. Ägaren räknade korten i en kategoriflik
 * och trodde att registret var nästan tomt: "tydligen har vi bara 66
 * kategoriserade verksamheter, det är katastrofalt."
 *
 * Registret är inte tomt. Uppmätt samma dag: 4 824 av 16 047 bär en
 * matkategori, alltså 30 procent av alla och 48 procent av de konsumentvända.
 * Sushi ensamt har 172. Det han såg var elva.
 *
 * Felet satt här. Taket på två per kommun finns för hemgruppen, där det ska
 * hindra att raden blir enfärgat Stockholm, men det tillämpades också på
 * kategoriflikarna. Där betyder det att Sushi aldrig kan visa mer än 24
 * oavsett hur många som finns, och i praktiken elva, eftersom bara sex
 * kommuner har någon sushi alls.
 *
 * Nu görs två svep. Det första håller taket, så att spridningen mellan
 * kommuner blir densamma som förut och de bästa raderna ur varje kommun
 * kommer först. Det andra fyller på ur samma lista utan tak, men bara om
 * antalet inte nåtts. En kategori med bredd påverkas alltså inte alls, och en
 * smal kategori får fylla sin rad med det som finns.
 *
 * Ordningen i listan är redan den rätta när den kommer hit, se
 * `kategoriurval`: foto först, sedan datum. Påfyllningen tar därför nästa
 * bästa och inte en slumpmässig rad.
 */
function plocka(lista: Rad[], antal: number, takPerKommun: number): Rad[] {
  const rakning = new Map<string, number>();
  const ut: Rad[] = [];
  const valda = new Set<Establishment>();

  for (const rad of lista) {
    const n = rakning.get(rad.e.municipality.slug) ?? 0;
    if (n >= takPerKommun) continue;
    rakning.set(rad.e.municipality.slug, n + 1);
    ut.push(rad);
    valda.add(rad.e);
    if (ut.length === antal) return ut;
  }

  for (const rad of lista) {
    if (valda.has(rad.e)) continue;
    ut.push(rad);
    if (ut.length === antal) break;
  }
  return ut;
}

// ---------------------------------------------------------------------------
// Hemgruppen: de som bär ett fotografi
// ---------------------------------------------------------------------------

/**
 * "Kända ställen i Stockholm".
 *
 * Ägaren 2026-08-22: "visa typ kända ställen i stockholm eller något, med bra
 * bilder, det ska vara schyssta bilder i guess."
 *
 * ══ VARFÖR EN STAD OCH INTE HELA LANDET ═════════════════════════════════
 *
 * Förra versionen spred tolv kort över sex kommuner med ett tak på tre per
 * kommun, och det gav en rad med två kyrkor, en studentnation och en arena i.
 * Skälet var räknat: 147 av de 210 bilderna ligger i Stockholm, så ett tak
 * tvingade in kommuner som bara hade byggnadsfoton att bidra med.
 *
 * Med staden namngiven i rubriken behövs inget tak, och då kan urvalet i
 * stället kräva kvalitet. Det är samma grepp som förlagan använder: Airbnbs
 * rader heter "Populära hem i X" och blandar aldrig ihop städer för
 * spridningens skull.
 *
 * Staden VÄLJS UR DATAN och står inte skriven i koden. Den med flest
 * verksamheter som klarar alla grindar vinner, vilket i dag är Stockholm och
 * i morgon kan vara någon annan.
 *
 * ══ NAMNET ═════════════════════════════════════════════════════════════
 *
 * "Populära ställen i Stockholm", på ägarens beslut 2026-08-22, efter att han
 * bett om ordet två gånger.
 *
 * Jag invände först och satte "Kända ställen", med skälet att vi inte mäter
 * popularitet: inga besöksdata, ingen betygsvolym. Invändningen står kvar som
 * en beskrivning av vad ordet BETYDER, och den är värd att känna till för den
 * som en dag vill bygga en riktig popularitetsmätning: det finns ingen i dag,
 * och rubriken bygger inte på en.
 *
 * Det urvalet FAKTISKT delar är att någon lagt ett fotografi av dem på
 * Wikimedia Commons och knutit det till ett Wikidata-objekt, vilket kräver att
 * stället är omskrivet någonstans, plus att OpenStreetMap kartlagt dem som
 * matplats. Operakällaren, Ekstedt, Riche, Sturehof, Den Gyldene Freden.
 *
 * ORDET ÄR MARKNADSFÖRING OCH INTE EN UPPGIFT, och gränsen går vid
 * bedömningen: raden får heta populär, men ingen verksamhet får framställas
 * som bättre eller sämre än en annan på kontrollresultat. Den regeln är
 * orörd, och raden är fortfarande kronologisk.
 *
 * ══ TRE GRINDAR, ALLA TRE RÄKNADE 2026-08-22 ═══════════════════════════
 *
 * 1. KONSUMENTVÄND. 81 av de 210 bilderna sitter på ett SKOLKÖK, eftersom
 *    skolbyggnader är flitigt fotograferade på Commons. Utan grinden blev
 *    raden Torpaskolan, Nyeds Skola och Katedralskolan. Kvar: 127.
 *
 * 2. OSM SÄGER ATT DET ÄR EN MATPLATS, se `arMatplats`. Grinden krävde först
 *    en MATKATEGORI, och det var fel: ägaren 2026-08-22 om att Riche saknades
 *    trots att den har brister som kvarstår och en bild. Riche bär
 *    `amenity=restaurant` och ingenting mer, och "Restaurang" finns inte i
 *    kategoritabellen eftersom den är 8 000 rader. Grinden sållade alltså bort
 *    Operakällaren, Ekstedt, Wedholms Fisk och Den Gyldene Freden, medan
 *    kyrkor med kyrkfik slank igenom på kommunens typ `Café`. Kvar med den
 *    rätta grinden: 33 i landet.
 *
 * 3. BILDENS ÅLDER. Wirströms Pub är fotograferad 1959 och Blå Porten någon
 *    gång 1912 till 1920, båda i svartvitt. De är kända ställen och usla
 *    fotografier av hur det ser ut i dag, vilket är precis vad raden ska
 *    visa. Grinden är alltså inte smak utan samma ärlighetskrav som
 *    Bildband.astro redan bär: en odaterad eller gammal bild är ett
 *    påstående om nuet som inte stämmer. Kvar: nio i Stockholm.
 *
 * ══ ANTALET RUTOR ══════════════════════════════════════════════════════
 *
 * Se HEM_FORSTA nedan. Talet stod förut här som tolv och var mätt på en rad
 * som bara visade Stockholm i fyra spalter. Båda förutsättningarna är borta:
 * raden är rikstäckande och rutnätet sex spalter.
 *
 * Ett skäl ur den gamla räkningen lever kvar och är värt att minnas. Plats
 * 14, 15, 21 och 22 i det gamla urvalet var Västerortskyrkan,
 * Uppenbarelsekyrkan, Markuskyrkan och Abrahamsbergskyrkan. De är korrekt
 * klassade, kyrkfik ÄR caféer i vårt register, men fyra kyrkor i rad på en
 * matsajt läser som att vi skrapat botten. Den gången löstes det genom att
 * kapa raden vid tolv. Nu löser bildrangen det i stället: en kyrka är bedömd
 * som `byggnad` eller obedömd och inte matplats, alltså rang 2 eller 3, och
 * hamnar i svansen oavsett hur många rutor raden har.
 */
/**
 * HEMGRUPPENS FÖRSTA VÄNDA ÄR FEM RADER, INTE TVÅ.
 *
 * Ägaren 2026-08-22: "det ska ej vara en knapp med visa fler, det ska vara på
 * skroll, så är det någon laddning animation."
 *
 * Med tolv kort i sex spalter blev första vändan två rader, och då ligger
 * vaktposten under rutnätet ALLTID inne i vyn redan vid inladdningen. Uppmätt
 * i bygget 2026-08-22 vid 1440 × 900: vaktposten hamnade omkring 750 px ned,
 * rutans nedre kant med marginal ligger på 1 100, alltså avslöjades alla
 * trettiosex korten innan man rört musen. Rullningen fanns i koden men
 * inträffade aldrig.
 *
 * Räknat: innehållet ovanför rutnätet är omkring 306 px och varje kortrad 222.
 * Fem rader lägger vaktposten på omkring 1 416, vilket är under kanten på
 * varje fönster upp till 1 216 px höjd. Fyra rader hade gett 1 194 och alltså
 * inte räckt på en skärm i fullskärm.
 *
 * Talet är hemgruppens eget. Kategoriflikarna behåller PER_SIDA, för deras
 * hela innehåll är PER_KATEGORI och en femradersvända hade gjort "visa fler"
 * meningslöst där.
 */
const HEM_FORSTA = 30;

/** Äldre än så och bilden visar inte stället som det är i dag. */
const HOGSTA_BILDALDER = 20;

/**
 * Årtalet ur attributionsraden, eller null.
 *
 * Raden byggs i pipeline/prikko/commons.py och ser ut som "Foto:
 * Holger.Ellgaard, 2020" eller "Okänd fotograf, 1912 till 1920". `capturedAt`
 * duger inte: fältet är en `date` i databasen och står tomt på fem av de elva,
 * eftersom Commons ofta bara känner ett årtal och ibland ett spann.
 *
 * Första fyrsiffriga talet vinner, och saknas det får bilden ingen ålder.
 * Utan ålder står verksamheten utanför raden men finns kvar överallt annars:
 * en odaterad bild är inte fel att visa, den duger bara inte som påstående om
 * hur det ser ut i dag.
 */
function fotoAr(attribution: string | null | undefined): number | null {
  const traff = /\b(1[89]\d{2}|20\d{2})\b/.exec(attribution ?? '');
  return traff ? Number(traff[1]) : null;
}

const iAr = new Date().getUTCFullYear();

/**
 * MATPLATSGRINDEN ÄR NEDFLYTTAD FRÅN URVAL TILL ORDNING.
 *
 * Den satt först som ett krav, och det kostade för mycket. Räknat 2026-08-22
 * över de 210 bilderna:
 *
 *   med bild, konsumentvänd och inte skola     99 rena, 8 brister, 3 kvarstår
 *   av dem, som OSM kallar matplats            36 rena, 3 brister, 1 kvarstår
 *
 * Grinden slängde alltså SJU av elva verksamheter med anmärkning, och det är
 * precis de ägaren bett om två gånger: "ha gärna på fronten blandat
 * restauranger med anmärkningar, brister som kvartsår, som också har bilder."
 *
 * Kravet är därför bara konsumentvänd, inte skola och en daterad bild som är
 * högst tjugo år. Att OSM kallar stället matplats är i stället en
 * SORTERINGSNYCKEL: de bäst belagda krogarna ligger först bland de rena, och
 * de med anmärkning kommer med oavsett.
 */
const kandaKandidater = kronologi.filter((r) => {
  if (!r.foto || !r.konsument) return false;
  const ar = fotoAr(r.e.image?.attribution);
  return ar !== null && iAr - ar <= HOGSTA_BILDALDER;
});

/**
 * HELA LANDET, INTE EN STAD.
 *
 * Ägaren 2026-08-22: "det behöver ej heta populära ställen i stockholm, du kan
 * kalla det för populara ställen på prikko eller något som passar bättre, då
 * kan du köra från andra städer också."
 *
 * Raden hette först "Kända ställen i Stockholm" och valde staden ur datan.
 * Skälet var att bildbeståndet är Stockholm: 147 av 210. Med den rätta
 * matplatsgrinden är fördelningen 32 Stockholm och 1 Jönköping av 33, så
 * spridningen blir inte mycket bättre av att raden är nationell.
 *
 * Rubriken blir ändå sannare utan stad, och det är skälet att byta: den lovar
 * inte längre en stadsrad den inte är, och den dag Göteborg eller Malmö kommer
 * in behöver ingen röra koden.
 */

/**
 * BLANDA BEDÖMNINGARNA.
 *
 * Ägaren 2026-08-22: "ha gärna på fronten blandat restauranger med
 * anmärkningar, brister som kvartsår, som också har bilder."
 *
 * Räknat samma dag över de 33 kandidaterna:
 *
 *   rena                    29
 *   brister                  2   Lundbergs Konditori, Nalen
 *   brister som kvarstår     1   Riche
 *   utan bedömning           1   Hamburger Börs
 *
 * Alla fyra icke-rena får plats, alltså en tredjedel av tolv rutor. Fler finns
 * inte: det är hela beståndet av verksamheter som både har en bild vi får visa
 * och en bedömning som inte är ren.
 *
 * DET HÄR ÄR INGEN RANGORDNING. Reserveringen ser bara till att raden inte
 * blir enfärgat grön av en slump. Ordningen i rutnätet är fortfarande
 * kronologisk, och rubriken säger ingenting om vilken verksamhet som är bäst
 * eller sämst.
 */
const HOGST_ICKE_RENA = Math.floor(HEM_FORSTA / 3);

/** Hela hemgruppen, alltså första vändan plus det "Visa fler" avslöjar. */
const HEM_POOL = 60;

/**
 * RANGEN VÄGER DOMEN OCH TAGGEN IHOP, och måste göra det.
 *
 * Första försöket sorterade bara på domen med matplatsen som andrahandsnyckel.
 * Utfallet mättes i bygget: Van Der Nootska Palatset låg ETTA och Westmanska
 * Palatset tia. Båda är palats, båda saknade dom, och en saknad dom rankade
 * över ett bedömt hus. Domen fanns bara för de 33 som bär `amenity`, och
 * palatsen är inte taggade som matplatser.
 *
 *   0  bedömd som krog
 *   1  obedömd, men OSM säger matplats: sannolikt en krog vi inte hunnit se
 *   2  bedömd som hus
 *   3  obedömd och inte matplats: sannolikt en kyrka, ett museum, en biograf
 *
 * Tvåan före trean är avsiktlig. Ett bedömt hus är ändå ett ställe man äter
 * på; en obedömd icke-matplats är oftast inte det.
 */
function bildrang(r: Rad): number {
  const dom = bildmotiv(r.e);
  if (dom === 'stallet') return 0;
  if (dom === 'byggnad') return 2;
  /* `annat` är bedömt och underkänt, alltså sist, aldrig i mitten: en bild som
     varken visar stället eller huset säljer ingenting. Bara det OBEDÖMDA får
     mittenplatsen. */
  if (dom === 'annat') return 3;
  return arMatplats(r.e) ? 1 : 3;
}

/* Samma bildregel som för de rena nedan: krogen först, huset sist. Här
   avgör den vilka icke-rena som får de reserverade platserna den dag de är
   fler än platserna. I dag är de exakt fyra och alla fyra får plats. */
const ickeRena = kandaKandidater
  .filter((r) => r.e.verdict !== 'clean')
  .sort((a, b) => bildrang(a) - bildrang(b));

/**
 * KROGEN FÖRE BYGGNADEN.
 *
 * Ägaren 2026-08-22: "restaurangerna med bilder på restaurangen istället för
 * ett stort palats vill vi visa långt uppe i populära lista, så tex: riche,
 * sushi sho, dashi, rolfs kök, den gröne jägaren, tudor arms, prinsen, etc
 * inga palats, annars ok."
 *
 * Matplatsgrinden räcker inte för det. Operakällaren och Spritmuseum bär
 * också `amenity=restaurant` och passerar den, men deras fotografi är ett hus
 * över ett torg. Det som skiljer sitter i BILDEN, inte i taggen.
 *
 * Ett namnord provades först och hade fel om sex av trettiotre: Herrängens
 * Gård är en krog med skylten i bild, Wedholms Fisk är ett hörnhus där krogen
 * knappt syns, och Hasselbacken bär inget byggnadsord alls trots att bilden
 * är ett rosa palats med staty framför. Regeln ströks och bilderna öppnades i
 * stället, en och en. Se lib/bildmotiv.ts.
 *
 * Ordningen blir alltså: krogen, det obedömda, huset. Huset sorteras SENARE,
 * aldrig bort. Ett konferenshus med bild är fortfarande bättre än en tom ruta.
 * Matplatsgrinden lever kvar som andrahandsnyckel och skiljer bara inom en
 * grupp där bilden inte har någon dom.
 */

const rena = kandaKandidater
  .filter((r) => r.e.verdict === 'clean')
  .sort((a, b) => bildrang(a) - bildrang(b));


const hem =
  kandaKandidater.length > 0
    ? [
        ...ickeRena.slice(0, HOGST_ICKE_RENA),
        ...rena,
        ...ickeRena.slice(HOGST_ICKE_RENA),
      ].slice(0, HEM_POOL)
    : plocka(kronologi, HEM_POOL, 2);

const hemRubrik = 'Populära ställen';

// ---------------------------------------------------------------------------
// Kategorigrupperna
// ---------------------------------------------------------------------------

/**
 * Tolv i första vändan och tolv till bakom "Visa fler".
 *
 * Ägaren 2026-08-22: "jag gillar laddiden, kanske inte oändlig laddning men
 * ändå lite."
 *
 * Ingen oändlig skroll alltså, och inte heller ett anrop: sajten är statisk,
 * så det finns ingen tjänst att fråga. Nästa vända står redan i markupen och
 * avslöjas av en kryssruta. Priset är att poolen växer, och det är räknat:
 * åtta per kategori gav 154 kort i markupen, tjugofyra ger omkring 330.
 */
const PER_SIDA = 12;
const PER_KATEGORI = 24;

/**
 * Foto först, sedan datum.
 *
 * Det är ett VISNINGSval och inte en bedömning: ett kort med fotografi bär
 * mer information än ett med tonplatta, och raden ska visa vad vi har.
 * Ordningen inom respektive halva är fortfarande kronologisk.
 */
function kategoriurval(id: MatkategoriId): Rad[] {
  const traffar = kronologi.filter((r) => r.kategorier.includes(id));
  const sorterade = [
    ...traffar.filter((r) => r.foto),
    ...traffar.filter((r) => !r.foto),
  ];
  return plocka(sorterade, PER_KATEGORI, 2);
}

interface Grupp {
  id: string;
  ikon: 'alla' | MatkategoriId;
  etikett: string;
  /**
   * Hur många verksamheter gruppen bär.
   *
   * Talet visas INTE i raden. Det stod en stund under varje etikett, och
   * ägaren 2026-08-25: "varför har du lagt till nummer under kategoriradan,
   * ser sämst ut?" Han har rätt: raden är navigering och inte statistik, och
   * tolv tal under tolv ord gör den till en tabell man ska läsa i stället för
   * en rad man ska välja ur. Räknaren på "Visa fler" säger redan vad ett
   * klick ger, och den säger det på det ställe där valet får en följd.
   *
   * Fältet står kvar eftersom det är billigt och kan behövas den dag raden
   * ska sortera eller gallra på storlek.
   */
  antal: number;
}

const grupper: Grupp[] = [{ id: 'hem', ikon: 'alla', etikett: 'Alla', antal: hem.length }];

/**
 * Vilka grupper varje verksamhet står i. Kortet renderas en gång och
 * grupperna hamnar i `data-kat`.
 *
 * `platsPerRad` håller kortets PLATS i varje grupp, och det behövs för
 * "Visa fler": ett kort kan vara nummer tre under Pizza och nummer tjugo
 * under Café. Ett kort räknas som extra bara när det ligger efter
 * PER_SIDA i ALLA sina grupper, annars hade det försvunnit från en flik
 * där det egentligen hör hemma på första vändan.
 */
const grupperPerRad = new Map<Establishment, Set<string>>();
const platsPerRad = new Map<Establishment, number[]>();
const pool: Rad[] = [];

function laggTill(rad: Rad, grupp: string, plats: number) {
  let set = grupperPerRad.get(rad.e);
  if (!set) {
    set = new Set();
    grupperPerRad.set(rad.e, set);
    platsPerRad.set(rad.e, []);
    pool.push(rad);
  }
  set.add(grupp);
  platsPerRad.get(rad.e)!.push(plats);
}

hem.forEach((rad, i) => laggTill(rad, 'hem', i));

/**
 * Grupperna där kortet ligger EFTER första vändan, som en ordlista.
 *
 * Per grupp och inte som en enda flagga, och skälet är mätt: ett kort kan
 * vara nummer tre under Pizza och nummer tjugo under Café. Med en enda flagga
 * fick jag välja mellan att dölja det på fliken där det hör hemma tidigt,
 * eller att visa det på fliken där det hör hemma sent. Utfallet av det andra
 * var att Café visade sexton kort i första vändan i stället för tolv.
 */
function extraGrupper(e: Establishment): string {
  const grupperna = [...grupperPerRad.get(e)!];
  const platser = platsPerRad.get(e)!;
  /* Tröskeln är per grupp: hemgruppen visar HEM_FORSTA i första vändan,
     kategorierna PER_SIDA. Ett kort kan ligga i båda och vara tidigt i den
     ena och sent i den andra. */
  const extra = grupperna.filter(
    (g, i) => platser[i] >= (g === 'hem' ? HEM_FORSTA : PER_SIDA),
  );

  /* Platsgruppen räknar i sin egen kommun och delar hemgruppens tal: båda
     visar hela sidans bredd och inte en kategoriflik. Stockholm har 237 kort
     i poolen, och utan taket hade brickan öppnat med alla 237 i markupen
     synliga på en gång.

     `platsRank` fylls längre ned i filen och är därför tom om någon flyttar
     upp anropet. Funktionen körs vid rendering, alltså efter hela
     frontmattern, och det är villkoret för att raden ska stämma. */
  if ((platsRank.get(e) ?? 0) >= HEM_FORSTA) extra.push('plats');

  return extra.join(' ');
}

for (const kategori of MATKATEGORIER) {
  const urval = kategoriurval(kategori.id);
  // En kategori som inte fyller sina rutor står inte i raden. Fyra kort
  // under en flik som utlovar en hel sorts mat läser som ett fel.
  if (urval.length < 4) continue;
  grupper.push({ id: kategori.id, ikon: kategori.id, etikett: kategori.namn, antal: urval.length });
  urval.forEach((rad, i) => laggTill(rad, kategori.id, i));
}


/**
 * GRIND: varje grupp i raden MÅSTE ha en :has()-regel i stilblocket.
 *
 * Reglerna är utskrivna en per grupp och kan inte genereras, se stilblocket.
 * Läggs en tjugoförsta kategori i matkategori.ts utan att reglerna följer med,
 * blir följden en flik som visar noll kort, och ingenting klagar: markupen är
 * giltig, kategorin finns, och felet syns bara för den som råkar klicka.
 *
 * Talet står därför här och bygget faller om det inte stämmer.
 */
const RADENS_GRUPPER = grupper.map((g) => g.id);
const REGLER_FINNS = [
  'hem', 'livsmedel', 'snabbmat', 'cafe-fik', 'pizza', 'asiatiskt', 'bar',
  'sushi', 'burgare', 'italienskt', 'kiosk', 'bageri', 'kebab', 'medelhav',
  'sallad', 'thai', 'indiskt', 'konditori', 'grill', 'mellanostern', 'glass',
];
const utanRegel = RADENS_GRUPPER.filter((id) => !REGLER_FINNS.includes(id));
if (utanRegel.length > 0) {
  throw new Error(
    `Startsidans kategorirad bär ${utanRegel.join(', ')}, som saknar :has()-regel ` +
      `i index.astro. Lägg till en rad i BÅDA väljarlistorna i stilblocket, ` +
      `annars visar fliken noll kort.`,
  );
}

/**
 * Poolens ordning i markupen är EN ordning för alla grupper. Rutnätet visar en
 * grupp i taget, så ordningen inom en grupp är det enda som syns, och den ska
 * vara densamma oavsett vilken flik man kom från.
 *
 * FOTO FÖRST, SEDAN DATUM.
 *
 * Ägaren 2026-08-22: "om man använder filter, dvs, tex trycker på sushi så ska
 * alternativ med bilder komma upp först."
 *
 * Urvalet gjorde redan det, se `kategoriurval`, men RENDERINGEN gjorde det
 * inte: poolen sorterades enbart kronologiskt, så en flik visade sina åtta
 * kort i datumordning och fotona hamnade var som helst. Urvalet och ordningen
 * är två olika saker, och bara den andra syns.
 *
 * Det här är ingen rangordning. Ett fotografi säger ingenting om hygienen; det
 * säger att vi vet mer om stället, och den som bläddrar ska se det vi vet
 * först.
 */
pool.sort(
  (a, b) =>
    Number(b.foto) - Number(a.foto) ||
    (b.datum ?? '').localeCompare(a.datum ?? '') ||
    a.e.name.localeCompare(b.e.name, 'sv'),
);

/**
 * SPRID UT BEDÖMNINGARNA I HEMGRUPPEN.
 *
 * Ägaren 2026-08-22: "hade uppskattat om du blandar dom listade på populära i
 * homepagen, inte liksom i ordning från inga avvikelser, till brister, till
 * brister kvarstår, ser mer legit ut om du blandar ordning lite."
 *
 * Han har rätt i vad han såg. Poolen sorteras på foto och sedan datum, och
 * datumen råkade lägga de fyra icke-rena sist i raden, så den läste som en
 * trappa: först allt rent, sedan bristerna, sist de kvarstående. En rad som
 * ser sorterad ut på bedömning läses som en rangordning även när den inte är
 * det, och det är precis vad sajten aldrig får göra.
 *
 * Spridningen görs på PLATS och inte på slump: de icke-rena läggs jämnt
 * fördelade genom de tolv första rutorna. Det är stabilt mellan bygganden,
 * till skillnad från en slumpordning som hade gjort varje nattkörning till en
 * ny sida utan att datan ändrats.
 *
 * Sprids bara det som faktiskt SYNS, alltså de tolv första. Resten av
 * hempoolen ligger kvar i sin ordning bakom rullningen.
 */
const hemSet = new Set(hem.map((r) => r.e));

/**
 * Ordningen bland de icke-rena: allvarligast först i kön till platserna.
 *
 * Ägaren 2026-08-22: "jag vill få upp riche på högsta raden."
 *
 * DETTA RANGORDNAR INTE VERKSAMHETER. Ordningen säger inte att Riche är sämre
 * eller bättre än något annat kort; den ser till att raden visar hela spannet
 * av utfall direkt, i stället för att de lindrigaste råkar ligga överst.
 * Rubriken heter "Populära ställen" och inte något som pekar ut ett ställe att
 * undvika, och det är den gränsen som gäller.
 */
const ALLVAR: Record<string, number> = { major: 0, minor: 1 };

const forsta = hem.slice(0, HEM_FORSTA);
const orena = forsta
  .filter((r) => r.e.verdict !== 'clean')
  .sort(
    (a, b) =>
      (ALLVAR[a.e.verdict ?? ''] ?? 2) - (ALLVAR[b.e.verdict ?? ''] ?? 2) ||
      bildrang(a) - bildrang(b),
  );
const renaIForsta = forsta.filter((r) => r.e.verdict === 'clean');

const blandad: Rad[] = [...renaIForsta];
if (orena.length > 0) {
  const steg = Math.max(1, Math.round(forsta.length / (orena.length + 1)));
  orena.forEach((r, i) => {
    blandad.splice(Math.min(blandad.length, (i + 1) * steg - 1), 0, r);
  });
}

/**
 * HEMGRUPPEN SKRIVER SIN EGEN ORDNING TILLBAKA I POOLEN, och utan det steget
 * betyder ingenting av arbetet ovanför något.
 *
 * `pool.sort()` några rader upp sorterar HELA poolen på foto, datum och namn,
 * för att en kategoriflik ska visa samma ordning oavsett var man kom ifrån.
 * Den sorteringen körde efter att hemgruppen lagts in, alltså slog den ut både
 * bildrangen och bedömningsspridningen.
 *
 * Uppmätt i bygget 2026-08-22, och felet var osynligt i koden: `hem[0]` var
 * Riche precis som avsett, men `pool[0]` var Van Der Nootska Palatset. Den
 * gamla reparationen läste ordningen ur POOLEN i stället för ur `hem`, så dess
 * "icke-rena i första vändan" blev noll stycken och hela blandningen hoppades
 * över utan ett ljud.
 *
 * Rättningen är att bygga ordningen ur `hem` och skriva den på exakt de
 * platser hemgruppens rader redan har i poolen. Platserna rörs inte, bara
 * innehållet, så ingen annan grupp får ett hål eller en dubblett.
 *
 * Priset är att ett kort som ligger i BÅDE hemgruppen och en kategori kan byta
 * plats inom kategorin. Det är rätt pris: alternativet var en startsida som
 * öppnar med ett palats.
 */
const hemPlatser: number[] = [];
pool.forEach((r, i) => {
  if (hemSet.has(r.e)) hemPlatser.push(i);
});

const hemOrdning = [...blandad, ...hem.slice(HEM_FORSTA)];

if (hemPlatser.length !== hemOrdning.length) {
  throw new Error(
    `Hemgruppen har ${hemPlatser.length} platser i poolen men ${hemOrdning.length} rader att skriva. ` +
      `Ordningen på startsidan går inte att lita på.`,
  );
}

hemPlatser.forEach((plats, i) => {
  pool[plats] = hemOrdning[i];
});

/**
 * De sex korten i hemgruppens FÖRSTA rad laddar sitt foto ivrigt.
 *
 * Poolen är sorterad kronologiskt över alla grupper, så "de fyra första i
 * poolen" är inte de fyra man ser: de kan lika gärna ligga under fliken
 * Kebab. Mätt i webbläsaren 2026-08-21 fick just de tre översta korten
 * `loading="lazy"` av precis det skälet.
 *
 * Fem och inte fler: rutnätet är fem spalter i --w-wide sedan 2026-08-24,
 * alltså är rad ett fem kort. Alla tolv ivrigt vore tolv hämtningar mot vår objektlagring i första
 * bildrutan för sex bilder som ligger under vikkanten.
 *
 * Talet läses ur `hemOrdning` och inte ur `hem`, för det är den blandade
 * ordningen som faktiskt hamnar i markupen.
 */
const tidiga = new Set(hemOrdning.slice(0, 5).map((r) => r.e));

// ---------------------------------------------------------------------------
// Platsgruppen
// ---------------------------------------------------------------------------

/**
 * EN TJUGOANDRA GRUPP I KATEGORIRADEN, OCH DEN HETER EN KOMMUN.
 *
 * ══ VAD SOM VAR TRASIGT ═══════════════════════════════════════════════════
 *
 * Startsidan visade Stockholm för alla. Uppmätt i bygget 2026-09-05 över
 * poolens kort: 237 av 483 ligger i Stockholm, och hemgruppens sextio är
 * 56 Stockholm, 2 Karlstad, 1 Jönköping och 1 Oskarshamn. Den som bor i
 * Örebro möttes av Scandic Hotel Malmen.
 *
 * ══ VAD SOM INTE GÅR ATT GÖRA ÅT DET, OCH DET ÄR MÄTT ═════════════════════
 *
 * Hemgruppen går INTE att byta till besökarens kommun. Raden kräver ett
 * daterat fotografi, och bildbeståndet är en storstadsbrist. Räknat samma dag
 * över alla 17 146 verksamheter, kort som klarar bildgrinden och
 * konsumentgrinden:
 *
 *   Stockholm 167   Uppsala 25   Jönköping 15   Linköping 7   Karlstad 7
 *   Örebro 3        Oskarshamn 1
 *   Norrköping, Höganäs, Kristinehamn, Lomma, Borgholm, Svenljunga:  0
 *
 * Nio av tretton kommuner har alltså NOLL kort i hemgruppen. En hemgrupp som
 * bytte till Örebro hade blivit tom, och en tom rad är sämre än en
 * stockholmsrad. Rubriken och urvalsregeln är dessutom ägarens beslut
 * 2026-08-22 och rörs inte.
 *
 * ══ VAD SOM DÄREMOT GÅR, OCH VAD DET KOSTAR ═══════════════════════════════
 *
 * Korten finns REDAN. Kategorigrupperna plockar med tak två per kommun, se
 * `plocka`, så poolen bär kort från hela landet även när ingen enskild flik
 * gör det. Räknat i bygget 2026-09-05:
 *
 *   Stockholm 237  Linköping 65  Jönköping 40  Uppsala 39  Örebro 33
 *   Karlstad 30    Oskarshamn 16 Kristinehamn 15
 *   Svenljunga 4   Lomma 2       Borgholm 2    Norrköping 0   Höganäs 0
 *
 * En grupp som samlar en kommuns kort ur ALLA flikar kostar därför bara ett
 * attribut per kort. Uppmätt på index.html: `data-kommun` på 483 kort är
 * 11,3 kB rått och 0,20 kB efter gzip, mot sidans 45,0 kB. Alternativet, att
 * skicka koordinaterna för de 14 384 verksamheter som har en, mättes samma
 * dag till 61 till 77 kB gzip för enbart koordinatparen, och då krävs
 * sökregistrets 373 kB gzip ovanpå för att veta vad punkterna heter.
 * Trehundra gånger dyrare för samma svar.
 */

/**
 * Kortets nummer inom sin EGEN kommun, räknat i poolens slutliga ordning.
 *
 * Måste räknas HÄR och inte tidigare. Hemgruppen skriver om sin ordning i
 * poolen några rader upp, se `hemPlatser`, och ett nummer räknat före det
 * hade pekat på ett annat kort än det som faktiskt hamnar i markupen.
 */
const platsRank = new Map<Establishment, number>();
const platsAntal = new Map<string, number>();
for (const rad of pool) {
  const slug = rad.e.municipality.slug;
  const n = platsAntal.get(slug) ?? 0;
  platsRank.set(rad.e, n);
  platsAntal.set(slug, n + 1);
}

/**
 * Fem, för rutnätet är fem spalter i --w-wide.
 *
 * Under fem fyller gruppen inte en enda rad, och en ensam rutt under en
 * rubrik som lovar en hel kommun läser som ett fel. Samma dom som
 * kategorierna redan lyder under, se `if (urval.length < 4) continue`, med ett
 * tal som är rutnätets och inte kategoriradens: en kategori lovar en sorts
 * mat, en kommun lovar en hel stad.
 *
 * Talet fäller i dag Norrköping, Höganäs, Lomma, Borgholm och Svenljunga. De
 * fem får ingen bricka på startsidan, och det är rätt svar: sökpanelens
 * platsrad tar dem till kommunen i stället, vilket är där deras innehåll
 * faktiskt finns.
 */
const PLATS_MINST = 5;

/**
 * Kommunerna brickan kan visa, som skriptet läser ur markupen.
 *
 * SERVERN VET INGENTING OM BESÖKAREN, och får inte veta något: sidan är
 * statiskt byggd och HTML:en cachas för alla. Listan är därför HELA
 * uppsättningen, och vilken av dem som gäller avgörs i webbläsaren.
 */
const platsKommuner = [...platsAntal]
  .filter(([, antal]) => antal >= PLATS_MINST)
  .map(([slug, antal]) => ({
    slug,
    city: pool.find((r) => r.e.municipality.slug === slug)!.e.municipality.city,
    antal,
  }))
  .sort((a, b) => b.antal - a.antal);

const platsData = JSON.stringify(platsKommuner).replace(/</g, '\\u003c');

// ---------------------------------------------------------------------------
// Senast kontrollerade
// ---------------------------------------------------------------------------

/**
 * BORTA, på ägarens beslut 2026-08-22: "vi behöver ju ej tex Senast
 * kontrollerade."
 *
 * Raden bar åtta kort utan foto direkt under tolv med foto, alltså samma
 * sorts innehåll i sämre skick. Färskheten den visade finns kvar på varje
 * kort ändå, i datumraden under namnet, och på kommunsidorna.
 */

// ---------------------------------------------------------------------------
// Kommunerna
// ---------------------------------------------------------------------------

/**
 * KOMMUNKORTEN ÄR BORTA, OCH DET ÄR ÄGARENS BESLUT 2026-08-22: "kanske att vi
 * ska droppa kommunkorten".
 *
 * De var tre stadsfoton med ett kommunnamn på, alltså navigering. Sidan visar
 * numera verksamheter, och tre kort som leder till en lista av listor bryter
 * den linjen. Vägen till en kommun finns kvar på fyra ställen: sökfältet,
 * länkkolumnerna längst ned, sidfoten som står på varje sida, och
 * /webbkarta/.
 *
 * `byTotal` står kvar, eftersom länkkolumnerna nedan sorterar på den.
 */
const summaries = municipalitySummaries();

/**
 * Störst först, inte bokstavsordning. INGEN rangordning i den mening regeln
 * förbjuder: talet är antal verksamheter i registret, alltså kommunens
 * storlek, och säger ingenting om hur kontrollerna utfallit.
 */
const byTotal = [...summaries].sort((a, b) => b.total - a.total);

// ---------------------------------------------------------------------------
// Länkkolumnerna
// ---------------------------------------------------------------------------

/**
 * Fyra kolumner med kommunernas kategorisidor, mot sidfoten. Skälet är inte
 * utseendet utan länkkraften: kommun- och kategorisidorna bär trafiken, och
 * startsidan är den starkaste interna avsändaren.
 *
 * Bara sidor som finns: linked-flaggan kommer ur samma grind som bygger
 * sidorna, så en rad här kan aldrig peka på en 404.
 */
const COLUMN_IDS: TopCategoryId[] = ['restaurang', 'cafe', 'butik', 'skola'];
/* Tolv och inte fem, sedan utforska-blocket blev flikat 2026-08-24.
   Femman fanns för att fyra kolumner skulle rymmas bredvid varandra på en
   skärmhöjd. Med flikar visas EN kategori i taget över fyra kolumner, alltså
   finns plats för alla tolv kommuner utan att blocket växer på höjden. */
const COLUMN_ROWS = 12;

const columns = COLUMN_IDS.map((id) => {
  const category = topCategory(id);
  const links = byTotal
    .map((m) => {
      const slice = municipalityCategories(m.slug).slices.find(
        (s) => s.category.id === id,
      );
      if (!slice?.linked) return null;
      return {
        city: m.city,
        count: slice.count,
        href: path(m.slug, 'kategori', slice.category.slug),
      };
    })
    .filter((l) => l !== null)
    .sort((a, b) => b.count - a.count)
    .slice(0, COLUMN_ROWS);
  return { category, links };
}).filter((c) => c.links.length > 0);

// ---------------------------------------------------------------------------
// Artiklarna
// ---------------------------------------------------------------------------

/**
 * Sist på sidan, och det är ägarens beslut: "artiklarna hör inte hemma högt
 * upp." Sektionen lyder under samma kvalitetsgrind som /artiklar/.
 */
/**
 * Sex artiklar och inte tre.
 *
 * Ägaren 2026-08-22: "att läsa gridden eller vad de tär kan ha mycket fler
 * kort, om det går typ 6 eller ngt, annars lite mindre."
 *
 * Tre kort i en 1 304 px behållare gav 424 px per artikelkort, alltså bredare
 * än en artikels egen brödtextspalt. Sex ger 198, vilket ligger på Airbnbs
 * eget kortmått: deras är 182 vid 1 512, uppmätt 2026-08-21.
 *
 * Beståndet räcker: 25 artiklar, noll utkast.
 */
/* Tolv och inte sex, sedan raden blev en rullrad 2026-08-24. Med sex kort à
   220 px mätte innehållet 1 400 mot 1 329 synliga, alltså 71 px att rulla, och
   en rullrad som rullar sjuttio pixlar är bara en rad som ser sönderklippt ut.
   Tolv ger 2 832 och därmed drygt en skärm till. Finns färre artiklar än så
   faller pilarna bort av sig själva, se skriptet. */
const ARTIKLAR = 12;
const artiklarKlara = sectionReady();
const artikelposter = artiklarKlara
  ? await getCollection('artiklar', ({ data }) => !data.draft)
  : [];
const artiklar = artikelposter
  .map((e) => ({
    slug: e.id,
    minutes: readingMinutes(e.body ?? ''),
    photo: articleImage(e.id, e.data.image),
    ...e.data,
  }))
  .sort((a, b) => b.published.localeCompare(a.published))
  .slice(0, ARTIKLAR);

/*
 * ══ RÖRELSEN, OCH VARFÖR DEN STÅR PÅ STARTSIDAN ═══════════════════════════
 *
 * Sajten har exakt ett flöde som ändrar sig i en takt en människa kan läsa:
 * 112 verksamheter tillkom i kommunernas register och sju försvann på 28
 * dagar, räknat 2026-09-05. Allt annat vi har rör sig en gång vartannat år
 * per rad. Sidtypen var byggd och länkad från 8 av 17 893 sidor, se docs/59
 * §4.4, alltså den enda återkommande anledningen att öppna Prikko låg
 * gömd sist på kommunsidan.
 *
 * TALEN ÄR RIKETS OCH ALDRIG KOMMUNENS. Blocket räknar `nationalMovement()`
 * på precis samma sätt som riksvyn själv gör, så att de två aldrig kan säga
 * olika saker. Kommunlänkarna står som NAMN utan tal, och det är villkoret
 * för att blocket över huvud taget får finnas: ett tal per kommun bredvid ett
 * annat är en rangordning av hur kommunerna sköter sina register, vilket är
 * samma fel som att rangordna dem på kontrollresultat. Skälet står utskrivet
 * i huvudet på pages/nytt-och-borta/[...riket].astro och ska inte härledas om.
 *
 * Orden är "tillkommit" och "försvunnit", aldrig "nyöppnat" och "stängt". Vi
 * har observerat att ett anläggnings-id dök upp eller slutade lämnas ut, och
 * ingenting mer. Se huvudet på lib/rorelse.ts.
 */
const rorelseposter = hasNationalPage() ? nationalMovement() : [];
const rorelseNya = rorelseposter.filter((e) => e.kind === 'ny').length;
const rorelseBorta = rorelseposter.length - rorelseNya;
const rorelsekommuner = movementMunicipalities();

const description = `Prikko samlar ${formatNumber(total.establishments)} livsmedelsverksamheter från ${total.municipalities} kommuner och visar hur var och en klarade sin senaste hygienkontroll.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: absolute(),
    inLanguage: 'sv-SE',
    description: SITE.description,
    /*
     * Ingen `potentialAction`/`SearchAction`, och det är ett beslut.
     * Markeringen fanns för sitelinks-sökrutan, som Google tog bort i
     * november 2024, och den kunde aldrig ha fungerat: robots.txt blockerar
     * `/sok/?` för att tunna resultatsidor inte ska hamna i indexet.
     */
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.legalName,
    url: absolute(),
    logo: `${SITE.url}/prikko-mark.svg`,
  },
];
---

<Base title={SITE.name} description={description} jsonLd={jsonLd} hemhuvud>
  <FaceSprite />

  {/* Sidans enda h1, och den syns inte. Se filhuvudet: båda förlagorna har
      antingen en enpixelsrubrik eller ingen alls. Meningen är skriven för
      att kunna citeras rakt av i ett AI-svar, alltså självbärande. */}
  <h1 class="visually-hidden">
    Hygienkontroller i {formatNumber(total.municipalities)} kommuner:
    {formatNumber(total.establishments)} restauranger, caféer, butiker och skolkök
  </h1>

  {/* Tomrummet som sidhuvudets stora sökläge hänger i.
      Räknat, och måttet måste hållas i takt med .sokdock i Header.astro:
      fältet står på top 88 och är 56 högt, alltså slut vid 144. Sidhuvudets
      rad tar de första 64, och 16 px luft under fältet ger 144 − 64 + 16.

      96 och inte 144. Vid 144 började kategoriraden på 208, och mellan
      fältets underkant och raden stod 64 px vitt intet. Uppmätt på
      förlagorna 2026-08-21: Ednias första kort börjar 240 px ned och
      Airbnbs 297, medan vårt låg på 290 med ett hål i mitten. */}
  <div class="storsok" aria-hidden="true"></div>

  {/* ══ Kategoriraden och rutnätet ═════════════════════════════════════
      SAMMA ROT, eftersom urvalsregeln är skriven som :has() på den. */}
  <section class="upptack">
    <div class="katband">
      <div class="container katinre">
        <fieldset class="katrad" data-katrad>
          <legend class="visually-hidden">Visa en sorts verksamhet</legend>

          {/* ══ KOMMUNBRICKAN ═══════════════════════════════════════════
              Först i raden, som hitta.ses egen platsbricka. Uppmätt på
              deras kategorisida 2026-09-05: en knapp 126 × 40 px, radie 8,
              vit platta, hårlinje rgb(224,224,224), etikett 14 px i vikt
              500 med en nål till vänster, uppe i höger hörn över
              träfflistan. Vår ligger i kategoriraden i stället, eftersom
              raden ÄR sidans brickrad och en andra brickyta ovanför den
              hade varit två navigeringar för samma sak.

              STARTAR `hidden` OCH ÄR TOM. Servern vet ingenting om
              besökaren och får inte veta något, se `platsKommuner`.
              Skriptet skriver namnet och visar brickan bara när
              webbläsaren själv minns en kommun. Den som aldrig svarat, och
              den som svarat nej, får raden precis som den ser ut i dag.

              Brickan ligger i en RULLANDE rad, och det är skälet att den
              får dyka upp efter inladdningen utan att sidan hoppar: raden
              växer i sidled inuti sitt eget spår, aldrig i höjd. Uppmätt i
              bygget: dokumenthöjden är densamma med och utan brickan. */}
          <input
            class="visually-hidden"
            type="radio"
            name="kategori"
            id="kat-plats"
            data-platsval
            hidden
          />
          <label class="val plats" for="kat-plats" data-platsbricka hidden>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z" />
              <circle cx="12" cy="10" r="2.6" />
            </svg>
            <span class="etikett" data-platsetikett></span>
          </label>
          <span class="avdelare plats" aria-hidden="true" data-platsavdelare hidden></span>

          {grupper.map((g, i) => (
            <>
              <input
                class="visually-hidden"
                type="radio"
                name="kategori"
                id={`kat-${g.id}`}
                checked={i === 0}
              />
              <label class="val" for={`kat-${g.id}`}>
                <Matikon namn={g.ikon} size={24} />
                <span class="etikett" data-etikett={g.etikett}>{g.etikett}</span>
              </label>
              {/* Avdelaren efter hemläget. Ednia har exakt den, uppmätt
                  2026-08-22: en 1 px bred och 48 px hög linje mellan "Alla
                  program" och kategorierna. Den gör att "Alla" läses som ett
                  eget läge och inte som den första kategorin i raden, vilket
                  är hela skillnaden mellan en filterrad och en lista. */}
              {i === 0 && <span class="avdelare" aria-hidden="true"></span>}
            </>
          ))}
        </fieldset>

        {/* Rullknapparna. Ednia har en rund knapp vid högerkanten på sin
            kategorirad, skärmbildad i ednia-1280-kategorirad.png: 32 px,
            vit, hårlinje och svag skugga. Vi har en i vardera änden.
            De är `hidden` tills skriptet har mätt att raden faktiskt går
            att rulla; en pil som inte gör något är sämre än ingen pil. */}
        <button class="rulla vanster" type="button" hidden data-rulla="-1" aria-label="Visa föregående kategorier">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>
        </button>
        <button class="rulla hoger" type="button" hidden data-rulla="1" aria-label="Visa fler kategorier">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="container radblock">
      {/* Rubriken är 14/24 och inte en rubrikgrad, och det är mätt: Airbnbs
          egen `h2` över kortraden är 14 px i vikt 400. Vår är halvfet
          eftersom den till skillnad från deras inte har någon större rad
          ovanför sig som bär avsnittets namn.

          En rubrik per grupp, en synlig. Ednia låter kortraden stå utan
          rubrik när ett filter är valt; vi behåller den, eftersom vår
          hemgrupp och våra kategorigrupper inte är samma sorts urval och
          raden annars byter innehåll utan att säga att den gjort det. */}
      <h2 class="radrubrik">
        {/* Platsgruppens rubrik NAMNGER kommunen, och det är inte en
            utsmyckning. Airbnbs regel, citerad i hemgruppens kommentar
            ovan: en rad som visar en stad heter "Populära hem i X". En rad
            som tyst bytt innehåll men behållit sin gamla rubrik ljuger, och
            det är precis felet hemgruppen slapp genom att ta bort staden ur
            sin egen rubrik. Texten skrivs av skriptet, av samma skäl som
            brickan är tom: servern vet inte vilken kommun det blir. */}
        <span data-for="plats" data-platsrubrik></span>
        <span data-for="hem">{hemRubrik}</span>
        {grupper.slice(1).map((g) => <span data-for={g.id}>{g.etikett}</span>)}
      </h2>

      <ul class="rutnat">
        {pool.map((rad) => (
          <li
            data-kat={[...grupperPerRad.get(rad.e)!].join(' ')}
            data-extra={extraGrupper(rad.e) || undefined}
            data-kommun={rad.e.municipality.slug}
          >
            <Verksamhetskort e={rad.e} tidig={tidiga.has(rad.e)} />
          </li>
        ))}
      </ul>

      {/* "Visa fler" som en kryssruta och inte en knapp.
          ────────────────────────────────────────────────────────────────
          Samma grepp som kategoriraden: `:has()` på ett formulärelement,
          alltså inget skript. En knapp hade krävt en klickhanterare för
          något som CSS redan kan.

          Etiketten byter text när rutan är i, och båda orden står i
          markupen: en etikett vars text sätts av `content` går inte att
          markera, inte att söka i sidan och inte att läsa upp korrekt. */}
      {/* ══ VISA PÅ KARTA ══════════════════════════════════════════════
          Airbnbs flytande knapp, uppmätt på deras sökresultat 2026-08-22:
          129 × 48 px, radie 24, mörk platta rgb(34, 34, 34), etikett 14 px
          i vikt 500, ikon till vänster, centrerad i vyn med 48 px till
          nederkanten.

          Fast i vyn hela startsidan igenom, se .kartrad i stilen för varför
          den inte längre är klistrad.

          En LÄNK och inte en knapp. Kartan är en egen sida, och en knapp
          som byter sida går inte att öppna i ny flik, inte att spara och
          inte att mellanklicka. */}
      <div class="kartrad">
        <a class="kartknapp" href="/karta/">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.2 3.4 3.6 5.6v15l5.6-2.2 5.6 2.2 5.6-2.2v-15l-5.6 2.2z" />
            <path d="M9.2 3.4v15.2M14.8 5.6v15.2" />
          </svg>
          Visa på karta
        </a>
      </div>

      {/* ══ NÄSTA VÄNDA, PÅ RULLNING ═══════════════════════════════════
          Ägaren 2026-08-22: "det ska ej vara en knapp med visa fler, det ska
          vara på skroll, så är det någon laddning animation."

          Vaktposten ligger under rutnätet. Når den vyn avslöjas nästa vända,
          och korten tonas in.

          INGEN FALSK SPINNARE. Korten står redan i markupen, så avslöjandet
          tar noll millisekunder; ett hjul som snurrar i en halv sekund vore
          en animering av något som inte händer. Pulsen nedan syns BARA innan
          vändan avslöjats, alltså som ett besked om att det finns mer, och
          slocknar i samma ögonblick korten kommer. Intoningen är den enda
          rörelse som svarar mot en verklig händelse.

          Kryssrutan står kvar och är fortfarande det som styr CSS:en, se
          .rutnat-reglerna. Skriptet bockar i den. Utan skript syns den som en
          knapp och sidan fungerar ändå. */}
      <div class="merrad" data-merrad>
        <input class="visually-hidden" type="checkbox" id="visa-fler" />
        {/* RÄKNAREN PÅ KNAPPEN.
            ──────────────────────────────────────────────────────────────
            Ägaren 2026-08-24: "kör räknaren och histogrammet, skit i hela
            panelen."

            Greppet är Ednias, uppmätt samma dag: deras bekräftelseknapp gick
            från "Visa 178 skolor" till "Visa 82 skolor" medan man kryssade i
            panelen, alltså visar knappen konsekvensen av valet INNAN man
            trycker. Deras panel bygger vi inte, den är 2 341 px innehåll i
            tolv sektioner för en datamängd med tre användbara axlar.

            Talet är per GRUPP och skrivs av skriptet, eftersom en kategori
            byter hur många som återstår. Utan skript står det bara "Visa
            fler", vilket är sant men tystare. */}
        <label class="mer" for="visa-fler">
          Visa fler<span class="merantal" data-merantal></span>
        </label>
        <span class="puls" data-puls aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
    </div>
  </section>

  {/* ══ Rörelsen ══════════════════════════════════════════════════════
      Före artiklarna och efter korten. Korten är vad vi har, rörelsen är
      vad som ÄNDRAT SIG sedan sist, och artiklarna är läsning. Den som kom
      hit i går och kommer igen i dag har bara en anledning på hela sajten,
      och den ska inte ligga under tolv artikelkort.

      Ingen egen sida byggs. Blocket är länkar till sidor som redan finns,
      och villkoret hasNationalPage() är riksvyns eget: byggs den inte finns
      ingen adress att peka på. */}
  {rorelseposter.length > 0 && (
    <section class="container block rorelse">
      <div class="blockhuvud">
        <h2>Nytt och borta</h2>
        <a href="/nytt-och-borta/">Hela landet</a>
      </div>

      <p class="rorelsesvar">
        {formatNumber(rorelseNya)} verksamheter har tillkommit i kommunernas
        register och {formatNumber(rorelseBorta)} har försvunnit ur dem.
        Uppgiften är att ett anläggnings-id dök upp i kommunens utlämning
        eller slutade lämnas ut, inte att någon öppnat eller stängt.
      </p>

      {/* NAMN OCH INGA TAL. Se resonemanget i frontmattern: en kommun med
          ett tal bredvid en annan kommun med ett tal är en rangordning,
          oavsett vad rubriken säger. Kommunens egna tal står på kommunens
          egen sida, ett klick bort. Ordningen är bokstavsordning, alltså den
          municipalities() ger överallt annars, och aldrig antal händelser:
          en lista sorterad på rörelse hade varit rangordningen i förklädnad. */}
      <ul class="rorelselankar">
        {rorelsekommuner.map((m) => (
          <li>
            <a href={`/${m.slug}/nytt-och-borta/`}>Nytt och borta i {m.city}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ══ Artiklarna ════════════════════════════════════════════════════*/}
  {artiklarKlara && artiklar.length > 0 && (
    <section class="container block">
      <div class="blockhuvud">
        <h2>Att läsa</h2>
        <a href="/artiklar/">Alla artiklar</a>
      </div>

      <div class="artikelram" data-artikelram>
        <button class="rulla vanster" type="button" hidden data-artrulla="-1" aria-label="Visa föregående artiklar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
        </button>
        <button class="rulla hoger" type="button" hidden data-artrulla="1" aria-label="Visa fler artiklar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      <ul class="artiklar" data-artiklar>
        {artiklar.map((a) => (
          <li>
            <a href={path('artiklar', a.slug)}>
              {a.photo && (
                <Image
                  class="artikelbild"
                  src={a.photo.src}
                  alt={a.photo.alt}
                  width={HERO_WIDTHS.at(-1)}
                  widths={HERO_WIDTHS}
                  sizes="(min-width: 1280px) 200px, (min-width: 1024px) 300px, (min-width: 640px) 33vw, 92vw"
                  loading="lazy"
                />
              )}
              <span class="artikelnamn">{a.title}</span>
              <span class="artikelmeta text-secondary">
                {a.category} · {a.minutes} min lästid
              </span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </section>
  )}

  {/* ══ Länkkolumnerna ════════════════════════════════════════════════*/}
  {/* UTFORSKA-BLOCKET HAR EN RUBRIK NU, och länkarna står i två rader.
      ──────────────────────────────────────────────────────────────────
      Ägaren 2026-08-24 om ednia.se: "dom har också en utforska delen som
      typ nästan är en del av footern... det är likt vår fast mer clean."

      Uppmätt hos dem samma dag: en H2 "Utforska" i 22/26 vikt 600 namnger
      blocket, och varje länk står i TVÅ rader, ortnamnet i 16/20 vikt 600
      över antalet i 14/20 vikt 400 grått, till exempel "Stockholm" över
      "129 gymnasier".

      Vår hade ingen rubrik alls, så blocket började mitt i luften med fyra
      kolumnrubriker, och länken låg på EN rad: "Stockholm 3 559". Den formen
      tvingar ögat att skilja namn från siffra utan hjälp. Tvåradigt kostar
      10 px per rad och gör skillnaden gratis.

      Flikarna ÄR byggda, se markupen. Deras "Visa fler" tas däremot inte:
      den döljer elva av 26 interna länkar bakom ett klick, vilket docs/26
      talar emot. Flikarna byter vad som syns, aldrig vad som finns. */}
  {columns.length > 0 && (
    <nav class="container kolumner" aria-label="Verksamhetstyper per kommun">
      <h2 class="utforska">Utforska</h2>

      {/* FLIKAR SOM BYTER DATAMÄNGD I SAMMA YTA.
          ──────────────────────────────────────────────────────────────────
          Ägaren 2026-08-24: "ednias är ju med klick, där det byter typ."

          Uppmätt hos dem samma dag: fyra flikar, 16/20 vikt 600, knapp 36 px
          hög, och det valda bär ett 2 px understreck i nästan svart. De byter
          Områden, Program i olika områden, Inriktningar i olika områden och
          Program nationellt, alltså fyra vyer på en skärmhöjd i stället för
          fyra kolumner som alla syns halvt.

          Radioknappar och `:has()`, ingen JavaScript. Exakt samma teknik som
          kategoriraden högre upp på sidan använder, och skälet är detsamma:
          sajten är statisk, och en flik som byter innehåll utan skript
          fungerar också för den som har skript avstängt och för sökmotorn,
          som ser alla fyra listorna i markupen.

          ALLA LÄNKAR STÅR KVAR I DOKUMENTET. Ednia döljer elva av 26 bakom en
          "Visa fler", och det gör vi inte: interna länkar bakom ett klick är
          precis vad docs/26 talar emot. Flikarna byter vad som SYNS, aldrig
          vad som finns. */}
      {/* HÅRLINJEN LIGGER PÅ EN EGEN RAD OCH INTE PÅ FLIKRADEN.
          ──────────────────────────────────────────────────────────────────
          Två mätta skäl, båda från 2026-08-27.

          Linjen låg fel. Flikraden bär `margin-left: -12px` för att första
          flikens ORD ska stå på 48 som allt annat, och underkanten följde
          med ut: uppmätt vid 1440 gick linjen 36 till 1392, alltså tolv
          pixlar ut i vänstergutten och jämnt i höger. Ednias linje är ett
          eget 1 px block i innehållets bredd, uppmätt till 48 till 1464 i
          en 1512 px vy, alltså symmetrisk. Wrappern bär linjen och står på
          innehållets bredd; flikraden får dra ut sig som förut.

          Flikarna måste dessutom kunna rulla. Uppmätt vid 375 bröt raden
          till två våningar och blocket blev 89 px högt i stället för 41,
          eftersom de fyra etiketterna mäter 113, 154, 71 och 147, alltså
          509 px med luft i en spalt på 343. Ednia rullar sin flikrad i en
          våning på 36 px, samma grepp som kategoriraden högre upp på den
          här sidan. En rullande rad kan inte bära linjen själv, för då
          rullar den med, och det är samma skäl som wrappern. */}
      <div class="flikrad">
        <div class="flikar" role="tablist">
          {columns.map((col, i) => (
            <>
              <input
                class="visually-hidden"
                type="radio"
                name="utforska"
                id={`utf-${col.category.id}`}
                checked={i === 0}
              />
              <label class="flik" for={`utf-${col.category.id}`}>{col.category.name}</label>
            </>
          ))}
        </div>
      </div>

      {columns.map((col) => (
        <ul class="utforskalista" data-for={col.category.id}>
          {col.links.map((l) => (
            <li>
              <a href={l.href}>
                <span class="ort">{l.city}</span>
                <span class="antal text-secondary">
                  {formatNumber(l.count)} {col.category.name.toLowerCase()}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ))}
    </nav>
  )}
</Base>

<style>
  /* ═══ Sidans bredd ═══════════════════════════════════════════════════
   *
   * Ingen egen regel längre. Startsidan hade en `.bred`-klass med
   * `max-width: var(--w-full)` och 48 px fyllning, medan resten av sajten låg
   * kvar på 1080. Ägaren 2026-08-22: "kör hela sajten på nya bredden."
   *
   * `--w-wide` är därför 1400 och `.container` bär gutterna, se tokens.css.
   * Startsidan använder nu samma `.container` som varje annan sida.
   */

  /* ═══ Tomrummet under sidhuvudet ═════════════════════════════════════
     Se markupen. Höjden är låst till sökdockens läge i Header.astro. */
  .storsok { height: 96px; }

  /* ═══ Kategoriraden ══════════════════════════════════════════════════
     Klistrad under sidhuvudets 64 px rad. Ednias egen rad är inte klistrad,
     Airbnbs försvinner helt vid rullning. Vår står kvar, och skälet är att
     den är sidans enda väg mellan tjugo urval: en rad man måste rulla
     tillbaka till toppen för att nå är en rad man använder en gång. */
  .katband {
    position: sticky;
    top: var(--h-bar);
    z-index: 30;
    background: var(--canvas);
    border-bottom: 1px solid var(--hairline);
  }

  .katinre { position: relative; }

  /* Ednias form: ikon ÖVER etikett, ingen ram, ingen fyllning, understreck
     på det valda. Uppmätt i ednia-1280-kategorirad.png, där raden är 69 px
     hög med ikonen på 24 och etiketten på 13.

     Staplat och inte i rad, till skillnad från den gamla filterraden här.
     Skälet är antalet: sex val i rad rymdes på 740 av 1 048 px, tjugoett
     gör det inte. Staplat är varje val omkring 76 px brett i stället för
     omkring 120, och raden rullar mjukare med kortare steg. */
  .katrad {
    display: flex;
    align-items: stretch;
    /* 28 och inte 24. Uppmätt på ednia.se 2026-08-22: deras kategorirad har
       `gap: 28px` mellan valen och är 69 px hög. Vår låg på 24 och 67. */
    gap: 28px;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;

    /* TONINGEN I KANTERNA, och bara i den ände det finns mer att rulla åt.
       ────────────────────────────────────────────────────────────────────
       Ägaren 2026-08-24 om ednia.se: "pilen sitter liksom flush längst höger
       och vänster kanten, och pilen sitter ju därför över en kategori mot
       kanten och då suddas den ut lite." Och sedan: "det ska ju såklart ej
       vara toning åt vänster om man är hela vägen till vänster."

       Uppmätt hos dem: pilen på `right: 0` OVANPÅ raden med 100 px toning
       under sig, och "Vård och omsorg" låg begravd under båda. Vår hade
       motsatt fel: ingen toning alls, och "Sallad" klipptes rakt av vid
       radens kant på 1365.

       40 px och inte deras 100, för hundra suddar en hel kategori.

       Flaggorna sätts av skriptet längst ned, med samma 8 px slack som
       pilarna, så att toning och pil alltid visas och döljs tillsammans.
       Utan skript finns ingen toning, och det är rätt: då finns inga pilar
       heller och raden rullas med fingret.

       `mask-image` och inte ett överlägg: en toning i en pseudo hade legat
       ovanpå etiketternas träffyta. Masken tar bort bläck, inte klick. */
    --tona-vanster: #000 0;
    --tona-hoger: #000 100%;

    mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--tona-vanster),
      var(--tona-hoger),
      transparent 100%
    );

    /* INGEN RESERV I SLUTET AV RADEN, och det är en rättelse.
       ────────────────────────────────────────────────────────────────────
       Här stod `padding-inline-end: 84px` med motiveringen att sista
       etiketten inte skulle hamna under pilen. Måttet gjorde två fel.

       Det första: pilen döljs när raden är utrullad, se skriptet med sina
       8 px slack. Vid full utrullning fanns alltså ingen pil att skydda
       etiketten mot, bara 84 px tomt. Uppmätt vid 1440 den 2026-08-27:
       radens scrollWidth 1929 mot ett innehåll på 1845, alltså 84 px död
       yta efter sista valet.

       Det andra: reserven tog bort just det ägaren bad om. Ednia 2026-08-27
       vid 1512: spårets scrollWidth 3347 är exakt innehållets bredd, alltså
       noll reserv, och deras högerpil på `right: 0` ligger därför OVANPÅ en
       kategori som toningen suddar ut under den. Vår pil slutar redan på
       samma pixel som raden, 1392 vid 1440, men reserven såg till att den
       aldrig hade något under sig.

       Utan reserven landar sista valet dikt an mot radens högerkant när man
       rullat färdigt, precis som hos dem, och under vägen dit passerar
       etiketterna under pilen och tonas av masken.

       Telefonen har kvar sin reserv och det är något annat: där är den lika
       med gutterns 16 och finns för att raden blöder ut ur containern.
       Ednia gör detsamma vid 375, uppmätt: 19 px kvar mot deras gutter 24. */
    /* OBLIGATORISK. Ett `fieldset` har `min-inline-size: min-content` i
       webbläsarens egen stilmall, och den vinner över `overflow-x: auto`.
       Utan raden mätte raden 617 px i en 390 px vid vyport och sköt hela
       dokumentet i sidled. Uppmätt i webbläsaren 2026-08-21. */
    min-inline-size: 0;
  }
  .katrad[data-mer-vanster] { --tona-vanster: #000 40px; }
  .katrad[data-mer-hoger]   { --tona-hoger: #000 calc(100% - 40px); }

  .katrad::-webkit-scrollbar { display: none; }

  .val {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: 0 0 auto;
    min-width: 56px;
    padding-block: var(--s-3) 10px;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
  }

  /* 13 px och inte Ednias 12.
     ────────────────────────────────────────────────────────────────────────
     Ednias egen kategorirad mäter 12/16 i vikt 600, uppmätt 2026-08-22, och
     raden låg på det. Ägaren: "sökrutan kan ha typ 16px ... men då måste
     kategori skrollet blir större också, någon pixel iaf liksom."

     Han har rätt i förhållandet. Ednias sökfält och kategorirad ligger på 14
     respektive 12, alltså två steg isär. Vårt fält är 16, och då blir 12 tre
     steg under, vilket får raden att se ut som en fotnot till fältet i
     stället för som sidans navigering.

     13 PX OCH VIKT 500. Graden provades i 16, 12 och 15 under 2026-08-24 och
     landade på 13, som är ägarens sista ord: "kör 13px istället på
     kategoritexten."

     Tretton ÄR --fs-caption, alltså tillbaka i skalan efter tre tal som stod
     utanför den. Det är också graden raden hade från början; det som ändrats
     mot utgångsläget är vikten.

     Vikten 500 är det "lite lite lite tunnare" han bad om samma dag och den
     står kvar. Det VALDA ligger på 700 längre ned, alltså 200 steg emellan i
     stället för de 100 raden hade förut. Vid 13 px bär vikten mer av
     markeringen än graden kan göra, så det avståndet är det som gör valt
     läsbart utan att ordet växer. */
  .etikett {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 500;
  }

  /* Etiketten reserverar sin HALVFETA bredd redan i viloläget. Vikten är en
     av bärarna av "valt", och utan reservationen växer ordet när man väljer
     det, vilket knuffar varje val till höger om det i sidled. Kopian ritas
     aldrig: höjd 0, overflow hidden. Den bidrar ändå till bredden, vilket
     är hela poängen. */

  .etikett::after {
    content: attr(data-etikett);
    display: block;
    height: 0;
    overflow: hidden;
    font-weight: 700;
    visibility: hidden;
  }

  /* `hidden` MÅSTE skrivas ut här, och det är en fälla värd att känna till.
     Webbläsarens egen regel `[hidden] { display: none }` ligger i UA-lagret,
     och VARJE författarregel vinner över det oavsett specificitet. `.val` har
     `display: flex`, alltså hade kommunbrickan stått synlig och tom trots
     sitt `hidden`-attribut. Uppmätt i bygget innan raden fanns: en ruta på
     56 px utan text först i kategoriraden.

     Gäller inte avdelaren, som aldrig sätter display, men den står med för
     att de två alltid ska visas och döljas tillsammans. */
  .val[hidden], .avdelare[hidden] { display: none; }

  /* Avdelaren, se markupen. 48 px hög i en 67 px rad, alltså centrerad med
     luft över och under, precis som Ednias. */
  .avdelare {
    flex: 0 0 1px;
    align-self: center;
    width: 1px;
    height: 48px;
    background: var(--hairline);
  }

  /* Understrecket. Rörelsen är Airbnbs, uppmätt på deras kategorirad
     2026-08-21: en markör med `transition: transform .3s
     cubic-bezier(.2, 0, 0, 1)`. Kurvan är deras genomgående och ligger på
     varje knapp de har.

     Färgen är märkesblå och inte svart, samma regel som Filterrad.astro och
     Kategorival.astro: valt läge är blått i sökpanelen, i kartan och i
     pagineringen, och en svart list bredvid dem ser lånad ut. */
  .val::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transition: transform .3s cubic-bezier(.2, 0, 0, 1);
  }

  /* Hovringen visar strecket i grått innan det blir blått, alltså en
     förhandsvisning av vad ett klick gör. Ednias eget beteende, skärmbildat
     i ednia-1280-kategori-hovring.png. */
  .val:hover { color: var(--text); }
  .val:hover::after { background: var(--tone-quiet); transform: scaleX(1); }

  /* Radioknappen ligger omedelbart före sin etikett i markupen, därför +
     och inte ~. Regeln står EFTER hovringen med avsikt: de har samma
     specificitet, och det valda ska vinna även när pekaren står på det. */
  input:checked + .val { color: var(--text); }
  input:checked + .val .etikett { font-weight: 700; }
  input:checked + .val::after { background: var(--brand); transform: scaleX(1); }

  input:focus-visible + .val {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
    border-radius: 4px;
  }

  /* ── Rullknapparna ───────────────────────────────────────────────────
     Ednias mått: 32 px, rund, vit, hårlinje, svag skugga. Toningen bredvid
     är vår egen och löser något deras rad inte har: vår rad ligger mot
     --canvas och inte mot vitt, så ett kort som klipps mot kanten behöver
     en mjuk övergång för att läsa som "det finns mer" i stället för
     "det tog slut". */
  .rulla {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-top: -16px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--card);
    box-shadow: 0 0 0 1px var(--hairline), 0 2px 6px rgba(0, 0, 0, .10);
    color: var(--text);
    cursor: pointer;
    transition: transform .25s cubic-bezier(.2, 0, 0, 1);
  }
  .rulla:hover { transform: scale(1.06); }

  /* INNANFÖR behållarens fyllning, inte utanför.
     ────────────────────────────────────────────────────────────────────────
     Här stod `left: -12px` och `right: -12px`, vilket sköt knapparna utanför
     `.katinre`, och med träffytans `inset: -6px` blev dokumentets scrollWidth
     1298 i en 1280 px vid vy. Alltså rullade SIDAN i sidled, samma sorts fel
     som `fieldset`-buggen längre ned i filen.

     12 px från behållarens YTTRE kant räckte inte heller. Ägaren 2026-08-24:
     "få in knapparna innanför väggarna." Uppmätt vid 1440: `.katinre` spänner
     0 till 1425 medan raden går 48 till 1377, så `right: 12px` la högerpilen
     på 1381 till 1413, alltså helt utanför radens egen yta och ute i gutter
     som annars är tom.

     Gutterns eget mått i stället, alltså `--container-luft`. Då slutar pilen
     på exakt samma pixel som raden och ligger innanför väggen, ovanpå
     toningen som redan gör kanten mjuk. */
  .rulla.vanster { left: var(--container-luft); }
  .rulla.hoger { right: var(--container-luft); }
  .rulla[hidden] { display: none; }

  /* Träffytan är 44 px, alltså --h-tap, oberoende av knappens 32. */
  .rulla::after {
    content: '';
    position: absolute;
    inset: -6px;
  }

  /* ── Rubrikraden ─────────────────────────────────────────────────────
     Luften ligger som PADDING på blocket och inte som marginal på rubriken.
     En marginal hade kollapsat ut genom `.container`, som bara har fyllning i
     sidled, och hamnat ovanför kategoribandet i stället för under det. Det
     var precis felet i första försöket: 24 px lades på `.upptack` och sköt
     ned hela bandet medan rubriken satt kvar dikt an mot dess hårlinje. */
  .radblock { padding-top: var(--s-6); }

  .radrubrik {
    margin-bottom: var(--s-4);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
    letter-spacing: normal;
  }

  .radrubrik span { display: none; }

  /* ── Rutnätet ────────────────────────────────────────────────────────
     Fyra spalter i --w-wide ger 250 px per kort. Airbnb kör sju à 182 px;
     deras kort bär ett fotografi som tål att vara litet, vårt bär ett namn
     som ska gå att läsa. Ednia kör tre à 382 px. */
  .rutnat {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* LUFT MELLAN KATEGORIRADEN OCH RUBRIKEN.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22: "populära ställen sitter nästan limmad mot toppen, är
     det verkligen rimligt?"

     Nej. Rubriken låg med noll marginal under kategoribandets hårlinje,
     alltså dikt an mot en kant. Kategoriraden är sidans navigering och
     rutnätet dess innehåll, och två saker som gör olika jobb ska inte sitta
     ihop.

     24 px över rubriken och 16 under, i stället för 0 och 12. Ednias första
     kort börjar 240 px ned vid 1280, med en rad Filtrera- och Sortera-piller
     i mellanrummet som vi inte har; luften får göra det jobbet i stället. */
  .upptack { padding-bottom: var(--s-12); }
  .upptack .rutnat { padding-top: var(--s-4); }

  /* ── Urvalet ─────────────────────────────────────────────────────────
     Grundläget visar hemgruppen. En webbläsare utan :has() får därmed en
     fungerande sida med tolv kort i stället för hela poolen.

     Reglerna är utskrivna en per grupp och inte genererade. Det är tjugoen
     rader att läsa, och alternativet, en sträng byggd i frontmattern och
     utskriven med set:html, hade lämnat Astros stilomfång och gjort
     `.rutnat` och `.upptack` till globala klassnamn. */
  .upptack .rutnat > li { display: none; }

  .upptack:has(#kat-hem:checked) .rutnat > li[data-kat~='hem'],
  .upptack:has(#kat-livsmedel:checked) .rutnat > li[data-kat~='livsmedel'],
  .upptack:has(#kat-snabbmat:checked) .rutnat > li[data-kat~='snabbmat'],
  .upptack:has(#kat-cafe-fik:checked) .rutnat > li[data-kat~='cafe-fik'],
  .upptack:has(#kat-pizza:checked) .rutnat > li[data-kat~='pizza'],
  .upptack:has(#kat-asiatiskt:checked) .rutnat > li[data-kat~='asiatiskt'],
  .upptack:has(#kat-bar:checked) .rutnat > li[data-kat~='bar'],
  .upptack:has(#kat-sushi:checked) .rutnat > li[data-kat~='sushi'],
  .upptack:has(#kat-burgare:checked) .rutnat > li[data-kat~='burgare'],
  .upptack:has(#kat-italienskt:checked) .rutnat > li[data-kat~='italienskt'],
  .upptack:has(#kat-kiosk:checked) .rutnat > li[data-kat~='kiosk'],
  .upptack:has(#kat-bageri:checked) .rutnat > li[data-kat~='bageri'],
  .upptack:has(#kat-kebab:checked) .rutnat > li[data-kat~='kebab'],
  .upptack:has(#kat-medelhav:checked) .rutnat > li[data-kat~='medelhav'],
  .upptack:has(#kat-sallad:checked) .rutnat > li[data-kat~='sallad'],
  .upptack:has(#kat-thai:checked) .rutnat > li[data-kat~='thai'],
  .upptack:has(#kat-indiskt:checked) .rutnat > li[data-kat~='indiskt'],
  .upptack:has(#kat-konditori:checked) .rutnat > li[data-kat~='konditori'],
  .upptack:has(#kat-grill:checked) .rutnat > li[data-kat~='grill'],
  .upptack:has(#kat-mellanostern:checked) .rutnat > li[data-kat~='mellanostern'],
  .upptack:has(#kat-glass:checked) .rutnat > li[data-kat~='glass'],
  /* Platsgruppen. EN rad och inte tretton, och det är skälet att kommunen
     står i `data-plats` på kortet i stället för i väljaren: CSS kan inte
     jämföra ett attribut på förfadern med ett på barnet, så tretton
     kommuner hade blivit tretton rader i vart och ett av de tre blocken
     här nedanför. Skriptet sätter attributet på den valda kommunens kort,
     och stilen förblir inne i Astros omfång. */
  .upptack:has(#kat-plats:checked) .rutnat > li[data-plats] {
    display: block;
  }

  /* EXTRAKORTEN, andra vändan.
     ────────────────────────────────────────────────────────────────────────
     Regeln står EFTER gruppreglerna och har högre specificitet tack vare
     `:not(:has())`, så den vinner över dem utan `!important`. Gruppreglerna
     behöver därmed inte skrivas i två uppsättningar: de säger vilka kort som
     hör till fliken, och den här säger vilka av dem som ännu inte fått plats. */
  .upptack:not(:has(#visa-fler:checked)):has(#kat-hem:checked) .rutnat > li[data-extra~='hem'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-livsmedel:checked) .rutnat > li[data-extra~='livsmedel'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-snabbmat:checked) .rutnat > li[data-extra~='snabbmat'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-cafe-fik:checked) .rutnat > li[data-extra~='cafe-fik'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-pizza:checked) .rutnat > li[data-extra~='pizza'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-asiatiskt:checked) .rutnat > li[data-extra~='asiatiskt'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-bar:checked) .rutnat > li[data-extra~='bar'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-sushi:checked) .rutnat > li[data-extra~='sushi'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-burgare:checked) .rutnat > li[data-extra~='burgare'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-italienskt:checked) .rutnat > li[data-extra~='italienskt'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-kiosk:checked) .rutnat > li[data-extra~='kiosk'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-bageri:checked) .rutnat > li[data-extra~='bageri'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-kebab:checked) .rutnat > li[data-extra~='kebab'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-medelhav:checked) .rutnat > li[data-extra~='medelhav'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-sallad:checked) .rutnat > li[data-extra~='sallad'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-thai:checked) .rutnat > li[data-extra~='thai'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-indiskt:checked) .rutnat > li[data-extra~='indiskt'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-konditori:checked) .rutnat > li[data-extra~='konditori'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-grill:checked) .rutnat > li[data-extra~='grill'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-mellanostern:checked) .rutnat > li[data-extra~='mellanostern'],
  .upptack:not(:has(#visa-fler:checked)):has(#kat-glass:checked) .rutnat > li[data-extra~='glass'],
  /* Båda attributen behövs. `data-extra~='plats'` sitter på varje kommuns
     kort efter dess trettionde, alltså på kort i kommuner som inte är
     vald; `data-plats` skär ned till den valda. */
  .upptack:not(:has(#visa-fler:checked)):has(#kat-plats:checked) .rutnat > li[data-extra~='plats'][data-plats] {
    display: none;
  }

  /* Kartknappen, FAST och inte klistrad.
     ────────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-22: "visa karta grejen syns typ inte fullt ut, och ska inte
     den finnas typ hela tiden när man är på homepagen?"

     Jo. Första versionen var `position: sticky` inuti `.upptack`, med
     motiveringen att en fast knapp följer med över sidfoten. Utfallet var att
     den knappt syntes alls: den svävade bara medan just den sektionen var i
     vy, och hann försvinna innan man hunnit läsa den.

     Airbnbs egen ligger fast i vyn på hela sökresultatsidan, och det är rätt
     avvägning: kartan är ett sätt att se HELA sidans innehåll, inte en fotnot
     till ett avsnitt.

     `bottom` räknar med sidfoten via en enkel regel i stället för ett skript:
     knappen ligger kvar tills man nått botten, och sidfoten har gott om egen
     luft. */
  .kartrad {
    position: fixed;
    left: 0;
    right: 0;
    bottom: var(--s-6);
    display: flex;
    justify-content: center;
    /* Under sidhuvudets 60 och över sidans innehåll. */
    z-index: 40;
    /* Raden spänner hela bredden men bara knappen ska gå att träffa. */
    pointer-events: none;
  }

  .kartrad > * { pointer-events: auto; }

  /* Räknaren på "Visa fler". Skrivs av skriptet, tom tills dess, och tar
     därför ingen plats innan den har något att säga. */
  .merantal { color: var(--text-secondary); }
  .merantal:not(:empty)::before { content: ' '; }

  .kartknapp {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 48px;
    padding-inline: 17px;
    border-radius: 24px;
    color: var(--card);
    font-size: var(--fs-body-s);
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, .28);
    transition: transform .25s cubic-bezier(.2, 0, 0, 1);

    /* Plattan bor på ::after. Knappen själv är ramen som klipper. */
    background: transparent;
    overflow: hidden;
    isolation: isolate;

    --kant-dis:  color-mix(in srgb, var(--card) 10%, transparent);
    --kant-halv: color-mix(in srgb, var(--card) 60%, transparent);
    --kant-ljus: var(--card);
  }

  /* RINGEN SNURRAR MED transform, INTE MED EN VINKEL I GRADIENTEN.
     ──────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-24: "kartgrejen, den är ej smooth, går bara från halv till
     hel på skroll."

     Han har rätt, och skälet är hur webbläsaren arbetar. Att animera `from` i
     en `conic-gradient` ändrar själva BILDEN, alltså måste gradienten ritas om
     varje bildruta, och en omritning körs inte på kompositören. Under en
     rullningstidslinje uppdateras den då i språng.

     `rotate` är däremot precis vad kompositören finns till för: gradienten
     ritas EN gång och kvadraten under vrids.

     Kvadraten måste vara kvadratisk och större än knappens diagonal, annars
     sveper ett hörn förbi kanten när den vrids. Knappen är 145,5 × 48, alltså
     diagonal 153,2, och 220 täcker med marginal. Knappen klipper med
     `overflow: hidden` och sin egen radie, så det enda som syns är de 2 px
     som ::after inte täcker. */
  .kartknapp::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220px;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: conic-gradient(
      var(--kant-dis)     0deg,
      var(--kant-dis)   190deg,
      var(--kant-halv)  268deg,
      var(--kant-ljus)  312deg,
      var(--kant-halv)  352deg,
      var(--kant-dis)   360deg);
    /* NEGATIVT, och det är hela knepet. `isolation: isolate` på knappen gör
       den till ett eget stapelsammanhang, och där målas barn med negativt
       z-index UNDER elementets eget innehåll men över dess bakgrund. Etiketten
       "Visa på karta" är en ren TEXTNOD och inte ett element, så den går inte
       att lyfta med en selektor. Uppmätt: med plattan på z-index 1 låg texten
       under den och knappen såg tom ut. */
    z-index: -2;
  }

  /* Plattan. Täcker allt utom de 2 px som blir ring. */
  .kartknapp::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 22px;
    background: var(--text);
    /* Ett steg över ringen, fortfarande under texten. Se ::before. */
    z-index: -1;
  }

  .kartknapp:hover {
    color: var(--card);
    text-decoration: none;
    transform: scale(1.04);
  }

  /* RINGEN SNURRAR INTE, OCH DET ÄR ETT BESLUT 2026-09-05.
     ──────────────────────────────────────────────────────────────────────
     Här låg en roterande kon-gradient i tre lager: sex sekunder per varv som
     grundläge, 1,4 sekunder vid hovring, och en rullningsdriven variant på
     åtta varv över dokumentet bakom `@supports (animation-timeline: scroll())`.
     Rullningsvarianten var ägarens egen beställning från 24 augusti, "kanske
     att snurren på bordern liksom snurrar på skroll hade varit coolt".

     Han har sett den i drift och avgjort om 2026-09-05: "kan du ta bort
     animationen på kartknappen på hem, jag gillar den inte."

     Gradienten står kvar och ger ringen ett stillastående ljusdrag. Den har
     ingen skarv att dölja: `--kant-dis` står på både 0 och 360 grader, alltså
     möts ändarna i samma ton och en frusen kon ser inte avklippt ut.

     Det som ströks var `animation` på ::before, hovringens `animation-duration`,
     hela `@supports`-blocket och båda `@keyframes`. Ingenting annat i knappen
     ändrades, alltså är plattan, ringens 2 px och `z-index`-lagren desamma. */

  }

  @media (prefers-reduced-motion: reduce) {
    /* Bara hovringens skalning återstår att stänga av. Undantaget för ringen
       låg här tidigare och behövs inte längre: ingen vinkel rör sig för
       någon, se noten vid .kartknapp::before. */
    .kartknapp { transition: none; }
  }

  .merrad {
    display: flex;
    justify-content: center;
    padding-top: var(--s-8);
  }

  /* Ednias och Airbnbs "visa fler" är båda en ram utan fyllning, alltså en
     handling som inte konkurrerar med korten om uppmärksamheten. */
  .mer {
    min-height: var(--h-tap);
    display: inline-flex;
    align-items: center;
    padding-inline: var(--s-6);
    border: 1px solid var(--text);
    border-radius: var(--r-pill);
    font-size: var(--fs-body-s);
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
  }

  .mer:hover { background: var(--canvas); }

  #visa-fler:focus-visible + .mer {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  /* Pulsen ersätter knappen så snart skriptet tagit över, se markupen. */
  .puls { display: none; gap: 6px; }
  .puls i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tone-quiet);
    animation: puls 1.1s ease-in-out infinite;
  }
  .puls i:nth-child(2) { animation-delay: .16s; }
  .puls i:nth-child(3) { animation-delay: .32s; }

  @keyframes puls {
    0%, 80%, 100% { opacity: .25; transform: scale(.8); }
    40%           { opacity: 1;   transform: none; }
  }

  /* Skriptet sätter data-rullar när vaktposten är armerad: då är knappen
     överflödig och pulsen tar dess plats. */
  .merrad[data-rullar] .mer { display: none; }
  .merrad[data-rullar] .puls { display: inline-flex; }

  /* Vändan är avslöjad: ingenting mer att vänta på. */
  .upptack:has(#visa-fler:checked) .merrad { visibility: hidden; }

  /* Intoningen. Enda rörelsen som svarar mot en verklig händelse: korten
     fanns inte i vyn förut och finns där nu. */
  .upptack:has(#visa-fler:checked) .rutnat > li[data-extra] {
    animation: tona-in .32s cubic-bezier(.2, 0, 0, 1) both;
  }

  @keyframes tona-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .puls i { animation: none; }
    .upptack:has(#visa-fler:checked) .rutnat > li[data-extra] { animation: none; }
  }

  /* Finns inga extrakort i den valda gruppen ska knappen inte stå kvar och
     lova något den inte kan ge. Varje flik prövas för sig. */
  .upptack:has(#kat-hem:checked):not(:has(.rutnat > li[data-extra~='hem'])) .merrad,
  .upptack:has(#kat-livsmedel:checked):not(:has(.rutnat > li[data-extra~='livsmedel'])) .merrad,
  .upptack:has(#kat-snabbmat:checked):not(:has(.rutnat > li[data-extra~='snabbmat'])) .merrad,
  .upptack:has(#kat-cafe-fik:checked):not(:has(.rutnat > li[data-extra~='cafe-fik'])) .merrad,
  .upptack:has(#kat-pizza:checked):not(:has(.rutnat > li[data-extra~='pizza'])) .merrad,
  .upptack:has(#kat-asiatiskt:checked):not(:has(.rutnat > li[data-extra~='asiatiskt'])) .merrad,
  .upptack:has(#kat-bar:checked):not(:has(.rutnat > li[data-extra~='bar'])) .merrad,
  .upptack:has(#kat-sushi:checked):not(:has(.rutnat > li[data-extra~='sushi'])) .merrad,
  .upptack:has(#kat-burgare:checked):not(:has(.rutnat > li[data-extra~='burgare'])) .merrad,
  .upptack:has(#kat-italienskt:checked):not(:has(.rutnat > li[data-extra~='italienskt'])) .merrad,
  .upptack:has(#kat-kiosk:checked):not(:has(.rutnat > li[data-extra~='kiosk'])) .merrad,
  .upptack:has(#kat-bageri:checked):not(:has(.rutnat > li[data-extra~='bageri'])) .merrad,
  .upptack:has(#kat-kebab:checked):not(:has(.rutnat > li[data-extra~='kebab'])) .merrad,
  .upptack:has(#kat-medelhav:checked):not(:has(.rutnat > li[data-extra~='medelhav'])) .merrad,
  .upptack:has(#kat-sallad:checked):not(:has(.rutnat > li[data-extra~='sallad'])) .merrad,
  .upptack:has(#kat-thai:checked):not(:has(.rutnat > li[data-extra~='thai'])) .merrad,
  .upptack:has(#kat-indiskt:checked):not(:has(.rutnat > li[data-extra~='indiskt'])) .merrad,
  .upptack:has(#kat-konditori:checked):not(:has(.rutnat > li[data-extra~='konditori'])) .merrad,
  .upptack:has(#kat-grill:checked):not(:has(.rutnat > li[data-extra~='grill'])) .merrad,
  .upptack:has(#kat-mellanostern:checked):not(:has(.rutnat > li[data-extra~='mellanostern'])) .merrad,
  .upptack:has(#kat-glass:checked):not(:has(.rutnat > li[data-extra~='glass'])) .merrad,
  .upptack:has(#kat-plats:checked):not(:has(.rutnat > li[data-extra~='plats'][data-plats])) .merrad {
    display: none;
  }

  .upptack:has(#kat-hem:checked) .radrubrik span[data-for='hem'],
  .upptack:has(#kat-livsmedel:checked) .radrubrik span[data-for='livsmedel'],
  .upptack:has(#kat-snabbmat:checked) .radrubrik span[data-for='snabbmat'],
  .upptack:has(#kat-cafe-fik:checked) .radrubrik span[data-for='cafe-fik'],
  .upptack:has(#kat-pizza:checked) .radrubrik span[data-for='pizza'],
  .upptack:has(#kat-asiatiskt:checked) .radrubrik span[data-for='asiatiskt'],
  .upptack:has(#kat-bar:checked) .radrubrik span[data-for='bar'],
  .upptack:has(#kat-sushi:checked) .radrubrik span[data-for='sushi'],
  .upptack:has(#kat-burgare:checked) .radrubrik span[data-for='burgare'],
  .upptack:has(#kat-italienskt:checked) .radrubrik span[data-for='italienskt'],
  .upptack:has(#kat-kiosk:checked) .radrubrik span[data-for='kiosk'],
  .upptack:has(#kat-bageri:checked) .radrubrik span[data-for='bageri'],
  .upptack:has(#kat-kebab:checked) .radrubrik span[data-for='kebab'],
  .upptack:has(#kat-medelhav:checked) .radrubrik span[data-for='medelhav'],
  .upptack:has(#kat-sallad:checked) .radrubrik span[data-for='sallad'],
  .upptack:has(#kat-thai:checked) .radrubrik span[data-for='thai'],
  .upptack:has(#kat-indiskt:checked) .radrubrik span[data-for='indiskt'],
  .upptack:has(#kat-konditori:checked) .radrubrik span[data-for='konditori'],
  .upptack:has(#kat-grill:checked) .radrubrik span[data-for='grill'],
  .upptack:has(#kat-mellanostern:checked) .radrubrik span[data-for='mellanostern'],
  .upptack:has(#kat-glass:checked) .radrubrik span[data-for='glass'],
  .upptack:has(#kat-plats:checked) .radrubrik span[data-for='plats'] {
    display: inline;
  }

  /* ═══ Blocken under ══════════════════════════════════════════════════
     Hårlinje över varje block i stället för en tonad bakgrund. Booli skiljer
     avsnitt med hårlinje och luft och aldrig med ett färgfält, se
     docs/19_formsystem.md. */
  .block {
    padding-block: var(--s-12);
    border-top: 1px solid var(--hairline);
  }

  .blockhuvud {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  /* Samma grad som rutnätets rubrik. Sidan har inte en enda rubrik i
     rubrikgrad, och det är avsikten. */
  .blockhuvud h2 {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    font-weight: 600;
    letter-spacing: normal;
  }

  .blockhuvud a {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    white-space: nowrap;
  }

  /* ── Rörelsen ────────────────────────────────────────────────────────
     Blocket är två meningar och en länkrad, alltså sidans lättaste avsnitt,
     och det ska väga så. Ingen ruta, ingen ram: hårlinjen från .block är
     hela avgränsningen, precis som artikelblocket under. */
  .rorelsesvar {
    max-width: var(--w-read);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    color: var(--text-secondary);
  }

  /* Länkarna står på en rad som bryter, inte i en kolumn. Tre kommuner i
     dag och sannolikt tretton när loggen mognat: en kolumn hade blivit en
     stapel av tretton nästan identiska rader, medan en brytande rad håller
     sig på två våningar även då. Gluggen är 8 lodrätt och 24 vågrätt, samma
     par som .policy i sidfoten använder för samma sorts rad. */
  .rorelselankar {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
  }

  .rorelselankar a {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  /* ── Artiklarna ──────────────────────────────────────────────────────
     Sex i bredd, se ARTIKLAR i frontmattern. Gluggen är 16 och inte 24:
     med sex spalter äter 24 px hundratjugo pixlar av bredden, och korten
     hamnar under 190. Samma glugg som verksamhetsrutnätet. */
  /* ARTIKELRADEN RULLAR I SIDLED i stället för att brytas till fler rader.
     ──────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-24: "kör sidoskroll på artikelraden."

     Ett rutnät med sex spalter tvingar varje kort till 1/6 av bredden och
     bryter till en andra rad så snart det finns fler än sex artiklar. En
     rullrad gör tvärtom: kortet håller sitt mått och raden växer åt sidan,
     vilket är samma grepp som kategoriraden högre upp och som Ednias egen
     kategoribanner, uppmätt 2026-08-24.

     `grid-auto-flow: column` och inte flex: korten ska ha EN bredd, och en
     kolumnström med `grid-auto-columns` sätter den på ett ställe i stället
     för `flex: 0 0 220px` på varje kort.

     220 px är kortets mått vid sex spalter i den gamla formen, alltså
     oförändrad täthet för den som inte rullar. Airbnbs egna karuseller på
     startsidan ligger på 182 och deras sökresultat på 307, uppmätt
     2026-08-22; 220 ligger i deras spann och bär vår tre raders rubrik.

     `scroll-snap` så att raden stannar med ett kort mot vänsterkanten och
     inte mitt i ett. Samma toning och samma pilar som kategoriraden, se
     .katrad, så att sidan har EN sorts rullrad och inte två. */
  .artiklar {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 220px;
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;

    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;

    --tona-vanster: #000 0;
    --tona-hoger: #000 100%;

    mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--tona-vanster),
      var(--tona-hoger),
      transparent 100%
    );
  }

  .artiklar::-webkit-scrollbar { display: none; }
  .artiklar > li { scroll-snap-align: start; }

  .artiklar[data-mer-vanster] { --tona-vanster: #000 40px; }
  .artiklar[data-mer-hoger]   { --tona-hoger: #000 calc(100% - 40px); }

  /* Raden behöver ett ankare för pilarna, precis som .katinre. */
  .artikelram { position: relative; }

  /* Eget indrag, och skälet är att de två ramarna inte är samma sak.
     `.katinre` ÄR behållaren och rymmer dess 48 px gutter, så där lägger
     `right: var(--container-luft)` pilen på innehållets kant. `.artikelram`
     ligger redan innanför behållarens fyllning, så samma tal sköt pilen 48 px
     in i raden: uppmätt 1297 till 1329 i en rad som slutar på 1377.

     8 px, alltså pilen strax innanför kanten och ovanpå toningens 40. */
  .artikelram .rulla.vanster { left: var(--s-2); }
  .artikelram .rulla.hoger { right: var(--s-2); }

  /* CENTRERAD PÅ BILDEN, inte på kortet.
     ──────────────────────────────────────────────────────────────────────
     Ägaren 2026-08-24: "pilen på artiklarna på homepagen ska vara centered."

     Den VAR centrerad, men på ramen: uppmätt låg pilens mitt på 2243 och
     ramens mitt på 2243, alltså exakt. Felet är att ramen är hela kortet.
     Kortet mäter 232 px medan bilden bara är 138, så kortets mitt hamnar
     nere vid rubrikens första rad och pilen ser låg ut.

     Kategoriraden har inte problemet, för där ÄR raden lika hög som sitt
     innehåll.

     Måttet räknas ur kortets egen bredd och bildens egen kvot, alltså
     220 / (16/10) / 2 = 68,75, och står som en formel så att det följer med
     om någon av de två ändras. `margin-top` nollas, den hörde till top: 50%. */
  .artikelram .rulla {
    top: calc(220px * 10 / 16 / 2);
    margin-top: -16px;
  }

  .artiklar a {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    color: var(--text);
    text-decoration: none;
  }

  .artiklar :global(.artikelbild) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--r-card);
  }

  /* 14/20 och inte 14/24, alltså samma stramare radavstånd som
     Verksamhetskort.astro redan valt och av samma skäl: i ett 198 px kort
     blir två rader med 24 punkters avstånd 48 px och drar isär kortets
     nedre halva.

     Tre rader och sedan avhugget. Artikelrubriker är långa ("Allergener och
     märkning i restaurang"), och ett kort som växer efter sin längsta rubrik
     spräcker radens jämnhet. */
  .artikelnamn {
    font-size: var(--fs-body-s);
    line-height: 20px;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .artiklar a:hover .artikelnamn { text-decoration: underline; }

  .artikelmeta {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }

  /* ── Länkkolumnerna ──────────────────────────────────────────────────
     Ingen ruta, ingen ram, inga ikoner. En länklista mot sidfoten. */
  /* EN SPALT OCH INGEN RADLUFT, för blocket sätter sin rytm själv.
     ────────────────────────────────────────────────────────────────────────
     Här stod `grid-template-columns: repeat(4, 1fr)` med `gap: var(--s-6)`.
     Spalterna gjorde ingenting: blockets tre barn spänner alla `1 / -1`, och
     de riktiga fyra spalterna bor i `.utforskalista`. Kvar av regeln fanns
     bara radluften, och den låg dubbelt: 24 px rutnätsluft PLUS flikradens
     egen 16 px marginal blev 40 px mellan hårlinjen och första länken,
     uppmätt vid 1440. Ednias mått är 16, uppmätt samma dag.

     Fyrspaltsregeln bar dessutom en följdfelaktighet, se mediefrågan längst
     ned: brytpunkten på 767 px ställde om `.kolumner` till två spalter, och
     eftersom den regeln aldrig hade någon verkan stod listan kvar på fyra
     ända ned till 375. Uppmätt där: fyra spalter à 77 till 89 px.

     Raderna får sina mått av barnen i stället, alltså 24 under rubriken och
     16 under hårlinjen, vilket är exakt Ednias rytm. */
  .kolumner {
    display: grid;
    /* En explicit spalt, så att barnens `grid-column: 1 / -1` har en sista
       linje att peka på. Utan template finns bara linje 1, och `-1` faller
       tillbaka på den, alltså på ett spann om ett. Det blir rätt ändå här,
       men bara av en slump. */
    grid-template-columns: 1fr;
    row-gap: 0;
    padding-block: var(--s-12);
    border-top: 1px solid var(--hairline);
  }

  /* Hårlinjen. Ednias är ett eget 1 px block i innehållets bredd, uppmätt
     2026-08-27 till 48 till 1464 i en 1512 px vy. Se noten i markupen för
     varför den inte får sitta på flikraden själv. */
  .flikrad {
    grid-column: 1 / -1;
    /* OBLIGATORISK, av exakt samma skäl som `min-inline-size: 0` på
       kategoriraden längre upp. Ett rutnätsbarn har `auto` som minsta mått,
       alltså sitt min-content, och wrappern ärver det ur flikraden inuti sig
       trots att den rullar. Uppmätt vid 375 utan raden: wrappern 497 px bred
       i en spalt på 343, och hela dokumentets scrollWidth 513 mot 375, alltså
       sidan rullade i sidled. Med raden: wrappern 343, flikraden 355 med
       509 px innehåll att rulla, dokumentet 375. */
    min-width: 0;
    margin-bottom: var(--s-4);
    border-bottom: 1px solid var(--hairline);
  }

  .flikar {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--s-2);
    /* Rullar när de fyra etiketterna inte ryms, alltså under omkring 560 px.
       Samma form som kategoriraden högre upp på sidan och som Ednias egen
       flikrad, uppmätt: 722 px innehåll i ett 375 px spår. */
    overflow-x: auto;
    scrollbar-width: none;

    /* UNDERSTRECKET FÅR INTE KLIPPAS AV RULLNINGEN.
       ──────────────────────────────────────────────────────────────────
       `overflow-x: auto` gör att `overflow-y` räknas som `auto` och inte
       som `visible`, det står i specifikationen. Flikens `::after` sitter på
       `bottom: -1px` för att lägga sig ovanpå hårlinjen, alltså en pixel
       utanför raden, och den pixeln hade klippts bort och dessutom kunnat
       ge raden en lodrät rullning.

       En pixels fyllning gör plats åt strecket inuti raden, och en lika stor
       negativ marginal tar tillbaka den, så att hårlinjen under står kvar på
       exakt samma pixel som förut. Marginalen kollapsar inte ut genom
       wrappern: den bär en underkant, och en underkant stänger kollapsen. */
    padding-bottom: 1px;
    margin-bottom: -1px;

    /* FÖRSTA FLIKENS ORD SKA STÅ PÅ SAMMA PIXEL SOM ALLT ANNAT.
       ──────────────────────────────────────────────────────────────────
       Ägaren 2026-08-24: "fixa så restauranger under utforska är flush mot
       vänster."

       Rubriken, listan och första posten mätte alla 48 vid 1440. Fliken
       gjorde det också, men dess ETIKETT har 12 px fyllning för träffytans
       skull, så ordet började på 60. Tolv pixlar räcker för att raden ska
       läsa som indragen.

       Ett negativt utdrag på raden i stället för mindre fyllning på fliken:
       träffytan ska förbli 24 px bred runt ordet, och understrecket är redan
       inskjutet 12 px från flikens kanter, så det landar också på 48.

       Utdraget sitter kvar på RADEN och inte på wrappern, så att hårlinjen
       ovanför står kvar på innehållets 48. Ednia gör likadant: deras flikrad
       bär `-ml-12` och deras linje är ett syskon utan utdrag. */
    margin-left: calc(var(--s-3) * -1);
  }

  .flikar::-webkit-scrollbar { display: none; }

  .flik {
    position: relative;
    /* `flex: none` sedan raden blev nowrap. Utan den pressas "Caféer och
       bagerier" ihop i stället för att raden rullar, samma fälla som
       wordmarken gick i, se Header.astro. */
    flex: none;
