           i poolen, och en bricka som öppnar ett tomt rutnät är ett fel som
           bara syns för den som råkar trycka.

           Är brickan vald när den försvinner måste hemgruppen tas tillbaka,
           annars står sidan kvar på ett urval som inte längre har någon
           knapp. */
        if (val.checked) {
          const hem = document.getElementById('kat-hem');
          if (hem) {
            hem.checked = true;
            /* Att sätta `checked` i kod utlöser INGEN change-händelse, och
               räknaren på "Visa fler" lyssnar på just den. Utan raden hade
               knappen stått kvar med platsgruppens tal medan rutnätet visade
               hemgruppen. */
            hem.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
        bricka.hidden = true;
        val.hidden = true;
        avdelare.hidden = true;
        return;
      }

      markta = [...rutnat.querySelectorAll(`li[data-kommun="${kommun.slug}"]`)];
      for (const li of markta) li.setAttribute('data-plats', '');

      etikett.textContent = kommun.city;
      etikett.dataset.etikett = kommun.city;
      /* Rubriken NAMNGER kommunen. Se markupen för varför den måste. */
      rubrik.textContent = `Ställen i ${kommun.city}`;

      val.hidden = false;
      bricka.hidden = false;
      avdelare.hidden = false;

      /* Raden blev bredare. Kategoriradens eget skript räknar om pilar och
         toning vid `resize` och vid rullning, och ingendera inträffar av att
         en bricka dyker upp. Utan raden stod högerpilen dold på en rad som
         nyss fått 90 px mer innehåll än den rymmer. */
      dispatchEvent(new Event('resize'));
    };

    stall(las());

    /* Väljer man kommun i sökpanelen medan man står på startsidan ska brickan
       följa med direkt. `storage` går bara till ANDRA flikar, aldrig till den
       som skrev, så valet meddelas med en egen händelse. Se lib/platsminne.ts. */
    addEventListener(PLATS_HANDELSE, (e) => stall(e.detail ?? null));
    /* Och en annan flik som byter kommun ska inte lämna den här stående på
       ett namn som inte längre gäller. */
    addEventListener('storage', (e) => {
      if (e.key === PLATS_NYCKEL) stall(e.newValue);
    });
  })();
</script>
