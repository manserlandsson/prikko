{/*
  Rullknapparna. Visas bara när raden faktiskt går att rulla, och släcks i
  var sin ände. En pil som inte gör något är sämre än ingen pil.

  Steget är 60 procent av synlig bredd och inte en fast pixelmängd: raden
  är 1 048 px på dator och 358 på telefon, och ett fast steg hade betytt
  "ett val" på det ena och "hela raden" på det andra. Rullningen är mjuk
  via `scroll-behavior: smooth` i CSS, alltså ingen egen animering här.
*/}
{/*
  Nästa vända avslöjas när vaktposten når vyn.

  IntersectionObserver och inte en rullhanterare, av samma skäl som
  sidhuvudets ihopfällning: en hanterare som körs vid varje rullsteg på en
  sida med 340 kort kostar mer än frågan är värd.

  `rootMargin` på 200 px gör att vändan är på plats innan man rullat fram
  till kanten, alltså känns det som att sidan fortsätter i stället för att
  ta slut och sedan växa. Talet är ett tak och inte en smak: marginalen
  läggs till fönstrets höjd, och blir summan större än vaktpostens läge
  avslöjas vändan redan vid inladdningen. Se HEM_FORSTA för räkningen.

  Knappen står kvar i markupen och är fortfarande det som styr CSS:en.
  Skriptet bockar bara i den. Utan skript är den en vanlig knapp som
  fungerar, vilket är hela skälet att den inte ersattes av ett skript.
*/}
<script is:inline>
  (() => {
    const merrad = document.querySelector('[data-merrad]');
    const ruta = document.getElementById('visa-fler');

    if (merrad && ruta && 'IntersectionObserver' in window) {
      merrad.dataset.rullar = '';
      /* `isIntersecting` ensamt räcker inte, och det syns bara om man mäter.
         En vaktpost rapporteras korsad först den bildruta då den ligger inne
         i rutan. Hoppar sidan FÖRBI den i ett enda steg, alltså End-tangenten,
         en återställd rullposition vid bakåtknappen eller en ankarlänk, finns
         det ingen sådan bildruta och nästa vända avslöjas aldrig. Uppmätt
         2026-08-22: ett hopp till sidfoten lämnade tolv kort kvar av trettiosex,
         medan samma sträcka rullad med hjulet gav alla trettiosex.

         `boundingClientRect.top < rootBounds.bottom` är sant både när posten
         är inne i rutan och när den passerat ovanför den, alltså exakt de två
         lägen som ska avslöja. */
      const io = new IntersectionObserver(
        (poster) => {
          const passerad = poster.some(
            (p) =>
              p.isIntersecting ||
              p.boundingClientRect.top <
                (p.rootBounds ? p.rootBounds.bottom : window.innerHeight),
          );
          if (!passerad) return;
          io.disconnect();
          ruta.checked = true;
        },
        { rootMargin: '200px' },
      );
      io.observe(merrad);
    }
  })();
</script>

<script is:inline>
  (() => {
    const rad = document.querySelector('[data-katrad]');
    if (!rad) return;

    const knappar = document.querySelectorAll('[data-rulla]');

    const stall = () => {
      const kanRulla = rad.scrollWidth > rad.clientWidth + 1;
      const vid = rad.scrollLeft;
      const slut = rad.scrollWidth - rad.clientWidth;
      for (const knapp of knappar) {
        const riktning = Number(knapp.dataset.rulla);
        const kvar = riktning < 0 ? vid : slut - vid;
        knapp.hidden = !kanRulla || kvar < 8;
      }

      /* Toningen ska bara finnas i den ände det FINNS mer att rulla åt.
         Ägaren 2026-08-24: "det ska ju såklart ej vara toning åt vänster om
         man är hela vägen till vänster."

         Samma tal som pilarna använder, alltså 8 px slack, så att toning och
         pil alltid visas och döljs tillsammans. En toning utan pil hade sett
         ut som en skugga ingen förstår. */
      rad.toggleAttribute('data-mer-vanster', kanRulla && vid > 8);
      rad.toggleAttribute('data-mer-hoger', kanRulla && slut - vid > 8);
    };

    for (const knapp of knappar) {
      knapp.addEventListener('click', () => {
        rad.scrollBy({ left: Number(knapp.dataset.rulla) * rad.clientWidth * 0.6 });
      });
    }

    rad.addEventListener('scroll', stall, { passive: true });
    window.addEventListener('resize', stall, { passive: true });
    stall();
  })();
</script>

<script is:inline>
  /* RÄKNAREN PÅ "VISA FLER".
     ──────────────────────────────────────────────────────────────────────
     Talet är hur många kort som ligger bakom kryssrutan i den grupp man just
     nu tittar på, alltså konsekvensen av att trycka. Ednias motsvarighet står
     på deras bekräftelseknapp och räknar om medan man väljer.

     Räknas ur DOM:en och inte ur frontmattern, av två skäl. Talet skiljer sig
     per grupp, och en grupp med färre extrakort än en annan hade krävt ett
     attribut per grupp på knappen. Och det som räknas ska vara exakt det som
     CSS:en döljer, alltså `data-extra` för den valda gruppen, annars kan de
     två glida isär utan att någon märker det.

     Skriptet lyssnar på kategoriradens radioknappar. `change` och inte
     `click`: tangentbordet byter val med piltangenter utan ett enda klick. */
  (() => {
    const ut = document.querySelector('[data-merantal]');
    const rutnat = document.querySelector('.rutnat');
    if (!ut || !rutnat) return;

    const skriv = () => {
      const vald = document.querySelector('.katrad input:checked');
      if (!vald) return;
      const grupp = vald.id.replace(/^kat-/, '');
      /* Platsgruppen behöver BÅDA attributen. `data-extra~="plats"` sitter på
         varje kommuns kort efter dess trettionde, alltså även på kommuner som
         inte är vald, och utan `[data-plats]` hade knappen räknat hela landet.
         Uppmätt i bygget: 260 mot Stockholms 207. Samma villkor som CSS:en
         använder, med flit: räknaren och regeln får aldrig glida isär. */
      const kvar = rutnat.querySelectorAll(
        grupp === 'plats'
          ? 'li[data-extra~="plats"][data-plats]'
          : `li[data-extra~="${grupp}"]`,
      ).length;
      ut.textContent = kvar > 0 ? `(${kvar.toLocaleString('sv-SE')})` : '';
    };

    for (const r of document.querySelectorAll('.katrad input')) {
      r.addEventListener('change', skriv);
    }
    skriv();
  })();
</script>

<script is:inline>
  /* Artikelradens rullning. Samma logik som kategoriraden, med samma
     8 px slack, så att toning och pil alltid visas och döljs tillsammans.
     Egen slinga och inte en delad hjälpfunktion: de två raderna har olika
     steglängd, kategoriraden 60 procent av bredden och den här ett helt
     kort plus glugg, alltså 236. Ett halvt kort framme i kanten är sämre än
     att stanna på ett.

     SIST I FILEN, och det är inte en smaksak. Skriptet låg först efter
     kategorifältet, alltså FÖRE artikelraden i dokumentet. Vid parsning fanns
     raden inte än, `querySelector` gav null och slingan återvände direkt.
     Uppmätt i bygget: raden hade 2 816 px innehåll i en 1 329 px vid ruta och
     båda pilarna stod ändå dolda. */
  (() => {
    const rad = document.querySelector('[data-artiklar]');
    if (!rad) return;
    const knappar = document.querySelectorAll('[data-artrulla]');

    const stall = () => {
      const kanRulla = rad.scrollWidth > rad.clientWidth + 1;
      const vid = rad.scrollLeft;
      const slut = rad.scrollWidth - rad.clientWidth;
      for (const knapp of knappar) {
        const riktning = Number(knapp.dataset.artrulla);
        const kvar = riktning < 0 ? vid : slut - vid;
        knapp.hidden = !kanRulla || kvar < 8;
      }
      rad.toggleAttribute('data-mer-vanster', kanRulla && vid > 8);
      rad.toggleAttribute('data-mer-hoger', kanRulla && slut - vid > 8);
    };

    for (const knapp of knappar) {
      knapp.addEventListener('click', () => {
        rad.scrollBy({ left: Number(knapp.dataset.artrulla) * 236 });
      });
    }

    rad.addEventListener('scroll', stall, { passive: true });
    addEventListener('resize', stall, { passive: true });

    /* Tre tillfällen, och alla tre behövs. Vid parsning står måtten inte
       klara, vid `load` har korten fått sina bilder, och bildrutan däremellan
       fångar fallet då bilderna redan låg i cachen och `load` hann före det
       här skriptet. Uppmätt utan dem: båda pilarna stod dolda trots att
       innehållet var 1 400 px i en 1 329 px vid rad. */
    stall();
    requestAnimationFrame(stall);
    addEventListener('load', stall, { once: true });
  })();
</script>


