---
/**
 * Typsnittsspecimen — INTE en publik sida.
 * Ligger under /preview/ som är blockerad i robots.txt och filtrerad ur
 * sitemap. Enda syftet är att jämföra kandidater i den faktiska designen
 * i stället för i abstrakt.
 *
 * Google Fonts laddas här (och bara här) — den riktiga sajten självhostar.
 */
const KANDIDATER = [
  {
    namn: 'Inter',
    stack: "'Inter', sans-serif",
    not: 'Nuvarande. Default i praktiskt taget varje AI-genererad sajt.',
  },
  {
    namn: 'Instrument Sans',
    stack: "'Instrument Sans', sans-serif",
    not: 'Nyare, smalare, redaktionell ton. Låg mättnad i marknaden.',
  },
  {
    namn: 'Plus Jakarta Sans',
    stack: "'Plus Jakarta Sans', sans-serif",
    not: 'Har blivit den nya default-fonten i AI-mallar och SaaS-teman.',
  },
  {
    namn: 'DM Sans',
    stack: "'DM Sans', sans-serif",
    not: 'Geometrisk och vänlig. Läser konsument snarare än register.',
  },
  {
    namn: 'Familjen Grotesk',
    stack: "'Familjen Grotesk', sans-serif",
    not: 'Svensk (Letters from Sweden). Distinkt, med grotesk-auktoritet.',
  },
];
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Typsnittsspecimen — Prikko</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Instrument+Sans:wght@400;600&family=Plus+Jakarta+Sans:wght@400;600&family=DM+Sans:wght@400;600&family=Familjen+Grotesk:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      @import '../../styles/tokens.css';
    </style>
  </head>

  <body>
    <div class="page">
      <header class="intro">
        <p class="eyebrow">Prikko · designbeslut</p>
        <h1 style="font-size:32px;line-height:36px">Vilket typsnitt bär förtroende?</h1>
        <p class="text-secondary" style="margin-top:8px">
          Samma restaurangsida, fem typsnitt. Bedöm rubrikens auktoritet, hur
          siffror och datum sätter sig, och om helheten känns som ett register
          eller som en mall.
        </p>
      </header>

      {KANDIDATER.map((k) => (
        <section class="specimen" style={`font-family:${k.stack}`}>
          <div class="tag">
            <strong>{k.namn}</strong>
            <span class="text-muted">{k.not}</span>
          </div>

          <h2 class="titel">Pizzeria Vesuvio</h2>
          <p class="adress text-secondary">Restaurang · Stortorget 12, Malmö</p>

          <div class="hero">
            <div class="chip"><span>A</span></div>
            <div class="meta">
              <div class="lbl">Mycket bra hygien</div>
              <div class="desc text-secondary">
                Inga avvikelser vid senaste kontrollen 19 mars 2026.
              </div>
              <div class="pills">
                <span class="pill">Riskklass 5</span>
                <span class="pill">3 kontroller</span>
                <span class="pill">Malmö stad</span>
              </div>
            </div>
          </div>

          <div class="rader">
            <div class="rad">
              <span class="prick" style="background:var(--grade-a)"></span>
              <div class="c">
                <b>19 mars 2026</b>
                <span class="text-secondary">Inga avvikelser · 8 punkter godkända</span>
              </div>
              <span class="st" style="color:var(--grade-a)">Godkänd</span>
            </div>
            <div class="rad">
              <span class="prick" style="background:var(--grade-c)"></span>
              <div class="c">
                <b>4 september 2025</b>
                <span class="text-secondary">2 anmärkningar · rengöring, temperatur</span>
              </div>
              <span class="st" style="color:var(--grade-c)">Brister</span>
            </div>
          </div>
        </section>
      ))}
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 720px;
    margin-inline: auto;
    padding: 48px 20px 96px;
  }

  .intro {
    margin-bottom: 40px;
  }

  .specimen {
    background: var(--card);
    border-radius: var(--r-card);
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: var(--shadow-sm);
  }

  .tag {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: baseline;
    padding-bottom: 16px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--hairline);
    font-size: 13px;
  }

  .tag strong {
    font-weight: 600;
    color: var(--brand);
  }

  .titel {
    font-size: 28px;
    line-height: 32px;
    font-weight: 600;
    letter-spacing: -.022em;
  }

  .adress {
    font-size: 16px;
    margin-top: 2px;
  }

  .hero {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
  }

  .chip {
    width: 88px;
    height: 88px;
    border-radius: 20px;
    background: var(--grade-a);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .chip span {
    font-size: 42px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.02em;
  }

  .lbl {
    font-size: 19px;
    font-weight: 600;
    color: var(--grade-a);
    letter-spacing: -.01em;
  }

  .desc {
    font-size: 15px;
    margin-top: 2px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }

  .pill {
    font-size: 13px;
    color: var(--text-secondary);
    background: var(--canvas);
    border-radius: 9px;
    padding: 5px 11px;
  }

  .rader {
    margin-top: 24px;
    border-top: 1px solid var(--hairline);
  }

  .rad {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
  }

  .rad + .rad {
    border-top: 1px solid var(--hairline);
  }

  .prick {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .c {
    flex: 1;
    min-width: 0;
  }

  .c b {
    display: block;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -.01em;
  }

  .c span {
    font-size: 14px;
  }

  .st {
    font-size: 14px;
    font-weight: 600;
  }
</style>
