---
/**
 * Sök.
 *
 * Söker i webbläsaren mot ett register som hämtas som egen fil
 * (/sok-index/<hash>.json). Registret låg tidigare inbakat i den här sidan,
 * vilket gjorde HTML-dokumentet 2,4 MB: hela registret måste laddas ner
 * innan sökrutan ens ritades. Nu ritas sidan direkt och registret kommer
 * efter.
 *
 * Adressen är innehållsbaserad och hämtas från lib/search-index, aldrig
 * skriven för hand. Sidhuvudets sökfält läser samma konstant, så de två
 * konsumenterna kan inte hamna på olika adresser.
 *
 * När beståndet växer nationellt byts filen mot ett serveranrop. Då ändras
 * bara hur `rows` fylls, inte gränssnittet. Därför ligger sökningen redan nu
 * mot en tydlig datastruktur i stället för mot DOM:en.
 *
 * Sidan är indexerbar, men robots.txt blockerar sökningar med query så att
 * tunna resultatsidor aldrig hamnar i Googles index.
 */
import Base from '../layouts/Base.astro';
import FaceSprite from '../components/FaceSprite.astro';
import { coverage, formatNumber, municipalities } from '../lib/data';
import { FACE_SPRITE_ID } from '../lib/face';
import { SEARCH_INDEX_FALLBACK_URL, SEARCH_INDEX_URL } from '../lib/search-index';
import { VERDICT } from '../lib/site';
import { path } from '../lib/urls';

const total = coverage();
const kommuner = municipalities();

const labels = [VERDICT.clean.label, VERDICT.minor.label, VERDICT.major.label];
---

<Base
  title="Sök verksamhet"
  description="Sök på restaurang, café, adress eller skola och se hur den klarade sin senaste hygienkontroll."
>
  <FaceSprite />

  <div class="container page">
    <header>
      <h1>Sök verksamhet</h1>
      <p class="lede text-secondary">
        Sök bland {formatNumber(total.establishments)} verksamheter i
        {' '}{total.municipalities} {total.municipalities === 1 ? 'kommun' : 'kommuner'}.
        Fler tillkommer efterhand.
      </p>
    </header>

    <form class="search" role="search" onsubmit="return false">
      <label for="q" class="visually-hidden">Sök på namn eller adress</label>
      <input
        id="q"
        type="search"
        placeholder="Namn eller adress"
        autocomplete="off"
        autofocus
      />
    </form>

    <p id="status" class="status text-secondary" aria-live="polite"></p>
    <ul id="results" class="results"></ul>

    {/* Utan JavaScript finns ingen sökning — men kommunerna ska ändå gå att
        nå härifrån, och Google ska hitta vidare. Listan är inte en reserv,
        den är sidans enda indexerbara innehåll. */}
    <nav class="fallback" aria-label="Kommuner">
      <h2>Bläddra per kommun</h2>
      <ul>
        {kommuner.map((m) => (
          <li><a href={path(m.slug)}>Hygienkontroller i {m.city}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .page {
    max-width: 720px;
    padding-block: var(--s-12) var(--s-16);
  }

  h1 { font-size: 34px; line-height: 38px; }
  .lede { margin-top: var(--s-2); font-size: var(--fs-body-s); }

  .search { margin-top: var(--s-6); }

  .search input {
    width: 100%;
    height: 52px;
    padding-inline: var(--s-4);
    font-family: inherit;
    font-size: var(--fs-body);
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
  }

  .search input::placeholder { color: var(--text-muted); }

  .status {
    margin-top: var(--s-4);
    font-size: var(--fs-caption);
    min-height: 18px;
  }

  .results {
    list-style: none;
    margin: var(--s-2) 0 0;
    padding: 0;
  }

  .results :global(li) { border-top: 1px solid var(--hairline); }

  .results :global(a) {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    color: var(--text);
  }

  .results :global(a:hover) { text-decoration: none; }
  .results :global(a:hover b) { color: var(--brand); }

  .results :global(.face) {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  .results :global(.info) { flex: 1; min-width: 0; }

  .results :global(.info b) {
    display: block;
    font-size: var(--fs-body-s);
    font-weight: 600;
  }

  .results :global(.info span) {
    font-size: var(--fs-caption);
    color: var(--text-secondary);
  }

  .results :global(.verdict) {
    font-size: var(--fs-caption);
    font-weight: 600;
    flex-shrink: 0;
  }

  .fallback {
    margin-top: var(--s-16);
    padding-top: var(--s-6);
    border-top: 1px solid var(--hairline);
  }

  .fallback h2 { font-size: var(--fs-h-s); line-height: var(--lh-h-s); }

  .fallback ul {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
  }

  .fallback li { font-size: var(--fs-body-s); }
</style>

<script
  define:vars={{
    labels,
    spriteId: FACE_SPRITE_ID,
    indexUrl: SEARCH_INDEX_URL,
    indexFallbackUrl: SEARCH_INDEX_FALLBACK_URL,
  }}
>
  const input = document.getElementById('q');
  const results = document.getElementById('results');
  const status = document.getElementById('status');

  const INK = ['var(--verdict-clean-ink)', 'var(--verdict-minor-ink)', 'var(--verdict-major-ink)'];

  /** Rader: [namn, adress, slug, kommunindex, bedömningsindex]. */
  let rows = null;
  /** Normaliserad söksträng per rad, byggd en gång när registret laddats. */
  let haystack = null;
  let kommuner = [];

  function normalise(s) {
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  }

  function render(term) {
    const q = normalise(term.trim());
    if (q.length < 2) {
      results.innerHTML = '';
      status.textContent = '';
      return;
    }

    if (!rows) {
      status.textContent = 'Hämtar registret…';
      return;
    }

    const hits = [];
    for (let i = 0; i < haystack.length && hits.length < 40; i++) {
      if (haystack[i].includes(q)) hits.push(rows[i]);
    }

    status.textContent = hits.length
      ? `${hits.length}${hits.length === 40 ? '+' : ''} träffar`
      : 'Inga träffar. Verksamheten kan sakna registrerad kontroll.';

    results.innerHTML = hits
      .map(([name, address, slug, k, v]) => {
        const key = v < 0 ? 'none' : ['clean', 'minor', 'major'][v];
        const label = v < 0 ? 'Ingen kontroll' : labels[v];
        const ink = v < 0 ? 'var(--verdict-none-ink)' : INK[v];
        const meta = [address, kommuner[k][1]].filter(Boolean).join(' · ');
        return `<li><a href="/${kommuner[k][0]}/${slug}/">
          <svg class="face" viewBox="0 0 100 100" aria-hidden="true"><use href="#${spriteId}-${key}"/></svg>
          <span class="info"><b>${escapeHtml(name)}</b><span>${escapeHtml(meta)}</span></span>
          <span class="verdict" style="color:${ink}">${label}</span>
        </a></li>`;
      })
      .join('');
  }

  input.addEventListener('input', () => render(input.value));

  /**
   * Hämtar registret från den hashade adressen, med den gamla som reserv.
   *
   * Reserven är inte paranoia. Det här dokumentet kan ha legat i cachen sedan
   * förra bygget och peka på en hash som inte längre finns på servern. Att
   * sökningen då blir helt död vore ett värre fel än det inaktuella register
   * vi gick ifrån.
   */
  function fetchIndex(url, fallback) {
    return fetch(url).then((r) => {
      if (r.ok) return r.json();
      if (fallback) return fetchIndex(fallback, null);
      throw new Error(String(r.status));
    });
  }

  fetchIndex(indexUrl, indexFallbackUrl)
    .then((data) => {
      kommuner = data.k;
      rows = data.e;
      // Byggs här i stället för att skickas med — samma sträng i filen hade
      // varit en ren kopia av namn, adress och ort, och nästan halva vikten.
      haystack = rows.map(
        ([name, address, , k]) => normalise(`${name} ${address} ${kommuner[k][1]}`),
      );
      render(input.value);
    })
    .catch(() => {
      status.textContent =
        'Sökregistret gick inte att hämta. Bläddra per kommun längre ner på sidan.';
    });

  // Stöd för /sok?q=... så att länkar utifrån fungerar direkt.
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    render(initial);
  }
</script>
