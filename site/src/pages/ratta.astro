---
/**
 * Rättelsesidan. Bär replikrätten, som är ett av våra juridiska skydd.
 *
 * ---------------------------------------------------------------------------
 * ETT VANLIGT FORMULÄR SOM SKICKAR
 * ---------------------------------------------------------------------------
 * Formuläret gör en POST till /api/ratta, som är en Cloudflare Pages Function
 * i site/functions/api/ratta.ts. Den skickar brevet till redaktionen genom
 * Resend. Ingen inloggning, ingen mejlklient, ingen tom textruta.
 *
 * Det bryter inte mot ADR 0001. Beslutet säger "statiskt genererat till att
 * börja med, med en planerad migration till hybridrendering på Cloudflare
 * Workers", och sajten ligger redan på Cloudflare Pages. Varje SIDA förblir
 * statiskt genererad; det är bara den här slutpunkten som körs vid förfrågan,
 * och Pages Functions ligger bredvid det statiska bygget utan att tvinga
 * någon sida att renderas om.
 *
 * En rad i community-schemat övervägdes och valdes bort. moderate.py läser
 * inte en sådan tabell och ingen notis går ut, så en rättelse hade legat
 * oläst, och skrivningen hade krävt inloggning av just den person formuläret
 * finns för. Ett brev landar i en inkorg som läses varje dag.
 *
 * RESERVVÄGEN ÄR KVAR. Går slutpunkten ned, saknas nyckeln eller svarar
 * Resend fel, visas samma text på sidan med adressen utskriven och en
 * kopieringsknapp. Ett formulär som bara misslyckas är oacceptabelt på den
 * sida där en verksamhet ska kunna försvara sig.
 *
 * KRÄVER AV ÄGAREN: brevlådan ratta@prikko.se måste finnas, annars skickas
 * brevet utan fel men landar ingenstans. Se docs/13_epost_pa_prikko_se.md
 * steg 1. Dessutom måste RESEND_API_KEY ligga som Secret i Pages.
 *
 * ---------------------------------------------------------------------------
 * SKRÄPPOST
 * ---------------------------------------------------------------------------
 * En honungsfälla, alltså ett dolt fält som bara en robot fyller i, plus en
 * kontroll av hur snabbt formuläret fylldes och en takregel per IP i
 * funktionen. Ingen Turnstile: den lägger ett tredjepartsskript och egen
 * lagring på en sajt som just dokumenterat i docs/14 att den inte har vare
 * sig spårpixlar eller Google Fonts, och det skulle göra /cookies och
 * /integritetspolicy osanna igen veckan efter att de gjordes sanna. Kommer
 * det faktisk skräppost är Turnstile nästa steg, och då ska de sidorna
 * uppdateras i samma ändring.
 *
 * ---------------------------------------------------------------------------
 * RÄTTELSE ÄR INTE GENMÄLE
 * ---------------------------------------------------------------------------
 * Rättelse: uppgiften är fel och ska ändras. Genmäle: uppgiften stämmer, men
 * verksamheten vill svara på den. Det andra har en egen väg, /konto/verksamhet,
 * som kräver inloggning och godkänt anspråk. Formuläret frågar därför i vilken
 * egenskap man hör av sig och visar vägen till genmäle för den som företräder
 * verksamheten, i stället för att ta emot ett genmäle i fel kanal.
 *
 * Kommunens kontrolluppgift kan vi inte rätta. Vi återger den. Alternativet
 * "uppgiften i kommunens kontrollrapport är fel" leder därför till kommunen
 * och har inget svarsfält, för det finns inget vi kan skriva om.
 */
import Base from '../layouts/Base.astro';
import '../styles/konto.css';
import { PUBLISHER } from '../lib/site';

const CONTACT = PUBLISHER.correctionEmail;

/**
 * Alternativen, och vad var och en frågar efter härnäst.
 *
 * `fix` är frågan på fältet "vad ska det vara i stället". Att den bor på
 * alternativet och inte i koden är hela poängen med formuläret: frågan blir
 * den rätta i stället för att en tom ruta får bära allt. Saknas `fix` finns
 * inget att rätta till ett bestämt värde, och fältet visas inte.
 *
 * `hint` står separat och inte som en andra mening i `fix`, eftersom frågan
 * följer med in i mejlet men handledningen inte ska göra det. "Vilka sidor är
 * dubbletter? Klistra in länkarna." lästes som en uppmaning till redaktionen
 * när den hamnade i brevet.
 *
 * Etiketten är också radioknappens värde, alltså ordagrant det som hamnar i
 * mejlet. Ingen kod ska behöva slå upp vad "dubblett" betydde, och den som
 * läser mejlet ser samma mening som den som fyllde i formuläret.
 */
const GROUPS: Array<{
  legend: string;
  scope: 'place' | 'inspection' | 'other';
  options: Array<{ label: string; fix?: string; hint?: string; toMunicipality?: boolean }>;
}> = [
  {
    legend: 'Uppgifter om en verksamhet',
    scope: 'place',
    options: [
      { label: 'Fel adress', fix: 'Vilken adress är den rätta?' },
      { label: 'Fel namn', fix: 'Vad heter verksamheten?' },
      {
        label: 'Fel plats på kartan',
        fix: 'Var ligger den?',
        hint: 'Adress eller närmaste korsning räcker.',
      },
      { label: 'Fel bild på verksamheten', fix: 'Vad är det bilden visar?' },
      {
        label: 'Verksamheten har upphört',
        fix: 'När stängde den?',
        hint: 'Ungefär räcker.',
      },
      {
        label: 'Verksamheten finns med flera gånger',
        fix: 'Vilka sidor är dubbletter?',
        hint: 'Klistra in länkarna.',
      },
    ],
  },
  {
    legend: 'En kontroll',
    scope: 'inspection',
    options: [
      {
        label: 'Kontrollen gäller en tidigare verksamhet i lokalen',
        fix: 'När tog ni över lokalen?',
      },
      {
        label: 'Bedömningen stämmer inte med kontrollrapporten',
        fix: 'Vad står det i rapporten?',
      },
      { label: 'Uppgiften i kommunens kontrollrapport är fel', toMunicipality: true },
    ],
  },
  {
    legend: 'Något annat',
    scope: 'other',
    options: [{ label: 'Något annat på sajten' }],
  },
];
---

<Base
  title="Rätta en uppgift"
  description="Anser du att en uppgift på Prikko är felaktig? Fyll i vad som är fel, så går det till redaktionen."
  noindex={true}
>
  <div class="container konto-page konto-wide">
    <div class="konto-card">
      <h1>Rätta en uppgift</h1>
      <p class="konto-lead">
        Svara på frågorna nedan, så går rättelsen till redaktionen.
      </p>

      <form id="form" novalidate>
        <h2 class="q">Vad är fel?</h2>

        {GROUPS.map((group) => (
          <fieldset class="group">
            <legend>{group.legend}</legend>
            {group.options.map((option) => (
              <label class="choice">
                <input
                  type="radio"
                  name="issue"
                  value={option.label}
                  data-scope={group.scope}
                  data-fix={option.fix ?? ''}
                  data-hint={option.hint ?? ''}
                  data-kommun={option.toMunicipality ? 'ja' : ''}
                />
                <span>{option.label}</span>
              </label>
            ))}
          </fieldset>
        ))}

        {/* Kommunens uppgift. Ingen väg framåt hos oss, och det ska stå
            innan någon skriver en text vi inte kan göra något med. */}
        <p class="notice notice-wait" id="to-municipality" hidden role="status">
          <b>Det här kan vi inte rätta.</b> Vi återger kommunens kontrollrapport
          och ändrar den aldrig. Rättelse begärs hos kommunens miljöförvaltning.
          Hör ändå av dig, så markerar vi uppgiften som bestridd medan den utreds.
        </p>

        {/* Verksamheten. Ifylld i förväg när man kommer från verksamhetssidan. */}
        <div class="block" id="place-block" hidden>
          <h2 class="q">Vilken verksamhet?</h2>

          <p class="from" id="from" hidden>
            Kommer från <a id="from-link" href="/">sidan du var på</a>.
          </p>

          <label class="field">
            <span>Namn</span>
            <input type="text" name="placeName" id="place-name" maxlength="150" />
          </label>

          <label class="field">
            <span>Kommun</span>
            <input type="text" name="placeMunicipality" id="place-municipality" maxlength="80" />
          </label>
        </div>

        {/* Allt annat på sajten. Då är sidan det enda som pekar ut vad det gäller. */}
        <div class="block" id="page-block" hidden>
          <h2 class="q">Vilken sida?</h2>
          <label class="field">
            <span>
              Adress
              <span class="hint">Kopiera från adressfältet.</span>
            </span>
            <input type="url" name="pageUrl" id="page-url" maxlength="300" placeholder="https://prikko.se/..." />
          </label>
        </div>

        {/* Rättelsen. Etiketten byts mot alternativets egen fråga. */}
        <label class="field fix" id="fix-field" hidden>
          <span>
            <span id="fix-label">Vad ska det vara i stället?</span>
            <span class="hint" id="fix-hint" hidden></span>
          </span>
          <input type="text" name="fix" id="fix" maxlength="300" />
        </label>

        <h2 class="q">Vem hör av sig?</h2>
        <fieldset class="group">
          <legend class="visually-hidden">Din roll</legend>
          <label class="choice">
            <input type="radio" name="role" value="Besökare" data-role="visitor" />
            <span>Jag är besökare</span>
          </label>
          <label class="choice">
            <input type="radio" name="role" value="Företrädare för verksamheten" data-role="owner" />
            <span>Jag företräder verksamheten</span>
          </label>
        </fieldset>

        {/* Genmäle är något annat än rättelse, och den som företräder
            verksamheten har rätt till båda. Vägen dit visas här, inte i ett
            stycke text ovanför formuläret. */}
        <p class="notice notice-wait" id="reply-right" hidden role="status">
          <b>Stämmer uppgiften men ni vill svara på den?</b> Det är ett genmäle,
          inte en rättelse. Svaret publiceras ordagrant bredvid kontrollen.
          <a id="reply-link" href="/konto/verksamhet/">Svara på en kontroll</a>.
        </p>

        <label class="field">
          <span>Ditt namn</span>
          <input type="text" name="name" id="name" maxlength="100" autocomplete="name" />
        </label>

        <label class="field">
          <span>E-post vi kan svara på</span>
          <input type="email" name="email" id="email" maxlength="150" autocomplete="email" />
        </label>

        <label class="field" id="phone-field" hidden>
          <span>
            Telefon
            <span class="hint">Frivilligt. Snabbare om vi behöver reda ut vem du är.</span>
          </span>
          <input type="tel" name="phone" id="phone" maxlength="30" autocomplete="tel" />
        </label>

        <label class="field">
          <span>
            Något mer vi behöver veta?
            <span class="hint">Frivilligt.</span>
          </span>
          <textarea name="note" id="note" maxlength="1200"></textarea>
        </label>

        {/* Honungsfällan.

            Dold för människor med CSS och för skärmläsare med aria-hidden och
            tabindex, alltså aldrig något en besökare kan hamna i av misstag.
            Namnet är valt för att locka: en ifyllningsrobot som känner igen
            "webbplats" fyller i den gärna. autocomplete="off" hindrar
            webbläsaren från att fylla i den åt en människa, vilket annars
            hade spärrat ute en riktig rättelse. */}
        <div class="trap" aria-hidden="true">
          <label for="webbplats">Lämna det här fältet tomt</label>
          <input type="text" id="webbplats" name="webbplats" tabindex="-1" autocomplete="off" />
        </div>

        <p class="notice notice-error" id="error" hidden role="alert"></p>

        <div class="konto-actions">
          <button type="submit" class="btn-primary" id="submit">Skicka rättelsen</button>
        </div>
      </form>

      {/* Kvittensen. Ersätter formuläret, för det finns inget kvar att göra. */}
      <div class="receipt" id="receipt" hidden>
        {/* Ingen svarstid här: raden under formuläret säger redan det, och
            den står kvar på kvittensskärmen. */}
        <p class="notice notice-ok" role="status">
          <b>Tack.</b> Rättelsen är skickad till redaktionen.
        </p>
      </div>

      {/* Reservvägen. Visas bara när utskicket faktiskt misslyckades, och bär
          då hela texten så att ingen står utan väg fram. Formuläret ligger
          kvar ovanför, så att ett nytt försök går att göra direkt. */}
      <div class="handoff" id="handoff" hidden>
        <p class="notice notice-error" role="alert" id="handoff-why">
          <b>Kunde inte skicka.</b>
        </p>
        <p class="fallback">
          Rättelsen är alltså inte inskickad. Mejla
          <a href={`mailto:${CONTACT}`}>{CONTACT}</a> och klistra in texten
          nedan, så tappas ingenting bort.
        </p>
        <textarea id="draft" readonly rows="12" aria-label="Texten till mejlet"></textarea>
        <div class="konto-actions">
          <button type="button" class="btn-quiet" id="copy">Kopiera texten</button>
          <span class="copied caption text-muted" id="copied" hidden>Kopierad.</span>
        </div>
      </div>

      <p class="konto-legal">
        Vi svarar normalt inom några dagar. Uppgifterna du lämnar används för
        att utreda och besvara din rättelse, inget annat. Se
        <a href="/integritetspolicy/">integritetspolicyn</a>.
      </p>
    </div>
  </div>
</Base>

<style>
  .q {
    margin-top: var(--s-8);
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  form > .q:first-child { margin-top: var(--s-6); }

  /* Grupperna delar radioknapparnas namn, så de är EN fråga trots tre
     fieldsets. Uppdelningen finns för att legenden ska kunna säga vilken
     sorts fel raderna under handlar om, vilket är den enda förklaring
     alternativen behöver. */
  .group {
    border: 0;
    padding: 0;
    margin: var(--s-4) 0 0;
    min-width: 0;
  }

  .group legend {
    padding: 0;
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .choice {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
    cursor: pointer;
  }

  .choice + .choice { border-top: 1px solid var(--hairline); }

  .choice input {
    flex: none;
    width: 17px;
    height: 17px;
    /* Radioknappen är rund och texten fyrkantig. Utan knuffen ligger den
       på textens överkant i stället för mitt för första raden. */
    margin: 1px 0 0;
    accent-color: var(--brand);
  }

  .from {
    margin-top: var(--s-3);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-secondary);
  }

  /* `hidden` måste vinna över display-reglerna i konto.css, som sätts av en
     klass och därmed har högre specificitet än webbläsarens [hidden]. Samma
     fälla som redan är dokumenterad på .konto-actions där. */
  .field[hidden],
  .block[hidden],
  .from[hidden],
  .hint[hidden],
  .handoff[hidden],
  .receipt[hidden],
  .copied[hidden] { display: none; }

  /* Honungsfällan.

     Inte `display: none` och inte `hidden`: en del robotar hoppar över just
     de två, eftersom de är det uppenbara sättet att gömma en fälla. Att i
     stället flytta fältet ur bild träffar fler, och för en människa är
     resultatet detsamma. `aria-hidden` och `tabindex="-1"` i markupen gör att
     varken skärmläsare eller tabbning når det. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .handoff { margin-top: var(--s-6); }

  .fallback {
    margin-top: var(--s-4);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  #draft {
    width: 100%;
    margin-top: var(--s-3);
    font: 400 var(--fs-body-s)/var(--lh-body-s) var(--font-sans);
    color: var(--text);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    padding: 10px 12px;
    resize: vertical;
  }
</style>

<script>
  import { PUBLISHER } from '../lib/site';

  const CONTACT = PUBLISHER.correctionEmail;

  const form = document.getElementById('form') as HTMLFormElement;
  const error = document.getElementById('error') as HTMLParagraphElement;

  const placeBlock = document.getElementById('place-block') as HTMLDivElement;
  const placeName = document.getElementById('place-name') as HTMLInputElement;
  const placeMunicipality = document.getElementById('place-municipality') as HTMLInputElement;
  const pageBlock = document.getElementById('page-block') as HTMLDivElement;
  const pageUrl = document.getElementById('page-url') as HTMLInputElement;

  const from = document.getElementById('from') as HTMLParagraphElement;
  const fromLink = document.getElementById('from-link') as HTMLAnchorElement;

  const fixField = document.getElementById('fix-field') as HTMLLabelElement;
  const fixLabel = document.getElementById('fix-label') as HTMLSpanElement;
  const fixHint = document.getElementById('fix-hint') as HTMLSpanElement;
  const fix = document.getElementById('fix') as HTMLInputElement;

  const toMunicipality = document.getElementById('to-municipality') as HTMLParagraphElement;
  const replyRight = document.getElementById('reply-right') as HTMLParagraphElement;
  const replyLink = document.getElementById('reply-link') as HTMLAnchorElement;
  const phoneField = document.getElementById('phone-field') as HTMLLabelElement;

  const submit = document.getElementById('submit') as HTMLButtonElement;
  const receipt = document.getElementById('receipt') as HTMLDivElement;
  const trap = document.getElementById('webbplats') as HTMLInputElement;

  const handoff = document.getElementById('handoff') as HTMLDivElement;
  const handoffWhy = document.getElementById('handoff-why') as HTMLParagraphElement;
  const draft = document.getElementById('draft') as HTMLTextAreaElement;
  const copy = document.getElementById('copy') as HTMLButtonElement;
  const copied = document.getElementById('copied') as HTMLSpanElement;

  /**
   * När formuläret ritades.
   *
   * Skickas med och jämförs i funktionen. En människa som läser tio alternativ
   * och fyller i fem fält är inte klar på tre sekunder; en robot är det.
   */
  const startedAt = Date.now();

  /**
   * Verksamheten kommer med i adressen från knappen på verksamhetssidan,
   * samma mönster som /konto/verksamhet redan använder. `sida` är vår egen
   * tilläggsparameter och bär sökvägen till sidan man stod på, för den är
   * det mest användbara redaktionen kan få.
   */
  const query = new URLSearchParams(location.search);
  const arrivedFrom = {
    id: query.get('id') ?? '',
    name: query.get('namn') ?? '',
    municipality: query.get('kommun') ?? '',
    /**
     * Adressen kommer utifrån och får aldrig bli ett href rakt av. En
     * `javascript:`-sträng i en länk vi själva renderar är en färdig XSS.
     * Bara rotrelativa sökvägar på vår egen sajt släpps fram, och `//` faller
     * eftersom det är en protokollrelativ adress till en främmande värd.
     */
    path: (() => {
      const raw = query.get('sida') ?? '';
      return raw.startsWith('/') && !raw.startsWith('//') ? raw : '';
    })(),
  };

  if (arrivedFrom.name) placeName.value = arrivedFrom.name;

  /* Kommunen kommer som slug, alltså "uppsala". Fältet läses av en människa
     och citeras rakt in i mejlet, så versalen sätts tillbaka. Bara första
     bokstaven: sammansatta slugar som "upplands-vasby" får en människa reda
     ut, och fältet går att skriva i. */
  if (arrivedFrom.municipality) {
    placeMunicipality.value =
      arrivedFrom.municipality.charAt(0).toUpperCase() + arrivedFrom.municipality.slice(1);
  }

  if (arrivedFrom.path) {
    fromLink.href = arrivedFrom.path;
    fromLink.textContent = arrivedFrom.name || 'sidan du var på';
    from.hidden = false;
  }

  /* Genmälesvägen behöver samma tre parametrar som verksamhetssidan skickar.
     Utan id leder länken ingenstans användbart, och då pekar den på kontot. */
  if (arrivedFrom.id) {
    replyLink.href =
      '/konto/verksamhet/?id=' +
      encodeURIComponent(arrivedFrom.id) +
      '&kommun=' +
      encodeURIComponent(arrivedFrom.municipality) +
      '&namn=' +
      encodeURIComponent(arrivedFrom.name);
  }

  function selectedIssue(): HTMLInputElement | null {
    return form.querySelector<HTMLInputElement>('input[name="issue"]:checked');
  }

  function selectedRole(): HTMLInputElement | null {
    return form.querySelector<HTMLInputElement>('input[name="role"]:checked');
  }

  /** Visar bara det som det valda alternativet faktiskt behöver. */
  function paint() {
    const issue = selectedIssue();
    const scope = issue?.dataset.scope ?? '';
    const fixText = issue?.dataset.fix ?? '';

    placeBlock.hidden = !(scope === 'place' || scope === 'inspection');
    pageBlock.hidden = scope !== 'other';
    toMunicipality.hidden = issue?.dataset.kommun !== 'ja';

    const hintText = issue?.dataset.hint ?? '';
    fixField.hidden = !fixText;
    if (fixText) fixLabel.textContent = fixText;
    fixHint.textContent = hintText;
    fixHint.hidden = !hintText;

    const owner = selectedRole()?.dataset.role === 'owner';
    replyRight.hidden = !owner;
    phoneField.hidden = !owner;
  }

  form.addEventListener('change', paint);
  paint();

  /**
   * Samlar ihop svaren.
   *
   * Returnerar två saker: fälten som skickas till slutpunkten, och en färdig
   * text till reservvägen. Texten byggs alltså på två ställen, här och i
   * funktionen, och det är med avsikt. Funktionen får aldrig lita på en kropp
   * som klienten satt ihop, och reservvägen måste fungera just när funktionen
   * inte svarar. Den enda som ser båda är den vars utskick misslyckades, och
   * för honom är formuleringarna desamma.
   */
  function collect(): { payload: Record<string, unknown>; draft: string } | null {
    const issue = selectedIssue();
    if (!issue) {
      fail('Välj vad som är fel.');
      return null;
    }

    const scope = issue.dataset.scope ?? '';
    const role = selectedRole();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
    const note = (document.getElementById('note') as HTMLTextAreaElement).value.trim();

    if (scope !== 'other' && !placeName.value.trim()) {
      fail('Skriv vilken verksamhet det gäller.');
      return null;
    }
    if (scope === 'other' && !pageUrl.value.trim()) {
      fail('Skriv vilken sida det gäller.');
      return null;
    }
    if (!role) {
      fail('Välj om du är besökare eller företräder verksamheten.');
      return null;
    }
    if (!name) {
      fail('Skriv ditt namn.');
      return null;
    }
    /* Grov kontroll, inte en fullständig. En adress som inte går fram
       studsar hos avsändaren, och det är ett bättre besked än vårt. */
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      fail('Skriv en e-postadress vi kan svara på.');
      return null;
    }

    const lines: string[] = [`Vad är fel: ${issue.value}`];

    if (scope === 'other') {
      lines.push(`Sida: ${pageUrl.value.trim()}`);
    } else {
      const municipality = placeMunicipality.value.trim();
      lines.push(
        `Verksamhet: ${placeName.value.trim()}${municipality ? `, ${municipality}` : ''}`,
      );
      if (arrivedFrom.path) lines.push(`Sida: ${location.origin}${arrivedFrom.path}`);
      if (arrivedFrom.id) lines.push(`Id: ${arrivedFrom.id}`);
    }

    if (!fixField.hidden && fix.value.trim()) {
      lines.push(`${fixLabel.textContent} ${fix.value.trim()}`);
    }

    lines.push('', `Avsändare: ${name}, ${role.value}`, `E-post: ${email}`);
    if (phone) lines.push(`Telefon: ${phone}`);
    if (note) lines.push('', note);

    const subject =
      scope === 'other'
        ? `Rättelse: ${pageUrl.value.trim()}`
        : `Rättelse: ${placeName.value.trim()}`;

    const useFix = !fixField.hidden && fix.value.trim();

    return {
      payload: {
        issue: issue.value,
        fixLabel: useFix ? fixLabel.textContent : '',
        fix: useFix ? fix.value.trim() : '',
        placeName: scope === 'other' ? '' : placeName.value.trim(),
        placeMunicipality: scope === 'other' ? '' : placeMunicipality.value.trim(),
        placeId: scope === 'other' ? '' : arrivedFrom.id,
        placePath: scope === 'other' ? '' : arrivedFrom.path,
        pageUrl: scope === 'other' ? pageUrl.value.trim() : '',
        role: role.value,
        name,
        email,
        phone,
        note,
        /* Fällan skickas med som den står. Är den ifylld är det inte en
           människa som fyllt i den, och funktionen avgör vad som ska hända. */
        webbplats: trap.value,
        startedAt,
      },
      draft: `Till: ${CONTACT}\nÄmne: ${subject}\n\n${lines.join('\n')}`,
    };
  }

  function fail(message: string) {
    error.innerHTML = '<b>Fel.</b> ';
    error.append(message);
    error.hidden = false;
    error.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  /**
   * Reservvägen: texten kvar på sidan med adressen utskriven.
   *
   * Visas BARA när utskicket verkligen gick fel. Ett valideringsfel hör inte
   * hit, för då finns det något att rätta i formuläret i stället.
   */
  function showFallback(text: string, why: string) {
    draft.value = text;
    handoffWhy.innerHTML = '<b>Kunde inte skicka.</b> ';
    handoffWhy.append(why);
    handoff.hidden = false;
    /* Kvittensen gäller den gamla texten. Rättar man ett fält och skickar om
       står "Kopierad" annars kvar över något man inte kopierat. */
    copied.hidden = true;
    handoff.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    error.hidden = true;
    handoff.hidden = true;

    const filled = collect();
    if (!filled) return;

    submit.disabled = true;
    submit.textContent = 'Skickar';

    try {
      const res = await fetch('/api/ratta', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(filled.payload),
      });

      /* Svaret är JSON när slutpunkten finns. Gör den inte det, till exempel
         under `astro dev` där Pages Functions inte körs, kommer en HTML-sida
         i stället och den här ska inte kasta. */
      let data: { ok?: boolean; error?: string } | null = null;
      try {
        data = await res.json();
      } catch {
        /* Inte JSON. `data` förblir null och fallen nedan tar hand om det. */
      }

      if (res.ok && data?.ok) {
        form.hidden = true;
        receipt.hidden = false;
        receipt.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }

      /* Fel vi själva ställt: fyll i något annat. Att lägga fram en text att
         kopiera hade varit fel svar på "du glömde din e-postadress". */
      if (res.status === 400 || res.status === 429) {
        fail(data?.error ?? 'Kunde inte skicka.');
        return;
      }

      showFallback(
        filled.draft,
        data?.error ?? `Servern svarade ${res.status}. Rättelsen är inte inskickad.`,
      );
    } catch {
      showFallback(filled.draft, 'Ingen kontakt med servern. Rättelsen är inte inskickad.');
    } finally {
      submit.disabled = false;
      submit.textContent = 'Skicka rättelsen';
    }
  });

  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(draft.value);
    } catch {
      /* Utan behörighet till urklipp får markeringen göra jobbet. */
      draft.select();
      return;
    }
    copied.hidden = false;
  });
</script>
