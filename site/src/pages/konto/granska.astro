---
/**
 * Granskning.
 *
 * Redaktionens arbetsyta: kön av omdömen, bilder, svar och anspråk som väntar på
 * ett beslut, och två knappar per post.
 *
 * ---------------------------------------------------------------------------
 * SIDAN ÄR INTE SPÄRREN
 * ---------------------------------------------------------------------------
 * HTML-filen byggs som varje annan sida och ligger öppet på prikko.se. Den är
 * tom: allt innehåll hämtas i webbläsaren, och databasen släpper bara ut kön
 * till ett konto som står i community.admins. Den som öppnar adressen utan
 * behörighet ser en mening om att sidan är redaktionens, och en fråga mot API:t
 * med samma konto svarar 42501.
 *
 * Ingen e-postadress står som villkor någonstans i den här filen. Rollen bor i
 * databasen, se pipeline/schema_admin.sql och site/src/lib/granska.ts.
 *
 * ---------------------------------------------------------------------------
 * FORMEN
 * ---------------------------------------------------------------------------
 * Detta är ett verktyg och inte en sida någon läser. Alltså: inga kort, inga
 * ramar i huvudkolumnen, ingen förklarande brödtext, och tätt före snyggt. En
 * hårfin linje mellan posterna och en markör i vänsterkanten för den som står i
 * tur, precis som en inkorg.
 *
 * TANGENTBORDET RÄCKER. G godkänner, A avslår, J och K flyttar. Ett avslag
 * kräver ett skäl, och skälet visas för den som skickade in på hens egen
 * kontosida. Musen fungerar också, men den som går igenom trettio bilder ska
 * aldrig behöva flytta handen.
 *
 * ---------------------------------------------------------------------------
 * VAD SIDAN INTE KAN
 * ---------------------------------------------------------------------------
 * Hygienbedömningen, kontrollhistoriken och utmärkelsen finns inte här och ska
 * aldrig göra det. De kommer från kommunernas kontroller, de skrivs bara av
 * pipelinen, och ingen funktion sidan når kan röra dem. Se schema_admin.sql.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/konto.css';
---

<Base title="Granska" description="Redaktionens granskning." noindex>
  <div class="container konto-page konto-wide granska">
    <p id="laddar" class="konto-empty">Hämtar kön …</p>

    {/* Utloggad, eller inloggad utan behörighet. Samma yta, olika text. */}
    <div id="nej" hidden>
      <header class="konto-head">
        <h1>Granska</h1>
        <p class="konto-sub" id="nej-text">Den här sidan är redaktionens.</p>
      </header>
      <div class="konto-actions">
        <button type="button" class="btn-primary" id="logga-in">Logga in</button>
      </div>
    </div>

    <div id="verktyg" hidden>
      {/* Apphuvudet, klistrat.

          Rubriken är 17 px och inte 32: det här är ett verktygsfält och inte
          en sidtitel, samma val som booli gör på sitt sökresultat, där h1
          renderas i 14 px. Se docs/19_formsystem.md.

          Att raden är klistrad är hela skälet till att genvägarna får plats.
          De stod förut i en fotnot under kön, alltså osynliga från post nummer
          två och nedåt, vilket är precis de poster man behöver dem för. */}
      <header class="granska-topp">
        <h1>Granska</h1>
        <span class="granska-rakning" id="rakning"></span>
        <p class="granska-tangenter" aria-hidden="true">
          <span><kbd>J</kbd><kbd>K</kbd> flytta</span>
          <span><kbd>Esc</kbd> avbryt</span>
          <span><kbd>R</kbd> hämta om</span>
        </p>
      </header>

      <p class="notice" id="global" hidden></p>

      <ol class="granska-ko" id="ko"></ol>

      <p class="granska-tomt" id="tomt" hidden>
        Kön är tom. Ingenting väntar på ett beslut.
      </p>
    </div>
  </div>
</Base>

<style is:global>
  /*
   * `is:global`, och varje selektor inleds med `.granska`.
   *
   * Astros scoping märker de element som står i MALLEN. Kön målas i webbläsaren
   * med createElement, alltså saknar varje post märkningen och en scopad regel
   * hade inte träffat en enda av dem. Samma skäl som gör att kontosidorna delar
   * konto.css i stället för att styla sig själva.
   *
   * `.granska` sitter på sidans yttersta div och finns ingen annanstans på
   * sajten, så räckvidden är den här sidan trots att regeln är global.
   *
   * -------------------------------------------------------------------------
   * FORMEN ÄR ETT VERKTYG OCH INTE EN SIDA
   * -------------------------------------------------------------------------
   * Tätt slår luftigt. Låg kontrast i det som är ram (linjer, etiketter,
   * knappkanter), hög kontrast i det som är innehåll (bilden, texten,
   * beslutet). Referensen är Linear och inte en publik sajt: den som går
   * igenom trettio bilder ska aldrig behöva flytta handen eller leta.
   */

  /* Bredden är --w-wide och inte ett eget tal.
     Här stod 860 px, alltså en femte sidbredd på en sajt som har fyra
     (docs/19_formsystem.md). Verktyget behöver dessutom mer än 860: bilden och
     texten om den ska stå BREDVID varandra, och det gör de inte i 860. */
  .granska {
    max-width: var(--w-wide);
    /* Ingen luft över: den klistrade huvudraden ska nå toppen av rullningen.
       De två lägen som INTE är verktyget får sin luft var för sig nedan. */
    padding-block: 0 var(--s-16);
  }

  .granska #laddar,
  .granska #nej { padding-top: var(--s-12); }

  /* ----------------------------------------------------------------------- */
  /* Apphuvudet                                                              */
  /* ----------------------------------------------------------------------- */

  .granska .granska-topp {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-block: var(--s-3);
    /* Ogenomskinlig, inte glas: kön rullar under raden och en halvgenomskinlig
       list hade lagt en bild ovanpå rubriken. Glas hör hemma på lager som
       svävar, se tokens.css. */
    background: var(--canvas);
    border-bottom: 1px solid var(--hairline);
  }

  .granska .granska-topp h1 {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    letter-spacing: 0;
    flex: none;
  }

  /* Räkningen som en liten sifferbricka. Den är det enda i huvudet som ändrar
     sig, och den ska gå att läsa i ögonvrån utan att söka efter den. */
  .granska .granska-rakning {
    flex: none;
    padding: 2px var(--s-2);
    border-radius: var(--r-pill);
    background: var(--brand-wash);
    color: var(--brand-ink);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .granska .granska-tangenter {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-1) var(--s-4);
    font-size: var(--fs-micro);
    line-height: var(--lh-micro);
    color: var(--text-muted);
  }

  .granska .granska-tangenter span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  /* Tangenten som tangent. En bokstav i en liten ram säger vad man ska trycka
     på utan en enda förklarande mening. */
  .granska kbd {
    display: inline-block;
    min-width: 17px;
    padding: 1px 4px;
    border: 1px solid var(--hairline);
    border-bottom-width: 2px;
    border-radius: 4px;
    background: var(--card);
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    line-height: 15px;
    font-weight: 600;
    text-align: center;
  }

  /* ----------------------------------------------------------------------- */
  /* Kön                                                                     */
  /* ----------------------------------------------------------------------- */

  .granska .granska-ko {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Ingen ram runt posten. Linjen ligger mellan raderna, som i en inkorg, och
     vänsterkanten bär markören för den som står i tur. Den valda posten får
     dessutom en svag fyllning: en 3 px kant ensam syns inte när kön är hundra
     poster lång och man rör sig med J och K. */
  /* Raden går ut i sidans marginal, som i en inkorg: markeringen ska nå
     kanten, inte sitta som en ruta inne på ytan. */
  .granska .granska-post {
    border-bottom: 1px solid var(--hairline);
    border-left: 3px solid transparent;
    /* Vänsterindraget är s-4 MINUS markörens 3 px, så att postens text står i
       exakt samma lodräta linje som rubriken i huvudraden. */
    padding: var(--s-4) var(--s-4) var(--s-6) calc(var(--s-4) - 3px);
    margin-inline: calc(var(--s-4) * -1);
  }

  .granska .granska-post[data-vald='1'] {
    border-left-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 4%, transparent);
  }

  /* Postens huvudrad: sort, vad det gäller, när det kom.
     Sorten står i en kolumn med fast bredd så att kön går att skanna lodrätt.
     Det är det enda som skiljer en lista med fyra sorters ärenden från en
     lista där varje rad börjar på ett nytt ställe. */
  .granska .granska-rad {
    display: flex;
    align-items: baseline;
    gap: var(--s-2) var(--s-3);
    flex-wrap: wrap;
  }

  .granska .granska-typ {
    flex: none;
    min-width: 68px;
    font-size: var(--fs-micro);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .granska .granska-plats {
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .granska .granska-rad .konto-meta {
    margin-left: auto;
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  /* ----------------------------------------------------------------------- */
  /* Postens kropp: bilden till vänster, allt att läsa till höger             */
  /* ----------------------------------------------------------------------- */

  .granska .granska-kropp {
    margin-top: var(--s-3);
    /* Texten radbryts på granskarens ögonmått och inte på spaltens.
       Ett omdöme är brödtext och brödtext blir oläsbar över 70 tecken. */
    max-width: 74ch;
  }

  /* Bilden är uppgiften, alltså får den plats, och texten om bilden ska gå
     att läsa utan att rulla förbi den. Därför två kolumner och inte en stapel.
     Bilden ligger till vänster eftersom ögat börjar där, och beslutet står
     längst ned till höger, dit läsningen tar vägen. */
  .granska .granska-kropp[data-media='1'] {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    max-width: none;
  }

  .granska .granska-innehall > * + * { margin-top: var(--s-3); }

  /* INGEN BESKÄRNING. En beskuren bild är en bild man inte har granskat, så
     `contain` och aldrig `cover`. Takhöjden finns för att en stående bild
     annars gör raden tre skärmar hög, och då är kön inte längre en kö. */
  .granska .granska-bild {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: contain;
    object-position: left top;
    border-radius: var(--r-card);
    background: var(--canvas);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .granska .granska-text {
    font-size: var(--fs-body-s);
    line-height: var(--lh-body);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .granska .granska-fakta {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    color: var(--text-muted);
  }

  .granska .granska-fakta b { color: var(--text-secondary); font-weight: 600; }

  /* ----------------------------------------------------------------------- */
  /* Beslutet                                                                */
  /* ----------------------------------------------------------------------- */

  .granska .granska-atgard {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }

  .granska .granska-skal {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-2);
    flex-wrap: wrap;
  }

  /* Knapparna är verktygsknappar och inte sajtens piller. En piller-CTA hör
     till en sida som vill något av besökaren; den här raden är två utfall i
     ett verktyg, och de ska ligga tätt och se lika viktiga ut. */
  .granska .granska-atgard .btn-primary,
  .granska .granska-atgard .btn-quiet,
  .granska .granska-skal .btn-quiet {
    gap: var(--s-2);
    border-radius: var(--r-control);
    padding: 8px 12px;
    font-size: var(--fs-caption);
  }

  .granska .granska-atgard .btn-quiet,
  .granska .granska-skal .btn-quiet {
    border-color: var(--glass-edge);
  }

  /* Bara den post man står på har en fylld knapp.
     Fyra blå knappar rakt ner i en kö skriker lika högt allihop, och då bär
     färgen ingen information. Fylld = här är du, och det är också den enda
     rad där G och A gör något. Musen får tillbaka fyllningen vid hovring, så
     ingenting går förlorat för den som inte använder tangentbordet. */
  .granska .granska-post:not([data-vald='1']) .granska-atgard .btn-primary {
    background: transparent;
    color: var(--brand-ink);
    box-shadow: inset 0 0 0 1px var(--glass-edge);
  }

  .granska .granska-post .granska-atgard .btn-primary:hover {
    background: var(--brand-ink);
    color: #fff;
    box-shadow: none;
  }

  .granska .granska-atgard .btn-primary kbd {
    border-color: rgba(255, 255, 255, .45);
    background: transparent;
    color: #fff;
  }

  /* Genvägen står PÅ knappen, men bara på den post man faktiskt står på.
     Annars säger sidan "tryck G" på åttio rader samtidigt, och då säger den
     ingenting. `visibility` och inte `display`: knappen ska inte ändra bredd
     när markeringen flyttar. */
  .granska .granska-atgard kbd { visibility: hidden; }
  .granska .granska-post[data-vald='1'] .granska-atgard kbd { visibility: visible; }

  /* Sexton pixlar är ett golv: under det zoomar iOS Safari in hela sidan när
     fältet får fokus, och zoomar aldrig ut igen. Samma regel som arken. */
  .granska .granska-skal input,
  .granska .granska-atgard select {
    font: 400 16px/1.4 var(--font-sans);
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-control);
    padding: 7px 10px;
  }

  .granska .granska-skal input {
    flex: 1 1 260px;
    min-width: 0;
  }

  /* Rullgardinen tar bredden efter sitt längsta alternativ, och ett flexbarn
     vägrar krympa under sitt innehåll utan min-width. Utan de här två raderna
     stack raden ut ur en telefonskärm och hela sidan gick att dra i sidled.
     Mätt: 443 px i en 375 px bred vy. */
  .granska .granska-atgard select {
    min-width: 0;
    max-width: 100%;
  }

  .granska .granska-skal input:focus-visible,
  .granska .granska-atgard select:focus-visible {
    border-color: var(--brand);
    outline: 2px solid var(--brand);
    outline-offset: 0;
  }

  .granska .granska-svar {
    margin-top: var(--s-2);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .granska .granska-fel { color: var(--verdict-major-ink); }
  .granska .granska-ok { color: var(--verdict-clean-ink); }

  /* Tom kö är ett arbetsläge och inte ett fel. Den ska se ut som ett avslutat
     pass, alltså luft och en mening mitt i ytan, inte en grå rad under en
     rubrik. */
  .granska .granska-tomt {
    padding: var(--s-16) 0;
    text-align: center;
    font-size: var(--fs-h-xs);
    line-height: var(--lh-h-xs);
    color: var(--text-secondary);
  }

  /* ----------------------------------------------------------------------- */
  /* Telefon                                                                 */
  /* ----------------------------------------------------------------------- */

  @media (max-width: 860px) {
    /* Ingen tangentbordslegend på en skärm utan tangentbord. */
    .granska .granska-tangenter { display: none; }

    .granska .granska-kropp[data-media='1'] {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }

    .granska .granska-bild { max-height: 340px; }

    .granska .granska-post {
      padding-inline: calc(var(--s-3) - 3px) var(--s-3);
      margin-inline: calc(var(--s-3) * -1);
    }

    .granska .granska-typ { min-width: 0; }

    .granska .granska-rad .konto-meta { margin-left: 0; }
  }
</style>

<script>
  import {
    configured,
    signedIn,
    arAdmin,
    ko,
    bildlank,
    publiceraOmdome,
    avslaOmdome,
    publiceraBild,
    avslaBild,
    publiceraSvar,
    avslaSvar,
    publiceraAnsprak,
    avslaAnsprak,
    METODER,
    type KoPost,
    type BildPost,
    type OmdomePost,
    type SvarPost,
    type AnsprakPost,
  } from '../../lib/granska';
  import { captureLinkSession, placeNames, type PlaceName } from '../../lib/community';
  import { openSignIn } from '../../lib/signin-dialog';

  const laddar = document.getElementById('laddar') as HTMLParagraphElement;
  const nej = document.getElementById('nej') as HTMLDivElement;
  const nejText = document.getElementById('nej-text') as HTMLParagraphElement;
  const loggaIn = document.getElementById('logga-in') as HTMLButtonElement;
  const verktyg = document.getElementById('verktyg') as HTMLDivElement;
  const rakning = document.getElementById('rakning') as HTMLSpanElement;
  const global = document.getElementById('global') as HTMLParagraphElement;
  const lista = document.getElementById('ko') as HTMLOListElement;
  const tomt = document.getElementById('tomt') as HTMLParagraphElement;

  const ETIKETT: Record<string, string> = {
    omdome: 'Omdöme',
    bild: 'Bild',
    svar: 'Svar',
    ansprak: 'Anspråk',
  };

  const MANADER = [
    'januari', 'februari', 'mars', 'april', 'maj', 'juni',
    'juli', 'augusti', 'september', 'oktober', 'november', 'december',
  ];

  function datum(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso.slice(0, 10);
    return `${d.getDate()} ${MANADER[d.getMonth()]} ${d.getFullYear()}`;
  }

  function stjarnor(rating: number | null): string {
    if (!rating) return '';
    return `${'★'.repeat(rating)}${'☆'.repeat(5 - rating)}`;
  }

  /* -------------------------------------------------------------------- */
  /* Tillstånd                                                             */
  /* -------------------------------------------------------------------- */

  let poster: KoPost[] = [];
  let platser = new Map<string, PlaceName>();
  let vald = 0;
  /** Sant medan ett beslut är på väg. Hindrar dubbla tryck på samma post. */
  let arbetar = false;

  function meddela(text: string, sort: 'ok' | 'fel' | 'vanta' = 'ok'): void {
    global.hidden = !text;
    global.textContent = text;
    global.className = `notice notice-${sort === 'fel' ? 'error' : sort === 'vanta' ? 'wait' : 'ok'}`;
  }

  function platsnamn(post: KoPost): string {
    if (post.sort === 'ansprak') return (post as AnsprakPost).establishment_name;
    const p = platser.get(post.establishment_id);
    /* Ett id är inte ett namn, men det är sant. En verksamhet som avpublicerats
       sedan raden skrevs finns inte i den redaktionella vyn, och då ska posten
       fortfarande gå att granska. */
    return p?.name ?? post.establishment_id;
  }

  function lank(post: KoPost): string | null {
    const p = platser.get(post.establishment_id);
    return p ? `/${p.municipality_slug}/${p.slug}/` : null;
  }

  /* -------------------------------------------------------------------- */
  /* Målning                                                               */
  /* -------------------------------------------------------------------- */

  /**
   * En post i kön.
   *
   * Byggd med createElement och textContent, aldrig med innerHTML. Allt som
   * står här är skrivet av någon annan, och granskningen är det sista stället
   * där en text ska kunna bli kod.
   */
  function rita(post: KoPost, position: number): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'granska-post';
    li.dataset.vald = position === vald ? '1' : '0';
    li.tabIndex = -1;

    const rad = document.createElement('div');
    rad.className = 'granska-rad';

    const typ = document.createElement('span');
    typ.className = 'granska-typ';
    typ.textContent = ETIKETT[post.sort] ?? post.sort;
    rad.append(typ);

    const href = lank(post);
    const namn = document.createElement(href ? 'a' : 'span');
    namn.className = 'granska-plats';
    namn.textContent = platsnamn(post);
    if (href) {
      (namn as HTMLAnchorElement).href = href;
      (namn as HTMLAnchorElement).target = '_blank';
      (namn as HTMLAnchorElement).rel = 'noopener';
    }
    rad.append(namn);

    const nar = document.createElement('span');
    nar.className = 'konto-meta';
    nar.textContent = datum(post.created_at);
    rad.append(nar);
    li.append(rad);

    let delar: HTMLElement[] = [];
    if (post.sort === 'omdome') delar = ritaOmdome(post as OmdomePost);
    if (post.sort === 'bild') delar = ritaBild(post as BildPost);
    if (post.sort === 'svar') delar = ritaSvar(post as SvarPost);
    if (post.sort === 'ansprak') delar = ritaAnsprak(post as AnsprakPost);

    /*
     * Bilden i egen kolumn, allt att läsa i den andra.
     *
     * Delarna kommer i en platt lista från rita*-funktionerna, och det som är
     * en bild plockas ut här i stället för att varje funktion ska behöva veta
     * hur posten är byggd. Sorteringen är formens ansvar, inte innehållets.
     *
     * Att bilden ligger BREDVID texten och inte över den är hela skälet: den
     * som granskar en bild måste se bildtexten och omdömet den hör till
     * samtidigt som bilden, annars är det två uppgifter i stället för en.
     */
    const kropp = document.createElement('div');
    kropp.className = 'granska-kropp';

    const bilder = delar.filter((el) => el.classList.contains('granska-bild'));
    if (bilder.length > 0) {
      const media = document.createElement('div');
      media.className = 'granska-media';
      media.append(...bilder);
      kropp.dataset.media = '1';
      kropp.append(media);
    }

    const innehall = document.createElement('div');
    innehall.className = 'granska-innehall';
    innehall.append(...delar.filter((el) => !el.classList.contains('granska-bild')));

    const holk = ritaAtgarder(post, position);
    innehall.append(holk);
    kropp.append(innehall);
    li.append(kropp);

    /* Tangentbordets krok sitter på POSTEN och inte på ett visst barn. Den låg
       på sista elementet, och den formen är just det som ändras när sidan
       ritas om; att flytta kroken hit gör att styrningen överlever nästa
       omgång layout. */
    (li as any).__godkann = (holk as any).__godkann;
    (li as any).__avsla = (holk as any).__avsla;
    return li;
  }

  function fakta(delar: Array<[string, string]>): HTMLParagraphElement {
    const p = document.createElement('p');
    p.className = 'granska-fakta';
    delar.forEach(([etikett, varde], i) => {
      if (i > 0) p.append(document.createTextNode(' · '));
      p.append(document.createTextNode(`${etikett} `));
      const b = document.createElement('b');
      b.textContent = varde;
      p.append(b);
    });
    return p;
  }

  function ritaOmdome(post: OmdomePost): HTMLElement[] {
    const ut: HTMLElement[] = [];

    if (post.body) {
      const text = document.createElement('p');
      text.className = 'granska-text';
      text.textContent = post.body;
      ut.push(text);
    }

    const delar: Array<[string, string]> = [];
    if (post.rating) delar.push(['Betyg', `${stjarnor(post.rating)} ${post.rating} av 5`]);
    if (post.visited_month) delar.push(['Besök', post.visited_month.slice(0, 7)]);
    if (!post.body) delar.push(['Text', 'ingen, bara betyg']);
    /* Att bilderna följer med vid ett avslag är inget granskaren ska behöva
       minnas. Det står på raden, före beslutet. */
    if (post.bilder > 0)
      delar.push(['Bilder', `${post.bilder} i kön, avslås med texten`]);
    if (delar.length > 0) ut.push(fakta(delar));

    return ut;
  }

  function ritaBild(post: BildPost): HTMLElement[] {
    const ut: HTMLElement[] = [];

    const bild = document.createElement('img');
    bild.className = 'granska-bild';
    bild.alt = '';
    bild.loading = 'lazy';
    /* Länken signeras när posten målas. Den gäller en timme, vilket räcker för
       en genomgång, och hinken förblir privat. */
    void bildlank(post.storage_path)
      .then((url) => {
        bild.src = url;
      })
      .catch(() => {
        const fel = document.createElement('p');
        fel.className = 'granska-svar granska-fel';
        fel.textContent = 'Bilden gick inte att hämta. Ladda om sidan.';
        bild.replaceWith(fel);
      });
    ut.push(bild);

    if (post.caption) {
      const text = document.createElement('p');
      text.className = 'granska-text';
      text.textContent = post.caption;
      ut.push(text);
    }

    /* Omdömet bilden hör till, ordagrant. En bild utan sammanhang är det
       svåraste tänkbara granskningsärendet: texten säger om det är disken,
       skylten eller en tallrik man tittar på. */
    if (post.omdome) {
      const text = document.createElement('p');
      text.className = 'granska-text';
      const betyg = post.omdome.rating ? `${stjarnor(post.omdome.rating)} ` : '';
      text.textContent = `${betyg}${post.omdome.body ?? 'Omdömet bär bara ett betyg.'}`;
      ut.push(text);
    }

    const delar: Array<[string, string]> = [
      ['Format', post.content_type.replace('image/', '')],
      ['Storlek', `${Math.round(post.byte_size / 1024)} kB`],
    ];
    if (!post.review_id) delar.push(['Text', 'ingen, bilden är inskickad för sig']);
    if (post.omdome && post.omdome.status !== 'published')
      delar.push(['Omdömet', post.omdome.status]);
    ut.push(fakta(delar));

    return ut;
  }

  function ritaSvar(post: SvarPost): HTMLElement[] {
    const text = document.createElement('p');
    text.className = 'granska-text';
    text.textContent = post.body;

    /* Att texten publiceras ordagrant eller inte alls är löftet i sidfoten, och
       att den inte står på sajten förrän pipelinen skrivit den dit är ett steg
       granskaren måste känna till. Båda står på raden. */
    return [
      text,
      fakta([
        ['Kontroll', post.inspection_id],
        ['Publiceras', 'ordagrant, av moderate.py synka'],
      ]),
    ];
  }

  function ritaAnsprak(post: AnsprakPost): HTMLElement[] {
    const delar: Array<[string, string]> = [
      ['Sökande', post.claimant_name],
      ['Roll', post.claimant_role],
      ['E-post', post.contact_email],
    ];
    if (post.organization_number) delar.push(['Org.nr', post.organization_number]);
    if (post.contact_phone) delar.push(['Telefon', post.contact_phone]);
    return [fakta(delar)];
  }

  /**
   * Knapparna.
   *
   * Två utfall, aldrig tre. Det finns ingen "ändra"-väg: texten är frusen efter
   * insändning av en trigger i databasen, och redaktionen kan bara välja mellan
   * att publicera ordagrant och att avslå.
   */
  function ritaAtgarder(post: KoPost, position: number): HTMLDivElement {
    const holk = document.createElement('div');

    const atgard = document.createElement('div');
    atgard.className = 'granska-atgard';

    let metod: HTMLSelectElement | null = null;
    if (post.sort === 'ansprak') {
      /* Ett godkänt anspråk måste bära hur det kontrollerades. Databasen fäller
         raden annars, så valet står före knappen och inte i en ruta efteråt. */
      metod = document.createElement('select');
      metod.setAttribute('aria-label', 'Hur anspråket kontrollerades');
      for (const m of METODER) {
        const val = document.createElement('option');
        val.value = m.varde;
        val.textContent = m.text;
        metod.append(val);
      }
      atgard.append(metod);
    }

    /* Genvägen står på knappen, som en tangent.
       En rad text längst ned på sidan som räknar upp fem bokstäver är en
       fotnot man läser en gång och glömmer; bokstaven på själva knappen är
       kvar nästa gång man tittar. CSS visar den bara på den post man står på,
       se stilblocket ovan. */
    const tangent = (bokstav: string) => {
      const k = document.createElement('kbd');
      k.textContent = bokstav;
      return k;
    };

    const godkann = document.createElement('button');
    godkann.type = 'button';
    godkann.className = 'btn-primary btn-tight';
    godkann.append('Godkänn', tangent('G'));
    godkann.addEventListener('click', () => {
      vald = position;
      void besluta(post, 'publish', metod?.value ?? null, null);
    });
    atgard.append(godkann);

    const avsla = document.createElement('button');
    avsla.type = 'button';
    avsla.className = 'btn-quiet btn-tight';
    avsla.append('Avslå', tangent('A'));
    atgard.append(avsla);
    holk.append(atgard);

    /* Skälet. Ett avslag utan skäl finns inte: databasen kräver det, och skälet
       är det enda den som skickade in kan göra något åt. */
    const skalrad = document.createElement('div');
    skalrad.className = 'granska-skal';
    skalrad.hidden = true;

    const falt = document.createElement('input');
    falt.type = 'text';
    falt.maxLength = 300;
    falt.placeholder = 'Skäl, visas för avsändaren';
    falt.setAttribute('aria-label', 'Skäl för avslag');
    skalrad.append(falt);

    const bekrafta = document.createElement('button');
    bekrafta.type = 'button';
    bekrafta.className = 'btn-quiet btn-tight';
    bekrafta.textContent = 'Avslå';
    skalrad.append(bekrafta);
    holk.append(skalrad);

    const oppna = () => {
      vald = position;
      skalrad.hidden = false;
      /* preventScroll: sidan ska inte hoppa när fältet fälls ut. */
      falt.focus({ preventScroll: true });
    };
    avsla.addEventListener('click', oppna);

    const skicka = () => {
      const skal = falt.value.trim();
      if (!skal) {
        falt.focus({ preventScroll: true });
        return;
      }
      void besluta(post, 'reject', null, skal);
    };
    bekrafta.addEventListener('click', skicka);
    falt.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        skicka();
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        skalrad.hidden = true;
        falt.value = '';
        (document.activeElement as HTMLElement)?.blur();
      }
    });

    /* Kroken som tangentbordet använder. Att lägga den på elementet i stället
       för att leta upp knappen med en selektor gör att formen på raden kan
       ändras utan att styrningen går sönder. */
    (holk as any).__godkann = () => godkann.click();
    (holk as any).__avsla = () => oppna();
    return holk;
  }

  function mala(): void {
    lista.textContent = '';
    if (vald >= poster.length) vald = Math.max(0, poster.length - 1);

    poster.forEach((post, i) => lista.append(rita(post, i)));

    tomt.hidden = poster.length > 0;
    rakning.textContent = poster.length === 0 ? 'inget väntar' : `${poster.length} väntar`;
  }

  /**
   * Flyttar bara markeringen.
   *
   * Att rita om hela kön för att byta vilken rad som är markerad kostade en
   * ny signerad länk för VARJE bild i kön vid varje tryck på J. Med en kö på
   * hundra poster är det hundra anrop per tangenttryckning, och bilderna
   * blinkade bort och kom tillbaka medan man bläddrade. Markeringen är ett
   * attribut, alltså byts attributet.
   */
  function markera(): void {
    for (let i = 0; i < lista.children.length; i += 1) {
      (lista.children[i] as HTMLElement).dataset.vald = i === vald ? '1' : '0';
    }
  }

  function flytta(steg: number): void {
    if (poster.length === 0) return;
    vald = Math.min(poster.length - 1, Math.max(0, vald + steg));
    markera();
    const li = lista.children[vald] as HTMLElement | undefined;
    /* `center` och inte `nearest`: den klistrade huvudraden ligger över kön,
       och en rad som rullas till kanten hamnar under den. */
    li?.scrollIntoView({ block: 'center' });
  }

  /* -------------------------------------------------------------------- */
  /* Beslut                                                                */
  /* -------------------------------------------------------------------- */

  async function besluta(
    post: KoPost,
    beslut: 'publish' | 'reject',
    metod: string | null,
    skal: string | null,
  ): Promise<void> {
    if (arbetar) return;
    arbetar = true;
    meddela(beslut === 'publish' ? 'Publicerar …' : 'Avslår …', 'vanta');

    try {
      let kvar: string[] = [];

      if (post.sort === 'omdome') {
        if (beslut === 'publish') await publiceraOmdome(post.id);
        else kvar = await avslaOmdome(post.id, skal!);
      } else if (post.sort === 'bild') {
        if (beslut === 'publish') await publiceraBild(post as BildPost);
        else kvar = await avslaBild(post.id, skal!);
      } else if (post.sort === 'svar') {
        if (beslut === 'publish') await publiceraSvar(post.id);
        else await avslaSvar(post.id, skal!);
      } else {
        if (beslut === 'publish') await publiceraAnsprak(post.id, metod ?? 'register_check');
        else await avslaAnsprak(post.id, skal!);
      }

      poster = poster.filter((p) => !(p.id === post.id && p.sort === post.sort));
      /* Ett avslaget omdöme tar sina väntande bilder med sig. De försvinner ur
         databasen som kö och ska försvinna ur listan i samma stund, annars
         klickar granskaren på en post som redan är avgjord. */
      if (post.sort === 'omdome' && beslut === 'reject') {
        poster = poster.filter((p) => !(p.sort === 'bild' && (p as BildPost).review_id === post.id));
      }
      mala();

      if (kvar.length > 0) {
        meddela(
          `Beslutet är skrivet, men ${kvar.length} fil(er) blev kvar i lagringen. ` +
            `Ta bort dem för hand: ${kvar.join(', ')}`,
          'vanta',
        );
      } else if (post.sort === 'svar' && beslut === 'publish') {
        meddela(
          'Svaret är godkänt. Texten står på sajten först efter ' +
            'python3 pipeline/moderate.py synka och ett nytt bygge.',
          'ok',
        );
      } else {
        meddela(beslut === 'publish' ? 'Publicerat.' : 'Avslaget.', 'ok');
      }
    } catch (err) {
      meddela(err instanceof Error ? err.message : 'Något gick fel.', 'fel');
    } finally {
      arbetar = false;
    }
  }

  /* -------------------------------------------------------------------- */
  /* Tangentbord                                                           */
  /* -------------------------------------------------------------------- */

  function tangent(e: KeyboardEvent): void {
    const i = document.activeElement;
    const skriver =
      i instanceof HTMLInputElement ||
      i instanceof HTMLTextAreaElement ||
      i instanceof HTMLSelectElement;
    if (skriver) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    const key = e.key.toLowerCase();
    if (key === 'j' || e.key === 'ArrowDown') {
      e.preventDefault();
      flytta(1);
      return;
    }
    if (key === 'k' || e.key === 'ArrowUp') {
      e.preventDefault();
      flytta(-1);
      return;
    }
    if (key === 'r') {
      e.preventDefault();
      void hamta();
      return;
    }

    const li = lista.children[vald] as any;
    if (!li) return;

    if (key === 'g' || e.key === 'Enter') {
      e.preventDefault();
      li.__godkann?.();
    }
    if (key === 'a') {
      e.preventDefault();
      li.__avsla?.();
    }
  }

  /* -------------------------------------------------------------------- */
  /* Start                                                                 */
  /* -------------------------------------------------------------------- */

  async function hamta(): Promise<void> {
    meddela('');
    try {
      poster = await ko();
    } catch (err) {
      laddar.hidden = true;
      verktyg.hidden = false;
      meddela(err instanceof Error ? err.message : 'Kön kunde inte hämtas.', 'fel');
      return;
    }

    /* Namnen hämtas ur den redaktionella databasen, som vem som helst får läsa.
       Kötabellerna bär bara ett id, och ska bara bära ett id: det finns ingen
       främmande nyckel mellan de två scheman och ska inte finnas någon. */
    try {
      platser = await placeNames(poster.map((p) => p.establishment_id));
    } catch {
      /* Namnen är en förbättring, inte kön. Utan dem står id:t kvar. */
    }

    laddar.hidden = true;
    verktyg.hidden = false;
    mala();
  }

  async function start(): Promise<void> {
    if (!configured) {
      laddar.hidden = true;
      nej.hidden = false;
      nejText.textContent = 'Inloggningen är inte konfigurerad i det här bygget.';
      loggaIn.hidden = true;
      return;
    }

    captureLinkSession();

    const visaNej = (text: string, knapp: boolean) => {
      laddar.hidden = true;
      verktyg.hidden = true;
      nej.hidden = false;
      nejText.textContent = text;
      loggaIn.hidden = !knapp;
    };

    if (!(await signedIn())) {
      visaNej('Logga in för att granska.', true);
      loggaIn.addEventListener('click', async () => {
        if (await openSignIn(loggaIn)) void start();
      });
      return;
    }

    /* Frågan ställs till databasen, aldrig till klienten. Svaret avgör bara vad
       sidan visar; det som avgör vad som kan skrivas är radsäkerheten. */
    if (!(await arAdmin())) {
      visaNej(
        'Den här sidan är redaktionens. Ditt konto har inte behörighet att granska.',
        false,
      );
      return;
    }

    nej.hidden = true;
    document.addEventListener('keydown', tangent);
    await hamta();
  }

  void start();
</script>
