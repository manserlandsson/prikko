---
/**
 * Verksamhetens sida: anspråk, uppgifter och svar på kontroll.
 *
 * ---------------------------------------------------------------------------
 * DET SVÅRA: ATT NÅGON FÖRETRÄDER VERKSAMHETEN
 * ---------------------------------------------------------------------------
 * Detta är den enda delen av bygget som inte går att lösa med kod. Ingen
 * teknisk konstruktion kan avgöra om personen bakom en e-postadress verkligen
 * är den som driver Pizzeria Napoli på Storgatan.
 *
 * Vägarna, och varför den byggda är den byggda:
 *
 *   Manuell registerkontroll  Redaktionen slår upp firmatecknare eller
 *     verklig huvudman i Bolagsverkets näringslivsregister och jämför med det
 *     den sökande uppgett. Kostar ingenting, kräver inget avtal, och prövar
 *     den enda fråga som betyder något: står den här personen skriven på det
 *     här bolaget. BYGGT.
 *   Brev med engångskod till adressen  Verksamhetsställets adress är den enda
 *     kontaktväg vi har till företaget; vi lagrar varken telefon, e-post
 *     eller webbplats. Därför är brev den enda kanal som går att automatisera.
 *     BYGGT, utom själva postningen: koden skapas med
 *     pipeline/verifieringsbrev.py och löses in i rutan nedan. Brevet postas
 *     för hand tills någon tecknat konto hos en brevtjänst. Ekopost tar
 *     15,60 kr ex moms per brev och har inget bindande avtal.
 *   E-post på verksamhetens egen domän  Går inte. Vi lagrar inga webbplatser,
 *     så det finns inget att jämföra en avsändardomän mot.
 *   BankID mot Bolagsverkets firmatecknare  Starkast. Kräver avtal med en
 *     förmedlare och kostar per inloggning. Rätt slutmål, fel investering nu.
 *
 * Att Google skickade vykod var sant förr. I dag väljer Google metod åt
 * företaget och rekommenderar videoverifiering: filma adressen, den
 * permanenta skylten, och något bara personalen kommer åt. Det tredje ledet
 * är det intressanta, och det är gratis att härma. Se docs/21.
 *
 * VAD SOM INTE ÄR VERIFIERAT: allt den sökande skriver i formuläret. Namn,
 * roll och organisationsnummer är påståenden. Vad redaktionen kontrollerar är
 * att de påståendena stämmer mot ett offentligt register. Det är inte samma
 * sak som att personen har fullmakt, och det ska sägas rakt ut.
 *
 * ---------------------------------------------------------------------------
 * VAD FÖRETAGET FÅR OCH INTE FÅR
 * ---------------------------------------------------------------------------
 * Får: fylla på med uppgifter om sig självt, och svara på en kontroll.
 *
 * Får inte: röra bedömningen, kontrollhistoriken eller utmärkelsen. Det finns
 * ingen väg härifrån till dem, och det är inte en artighet utan hela skälet
 * att sajten går att lita på. Enda sättet att kommentera en kontroll är ett
 * svar, det publiceras ordagrant, och det går genom moderering.
 *
 * Får inte heller: lägga bilder i besökarnas omdömesflöde. community.
 * image_uploads hör till besökaren och stänger uttryckligen ute den som har
 * ett godkänt anspråk. Bildrutan som stod här togs bort när den regeln kom.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/konto.css';

/* Veckans dagar renderas i mallen och inte av skriptet.
   Stilarna i den här filen är scoped, och Astro märker bara upp det som fanns
   i mallen när sidan byggdes. Rader som skriptet skapar i webbläsaren får
   ingen märkning och därmed ingen stil. */
const DAGAR = [
  ['mon', 'Måndag'],
  ['tue', 'Tisdag'],
  ['wed', 'Onsdag'],
  ['thu', 'Torsdag'],
  ['fri', 'Fredag'],
  ['sat', 'Lördag'],
  ['sun', 'Söndag'],
] as const;
---

<Base
  title="Din verksamhet"
  description="Fyll på med uppgifter om verksamheten och svara på en kontroll."
  noindex
>
  <div class="container konto-page konto-wide">
    <div class="konto-card">
      <h1 id="title">Din verksamhet</h1>
      <p class="konto-lead" id="lead">Läser in.</p>
      <p class="notice notice-error" id="error" hidden role="alert"></p>
      <div class="konto-actions" id="signin-row" hidden>
        <button type="button" class="btn-primary" id="signin">Logga in eller bli medlem</button>
      </div>
    </div>

    {/* Ansökan om att företräda verksamheten. */}
    <div class="konto-card" id="claim-card" hidden>
      <h2>Ansök om att företräda verksamheten</h2>
      <p class="konto-lead">
        Vi kontrollerar uppgifterna mot Bolagsverket innan du får svara. Det
        görs för hand och kan ta någon dag. Uppgifterna nedan publiceras aldrig.
      </p>

      <form id="claim-form" novalidate>
        <label class="field">
          <span>Ditt namn</span>
          <input type="text" name="claimantName" maxlength="100" required autocomplete="name" />
        </label>

        {/* Fritext förr. Ett fast val säger redaktionen exakt vad den ska
            slå upp, och "ägare" och "firmatecknare" är inte samma sak i
            registret. */}
        <label class="field">
          <span>Din roll i verksamheten</span>
          <select name="claimantRole" required>
            <option value="">Välj roll</option>
            <option value="Firmatecknare">Firmatecknare</option>
            <option value="Verkställande direktör">Verkställande direktör</option>
            <option value="Styrelseledamot">Styrelseledamot</option>
            <option value="Ägare">Ägare</option>
            <option value="Restaurangchef">Restaurangchef</option>
            <option value="Ombud med fullmakt">Ombud med fullmakt</option>
          </select>
        </label>

        <label class="field">
          <span>
            Organisationsnummer
            <span class="hint">
              Verksamhetens, inte ditt personnummer. Används bara för
              kontrollen och publiceras aldrig.
            </span>
          </span>
          <input
            type="text"
            name="organizationNumber"
            maxlength="13"
            required
            inputmode="numeric"
            placeholder="556677-8899"
          />
        </label>

        <label class="field">
          <span>E-post vi kan nå dig på</span>
          <input type="email" name="contactEmail" required autocomplete="email" />
        </label>

        <label class="field">
          <span>Telefon <span class="hint">Frivilligt. Snabbare om något behöver redas ut.</span></span>
          <input type="tel" name="contactPhone" maxlength="30" autocomplete="tel" />
        </label>

        <p class="notice notice-error" id="claim-error" hidden role="alert"></p>

        <div class="konto-actions">
          <button type="submit" class="btn-primary" id="claim-submit">Skicka ansökan</button>
        </div>

        <p class="konto-legal">
          Att ansöka ger ingen rätt att svara. Rätten uppstår först när
          redaktionen kontrollerat att du företräder verksamheten. Lämnar du
          medvetet oriktiga uppgifter stängs kontot av.
        </p>
      </form>
    </div>

    {/* Kod ur brevet till verksamhetens adress. */}
    <div class="konto-card" id="code-card" hidden>
      <h2>Har du fått en kod på posten?</h2>
      <form id="code-form" novalidate>
        <label class="field">
          <span>Koden i brevet</span>
          <input
            type="text"
            name="code"
            id="code"
            maxlength="8"
            required
            autocomplete="one-time-code"
            spellcheck="false"
          />
        </label>

        <p class="notice notice-error" id="code-error" hidden role="alert"></p>

        <div class="konto-actions">
          <button type="submit" class="btn-primary" id="code-submit">Lös in koden</button>
        </div>
      </form>
    </div>

    {/* Uppgifter om verksamheten. */}
    <div class="konto-card" id="facts-card" hidden>
      <h2>Uppgifter om verksamheten</h2>
      <p class="konto-lead">
        Granskas innan de visas. Skicka in på nytt när något ändras, så gäller
        det du skickade senast.
      </p>

      <form id="facts-form" novalidate>
        <label class="field">
          <span>
            Presentation
            <span class="hint" id="presentation-hint">Minst 20 tecken.</span>
          </span>
          <textarea name="presentation" id="presentation" maxlength="1500"></textarea>
        </label>

        <fieldset class="hours">
          <legend>Öppettider</legend>
          {
            DAGAR.map(([day, name]) => (
              <div class="hour-row">
                <span class="day">{name}</span>
                <div class="hour-times">
                  <input type="time" id={`from-${day}`} aria-label={`${name}, öppnar`} />
                  <span>till</span>
                  <input type="time" id={`to-${day}`} aria-label={`${name}, stänger`} />
                </div>
                <label class="hour-shut">
                  <input type="checkbox" id={`shut-${day}`} />
                  <span>Stängt</span>
                </label>
              </div>
            ))
          }

          {/* Avvikande datum: röda dagar, inventering, semesterstängt.

              Vi räknar inte fram röda dagar åt någon. Vilka dagar som är röda
              går att slå upp, men vad ETT ställe gör en röd dag gör det inte,
              och en gissning här hade blivit ett påstående på verksamhetens
              sida som ingen på verksamheten skrivit. */}
          <div class="avvikande">
            <p class="avvikande-rubrik">Avvikande datum</p>
            <ul class="undantag" id="exceptions"></ul>
            <button type="button" class="btn-quiet btn-tight" id="add-exception">
              Lägg till datum
            </button>
          </div>
        </fieldset>

        {/* Raderna klonas härifrån och inte ur skriptet.

            Stilarna i den här filen är scoped, och Astro märker bara upp det
            som stod i mallen när sidan byggdes. Ett element som skriptet
            skapar från grunden får ingen märkning och därmed ingen stil. Det
            som ligger i en <template> stod i mallen, alltså bär kopian
            märkningen med sig. */}
        <template id="exception-template">
          <li class="undantag-rad">
            <input type="date" class="ex-date" aria-label="Datum" required />
            <input
              type="text"
              class="ex-label"
              maxlength="40"
              placeholder="Namn på dagen"
              aria-label="Namn på dagen"
            />
            <div class="hour-times">
              <input type="time" class="ex-from" aria-label="Öppnar" />
              <span>till</span>
              <input type="time" class="ex-to" aria-label="Stänger" />
            </div>
            <label class="hour-shut">
              <input type="checkbox" class="ex-shut" />
              <span>Stängt</span>
            </label>
            <button type="button" class="btn-quiet btn-tight ex-remove">Ta bort</button>
          </li>
        </template>

        <label class="field">
          <span>Telefon</span>
          <input type="tel" name="phone" maxlength="30" autocomplete="tel" />
        </label>

        <label class="field">
          <span>Webbplats</span>
          <input type="url" name="website" maxlength="200" placeholder="https://" />
        </label>

        <label class="field">
          <span>Boka bord <span class="hint">Länk till er bokning.</span></span>
          <input type="url" name="bookingUrl" maxlength="200" placeholder="https://" />
        </label>

        <p class="notice notice-error" id="facts-error" hidden role="alert"></p>

        <div class="konto-actions">
          <button type="submit" class="btn-primary" id="facts-submit">Skicka in</button>
        </div>

        <p class="konto-legal">
          Uppgifterna fryses när du skickar dem. Redaktionen kan publicera dem
          eller låta bli, aldrig ändra i dem. Du ansvarar för att de stämmer.
        </p>
      </form>

      <h3 class="sub">Dina insändningar</h3>
      <ul class="konto-list" id="submissions"></ul>
      <p class="konto-empty" id="submissions-empty">Du har inte skickat in några uppgifter än.</p>
    </div>

    {/* Verksamhetens egna bilder.

        Egen ruta och inte en del av uppgifterna ovanför: en bild är en fil som
        laddas upp en i taget och lever sitt eget liv, medan uppgifterna är ett
        formulär som skickas in i sin helhet.

        Det här är INTE besökarnas bildflöde. Den som har ett godkänt anspråk
        är uttryckligen utestängd därifrån, och den spärren står kvar. Se
        Foretagsbilder.astro. */}
    <div class="konto-card" id="photos-card" hidden>
      <h2>Bilder</h2>
      <p class="konto-lead">
        Granskas innan de visas. Den översta bilden står först på sidan.
      </p>

      <form id="photo-form" novalidate>
        <label class="field">
          <span>
            Bild
            <span class="hint" id="photo-hint">JPEG, PNG, WebP eller HEIC. Högst 12 MB.</span>
          </span>
          {/* HEIC och HEIF står med, och ändelserna står med UTÖVER typerna.
              Flera webbläsare lämnar `file.type` tom för HEIC, eftersom
              formatet inte står i deras egen tabell, och filväljaren matchar
              då på det den känner igen. Utan `.heic` i listan är iPhone-bilden
              gråmarkerad i rutan och går inte att välja alls. Samma lista som
              besökarnas uppladdning, se Reviews.astro. */}
          <input
            type="file"
            id="photo-file"
            accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.heic,.heif"
          />
        </label>

        <label class="field">
          <span>Bildtext <span class="hint">Frivilligt. Högst 120 tecken.</span></span>
          <input type="text" id="photo-caption" maxlength="120" />
        </label>

        <label class="samtycke">
          <input type="checkbox" id="photo-rights" />
          <span>Bilden är vår egen, eller så har vi fotografens tillstånd att publicera den.</span>
        </label>

        <p class="notice notice-error" id="photo-error" hidden role="alert"></p>

        <div class="konto-actions">
          <button type="submit" class="btn-primary" id="photo-submit">Ladda upp</button>
        </div>
      </form>

      <h3 class="sub">Era bilder</h3>
      <ul class="konto-list" id="photo-list"></ul>
      <p class="konto-empty" id="photo-empty">Ni har inte lagt upp någon bild än.</p>
    </div>

    {/* Svar på en kontroll. */}
    <div class="konto-card" id="respond-card" hidden>
      <h2>Svara på en kontroll</h2>
      <p class="konto-lead">
        Ditt svar publiceras <b>ordagrant</b> bredvid kontrollen. Redaktionen
        kan publicera det eller låta bli, aldrig ändra i det.
      </p>

      <form id="respond-form" novalidate>
        <label class="field">
          <span>Vilken kontroll gäller svaret?</span>
          <select name="inspection" id="inspection" required></select>
        </label>

        <label class="field">
          <span>
            Ditt svar
            <span class="hint">
              Minst tio tecken, högst 2 000. Skriv om kontrollen och vad ni
              gjort. Namnge inte enskilda inspektörer eller anställda.
            </span>
          </span>
          <textarea name="body" maxlength="2000" required></textarea>
        </label>

        <p class="notice notice-error" id="respond-error" hidden role="alert"></p>

        <div class="konto-actions">
          <button type="submit" class="btn-primary" id="respond-submit">Skicka svar</button>
        </div>

        <p class="konto-legal">
          Texten fryses när du skickar den. Varken vi eller du kan ändra den i
          efterhand, och det är själva poängen: det är så vi kan lova att svar
          publiceras oredigerade. Vill du säga något annat får det gamla svaret
          tas bort först. Skriv till
          <a href="/ratta/">redaktionen</a> om det behövs.
        </p>
      </form>

      <h3 class="sub">Dina svar</h3>
      <ul class="konto-list" id="responses"></ul>
      <p class="konto-empty" id="responses-empty">Du har inte skickat något svar än.</p>
    </div>
  </div>

</Base>

<style>
  .sub {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-body);
  }

  /* Öppettiderna är sju likadana rader. Ett rutnät håller klockslagen i
     linje utan att varje rad behöver en egen etikett att läsa. */
  .hours {
    margin-top: var(--s-4);
    padding: 0;
    border: 0;
  }

  .hours legend {
    padding: 0;
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .hour-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) 0;
  }

  .hour-row + .hour-row {
    border-top: 1px solid var(--hairline);
  }

  .hour-row .day {
    font-size: var(--fs-small);
  }

  .hour-times {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .hour-times input {
    width: 100%;
    max-width: 7rem;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    background: var(--card);
    color: inherit;
    font: inherit;
    font-size: var(--fs-small);
  }

  .hour-times input:disabled {
    opacity: 0.4;
  }

  .hour-shut {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-small);
    white-space: nowrap;
  }

  /* Avvikande datum ligger under veckoschemat och skiljs av luft, inte av en
     ram. Det är samma uppgift sedd på ett annat sätt, inte ett nytt avsnitt. */
  .avvikande {
    margin-top: var(--s-5);
  }

  .avvikande-rubrik {
    margin-bottom: var(--s-2);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }

  .undantag {
    list-style: none;
    margin: 0 0 var(--s-2);
    padding: 0;
  }

  .undantag-rad {
    display: grid;
    grid-template-columns: auto minmax(6rem, 1fr) auto auto auto;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    padding: var(--s-2) 0;
  }

  .undantag-rad + .undantag-rad {
    border-top: 1px solid var(--hairline);
  }

  .undantag-rad input[type='date'],
  .undantag-rad input[type='text'] {
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--hairline);
    border-radius: var(--r-control);
    background: var(--card);
    color: inherit;
    font: inherit;
    font-size: var(--fs-small);
    min-width: 0;
  }

  /* Samtyckesrutan står som en rad och inte som ett fält: kryssrutan och
     texten hör ihop och ska ligga bredvid varandra. */
  .samtycke {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
    margin-top: var(--s-4);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .samtycke input {
    margin-top: 2px;
    flex: none;
  }

  /* Miniatyren i listan över egna bilder. Så liten att en rad fortfarande är
     en rad, och stor nog att man ser vilken bild det gäller. */
  .bild-mini {
    width: 56px;
    height: 42px;
    flex: none;
    object-fit: cover;
    border-radius: var(--r-control);
    background: var(--canvas);
  }

  /* Smal skärm: de fem kolumnerna i en avvikande rad får inte plats. Datum och
     namn delar första raden, klockslagen och "Stängt" den andra, och
     borttagningen den tredje. */
  @media (max-width: 620px) {
    .undantag-rad {
      grid-template-columns: 1fr auto;
    }

    .undantag-rad .ex-date { grid-column: 1; }
    .undantag-rad .ex-label { grid-column: 1 / -1; }
    .undantag-rad .hour-times { grid-column: 1; }
    .undantag-rad .hour-shut { grid-column: 2; }
    .undantag-rad .ex-remove { grid-column: 1 / -1; justify-self: start; }
  }

  /* Smal skärm: dagen och "Stängt" delar första raden, klockslagen får hela
     den andra. Utan den uttryckliga placeringen hamnar "Stängt" på en tredje
     rad, eftersom klockslagen spänner över båda spalterna och trycker ner
     allt som kommer efter. Sju dagar gånger en rad för mycket är en halv
     skärm. */
  @media (max-width: 520px) {
    .hour-row {
      grid-template-columns: 1fr auto;
    }

    .hour-row .day {
      grid-column: 1;
      grid-row: 1;
    }

    .hour-shut {
      grid-column: 2;
      grid-row: 1;
    }

    .hour-times {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

<script>
  import {
    configured,
    signedIn,
    claimFor,
    submitClaim,
    inspectionsFor,
    ownerResponses,
    submitOwnerResponse,
    CommunityError,
  } from '../../lib/community';
  import {
    DAGAR,
    angraInsandning,
    egnaBilder,
    insandningar,
    laddaUppBild,
    losInKod,
    nivaFor,
    skickaUppgifter,
    taBortBild,
    tierFor,
    type Avvikelser,
    type Dag,
    type Foretagsbild,
    type Insandning,
    type Niva,
    type Oppettider,
  } from '../../lib/foretag';
  import { openSignIn } from '../../lib/signin-dialog';

  const title = document.getElementById('title') as HTMLHeadingElement;
  const lead = document.getElementById('lead') as HTMLParagraphElement;
  const error = document.getElementById('error') as HTMLParagraphElement;

  const claimCard = document.getElementById('claim-card') as HTMLDivElement;
  const claimForm = document.getElementById('claim-form') as HTMLFormElement;
  const claimError = document.getElementById('claim-error') as HTMLParagraphElement;
  const claimSubmit = document.getElementById('claim-submit') as HTMLButtonElement;

  const codeCard = document.getElementById('code-card') as HTMLDivElement;
  const codeForm = document.getElementById('code-form') as HTMLFormElement;
  const codeError = document.getElementById('code-error') as HTMLParagraphElement;
  const codeSubmit = document.getElementById('code-submit') as HTMLButtonElement;

  const factsCard = document.getElementById('facts-card') as HTMLDivElement;
  const factsForm = document.getElementById('facts-form') as HTMLFormElement;
  const factsError = document.getElementById('facts-error') as HTMLParagraphElement;
  const factsSubmit = document.getElementById('facts-submit') as HTMLButtonElement;
  const presentation = document.getElementById('presentation') as HTMLTextAreaElement;
  const presentationHint = document.getElementById('presentation-hint') as HTMLSpanElement;
  const submissionList = document.getElementById('submissions') as HTMLUListElement;
  const submissionEmpty = document.getElementById('submissions-empty') as HTMLParagraphElement;

  const exceptionList = document.getElementById('exceptions') as HTMLUListElement;
  const exceptionTemplate = document.getElementById('exception-template') as HTMLTemplateElement;
  const addException = document.getElementById('add-exception') as HTMLButtonElement;

  const photosCard = document.getElementById('photos-card') as HTMLDivElement;
  const photoForm = document.getElementById('photo-form') as HTMLFormElement;
  const photoError = document.getElementById('photo-error') as HTMLParagraphElement;
  const photoSubmit = document.getElementById('photo-submit') as HTMLButtonElement;
  const photoFile = document.getElementById('photo-file') as HTMLInputElement;
  const photoCaption = document.getElementById('photo-caption') as HTMLInputElement;
  const photoRights = document.getElementById('photo-rights') as HTMLInputElement;
  const photoHint = document.getElementById('photo-hint') as HTMLSpanElement;
  const photoList = document.getElementById('photo-list') as HTMLUListElement;
  const photoEmpty = document.getElementById('photo-empty') as HTMLParagraphElement;

  const respondCard = document.getElementById('respond-card') as HTMLDivElement;
  const respondForm = document.getElementById('respond-form') as HTMLFormElement;
  const respondError = document.getElementById('respond-error') as HTMLParagraphElement;
  const respondSubmit = document.getElementById('respond-submit') as HTMLButtonElement;
  const inspectionSelect = document.getElementById('inspection') as HTMLSelectElement;
  const responseList = document.getElementById('responses') as HTMLUListElement;
  const responseEmpty = document.getElementById('responses-empty') as HTMLParagraphElement;

  /* Samma etiketter som på kontosidan, och böjda efter vad de sitter på. */
  const RESPONSE_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Publicerat',
    rejected: 'Avslaget',
  };

  const FACTS_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Visas',
    rejected: 'Avslagen',
  };

  const PHOTO_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Visas',
    rejected: 'Avslagen',
  };

  const dates = new Intl.DateTimeFormat('sv-SE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  const ASSESSMENT: Record<number, string> = {
    0: 'inga anmärkningar',
    1: 'mindre anmärkningar',
    2: 'allvarliga anmärkningar',
  };

  function show(message: string) {
    error.innerHTML = `<b>Fel.</b> ${message}`;
    error.hidden = false;
  }

  function say(box: HTMLParagraphElement, message: string) {
    box.innerHTML = `<b>Fel.</b> ${message}`;
    box.hidden = false;
  }

  function tag(status: string, labels: Record<string, string>): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = `status-tag status-${status}`;
    span.textContent = labels[status] ?? status;
    return span;
  }

  /** Radens vänsterdel, samma form som listorna på kontosidan. */
  function row(title: string, quote: boolean, reason?: string | null): HTMLElement {
    const box = document.createElement('div');
    box.className = 'konto-main';

    const text = document.createElement(quote ? 'p' : 'b');
    if (quote) text.className = 'konto-quote';
    text.textContent = title;
    box.append(text);

    if (reason) {
      const why = document.createElement('span');
      why.className = 'konto-why';
      why.textContent = `Skäl: ${reason}`;
      box.append(why);
    }
    return box;
  }

  function side(...nodes: Node[]): HTMLElement {
    const box = document.createElement('div');
    box.className = 'konto-side';
    box.append(...nodes);
    return box;
  }

  /**
   * Kontrollsiffran i ett svenskt organisationsnummer.
   *
   * Samma Luhn-summa som personnummer. Fångar felskrivningar och de flesta
   * påhittade nummer innan de når granskningskön, vilket är hela vinsten: ett
   * nummer som inte kan finnas ska inte kosta en människa en uppslagning.
   * Att numret finns betyder inte att den sökande har med det att göra.
   */
  function orgNumberValid(input: string): boolean {
    const digits = input.replace(/\D/g, '');
    const ten = digits.length === 12 ? digits.slice(2) : digits;
    if (ten.length !== 10) return false;

    let sum = 0;
    for (let i = 0; i < 10; i += 1) {
      let n = Number(ten[i]) * (i % 2 === 0 ? 2 : 1);
      if (n > 9) n -= 9;
      sum += n;
    }
    return sum % 10 === 0;
  }

  async function start() {
    if (!configured) {
      lead.textContent = 'Funktionen är inte konfigurerad på den här installationen.';
      return;
    }

    // Verksamheten kommer med i adressen från knappen på verksamhetssidan.
    const query = new URLSearchParams(location.search);
    const place = {
      id: query.get('id') ?? '',
      name: query.get('namn') ?? '',
      municipalitySlug: query.get('kommun') ?? '',
    };

    if (!/^F-\d{4}-.+$/.test(place.id)) {
      lead.textContent =
        'Öppna den här sidan från verksamhetens egen sida, via länken "Driver du verksamheten?".';
      return;
    }

    // Utloggad: en knapp, aldrig en ruta som öppnar sig själv.
    if (!(await signedIn())) {
      const signinRow = document.getElementById('signin-row') as HTMLDivElement;
      const button = document.getElementById('signin') as HTMLButtonElement;
      lead.textContent = place.name
        ? `Logga in för att svara för ${place.name}.`
        : 'Logga in för att fortsätta.';
      signinRow.hidden = false;
      button.addEventListener('click', async () => {
        if (!(await openSignIn(button))) return;
        signinRow.hidden = true;
        await load(place);
      });
      return;
    }

    await load(place);
  }

  async function load(place: { id: string; name: string; municipalitySlug: string }) {
    if (place.name) title.textContent = place.name;
    const link = place.municipalitySlug
      ? ` <a href="/${place.municipalitySlug}/">Till ${place.municipalitySlug}</a>.`
      : '';

    let claim = null;
    try {
      claim = await claimFor(place.id);
    } catch (err) {
      show(err instanceof CommunityError ? err.message : 'Kunde inte läsa ditt anspråk.');
      return;
    }

    if (!claim) {
      lead.innerHTML =
        'Du företräder inte den här verksamheten hos oss än. Ansök nedan.' + link;
      claimCard.hidden = false;
      wireClaim(place);
      return;
    }

    if (claim.status === 'pending') {
      lead.innerHTML =
        '<b>Väntar.</b> Din ansökan är inskickad och granskas för hand. Du får ' +
        'besked på den e-postadress du angav.';
      /* Har ett brev gått till adressen är koden den snabbare vägen, och den
         som löser in den behöver inte vänta på redaktionen alls. */
      codeCard.hidden = false;
      wireCode(place);
      return;
    }

    if (claim.status === 'rejected') {
      lead.innerHTML =
        '<b>Avslaget.</b> ' +
        (claim.rejection_reason ?? 'Ansökan godkändes inte.') +
        ' Hör av dig till <a href="/ratta/">redaktionen</a> om det är fel.';
      return;
    }

    lead.textContent = 'Du är godkänd som företrädare för den här verksamheten.';

    /* Nivån läses EN gång och skickas vidare. Vad en nivå får göra står i
       NIVAER i lib/foretag.ts och ingen annanstans: den dag en gräns ska bli
       en betalgräns flyttas den där, inte i varje ruta på den här sidan. */
    let niva = nivaFor('gratis');
    try {
      niva = nivaFor(await tierFor(place.id));
    } catch {
      /* Kunde inte läsa nivån. Gratisnivån är rätt förval. */
    }

    factsCard.hidden = false;
    respondCard.hidden = false;
    await wireFacts(place, niva);

    if (niva.bilder > 0) {
      photosCard.hidden = false;
      await wirePhotos(place, niva);
    }

    await wireRespond(place);
  }

  function wireClaim(place: { id: string; name: string; municipalitySlug: string }) {
    claimForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      claimError.hidden = true;

      const data = new FormData(claimForm);
      const orgNumber = String(data.get('organizationNumber') ?? '').trim();
      if (!orgNumberValid(orgNumber)) {
        say(claimError, 'Organisationsnumret ser inte ut att stämma. Kontrollera siffrorna.');
        return;
      }

      claimSubmit.disabled = true;
      claimSubmit.textContent = 'Skickar';

      try {
        await submitClaim(place, {
          claimantName: String(data.get('claimantName') ?? '').trim(),
          claimantRole: String(data.get('claimantRole') ?? '').trim(),
          organizationNumber: orgNumber,
          contactEmail: String(data.get('contactEmail') ?? '').trim(),
          contactPhone: String(data.get('contactPhone') ?? '').trim(),
        });
        claimCard.hidden = true;
        lead.innerHTML =
          '<b>Väntar.</b> Tack. Ansökan granskas för hand och du får besked per e-post.';
      } catch (err) {
        say(claimError, err instanceof CommunityError ? err.message : 'Kunde inte skicka ansökan.');
        claimSubmit.disabled = false;
        claimSubmit.textContent = 'Skicka ansökan';
      }
    });
  }

  function wireCode(place: { id: string; name: string; municipalitySlug: string }) {
    codeForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      codeError.hidden = true;

      const field = document.getElementById('code') as HTMLInputElement;
      const code = field.value.trim();
      if (code.length < 4) {
        say(codeError, 'Skriv koden som står i brevet.');
        return;
      }

      codeSubmit.disabled = true;
      codeSubmit.textContent = 'Kontrollerar';

      try {
        await losInKod(place.id, code);
        /* Anspråket är godkänt nu. Läs om sidan i stället för att gissa vad
           den ska visa: load() vet redan vad ett godkänt anspråk ger. */
        codeCard.hidden = true;
        await load(place);
      } catch (err) {
        say(codeError, err instanceof CommunityError ? err.message : 'Koden gick inte att lösa in.');
        codeSubmit.disabled = false;
        codeSubmit.textContent = 'Lös in koden';
      }
    });
  }

  /* ---------------------------------------------------------------------- */
  /* Uppgifter                                                              */
  /* ---------------------------------------------------------------------- */

  /** Raderna finns redan i mallen. Här kopplas bara beteendet på. */
  function wireHours() {
    for (const day of DAGAR) {
      const box = document.getElementById(`shut-${day}`) as HTMLInputElement;
      const from = document.getElementById(`from-${day}`) as HTMLInputElement;
      const to = document.getElementById(`to-${day}`) as HTMLInputElement;

      /* Stängt och klockslag är varandras motsatser. Att låta båda stå
         ifyllda är att be om en rad som säger två saker. */
      box.addEventListener('change', () => {
        from.disabled = box.checked;
        to.disabled = box.checked;
        if (box.checked) {
          from.value = '';
          to.value = '';
        }
      });
    }
  }

  function readHours(): Oppettider | null {
    const hours: Oppettider = {};
    for (const day of DAGAR) {
      const shut = document.getElementById(`shut-${day}`) as HTMLInputElement;
      const from = document.getElementById(`from-${day}`) as HTMLInputElement;
      const to = document.getElementById(`to-${day}`) as HTMLInputElement;

      if (shut.checked) {
        hours[day] = { closed: true };
      } else if (from.value && to.value) {
        hours[day] = { from: from.value, to: to.value };
      }
    }
    return Object.keys(hours).length > 0 ? hours : null;
  }

  /* ---------------------------------------------------------------------- */
  /* Avvikande datum                                                        */
  /* ---------------------------------------------------------------------- */

  /** En tom rad, klonad ur mallen så att den bär sidans stilar. */
  function addExceptionRow(values?: {
    datum: string;
    label?: string;
    from?: string;
    to?: string;
    closed?: boolean;
  }): HTMLLIElement {
    const row = exceptionTemplate.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    const date = row.querySelector('.ex-date') as HTMLInputElement;
    const label = row.querySelector('.ex-label') as HTMLInputElement;
    const from = row.querySelector('.ex-from') as HTMLInputElement;
    const to = row.querySelector('.ex-to') as HTMLInputElement;
    const shut = row.querySelector('.ex-shut') as HTMLInputElement;

    if (values) {
      date.value = values.datum;
      label.value = values.label ?? '';
      from.value = values.from ?? '';
      to.value = values.to ?? '';
      shut.checked = Boolean(values.closed);
    }

    /* Stängt och klockslag är varandras motsatser, precis som i veckoschemat. */
    const sync = () => {
      from.disabled = shut.checked;
      to.disabled = shut.checked;
      if (shut.checked) {
        from.value = '';
        to.value = '';
      }
    };
    shut.addEventListener('change', sync);
    sync();

    (row.querySelector('.ex-remove') as HTMLButtonElement).addEventListener('click', () => {
      row.remove();
    });

    exceptionList.append(row);
    return row;
  }

  function readExceptions(): Avvikelser | null {
    const out: Avvikelser = {};
    for (const row of Array.from(exceptionList.children) as HTMLLIElement[]) {
      const datum = (row.querySelector('.ex-date') as HTMLInputElement).value;
      if (!datum) continue;
      const label = (row.querySelector('.ex-label') as HTMLInputElement).value.trim();
      const shut = (row.querySelector('.ex-shut') as HTMLInputElement).checked;
      const from = (row.querySelector('.ex-from') as HTMLInputElement).value;
      const to = (row.querySelector('.ex-to') as HTMLInputElement).value;

      if (shut) {
        out[datum] = label ? { closed: true, label } : { closed: true };
      } else if (from && to) {
        out[datum] = label ? { from, to, label } : { from, to };
      }
      /* En rad med ett datum men varken tider eller "Stängt" säger ingenting
         och hoppas över i tysthet. Databasen hade avvisat hela insändningen. */
    }
    return Object.keys(out).length > 0 ? out : null;
  }

  function fillExceptions(values: Avvikelser | null) {
    exceptionList.textContent = '';
    if (!values) return;
    for (const datum of Object.keys(values).sort()) {
      const value = values[datum];
      addExceptionRow({
        datum,
        label: value.label,
        closed: 'closed' in value,
        from: 'closed' in value ? undefined : value.from,
        to: 'closed' in value ? undefined : value.to,
      });
    }
  }

  /** Fyller formuläret med det som senast skickades in. */
  function fillFrom(item: Insandning) {
    presentation.value = item.presentation ?? '';
    (factsForm.elements.namedItem('phone') as HTMLInputElement).value = item.phone ?? '';
    (factsForm.elements.namedItem('website') as HTMLInputElement).value = item.website ?? '';
    (factsForm.elements.namedItem('bookingUrl') as HTMLInputElement).value =
      item.booking_url ?? '';

    fillExceptions(item.opening_hours_exceptions);

    if (!item.opening_hours) return;
    for (const day of DAGAR) {
      const value = item.opening_hours[day as Dag];
      if (!value) continue;
      const shut = document.getElementById(`shut-${day}`) as HTMLInputElement;
      const from = document.getElementById(`from-${day}`) as HTMLInputElement;
      const to = document.getElementById(`to-${day}`) as HTMLInputElement;

      if ('closed' in value) {
        shut.checked = true;
        from.disabled = true;
        to.disabled = true;
      } else {
        from.value = value.from;
        to.value = value.to;
      }
    }
  }

  /** En rad i listan beskriver vad insändningen faktiskt innehöll. */
  function summarise(item: Insandning): string {
    const parts: string[] = [];
    if (item.presentation) parts.push('presentation');
    if (item.opening_hours) parts.push('öppettider');
    if (item.opening_hours_exceptions) parts.push('avvikande datum');
    if (item.phone) parts.push('telefon');
    if (item.website) parts.push('webbplats');
    if (item.booking_url) parts.push('bokning');
    return parts.length > 0 ? parts.join(', ') : 'inga uppgifter';
  }

  async function paintSubmissions(place: { id: string }) {
    let rows: Insandning[] = [];
    try {
      rows = await insandningar(place.id);
    } catch {
      return;
    }

    submissionList.textContent = '';
    for (const item of rows) {
      const li = document.createElement('li');

      const main = row(
        summarise(item),
        false,
        item.status === 'rejected' ? item.rejection_reason : null,
      );
      const when = document.createElement('span');
      when.className = 'konto-meta';
      when.textContent = dates.format(new Date(item.created_at));
      main.append(when);

      const parts: Node[] = [tag(item.status, FACTS_STATUS)];

      /* Bara det som ingen hunnit titta på går att ta tillbaka. */
      if (item.status === 'pending') {
        const undo = document.createElement('button');
        undo.type = 'button';
        undo.className = 'btn-quiet btn-tight';
        undo.textContent = 'Ångra';
        undo.addEventListener('click', async () => {
          undo.disabled = true;
          try {
            await angraInsandning(item.id);
            await paintSubmissions(place);
          } catch (err) {
            say(
              factsError,
              err instanceof CommunityError ? err.message : 'Kunde inte ta bort insändningen.',
            );
            undo.disabled = false;
          }
        });
        parts.push(undo);
      }

      li.append(main, side(...parts));
      submissionList.append(li);
    }
    submissionEmpty.hidden = rows.length > 0;
  }

  async function wireFacts(
    place: { id: string; name: string; municipalitySlug: string },
    niva: Niva,
  ) {
    wireHours();
    addException.addEventListener('click', () => {
      addExceptionRow().querySelector<HTMLInputElement>('.ex-date')?.focus();
    });

    presentation.maxLength = niva.presentation;
    presentationHint.textContent = `Minst 20 tecken, högst ${niva.presentation}.`;

    /* Nivån styr, inte en lista i den här filen. Ingen nivå stänger av
       avvikande datum i dag; raden finns för att den ska kunna göra det utan
       att någon skriver om formuläret. */
    if (!niva.avvikandeTider) {
      (document.querySelector('.avvikande') as HTMLElement | null)?.setAttribute('hidden', '');
    }

    let rows: Insandning[] = [];
    try {
      rows = await insandningar(place.id);
    } catch {
      /* Listan målas ändå nedan, och tom lista är rätt svar om läsningen föll. */
    }
    /* Senaste insändningen är utgångspunkten, så att den som vill ändra en
       öppettid slipper skriva presentationen en gång till. */
    if (rows.length > 0) fillFrom(rows[0]);

    await paintSubmissions(place);

    factsForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      factsError.hidden = true;

      const data = new FormData(factsForm);
      const text = String(data.get('presentation') ?? '').trim();
      if (text.length > 0 && text.length < 20) {
        say(factsError, 'Presentationen måste vara minst 20 tecken.');
        return;
      }

      factsSubmit.disabled = true;
      factsSubmit.textContent = 'Skickar';

      try {
        await skickaUppgifter(place, {
          presentation: text,
          openingHours: readHours(),
          exceptions: readExceptions(),
          phone: String(data.get('phone') ?? '').trim(),
          website: String(data.get('website') ?? '').trim(),
          bookingUrl: String(data.get('bookingUrl') ?? '').trim(),
        });
        await paintSubmissions(place);
      } catch (err) {
        say(
          factsError,
          err instanceof CommunityError ? err.message : 'Kunde inte skicka uppgifterna.',
        );
      } finally {
        factsSubmit.disabled = false;
        factsSubmit.textContent = 'Skicka in';
      }
    });
  }

  /* ---------------------------------------------------------------------- */
  /* Bilder                                                                 */
  /* ---------------------------------------------------------------------- */

  async function paintPhotos(place: { id: string }, niva: Niva) {
    let rows: Foretagsbild[] = [];
    try {
      rows = await egnaBilder(place.id);
    } catch {
      return;
    }

    photoList.textContent = '';
    for (const bild of rows) {
      const li = document.createElement('li');

      /* En miniatyr först när bilden är publicerad. Den som väntar på
         granskning har ingen publik URL, och en signerad länk till inkorgen
         hör till redaktionens verktyg och inte hit. */
      if (bild.published_url) {
        const img = document.createElement('img');
        img.className = 'bild-mini';
        img.src = bild.published_url;
        img.alt = bild.caption ?? '';
        img.loading = 'lazy';
        li.append(img);
      }

      const main = row(
        bild.caption ?? 'Utan bildtext',
        false,
        bild.status === 'rejected' ? bild.rejection_reason : null,
      );
      const when = document.createElement('span');
      when.className = 'konto-meta';
      when.textContent = dates.format(new Date(bild.created_at));
      main.append(when);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'btn-quiet btn-tight';
      /* En publicerad bild går också att ta bort. En bild är varken en uppgift
         som ersätts av en ny insändning eller ett yttrande som ska stå kvar:
         det kan vara fel bild, ett ombyggt kök eller en fotograf som ändrat
         sig, och då ska den bort utan att någon behöver be om lov. */
      remove.textContent = 'Ta bort';
      remove.addEventListener('click', async () => {
        remove.disabled = true;
        try {
          await taBortBild(bild);
          await paintPhotos(place, niva);
        } catch (err) {
          say(photoError, err instanceof CommunityError ? err.message : 'Kunde inte ta bort bilden.');
          remove.disabled = false;
        }
      });

      li.append(main, side(tag(bild.status, PHOTO_STATUS), remove));
      photoList.append(li);
    }

    photoEmpty.hidden = rows.length > 0;

    /* Kvar av nivån, räknat på det som inte avslagits. Taket i databasen är
       ett annat och högre tal; se check_business_image(). */
    const anvanda = rows.filter((b) => b.status !== 'rejected').length;
    const kvar = Math.max(0, niva.bilder - anvanda);
    photoHint.textContent =
      kvar > 0
        ? `JPEG, PNG, WebP eller HEIC. Högst 12 MB. ${kvar} av ${niva.bilder} kvar.`
        : `Ni har lagt upp ${niva.bilder} bilder. Ta bort en för att lägga till en ny.`;
    photoSubmit.disabled = kvar === 0;
  }

  async function wirePhotos(
    place: { id: string; name: string; municipalitySlug: string },
    niva: Niva,
  ) {
    await paintPhotos(place, niva);

    photoForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      photoError.hidden = true;

      const file = photoFile.files?.[0];
      if (!file) {
        say(photoError, 'Välj en bild.');
        return;
      }
      if (!photoRights.checked) {
        say(photoError, 'Bekräfta att bilden är er egen att publicera.');
        return;
      }

      photoSubmit.disabled = true;
      photoSubmit.textContent = 'Laddar upp';

      try {
        /* Nya bilder hamnar sist. Ordningen ändras genom att en bild tas bort
           och läggs upp på nytt, precis som allt annat på företagsytan. */
        const sist = photoList.children.length;
        await laddaUppBild(place, file, photoCaption.value, Math.min(sist, 99));
        photoForm.reset();
        await paintPhotos(place, niva);
      } catch (err) {
        say(photoError, err instanceof CommunityError ? err.message : 'Kunde inte ladda upp bilden.');
      } finally {
        photoSubmit.disabled = false;
        photoSubmit.textContent = 'Ladda upp';
      }
    });
  }

  /* ---------------------------------------------------------------------- */
  /* Svar på kontroll                                                       */
  /* ---------------------------------------------------------------------- */

  async function paintResponses(establishmentId: string) {
    let rows: Awaited<ReturnType<typeof ownerResponses>> = [];
    try {
      rows = await ownerResponses(establishmentId);
    } catch {
      return;
    }
    responseList.textContent = '';
    for (const item of rows) {
      const li = document.createElement('li');
      li.append(
        row(item.body, true, item.status === 'rejected' ? item.rejection_reason : null),
        side(tag(item.status, RESPONSE_STATUS)),
      );
      responseList.append(li);
    }
    responseEmpty.hidden = rows.length > 0;
  }

  async function wireRespond(place: { id: string; name: string; municipalitySlug: string }) {
    let inspections: Awaited<ReturnType<typeof inspectionsFor>> = [];
    try {
      inspections = await inspectionsFor(place.id);
    } catch {
      show('Kunde inte hämta kontrollerna.');
    }

    if (inspections.length === 0) {
      respondForm.hidden = true;
      const note = document.createElement('p');
      note.className = 'konto-empty';
      note.textContent =
        'Kommunen har inte publicerat någon kontroll av verksamheten, så det finns inget att svara på än.';
      respondCard.append(note);
    }

    for (const i of inspections) {
      const option = document.createElement('option');
      option.value = i.id;
      const answered = i.owner_comment ? ' (redan besvarad)' : '';
      /* Punkt och inte långt tankstreck. Samma avdelare som omdömesradens
         metatext på verksamhetssidan. */
      option.textContent = `${dates.format(new Date(i.inspected_at))} · ${
        ASSESSMENT[i.assessment] ?? ''
      }${answered}`;
      option.disabled = Boolean(i.owner_comment);
      inspectionSelect.append(option);
    }

    await paintResponses(place.id);

    respondForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      respondError.hidden = true;

      const data = new FormData(respondForm);
      const body = String(data.get('body') ?? '').trim();
      const inspectionId = String(data.get('inspection') ?? '');

      if (!inspectionId) {
        say(respondError, 'Välj vilken kontroll svaret gäller.');
        return;
      }
      if (body.length < 10) {
        say(respondError, 'Skriv minst tio tecken.');
        return;
      }

      respondSubmit.disabled = true;
      respondSubmit.textContent = 'Skickar';

      try {
        await submitOwnerResponse(place, inspectionId, body);
        respondForm.reset();
        await paintResponses(place.id);
      } catch (err) {
        say(
          respondError,
          err instanceof CommunityError ? err.message : 'Kunde inte skicka svaret.',
        );
      } finally {
        respondSubmit.disabled = false;
        respondSubmit.textContent = 'Skicka svar';
      }
    });
  }

  void start();
</script>
