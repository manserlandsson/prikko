---
import Maskot from '../../components/Maskot.astro';
/**
 * Notiser.
 *
 * Klockans lista. Byggs statiskt som varje annan sida och fylls i
 * webbläsaren; ingen personlig uppgift finns i HTML-filen.
 *
 * ---------------------------------------------------------------------------
 * VAD SOM STÅR HÄR, OCH VARFÖR DET INTE GÅR ATT STÄLLA IN
 * ---------------------------------------------------------------------------
 * Två saker, båda sådana någon annan gjort med det du redan brytt dig om:
 *
 *   1. En verksamhet du bevakar har fått en ny bedömning.
 *   2. Ditt omdöme har publicerats eller avvisats.
 *
 * Ingen kryssruta. Samma resonemang som över notify.py: Prikko besöks två
 * gånger om året, och en inställning ingen hinner sätta slår aldrig ett förval
 * som är rätt. Vill man inte höra om en verksamhet slutar man bevaka den, och
 * det är samma knapp som förut.
 *
 * ---------------------------------------------------------------------------
 * OLÄSTMARKERINGEN
 * ---------------------------------------------------------------------------
 * En vattenlinje i databasen, inte en flagga per rad och ALDRIG en nyckel i
 * localStorage. Skälen står i docs/14_samtycke_och_lagring_i_webblasaren.md
 * och över community.notice_reads i pipeline/schema_community.sql.
 *
 * Linjen flyttas när listan MÅLATS, inte när sidan börjar laddas. Går
 * hämtningen sönder halvvägs ska pricken stå kvar: en notis som räknats som
 * läst utan att ha visats är en notis som försvunnit.
 */
import Base from '../../layouts/Base.astro';
import { municipalities } from '../../lib/data';
import '../../styles/konto.css';

/* Kommunens namn slaget på slug, samma karta som kontosidan bakar in. En slug
   är inte ett namn: "malmo" ska stå som "Malmö". */
const cities = Object.fromEntries(municipalities().map((m) => [m.slug, m.city]));
---

<Base title="Notiser" description="Dina notiser på Prikko." noindex>
  <div class="container konto-page konto-wide">
    {/* Utloggad. En rubrik och en knapp, aldrig en ruta som poppar upp. */}
    <div id="guest" hidden>
      <header class="konto-head">
        <h1>Notiser</h1>
        <p class="konto-sub">
          Logga in för att se vad som hänt med dina bevakningar och dina omdömen.
        </p>
      </header>
      <div class="konto-actions">
        <button type="button" class="btn-primary" id="signin">Logga in eller bli medlem</button>
      </div>
    </div>

    {/* Inloggad */}
    <div id="feed" hidden>
      <header class="konto-head">
        <h1>Notiser</h1>
      </header>

      <section class="konto-card">
        <div class="konto-bar">
          <h2>Senaste</h2>
          <a href="/konto/">Ditt konto</a>
        </div>
        <p class="konto-sub">
          Nya bedömningar hos verksamheter du bevakar, och besked om dina omdömen.
        </p>
        <ul class="konto-list notis-list" id="list"></ul>
        {/* Maskoten i tomt läge. Ytan är rätt enligt den bärande regeln: en
            tom notislista nämner ingen verksamhet, och det är sajten som talar
            till en inloggad person om hens eget konto.

            Statisk. Rörelse här hade brutit mot WCAG 2.2.2, som kräver en
            paus-, stopp- eller döljkontroll för allt som rör sig mer än fem
            sekunder parallellt med annat innehåll. En loop uppfyller aldrig
            femsekundersvillkoret. */}
        <div class="konto-empty" id="empty">
          <Maskot pose="tom" size={96} />
          <p>Du har inga notiser än.</p>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="cities" set:html={JSON.stringify(cities)} />
</Base>

<script>
  import {
    configured,
    signedIn,
    captureLinkSession,
    notices,
    reviewNotices,
    noticesReadAt,
    markNoticesRead,
    placeNames,
    type NoticeRow,
    type ReviewNotice,
    type PlaceName,
  } from '../../lib/community';
  import { openSignIn } from '../../lib/signin-dialog';

  const guest = document.getElementById('guest') as HTMLDivElement;
  const feed = document.getElementById('feed') as HTMLDivElement;
  const list = document.getElementById('list') as HTMLUListElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;
  const signinButton = document.getElementById('signin') as HTMLButtonElement;

  const CITIES: Record<string, string> = JSON.parse(
    document.getElementById('cities')?.textContent || '{}',
  );

  /* Etiketterna är sajtens egna, ordagrant ur site/src/lib/site.ts. Notisen
     och verksamhetssidan måste säga samma sak om samma kontroll, annars är det
     ena fel. Samma karta finns i pipeline/notify.py av samma skäl. */
  const VERDICT: Record<string, string> = {
    minor: 'Brister',
    major: 'Brister som kvarstår',
  };

  const REVIEW_STATUS: Record<string, string> = {
    published: 'Publicerat',
    rejected: 'Avslaget',
  };

  const MONTHS = [
    'januari', 'februari', 'mars', 'april', 'maj', 'juni',
    'juli', 'augusti', 'september', 'oktober', 'november', 'december',
  ];

  /** Datum på svenska, samma form som notismejlet skriver. */
  function swedishDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso.slice(0, 10);
    return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
  }

  /**
   * En rad i listan, oavsett varifrån den kommer.
   *
   * `at` är sorteringsnyckeln OCH det som jämförs mot vattenlinjen. För en
   * bevakningsnotis är det när vi upptäckte kontrollen, inte när kommunen
   * utförde den: en kontroll från i våras som dyker upp i natt är ny för
   * läsaren i natt.
   */
  interface Item {
    at: string;
    title: string;
    meta: string;
    href: string | null;
    tag: string;
    tagClass: string;
    why: string | null;
  }

  function fromNotice(row: NoticeRow): Item {
    const city = CITIES[row.municipality_slug] ?? row.municipality_slug;
    return {
      at: row.created_at,
      title: row.establishment_name,
      meta: `${city} · Kontroll ${swedishDate(row.inspected_at)}`,
      href: `/${row.municipality_slug}/${row.establishment_slug}/`,
      tag: VERDICT[row.verdict] ?? row.verdict,
      tagClass: `notis-${row.verdict}`,
      why: null,
    };
  }

  function fromReview(row: ReviewNotice, place: PlaceName | undefined): Item {
    /* Namnet kommer ur den redaktionella databasen och kan saknas: en
       verksamhet som avpublicerats sedan omdömet skrevs finns inte i vyn. Då
       skrivs notisen utan namn i stället för att utelämnas, för beskedet
       gäller läsarens egen text och är sant ändå. */
    const where = place ? ` om ${place.name}` : '';
    return {
      at: row.moderated_at,
      title: `Ditt omdöme${where}`,
      meta:
        row.status === 'published'
          ? 'Ligger nu ute hos verksamheten'
          : 'Kom inte med, och kan skrivas om',
      href: place ? `/${place.municipality_slug}/${place.slug}/` : '/konto/',
      tag: REVIEW_STATUS[row.status] ?? row.status,
      tagClass: `status-${row.status}`,
      /* Skälet hör hemma på raden. Utan det står det "Avslaget" bredvid en
         text man inte får veta något om. */
      why: row.status === 'rejected' ? row.rejection_reason : null,
    };
  }

  function render(item: Item, unread: boolean): HTMLLIElement {
    const li = document.createElement('li');

    /* Pricken ligger FÖRE titeln och står kvar som en tom yta när raden är
       läst. Utan platshållaren hoppar hela listan i sidled så fort man
       tittat på den. */
    const pip = document.createElement('span');
    pip.className = unread ? 'notis-prick' : 'notis-prick last';
    if (unread) pip.setAttribute('aria-label', 'Oläst');
    li.append(pip);

    const box = document.createElement(item.href ? 'a' : 'div');
    box.className = 'konto-main';
    if (item.href) (box as HTMLAnchorElement).href = item.href;

    const strong = document.createElement('b');
    strong.textContent = item.title;
    box.append(strong);

    const meta = document.createElement('span');
    meta.className = 'konto-meta';
    meta.textContent = `${item.meta} · ${swedishDate(item.at)}`;
    box.append(meta);

    if (item.why) {
      const why = document.createElement('span');
      why.className = 'konto-why';
      why.textContent = `Skäl: ${item.why}`;
      box.append(why);
    }
    li.append(box);

    const side = document.createElement('div');
    side.className = 'konto-side';
    const tag = document.createElement('span');
    tag.className = `status-tag ${item.tagClass}`;
    tag.textContent = item.tag;
    side.append(tag);
    li.append(side);

    return li;
  }

  async function paint() {
    guest.hidden = true;
    feed.hidden = false;

    let rows: NoticeRow[] = [];
    let mine: ReviewNotice[] = [];
    let readAt: string | null = null;

    try {
      [rows, mine, readAt] = await Promise.all([
        notices(),
        reviewNotices(),
        noticesReadAt(),
      ]);
    } catch {
      /* Tabellerna saknas tills ägaren kört om schema_community.sql, och då
         svarar PostgREST 404. Beskedet ska säga att listan inte gick att
         hämta, aldrig att den är tom: en tom lista är ett påstående. */
      empty.textContent = 'Notiserna kunde inte hämtas. Ladda om sidan.';
      return;
    }

    let places = new Map<string, PlaceName>();
    if (mine.length > 0) {
      try {
        places = await placeNames(mine.map((row) => row.establishment_id));
      } catch {
        /* Namnen är en förbättring, inte notisen. Utan dem står det "Ditt
           omdöme" utan verksamhet, och beskedet är fortfarande sant. */
      }
    }

    const items = [
      ...rows.map(fromNotice),
      ...mine.map((row) => fromReview(row, places.get(row.establishment_id))),
    ].sort((a, b) => (a.at < b.at ? 1 : a.at > b.at ? -1 : 0));

    const since = readAt ? Date.parse(readAt) : Number.NEGATIVE_INFINITY;

    list.textContent = '';
    for (const item of items) list.append(render(item, Date.parse(item.at) > since));
    empty.hidden = items.length > 0;

    /* Först nu, och bara när något faktiskt målats. En vattenlinje som
       flyttats utan att raderna visats gör notiserna osynliga för alltid. */
    if (items.length > 0) {
      try {
        await markNoticesRead();
      } catch {
        /* Pricken står kvar till nästa besök. Det är rätt riktning att
           misslyckas åt. */
      }
    }
  }

  async function start() {
    if (!configured) {
      guest.hidden = false;
      signinButton.disabled = true;
      signinButton.textContent = 'Inloggning är inte konfigurerad';
      return;
    }

    captureLinkSession();

    if (await signedIn()) {
      await paint();
      return;
    }

    guest.hidden = false;
    signinButton.addEventListener('click', async () => {
      if (await openSignIn(signinButton)) await paint();
    });
  }

  void start();
</script>
