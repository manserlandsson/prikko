---
/**
 * Kontosidan.
 *
 * Byggs statiskt som alla andra sidor och fylls i webbläsaren. Ingen personlig
 * uppgift finns i HTML-filen; den ligger i databasen och hämtas av den som är
 * inloggad. Ett bygge kan därför inte råka publicera någons bevakningslista.
 *
 * Utloggad möts man av en knapp, inte av en ruta som poppar upp. Det är samma
 * regel som gäller överallt: inloggning utlöses av ett tryck, aldrig av en
 * sidladdning.
 *
 * ---------------------------------------------------------------------------
 * ORDNINGEN PÅ SIDAN
 * ---------------------------------------------------------------------------
 * Bevakningar, omdömen, verksamheter, bilder, kontot. Det man kommer hit för
 * står först och det administrativa sist, och varje avsnitt har samma
 * uppbyggnad: en rubrik och rader. Sidan hade tidigare fyra rutor som var och
 * en förklarade sig själv i ett stycke innan den visade något.
 *
 * De två första avsnitten står kvar även när de är tomma, för de säger vad
 * kontot är till för. Anspråk och bilder ritas bara när de finns: den som
 * varken företräder en verksamhet eller skickat in en bild har inget att
 * hantera där, och en tom rubrik är ingen upplysning.
 */
import Base from '../../layouts/Base.astro';
import Maskot from '../../components/Maskot.astro';
import { municipalities } from '../../lib/data';
import '../../styles/konto.css';

/*
 * Kommunens namn, slagen på slug.
 *
 * Bevakningsraden lagrar bara `municipality_slug`, och en slug är inte ett
 * namn: "malmo" ska stå som "Malmö". Kartan är en rad per kommun i beståndet
 * och bakas in i sidan; alternativet hade varit att skicka en fråga till
 * databasen för något som är känt vid bygget.
 */
const cities = Object.fromEntries(municipalities().map((m) => [m.slug, m.city]));
---

<Base title="Ditt konto" description="Ditt konto på Prikko." noindex>
  <div class="container konto-page konto-app">
    {/* Utloggad. Ingen ruta: en rubrik och en knapp. */}
    <div id="guest" class="konto-enkel" hidden>
      <header class="konto-head">
        <h1>Ditt konto</h1>
        <p class="konto-sub">Här ligger dina bevakningar och dina omdömen.</p>
      </header>
      <div class="konto-actions">
        <button type="button" class="btn-primary" id="signin">Logga in eller bli medlem</button>
      </div>
    </div>

    {/* Inloggad.

        Randen och EN spalt, aldrig fem kort i en rulle. Vilket avsnitt som
        visas står i adressens fragment, så att webbläsarens bakåtknapp går
        mellan flikarna och så att en länk kan peka på ett avsnitt. Notiser
        är en länk och inte en flik, för den bor på en egen adress som
        klockan i sidhuvudet pekar på. */}
    <div id="account" hidden>
      <div class="konto-ram har-rand">
        <header class="konto-head">
          <h1>Ditt konto</h1>
        </header>

        <nav class="konto-rand" id="rand" aria-label="Ditt konto">
          <a href="#bevakningar" data-sek="bevakningar" aria-current="page">Bevakningar<span class="antal" id="antal-bevakningar"></span></a>
          <a href="/konto/notiser/">Notiser</a>
          <a href="#omdomen" data-sek="omdomen">Dina omdömen<span class="antal" id="antal-omdomen"></span></a>
          <a href="#verksamheter" data-sek="verksamheter" id="rand-verksamheter" hidden>Verksamheter<span class="antal" id="antal-verksamheter"></span></a>
          <a href="#bilder" data-sek="bilder" id="rand-bilder" hidden>Dina bilder<span class="antal" id="antal-bilder"></span></a>
          <a href="#kontot" data-sek="kontot">Kontot</a>
        </nav>

        <div class="konto-spalt">

          {/* Förvalet står i märkningen och inte bara i skriptet: annars är
              spalten tom i det ögonblick kontot visas men listorna ännu inte
              målats. franHash() rättar valet så fort det finns något att rätta. */}
          <section class="konto-sektion ar-vald" id="sek-bevakningar" data-sek="bevakningar">
            <div class="konto-bar">
              <h2>Bevakningar</h2>
              <a href="/sok/">Sök verksamhet</a>
            </div>
            {/* Vad bevakningen gör, i en rad. Raden sade tidigare att vi inte
                skickar några utskick, vilket slutade vara sant den natt
                notify.py började mejla. */}
            <p class="konto-sub">
              Vi mejlar när kommunen hittar nya anmärkningar hos någon av dem.
            </p>
            <ul class="konto-list" id="follows"></ul>
            {/*
              Maskoten i tomt läge, samma yta och samma skäl som den tomma
              notislistan och den tomma granskningskön: ett konto utan bevakningar
              nämner ingen verksamhet, alltså finns ingen bedömning att stå
              bredvid, och det är sajten som talar till en inloggad person om hens
              eget konto.

              ETT per sida. Sidan har två tomma lägen, det här och "Du har inte
              skrivit något omdöme än" strax nedanför, och bara det första får
              figur. Två grävlingar på samma skärm är inte en avsändare, det är ett
              mönster, och docs/24 §2 säger ett per sida utan undantag. Det första
              får den eftersom bevakningar är vad kontot är till för.

              Statisk. Rörelse här hade legat parallellt med annat innehåll och
              därmed fallit på WCAG 2.2.2, och den som är inloggad ser den här
              skärmen ofta. Frekvensregeln i docs/24 §2 gäller även rörelse.

              Felraden får INGEN figur, och det sköter sig självt: skriptet skriver
              `followEmpty.textContent` när hämtningen misslyckas, vilket tar bort
              svg:n i samma svep. Det är exakt vad docs/24 §2 punkt 8 kräver, och
              skillnaden mot ett tomt läge är vem som orsakat det.

              Kostnad: 4 939 B gzippat på EN sida, som dessutom är noindex.
            */}
            <div class="konto-empty" id="follows-empty">
              <Maskot pose="tom" size={96} />
              <p>Du bevakar ingen verksamhet än.</p>
            </div>
          </section>

          <section class="konto-sektion" id="sek-omdomen" data-sek="omdomen">
            <div class="konto-bar">
              <h2>Dina omdömen</h2>
            </div>
            {/* Omdömen är anonyma. Inget visningsnamn, ingen författarrad, och
                därför inget namnfält någonstans på den här sidan. */}
            <p class="konto-sub">Publiceras anonymt och ordagrant efter granskning.</p>
            <ul class="konto-list" id="reviews"></ul>
            <p class="konto-empty" id="reviews-empty">Du har inte skrivit något omdöme än.</p>
          </section>

          <section class="konto-sektion" id="claims-card" data-sek="verksamheter" hidden>
            <div class="konto-bar">
              <h2>Verksamheter du företräder</h2>
            </div>
            <ul class="konto-list" id="claims"></ul>
          </section>

          <section class="konto-sektion" id="uploads-card" data-sek="bilder" hidden>
            <div class="konto-bar">
              <h2>Dina bilder</h2>
            </div>
            <ul class="konto-list" id="uploads"></ul>
          </section>

          <section class="konto-sektion" id="sek-kontot" data-sek="kontot">
            <div class="konto-bar">
              <h2>Kontot</h2>
            </div>
            <ul class="konto-list">
              <li>
                <div class="konto-main">
                  <b id="who"></b>
                </div>
                <div class="konto-side">
                  <button type="button" class="btn-quiet btn-tight" id="signout">Logga ut</button>
                </div>
              </li>
            </ul>
          </section>

        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="cities" set:html={JSON.stringify(cities)} />
</Base>

<script>
  import {
    configured,
    currentUser,
    signedIn,
    signOut,
    captureLinkSession,
    follows,
    unfollow,
    myReviews,
    deleteReview,
    claims,
    myUploads,
    deleteUpload,
    placeNames,
    placeStates,
  } from '../../lib/community';
  import type { PlaceState } from '../../lib/community';
  import { openSignIn } from '../../lib/signin-dialog';

  const guest = document.getElementById('guest') as HTMLDivElement;
  const account = document.getElementById('account') as HTMLDivElement;
  const who = document.getElementById('who') as HTMLElement;
  const signinButton = document.getElementById('signin') as HTMLButtonElement;
  const signoutButton = document.getElementById('signout') as HTMLButtonElement;

  const followList = document.getElementById('follows') as HTMLUListElement;
  /* HTMLElement och inte HTMLParagraphElement: raden bär numera maskoten och
     är därför en div. Felgrenen nedan skriver textContent på den, vilket tar
     bort figuren, och det är avsiktligt. Ett fel får ingen figur. */
  const followEmpty = document.getElementById('follows-empty') as HTMLElement;

  const reviewList = document.getElementById('reviews') as HTMLUListElement;
  const reviewEmpty = document.getElementById('reviews-empty') as HTMLParagraphElement;

  const claimsCard = document.getElementById('claims-card') as HTMLElement;
  const claimList = document.getElementById('claims') as HTMLUListElement;

  const uploadsCard = document.getElementById('uploads-card') as HTMLElement;
  const uploadList = document.getElementById('uploads') as HTMLUListElement;

  const rand = document.getElementById('rand') as HTMLElement;

  /**
   * Flikarna.
   *
   * Sidan bar fem kort i en enda rulle och mätte 2 844 px vid 1440x900, alltså
   * 3,16 skärmar. Google Search Settings och DuckDuckGos inställningar gör
   * båda tvärtom: en smal navigering till vänster eller överst, och EN yta i
   * taget. Googles sida är exakt 900 px hög vid 900 px fönster, alltså rullar
   * en vald flik inte alls.
   *
   * Valet står i adressens fragment och inte i en variabel. Då fungerar
   * bakåtknappen, och en länk kan peka rakt på ett avsnitt.
   *
   * `hidden` på ett avsnitt betyder fortfarande "det här finns inte", och det
   * vinner över flikvalet: regeln i konto.css är `!important`. Flikvalet bärs
   * därför av klassen .ar-vald och aldrig av `hidden`.
   */
  const sektioner = Array.from(
    document.querySelectorAll<HTMLElement>('.konto-sektion'),
  );

  function flikar(): HTMLAnchorElement[] {
    return Array.from(
      rand.querySelectorAll<HTMLAnchorElement>('a[data-sek]'),
    ).filter((a) => !a.hidden);
  }

  function visa(namn: string) {
    const rader = flikar();
    /* Ett fragment som pekar på ett avsnitt utan innehåll, eller på ingenting
       alls, landar på den första fliken i stället för att visa en tom sida. */
    const vald = rader.find((a) => a.dataset.sek === namn) ?? rader[0];
    if (!vald) return;

    for (const a of rader) {
      if (a === vald) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }
    for (const s of sektioner) {
      s.classList.toggle('ar-vald', s.dataset.sek === vald.dataset.sek);
    }
  }

  function franHash() {
    visa(decodeURIComponent(location.hash.replace(/^#/, '')));
  }

  /** Siffran i randen. Noll skrivs inte ut: ett tomt avsnitt bär ingen siffra. */
  function raknare(id: string, antal: number) {
    const ruta = document.getElementById(id);
    if (ruta) ruta.textContent = antal > 0 ? String(antal) : '';
  }

  const CITIES: Record<string, string> = JSON.parse(
    document.getElementById('cities')?.textContent || '{}',
  );

  /**
   * Etiketterna för moderering skiljer sig åt mellan avsnitten, och det är
   * inte kosmetika. `published` på ett anspråk betyder att redaktionen
   * godkänt att du företräder verksamheten, inte att något publicerats.
   * Kontosidan sade "Publicerat" i båda fallen.
   */
  const REVIEW_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Publicerat',
    rejected: 'Avslaget',
  };

  const CLAIM_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Godkänt',
    rejected: 'Avslaget',
  };

  const IMAGE_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Publicerad',
    rejected: 'Avslagen',
  };

  function tag(status: string, labels: Record<string, string>): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = `status-tag status-${status}`;
    span.textContent = labels[status] ?? status;
    return span;
  }

  /** Vänsterdelen av en rad: fet titel och en tyst rad under. */
  function main(title: string, meta: string, href?: string): HTMLElement {
    const box = document.createElement(href ? 'a' : 'div');
    box.className = 'konto-main';
    if (href) (box as HTMLAnchorElement).href = href;

    const strong = document.createElement('b');
    strong.textContent = title;
    box.append(strong);

    if (meta) {
      const small = document.createElement('span');
      small.className = 'konto-meta';
      small.textContent = meta;
      box.append(small);
    }
    return box;
  }

  function side(...nodes: Node[]): HTMLElement {
    const box = document.createElement('div');
    box.className = 'konto-side';
    box.append(...nodes);
    return box;
  }

  function quietButton(label: string, run: () => Promise<void>): HTMLButtonElement {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn-quiet btn-tight';
    button.textContent = label;
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        await run();
      } catch {
        button.disabled = false;
      }
    });
    return button;
  }

  /* Bevakningar ------------------------------------------------------- */

  /*
   * Sökningen är RESERVEN, inte vägen.
   *
   * `follows` lagrar namn och kommun, aldrig verksamhetens slug, och slugen
   * går inte att räkna fram ur namnet i webbläsaren. Den slås därför upp med
   * de andra uppgifterna i placeStates(). Går den uppslagningen fel, eller har
   * verksamheten avpublicerats sedan man tryckte Följ, finns ingen adress att
   * länka till, och då är sökningen med namnet ifyllt den ärliga vägen. En
   * gissad adress hade sett ut som en länk till stället.
   */
  function searchUrl(name: string): string {
    return `/sok/?q=${encodeURIComponent(name)}`;
  }

  /** Datum på svenska, samma form som notislistan och notismejlet skriver. */
  const MONTHS = [
    'januari', 'februari', 'mars', 'april', 'maj', 'juni',
    'juli', 'augusti', 'september', 'oktober', 'november', 'december',
  ];

  function swedishDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return iso.slice(0, 10);
    return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}`;
  }

  /*
   * Bedömningens tre ord, ordagrant som på verksamhetssidan.
   *
   * Upprepade här och inte importerade ur lib/site: den modulen drar in
   * bygg-data som inte hör hemma i paketet för en inloggad sida. Ändras ett
   * ord där måste det ändras här, vilket är priset för att kontosidan inte
   * ska bära beståndet.
   *
   * Ingen färgskala i sig, bara samma bläck som statusetiketterna redan
   * använder. En rad som bara är färgad säger ingenting för den som inte ser
   * färg; det är ordet som bär beskedet.
   */
  const VERDICT_LABEL: Record<string, string> = {
    clean: 'Inga anmärkningar',
    minor: 'Brister',
    major: 'Brister som kvarstår',
  };

  /**
   * Bevakningarna, med läget hos varje ställe.
   *
   * Raden sade tidigare bara namn och stad, alltså exakt lika mycket som den
   * sagt den sekund man tryckte Följ. Att bevaka något vars läge man ändå
   * måste gå och titta efter är ingen bevakning.
   *
   * Ordningen är senaste kontroll först, inte när man tryckte Följ. Det är
   * listans enda uppgift: säga vad som hänt sedan sist. Ställen utan känt
   * datum ligger sist, för de har ingenting att sortera på.
   */
  async function paintFollows() {
    let rows: Awaited<ReturnType<typeof follows>> = [];
    try {
      rows = await follows();
    } catch {
      followEmpty.textContent = 'Bevakningarna kunde inte hämtas. Ladda om sidan.';
      return;
    }

    /* ETT anrop för hela listan. Faller det står raderna kvar med namn och
       stad, alltså som förut, i stället för att listan uteblir. */
    let states = new Map<string, PlaceState>();
    try {
      states = await placeStates(rows.map((row) => row.establishment_id));
    } catch {
      /* Utan läge duger namnet. Bevakningen är fortfarande ens egen. */
    }

    const sorted = [...rows].sort((a, b) => {
      const one = states.get(a.establishment_id)?.latest_inspection ?? '';
      const two = states.get(b.establishment_id)?.latest_inspection ?? '';
      return two.localeCompare(one);
    });

    followList.textContent = '';
    for (const row of sorted) {
      const state = states.get(row.establishment_id);
      const li = document.createElement('li');

      const city = CITIES[row.municipality_slug] ?? row.municipality_slug;
      /* Namnet ur uppslagningen när den finns: en verksamhet som bytt namn
         sedan man tryckte Följ ska stå med det namn sidan den länkar till
         bär. Kopian på bevakningsraden är en reserv och inte sanningen. */
      const name = state?.name ?? row.establishment_name;

      li.append(
        main(
          name,
          state?.latest_inspection
            ? `${city} · Kontrollerad ${swedishDate(state.latest_inspection)}`
            : city,
          state ? `/${state.municipality_slug}/${state.slug}/` : searchUrl(name),
        ),
        side(
          ...(state?.verdict && VERDICT_LABEL[state.verdict]
            ? [verdictTag(state.verdict)]
            : []),
          quietButton('Sluta bevaka', async () => {
            await unfollow(row.establishment_id);
            li.remove();
            followEmpty.hidden = followList.children.length > 0;
            raknare('antal-bevakningar', followList.children.length);
          }),
        ),
      );
      followList.append(li);
    }
    followEmpty.hidden = rows.length > 0;
    raknare('antal-bevakningar', rows.length);
  }

  /** Bedömningen som etikett, samma form som statusetiketterna på sidan. */
  function verdictTag(verdict: string): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = `status-tag verdict-${verdict}`;
    span.textContent = VERDICT_LABEL[verdict];
    return span;
  }

  /* Omdömen ----------------------------------------------------------- */

  /** Betyget som stjärnor, samma form som på verksamhetssidan. */
  function stars(rating: number): HTMLElement {
    const box = document.createElement('span');
    box.className = 'konto-stars';
    box.setAttribute('aria-label', `${rating} av 5`);
    for (let i = 1; i <= 5; i += 1) {
      const star = document.createElement('span');
      star.className = i <= rating ? 'on' : 'off';
      star.setAttribute('aria-hidden', 'true');
      star.textContent = '★';
      box.append(star);
    }
    return box;
  }

  async function paintReviews() {
    let rows: Awaited<ReturnType<typeof myReviews>> = [];
    try {
      rows = await myReviews();
    } catch {
      reviewEmpty.textContent = 'Omdömena kunde inte hämtas. Ladda om sidan.';
      return;
    }

    /* Namnen i EN fråga, inte en per rad.
       Omdömesraden bär bara id och kommun. Namnet skrivs INTE på raden: en
       verksamhet som byter namn hade då burit det gamla namnet i evighet i
       den som skrev omdömet, medan sidan den pekar på bar det nya. */
    const namn = await placeNames(rows.map((row) => row.establishment_id)).catch(
      () => new Map<string, { name: string; slug: string; municipality_slug: string }>(),
    );

    reviewList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');

      /*
       * Vilket ställe omdömet gäller, överst och som länk.
       *
       * Raden sade förut bara betyg och text, alltså stod ens egna omdömen
       * utan att säga vad de handlade om. Bevakningarna strax ovanför har
       * burit namnet hela tiden, och det var den enda skillnaden mellan de
       * två listorna.
       *
       * Länken går till verksamhetens sida och inte till en sökning, till
       * skillnad från bevakningarna: här finns slugen, så det finns ingen
       * anledning att skicka någon via ett sökresultat till en sida vi redan
       * vet adressen till.
       */
      const plats = namn.get(row.establishment_id);
      const box = document.createElement(plats ? 'a' : 'div');
      box.className = 'konto-main';
      if (plats) {
        /* Kommunen tas ur uppslagningen och inte ur omdömesraden. De två är
           lika i dag, men slugen kommer därifrån, och en adress ska byggas av
           delar som kommer från samma källa. */
        (box as HTMLAnchorElement).href = `/${plats.municipality_slug}/${plats.slug}/`;

        const titel = document.createElement('b');
        titel.textContent = plats.name;
        box.append(titel);

        const ort = document.createElement('span');
        ort.className = 'konto-meta';
        ort.textContent = CITIES[plats.municipality_slug] ?? plats.municipality_slug;
        box.append(ort);
      }

      /* Betyget bara när det finns. Ett omdöme utan siffra är ett fullgott
         omdöme och ska inte få fem gråa stjärnor som läser som noll av fem. */
      if (row.rating) box.append(stars(row.rating));

      /* Texten bara när den finns. Ett omdöme kan vara enbart ett betyg sedan
         ägaren beslutat att stjärnorna räcker, och en tom citatrad hade sett
         ut som ett omdöme vars text kommit bort. */
      if (row.body) {
        const text = document.createElement('p');
        text.className = 'konto-quote';
        text.textContent = row.body;
        box.append(text);
      }

      /* Skälet till ett avslag hörde hemma här från början. Utan det står det
         "Avslaget" bredvid en text man inte får veta något om. */
      if (row.status === 'rejected' && row.rejection_reason) {
        const why = document.createElement('span');
        why.className = 'konto-why';
        /* "Skäl:" står ut. Utan etiketten läses redaktionens mening som en
           fortsättning på ens egen text, båda är tyst grå caption. */
        why.textContent = `Skäl: ${row.rejection_reason}`;
        box.append(why);
      }

      li.append(
        box,
        side(
          tag(row.status, REVIEW_STATUS),
          quietButton('Ta bort', async () => {
            await deleteReview(row.id);
            li.remove();
            reviewEmpty.hidden = reviewList.children.length > 0;
            raknare('antal-omdomen', reviewList.children.length);
          }),
        ),
      );
      reviewList.append(li);
    }
    reviewEmpty.hidden = rows.length > 0;
    raknare('antal-omdomen', rows.length);
  }

  /* Anspråk och bilder ------------------------------------------------ */

  function placeUrl(row: { establishment_id: string; municipality_slug: string; establishment_name: string }) {
    return (
      `/konto/verksamhet/?id=${encodeURIComponent(row.establishment_id)}` +
      `&kommun=${encodeURIComponent(row.municipality_slug)}` +
      `&namn=${encodeURIComponent(row.establishment_name)}`
    );
  }

  /** Anspråken. Rutan ritas inte om den är tom. */
  async function paintClaims() {
    let rows: Awaited<ReturnType<typeof claims>> = [];
    try {
      rows = await claims();
    } catch {
      return;
    }
    if (rows.length === 0) return;

    claimList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');
      li.append(
        main(row.establishment_name, CITIES[row.municipality_slug] ?? row.municipality_slug, placeUrl(row)),
        side(tag(row.status, CLAIM_STATUS)),
      );
      claimList.append(li);
    }
    claimsCard.hidden = false;
    /* Randens rad följer avsnittet. Ett avsnitt som inte finns får ingen flik,
       annars leder fliken till en tom yta. */
    const flik = document.getElementById('rand-verksamheter');
    if (flik) flik.hidden = false;
    raknare('antal-verksamheter', rows.length);
  }

  /**
   * Egna bilder.
   *
   * Egen funktion och inte en svans på anspråken, vilket den var förut. Den
   * gamla varianten gick igenom sina GODKÄNDA ANSPRÅK och frågade efter bilder
   * per verksamhet. Den vägen kan inte ge något längre: bilder skickas in av
   * gäster, och den som företräder en verksamhet får inte ladda upp alls. Listan
   * hade alltid varit tom, och besökarens egna bilder hade aldrig synts någonstans.
   *
   * Kortet visas bara för den som har skickat in en bild. Ett tomt kort med en
   * rubrik som lovar bilder är sämre än inget kort.
   */
  async function paintUploads() {
    let rows: Awaited<ReturnType<typeof myUploads>> = [];
    try {
      rows = await myUploads();
    } catch {
      return;
    }
    if (rows.length === 0) return;

    /* Namnen bor i den redaktionella databasen, inte i bildraden. Ett anrop
       för hela listan, inte ett per bild. En verksamhet som avpublicerats
       sedan bilden skickades saknas i svaret, och raden får då stå utan namn
       i stället för att utelämnas. */
    let names = new Map<string, { name: string; slug: string; municipality_slug: string }>();
    try {
      names = await placeNames(rows.map((row) => row.establishment_id));
    } catch {
      /* Utan namn duger kommunen. Bilden är fortfarande ens egen. */
    }

    uploadList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');

      /* Raden länkar till verksamheten, precis som omdömesraden gör.
         En publicerad bild ska gå att gå och titta på, och det var enda
         skillnaden mellan de två listorna. Saknas uppslagningen står raden
         kvar som en div: en gissad adress är sämre än ingen. */
      const plats = names.get(row.establishment_id);
      const box = document.createElement(plats ? 'a' : 'div');
      box.className = 'konto-main';
      if (plats) {
        (box as HTMLAnchorElement).href = `/${plats.municipality_slug}/${plats.slug}/#bilder`;
      }

      const title = document.createElement('b');
      title.textContent = plats?.name ?? 'Verksamheten';
      box.append(title);

      const where = document.createElement('span');
      where.className = 'konto-meta';
      where.textContent = CITIES[row.municipality_slug] ?? row.municipality_slug;
      box.append(where);

      /* Samma sak som vid omdömena: "Avslagen" utan skäl är ett besked man
         inte kan göra något med. */
      if (row.status === 'rejected' && row.rejection_reason) {
        const why = document.createElement('span');
        why.className = 'konto-why';
        why.textContent = `Skäl: ${row.rejection_reason}`;
        box.append(why);
      }

      /* Borttagning på alla lägen, inte bara de som väntar.
         Bilden är den som skickade in den, precis som ett omdöme är sin
         författares. En publicerad bild försvinner från verksamhetens sida i
         samma stund, och filen tas bort ur lagringen med raden. */
      li.append(
        box,
        side(
          tag(row.status, IMAGE_STATUS),
          quietButton('Ta bort', async () => {
            await deleteUpload(row);
            li.remove();
            uploadsCard.hidden = uploadList.children.length === 0;
            const flik = document.getElementById('rand-bilder');
            if (flik) flik.hidden = uploadsCard.hidden;
            raknare('antal-bilder', uploadList.children.length);
            /* Försvann avsnittet man stod i finns ingen vald flik kvar.
               Då tas den första i stället för att spalten blir tom. */
            if (uploadsCard.hidden) franHash();
          }),
        ),
      );
      uploadList.append(li);
    }
    uploadsCard.hidden = false;
    const flik = document.getElementById('rand-bilder');
    if (flik) flik.hidden = false;
    raknare('antal-bilder', rows.length);
  }

  /* Start ------------------------------------------------------------- */

  async function loadAccount() {
    guest.hidden = true;
    account.hidden = false;

    const user = currentUser();
    who.textContent = user?.email ?? 'Du är inloggad';

    await Promise.all([paintFollows(), paintReviews(), paintClaims(), paintUploads()]);

    /* Först nu. Vilka flikar som finns avgörs av vad som målats, och ett val
       taget innan dess hade kunnat landa på en flik som strax döljs. */
    franHash();
    addEventListener('hashchange', franHash);
  }

  async function start() {
    if (!configured) {
      guest.hidden = false;
      signinButton.disabled = true;
      signinButton.textContent = 'Inloggning är inte konfigurerad';
      return;
    }

    // Kommer man tillbaka från Google eller Apple ligger sessionen i
    // fragmentet. Normalt går den vägen genom /konto/inloggad/, men om någon
    // landat direkt här ska den ändå tas om hand.
    captureLinkSession();

    if (await signedIn()) {
      await loadAccount();
    } else {
      guest.hidden = false;
      signinButton.addEventListener('click', async () => {
        if (await openSignIn(signinButton)) await loadAccount();
      });
    }

    signoutButton.addEventListener('click', async () => {
      await signOut();
      location.href = '/';
    });
  }

  void start();
</script>
