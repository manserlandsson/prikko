---
/**
 * Kontosidan.
 *
 * Byggs statiskt som alla andra sidor och fylls i webbläsaren. Ingen personlig
 * uppgift finns i HTML-filen; den ligger i databasen och hämtas av den som är
 * inloggad. Ett bygge kan därför inte råka publicera någons bevakningslista.
 *
 * Utloggad möts man av en knapp, inte av en ruta som poppar upp. Det är samma
 * regel som gäller överallt: inloggning utlöses av ett tryck, aldrig av en
 * sidladdning.
 *
 * ---------------------------------------------------------------------------
 * ORDNINGEN PÅ SIDAN
 * ---------------------------------------------------------------------------
 * Bevakningar, omdömen, verksamheter, bilder, kontot. Det man kommer hit för
 * står först och det administrativa sist, och varje avsnitt har samma
 * uppbyggnad: en rubrik och rader. Sidan hade tidigare fyra rutor som var och
 * en förklarade sig själv i ett stycke innan den visade något.
 *
 * De två första avsnitten står kvar även när de är tomma, för de säger vad
 * kontot är till för. Anspråk och bilder ritas bara när de finns: en
 * uppladdning kräver ett godkänt anspråk, så för nästan alla är de två
 * avsnitten en beskrivning av något de inte kan göra.
 */
import Base from '../../layouts/Base.astro';
import { municipalities } from '../../lib/data';
import '../../styles/konto.css';

/*
 * Kommunens namn, slagen på slug.
 *
 * Bevakningsraden lagrar bara `municipality_slug`, och en slug är inte ett
 * namn: "malmo" ska stå som "Malmö". Kartan är en rad per kommun i beståndet
 * och bakas in i sidan; alternativet hade varit att skicka en fråga till
 * databasen för något som är känt vid bygget.
 */
const cities = Object.fromEntries(municipalities().map((m) => [m.slug, m.city]));
---

<Base title="Ditt konto" description="Ditt konto på Prikko." noindex>
  <div class="container konto-page konto-wide">
    {/* Utloggad. Ingen ruta: en rubrik och en knapp. */}
    <div id="guest" hidden>
      <header class="konto-head">
        <h1>Ditt konto</h1>
        <p class="konto-sub">Här ligger dina bevakningar och dina omdömen.</p>
      </header>
      <div class="konto-actions">
        <button type="button" class="btn-primary" id="signin">Logga in eller bli medlem</button>
      </div>
    </div>

    {/* Inloggad */}
    <div id="account" hidden>
      <header class="konto-head">
        <h1>Ditt konto</h1>
      </header>

      <section class="konto-card">
        <div class="konto-bar">
          <h2>Bevakningar</h2>
          <a href="/sok/">Sök verksamhet</a>
        </div>
        {/* Vad bevakningen gör, i en rad. Raden sade tidigare att vi inte
            skickar några utskick, vilket slutade vara sant den natt
            notify.py började mejla. */}
        <p class="konto-sub">
          Vi mejlar när kommunen hittar nya anmärkningar hos någon av dem.
        </p>
        <ul class="konto-list" id="follows"></ul>
        <p class="konto-empty" id="follows-empty">Du bevakar ingen verksamhet än.</p>
      </section>

      <section class="konto-card">
        <div class="konto-bar">
          <h2>Dina omdömen</h2>
        </div>
        {/* Omdömen är anonyma. Inget visningsnamn, ingen författarrad, och
            därför inget namnfält någonstans på den här sidan. */}
        <p class="konto-sub">Publiceras anonymt och ordagrant efter granskning.</p>
        <ul class="konto-list" id="reviews"></ul>
        <p class="konto-empty" id="reviews-empty">Du har inte skrivit något omdöme än.</p>
      </section>

      <section class="konto-card" id="claims-card" hidden>
        <div class="konto-bar">
          <h2>Verksamheter du företräder</h2>
        </div>
        <ul class="konto-list" id="claims"></ul>
      </section>

      <section class="konto-card" id="uploads-card" hidden>
        <div class="konto-bar">
          <h2>Dina bilder</h2>
        </div>
        <ul class="konto-list" id="uploads"></ul>
      </section>

      <section class="konto-card">
        <div class="konto-bar">
          <h2>Kontot</h2>
        </div>
        <ul class="konto-list">
          <li>
            <div class="konto-main">
              <b id="who"></b>
            </div>
            <div class="konto-side">
              <button type="button" class="btn-quiet btn-tight" id="signout">Logga ut</button>
            </div>
          </li>
        </ul>
      </section>
    </div>
  </div>

  <script type="application/json" id="cities" set:html={JSON.stringify(cities)} />
</Base>

<script>
  import {
    configured,
    currentUser,
    signedIn,
    signOut,
    captureLinkSession,
    follows,
    unfollow,
    myReviews,
    deleteReview,
    claims,
    myUploads,
    placeNames,
  } from '../../lib/community';
  import { openSignIn } from '../../lib/signin-dialog';

  const guest = document.getElementById('guest') as HTMLDivElement;
  const account = document.getElementById('account') as HTMLDivElement;
  const who = document.getElementById('who') as HTMLElement;
  const signinButton = document.getElementById('signin') as HTMLButtonElement;
  const signoutButton = document.getElementById('signout') as HTMLButtonElement;

  const followList = document.getElementById('follows') as HTMLUListElement;
  const followEmpty = document.getElementById('follows-empty') as HTMLParagraphElement;

  const reviewList = document.getElementById('reviews') as HTMLUListElement;
  const reviewEmpty = document.getElementById('reviews-empty') as HTMLParagraphElement;

  const claimsCard = document.getElementById('claims-card') as HTMLElement;
  const claimList = document.getElementById('claims') as HTMLUListElement;

  const uploadsCard = document.getElementById('uploads-card') as HTMLElement;
  const uploadList = document.getElementById('uploads') as HTMLUListElement;

  const CITIES: Record<string, string> = JSON.parse(
    document.getElementById('cities')?.textContent || '{}',
  );

  /**
   * Etiketterna för moderering skiljer sig åt mellan avsnitten, och det är
   * inte kosmetika. `published` på ett anspråk betyder att redaktionen
   * godkänt att du företräder verksamheten, inte att något publicerats.
   * Kontosidan sade "Publicerat" i båda fallen.
   */
  const REVIEW_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Publicerat',
    rejected: 'Avslaget',
  };

  const CLAIM_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Godkänt',
    rejected: 'Avslaget',
  };

  const IMAGE_STATUS: Record<string, string> = {
    pending: 'Granskas',
    published: 'Publicerad',
    rejected: 'Avslagen',
  };

  function tag(status: string, labels: Record<string, string>): HTMLSpanElement {
    const span = document.createElement('span');
    span.className = `status-tag status-${status}`;
    span.textContent = labels[status] ?? status;
    return span;
  }

  /** Vänsterdelen av en rad: fet titel och en tyst rad under. */
  function main(title: string, meta: string, href?: string): HTMLElement {
    const box = document.createElement(href ? 'a' : 'div');
    box.className = 'konto-main';
    if (href) (box as HTMLAnchorElement).href = href;

    const strong = document.createElement('b');
    strong.textContent = title;
    box.append(strong);

    if (meta) {
      const small = document.createElement('span');
      small.className = 'konto-meta';
      small.textContent = meta;
      box.append(small);
    }
    return box;
  }

  function side(...nodes: Node[]): HTMLElement {
    const box = document.createElement('div');
    box.className = 'konto-side';
    box.append(...nodes);
    return box;
  }

  function quietButton(label: string, run: () => Promise<void>): HTMLButtonElement {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'btn-quiet btn-tight';
    button.textContent = label;
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        await run();
      } catch {
        button.disabled = false;
      }
    });
    return button;
  }

  /* Bevakningar ------------------------------------------------------- */

  /*
   * Verksamheten når man via sökningen och inte direkt.
   *
   * `follows` lagrar namn och kommun, aldrig verksamhetens slug, och slugen
   * går inte att räkna fram ur namnet i webbläsaren. Sökningen med namnet
   * ifyllt är den ärliga vägen; en länk rakt till kommunsidan hade sett ut
   * som en länk till stället.
   */
  function searchUrl(name: string): string {
    return `/sok/?q=${encodeURIComponent(name)}`;
  }

  async function paintFollows() {
    let rows: Awaited<ReturnType<typeof follows>> = [];
    try {
      rows = await follows();
    } catch {
      followEmpty.textContent = 'Bevakningarna kunde inte hämtas. Ladda om sidan.';
      return;
    }

    followList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');
      li.append(
        main(
          row.establishment_name,
          CITIES[row.municipality_slug] ?? row.municipality_slug,
          searchUrl(row.establishment_name),
        ),
        side(
          quietButton('Sluta bevaka', async () => {
            await unfollow(row.establishment_id);
            li.remove();
            followEmpty.hidden = followList.children.length > 0;
          }),
        ),
      );
      followList.append(li);
    }
    followEmpty.hidden = rows.length > 0;
  }

  /* Omdömen ----------------------------------------------------------- */

  /** Betyget som stjärnor, samma form som på verksamhetssidan. */
  function stars(rating: number): HTMLElement {
    const box = document.createElement('span');
    box.className = 'konto-stars';
    box.setAttribute('aria-label', `${rating} av 5`);
    for (let i = 1; i <= 5; i += 1) {
      const star = document.createElement('span');
      star.className = i <= rating ? 'on' : 'off';
      star.setAttribute('aria-hidden', 'true');
      star.textContent = '★';
      box.append(star);
    }
    return box;
  }

  async function paintReviews() {
    let rows: Awaited<ReturnType<typeof myReviews>> = [];
    try {
      rows = await myReviews();
    } catch {
      reviewEmpty.textContent = 'Omdömena kunde inte hämtas. Ladda om sidan.';
      return;
    }

    reviewList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');

      const box = document.createElement('div');
      box.className = 'konto-main';

      /* Betyget bara när det finns. Ett omdöme utan siffra är ett fullgott
         omdöme och ska inte få fem gråa stjärnor som läser som noll av fem. */
      if (row.rating) box.append(stars(row.rating));

      /* Texten bara när den finns. Ett omdöme kan vara enbart ett betyg sedan
         ägaren beslutat att stjärnorna räcker, och en tom citatrad hade sett
         ut som ett omdöme vars text kommit bort. */
      if (row.body) {
        const text = document.createElement('p');
        text.className = 'konto-quote';
        text.textContent = row.body;
        box.append(text);
      }

      /* Skälet till ett avslag hörde hemma här från början. Utan det står det
         "Avslaget" bredvid en text man inte får veta något om. */
      if (row.status === 'rejected' && row.rejection_reason) {
        const why = document.createElement('span');
        why.className = 'konto-why';
        /* "Skäl:" står ut. Utan etiketten läses redaktionens mening som en
           fortsättning på ens egen text, båda är tyst grå caption. */
        why.textContent = `Skäl: ${row.rejection_reason}`;
        box.append(why);
      }

      li.append(
        box,
        side(
          tag(row.status, REVIEW_STATUS),
          quietButton('Ta bort', async () => {
            await deleteReview(row.id);
            li.remove();
            reviewEmpty.hidden = reviewList.children.length > 0;
          }),
        ),
      );
      reviewList.append(li);
    }
    reviewEmpty.hidden = rows.length > 0;
  }

  /* Anspråk och bilder ------------------------------------------------ */

  function placeUrl(row: { establishment_id: string; municipality_slug: string; establishment_name: string }) {
    return (
      `/konto/verksamhet/?id=${encodeURIComponent(row.establishment_id)}` +
      `&kommun=${encodeURIComponent(row.municipality_slug)}` +
      `&namn=${encodeURIComponent(row.establishment_name)}`
    );
  }

  /** Anspråken. Rutan ritas inte om den är tom. */
  async function paintClaims() {
    let rows: Awaited<ReturnType<typeof claims>> = [];
    try {
      rows = await claims();
    } catch {
      return;
    }
    if (rows.length === 0) return;

    claimList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');
      li.append(
        main(row.establishment_name, CITIES[row.municipality_slug] ?? row.municipality_slug, placeUrl(row)),
        side(tag(row.status, CLAIM_STATUS)),
      );
      claimList.append(li);
    }
    claimsCard.hidden = false;
  }

  /**
   * Egna bilder.
   *
   * Egen funktion och inte en svans på anspråken, vilket den var förut. Den
   * gamla varianten gick igenom sina GODKÄNDA ANSPRÅK och frågade efter bilder
   * per verksamhet. Den vägen kan inte ge något längre: bilder skickas in av
   * gäster, och den som företräder en verksamhet får inte ladda upp alls. Listan
   * hade alltid varit tom, och besökarens egna bilder hade aldrig synts någonstans.
   *
   * Kortet visas bara för den som har skickat in en bild. Ett tomt kort med en
   * rubrik som lovar bilder är sämre än inget kort.
   */
  async function paintUploads() {
    let rows: Awaited<ReturnType<typeof myUploads>> = [];
    try {
      rows = await myUploads();
    } catch {
      return;
    }
    if (rows.length === 0) return;

    /* Namnen bor i den redaktionella databasen, inte i bildraden. Ett anrop
       för hela listan, inte ett per bild. En verksamhet som avpublicerats
       sedan bilden skickades saknas i svaret, och raden får då stå utan namn
       i stället för att utelämnas. */
    let names = new Map<string, { name: string }>();
    try {
      names = await placeNames(rows.map((row) => row.establishment_id));
    } catch {
      /* Utan namn duger kommunen. Bilden är fortfarande ens egen. */
    }

    uploadList.textContent = '';
    for (const row of rows) {
      const li = document.createElement('li');

      const box = document.createElement('div');
      box.className = 'konto-main';

      const title = document.createElement('b');
      title.textContent = names.get(row.establishment_id)?.name ?? 'Verksamheten';
      box.append(title);

      const where = document.createElement('span');
      where.className = 'konto-meta';
      where.textContent = CITIES[row.municipality_slug] ?? row.municipality_slug;
      box.append(where);

      /* Samma sak som vid omdömena: "Avslagen" utan skäl är ett besked man
         inte kan göra något med. */
      if (row.status === 'rejected' && row.rejection_reason) {
        const why = document.createElement('span');
        why.className = 'konto-why';
        why.textContent = `Skäl: ${row.rejection_reason}`;
        box.append(why);
      }

      li.append(box, side(tag(row.status, IMAGE_STATUS)));
      uploadList.append(li);
    }
    uploadsCard.hidden = false;
  }

  /* Start ------------------------------------------------------------- */

  async function loadAccount() {
    guest.hidden = true;
    account.hidden = false;

    const user = currentUser();
    who.textContent = user?.email ?? 'Du är inloggad';

    await Promise.all([paintFollows(), paintReviews(), paintClaims(), paintUploads()]);
  }

  async function start() {
    if (!configured) {
      guest.hidden = false;
      signinButton.disabled = true;
      signinButton.textContent = 'Inloggning är inte konfigurerad';
      return;
    }

    // Kommer man tillbaka från Google eller Apple ligger sessionen i
    // fragmentet. Normalt går den vägen genom /konto/inloggad/, men om någon
    // landat direkt här ska den ändå tas om hand.
    captureLinkSession();

    if (await signedIn()) {
      await loadAccount();
    } else {
      guest.hidden = false;
      signinButton.addEventListener('click', async () => {
        if (await openSignIn(signinButton)) await loadAccount();
      });
    }

    signoutButton.addEventListener('click', async () => {
      await signOut();
      location.href = '/';
    });
  }

  void start();
</script>
