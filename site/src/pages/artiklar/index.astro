---
/**
 * Artiklarnas indexsida.
 *
 * Sajtens redaktionella yta har två rum, och skillnaden ska synas: rapporterna
 * räknas fram ur beståndet, artiklarna är skrivna. Den här sidan listar de
 * skrivna. Kortmönstret är JobbSafaris (kategorietikett, rubrik, ingress,
 * lästid) i vårt eget formspråk: hårlinjer, Instrument Sans, inga skuggfält.
 *
 * Kvalitetsgrinden: under MIN_ARTICLES publicerade artiklar bär sidan noindex
 * och hålls ur sitemapen (astro.config.mjs läser samma grind). En indexsida
 * med en ensam artikel är en tunn sida i bibelns §6-mening, och den svagaste
 * länken sänker domänen.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MIN_ARTICLES, readingMinutes, sectionReady } from '../../lib/artiklar';
import { articleImage, CARD_SIZES, CARD_WIDTHS } from '../../lib/artikelbilder';
import { formatDate } from '../../lib/data';
import { SITE } from '../../lib/site';
import { absolute, path } from '../../lib/urls';

const entries = await getCollection('artiklar', ({ data }) => !data.draft);
const articles = entries
  .map((e) => ({
    slug: e.id,
    minutes: readingMinutes(e.body ?? ''),
    photo: articleImage(e.id, e.data.image),
    ...e.data,
  }))
  .sort((a, b) => b.published.localeCompare(a.published));

/**
 * Korten på första raden ligger ovanför vikningen och hämtas direkt, resten
 * lat. Tre är rutnätets bredaste rad på en vanlig skärm; på en telefon är det
 * ett kort och två bilder till som hämtas i onödan, vilket är billigare än ett
 * lat LCP-element.
 */
const EAGER_CARDS = 3;

const ready = sectionReady();
if (articles.length !== entries.length || (articles.length >= MIN_ARTICLES) !== ready) {
  // Grinden i lib/artiklar.ts läser disk, sidan läser collection. Säger de
  // emot varandra är det ett byggfel, inte något att publicera runt.
  throw new Error('Artikelgrinden och innehållssamlingen är osams. Se lib/artiklar.ts.');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Artiklar',
  description:
    'Guider och förklaringar om den svenska livsmedelskontrollen, skrivna av Prikko.',
  inLanguage: 'sv-SE',
  url: absolute('artiklar'),
  publisher: { '@type': 'Organization', name: SITE.legalName },
  hasPart: articles.map((a) => ({
    '@type': 'Article',
    headline: a.title,
    description: a.description,
    datePublished: a.published,
    url: absolute('artiklar', a.slug),
  })),
};
---

<Base
  title="Artiklar om livsmedelskontrollen"
  description="Hur en hygienkontroll går till, vad en anmärkning betyder och varför kommunernas siffror inte går att jämföra rakt av. Guider och förklaringar från Prikko."
  jsonLd={jsonLd}
  noindex={!ready}
>
  <div class="container page">
    <header>
      <p class="eyebrow">Artiklar</p>
      <h1>Så fungerar livsmedelskontrollen</h1>
      {/* Ingen ingress. Den sade att kontrollrapporterna är offentliga och
          att vi översätter dem, alltså varifrån innehållet kommer och varför
          sidan finns. Rubriken och korten under gör hela arbetet. */}
    </header>

    <section aria-label="Alla artiklar">
      <ul class="grid">
        {articles.map((a, i) => (
          <li class:list={['card', !a.photo && 'no-photo']}>
            {a.photo && (
              <Image
                class="photo"
                src={a.photo.src}
                alt={a.photo.alt}
                width={CARD_WIDTHS.at(-1)}
                widths={CARD_WIDTHS}
                sizes={CARD_SIZES}
                loading={i < EAGER_CARDS ? 'eager' : 'lazy'}
              />
            )}
            <div class="body">
              <p class="eyebrow tag">{a.category}</p>
              <h2><a href={path('artiklar', a.slug)}>{a.title}</a></h2>
              <p class="text-secondary summary">{a.lede}</p>
              <p class="caption text-secondary meta">
                {formatDate(a.published)} · {a.minutes} min lästid
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    {/* Bara länkarna. Raden var först två stycken om skillnaden mellan
        artiklar och rapporter, sedan en källrad om att tal i artiklar är
        frusna vid skrivtillfället. Ingen av dem behövs på en sida som är en
        lista med kort: den som vill veta hur talen räknas följer länken.
        Länkarna står kvar ordagrant, de bär länkgrafen. */}
    <section class="about">
      <p>
        <a href={path('rapporter')}>Rapporterna</a> ·
        {' '}<a href={path('metodik')}>Metodiken</a> ·
        {' '}<a href={path('kallor')}>Källorna</a> ·
        {' '}<a href={path('ratta')}>Rätta en uppgift</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--s-12) var(--s-16);
  }

  header {
    max-width: var(--w-read);
  }

  h1 {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    margin-top: var(--s-2);
  }

  section {
    margin-top: var(--s-12);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-6);
  }

  /* Bild överst, sedan text i en egen kropp: Boolis och Hemnets kortform, och
     samma uppdelning som KommunKort redan har. Renheten sitter i att kortet
     har EN yta och EN kant — bilden går ut i kortets ytterkanter i stället för
     att ligga inramad med luft runt om. */
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .card :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--card);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--s-4) var(--s-6) var(--s-6);
  }

  /* Utan bild börjar kortet med kategorietiketten, och då behöver kroppen
     samma luft upptill som den har nedtill. En platshållarruta i bildens
     ställe vore värre: den läser som en trasig bild, medan ett kort som helt
     saknar bildfält bara läser som ett textkort. Bilderna läggs in en artikel
     i taget, så blandningen är ett normaltillstånd och inte ett fel. */
  .no-photo .body {
    padding-top: var(--s-6);
  }

  .tag {
    color: var(--brand-ink);
  }

  .grid h2 {
    margin-top: var(--s-2);
    font-size: var(--fs-h-s);
    line-height: var(--lh-h-s);
  }

  /* Rubriken är länken. Träffytan görs kortstor med en pseudo-yta i stället
     för att slå in hela kortet i ett ankare, så att texten förblir markerbar
     och en framtida andralänk i kortet är möjlig. */
  .grid h2 a {
    color: var(--text);
  }

  .grid h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .grid li {
    position: relative;
    transition: box-shadow .18s ease;
  }

  /* Samma svar på pekaren som kommunkorten ger. Kortet med bild behöver det
     mest: där ligger rubriken inte längre överst i kortet, och utan skuggan är
     det bara textfärgen som visar att hela ytan är klickbar. */
  .grid li:hover {
    box-shadow: var(--shadow-pop);
  }

  .grid li:hover h2 a {
    color: var(--brand-ink);
  }

  .summary {
    margin-top: var(--s-3);
    font-size: var(--fs-body-s);
    line-height: var(--lh-body-s);
  }

  .meta {
    margin-top: auto;
    padding-top: var(--s-4);
  }

  .about {
    max-width: var(--w-read);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-6);
    font-size: var(--fs-body-s);
  }

  .about p {
    line-height: 22px;
    color: var(--text-secondary);
  }
</style>
