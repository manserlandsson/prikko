---
/**
 * En enskild artikel. All form bor i layouts/Artikel.astro, all metadata i
 * artikelns frontmatter. Den här filen är bara kopplingen mellan dem.
 */
import { getCollection, render } from 'astro:content';
import Artikel from '../../layouts/Artikel.astro';
import { readingMinutes } from '../../lib/artiklar';
import { articleImage } from '../../lib/artikelbilder';

export async function getStaticPaths() {
  const entries = await getCollection('artiklar', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const minutes = readingMinutes(entry.body ?? '');
const image = articleImage(entry.id, entry.data.image);
---

<Artikel
  slug={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  lede={entry.data.lede}
  category={entry.data.category}
  published={entry.data.published}
  updated={entry.data.updated}
  minutes={minutes}
  image={image}
>
  <Content />
</Artikel>
